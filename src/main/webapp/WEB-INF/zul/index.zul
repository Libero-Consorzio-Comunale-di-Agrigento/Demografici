<?xml version="1.0" encoding="UTF-8"?>
<?taglib uri="http://www.zkoss.org/dsp/web/core" prefix="c"?>
<?link rel="stylesheet" type="text/css" href="/css/de4gsdzk.css" ?>

<zk xmlns="http://www.zkoss.org/2005/zul"
	xmlns:h="http://www.w3.org/1999/xhtml"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul http://www.zkoss.org/2005/zul/zul.xsd">

	<window closable="false"
			apply="org.zkoss.bind.BindComposer"
			width="100%" height="100%"
			viewModel="@id('vm') @init('restrict.IndexViewModel')">

		<borderlayout height="100%">
			<north>
				<include hflex="1" vflex="1" src="/north.zul"/>
			</north>

			<center autoscroll="true">
				<include hflex="1" vflex="1" src="@load(vm.selectedModulo.uri)"/>
			</center>

			<south style="border-top: 1px solid #c5c5c5; margin-top:-1;">
				<include hflex="1" vflex="1" src="/south.zul"/>
			</south>

		</borderlayout>
	</window>
</zk>