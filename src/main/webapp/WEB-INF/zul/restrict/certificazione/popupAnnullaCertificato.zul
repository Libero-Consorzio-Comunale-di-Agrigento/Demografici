<?xml version="1.0" encoding="UTF-8"?>
<?taglib uri="http://www.zkoss.org/dsp/web/core" prefix="c"?>

<zk xmlns="http://www.zkoss.org/2005/zul"
    xmlns:h="http://www.w3.org/1999/xhtml"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.zkoss.org/2005/zul http://www.zkoss.org/2005/zul/zul.xsd">

    <window apply="org.zkoss.bind.BindComposer"
            viewModel="@id('vm') @init('restrict.certificazione.PopupAnnullaCertificatoViewModel')"
            title="@load(vm.etichette['annulla_certificato_tooltip'])"
            width="470px"
            border="normal"
            closable="false"
            sizable="false">

        <grid sclass="form">
            <rows>
                <row>
                    <cell align="right" width="60px">
                        <customLabel mandatory="true" value="@load(vm.etichette['Note'])"/>
                    </cell>
                    <cell>
                        <textbox rows="3"
                                 value="@bind(vm.noteAnnullamento)"
                                 hflex="1"/>
                    </cell>
                </row>
                <row visible="@load(vm.showCertificatoEsternoWarning)">
                    <cell colspan="2">
                        <label value="@load(vm.etichette['Warn_annullamento_certificato_esterno']))"
                                   style="font-weight:bold;"/>
                    </cell>
                </row>
            </rows>
        </grid>

        <h:div sclass="barraPulsanti">
            <h:div>
                <button label="@load(vm.etichette['Conferma'])" onClick="@command('onConferma')"
                        image="/images/icon/action/16x16/ok.png"/>
                <button label="@load(vm.etichette['Chiudi'])" onClick="@command('onChiudi')"
                        image="/images/icon/action/16x16/close.png"/>
            </h:div>
        </h:div>

    </window>

</zk>