<?xml version="1.0" encoding="UTF-8"?>
<?taglib uri="http://www.zkoss.org/dsp/web/core" prefix="c"?>

<zk xmlns="http://www.zkoss.org/2005/zul"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:h="http://www.w3.org/1999/xhtml"
    xsi:schemaLocation="http://www.zkoss.org/2005/zul http://www.zkoss.org/2005/zul/zul.xsd">

    <window apply="org.zkoss.bind.BindComposer"
            viewModel="@id('vm') @init('restrict.certificazione.PopupFondoCassaViewModel')"
            title="@load(vm.formLabel)"
            width="470px"
            border="normal"
            closable="false"
            sizable="false">

        <grid sclass="form">
            <rows>
                <row>
                    <cell align="right" width="100px">
                        <customLabel value="@load(vm.etichette['Terminalista'])"/>
                    </cell>
                    <cell>
                        <label value="@load(vm.dettaglio.id.terminalista.cognomeNome)"
                               style="font-weight:bold;"/>
                    </cell>
                </row>
                <row>
                    <cell align="right">
                        <customLabel value="@load(vm.etichette['Data'])"/>
                    </cell>
                    <cell>
                        <label value="@load(c:formatDate(vm.dettaglio.id.data, 'dd/MM/yyyy'))"
                               style="font-weight:bold;"/>
                    </cell>
                </row>
                <row>
                    <cell align="right">
                        <customLabel value="@load(vm.etichette['Fondo_Cassa'])"/>
                    </cell>
                    <cell>
                        <decimalbox value="@bind(vm.dettaglio.fondoCassa)"
                                    mold="rounded"
                                    format="€ #,##0.00"
                                    hflex="1"/>
                    </cell>
                </row>
            </rows>
        </grid>

        <h:div sclass="barraPulsanti">
            <h:div>
                <button label="@load(vm.etichette['Conferma'])" onClick="@command('onConferma')"
                        image="/images/icon/action/16x16/ok.png"/>
                <button label="@load(vm.etichette['Chiudi'])" onClick="@command('onChiudi')"
                        image="/images/icon/action/16x16/close.png"/>
            </h:div>
        </h:div>
    </window>

</zk>