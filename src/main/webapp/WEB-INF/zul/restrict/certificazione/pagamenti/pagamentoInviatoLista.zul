<?xml version="1.0" encoding="UTF-8"?>
<?taglib uri="http://www.zkoss.org/dsp/web/core" prefix="c"?>
<?xel-method prefix="c" name="showMsgBox" class="it.finmatica.de4gsdzk.utils.MessaggioUtils" signature="void showMsgBox(java.lang.String, java.lang.String, java.lang.String)"?>

<zk xmlns="http://www.zkoss.org/2005/zul"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.zkoss.org/2005/zul http://www.zkoss.org/2005/zul/zul.xsd">

    <window viewModel="@id('vm') @init('restrict.certificazione.pagamenti.PagamentoInviatoListaViewModel')"
            apply="org.zkoss.bind.BindComposer"
            border="none"
            width="100%" height="100%"
            sizable="false" closable="false"
            onOK="@command('onRicerca')">

        <vlayout vflex="1">
            <hlayout valign="middle">
                <controlBarLista/>

                <label value="@load(vm.formLabel)" sclass="formTitle"/>
            </hlayout>

            <groupbox closable="false">
                <grid sclass="form">
                    <rows>
                        <row>
                            <cell align="right" width="90px">
                                <label value="@load(vm.etichette['Data_Invio'])"/>
                            </cell>
                            <cell width="300px">
                                <hlayout valign="middle">
                                    <label value="@load(vm.etichette['Da'])"/>
                                    <datebox format="dd/MM/yyyy" value="@bind(vm.ricercaPagamentoInviato.dataInvioDal)"
                                             width="100px"/>
                                    <space/>
                                    <label value="@load(vm.etichette['A'])"/>
                                    <datebox format="dd/MM/yyyy" value="@bind(vm.ricercaPagamentoInviato.dataInvioAl)"
                                             width="100px"/>
                                    <button image="/images/icon/action/16x16/cancel.png"
                                            tooltiptext="@load(vm.etichette['Cancella'])"
                                            onClick="@command('onCancellaCampoRicerca')">
                                        <custom-attributes proprieta="dataInvioDal,dataInvioAl"/>
                                    </button>
                                </hlayout>
                            </cell>
                            <cell align="right" width="90px">
                                <label value="@load(vm.etichette['Stato'])"/>
                            </cell>
                            <cell>
                                <combobox model="@load(vm.listaStato)" readonly="true" width="120px"
                                          selectedItem="@bind(vm.ricercaPagamentoInviato.statoInvio) @converter('it.finmatica.zk.utils.PropertyConverter', property='id')"
                                          onChange="@command('onRicerca')">
                                    <template name="model">
                                        <comboitem
                                                label="@load(empty each? vm.etichette['Tutti']:vm.getEtichettaEnum(each))"
                                                value="@load(each)"/>
                                    </template>
                                </combobox>
                            </cell>
                            <cell width="40px" align="right">
                                <hlayout valign="middle">
                                    <button image="/images/icon/action/16x16/search.png"
                                            tooltiptext="@load(vm.etichette['Effettua_Ricerca'])"
                                            onClick="@command('onRicerca')"/>
                                </hlayout>
                            </cell>
                        </row>
                    </rows>
                </grid>
            </groupbox>

            <orderByBlock/>

            <borderlayout vflex="1">
                <center vflex="1">
                    <listbox model="@load(vm.lista)" selectedItem="@bind(vm.dettaglio)" vflex="1"
                             emptyMessage="@load(vm.etichette['Nessun_dato_disponibile'])"
                             onSelect="@command('onSelectDettaglio')">
                        <listhead>
                            <listheader label="@load(vm.etichette['Anno'])" hflex="1"/>
                            <listheader label="@load(vm.etichette['Progressivo'])" hflex="1"/>
                            <listheader label="@load(vm.etichette['Totale_Diritti'])" hflex="1"/>
                            <listheader label="@load(vm.etichette['Codice_Fiscale'])" hflex="2"/>
                            <listheader label="@load(vm.etichette['Data_Invio'])" hflex="1"/>
                            <listheader label="@load(vm.etichette['Stato_pagamento'])" width="110px"/>
                        </listhead>
                        <template name="model" var="item">
                            <listitem>
                                <listcell label="@load(item.anno)"/>
                                <listcell label="@load(item.progressivo)"/>
                                <listcell>
                                    <currencylabel value="@load(item.importoTotale)"/>
                                </listcell>
                                <listcell label="@load(item.codiceFiscalePagatore)"/>
                                <listcell sclass="testo-al-centro"
                                          label="@load(empty item.dataInvio? null:(c:formatDate(item.dataInvio, 'dd/MM/yyyy')))"/>
                                <listcell sclass="testo-al-centro">
                                    <button image="/images/icon/action/18x18/ok.png"
                                            tooltiptext="@load(vm.etichette['Inviato'])"
                                            visible="@load(item.isInviatoConSuccesso())"
                                            onClick="@command(c:showMsgBox(vm.msgTitle, 'I', item.note))"/>
                                    <button image="/images/icon/action/18x18/warning_light.png"
                                            tooltiptext="@load(vm.etichette['info_tooltip'])"
                                            visible="@load(not item.isInviatoConSuccesso())"
                                            onClick="@command(c:showMsgBox(vm.msgTitle, 'E', item.note))"/>
                                </listcell>
                            </listitem>
                        </template>
                    </listbox>
                </center>
                <east size="60%" collapsible="true" open="@load(not empty vm.dettaglio)">
                    <vlayout vflex="1" hflex="1" sclass="scroll">
                        <groupbox mold="3d" closable="false" style="background: #EDEFF5" vflex="1">
                            <caption label="@load(vm.etichette['Pagamento'])" width="260px">
                                <hlayout sclass="testo-a-dx">
                                    <button image="/images/icon/action/18x18/refresh.png"
                                            tooltiptext="@load(vm.getEtichettaEnum(vm.funzioniDettaglio.getEnum('RIPETIZIONE')))"
                                            onClick="@command('onRipetiInvio')"
                                            visible="@load(vm.funzioniDettaglio.isVisible('RIPETIZIONE'))"
                                            disabled="@load(vm.funzioniDettaglio.isDisabled('RIPETIZIONE'))"/>
                                    <button image="/images/icon/action/18x18/links.png"
                                            tooltiptext="@load(vm.getEtichettaEnum(vm.funzioniDettaglio.getEnum('CONFERMA')))"
                                            onClick="@command('onConfermaPagamento')"
                                            visible="@load(vm.funzioniDettaglio.isVisible('CONFERMA'))"
                                            disabled="@load(vm.funzioniDettaglio.isDisabled('CONFERMA'))"/>
                                    <button image="/images/de4gsdzk/18x18/bell.png"
                                            tooltiptext="@load(vm.getEtichettaEnum(vm.funzioniDettaglio.getEnum('VERIFICA')))"
                                            onClick="@command('onVerificaPagamento')"
                                            visible="@load(vm.funzioniDettaglio.isVisible('VERIFICA'))"
                                            disabled="@load(vm.funzioniDettaglio.isDisabled('VERIFICA'))"/>
                                    <button image="/images/icon/action/18x18/undo.png"
                                            tooltiptext="@load(vm.getEtichettaEnum(vm.funzioniDettaglio.getEnum('ANNULLA')))"
                                            onClick="@command('onAnnullaPagamento')"
                                            visible="@load(vm.funzioniDettaglio.isVisible('ANNULLA'))"
                                            disabled="@load(vm.funzioniDettaglio.isDisabled('ANNULLA'))"/>
                                </hlayout>
                            </caption>
                            <grid sclass="form"
                                  visible="@load(not empty vm.dettaglio.chiaveServizioEsterno or not empty vm.dettaglio.note)">
                                <rows>
                                    <row visible="@load(not empty vm.dettaglio.chiaveServizioEsterno)">
                                        <cell align="right" width="60px">
                                            <label value="@load(vm.etichette['Chiave'])"/>
                                        </cell>
                                        <cell>
                                            <label value="@load(vm.dettaglio.chiaveServizioEsterno)"/>
                                        </cell>
                                    </row>
                                    <row visible="@load(not empty vm.dettaglio.note)">
                                        <cell align="right" width="60px">
                                            <label value="@load(vm.etichette['Note'])"/>
                                        </cell>
                                        <cell>
                                            <label value="@load(vm.dettaglio.note)" multiline="true"/>
                                        </cell>
                                    </row>
                                </rows>
                            </grid>
                            <hlayout sclass="navigazione" valign="middle">
                                <label value="@load(c:cat(vm.etichette['Numero_record_trovati'], vm.dettaglio.numeroDocumenti))"
                                       multiline="true" sclass="grassetto"/>
                            </hlayout>
                            <listbox model="@load(vm.dettaglio.documenti)" nonselectableTags="" vflex="1"
                                     emptyMessage="@load(vm.etichette['Nessun_dato_disponibile'])">
                                <listhead sizable="true">
                                    <listheader label="@load(vm.etichette['Anno_emissione'])" width="110px"/>
                                    <listheader label="@load(vm.etichette['Progressivo_emissione'])" width="110px"/>
                                    <listheader label="@load(vm.etichette['Descrizione'])"/>
                                    <listheader label="@load(vm.etichette['Beneficiario'])"/>
                                    <listheader label="@load(vm.etichette['Richiedente'])"/>
                                    <listheader label="@load(vm.etichette['Terminalista'])"/>
                                    <listheader label="@load(vm.etichette['Data_emissione'])"/>
                                </listhead>
                                <template name="model" var="item">
                                    <listitem>
                                        <listcell label="@load(item.certificatoEmesso.annoEmissione)"/>
                                        <listcell label="@load(item.certificatoEmesso.progressivoEmissione)"/>
                                        <listcell label="@load(item.certificatoEmesso.tipoCertificato.descrizione)"/>
                                        <listcell label="@load(item.certificatoEmesso.beneficiario.cognomeNome)"/>
                                        <listcell label="@load(item.certificatoEmesso.richiedente.cognomeNome)"/>
                                        <listcell label="@load(item.certificatoEmesso.terminalista.cognomeNome)"/>
                                        <listcell sclass="testo-al-centro">
                                            <label value="@load(empty item.certificatoEmesso.dataEmissione? null:(c:formatDate(item.certificatoEmesso.dataEmissione, 'dd/MM/yyyy')))"/>
                                        </listcell>
                                    </listitem>
                                </template>
                            </listbox>
                        </groupbox>
                    </vlayout>
                </east>
            </borderlayout>
        </vlayout>

    </window>

</zk>