<?xml version="1.0" encoding="UTF-8"?>
<?taglib uri="http://www.zkoss.org/dsp/web/core" prefix="c"?>

<zk xmlns="http://www.zkoss.org/2005/zul"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.zkoss.org/2005/zul http://www.zkoss.org/2005/zul/zul.xsd">

    <window viewModel="@id('vm') @init('restrict.certificazione.pagamenti.PagamentoRemotoRicercaViewModel')"
            apply="org.zkoss.bind.BindComposer"
            border="none"
            width="100%" height="100%"
            sizable="false" closable="false"
            onOK="@command('onRicerca')">

        <hlayout valign="middle">
            <hlayout sclass="navigazione" valign="middle" height="40px">
            </hlayout>
            <label value="@load(vm.formLabel)" sclass="formTitle"/>
        </hlayout>

        <groupbox closable="false">
            <grid sclass="form">
                <rows>
                    <row>
                        <cell align="right" width="120px">
                            <label value="@load(vm.etichette['Ricerca_Iuv'])"/>
                        </cell>
                        <cell width="200px">
                            <hlayout valign="middle">
                                <textbox hflex="1" value="@bind(vm.chiaveServizioEsternoRicerca)"/>
                                <button image="/images/icon/action/16x16/cancel.png"
                                        tooltiptext="@load(vm.etichette['Cancella'])"
                                        onClick="@command('onCancellaCampoRicerca')">
                                    <custom-attributes proprieta="chiaveServizioEsternoRicerca"/>
                                </button>
                            </hlayout>
                        </cell>
                        <cell/>
                        <cell width="40px">
                            <button image="/images/icon/action/16x16/search.png"
                                    tooltiptext="@load(vm.etichette['Effettua_Ricerca'])"
                                    onClick="@command('onRicerca')"/>
                        </cell>
                    </row>
                </rows>
            </grid>
        </groupbox>

        <vlayout vflex="1" width="100%" sclass="scroll">
            <groupbox closable="false" style="@load(not empty vm.dettaglio ? 'display: block': 'display: none')">
                <caption label="@load(vm.etichette['Pagamento'])"/>
                <grid sclass="form">
                    <rows>
                        <row>
                            <cell align="right" width="120px">
                                <label value="@load(vm.etichette['Iuv'])"/>
                            </cell>
                            <cell>
                                <customLabel value="@load(vm.dettaglio.id)" bold="true"/>
                            </cell>
                        </row>
                        <row>
                            <cell align="right">
                                <label value="@load(vm.etichette['Esito_operazione'])"/>
                            </cell>
                            <cell>
                                <hlayout>
                                    <image visible="@load(vm.dettaglio.esitoOperazione eq 'OK')"
                                           src="/images/icon/show/16x16/point_green.png"/>
                                    <image visible="@load(vm.dettaglio.esitoOperazione ne 'OK')"
                                           src="/images/icon/show/16x16/point_red.png"/>
                                    <customLabel value="@load(vm.dettaglio.esitoOperazione)" bold="true"/>
                                </hlayout>
                            </cell>
                        </row>
                        <row>
                            <cell align="right">
                                <label value="@load(vm.etichette['Chiave'])"/>
                            </cell>
                            <cell>
                                <customLabel value="@load(vm.dettaglio.chiave)" bold="true"/>
                            </cell>
                        </row>
<!--                        <row>-->
<!--                            <cell align="right" width="120px">-->
<!--                                <label value="@load(vm.etichette['Tipo_pagatore'])"/>-->
<!--                            </cell>-->
<!--                            <cell>-->
<!--                                <customLabel value="@load(vm.dettaglio.tipoPagatore)" bold="true"/>-->
<!--                            </cell>-->
<!--                        </row>-->
                        <row>
                            <cell align="right" width="120px">
                                <label value="@load(vm.etichette['Codice_pagatore'])"/>
                            </cell>
                            <cell>
                                <customLabel value="@load(vm.dettaglio.codicePagatore)" bold="true"/>
                            </cell>
                        </row>
                        <row>
                            <cell align="right">
                                <label value="@load(vm.etichette['Anagrafica_pagatore'])"/>
                            </cell>
                            <cell>
                                <customLabel value="@load(vm.dettaglio.anagraficaPagatore)" bold="true"/>
                            </cell>
                        </row>
                        <row>
                            <cell align="right">
                                <label value="@load(vm.etichette['Email_pagatore'])"/>
                            </cell>
                            <cell>
                                <customLabel value="@load(vm.dettaglio.emailPagatore)" bold="true"/>
                            </cell>
                        </row>
<!--                        <row>-->
<!--                            <cell align="right">-->
<!--                                <label value="@load(vm.etichette['Tipo_dovuto'])"/>-->
<!--                            </cell>-->
<!--                            <cell>-->
<!--                                <customLabel value="@load(vm.dettaglio.tipoDovuto)" bold="true"/>-->
<!--                            </cell>-->
<!--                        </row>-->
<!--                        <row>-->
<!--                            <cell align="right">-->
<!--                                <label value="@load(vm.etichette['Tipo_versamento'])"/>-->
<!--                            </cell>-->
<!--                            <cell>-->
<!--                                <customLabel value="@load(vm.dettaglio.tipoVersamento)" bold="true"/>-->
<!--                            </cell>-->
<!--                        </row>-->
                        <row>
                            <cell align="right">
                                <label value="@load(vm.etichette['Causale_versamento'])"/>
                            </cell>
                            <cell>
                                <customLabel value="@load(vm.dettaglio.causaleVersamento)" bold="true"/>
                            </cell>
                        </row>
                        <row>
                            <cell align="right">
                                <label value="@load(vm.etichette['Data_scadenza'])"/>
                            </cell>
                            <cell>
                                <customLabel value="@load(vm.dettaglio.dataScadenza)" bold="true"/>
                            </cell>
                        </row>
                        <row>
                            <cell align="right">
                                <label value="@load(vm.etichette['Importo_totale'])"/>
                            </cell>
                            <cell>
                                <customLabel value="@load(vm.dettaglio.importoTotale)" bold="true"/>
                            </cell>
                        </row>
                    </rows>
                </grid>
            </groupbox>

            <groupbox closable="false" style="@load(not empty vm.dettaglio ? 'display: block': 'display: none')">
                <caption label="@load(vm.etichette['SV_singolo_versamento'])"/>
                <grid sclass="form">
                    <rows>
                        <row>
                            <cell align="right" width="120px">
                                <label value="@load(vm.etichette['SV_servizio'])"/>
                            </cell>
                            <cell>
                                <customLabel value="@load(vm.dettaglio.svServizio)" bold="true"/>
                            </cell>
                        </row>
                        <row>
                            <cell align="right">
                                <label value="@load(vm.etichette['SV_causale'])"/>
                            </cell>
                            <cell>
                                <customLabel value="@load(vm.dettaglio.svCausale)" bold="true"/>
                            </cell>
                        </row>
                        <row>
                            <cell align="right" width="120px">
                                <label value="@load(vm.etichette['SV_importo'])"/>
                            </cell>
                            <cell>
                                <customLabel value="@load(vm.dettaglio.svImporto)" bold="true"/>
                            </cell>
                        </row>
                        <row>
                            <cell align="right" width="120px">
                                <label value="@load(vm.etichette['SV_commissione_carico_PA'])"/>
                            </cell>
                            <cell>
                                <customLabel value="@load(vm.dettaglio.svCommissioneCaricoPA)" bold="true"/>
                            </cell>
                        </row>
                        <row>
                            <cell align="right" width="120px">
                                <label value="@load(vm.etichette['SV_dati_riscossione'])"/>
                            </cell>
                            <cell>
                                <customLabel value="@load(vm.dettaglio.svDatiRiscossione)" bold="true"/>
                            </cell>
                        </row>
                        <row>
                            <cell align="right" width="120px">
                                <label value="@load(vm.etichette['SV_accertamento'])"/>
                            </cell>
                            <cell>
                                <customLabel value="@load(vm.dettaglio.svAccertamento)" bold="true"/>
                            </cell>
                        </row>
                        <row>
                            <cell align="right" width="120px">
                                <label value="@load(vm.etichette['SV_bilancio'])"/>
                            </cell>
                            <cell>
                                <customLabel value="@load(vm.dettaglio.svBilancio)" bold="true"/>
                            </cell>
                        </row>
                    </rows>
                </grid>
            </groupbox>

            <groupbox closable="false" style="@load(not empty vm.dettaglio ? 'display: block': 'display: none')">
                <caption label="@load(vm.etichette['IP_pagamento'])"/>
                <grid sclass="form">
                    <rows>
                        <row>
                            <cell align="right" width="120px">
                                <label value="@load(vm.etichette['IP_importo_pagato'])"/>
                            </cell>
                            <cell>
                                <customLabel value="@load(vm.dettaglio.ipImportoPagato)" bold="true"/>
                            </cell>
                        </row>
                        <row>
                            <cell align="right">
                                <label value="@load(vm.etichette['IP_data_pagamento'])"/>
                            </cell>
                            <cell>
                                <customLabel value="@load(vm.dettaglio.ipDataPagamento)" bold="true"/>
                            </cell>
                        </row>
                        <row>
                            <cell align="right" width="120px">
                                <label value="@load(vm.etichette['IP_codice_versante'])"/>
                            </cell>
                            <cell>
                                <customLabel value="@load(vm.dettaglio.ipCodiceVersante)" bold="true"/>
                            </cell>
                        </row>
                        <row>
                            <cell align="right" width="120px">
                                <label value="@load(vm.etichette['IP_anagrafica_versante'])"/>
                            </cell>
                            <cell>
                                <customLabel value="@load(vm.dettaglio.ipAnagraficaVersante)" bold="true"/>
                            </cell>
                        </row>
                    </rows>
                </grid>
            </groupbox>

        </vlayout>

    </window>

</zk>