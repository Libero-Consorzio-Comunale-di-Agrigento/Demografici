<?xml version="1.0" encoding="UTF-8"?>
<?taglib uri="http://www.zkoss.org/dsp/web/core" prefix="c"?>

<zk xmlns="http://www.zkoss.org/2005/zul"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.zkoss.org/2005/zul http://www.zkoss.org/2005/zul/zul.xsd">

    <window viewModel="@id('vm') @init('restrict.certificazione.dizionari.pagamento.DocumentoDettaglioViewModel')"
            apply="org.zkoss.bind.BindComposer"
            border="none"
            width="100%" height="100%"
            sizable="false" closable="false">

        <vlayout vflex="1">

            <hlayout valign="middle">
                <controlBarDettaglio/>

                <label value="@load(vm.formLabel)" sclass="formTitle"/>
            </hlayout>

            <grid sclass="form">
                <columns>
                    <column width="150px"/>
                    <column/>
                </columns>
                <rows>
                    <row>
                        <cell colspan="3">
                            <groupbox closable="false">
                                <caption label="@load(vm.etichette['Tipo_Certificato'])"/>
                                <grid>
                                    <rows>
                                        <row>
                                            <cell align="right" width="130px">
                                                <label value="@load(vm.etichette['Categoria_Tipo_Certificato'])"/>
                                            </cell>
                                            <cell>
                                                <customLabel bold="true"
                                                             value="@load(vm.dettaglio.tipoCertificato.categoriaTipoCertificato.descrizione)"/>
                                            </cell>
                                        </row>
                                        <row>
                                            <cell align="right" width="150px">
                                                <label value="@load(vm.etichette['Codice'])"/>
                                            </cell>
                                            <cell>
                                                <customLabel bold="true"
                                                             value="@load(vm.dettaglio.tipoCertificato.id)"/>
                                            </cell>
                                        </row>
                                        <row>
                                            <cell align="right" width="150px">
                                                <label value="@load(vm.etichette['Descrizione'])"/>
                                            </cell>
                                            <cell>
                                                <customLabel bold="true"
                                                             value="@load(vm.dettaglio.tipoCertificato.descrizione)"/>
                                            </cell>
                                        </row>
                                    </rows>
                                </grid>
                            </groupbox>
                        </cell>
                    </row>
                    <row>
                        <cell align="right" width="150px">
                            <customLabel mandatory="true" value="@load(vm.etichette['Servizio'])"/>
                        </cell>
                        <cell>
                            <combobox model="@load(vm.listaServizio)" readonly="false" hflex="1"
                                      selectedItem="@bind(vm.dettaglio.servizio) @converter('it.finmatica.zk.utils.PropertyConverter', property='id')">
                                <template name="model">
                                    <comboitem label="@load(empty each?'- -':c:cat3(each.id,' - ', each.descrizione))"
                                               tooltiptext="@load(c:cat3(each.id,' - ', each.descrizione))"
                                               value="@load(each)"/>
                                </template>
                            </combobox>
                        </cell>
                        <cell/>
                    </row>
                </rows>
            </grid>

        </vlayout>

    </window>

</zk>