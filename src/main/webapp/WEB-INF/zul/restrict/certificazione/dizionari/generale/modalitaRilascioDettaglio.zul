<?xml version="1.0" encoding="UTF-8"?>
<?taglib uri="http://www.zkoss.org/dsp/web/core" prefix="c"?>

<zk xmlns="http://www.zkoss.org/2005/zul"
	xmlns:h="http://www.w3.org/1999/xhtml"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul http://www.zkoss.org/2005/zul/zul.xsd">

	<window viewModel="@id('vm') @init('restrict.certificazione.dizionari.generale.ModalitaRilascioDettaglioViewModel')"
			apply="org.zkoss.bind.BindComposer"
			border="none"
			width="100%" height="100%"
			sizable="false" closable="false">

		<vlayout vflex="1">

			<hlayout valign="middle">
				<controlBarDettaglio/>

				<label value="@load(vm.formLabel)" sclass="formTitle"/>
			</hlayout>

			<grid sclass="form">
				<rows>
					<row>
						<cell align="right" width="150px">
							<h:span class="mandatoryLabel">*</h:span><label value="@load(vm.etichette['Codice'])"/>
						</cell>
						<cell colspan="2">
							<intbox value="@bind(vm.dettaglio.id)" mold="rounded" cols="2" maxlength="2" disabled="@load(vm.tipoOperazione.isUpdate())"/>
						</cell>
					</row>
					<row>
						<cell align="right">
							<label value="@load(vm.etichette['Descrizione'])"/>
						</cell>
						<cell colspan="2">
							<hlayout valign="middle">
								<textbox value="@bind(vm.dettaglio.descrizione)" hflex="1"/>
								<button image="/images/icon/action/16x16/cancel.png"
										tooltiptext="@load(vm.etichette['Cancella'])"
										onClick="@command('onCancellaCampoDizionario')">
									<custom-attributes proprieta="descrizione"/>
								</button>
							</hlayout>
						</cell>
					</row>
					<row>
						<cell align="right">
							<label value="@load(vm.etichette['Descrizione_stampa'])"/>
						</cell>
						<cell colspan="2">
							<hlayout valign="middle">
								<textbox value="@bind(vm.dettaglio.descrizioneStampa)" hflex="1"/>
								<button image="/images/icon/action/16x16/cancel.png"
										tooltiptext="@load(vm.etichette['Cancella'])"
										onClick="@command('onCancellaCampoDizionario')">
									<custom-attributes proprieta="descrizioneStampa"/>
								</button>
							</hlayout>
						</cell>
					</row>
					<row>
						<cell align="right">
							<label value="@load(vm.etichette['Specifica_Esenzione_Libera'])"/>
						</cell>
						<cell colspan="2">
							<checkbox checked="@bind(vm.dettaglio.flagModalitaStampaLibera)"/>
						</cell>
					</row>
					<row>
						<cell align="right">
							<label value="@load(vm.etichette['Categoria_Tipo_Certificato'])"/>
						</cell>
						<cell colspan="2">
							<combobox model="@load(vm.listaCategoriaTipoCertificato)" readonly="true" width="400px"
									  selectedItem="@bind(vm.dettaglio.categoriaTipoCertificato) @converter('it.finmatica.zk.utils.PropertyConverter', property='codice')"
									  onSelect="@command('onSelectCategoria')">
								<template name="model">
									<comboitem label="@load(empty each? '- -':each.descrizione)"
											   value="@load(each)"/>
								</template>
							</combobox>
						</cell>
					</row>
					<row>
						<cell align="right">
							<label value="@load(vm.etichette['Competenza_On_Line'])"/>
						</cell>
						<cell colspan="2">
							<label value="@load(vm.getEtichettaEnum(vm.dettaglio.categoriaTipoCertificato.tipoCompetenzaOnline))"
								   style="font-weight:bold;"/>
						</cell>
					</row>
					<row>
						<cell align="right">
							<label value="On-Line"/>
						</cell>
						<cell colspan="2">
							<checkbox checked="@bind(vm.dettaglio.flagOnLine)"/>
						</cell>
					</row>
					<row>
						<cell align="right">
							<label value="@load(vm.etichette['Esenzione_diritti'])"/>
						</cell>
						<cell colspan="2">
							<hlayout height="20px">
								<radiogroup model="@load(vm.listaSiNo)"
											selectedItem="@bind(vm.dettaglio.esenzioneDiritti) @converter('it.finmatica.zk.utils.PropertyConverter', property='id')">
									<template name="model">
										<radio label="@load(vm.getEtichettaEnum(each))" value="@load(each)" style="padding-left:10px"/>
									</template>
								</radiogroup>
							</hlayout>
						</cell>
					</row>
					<row>
						<cell align="right">
							<label value="@load(vm.etichette['Fascia_tariffaria_Bollo'])"/>
						</cell>
						<cell colspan="2">
							<hlayout valign="middle">
								<combobox model="@load(vm.listaTariffaDiritto)" readonly="true" width="100px"
										  onChange="@command('onSelectFasciaTariffaria')"
										  selectedItem="@bind(vm.dettaglio.fasciaTariffaria) @converter('it.finmatica.zk.utils.PropertyConverter', property='fasciaTariffaria')">
									<template name="model">
										<comboitem
												label="@load(empty each?'- -' : c:cat3(each.fasciaTariffaria, ' - ', c:formatNumber(each.importo1,'€ #,##0.00') ))"
												value="@load(each.fasciaTariffaria)"/>
									</template>
								</combobox>
								<space/>
								<label value="@load(vm.etichette['Pagamento_bollo'])"/>
								<checkbox checked="@load(vm.dettaglio.isInBollo())" disabled="true"/>
							</hlayout>
						</cell>
					</row>
					<row>
						<cell align="right">
							<label value="@load(vm.etichette['Dismesso'])"/>
						</cell>
						<cell colspan="2">
							<checkbox checked="@bind(vm.dettaglio.flagDismesso)"/>
						</cell>
					</row>
					<row>
						<cell align="right">
							<label value="@load(vm.etichette['Uso_interno'])"/>
						</cell>
						<cell colspan="2">
							<checkbox checked="@bind(vm.dettaglio.flagUsoInterno)"/>
						</cell>
					</row>
					<row>
						<cell align="right">
							<label value="@load(vm.labelMotivoEsenzioneBollo)"/>
						</cell>
						<cell>
							<hlayout valign="middle" hflex="1">
								<bandboxMotivoEsenzioneBollo hflex="1"
															 value="@load(vm.dettaglio.motivoEsenzioneBollo.descrizione)"
															 tipoCompetenzaOnline="@load(vm.dettaglio.categoriaTipoCertificato.tipoCompetenzaOnline)"
															 onSelect="@command('onSelectMotivoEsenzioneBollo')"/>
								<button image="/images/icon/action/16x16/cancel.png"
										tooltiptext="@load(vm.etichette['Cancella'])"
										onClick="@command('onCancellaCampoDizionario')">
									<custom-attributes proprieta="motivoEsenzioneBollo"/>
								</button>
							</hlayout>
						</cell>
						<cell/>
					</row>
				</rows>
			</grid>

		</vlayout>

	</window>

</zk>