<?xml version="1.0" encoding="UTF-8"?>
<?taglib uri="http://www.zkoss.org/dsp/web/core" prefix="c"?>

<zk xmlns="http://www.zkoss.org/2005/zul"
	xmlns:h="http://www.w3.org/1999/xhtml"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul http://www.zkoss.org/2005/zul/zul.xsd">

	<window viewModel="@id('vm') @init('restrict.certificazione.dizionari.generale.MotivoSospensioneDettaglioViewModel')"
			apply="org.zkoss.bind.BindComposer"
			border="none"
			width="100%" height="100%"
			sizable="false" closable="false">

		<vlayout vflex="1">

			<hlayout valign="middle">
				<controlBarDettaglio/>

				<label value="@load(vm.formLabel)" sclass="formTitle"/>
			</hlayout>

			<grid sclass="form">
				<rows>
					<row>
						<cell align="right" width="150px">
							<h:span class="mandatoryLabel">*</h:span><label value="@load(vm.etichette['Codice'])"/>
						</cell>
						<cell>
							<intbox value="@bind(vm.dettaglio.id)" mold="rounded" cols="2" maxlength="2" disabled="@load(vm.tipoOperazione.isUpdate())"/>
						</cell>
					</row>
					<row>
						<cell align="right">
							<label value="@load(vm.etichette['Descrizione'])"/>
						</cell>
						<cell>
							<hlayout valign="middle">
								<textbox value="@bind(vm.dettaglio.descrizione)" hflex="1"/>
								<button image="/images/icon/action/16x16/cancel.png"
										tooltiptext="@load(vm.etichette['Cancella'])"
										onClick="@command('onCancellaCampoDizionario')">
									<custom-attributes proprieta="descrizione"/>
								</button>
							</hlayout>
						</cell>
					</row>
					<row>
						<cell align="right">
							<label value="@load(vm.etichette['Avviso'])"/>
						</cell>
						<cell>
							<checkbox checked="@bind(vm.dettaglio.flagAvviso)"/>
						</cell>
					</row>
					<row>
						<cell align="right">
							<label value="@load(vm.etichette['Anpr_Certificabilita'])"/>
						</cell>
						<cell>
							<combobox model="@load(vm.listaCertificabilita)" readonly="true" width="500px"
									  selectedItem="@bind(vm.dettaglio.certificabilita) @converter('it.finmatica.zk.utils.PropertyConverter', property='id')">
								<template name="model">
									<comboitem label="@load(empty each?'- -':each.descrizione)"
											   tooltiptext="@load(each.descrizione)" value="@load(each)"/>
								</template>
							</combobox>
						</cell>
					</row>
					<row>
						<cell align="right">
							<label value="@load(vm.etichette['Anpr_Tutela'])"/>
						</cell>
						<cell>
							<combobox model="@load(vm.listaTutela)" readonly="true" width="500px"
									  selectedItem="@bind(vm.dettaglio.tutela) @converter('it.finmatica.zk.utils.PropertyConverter', property='id')">
								<template name="model">
									<comboitem label="@load(empty each?'- -':each.descrizione)"
											   tooltiptext="@load(each.descrizione)" value="@load(each)"/>
								</template>
							</combobox>
						</cell>
					</row>
				</rows>
			</grid>

		</vlayout>

	</window>

</zk>