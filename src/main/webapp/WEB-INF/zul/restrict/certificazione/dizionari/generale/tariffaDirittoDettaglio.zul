<?xml version="1.0" encoding="UTF-8"?>
<?taglib uri="http://www.zkoss.org/dsp/web/core" prefix="c"?>

<zk xmlns="http://www.zkoss.org/2005/zul"
    xmlns:h="http://www.w3.org/1999/xhtml"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.zkoss.org/2005/zul http://www.zkoss.org/2005/zul/zul.xsd">

    <window viewModel="@id('vm') @init('restrict.certificazione.dizionari.generale.TariffaDirittoDettaglioViewModel')"
            apply="org.zkoss.bind.BindComposer"
            border="none"
            width="100%" height="100%"
            sizable="false" closable="false">

        <vlayout vflex="1" width="100%" sclass="scroll">

            <hlayout valign="middle">
                <controlBarDettaglio/>

                <label value="@load(vm.formLabel)" sclass="formTitle"/>
            </hlayout>

            <grid sclass="form">
                <rows>
                    <row>
                        <cell align="right" width="150px">
                            <customLabel mandatory="true" value="@load(vm.etichette['Codice_diritto'])"/>
                        </cell>
                        <cell>
                            <combobox model="@load(vm.listaDiritto)"
                                      selectedItem="@bind(vm.dettaglio.diritto) @converter('it.finmatica.zk.utils.PropertyConverter', property='id')"
                                      readonly="true">
                                <template name="model">
                                    <comboitem
                                            label="@load(empty each?'- -':c:cat3(each.id, ' - ', vm.getEtichettaEnum(each)))"
                                            value="@load(each)"/>
                                </template>
                            </combobox>
                        </cell>
                    </row>
                    <row>
                        <cell align="right">
                            <h:span class="mandatoryLabel">*</h:span>
                            <label value="@load(vm.etichette['Fascia_tariffaria'])"/>
                        </cell>
                        <cell>
                            <hlayout valign="middle">
                                <intbox value="@bind(vm.dettaglio.fasciaTariffaria)" mold="rounded" cols="2"
                                        maxlength="2"/>
                                <button image="/images/icon/action/16x16/cancel.png"
                                        tooltiptext="@load(vm.etichette['Cancella'])"
                                        onClick="@command('onCancellaCampoDizionario')">
                                    <custom-attributes proprieta="fasciaTariffaria"/>
                                </button>
                            </hlayout>
                        </cell>
                    </row>
                    <row>
                        <cell align="right">
                            <label value="@load(vm.etichette['Descrizione'])"/>
                        </cell>
                        <cell>
                            <hlayout valign="middle">
                                <textbox value="@bind(vm.dettaglio.descrizione)" hflex="1"/>
                                <button image="/images/icon/action/16x16/cancel.png"
                                        tooltiptext="@load(vm.etichette['Cancella'])"
                                        onClick="@command('onCancellaCampoDizionario')">
                                    <custom-attributes proprieta="descrizione"/>
                                </button>
                            </hlayout>
                        </cell>
                    </row>
                    <row>
                        <cell align="right">
                            <label value="@load(vm.etichette['Importo_1'])"/>
                        </cell>
                        <cell>
                            <hlayout valign="middle" hflex="1">
                                <currencybox value="@bind(vm.dettaglio.importo1)"/>
                                <button image="/images/icon/action/16x16/cancel.png"
                                        tooltiptext="@load(vm.etichette['Cancella'])"
                                        onClick="@command('onCancellaCampoDizionario')">
                                    <custom-attributes proprieta="importo1"/>
                                </button>
                            </hlayout>
                        </cell>
                    </row>
                    <row>
                        <cell align="right">
                            <label value="@load(vm.etichette['Importo_2'])"/>
                        </cell>
                        <cell>
                            <hlayout valign="middle" hflex="1">
                                <currencybox value="@bind(vm.dettaglio.importo2)"/>
                                <button image="/images/icon/action/16x16/cancel.png"
                                        tooltiptext="@load(vm.etichette['Cancella'])"
                                        onClick="@command('onCancellaCampoDizionario')">
                                    <custom-attributes proprieta="importo2"/>
                                </button>
                            </hlayout>
                        </cell>
                    </row>
                    <row>
                        <cell align="right">
                            <label value="@load(vm.etichette['Importo_1_on_line'])"/>
                        </cell>
                        <cell>
                            <hlayout valign="middle" hflex="1">
                                <currencybox value="@bind(vm.dettaglio.importo1OnLine)"/>
                                <button image="/images/icon/action/16x16/cancel.png"
                                        tooltiptext="@load(vm.etichette['Cancella'])"
                                        onClick="@command('onCancellaCampoDizionario')">
                                    <custom-attributes proprieta="importo1OnLine"/>
                                </button>
                            </hlayout>
                        </cell>
                    </row>
                    <row>
                        <cell align="right">
                            <label value="@load(vm.etichette['Importo_2_on_line'])"/>
                        </cell>
                        <cell>
                            <hlayout valign="middle" hflex="1">
                                <currencybox value="@bind(vm.dettaglio.importo2OnLine)"/>
                                <button image="/images/icon/action/16x16/cancel.png"
                                        tooltiptext="@load(vm.etichette['Cancella'])"
                                        onClick="@command('onCancellaCampoDizionario')">
                                    <custom-attributes proprieta="importo2OnLine"/>
                                </button>
                            </hlayout>
                        </cell>
                    </row>
                </rows>
            </grid>

            <groupbox width="100%" open="true" closable="false" vflex="1">
                <caption label="@load(vm.etichette['Categorie_Tipo_Certificato'])"/>
                <include tariffaDiritto="@load(vm.dettaglio)" opener="@load(vm.self)"
                         src="@load('dizionari/generale/tariffaDirittoCategoriaLista.zul')"
                         vflex="1"/>
            </groupbox>

        </vlayout>


    </window>

</zk>