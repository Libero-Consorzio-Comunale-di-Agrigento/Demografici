<?xml version="1.0" encoding="UTF-8"?>
<?taglib uri="http://www.zkoss.org/dsp/web/core" prefix="c"?>

<zk xmlns="http://www.zkoss.org/2005/zul"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.zkoss.org/2005/zul http://www.zkoss.org/2005/zul/zul.xsd">

    <window viewModel="@id('vm') @init('restrict.certificazione.dizionari.generale.DatoGeneraleViewModel')"
            apply="org.zkoss.bind.BindComposer"
            border="none"
            width="100%" height="@load(vm.wCenterHeight)"
            sizable="false" closable="false">

        <tabbox hflex="1" vflex="1">
            <tabs>
                <tab label="@load(vm.etichette['Tipi_Certificato'])"/>
                <tab label="@load(vm.etichette['Terminalisti'])"/>
                <tab label="@load(vm.etichette['Sindaco'])"/>
                <tab label="@load(vm.etichette['Servizi'])"/>
                <tab label="@load(vm.etichette['Motivi_sospensione'])"/>
                <tab label="@load(vm.etichette['Tariffe_Diritti'])"/>
                <tab label="@load(vm.etichette['Modalita_rilascio'])"/>
                <tab label="@load(vm.etichette['Tipi_firma'])"/>
                <tab label="@load(vm.etichette['Validita'])"/>
            </tabs>
            <tabpanels>
                <tabpanel>
                    <include hflex="1" vflex="1"
                             src="/restrict/certificazione/dizionari/generale/tipoCertificatoLista.zul"/>
                </tabpanel>
                <tabpanel>
                    <include hflex="1" vflex="1"
                             src="/restrict/certificazione/dizionari/generale/terminalistaLista.zul"/>
                </tabpanel>
                <tabpanel>
                    <include hflex="1" vflex="1"
                             src="/restrict/certificazione/dizionari/generale/sindacoDettaglio.zul"/>
                </tabpanel>
                <tabpanel>
                    <include hflex="1" vflex="1"
                             src="/restrict/certificazione/dizionari/generale/servizioComunaleLista.zul"/>
                </tabpanel>
                <tabpanel>
                    <include hflex="1" vflex="1"
                             src="/restrict/certificazione/dizionari/generale/motivoSospensioneLista.zul"/>
                </tabpanel>
                <tabpanel>
                    <include hflex="1" vflex="1"
                             src="/restrict/certificazione/dizionari/generale/tariffaDirittoLista.zul"/>
                </tabpanel>
                <tabpanel>
                    <include hflex="1" vflex="1"
                             src="/restrict/certificazione/dizionari/generale/modalitaRilascioLista.zul"/>
                </tabpanel>
                <tabpanel>
                    <include hflex="1" vflex="1"
                             src="/restrict/certificazione/dizionari/generale/firmaLista.zul"/>
                </tabpanel>
                <tabpanel>
                    <include hflex="1" vflex="1"
                             src="/restrict/certificazione/dizionari/generale/validitaCertificatoLista.zul"/>
                </tabpanel>
            </tabpanels>
        </tabbox>

    </window>

</zk>