<?xml version="1.0" encoding="UTF-8"?>
<?taglib uri="http://www.zkoss.org/dsp/web/core" prefix="c"?>

<zk xmlns="http://www.zkoss.org/2005/zul"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.zkoss.org/2005/zul http://www.zkoss.org/2005/zul/zul.xsd">

    <window viewModel="@id('vm') @init('restrict.certificazione.dizionari.generale.TipoCertificatoDettaglioViewModel')"
            apply="org.zkoss.bind.BindComposer"
            border="none"
            width="100%" height="100%"
            sizable="false" closable="false">

        <vlayout vflex="1" sclass="scroll">

            <hlayout valign="middle">
                <controlBarDettaglio/>

                <label value="@load(vm.formLabel)" sclass="formTitle"/>
            </hlayout>

            <grid sclass="form">
                <rows>
                    <row>
                        <cell align="right" width="150px">
                            <label value="@load(vm.etichette['Categoria_Tipo_Certificato'])"/>
                        </cell>
                        <cell colspan="2">
                            <hlayout hflex="1">
                                <combobox model="@load(vm.listaCategoriaTipoCertificato)"
                                          selectedItem="@bind(vm.dettaglio.categoriaTipoCertificato) @converter('it.finmatica.zk.utils.PropertyConverter', property='id')"
                                          readonly="true" hflex="1"
                                          onSelect="@command('onSelectCategoria')">
                                    <template name="model">
                                        <comboitem
                                                label="@load(empty each ? vm.getEtichettaCategoriaNull() : each.descrizione)"
                                                value="@load(each)"/>
                                    </template>
                                </combobox>
                            </hlayout>
                        </cell>
                        <cell colspan="3"/>
                    </row>
                    <row>
                        <cell align="right">
                            <customLabel mandatory="true" value="@load(vm.etichette['Codice'])"/>
                        </cell>
                        <cell>
                            <textbox value="@bind(vm.dettaglio.id)" hflex="1" style="text-transform:uppercase" readonly="@load(vm.tipoOperazione.isUpdate())"/>
                        </cell>
                        <cell colspan="4"/>
                    </row>
                    <row>
                        <cell align="right">
                            <customLabel mandatory="true" value="@load(vm.etichette['Descrizione'])"/>
                        </cell>
                        <cell colspan="3">
                            <hlayout valign="middle">
                                <textbox value="@bind(vm.dettaglio.descrizione)" hflex="1"/>
                                <button image="/images/icon/action/16x16/cancel.png"
                                        tooltiptext="@load(vm.etichette['Cancella'])"
                                        onClick="@command('onCancellaCampoDizionario')">
                                    <custom-attributes proprieta="descrizione"/>
                                </button>
                            </hlayout>
                        </cell>
                        <cell colspan="2"/>
                    </row>
                    <row>
                        <cell align="right">
                            <label value="@load(vm.etichette['Competenza_On_Line'])"/>
                        </cell>
                        <cell colspan="5">
                            <label value="@load(vm.getEtichettaEnum(vm.dettaglio.categoriaTipoCertificato.tipoCompetenzaOnline))"
                                   style="font-weight:bold;"/>
                        </cell>
                    </row>
                    <row>
                        <cell align="right">
                            <label value="On-Line"/>
                        </cell>
                        <cell colspan="5">
                            <checkbox checked="@bind(vm.dettaglio.flagOnLine)"/>
                        </cell>
                    </row>
                    <row>
                        <cell align="right">
                            <label value="@load(vm.etichette['Dismesso'])"/>
                        </cell>
                        <cell colspan="5">
                            <checkbox checked="@bind(vm.dettaglio.flagDismesso)"/>
                        </cell>
                    </row>
                    <row>
                        <cell align="right">
                            <customLabel mandatory="true" value="@load(vm.etichette['Tipo_firma'])"/>
                        </cell>
                        <cell colspan="2">
                            <hlayout hflex="1">
                                <combobox model="@load(vm.listaFirma)"
                                          selectedItem="@bind(vm.dettaglio.firma) @converter('it.finmatica.zk.utils.PropertyConverter', property='id')"
                                          readonly="true" hflex="1">
                                    <template name="model">
                                        <comboitem
                                                label="@load(empty each?'- -':c:cat3(each.id, ' - ', each.descrizione))"
                                                value="@load(each)"/>
                                    </template>
                                </combobox>
                            </hlayout>
                        </cell>
                        <cell colspan="3"/>
                    </row>
                    <row>
                        <cell align="right">
                            <label value="@load(vm.etichette['Validita'])"/>
                        </cell>
                        <cell colspan="2">
                            <hlayout hflex="1">
                                <combobox model="@load(vm.listaValidita)"
                                          selectedItem="@bind(vm.dettaglio.validita) @converter('it.finmatica.zk.utils.PropertyConverter', property='id')"
                                          readonly="true" hflex="1">
                                    <template name="model">
                                        <comboitem
                                                label="@load(empty each?'- -':c:cat3(each.id, ' - ', each.descrizione))"
                                                value="@load(each)"/>
                                    </template>
                                </combobox>
                            </hlayout>
                        </cell>
                        <cell colspan="3"/>
                    </row>
                    <row>
                        <cell align="right">
                            <customLabel mandatory="@load(vm.dettaglio.tipoAttoEnum eq 'CIT')" value="@load(vm.labelTipoCertificatoEsterno)"/>
                        </cell>
                        <cell colspan="2">
                            <hlayout valign="middle" hflex="1">
                                <bandboxTipoCertificatoEsterno hflex="1"
                                                               value="@load(vm.dettaglio.tipoCertificatoEsterno.descrizione)"
                                                               tipoCompetenzaOnline="@load(vm.dettaglio.categoriaTipoCertificato.tipoCompetenzaOnline)"
                                                               onSelect="@command('onSelectTipoCertificatoEsterno')"/>
                                <button image="/images/icon/action/16x16/cancel.png"
                                        tooltiptext="@load(vm.etichette['Cancella'])"
                                        onClick="@command('onCancellaCampoDizionario')">
                                    <custom-attributes proprieta="tipoCertificatoEsterno"/>
                                </button>
                            </hlayout>
                        </cell>
                        <cell colspan="3"/>
                    </row>
                    <row>
                        <cell align="right">
                            <customLabel value="@load(vm.etichette['Modello'])"/>
                        </cell>
                        <cell colspan="2">
                            <hlayout valign="middle" hflex="1">
                                <textbox value="@bind(vm.modelloRelazione.modello.nome)"
                                         tooltiptext="@load(vm.modelloRelazione.modello.nome)" hflex="1"/>
                                <button visible="@bind(not empty vm.modelloRelazione.modello.id)"
                                        image="/images/icon/action/16x16/import.png"
                                        tooltiptext="@load(vm.etichette['scarica_modello_tooltip'])"
                                        onClick="@command('onDownloadAllegato')"/>
                                <button image="/images/icon/action/16x16/export.png" upload="true"
                                        tooltiptext="@load(vm.etichette['inserisci_modello_tooltip'])"
                                        onUpload="@command('onUploadAllegato')"/>
                            </hlayout>
                        </cell>
                        <cell colspan="3"/>
                    </row>
                    <row>
                        <cell align="right">
                            <label value="@load(vm.etichette['Formato_testo'])"/>
                        </cell>
                        <cell colspan="2">
                            <combobox model="@load(vm.listaFormatiTesto)" readonly="true"
                                      selectedItem="@bind(vm.modelloRelazione.modello.formatoTesto)">
                                <template name="model">
                                    <comboitem label="@load(empty each?'- -':each)" value="@load(each)"/>
                                </template>
                            </combobox>
                        </cell>
                        <cell colspan="3"/>
                    </row>
                    <row>
                        <cell colspan="6">
                            <groupbox closable="false">
                                <caption label="@load(vm.etichette['Beneficiario'])"/>
                                <grid sclass="form">
                                    <rows>
                                        <row>
                                            <cell align="right" width="150px">
                                                <customLabel mandatory="@load(vm.dettaglio.isStatoCivile())" value="@load(vm.etichette['Filtro'])"/>
                                            </cell>
                                            <cell colspan="2">
                                                <hlayout hflex="1">
                                                    <combobox model="@load(vm.listaFiltro)"
                                                              selectedItem="@bind(vm.dettaglio.filtro) @converter('it.finmatica.zk.utils.PropertyConverter', property='id')"
                                                              readonly="true" hflex="1">
                                                        <template name="model">
                                                            <comboitem
                                                                    label="@load(empty each?'- -':c:cat3(each.id, ' - ', each.descrizione))"
                                                                    value="@load(each)"/>
                                                        </template>
                                                    </combobox>
                                                </hlayout>
                                            </cell>
                                            <cell colspan="3"/>
                                        </row>
                                        <row visible="@load(not vm.dettaglio.categoriaTipoCertificato.isStatoCivile())">
                                            <cell align="right">
                                                <customLabel value="@load(vm.etichette['Codice_controllo'])"/>
                                            </cell>
                                            <cell colspan="2">
                                                <hlayout hflex="1">
                                                    <combobox model="@load(vm.listaCodiceControllo)"
                                                              selectedItem="@bind(vm.dettaglio.codiceControllo) @converter('it.finmatica.zk.utils.PropertyConverter', property='id')"
                                                              readonly="true" hflex="1">
                                                        <template name="model">
                                                            <comboitem
                                                                    label="@load(empty each?'- -':c:cat3(each.id, ' - ', each.descrizione))"
                                                                    value="@load(each)"/>
                                                        </template>
                                                    </combobox>
                                                </hlayout>
                                            </cell>
                                            <cell colspan="3"/>
                                        </row>
                                    </rows>
                                </grid>
                            </groupbox>
                        </cell>
                    </row>
                    <row visible="@load(not empty vm.dettaglio.categoriaTipoCertificato.tipoCompetenzaOnline)">
                        <cell colspan="6">
                            <groupbox closable="false">
                                <caption
                                        label="@load(vm.getEtichettaEnum(vm.dettaglio.categoriaTipoCertificato.tipoCompetenzaOnline))"/>
                                <!-- STATO CIVILE -->
                                <grid sclass="form"
                                      visible="@load(vm.dettaglio.categoriaTipoCertificato.isStatoCivile())">
                                    <rows>
                                        <row>
                                            <cell align="right" width="200px">
                                                <customLabel mandatory="true"
                                                             value="@load(vm.etichette['Tipi_di_Atto'])"/>
                                            </cell>
                                            <cell hflex="6">
                                                <hlayout hflex="1">
                                                    <radiogroup model="@load(vm.listaTipoAtto)"
                                                                selectedItem="@bind(vm.dettaglio.tipoAttoEnum) @converter('it.finmatica.zk.utils.PropertyConverter', property='id')">
                                                        <template name="model">
                                                            <radio label="@load(vm.getEtichettaPluralEnum(each) )"
                                                                   value="@load(each)"
                                                                   style="padding:20px"/>
                                                        </template>
                                                    </radiogroup>
                                                </hlayout>
                                            </cell>
                                        </row>
                                        <row>
                                            <cell align="right">
                                                <label value="@load(vm.etichette['Controllo_Annotazioni'])"/>
                                            </cell>
                                            <cell>
                                                <checkbox checked="@bind(vm.dettaglio.flagAnnotazioni)"/>
                                            </cell>
                                        </row>
                                    </rows>
                                </grid>
                                <!-- ANAGRAFE -->
                                <grid sclass="form" visible="@load(vm.dettaglio.categoriaTipoCertificato.isAnagrafe())">
                                    <rows>
                                        <row>
                                            <cell align="right" width="150px">
                                                <label value="@load(vm.etichette['Storico'])"/>
                                            </cell>
                                            <cell>
                                                <checkbox checked="@bind(vm.dettaglio.flagStorico) @converter('it.finmatica.de4gsdzk.zkutils.ETipoSiNoCheckboxConverter')" />
                                            </cell>
                                        </row>
                                        <row>
                                            <cell align="right">
                                                <label value="@load(vm.etichette['Stato_di_famiglia'])"/>
                                            </cell>
                                            <cell>
                                                <checkbox checked="@bind(vm.dettaglio.flagStatoDiFamiglia)"/>
                                            </cell>
                                        </row>
                                        <row>
                                            <cell colspan="2">
                                                <groupbox closable="false">
                                                    <caption label="@load(vm.etichette['Documento_Individuo'])"/>
                                                    <grid sclass="form">
                                                        <rows>
                                                            <row>
                                                                <cell align="right" width="150px">
                                                                    <label value="@load(vm.etichette['Tipo_Documento'])"/>
                                                                </cell>
                                                                <cell colspan="2">
                                                                    <hlayout valign="middle" hflex="1">
                                                                        <bandboxTipoDocumentoAnagrafe hflex="1"
                                                                                                      tipoDocumentoAnagrafeFiltro="@load(vm.tipoDocumentoAnagrafeFiltro)"
                                                                                                      value="@load(vm.dettaglio.tipoDocumentoAnagrafe.descrizioneEstesa)"
                                                                                                      onSelect="@command('onSelectTipoDocumentoAnagrafe')"/>
                                                                        <button image="/images/icon/action/16x16/cancel.png"
                                                                                tooltiptext="@load(vm.etichette['Cancella'])"
                                                                                onClick="@command('onCancellaCampoDizionario')">
                                                                            <custom-attributes
                                                                                    proprieta="tipoDocumentoAnagrafe"/>
                                                                        </button>
                                                                    </hlayout>
                                                                </cell>
                                                                <cell colspan="3"/>
                                                            </row>
                                                            <row>
                                                                <cell align="right">
                                                                    <label value="@load(vm.etichette['Numero'])"/>
                                                                </cell>
                                                                <cell colspan="3">
                                                                    <checkbox
                                                                            checked="@bind(vm.dettaglio.flagNumeraDocumentoAnagrafe)"/>
                                                                </cell>
                                                                <cell colspan="2"/>
                                                            </row>
                                                        </rows>
                                                    </grid>
                                                </groupbox>
                                            </cell>
                                        </row>
                                    </rows>
                                </grid>
                            </groupbox>
                        </cell>
                    </row>
                </rows>
            </grid>
        </vlayout>

    </window>

</zk>