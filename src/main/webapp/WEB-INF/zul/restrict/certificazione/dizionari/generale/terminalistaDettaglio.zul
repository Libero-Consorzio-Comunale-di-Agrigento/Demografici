<?xml version="1.0" encoding="UTF-8"?>
<?taglib uri="http://www.zkoss.org/dsp/web/core" prefix="c"?>

<zk xmlns="http://www.zkoss.org/2005/zul"
	xmlns:h="http://www.w3.org/1999/xhtml"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul http://www.zkoss.org/2005/zul/zul.xsd">

	<window viewModel="@id('vm') @init('restrict.certificazione.dizionari.generale.TerminalistaDettaglioViewModel')"
			apply="org.zkoss.bind.BindComposer"
			border="none"
			width="100%" height="100%"
			sizable="false" closable="false">

		<vlayout vflex="1">

			<hlayout valign="middle">
				<controlBarDettaglio/>

				<label value="@load(vm.formLabel)" sclass="formTitle"/>
			</hlayout>

			<grid sclass="form">
				<rows>
					<row>
						<cell align="right" width="150px">
							<h:span class="mandatoryLabel">*</h:span><label value="@load(vm.etichette['Codice_Utente'])"/>
						</cell>
						<cell>
							<textbox value="@bind(vm.dettaglio.id)" disabled="@load(vm.tipoOperazione.isUpdate())"/>
						</cell>
					</row>
					<row>
						<cell align="right">
							<label value="@load(vm.etichette['Cognome'])"/>
						</cell>
						<cell>
							<hlayout valign="middle">
								<textbox value="@bind(vm.dettaglio.cognome)" hflex="1"/>
								<button image="/images/icon/action/16x16/cancel.png"
										tooltiptext="@load(vm.etichette['Cancella'])"
										onClick="@command('onCancellaCampoDizionario')">
									<custom-attributes proprieta="cognome"/>
								</button>
							</hlayout>
						</cell>
					</row>
					<row>
						<cell align="right">
							<label value="@load(vm.etichette['Nome'])"/>
						</cell>
						<cell>
							<hlayout valign="middle">
								<textbox value="@bind(vm.dettaglio.nome)" hflex="1"/>
								<button image="/images/icon/action/16x16/cancel.png"
										tooltiptext="@load(vm.etichette['Cancella'])"
										onClick="@command('onCancellaCampoDizionario')">
									<custom-attributes proprieta="nome"/>
								</button>
							</hlayout>
						</cell>
					</row>
					<row>
						<cell align="right">
							<label value="@load(vm.etichette['Qualifica'])"/>
						</cell>
						<cell>
							<hlayout valign="middle">
								<textbox value="@bind(vm.dettaglio.qualifica)" hflex="1"/>
								<button image="/images/icon/action/16x16/cancel.png"
										tooltiptext="@load(vm.etichette['Cancella'])"
										onClick="@command('onCancellaCampoDizionario')">
									<custom-attributes proprieta="qualifica"/>
								</button>
							</hlayout>
						</cell>
					</row>
					<row>
						<cell align="right">
							<label value="@load(vm.etichette['Email'])"/>
						</cell>
						<cell>
							<hlayout valign="middle">
								<textbox value="@bind(vm.dettaglio.indirizzoMail)" hflex="1"/>
								<button image="/images/icon/action/16x16/cancel.png"
										tooltiptext="@load(vm.etichette['Cancella'])"
										onClick="@command('onCancellaCampoDizionario')">
									<custom-attributes proprieta="indirizzoMail"/>
								</button>
							</hlayout>
						</cell>
					</row>
					<row>
						<cell align="right">
							<label value="@load(vm.etichette['Numero_telefono'])"/>
						</cell>
						<cell>
							<hlayout valign="middle" hflex="1">
								<textbox value="@bind(vm.dettaglio.telefono)" width="350px"/>
								<button image="/images/icon/action/16x16/cancel.png"
										tooltiptext="@load(vm.etichette['Cancella'])" onClick="@command('onCancellaCampoDizionario')">
									<custom-attributes proprieta="telefono"/>
								</button>
								<space/>
							</hlayout>
						</cell>
					</row>
					<row>
						<cell align="right">
							<label value="@load(vm.etichette['Nominativo_Stampa'])"/>
						</cell>
						<cell>
							<checkbox checked="@bind(vm.dettaglio.flagInStampa)"/>
						</cell>
					</row>
					<row>
						<cell align="right">
							<label value="@load(vm.etichette['Fondo_Cassa'])"/>
						</cell>
						<cell>
							<checkbox checked="@bind(vm.dettaglio.flagFondoCassa)"/>
						</cell>
					</row>
				</rows>
			</grid>

		</vlayout>

	</window>

</zk>