<?xml version="1.0" encoding="UTF-8"?>
<?taglib uri="http://www.zkoss.org/dsp/web/core" prefix="c"?>

<zk xmlns="http://www.zkoss.org/2005/zul"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.zkoss.org/2005/zul http://www.zkoss.org/2005/zul/zul.xsd">

    <window viewModel="@id('vm') @init('restrict.certificazione.dizionari.generale.TipoCertificatoListaViewModel')"
            apply="org.zkoss.bind.BindComposer"
            border="none"
            width="100%" height="100%"
            sizable="false" closable="false">

        <hlayout valign="middle">
            <controlBarLista/>

            <label value="@load(vm.formLabel)" sclass="formTitle"/>
        </hlayout>

        <groupbox closable="false">
            <grid sclass="form">
                <rows>
                    <row>
                        <cell align="right" width="120px">
                            <label value="@load(vm.etichette['Categoria_Tipo_Certificato'])"/>
                        </cell>
                        <cell colspan="2">
                            <hlayout hflex="1">
                                <combobox model="@load(vm.listaCategoriaTipoCertificato)"
                                          selectedItem="@bind(vm.selectedCategoria) @converter('it.finmatica.zk.utils.PropertyConverter', property='id')"
                                          onSelect="@command('onSelectCategoria')"
                                          readonly="true" hflex="1">
                                    <template name="model">
                                        <comboitem
                                                label="@load(empty each?'- -':each.descrizione)"
                                                value="@load(each)"/>
                                    </template>
                                </combobox>
                            </hlayout>
                        </cell>
                        <cell colspan="3"/>
                    </row>
                </rows>
            </grid>
        </groupbox>

        <vlayout vflex="1">

            <orderByBlock/>

            <listbox model="@load(vm.lista)" selectedItem="@bind(vm.dettaglio)" nonselectableTags="" vflex="1"
                     emptyMessage="@load(vm.etichette['Nessun_dato_disponibile'])">
                <listhead>
                    <listheader label="@load(vm.etichette['Codice'])" hflex="1"/>
                    <listheader label="@load(vm.etichette['Descrizione'])" hflex="5"/>
                    <listheader label="@load(vm.etichette['Dismesso'])" width="70px"/>
                    <listheader label="" width="52px"/>
                </listhead>
                <template name="model" var="item">
                    <listitem onDoubleClick="@command('onModifica')">
                        <listcell label="@load(item.id)"/>
                        <listcell label="@load(item.descrizione)"/>
                        <listcell sclass="testo-al-centro">
                            <checkbox checked="@load(item.flagDismesso)" disabled="true"/>
                        </listcell>
                        <listcell>
                            <button image="/images/icon/action/18x18/edit.png"
                                    tooltiptext="@load(vm.etichette['modifica_tooltip'])"
                                    visible="@load(not empty item.id)"
                                    onClick="@command('onModifica')"/>
                        </listcell>
                    </listitem>
                </template>
            </listbox>

        </vlayout>

    </window>

</zk>