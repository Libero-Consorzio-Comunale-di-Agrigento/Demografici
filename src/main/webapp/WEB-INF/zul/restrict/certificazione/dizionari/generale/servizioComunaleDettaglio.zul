<?xml version="1.0" encoding="UTF-8"?>
<?taglib uri="http://www.zkoss.org/dsp/web/core" prefix="c"?>

<zk xmlns="http://www.zkoss.org/2005/zul"
	xmlns:h="http://www.w3.org/1999/xhtml"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul http://www.zkoss.org/2005/zul/zul.xsd">

	<window viewModel="@id('vm') @init('restrict.certificazione.dizionari.generale.ServizioComunaleDettaglioViewModel')"
			apply="org.zkoss.bind.BindComposer"
			border="none"
			width="100%" height="100%"
			sizable="false" closable="false">

		<vlayout vflex="1" sclass="scroll">

			<hlayout valign="middle">
				<controlBarDettaglio/>

				<label value="@load(vm.formLabel)" sclass="formTitle"/>
			</hlayout>

			<grid sclass="form">
				<rows>
					<row>
						<cell align="right" width="150px">
							<h:span class="mandatoryLabel">*</h:span><label value="@load(vm.etichette['Codice'])"/>
						</cell>
						<cell>
							<textbox value="@bind(vm.dettaglio.id)" disabled="@load(vm.tipoOperazione.isUpdate())"/>
						</cell>
					</row>
					<row>
						<cell align="right">
							<label value="@load(vm.etichette['Nome'])"/>
						</cell>
						<cell>
							<hlayout valign="middle">
								<textbox value="@bind(vm.dettaglio.nome)" hflex="1"/>
								<button image="/images/icon/action/16x16/cancel.png"
										tooltiptext="@load(vm.etichette['Cancella'])"
										onClick="@command('onCancellaCampoDizionario')">
									<custom-attributes proprieta="nome"/>
								</button>
							</hlayout>
						</cell>
					</row>
					<row>
						<cell align="right">
							<label value="@load(vm.etichette['Descrizione'])"/>
						</cell>
						<cell>
							<hlayout valign="middle">
								<textbox value="@bind(vm.dettaglio.descrizione)" hflex="1"/>
								<button image="/images/icon/action/16x16/cancel.png"
										tooltiptext="@load(vm.etichette['Cancella'])"
										onClick="@command('onCancellaCampoDizionario')">
									<custom-attributes proprieta="descrizione"/>
								</button>
							</hlayout>
						</cell>
					</row>
					<row>
						<cell align="right">
							<label value="@load(vm.etichette['Responsabile'])"/>
						</cell>
						<cell>
							<hlayout valign="middle">
								<textbox value="@bind(vm.dettaglio.responsabile)" hflex="1"/>
								<button image="/images/icon/action/16x16/cancel.png"
										tooltiptext="@load(vm.etichette['Cancella'])"
										onClick="@command('onCancellaCampoDizionario')">
									<custom-attributes proprieta="responsabile"/>
								</button>
							</hlayout>
						</cell>
					</row>
					<row>
						<cell align="right">
							<label value="@load(vm.etichette['Orari1'])"/>
						</cell>
						<cell>
							<hlayout valign="middle">
								<textbox value="@bind(vm.dettaglio.orari1)" hflex="1"/>
								<button image="/images/icon/action/16x16/cancel.png"
										tooltiptext="@load(vm.etichette['Cancella'])"
										onClick="@command('onCancellaCampoDizionario')">
									<custom-attributes proprieta="orari1"/>
								</button>
							</hlayout>
						</cell>
					</row>
					<row>
						<cell align="right">
							<label value="@load(vm.etichette['Orari2'])"/>
						</cell>
						<cell>
							<hlayout valign="middle">
								<textbox value="@bind(vm.dettaglio.orari2)" hflex="1"/>
								<button image="/images/icon/action/16x16/cancel.png"
										tooltiptext="@load(vm.etichette['Cancella'])"
										onClick="@command('onCancellaCampoDizionario')">
									<custom-attributes proprieta="orari2"/>
								</button>
							</hlayout>
						</cell>
					</row>
					<row>
						<cell align="right">
							<label value="@load(vm.etichette['Orari3'])"/>
						</cell>
						<cell>
							<hlayout valign="middle">
								<textbox value="@bind(vm.dettaglio.orari3)" hflex="1"/>
								<button image="/images/icon/action/16x16/cancel.png"
										tooltiptext="@load(vm.etichette['Cancella'])"
										onClick="@command('onCancellaCampoDizionario')">
									<custom-attributes proprieta="orari3"/>
								</button>
							</hlayout>
						</cell>
					</row>
					<row>
						<cell align="right">
							<label value="@load(vm.etichette['Orari4'])"/>
						</cell>
						<cell>
							<hlayout valign="middle">
								<textbox value="@bind(vm.dettaglio.orari4)" hflex="1"/>
								<button image="/images/icon/action/16x16/cancel.png"
										tooltiptext="@load(vm.etichette['Cancella'])"
										onClick="@command('onCancellaCampoDizionario')">
									<custom-attributes proprieta="orari4"/>
								</button>
							</hlayout>
						</cell>
					</row>
					<row>
						<cell align="right">
							<label value="@load(vm.etichette['Orari5'])"/>
						</cell>
						<cell>
							<hlayout valign="middle">
								<textbox value="@bind(vm.dettaglio.orari5)" hflex="1"/>
								<button image="/images/icon/action/16x16/cancel.png"
										tooltiptext="@load(vm.etichette['Cancella'])"
										onClick="@command('onCancellaCampoDizionario')">
									<custom-attributes proprieta="orari5"/>
								</button>
							</hlayout>
						</cell>
					</row>
					<row>
						<cell align="right">
							<label value="@load(vm.etichette['Orari6'])"/>
						</cell>
						<cell>
							<hlayout valign="middle">
								<textbox value="@bind(vm.dettaglio.orari6)" hflex="1"/>
								<button image="/images/icon/action/16x16/cancel.png"
										tooltiptext="@load(vm.etichette['Cancella'])"
										onClick="@command('onCancellaCampoDizionario')">
									<custom-attributes proprieta="orari6"/>
								</button>
							</hlayout>
						</cell>
					</row>
					<row>
						<cell align="right">
							<label value="@load(vm.etichette['Orari7'])"/>
						</cell>
						<cell>
							<hlayout valign="middle">
								<textbox value="@bind(vm.dettaglio.orari7)" hflex="1"/>
								<button image="/images/icon/action/16x16/cancel.png"
										tooltiptext="@load(vm.etichette['Cancella'])"
										onClick="@command('onCancellaCampoDizionario')">
									<custom-attributes proprieta="orari7"/>
								</button>
							</hlayout>
						</cell>
					</row>
                    <row>
                        <cell align="right">
                            <label value="@load(vm.etichette['Indirizzo'])"/>
                        </cell>
                        <cell>
                            <hlayout valign="middle">
                                <textbox value="@bind(vm.dettaglio.indirizzo)" hflex="1"/>
                                <button image="/images/icon/action/16x16/cancel.png"
                                        tooltiptext="@load(vm.etichette['Cancella'])"
                                        onClick="@command('onCancellaCampoDizionario')">
                                    <custom-attributes proprieta="indirizzo"/>
                                </button>
                            </hlayout>
                        </cell>
                    </row>
                    <row>
                        <cell align="right">
                            <label value="@load(vm.etichette['Email'])"/>
                        </cell>
                        <cell>
                            <hlayout valign="middle">
                                <textbox value="@bind(vm.dettaglio.indirizzoMail)" hflex="1"/>
                                <button image="/images/icon/action/16x16/cancel.png"
                                        tooltiptext="@load(vm.etichette['Cancella'])"
                                        onClick="@command('onCancellaCampoDizionario')">
                                    <custom-attributes proprieta="indirizzoMail"/>
                                </button>
                            </hlayout>
                        </cell>
                    </row>
                    <row>
                        <cell align="right">
                            <label value="@load(vm.etichette['PEC'])"/>
                        </cell>
                        <cell>
                            <hlayout valign="middle">
                                <textbox value="@bind(vm.dettaglio.pec)" hflex="1"/>
                                <button image="/images/icon/action/16x16/cancel.png"
                                        tooltiptext="@load(vm.etichette['Cancella'])"
                                        onClick="@command('onCancellaCampoDizionario')">
                                    <custom-attributes proprieta="pec"/>
                                </button>
                            </hlayout>
                        </cell>
                    </row>
					<row>
						<cell align="right">
							<label value="@load(vm.etichette['Numero_telefono'])"/>
						</cell>
						<cell>
							<hlayout valign="middle">
								<textbox value="@bind(vm.dettaglio.telefono)" hflex="1"/>
								<button image="/images/icon/action/16x16/cancel.png"
										tooltiptext="@load(vm.etichette['Cancella'])"
										onClick="@command('onCancellaCampoDizionario')">
									<custom-attributes proprieta="telefono"/>
								</button>
							</hlayout>
						</cell>
					</row>
				</rows>
			</grid>

		</vlayout>

	</window>

</zk>