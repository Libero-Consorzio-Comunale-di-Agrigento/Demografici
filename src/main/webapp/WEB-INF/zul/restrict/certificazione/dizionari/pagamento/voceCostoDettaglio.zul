<?xml version="1.0" encoding="UTF-8"?>
<?taglib uri="http://www.zkoss.org/dsp/web/core" prefix="c"?>

<zk xmlns="http://www.zkoss.org/2005/zul"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.zkoss.org/2005/zul http://www.zkoss.org/2005/zul/zul.xsd">

    <window viewModel="@id('vm') @init('restrict.certificazione.dizionari.pagamento.VoceCostoDettaglioViewModel')"
            apply="org.zkoss.bind.BindComposer"
            border="none"
            width="100%" height="100%"
            sizable="false" closable="false">

        <vlayout vflex="1">

            <hlayout valign="middle">
                <controlBarDettaglio/>

                <label value="@load(vm.formLabel)" sclass="formTitle"/>
            </hlayout>

            <grid sclass="form">
                <columns>
                    <column width="150px"/>
                    <column/>
                </columns>
                <rows>
                    <row>
                        <cell colspan="2">
                            <groupbox closable="false">
                                <caption label="@load(vm.etichette['Tariffa_Diritto'])"/>
                                <grid>
                                    <columns>
                                        <column width="130px"/>
                                        <column width="160px"/>
                                        <column />
                                    </columns>
                                    <rows>
                                        <row>
                                            <cell align="right">
                                                <label value="@load(vm.etichette['Codice_diritto'])"/>
                                            </cell>
                                            <cell>
                                                <customLabel bold="true"
                                                             value="@load(c:cat3(vm.dettaglio.tariffaDiritto.diritto.id, ' - ', vm.getEtichettaEnum(vm.dettaglio.tariffaDiritto.diritto)))"/>
                                            </cell>
                                            <cell/>
                                        </row>
                                        <row>
                                            <cell align="right">
                                                <label value="@load(vm.etichette['Fascia_tariffaria'])"/>
                                            </cell>
                                            <cell>
                                                <customLabel bold="true"
                                                             value="@load(vm.dettaglio.tariffaDiritto.fasciaTariffaria)"/>
                                            </cell>
                                            <cell/>
                                        </row>
                                        <row>
                                            <cell align="right">
                                                <label value="@load(vm.etichette['Descrizione'])"/>
                                            </cell>
                                            <cell colspan="2">
                                                <customLabel bold="true"
                                                             value="@load(vm.dettaglio.tariffaDiritto.descrizione)"/>
                                            </cell>
                                        </row>
                                        <row>
                                            <cell align="right">
                                                <label value="@load(vm.etichette['Importo_1'])"/>
                                            </cell>
                                            <cell>
                                                <currencylabel bold="true"
                                                               value="@load(vm.dettaglio.tariffaDiritto.importo1)"/>
                                            </cell>
                                            <cell/>
                                        </row>
                                        <row>
                                            <cell align="right">
                                                <label value="@load(vm.etichette['Importo_2'])"/>
                                            </cell>
                                            <cell>
                                                <currencylabel bold="true"
                                                               value="@load(vm.dettaglio.tariffaDiritto.importo2)"/>
                                            </cell>
                                            <cell/>
                                        </row>
                                    </rows>
                                </grid>
                            </groupbox>
                        </cell>
                    </row>
                    <row>
                        <cell align="right" width="150px">
                            <label value="@load(vm.etichette['Voce_costo_1_codice'])"/>
                        </cell>
                        <cell>
                            <textbox value="@bind(vm.dettaglio.voceCosto1)" hflex="1"/>
                        </cell>
                    </row>
                    <row>
                        <cell align="right">
                            <label value="@load(vm.etichette['Voce_costo_2_codice'])"/>
                        </cell>
                        <cell>
                            <textbox value="@bind(vm.dettaglio.voceCosto2)" hflex="1"/>
                        </cell>
                    </row>
                    <zk if="${vm.showDepagColumns}">
                        <row>
                            <cell align="right">
                                <label value="@load(vm.etichette['Anno_accertamento'])"/>
                            </cell>
                            <cell>
                                <intbox value="@bind(vm.dettaglio.annoAccertamento)"/>
                            </cell>
                        </row>
                        <row>
                            <cell align="right">
                                <label value="@load(vm.etichette['Numero_accertamento'])"/>
                            </cell>
                            <cell>
                                <intbox value="@bind(vm.dettaglio.numeroAccertamento)"/>
                            </cell>
                        </row>
                    </zk>
                </rows>
            </grid>

        </vlayout>

    </window>

</zk>