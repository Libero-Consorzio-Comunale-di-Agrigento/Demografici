<?xml version="1.0" encoding="UTF-8"?>
<?taglib uri="http://www.zkoss.org/dsp/web/core" prefix="c"?>
<?xel-method prefix="c" name="getAttoCellSclass" class="it.finmatica.de4gsdzk.utils.FormUtils" signature="java.lang.String getAttoCellSclass(it.finmatica.de4gsdzk.CivAttoBaseDomain)"?>

<zk xmlns="http://www.zkoss.org/2005/zul"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.zkoss.org/2005/zul http://www.zkoss.org/2005/zul/zul.xsd">

    <window viewModel="@id('vm') @init('restrict.certificazione.StampaCertificatiListaViewModel')"
            apply="org.zkoss.bind.BindComposer"
            border="none"
            width="100%" height="100%"
            sizable="false" closable="false">

        <hlayout valign="middle">
            <controlBarStampa/>

            <label value="@load(vm.formLabel)" sclass="formTitle"/>
        </hlayout>

        <vlayout vflex="1">

            <groupbox closable="false">
                <grid sclass="form">
                    <rows>
                        <row>
                            <cell align="right" width="90px">
                                <label value="@load(vm.etichette['Data_emissione'])"/>
                            </cell>
                            <cell width="300px">
                                <hlayout valign="middle">
                                    <label value="@load(vm.etichette['Da'])"/>
                                    <datebox format="dd/MM/yyyy" value="@bind(vm.ricerca.dataEmissioneDal)"
                                             width="100px"/>
                                    <space/>
                                    <label value="@load(vm.etichette['A'])"/>
                                    <datebox format="dd/MM/yyyy" value="@bind(vm.ricerca.dataEmissioneAl)"
                                             width="100px"/>
                                    <button image="/images/icon/action/16x16/cancel.png"
                                            tooltiptext="@load(vm.etichette['Cancella'])"
                                            onClick="@command('onCancellaCampoRicerca')">
                                        <custom-attributes proprieta="dataEmissioneDal,dataEmissioneAl"/>
                                    </button>
                                </hlayout>
                            </cell>
                            <cell align="right" width="100px">
                                <label value="@load(vm.etichette['Terminalista'])"/>
                            </cell>
                            <cell>
                                <hlayout valign="middle" hflex="1">
                                    <bandboxTerminalista hflex="1"
                                                         value="@load(vm.ricerca.terminalista.cognomeNome)"
                                                         onSelect="@command('onSelectTerminalista')"/>
                                    <button image="/images/icon/action/16x16/cancel.png"
                                            tooltiptext="@load(vm.etichette['Cancella'])"
                                            onClick="@command('onCancellaCampoRicerca')">
                                        <custom-attributes proprieta="terminalista"/>
                                    </button>
                                </hlayout>
                            </cell>
                            <cell align="right" width="150px">
                                <label value="@load(vm.etichette['Escludi_annullati'])"
                                       onCheck="@command('onRicerca')"/>
                            </cell>
                            <cell width="40px">
                                <checkbox checked="@bind(vm.ricerca.escludiAnnullati)"
                                          onCheck="@command('onRicerca')"/>
                            </cell>
                            <cell align="right" width="100px">
                                <label value="@load(vm.etichette['Stampa_Riepilogo'])"
                                       onCheck="@command('onRicerca')"/>
                            </cell>
                            <cell width="40px">
                                <checkbox checked="@bind(vm.ricerca.riepilogo.stampaRiepilogo)"
                                          onCheck="@command('onRicerca')"/>
                            </cell>
                            <cell width="40px"/>
                        </row>
                        <row>
                            <cell align="right">
                                <label value="@load(vm.etichette['Modalita_rilascio'])"/>
                            </cell>
                            <cell>
                                <hlayout valign="middle" hflex="1">
                                    <bandboxModalitaRilascio hflex="1"
                                                                        value="@load(vm.ricerca.modalitaRilascio.descrizione)"
                                                                        onSelect="@command('onSelectModalitaRilascio')"/>
                                    <button image="/images/icon/action/16x16/cancel.png"
                                            tooltiptext="@load(vm.etichette['Cancella'])"
                                            onClick="@command('onCancellaCampoRicerca')">
                                        <custom-attributes proprieta="modalitaRilascio"/>
                                    </button>
                                </hlayout>
                            </cell>
                            <cell align="right">
                                <label value="@load(vm.etichette['Tipo_pagamento'])"/>
                            </cell>
                            <cell>
                                <combobox model="@load(vm.listaTipoPagamento)" readonly="true" hflex="1"
                                          selectedItem="@bind(vm.ricerca.tipoPagamento) @converter('it.finmatica.zk.utils.PropertyConverter', property='id')"
                                          onSelect="@command('onRicerca')">
                                    <template name="model">
                                        <comboitem label="@load(empty each?vm.etichette['Tutti']:each.descrizione)"
                                                   value="@load(each)"/>
                                    </template>
                                </combobox>
                            </cell>
                            <cell align="right">
                                <label value="@load(vm.etichette['Stampa_Solo_Carta_Identita'])"/>
                            </cell>
                            <cell>
                                <checkbox checked="@bind(vm.ricerca.soloCartaIdentita)"
                                          onCheck="@command('onRicerca')"/>
                            </cell>
                            <cell align="right">
                                <label value="@load(vm.etichette['Stampa_Solo_Bollo'])"/>
                            </cell>
                            <cell>
                                <checkbox checked="@bind(vm.ricerca.soloBollo)"
                                          onCheck="@command('onRicerca')"/>
                            </cell>
                            <cell align="right">
                                <hlayout valign="middle">
                                    <button image="/images/icon/action/16x16/search.png"
                                            tooltiptext="@load(vm.etichette['Effettua_Ricerca'])"
                                            onClick="@command('onRicerca')"/>
                                </hlayout>
                            </cell>
                        </row>
                    </rows>
                </grid>
            </groupbox>

            <orderByBlock/>

            <listbox model="@load(vm.lista)" nonselectableTags="" vflex="1"
                     emptyMessage="@load(vm.etichette['Nessun_dato_disponibile'])">
                <listhead sizable="true">
                    <listheader label="@load(vm.etichette['Data_emissione'])" hflex="min"/>
                    <listheader label="@load(vm.etichette['Progressivo_emissione'])" hflex="min"/>
                    <listheader label="@load(vm.etichette['Annullato'])" hflex="min"/>
                    <listheader label="@load(vm.etichette['Descrizione'])"/>
                    <listheader label="@load(vm.etichette['Beneficiario'])"/>
                    <listheader label="@load(vm.etichette['Diritti_segreteria_abbr'])" hflex="min"
                                style="min-width: 60px;"/>
                    <listheader label="@load(vm.etichette['Diritti_stato_civile_abbr'])" hflex="min"
                                style="min-width: 60px;"/>
                    <listheader label="@load(vm.etichette['Diritti_carta_identita_abbr'])" hflex="min"
                                style="min-width: 60px;"/>
                    <listheader label="@load(vm.etichette['Rimborso_stampati_abbr'])" hflex="min"
                                style="min-width: 60px;"/>
                    <listheader label="@load(vm.etichette['Bollo'])" hflex="min" style="min-width: 60px;"/>
                    <listheader label="@load(vm.etichette['Totale'])" hflex="min" style="min-width: 60px;"/>
                </listhead>
                <template name="model" var="item">
                    <listitem>
                        <listcell>
                            <label value="@load(empty item.dataEmissione? null:(c:formatDate(item.dataEmissione, 'dd/MM/yyyy')))"/>
                        </listcell>
                        <listcell label="@load(item.progressivoEmissione)"/>
                        <listcell sclass="testo-al-centro">
                            <checkbox checked="@load(item.isAnnullato())"
                                      disabled="true"/>
                        </listcell>
                        <listcell label="@load(item.tipoCertificato.descrizione)"/>
                        <listcell label="@load(item.beneficiario.cognomeNome)"/>
                        <listcell>
                            <currencylabel value="@load(item.segreteria)"/>
                        </listcell>
                        <listcell>
                            <currencylabel value="@load(item.statoCivile)"/>
                        </listcell>
                        <listcell>
                            <currencylabel value="@load(item.cartaIdentita)"/>
                        </listcell>
                        <listcell>
                            <currencylabel value="@load(item.rimborsoStampati)"/>
                        </listcell>
                        <listcell>
                            <currencylabel value="@load(item.bollo)"/>
                        </listcell>
                        <listcell>
                            <currencylabel value="@load(item.totale)"/>
                        </listcell>
                    </listitem>
                </template>
            </listbox>

        </vlayout>

    </window>

</zk>