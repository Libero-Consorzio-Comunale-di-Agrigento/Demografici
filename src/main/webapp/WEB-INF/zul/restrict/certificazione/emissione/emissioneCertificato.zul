<?xml version="1.0" encoding="UTF-8"?>
<?taglib uri="http://www.zkoss.org/dsp/web/core" prefix="c"?>
<?component name="templateSezioneBeneficiarioEmissioneCertificato" macroURI="/restrict/certificazione/emissione/templateSezioneBeneficiarioEmissioneCertificato.zul" inline="true"?>
<?component name="templateSezioneRichiedenteEmissioneCertificato" macroURI="/restrict/certificazione/emissione/templateSezioneRichiedenteEmissioneCertificato.zul" inline="true"?>
<?component name="templateSezioneEnteRichiedenteEmissioneCertificato" macroURI="/restrict/certificazione/emissione/templateSezioneEnteRichiedenteEmissioneCertificato.zul" inline="true"?>
<?component name="templateSezioneArchivioEmissioneCertificato" macroURI="/restrict/certificazione/emissione/templateSezioneArchivioEmissioneCertificato.zul" inline="true"?>
<?component name="templateSezioneModalitaRilascioEmissioneCertificato" macroURI="/restrict/certificazione/emissione/templateSezioneModalitaRilascioEmissioneCertificato.zul" inline="true"?>
<?component name="templateSezioneTerminalistaEmissioneCertificato" macroURI="/restrict/certificazione/emissione/templateSezioneTerminalistaEmissioneCertificato.zul" inline="true"?>

<zk xmlns="http://www.zkoss.org/2005/zul"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.zkoss.org/2005/zul http://www.zkoss.org/2005/zul/zul.xsd">

	<window viewModel="@id('vm') @init('restrict.certificazione.emissione.EmissioneCertificatoViewModel')"
			apply="org.zkoss.bind.BindComposer"
			border="none"
			width="100%" height="100%"
			sizable="false" closable="false">

        <hlayout valign="middle">
            <hlayout sclass="navigazione" valign="middle">
                <hlayout sclass="afc-control-bar" valign="middle">
                    <zk if="${vm.backFromRecordEnabled}">
                        <toolbarbuttonBackFromRecord/>
                    </zk>
                    <toolbarbuttonInsFromList/>
                    <toolbarbutton image="/images/icon/action/22x22/cash_register.png"
                                   tooltiptext="@load(vm.etichette['Fondo_cassa'])"
                                   onClick="@command('onOpenFondoCassa')"
                                   disabled="@load(!vm.terminalista.flagFondoCassa)"/>
                </hlayout>
            </hlayout>

            <label value="@load(vm.formLabel)" sclass="formTitle"/>
        </hlayout>

		<vlayout vflex="1" width="100%" sclass="scroll">
		    <templateSezioneBeneficiarioEmissioneCertificato/>

            <groupbox closable="false">
                <grid sclass="form">
                    <rows>
                        <row>
                            <cell align="right" width="175px">
                                <customLabel value="@load(vm.etichette['Tipo_Emissione'])"/>
                            </cell>
                            <cell colspan="3">
                                <hlayout height="25px" valign="middle">
                                    <radiogroup model="@load(vm.listaTipoRichiedente)" hflex="1"
                                                selectedItem="@bind(vm.tipoRichiedente) @converter('it.finmatica.zk.utils.PropertyConverter', property='id')"
                                                onCheck="@command('onCheckTipoRichiedente')">
                                        <template name="model">
                                            <radio label="@load(each.descrizione))"
                                                   value="@load(each)"
                                                   style="padding-left:15px;"/>
                                        </template>
                                    </radiogroup>
                                </hlayout>
                            </cell>
                            <cell colspan="3"/>
                        </row>
                    </rows>
                </grid>
            </groupbox>

            <templateSezioneRichiedenteEmissioneCertificato/>

            <templateSezioneEnteRichiedenteEmissioneCertificato/>

            <groupbox mold="3d" hflex="1">
                <caption sclass="mainCaption">
                    <div>
                        <updownbutton onClick="@command(self.openClose())" sclass="captionButton"/>
                        <label value="@load(vm.etichette['SEZIONE_DATI_CERTIFICATO'])" sclass="captionLabel"/>
                    </div>
                </caption>
                <grid sclass="form">
                    <rows>
                        <row>
                            <cell>
                                <templateSezioneArchivioEmissioneCertificato/>
                                <templateSezioneModalitaRilascioEmissioneCertificato/>
                                <templateSezioneTerminalistaEmissioneCertificato/>
                            </cell>
                        </row>
                    </rows>
                </grid>
            </groupbox>

            <groupbox closable="false">
                <grid sclass="form">
                    <rows>
                        <row>
                            <cell>
                                <hlayout hflex="1" sclass="testo-al-centro">
                                    <button label="Elabora"
                                            height="35px" width="150px"
                                            style="font-size:12px; font-weight: bold;"
                                            onClick="@command('onElaboraCertificato')"/>
                                </hlayout>
                            </cell>
                        </row>
                    </rows>
                </grid>
            </groupbox>

		</vlayout>

	</window>

</zk>