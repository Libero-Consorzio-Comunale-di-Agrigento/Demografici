<?xml version="1.0" encoding="UTF-8"?>
<?taglib uri="http://www.zkoss.org/dsp/web/core" prefix="c"?>

<zk xmlns="http://www.zkoss.org/2005/zul"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul http://www.zkoss.org/2005/zul/zul.xsd">

	<!-- ARCHIVIO - TIPO CERTIFICATO -->
	<groupbox closable="false">
		<caption label="@load(vm.etichette['Tipo_Certificato'])"/>
		<grid sclass="form">
			<columns>
				<column width="160px"/>
				<column/>
				<column/>
				<column width="100px"/>
				<column/>
			</columns>
			<rows>
				<row>
					<cell align="right" width="160px">
						<customLabel mandatory="true" value="@load(vm.etichette['Categoria_Tipo_Certificato'])"/>
					</cell>
					<cell>
						<combobox model="@load(vm.listaCategoriaTipoCertificato)" readonly="true" hflex="1"
								  disabled="@load(not vm.beneficiarioState.hasRequiredDataForTipoCertificatoSearch() or empty vm.listaCategoriaTipoCertificato)"
								  selectedItem="@bind(vm.categoriaTipoCertificatoSelezionata) @converter('it.finmatica.zk.utils.PropertyConverter', property='id')"
								  onSelect="@command('onSelectCategoriaTipoCertificato')">
							<template name="model">
								<comboitem label="@load(empty each?'- -':each.descrizione)" value="@load(each)"/>
							</template>
						</combobox>
					</cell>
					<cell colspan="3"/>
                </row>
 				<row>
 					<cell align="right">
						<customLabel mandatory="true" value="@load(vm.etichette['Tipo_Certificato'])"/>
 					</cell>
					<cell colspan="2">
						<hlayout valign="middle" hflex="1">
							<bandboxTipoCertificato hflex="1"
													disabled="@load(not vm.beneficiarioState.hasRequiredDataForTipoCertificatoSearch() or empty vm.categoriaTipoCertificatoSelezionata)"
													value="@load(vm.tipoCertificato.descrizione)"
													categoriaTipoCertificato="@load(vm.categoriaTipoCertificatoSelezionata)"
													anagrafeFiltroList="@load(vm.beneficiarioState.anagrafeFiltroList)"
													onSelect="@command('onSelectTipoCertificato')"/>
							<button image="/images/icon/action/16x16/cancel.png"
									tooltiptext="@load(vm.etichette['Cancella'])"
									disabled="@load(not vm.beneficiarioState.hasRequiredDataForTipoCertificatoSearch())"
									onClick="@command('onCancellaCampoCertificato')">
								<custom-attributes proprieta="tipoCertificato"/>
							</button>
						</hlayout>
					</cell>
					<cell align="right">
						<customLabel mandatory="@load(vm.dataStoricoMandatory)"
									 value="@load(vm.etichette['Al'])"
									 visible="@load(vm.dataStoricoMandatory)"/>
					</cell>
					<cell>
						<hlayout valign="middle" hflex="1" spacing="9px"
								 visible="@load(vm.dataStoricoMandatory)">
							<datebox format="dd/MM/yyyy"
									 value="@bind(vm.dataStorico)"/>
							<button image="/images/icon/action/16x16/cancel.png"
									tooltiptext="@load(vm.etichette['Cancella'])"
									onClick="@command('onCancellaCampoCertificato')">
								<custom-attributes proprieta="dataStorico"/>
							</button>
						</hlayout>
					</cell>
                 </row>
			</rows>
		</grid>
	</groupbox>

</zk>