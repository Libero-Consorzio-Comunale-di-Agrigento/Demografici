<?xml version="1.0" encoding="UTF-8"?>
<?taglib uri="http://www.zkoss.org/dsp/web/core" prefix="c"?>
<?xel-method prefix="c" name="getAttoCellSclass" class="it.finmatica.de4gsdzk.utils.FormUtils" signature="java.lang.String getAttoCellSclass(it.finmatica.de4gsdzk.CivAttoBaseDomain)"?>

<zk xmlns="http://www.zkoss.org/2005/zul"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.zkoss.org/2005/zul http://www.zkoss.org/2005/zul/zul.xsd">

    <window viewModel="@id('vm') @init('restrict.certificazione.stampe.StampaDirittiViewModel')"
            apply="org.zkoss.bind.BindComposer"
            border="none"
            width="100%" height="100%"
            sizable="false" closable="false">

        <hlayout valign="middle">
            <controlBarStampa/>

            <label value="@load(vm.formLabel)" sclass="formTitle"/>
        </hlayout>

        <vlayout vflex="1" style="overflow: auto;">

            <groupbox closable="false">
                <grid sclass="form">
                    <columns>
                        <column width="150px"/>
                        <column />
                    </columns>
                    <rows>
                        <row>
                            <cell align="right">
                                <customLabel mandatory="true" value="@load(vm.etichette['Data'])"/>
                            </cell>
                            <cell>
                                <hlayout valign="middle">
                                    <label value="@load(vm.etichette['Dal'])"/>
                                    <datebox format="dd/MM/yyyy" value="@bind(vm.dal)"
                                             width="100px"/>
                                    <space/>
                                    <label value="@load(vm.etichette['Al'])"/>
                                    <datebox format="dd/MM/yyyy" value="@bind(vm.al)"
                                             width="100px"/>
                                    <button image="/images/icon/action/16x16/cancel.png"
                                            tooltiptext="@load(vm.etichette['Cancella'])"
                                            onClick="@command('onCancellaCampo')">
                                    </button>
                                </hlayout>
                            </cell>
                        </row>
                    </rows>
                </grid>
            </groupbox>

        </vlayout>

    </window>

</zk>