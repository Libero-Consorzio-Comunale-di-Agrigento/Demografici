<?xml version="1.0" encoding="UTF-8"?>
<?taglib uri="http://www.zkoss.org/dsp/web/core" prefix="c"?>
<?component name="estremiCertificatoFormLabel" macroURI="/restrict/certificazione/certificati/estremiCertificatoFormLabel.zul" inline="true"?>

<zk xmlns="http://www.zkoss.org/2005/zul"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.zkoss.org/2005/zul http://www.zkoss.org/2005/zul/zul.xsd">

    <window viewModel="@id('vm') @init('restrict.certificazione.certificati.CertificatoEmessoDettaglioViewModel')"
            apply="org.zkoss.bind.BindComposer"
            border="none"
            width="100%" height="100%"
            sizable="false" closable="false">

        <hlayout valign="middle">
            <controlBarCertificatoEmesso/>

            <label value="@load(vm.etichette['CERTIFICATO_EMESSO'])" sclass="formTitle"
                   visible="@load(!vm.dettaglio.isAnnullato())"/>
            <label value="@load(vm.etichette['CERTIFICATO_ANNULLATO'])" sclass="grassettoRedText"
                   visible="@load(vm.dettaglio.isAnnullato())"/>

            <estremiCertificatoFormLabel/>
        </hlayout>

        <vlayout vflex="1" width="100%" sclass="scroll">

            <!-- BENEFICIARIO -->
            <groupbox mold="3d" hflex="1">
                <caption sclass="mainCaption">
                    <div>
                        <updownbutton onClick="@command(self.openClose())" sclass="captionButton"/>
                        <label value="@load(vm.etichette['SEZIONE_BENEFICIARIO'])" sclass="captionLabel"/>
                    </div>
                </caption>
                <grid sclass="form">
                    <rows>
                        <row>
                            <cell>
                                <groupbox closable="false">
                                    <grid sclass="form">
                                        <rows>
                                            <row>
                                                <cell align="right" width="160px">
                                                    <label value="@load(vm.etichette['Codice_Fiscale'])"/>
                                                </cell>
                                                <cell>
                                                    <label value="@load(vm.dettaglio.beneficiario.codiceFiscale)"
                                                           style="font-weight:bold;"/>
                                                </cell>
                                            </row>
                                            <row>
                                                <cell align="right">
                                                    <label value="@load(vm.etichette['Cognome'])"/>
                                                </cell>
                                                <cell>
                                                    <label value="@load(vm.dettaglio.beneficiario.cognome)"
                                                           style="font-weight:bold;"/>
                                                </cell>
                                            </row>
                                            <row>
                                                <cell align="right">
                                                    <label value="@load(vm.etichette['Nome'])"/>
                                                </cell>
                                                <cell>
                                                    <label value="@load(vm.dettaglio.beneficiario.nome)"
                                                           style="font-weight:bold;"/>
                                                </cell>
                                            </row>
                                            <row>
                                                <cell align="right">
                                                    <label value="@load(vm.etichette['Sesso'])"/>
                                                </cell>
                                                <cell>
                                                    <label value="@load(vm.dettaglio.beneficiario.sesso)"
                                                           style="font-weight:bold;"/>
                                                </cell>
                                            </row>
                                            <row>
                                                <cell align="right">
                                                    <label value="@load(vm.etichette['Data_Nascita'])"/>
                                                </cell>
                                                <cell>
                                                    <label value="@load(empty vm.dettaglio.beneficiario.dataNascita ? '' : c:formatDate(vm.dettaglio.beneficiario.dataNascita,'dd/MM/yyyy'))"
                                                           style="font-weight:bold;"/>
                                                </cell>
                                            </row>
                                        </rows>
                                    </grid>
                                </groupbox>
                            </cell>
                        </row>
                    </rows>
                </grid>
            </groupbox>
            <zk if="true">
                <!-- RICHIEDENTE -->
                <groupbox mold="3d" hflex="1" open="true">
                    <caption sclass="mainCaption">
                        <div>
                            <updownbutton onClick="@command(self.openClose())" sclass="captionButton"/>
                            <label value="@load(vm.etichette['SEZIONE_RICHIEDENTE'])" sclass="captionLabel"/>
                        </div>
                    </caption>
                    <grid sclass="form">
                        <rows>
                            <row>
                                <cell>
                                    <groupbox closable="false">
                                        <grid sclass="form">
                                            <rows>
                                                <row>
                                                    <cell align="right" width="180px">
                                                        <label value="@load(vm.etichette['Codice_Fiscale'])"/>
                                                    </cell>
                                                    <cell>
                                                        <label value="@load(vm.dettaglio.richiedente.codiceFiscale)"
                                                               style="font-weight:bold;"/>
                                                    </cell>
                                                </row>
                                                <row>
                                                    <cell align="right">
                                                        <label value="@load(vm.etichette['Cognome'])"/>
                                                    </cell>
                                                    <cell>
                                                        <label value="@load(vm.dettaglio.richiedente.cognome)"
                                                               style="font-weight:bold;"/>
                                                    </cell>
                                                </row>
                                                <row>
                                                    <cell align="right">
                                                        <label value="@load(vm.etichette['Nome'])"/>
                                                    </cell>
                                                    <cell>
                                                        <label value="@load(vm.dettaglio.richiedente.nome)"
                                                               style="font-weight:bold;"/>
                                                    </cell>
                                                </row>
                                                <row>
                                                    <cell align="right">
                                                        <label value="@load(vm.etichette['Sesso'])"/>
                                                    </cell>
                                                    <cell>
                                                        <label value="@load(vm.dettaglio.richiedente.sesso)"
                                                               style="font-weight:bold;"/>
                                                    </cell>
                                                </row>
                                                <row>
                                                    <cell align="right">
                                                        <label value="@load(vm.etichette['Data_Nascita'])"/>
                                                    </cell>
                                                    <cell>
                                                        <label value="@load(empty vm.dettaglio.richiedente.dataNascita ? '' : c:formatDate(vm.dettaglio.richiedente.dataNascita,'dd/MM/yyyy'))"
                                                               style="font-weight:bold;"/>
                                                    </cell>
                                                </row>
                                                <row>
                                                    <cell align="right">
                                                        <label value="@load(vm.etichette['Comune_Nascita'])"/>
                                                    </cell>
                                                    <cell>
                                                        <label value="@load(c:cat4(vm.dettaglio.richiedente.comuneNascita.descrizione, ' (',vm.dettaglio.richiedente.comuneNascita.siglaProvincia, ')'))"
                                                               style="font-weight:bold;"/>
                                                    </cell>
                                                </row>
                                                <row>
                                                    <cell align="right">
                                                        <label value="@load(vm.etichette['Nazionalita'])"/>
                                                    </cell>
                                                    <cell>
                                                        <label value="@load(vm.dettaglio.richiedente.nazionalita.descrizione)"
                                                               style="font-weight:bold;"/>
                                                    </cell>
                                                </row>
                                                <row>
                                                    <cell align="right">
                                                        <label value="@load(vm.etichette['Documento_riconoscimento'])"/>
                                                    </cell>
                                                    <cell>
                                                        <label value="@load(vm.dettaglio.richiedente.tipoDocumento.descrizioneEstesa)"
                                                               style="font-weight:bold;"/>
                                                    </cell>
                                                </row>
                                                <row>
                                                    <cell align="right">
                                                        <label value="@load(vm.etichette['Numero'])"/>
                                                    </cell>
                                                    <cell>
                                                        <label value="@load(vm.dettaglio.richiedente.numeroDocumento)"
                                                               style="font-weight:bold;"/>
                                                    </cell>
                                                </row>
                                                <row>
                                                    <cell align="right">
                                                        <label value="@load(vm.etichette['Data_Rilascio'])"/>
                                                    </cell>
                                                    <cell>
                                                        <label value="@load(empty vm.dettaglio.richiedente.dataRilascioDocumento ? '' : c:formatDate(vm.dettaglio.richiedente.dataRilascioDocumento,'dd/MM/yyyy'))"
                                                               style="font-weight:bold;"/>
                                                    </cell>
                                                </row>
                                            </rows>
                                        </grid>
                                    </groupbox>
                                </cell>
                            </row>
                        </rows>
                    </grid>
                </groupbox>
            </zk>

            <groupbox mold="3d" hflex="1">
                <caption sclass="mainCaption">
                    <div>
                        <updownbutton onClick="@command(self.openClose())" sclass="captionButton"/>
                        <label value="@load(vm.etichette['SEZIONE_DATI_CERTIFICATO'])" sclass="captionLabel"/>
                    </div>
                </caption>
                <grid sclass="form">
                    <rows>
                        <row>
                            <cell>
                                <groupbox closable="false">
                                    <caption label="@load(vm.etichette['Tipo_Certificato'])"/>
                                    <grid sclass="form">
                                        <rows>
                                            <row>
                                                <cell align="right" width="160px">
                                                    <label value="@load(vm.etichette['Tipo_Certificato'])"/>
                                                </cell>
                                                <cell>
                                                    <label value="@load(vm.dettaglio.tipoCertificato.descrizione)"
                                                           style="font-weight:bold;"/>
                                                </cell>
                                            </row>
                                        </rows>
                                    </grid>
                                </groupbox>
                                <groupbox closable="false">
                                    <caption label="@load(vm.etichette['Modalita_rilascio'])"/>
                                    <grid sclass="form">
                                        <columns>
                                            <column width="180px"/>
                                            <column width="120px"/>
                                            <column/>
                                            <column/>
                                        </columns>
                                        <rows>
                                            <row>
                                                <cell align="right">
                                                    <label value="@load(vm.etichette['Motivo'])"/>
                                                </cell>
                                                <cell colspan="3">
                                                    <label value="@load(vm.dettaglio.modalitaRilascio.descrizioneStampa)"
                                                           style="font-weight:bold;"/>
                                                </cell>
                                            </row>
                                            <row>
                                                <cell align="right" width="160px">
                                                    <label value="Altra specifica esenzione"/>
                                                </cell>
                                                <cell colspan="3">
                                                    <label value="@load(vm.dettaglio.descrizioneModalitaStampaLibera)"
                                                           style="font-weight:bold;"/>
                                                </cell>
                                            </row>
                                            <row>
                                                <cell align="right" width="120px">
                                                    <label value="Esenzione diritti di segreteria"/>
                                                </cell>
                                                <cell colspan="3">
                                                    <label value="@load(vm.getEtichettaEnum(vm.dettaglio.modalitaRilascio.esenzioneDiritti))"
                                                           style="font-weight:bold;"/>
                                                </cell>
                                            </row>
                                            <row>
                                                <cell align="right">
                                                    <label value="@load(not empty vm.diritti.segreteria.getDescrizione() ? vm.diritti.segreteria.getDescrizione() : vm.etichette['Diritti_segreteria'])"/>
                                                </cell>
                                                <cell>
                                                    <currencylabel value="@load(vm.dettaglio.segreteria)"
                                                                   bold="true"/>
                                                </cell>
                                                <cell colspan="2"/>
                                            </row>
                                            <row>
                                                <cell align="right">
                                                    <label value="@load(not empty vm.diritti.statoCivile.getDescrizione() ? vm.diritti.statoCivile.getDescrizione() : vm.etichette['Diritti_stato_civile'])"/>
                                                </cell>
                                                <cell>
                                                    <currencylabel value="@load(vm.dettaglio.statoCivile)"
                                                                   bold="true"/>
                                                </cell>
                                                <cell colspan="2"/>
                                            </row>
                                            <row>
                                                <cell align="right">
                                                    <label value="@load(not empty vm.diritti.cartaIdentita.getDescrizione() ? vm.diritti.cartaIdentita.getDescrizione() : vm.etichette['Diritti_carta_identita'])"/>
                                                </cell>
                                                <cell>
                                                    <currencylabel value="@load(vm.dettaglio.cartaIdentita)"
                                                                   bold="true"/>
                                                </cell>
                                                <cell colspan="2"/>
                                            </row>
                                            <row>
                                                <cell align="right">
                                                    <label value="@load(not empty vm.diritti.rimborsoStampati.getDescrizione() ? vm.diritti.rimborsoStampati.getDescrizione() : vm.etichette['Rimborso_stampati'])"/>
                                                </cell>
                                                <cell>
                                                    <currencylabel value="@load(vm.dettaglio.rimborsoStampati)"
                                                                   bold="true"/>
                                                </cell>
                                                <cell colspan="2"/>
                                            </row>
                                            <row>
                                                <cell align="right">
                                                    <label value="@load(not empty vm.diritti.bollo.getDescrizione() ? vm.diritti.bollo.getDescrizione() : vm.etichette['Bollo'])"/>
                                                </cell>
                                                <cell>
                                                    <currencylabel value="@load(vm.dettaglio.bollo)"
                                                                   bold="true"/>
                                                </cell>
                                                <cell colspan="2"/>
                                            </row>
                                            <row>
                                                <cell align="right">
                                                    <label value="@load(vm.etichette['Tipo_pagamento'])"/>
                                                </cell>
                                                <cell colspan="3">
                                                    <combobox model="@load(vm.listaTipoPagamento)" readonly="true"
                                                              width="200px"
                                                              selectedItem="@bind(vm.dettaglio.tipoPagamento) @converter('it.finmatica.zk.utils.PropertyConverter', property='id')"
                                                              disabled="@load(vm.dettaglio.isAnnullato())">
                                                        <template name="model">
                                                            <comboitem label="@load(empty each?'- -':each.descrizione)"
                                                                       value="@load(each)"/>
                                                        </template>
                                                    </combobox>
                                                </cell>
                                            </row>
                                        </rows>
                                    </grid>
                                </groupbox>
                                <groupbox closable="false">
                                    <caption label="@load(vm.etichette['Firma_Emissione'])"/>
                                    <grid sclass="form">
                                        <rows>
                                            <row>
                                                <cell align="right" width="160px">
                                                    <label value="@load(vm.etichette['Cognome_Nome'])"/>
                                                </cell>
                                                <cell colspan="5">
                                                    <label value="@load(vm.dettaglio.terminalista.cognomeNome)"
                                                           style="font-weight:bold;"/>
                                                </cell>
                                            </row>
                                            <row>
                                                <cell align="right">
                                                    <label value="@load(vm.etichette['Qualifica'])"/>
                                                </cell>
                                                <cell colspan="5">
                                                    <label value="@load(vm.dettaglio.terminalista.qualifica)"
                                                           style="font-weight:bold;"/>
                                                </cell>
                                            </row>
                                            <row>
                                                <cell align="right">
                                                    <label value="@load(vm.etichette['Nominativo_Stampa'])"/>
                                                </cell>
                                                <cell colspan="5">
                                                    <checkbox checked="@load(vm.dettaglio.terminalista.flagInStampa)"
                                                              disabled="true"/>
                                                </cell>
                                            </row>
                                        </rows>
                                    </grid>
                                </groupbox>
                                <groupbox closable="false"
                                          style="@load(vm.dettaglio.isAnnullato()? '' : 'display:none')">
                                    <caption label="@load(vm.etichette['Dati_Annullamento'])"/>
                                    <grid sclass="form">
                                        <rows>
                                            <row>
                                                <cell align="right" width="160px">
                                                    <label value="@load(vm.etichette['Cognome_Nome'])"/>
                                                </cell>
                                                <cell colspan="5">
                                                    <label value="@load(vm.dettaglio.terminalistaAnnullamento.cognomeNome)"
                                                           style="font-weight:bold;"/>
                                                </cell>
                                            </row>
                                            <row>
                                                <cell align="right" width="160px">
                                                    <label value="@load(vm.etichette['Data'])"/>
                                                </cell>
                                                <cell colspan="5">
                                                    <label value="@load(empty vm.dettaglio.dataAnnullamento? null:(c:formatDate(vm.dettaglio.dataAnnullamento, 'dd/MM/yyyy')))"
                                                           style="font-weight:bold;"/>
                                                </cell>
                                            </row>
                                            <row>
                                                <cell align="right" width="160px">
                                                    <label value="@load(vm.etichette['Note'])"/>
                                                </cell>
                                                <cell colspan="5">
                                                    <label value="@load(vm.dettaglio.noteAnnullamento)"
                                                           style="font-weight:bold;"/>
                                                </cell>
                                            </row>
                                        </rows>
                                    </grid>
                                </groupbox>
                            </cell>
                        </row>
                    </rows>
                </grid>
            </groupbox>
        </vlayout>

    </window>

</zk>