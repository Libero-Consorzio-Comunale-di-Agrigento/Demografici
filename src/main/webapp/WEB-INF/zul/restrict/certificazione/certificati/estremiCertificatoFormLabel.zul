<?xml version="1.0" encoding="UTF-8"?>
<?taglib uri="http://www.zkoss.org/dsp/web/core" prefix="c"?>

<zk xmlns="http://www.zkoss.org/2005/zul"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.zkoss.org/2005/zul http://www.zkoss.org/2005/zul/zul.xsd">

    <hlayout sclass="testo-a-dx" hflex="1">
        <hlayout spacing="2px">

            <hlayout valign="middle" spacing="5px">
                <label value="@load(vm.etichette['Anno_emissione'])" sclass="grassetto"/>
                <label value="@load(vm.dettaglio.annoEmissione)" sclass="grassetto"/>

                <label value=" - "/>
                <label value="@load(vm.etichette['Progressivo_emissione'])" sclass="grassetto"/>
                <label value="@load(vm.dettaglio.progressivoEmissione)" sclass="grassetto"/>
            </hlayout>

            <space/>

        </hlayout>
    </hlayout>

</zk>