<?xml version="1.0" encoding="UTF-8"?>
<?taglib uri="http://www.zkoss.org/dsp/web/core" prefix="c"?>
<?xel-method prefix="c" name="showMsgBox" class="it.finmatica.de4gsdzk.utils.MessaggioUtils" signature="void showMsgBox(java.lang.String, java.lang.String, java.lang.String)"?>

<zk xmlns="http://www.zkoss.org/2005/zul"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.zkoss.org/2005/zul http://www.zkoss.org/2005/zul/zul.xsd">

	<window viewModel="@id('vm') @init('restrict.certificazione.certificati.CertificatoEmessoListaViewModel')"
			apply="org.zkoss.bind.BindComposer"
			border="none"
			width="100%" height="100%"
            sizable="false" closable="false"
            onOK="@command('onRicerca')">

		<vlayout vflex="1">

			<hlayout valign="middle">
				<controlBarLista/>

				<label value="@load(vm.formLabel)" sclass="formTitle"/>
			</hlayout>

            <groupbox closable="false">
                <grid sclass="form">
                    <rows>
                        <row>
                            <cell align="right" width="90px">
                                <label value="@load(vm.etichette['Anno_emissione'])"/>
                            </cell>
                            <cell width="100px">
                                <hlayout valign="middle">
                                    <intbox hflex="1" value="@bind(vm.ricercaCertificato.annoEmissione)"/>
                                    <button image="/images/icon/action/16x16/cancel.png"
                                            tooltiptext="@load(vm.etichette['Cancella'])"
                                            onClick="@command('onCancellaCampoRicerca')">
                                        <custom-attributes proprieta="annoEmissione"/>
                                    </button>
                                </hlayout>
                            </cell>
                            <cell align="right" width="90px">
                                <label value="@load(vm.etichette['Progressivo_emissione'])"/>
                            </cell>
                            <cell width="100px">
                                <hlayout valign="middle">
                                    <intbox hflex="1" value="@bind(vm.ricercaCertificato.progressivoEmissione)"/>
                                    <button image="/images/icon/action/16x16/cancel.png"
                                            tooltiptext="@load(vm.etichette['Cancella'])"
                                            onClick="@command('onCancellaCampoRicerca')">
                                        <custom-attributes proprieta="progressivoEmissione"/>
                                    </button>
                                </hlayout>
                            </cell>
                            <cell align="right" width="90px">
                                <label value="@load(vm.etichette['Data_emissione'])"/>
                            </cell>
                            <cell width="300px">
                                <hlayout valign="middle">
                                    <label value="@load(vm.etichette['Da'])"/>
                                    <datebox format="dd/MM/yyyy" value="@bind(vm.ricercaCertificato.dataEmissioneDal)"
                                             width="100px"/>
                                    <space/>
                                    <label value="@load(vm.etichette['A'])"/>
                                    <datebox format="dd/MM/yyyy" value="@bind(vm.ricercaCertificato.dataEmissioneAl)"
                                             width="100px"/>
                                    <button image="/images/icon/action/16x16/cancel.png"
                                            tooltiptext="@load(vm.etichette['Cancella'])"
                                            onClick="@command('onCancellaCampoRicerca')">
                                        <custom-attributes proprieta="dataEmissioneDal,dataEmissioneAl"/>
                                    </button>
                                </hlayout>
                            </cell>
                            <cell align="right" width="90px">
                                <label value="@load(vm.etichette['Terminalista'])"/>
                            </cell>
                            <cell>
                                <hlayout valign="middle" hflex="1">
                                    <bandboxTerminalista hflex="1"
                                                         value="@load(vm.ricercaCertificato.terminalista.cognomeNome)"
                                                         onSelect="@command('onSelectTerminalista')"/>
                                    <button image="/images/icon/action/16x16/cancel.png"
                                            tooltiptext="@load(vm.etichette['Cancella'])"
                                            onClick="@command('onCancellaCampoRicerca')">
                                        <custom-attributes proprieta="terminalista"/>
                                    </button>
                                </hlayout>
                            </cell>
                            <cell align="right" width="100px">
                                <label value="@load(vm.etichette['Escludi_annullati'])"/>
                            </cell>
                            <cell width="25px">
                                <checkbox checked="@bind(vm.ricercaCertificato.escludiAnnullati)"
                                          onCheck="@command('onRicerca')"/>
                            </cell>
                            <cell width="40px"/>
                        </row>
                        <row>
                            <cell align="right">
                                <label value="@load(vm.etichette['Tipo_Certificato'])"/>
                            </cell>
                            <cell colspan="3">
								<hlayout valign="middle" hflex="1">
                                    <bandboxTipoCertificato hflex="1"
                                                            value="@load(vm.ricercaCertificato.tipoCertificato.descrizione)"
                                                            onSelect="@command('onSelectTipoCertificato')"/>
                                    <button image="/images/icon/action/16x16/cancel.png"
                                            tooltiptext="@load(vm.etichette['Cancella'])"
                                            onClick="@command('onCancellaCampoRicerca')">
                                        <custom-attributes proprieta="tipoCertificato"/>
                                    </button>
                                </hlayout>
                            </cell>
                            <cell align="right">
                                <label value="@load(vm.etichette['Modalita_rilascio'])"/>
                            </cell>
                            <cell>
								<hlayout valign="middle" hflex="1">
                                    <bandboxModalitaRilascio hflex="1"
                                                             value="@load(vm.ricercaCertificato.modalitaRilascio.descrizioneStampa)"
                                                             onSelect="@command('onSelectModalitaRilascio')"/>
									<button image="/images/icon/action/16x16/cancel.png"
											tooltiptext="@load(vm.etichette['Cancella'])" onClick="@command('onCancellaCampoRicerca')">
											<custom-attributes proprieta="modalitaRilascio"/>
								    </button>
                                </hlayout>
                            </cell>
                            <cell align="right">
                                <label value="@load(vm.etichette['Tipo_pagamento'])"/>
                            </cell>
                            <cell>
                                <combobox model="@load(vm.listaTipoPagamento)" readonly="true" hflex="1"
                                          selectedItem="@bind(vm.ricercaCertificato.tipoPagamento) @converter('it.finmatica.zk.utils.PropertyConverter', property='id')"
                                          onChange="@command('onRicerca')">
                                    <template name="model">
                                        <comboitem label="@load(empty each?vm.etichette['Tutti']:each.descrizione)"
                                                   value="@load(each)"/>
                                    </template>
                                </combobox>
                            </cell>
                            <cell colspan="2"/>
                            <cell width="40px"/>
                        </row>
                        <row>
                            <cell align="right">
                                <label value="@load(vm.etichette['Cognome'])"/>
                            </cell>
                            <cell colspan="3">
                                <hlayout valign="middle" hflex="1">
                                    <textbox value="@bind(vm.ricercaCertificato.cognomeTipoSoggettoCertificato)" onOK="@command('onRicerca')" hflex="1"/>
                                    <button image="/images/icon/action/16x16/cancel.png"
                                            tooltiptext="@load(vm.etichette['Cancella'])" onClick="@command('onCancellaCampoRicerca')">
                                        <custom-attributes proprieta="cognomeTipoSoggettoCertificato"/>
                                    </button>
                                </hlayout>
                            </cell>
                            <cell align="right">
                                <label value="@load(vm.etichette['Nome'])"/>
                            </cell>
                            <cell>
                                <hlayout valign="middle" hflex="1">
                                    <textbox value="@bind(vm.ricercaCertificato.nomeTipoSoggettoCertificato)"
                                             onOK="@command('onRicerca')" hflex="1"/>
                                    <button image="/images/icon/action/16x16/cancel.png"
                                            tooltiptext="@load(vm.etichette['Cancella'])"
                                            onClick="@command('onCancellaCampoRicerca')">
                                        <custom-attributes proprieta="nomeTipoSoggettoCertificato"/>
                                    </button>
                                </hlayout>
                            </cell>
                            <cell align="right" width="70px">
                                <label value="@load(vm.etichette['Tipo_Soggetto'])"/>
                            </cell>
                            <cell>
                                <combobox model="@load(vm.listaTipoSoggettoCertificato)" readonly="true" hflex="1"
                                          selectedItem="@bind(vm.ricercaCertificato.tipoSoggettoCertificato) @converter('it.finmatica.zk.utils.PropertyConverter', property='id')"
                                          onChange="@command('onRicerca')">
                                    <template name="model">
                                        <comboitem
                                                label="@load(empty each? vm.etichette['Tutti']:vm.getEtichettaEnum(each))"
                                                value="@load(each)"/>
                                    </template>
                                </combobox>
                            </cell>
                            <cell colspan="2"/>
                            <cell align="right">
                                <hlayout valign="middle">
                                    <button image="/images/icon/action/16x16/search.png"
                                            tooltiptext="@load(vm.etichette['Effettua_Ricerca'])"
                                            onClick="@command('onRicerca')"/>
                                </hlayout>
                            </cell>
                        </row>
                    </rows>
                </grid>
            </groupbox>

			<orderByBlock/>

			<listbox model="@load(vm.lista)" selectedItem="@bind(vm.dettaglio)" nonselectableTags="" vflex="1"
					 emptyMessage="@load(vm.etichette['Nessun_dato_disponibile'])">
				<listhead sizable="true">
                    <listheader label="@load(vm.etichette['Anno_emissione'])" hflex="min"/>
                    <listheader label="@load(vm.etichette['Progressivo_emissione'])" hflex="min"/>
                    <listheader label="@load(vm.etichette['Annullato'])" hflex="min"/>
					<listheader label="@load(vm.etichette['Descrizione'])"	/>
					<listheader label="@load(vm.etichette['Beneficiario'])" />
					<listheader label="@load(vm.etichette['Richiedente'])" />
					<listheader label="@load(vm.etichette['Terminalista'])" />
					<listheader label="@load(vm.etichette['Modalita_rilascio'])" />
					<listheader label="@load(vm.etichette['Data_emissione'])" hflex="min"/>
                    <listheader label="@load(vm.etichette['Stato_pagamento'])" width="110px"/>
                    <listheader label="" width="52px"/>
				</listhead>
				<template name="model" var="item">
                    <listitem onDoubleClick="@command('onApri')">
                        <listcell label="@load(item.annoEmissione)"/>
                        <listcell label="@load(item.progressivoEmissione)"/>
                        <listcell sclass="testo-al-centro">
                            <checkbox checked="@load(item.isAnnullato())"
                                      disabled="true"/>
                        </listcell>
						<listcell label="@load(item.tipoCertificato.descrizione)"/>
						<listcell label="@load(item.beneficiario.cognomeNome)" />
						<listcell label="@load(item.richiedente.cognomeNome)" />
						<listcell label="@load(item.terminalista.cognomeNome)" />
						<listcell label="@load(item.modalitaRilascio.descrizioneStampa)" />
						<listcell sclass="testo-al-centro">
                            <label value="@load(empty item.dataEmissione? null:(c:formatDate(item.dataEmissione, 'dd/MM/yyyy')))"/>
                        </listcell>
                        <listcell sclass="testo-al-centro">
                            <button image="/images/icon/action/18x18/ok.png"
                                    tooltiptext="@load(vm.etichette['Inviato'])"
                                    visible="@load(not empty item.pagamentoInviatoDettaglio.pagamentoInviato and item.pagamentoInviatoDettaglio.pagamentoInviato.isInviatoConSuccesso())"
                                    onClick="@command(c:showMsgBox(vm.msgTitle, 'I', item.pagamentoInviatoDettaglio.pagamentoInviato.note))"/>
                            <button image="/images/icon/action/18x18/warning_light.png"
                                    tooltiptext="@load(vm.etichette['info_tooltip'])"
                                    visible="@load(not empty item.pagamentoInviatoDettaglio.pagamentoInviato and not item.pagamentoInviatoDettaglio.pagamentoInviato.isInviatoConSuccesso())"
                                    onClick="@command(c:showMsgBox(vm.msgTitle, 'E', item.pagamentoInviatoDettaglio.pagamentoInviato.note))"/>
                        </listcell>
                        <listcell>
                            <button image="/images/icon/action/18x18/edit.png"
                                    tooltiptext="@load(vm.etichette['modifica_tooltip'])"
                                    visible="@load(not empty item.id)"
                                    onClick="@command('onApri')"/>
                        </listcell>
					</listitem>
				</template>
			</listbox>

		</vlayout>

	</window>

</zk>