<?xml version="1.0" encoding="UTF-8"?>
<?taglib uri="http://www.zkoss.org/dsp/web/core" prefix="c"?>
<?component name="templateRicercaIndividuo" macroURI="/restrict/anagrafe/templateRicercaIndividuo.zul" inline="true"?>

<zk xmlns="http://www.zkoss.org/2005/zul"
    xmlns:h="http://www.w3.org/1999/xhtml"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.zkoss.org/2005/zul http://www.zkoss.org/2005/zul/zul.xsd">

    <window viewModel="@id('vm') @init('restrict.anagrafe.AnagrafeAllSelectViewModel')"
            apply="org.zkoss.bind.BindComposer"
            border="none"
            width="1050px" height="600px"
            title="@load(vm.etichette['Seleziona_Soggetto'])"
            sizable="false" closable="false">

        <controlBarLista/>

        <vlayout vflex="1">
            <groupbox closable="false">
                <zk if="${vm.newSearchOn}">
                    <templateRicercaIndividuo/>
                </zk>
                <zk if="${!vm.newSearchOn}">
                    <grid sclass="form">
                        <rows>
                            <row>
                                <cell>
                                    <grid sclass="form">
                                        <rows>
                                            <row>
                                                <cell width="80px" align="right">
                                                    <label value="@load(vm.etichette['Cognome'])"/>
                                                </cell>
                                                <cell colspan="11">
                                                    <hlayout valign="middle" hflex="1">
                                                        <textbox value="@bind(vm.cognome)" onOK="@command('onRicerca')"
                                                                 hflex="1"/>
                                                        <button image="/images/icon/action/16x16/cancel.png"
                                                                tooltiptext="@load(vm.etichette['Cancella'])"
                                                                onClick="@command('onCancellaCampoRicerca')">
                                                            <custom-attributes proprieta="cognome"/>
                                                        </button>
                                                    </hlayout>
                                                </cell>
                                                <cell width="135px"/>
                                            </row>
                                            <row>
                                                <cell align="right">
                                                    <label value="@load(vm.etichette['Nome'])"/>
                                                </cell>
                                                <cell colspan="11">
                                                    <hlayout valign="middle" hflex="1">
                                                        <textbox value="@bind(vm.nome)" onOK="@command('onRicerca')"
                                                                 hflex="1"/>
                                                        <button image="/images/icon/action/16x16/cancel.png"
                                                                tooltiptext="@load(vm.etichette['Cancella'])"
                                                                onClick="@command('onCancellaCampoRicerca')">
                                                            <custom-attributes proprieta="nome"/>
                                                        </button>
                                                    </hlayout>
                                                </cell>
                                                <cell/>
                                            </row>
                                            <row>
                                                <cell align="right">
                                                    <label value="@load(vm.etichette['Data_Nascita'])"/>
                                                </cell>
                                                <cell colspan="3">
                                                    <hlayout valign="middle">
                                                        <datebox format="dd/MM/yyyy" value="@bind(vm.dataNascita)"
                                                                 onOK="@command('onRicerca')" width="110px"/>
                                                        <button image="/images/icon/action/16x16/cancel.png"
                                                                tooltiptext="@load(vm.etichette['Cancella'])"
                                                                onClick="@command('onCancellaCampoRicerca')">
                                                            <custom-attributes proprieta="dataNascita"/>
                                                        </button>
                                                    </hlayout>
                                                </cell>
                                                <cell align="right">
                                                    <label value="@load(vm.etichette['Sesso'])"
                                                           visible="@load(not empty vm.sesso)"/>
                                                </cell>
                                                <cell>
                                                    <label value="@load(vm.sesso)"/>
                                                </cell>
                                                <cell colspan="2" align="right">
                                                    <label value="@load(vm.etichette['Codice_Fiscale'])"/>
                                                </cell>
                                                <cell colspan="4">
                                                    <hlayout valign="middle" sclass="testo-a-dx" hflex="1">
                                                        <textbox value="@bind(vm.codiceFiscale)" maxlength="16"
                                                                 hflex="1" style="text-transform:uppercase"/>
                                                        <button image="/images/icon/action/16x16/cancel.png"
                                                                tooltiptext="@load(vm.etichette['Cancella'])"
                                                                onClick="@command('onCancellaCampoRicerca')">
                                                            <custom-attributes proprieta="codiceFiscale"/>
                                                        </button>
                                                    </hlayout>
                                                </cell>
                                                <cell align="right">
                                                    <hlayout valign="middle">
                                                        <button label="@load(vm.etichette['Ricerca_in_ANPR'])"
                                                                onClick="@command('onRicercaANP')"
                                                                image="/images/icon/action/16x16/dbtodb.png"/>
                                                    </hlayout>
                                                </cell>
                                            </row>
                                            <row visible="@load(vm.isGsd())">
                                                <cell colspan="6"/>
                                                <cell align="right" colspan="2">
                                                    <label value="@load(vm.etichette['Archivio'])"/>
                                                </cell>
                                                <cell colspan="4">
                                                    <combobox model="@load(vm.listaArchivio)" readonly="true"
                                                              selectedItem="@bind(vm.archivio) @converter('it.finmatica.zk.utils.PropertyConverter', property='id')"
                                                              hflex="1">
                                                        <template name="model">
                                                            <comboitem
                                                                    label="@load(empty each?vm.etichette['Tutti']:vm.getEtichettaEnum(each))"
                                                                    value="@load(each)"/>
                                                        </template>
                                                    </combobox>
                                                </cell>
                                                <cell/>
                                            </row>
                                        </rows>
                                    </grid>
                                </cell>
                                <cell width="42px">
                                    <button image="/images/icon/action/16x16/refresh.png"
                                            tooltiptext="@load(vm.etichette['Anagrafe_Locale'])"
                                            onClick="@command('onRicercaANAGSD')"/>
                                </cell>
                            </row>
                        </rows>
                    </grid>
                </zk>
            </groupbox>

            <hlayout sclass="navigazione" valign="middle">
                <totalSizeBlock/>
                <hlayout hflex="1" valign="middle" sclass="testo-al-centro">
                    <label value="@load(vm.getLabelSorgente())" style="font-weight: bold;font-size:15px"/>
                </hlayout>
                <hlayout hflex="1"/>
            </hlayout>

            <listbox model="@load(vm.lista)" selectedItem="@bind(vm.dettaglio)" nonselectableTags="" vflex="1"
                     emptyMessage="@load(vm.etichette['Nessun_dato_disponibile'])">
                <listhead>
                    <listheader label="@load(vm.etichette['Cognome'])"/>
                    <listheader label="@load(vm.etichette['Nome'])"/>
                    <listheader label="@load(vm.etichette['Sesso'])" width="52px"/>
                    <listheader label="@load(vm.etichette['Data_Nascita'])" width="104px"/>
                    <listheader label="@load(vm.etichette['Stato_Civile'])"/>
                    <listheader label="@load(vm.etichette['Stato_Anagrafico'])"/>
                    <listheader label="@load(vm.etichette['Comune_Residenza'])" visible="@load(vm.isAnpr())"/>
                    <listheader label="@load(vm.etichette['Archivio'])" visible="@load(vm.isGsd())"/>
                    <listheader label="" width="52px"/>
                </listhead>
                <template name="model" var="item">
                    <listitem onDoubleClick="@command('onSeleziona')">
                        <listcell label="@load(item.cognome)"/>
                        <listcell label="@load(item.nome)"/>
                        <listcell label="@load(item.sesso)"/>
                        <listcell
                                label="@load(empty item.dataNascita? null:(c:formatDate(item.dataNascita, 'dd/MM/yyyy')))"/>
                        <listcell label="@load(item.descrizioneStatoCivile)"/>
                        <listcell label="@load(item.descrizioneStatoAnagrafico)"/>
                        <listcell label="@load(item.comuneResidenza.descrizione)" visible="@load(vm.isAnpr())"/>
                        <listcell label="@load(vm.getEtichettaEnum(item.archivio))" visible="@load(vm.isGsd())"/>
                        <listcell>
                            <button image="/images/icon/action/16x16/forward.png"
                                    tooltiptext="@load(vm.etichette['seleziona_tooltip'])"
                                    onClick="@command('onSeleziona')"/>
                        </listcell>
                    </listitem>
                </template>
            </listbox>

        </vlayout>

        <h:div sclass="barraPulsanti">
            <h:div>
                <button label="@load(vm.etichette['Seleziona'])" onClick="@command('onSeleziona')"
                        image="/images/icon/action/16x16/ok.png"/>
                <button label="@load(vm.etichette['Chiudi'])" onClick="@command('onChiudi')"
                        image="/images/icon/action/16x16/close.png"/>
            </h:div>
        </h:div>

    </window>

</zk>
