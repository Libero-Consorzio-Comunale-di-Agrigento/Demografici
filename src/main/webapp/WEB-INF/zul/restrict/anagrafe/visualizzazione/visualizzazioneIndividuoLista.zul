<?xml version="1.0" encoding="UTF-8"?>
<?taglib uri="http://www.zkoss.org/dsp/web/core" prefix="c"?>
<?link rel="stylesheet" type="text/css" href="/css/de4gsdzk.css" ?>
<?xel-method prefix="c" name="westWidth" class="it.finmatica.de4gsdzk.utils.ConfigurazioneUtils" signature="String getWestWidth()"?>
<?component name="templateRicercaIndividuo" macroURI="/restrict/anagrafe/templateRicercaIndividuo.zul" inline="true"?>

<zk xmlns="http://www.zkoss.org/2005/zul"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.zkoss.org/2005/zul http://www.zkoss.org/2005/zul/zul.xsd">

    <window viewModel="@id('vm') @init('restrict.anagrafe.visualizzazione.VisualizzazioneIndividuoListaViewModel')"
            apply="org.zkoss.bind.BindComposer"
            border="none"
            width="100%" height="100%"
            sizable="false" closable="false">
        <vlayout vflex="1">

            <hlayout sclass="navigazione" valign="middle">
                <controlBar value="@load(vm.controlBarAttributes)"/>

                <label value="@load(vm.formLabel)" sclass="formTitle"/>
            </hlayout>
            <groupbox closable="false">
                <templateRicercaIndividuo/>
            </groupbox>

            <hlayout valign="middle">
                <totalSizeBlock/>
            </hlayout>

            <listbox model="@load(vm.lista)" selectedItem="@bind(vm.dettaglio)" nonselectableTags="" vflex="1"
                     emptyMessage="@load(vm.etichette['Nessun_dato_disponibile'])">
                <listhead>
                    <listheader label="@load(vm.etichette['Cognome'])"/>
                    <listheader label="@load(vm.etichette['Nome'])"/>
                    <listheader label="@load(vm.etichette['Sesso'])" width="52px"/>
                    <listheader label="@load(vm.etichette['Data_Nascita'])" width="104px"/>
                    <listheader label="@load(vm.etichette['Comune_Nascita'])"/>
                    <listheader label="@load(vm.etichette['Codice_Fiscale'])"/>
                    <listheader label="@load(vm.etichette['Comune_Residenza'])"/>
                    <listheader label="@load(vm.etichette['Stato_Civile'])"/>
                    <listheader label="@load(vm.etichette['Stato_Anagrafico'])"/>
                    <listheader label="" width="52px"/>
                </listhead>
                <template name="model" var="item">
                    <listitem onDoubleClick="@command('onSeleziona')">
                        <listcell label="@load(item.cognome)"/>
                        <listcell label="@load(item.nome)"/>
                        <listcell label="@load(item.sesso)"/>
                        <listcell
                                label="@load(empty item.dataNascita? null:(c:formatDate(item.dataNascita, 'dd/MM/yyyy')))"/>
                        <listcell label="@load(item.descrizioneComuneNascita)"/>
                        <listcell label="@load(item.codiceFiscale)"/>
                        <listcell label="@load(item.comuneResidenza.descrizione)"/>
                        <listcell label="@load(item.descrizioneStatoCivile)"/>
                        <listcell label="@load(item.descrizioneStatoAnagrafico)"/>
                        <listcell>
                            <button image="/images/icon/action/16x16/forward.png"
                                    tooltiptext="@load(vm.etichette['seleziona_tooltip'])"
                                    onClick="@command('onSeleziona')"/>
                        </listcell>
                    </listitem>
                </template>
            </listbox>
        </vlayout>
    </window>


</zk>