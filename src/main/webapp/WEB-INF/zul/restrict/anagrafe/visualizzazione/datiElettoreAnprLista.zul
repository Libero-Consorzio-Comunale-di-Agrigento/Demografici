<?xml version="1.0" encoding="UTF-8"?>
<?taglib uri="http://www.zkoss.org/dsp/web/core" prefix="c"?>
<?link rel="stylesheet" type="text/css" href="/css/de4gsdzk.css" ?>

<zk xmlns="http://www.zkoss.org/2005/zul"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.zkoss.org/2005/zul http://www.zkoss.org/2005/zul/zul.xsd">

    <window viewModel="@id('vm') @init('restrict.anagrafe.visualizzazione.DatiElettoreAnprListaViewModel')"
            apply="org.zkoss.bind.BindComposer"
            border="none"
            width="100%" height="100%"
            sizable="false" closable="false">
        <vlayout vflex="1">

            <hlayout sclass="navigazione" valign="middle">
                <controlBar value="@load(vm.controlBarAttributes)"/>

                <label value="@load(vm.formLabel)" sclass="formTitle"/>

                <estremiIndividuoFormLabel/>
            </hlayout>

            <groupbox closable="false">
                <caption label="@load(vm.etichette['Dati_Generali'])"/>
                <grid sclass="form">
                    <rows>
                        <row>
                            <cell align="right" width="150px">
                                <label value="@load(vm.etichette['Certificabile'])"/>
                            </cell>
                            <cell>
                                <customLabel
                                        value="@load(c:cat3(empty vm.anpSoggetto.certificabile ? '' : vm.anpSoggetto.certificabile, empty vm.anpSoggetto.certificabile or empty vm.anpSoggetto.descrizioneCertificabilita ? '' : ' - ', empty vm.anpSoggetto.descrizioneCertificabilita ? '' : vm.anpSoggetto.descrizioneCertificabilita))"
                                        bold="true"/>
                            </cell>
                        </row>
                        <row>
                            <cell align="right" width="150px">
                                <label value="@load(vm.etichette['Motivo_Cancellazione'])"/>
                            </cell>
                            <cell>
                                <customLabel
                                        value="@load(c:cat3(empty vm.anpSoggetto.motivoCancellazione ? '' : vm.anpSoggetto.motivoCancellazione, empty vm.anpSoggetto.motivoCancellazione or empty vm.anpSoggetto.descrizioneMotivoCancellazione ? '' : ' - ', empty vm.anpSoggetto.descrizioneMotivoCancellazione ? '' : vm.anpSoggetto.descrizioneMotivoCancellazione))"
                                        bold="true"/>
                            </cell>
                        </row>
                        <row>
                            <cell align="right" width="150px">
                                <label value="@load(vm.etichette['Note_Cancellazione'])"/>
                            </cell>
                            <cell>
                                <customLabel value="@load(vm.anpSoggetto.noteCancellazione)" bold="true"/>
                            </cell>
                        </row>
                    </rows>
                </grid>
            </groupbox>

            <groupbox closable="false" vflex="1">
                <caption label="@load(vm.etichette['Dati_Liste'])"/>
                <vlayout vflex="1">
                    <totalSizeBlock/>

                    <borderlayout vflex="1">
                        <center vflex="1">
                            <listbox model="@load(vm.lista)" selectedItem="@bind(vm.dettaglio)"
                                     nonselectableTags="" vflex="1"
                                     emptyMessage="@load(vm.etichette['Nessun_dato_disponibile'])">
                                <listhead>
                                    <listheader label="@load(vm.etichette['Lista'])"/>
                                    <listheader label="@load(vm.etichette['Elettore'])" width="80px"/>
                                    <listheader label="@load(vm.etichette['Sezione'])" width="80px"/>
                                    <listheader label="@load(vm.etichette['Comune'])"/>
                                    <listheader label="@load(vm.etichette['Provincia'])"/>
                                </listhead>
                                <template name="model" var="item">
                                    <listitem>
                                        <listcell label="@load(item.descrizioneLista)"/>
                                        <listcell sclass="testo-al-centro">
                                            <checkbox checked="@load(item.elettore)" disabled="true"/>
                                        </listcell>
                                        <listcell label="@load(item.sezioneElettorale)"/>
                                        <listcell label="@load(item.nomeComune)"/>
                                        <listcell label="@load(item.siglaProvinciaIstat)"/>
                                    </listitem>
                                </template>
                            </listbox>
                        </center>
                        <east size="50%" collapsible="true" splittable="true" open="@load(not empty vm.dettaglio)"
                              autoscroll="true">
                            <vlayout hflex="1">
                                <groupbox mold="3d" style="background: #EDEFF5" closable="false">
                                    <grid sclass="form">
                                        <rows>
                                            <row>
                                                <cell>
                                                    <groupbox closable="false">
                                                        <caption label="@load(vm.etichette['Vota_Per'])"/>
                                                        <grid sclass="form">
                                                            <rows>
                                                                <row>
                                                                    <cell align="right" width="110px">
                                                                        <customLabel
                                                                                value="@load(vm.etichette['Referendum'])"/>
                                                                    </cell>
                                                                    <cell align="center">
                                                                        <checkbox
                                                                                checked="@load(vm.dettaglio.referendum eq 'S')"
                                                                                disabled="true"/>
                                                                    </cell>
                                                                    <cell align="right" width="110px">
                                                                        <customLabel
                                                                                value="@load(vm.etichette['Parlamento_UE'])"/>
                                                                    </cell>
                                                                    <cell align="center">
                                                                        <checkbox
                                                                                checked="@load(vm.dettaglio.elezioniMembriUe eq 'S')"
                                                                                disabled="true"/>
                                                                    </cell>
                                                                    <cell align="right" width="110px">
                                                                        <customLabel
                                                                                value="@load(vm.etichette['Senato'])"/>
                                                                    </cell>
                                                                    <cell align="center">
                                                                        <checkbox
                                                                                checked="@load(vm.dettaglio.senato eq 'S')"
                                                                                disabled="true"/>
                                                                    </cell>
                                                                    <cell align="right" width="110px">
                                                                        <customLabel
                                                                                value="@load(vm.etichette['Camera'])"/>
                                                                    </cell>
                                                                    <cell align="center">
                                                                        <checkbox
                                                                                checked="@load(vm.dettaglio.camera eq 'S')"
                                                                                disabled="true"/>
                                                                    </cell>
                                                                </row>
                                                                <row>
                                                                    <cell align="right" width="110px">
                                                                        <customLabel
                                                                                value="@load(vm.etichette['Regionali'])"/>
                                                                    </cell>
                                                                    <cell align="center">
                                                                        <checkbox
                                                                                checked="@load(vm.dettaglio.regionali eq 'S')"
                                                                                disabled="true"/>
                                                                    </cell>
                                                                    <cell align="right" width="110px">
                                                                        <customLabel
                                                                                value="@load(vm.etichette['Comunali'])"/>
                                                                    </cell>
                                                                    <cell align="center">
                                                                        <checkbox
                                                                                checked="@load(vm.dettaglio.comunali eq 'S')"
                                                                                disabled="true"/>
                                                                    </cell>
                                                                    <cell align="right" width="110px">
                                                                        <customLabel
                                                                                value="@load(vm.etichette['Circoscrizionali'])"/>
                                                                    </cell>
                                                                    <cell align="center">
                                                                        <checkbox
                                                                                checked="@load(vm.dettaglio.circoscrizionali eq 'S')"
                                                                                disabled="true"/>
                                                                    </cell>
                                                                    <cell colspan="2"/>
                                                                </row>
                                                            </rows>
                                                        </grid>
                                                    </groupbox>
                                                </cell>
                                            </row>

                                            <row>
                                                <cell>
                                                    <groupbox closable="false">
                                                        <caption label="@load(vm.etichette['Dati_Sezione'])"/>
                                                        <grid sclass="form">
                                                            <rows>
                                                                <row>
                                                                    <cell align="right" width="110px">
                                                                        <customLabel
                                                                                value="@load(vm.etichette['Sede'])"/>
                                                                    </cell>
                                                                    <cell>
                                                                        <customLabel
                                                                                value="@load(vm.dettaglio.denominazioneSezioneElettorale)"
                                                                                bold="true"/>
                                                                    </cell>
                                                                </row>
                                                                <row>
                                                                    <cell align="right" width="110px">
                                                                        <customLabel
                                                                                value="@load(vm.etichette['Indirizzo'])"/>
                                                                    </cell>
                                                                    <cell>
                                                                        <customLabel
                                                                                value="@load(vm.dettaglio.indirizzoFormattato)"
                                                                                bold="true"/>
                                                                    </cell>
                                                                </row>
                                                            </rows>
                                                        </grid>
                                                    </groupbox>
                                                </cell>
                                            </row>

                                            <row>
                                                <cell>
                                                    <groupbox closable="false">
                                                        <caption label="@load(vm.etichette['Dati_Circorscrizioni'])"/>
                                                        <grid sclass="form">
                                                            <columns>
                                                                <column width="110px"/>
                                                                <column/>
                                                                <column width="110px"/>
                                                                <column/>
                                                            </columns>
                                                            <rows>
                                                                <row>
                                                                    <cell align="right" >
                                                                        <customLabel
                                                                                value="@load(vm.etichette['Parlamento_UE'])"/>
                                                                    </cell>
                                                                    <cell colspan="3">
                                                                        <customLabel
                                                                                value="@load(vm.dettaglio.circoscrizioneElezioniMembriUe)"
                                                                                bold="true"/>
                                                                    </cell>
                                                                </row>
                                                                <row>
                                                                    <cell align="right" >
                                                                        <customLabel
                                                                                value="@load(vm.etichette['Senato'])"/>
                                                                    </cell>
                                                                    <cell>
                                                                        <customLabel
                                                                                value="@load(vm.dettaglio.circoscrizioneSenato)"
                                                                                bold="true"/>
                                                                    </cell>
                                                                    <cell align="right" >
                                                                        <customLabel
                                                                                value="@load(vm.etichette['Collegio'])"/>
                                                                    </cell>
                                                                    <cell>
                                                                        <customLabel
                                                                                value="@load(vm.dettaglio.collegioSenato)"
                                                                                bold="true"/>
                                                                    </cell>
                                                                </row>
                                                                <row>
                                                                    <cell align="right" >
                                                                        <customLabel
                                                                                value="@load(vm.etichette['Camera'])"/>
                                                                    </cell>
                                                                    <cell>
                                                                        <customLabel
                                                                                value="@load(vm.dettaglio.circoscrizioneCamera)"
                                                                                bold="true"/>
                                                                    </cell>
                                                                    <cell align="right" >
                                                                        <customLabel
                                                                                value="@load(vm.etichette['Collegio'])"/>
                                                                    </cell>
                                                                    <cell>
                                                                        <customLabel
                                                                                value="@load(vm.dettaglio.collegioCamera)"
                                                                                bold="true"/>
                                                                    </cell>
                                                                </row>
                                                                <row>
                                                                    <cell align="right" >
                                                                        <customLabel
                                                                                value="@load(vm.etichette['Regionali'])"/>
                                                                    </cell>
                                                                    <cell colspan="3">
                                                                        <customLabel
                                                                                value="@load(vm.dettaglio.circoscrizioneRegionali)"
                                                                                bold="true"/>
                                                                    </cell>
                                                                </row>
                                                                <row>
                                                                    <cell align="right" >
                                                                        <customLabel
                                                                                value="@load(vm.etichette['Circoscrizionali'])"/>
                                                                    </cell>
                                                                    <cell colspan="3">
                                                                        <customLabel
                                                                                value="@load(vm.dettaglio.circoscrizioneElezCircosc)"
                                                                                bold="true"/>
                                                                    </cell>

                                                                </row>
                                                            </rows>
                                                        </grid>
                                                    </groupbox>
                                                </cell>
                                            </row>

                                            <row>
                                                <cell>
                                                    <groupbox closable="false">
                                                        <caption label="@load(vm.etichette['Dati_Cancellazione'])"/>
                                                        <grid sclass="form">
                                                            <rows>
                                                                <row>
                                                                    <cell align="right" width="110px">
                                                                        <customLabel
                                                                                value="@load(vm.etichette['Data'])"/>
                                                                    </cell>
                                                                    <cell>
                                                                        <customLabel
                                                                                value="@load(empty vm.dettaglio.dataCancellazioneLista ? null : (c:formatDate(vm.dettaglio.dataCancellazioneLista, 'dd/MM/yyyy')))"
                                                                                bold="true"/>
                                                                    </cell>
                                                                </row>
                                                                <row>
                                                                    <cell align="right" width="110px">
                                                                        <customLabel
                                                                                value="@load(vm.etichette['Consultazione'])"/>
                                                                    </cell>
                                                                    <cell>
                                                                        <customLabel
                                                                                value="@load(c:cat3(empty vm.dettaglio.tipoConsultazione ? '' : vm.dettaglio.tipoConsultazione, empty vm.dettaglio.tipoConsultazione or empty vm.dettaglio.descrizioneTipoConsultazione ? '' : ' - ', empty vm.dettaglio.descrizioneTipoConsultazione ? '' : vm.dettaglio.descrizioneTipoConsultazione))"
                                                                                bold="true"/>
                                                                    </cell>
                                                                </row>
                                                            </rows>
                                                        </grid>
                                                    </groupbox>
                                                </cell>
                                            </row>
                                        </rows>
                                    </grid>
                                </groupbox>
                            </vlayout>
                        </east>
                    </borderlayout>

                </vlayout>
            </groupbox>

        </vlayout>

    </window>

</zk>