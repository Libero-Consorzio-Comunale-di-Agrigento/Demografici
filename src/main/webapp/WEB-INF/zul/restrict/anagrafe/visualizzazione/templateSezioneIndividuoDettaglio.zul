                                    <cell>
                                        <button image="/images/icon/action/16x16/forward.png"
                                                disabled="@load(empty vm.dettaglio.coabitante.capoFamiglia)"
                                                onClick="@command('onOpenIndividuo', soggetto=vm.dettaglio.coabitante.capoFamiglia, id=null)"/>
                                    </cell>
                                </row>
                                <row if="${arg.showAnp ne true}">
                                    <cell align="right">
                                        <label value="Domicilio Digitale"/>
                                    </cell>
                                    <cell colspan="2">
                                        <customLabel value="@load(vm.dettaglio.domicilioDigitale)" bold="true"/>
                                    </cell>
                                </row>
                                <row if="${arg.showAnp ne true}">
                                    <cell align="right">
                                        <label value="@load(vm.etichette['Note'])"/>
                                    </cell>
                                    <cell colspan="2">
                                        <customLabel value="@load(vm.dettaglio.note)" bold="true" multiline="true"/>
                                    </cell>
                                </row>
                            </rows>
                        </grid>
                    </groupbox>
                </cell>
            </row>
        </rows>
    </grid>
</zk>
