<?xml version="1.0" encoding="UTF-8"?>
<zk xmlns="http://www.zkoss.org/2005/zul"
    xmlns:c="http://www.zkoss.org/2005/zk/comp">
    <grid sclass="form">
        <rows>
            <row>
                <cell>
                    <groupbox closable="false">
                        <caption label="@load(vm.etichette['Individuo'])"/>
                        <grid sclass="form">
                            <columns>
                                <column width="120px"/>
                                <column/>
                                <column width="120px"/>
                                <column/>
                                <column width="52px"/>
                            </columns>
                            <rows>
                                <row>
                                    <cell align="right">
                                        <label value="@load(vm.etichette['Ultimo_Evento'])"/>
                                    </cell>
                                    <cell colspan="4">
                                        <label value="@load((vm.dettaglio.fascia.id eq 5 or vm.dettaglio.fascia.id eq 6)
                                                            ? vm.dettaglio.stato.descrizione
                                                            : vm.getUltimoEventoDesc()))"
                                               sclass="grassetto"
                                               if="${arg.showAnp ne true}"/>
                                        <label value="@load(vm.getEtichettaEnum(vm.anpDettaglio.fascia))"
                                               sclass="@load(c:cat('grassetto', vm.dettaglio.fascia ne vm.anpDettaglio.fascia ? ' redText':''))"
                                               if="${arg.showAnp eq true}"/>
                                    </cell>
                                </row>
                                <row>
                                    <cell align="right">
                                        <label value="@load(vm.etichette['Cognome'])"/>
                                    </cell>
                                    <cell colspan="4">
                                        <label value="@load(vm.dettaglio.cognome)" sclass="grassetto"
                                               if="${arg.showAnp ne true}"/>
                                        <label value="@load(vm.anpDettaglio.cognome)"
                                               sclass="@load(c:cat('grassetto', vm.dettaglio.cognome ne vm.anpDettaglio.cognome ? ' redText':''))"
                                               if="${arg.showAnp eq true}"/>
                                    </cell>
                                </row>
                                <row>
                                    <cell align="right">
                                        <label value="@load(vm.etichette['Nome'])"/>
                                    </cell>
                                    <cell colspan="4">
                                        <label value="@load(vm.dettaglio.nome)" sclass="grassetto"
                                               if="${arg.showAnp ne true}"/>
                                        <label value="@load(vm.anpDettaglio.nome)"
                                               sclass="@load(c:cat('grassetto', vm.dettaglio.nome ne vm.anpDettaglio.nome ? ' redText':''))"
                                               if="${arg.showAnp eq true}"/>
                                    </cell>
                                </row>
                                <row>
                                    <cell align="right">
                                        <label value="@load(vm.etichette['Sesso'])"/>
                                    </cell>
                                    <cell>
                                        <label value="@load(vm.dettaglio.sesso)" sclass="grassetto"
                                               if="${arg.showAnp ne true}"/>
                                        <label value="@load(vm.anpDettaglio.sesso)"
                                               sclass="@load(c:cat('grassetto', vm.dettaglio.sesso ne vm.anpDettaglio.sesso ? ' redText':''))"
                                               if="${arg.showAnp eq true}"/>
                                    </cell>
                                    <cell align="right">
                                        <label value="@load(vm.etichette['Codice_Fiscale'])"/>
                                    </cell>
                                    <cell colspan="2">
                                        <label value="@load(vm.dettaglio.codiceFiscale)" sclass="grassetto"
                                               if="${arg.showAnp ne true}"/>
                                        <label value="@load(vm.anpDettaglio.codiceFiscale)"
                                               sclass="@load(c:cat('grassetto', vm.dettaglio.codiceFiscale ne vm.anpDettaglio.codiceFiscale ? ' redText':''))"
                                               if="${arg.showAnp eq true}"/>
                                    </cell>
                                </row>
                                <row>
                                    <cell align="right">
                                        <label value="@load(vm.etichette['Nazionalita'])"/>
                                    </cell>
                                    <cell>
                                        <label value="@load(vm.dettaglio.nazionalita.descrizione)"
                                               sclass="grassetto"
                                               if="${arg.showAnp ne true}"/>
                                        <label value="@load(vm.anpDettaglio.nazionalita.descrizione)"
                                               sclass="@load(c:cat('grassetto', vm.anpDettaglio.nazionalita ne vm.anpDettaglio.nazionalita ? ' redText':''))"
                                               if="${arg.showAnp eq true}"/>
                                    </cell>
                                    <cell align="right">
                                        <label value="@load(vm.etichette['Dal'])"/>
                                    </cell>
                                    <cell colspan="2">
                                        <label value="@load(empty vm.dettaglio.dataNazionalita ? null : (c:formatDate(vm.dettaglio.dataNazionalita, 'dd/MM/yyyy')))"
                                               sclass="grassetto"
                                               if="${arg.showAnp ne true}"/>
                                        <label value="@load(empty vm.anpDettaglio.dataNazionalita ? null : (c:formatDate(vm.anpDettaglio.dataNazionalita, 'dd/MM/yyyy')))"
                                               sclass="@load(c:cat('grassetto', vm.dettaglio.dataNazionalita ne vm.anpDettaglio.dataNazionalita ? ' redText':''))"
                                               if="${arg.showAnp eq true}"/>
                                    </cell>
                                </row>
                                <row>
                                    <cell align="right">
                                        <label value="@load(vm.etichette['Stato_Civile'])"/>
                                    </cell>
                                    <cell colspan="4">
                                        <label value="@load(vm.dettaglio.descrizioneStatoCivile)"
                                               sclass="grassetto"
                                               if="${arg.showAnp ne true}"/>
                                        <label value="@load(vm.anpDettaglio.descrizioneStatoCivile)"
                                               sclass="@load(c:cat('grassetto', vm.anpDettaglio.descrizioneStatoCivile ne vm.anpDettaglio.descrizioneStatoCivile ? ' redText':''))"
                                               if="${arg.showAnp eq true}"/>
                                    </cell>
                                </row>
                            </rows>
                        </grid>
                    </groupbox>
                    <groupbox closable="false">
                        <caption label="@load(vm.etichette['Nascita'])"/>
                        <grid sclass="form">
                            <columns>
                                <column width="120px"/>
                                <column/>
                                <column width="120px"/>
                                <column/>
                                <column width="52px"/>
                            </columns>
                            <rows>
                                <row>
                                    <cell align="right">
                                        <label value="@load(vm.etichette['Data_Nascita'])"/>
                                    </cell>
                                    <cell>
                                        <label value="@load(empty vm.dettaglio.dataNascita ? null : (c:formatDate(vm.dettaglio.dataNascita, 'dd/MM/yyyy')))"
                                               sclass="grassetto"
                                               if="${arg.showAnp ne true}"/>
                                        <image src="/images/icon/presentation/16x16/alert.png"
                                               tooltiptext="@load(vm.etichette['Data_Non_Significativa_tooltip'])"
                                               visible="@load(not empty vm.dettaglio.dataNascita and vm.dettaglio.flagAnnoNascita)"
                                               style="margin-left:5px"
                                               if="${arg.showAnp ne true}"/>
                                        <label value="@load(empty vm.anpDettaglio.dataNascita ? null : (c:formatDate(vm.anpDettaglio.dataNascita, 'dd/MM/yyyy')))"
                                               sclass="@load(c:cat('grassetto', vm.dettaglio.dataNascita ne vm.anpDettaglio.dataNascita ? ' redText':''))"
                                               if="${arg.showAnp eq true}"/>
                                    </cell>
                                    <cell align="right">
                                        <label value="@load(vm.etichette['Comune_Nascita'])"/>
                                    </cell>
                                    <cell>
                                        <comuneLabel value="@load(vm.dettaglio.comuneNascita)"
                                                     bold="true"
                                                     if="${arg.showAnp ne true}"/>
                                        <comuneLabel value="@load(vm.anpDettaglio.comuneNascita)"
                                                     bold="true"
                                                     sclass="@load(vm.dettaglio.comuneNascita ne vm.anpDettaglio.comuneNascita ? 'redText':'')"
                                                     if="${arg.showAnp eq true}"/>
                                    </cell>
                                    <cell/>
                                </row>
                                <row>
                                    <cell align="right">
                                        <label value="@load(vm.etichette['Atto'])"/>
                                    </cell>
                                    <cell>
                                        <estremiAttoLabel value="@load(vm.dettaglio.attoNascita)"
                                                          bold="true"
                                                          if="${arg.showAnp ne true}"/>
                                        <estremiAttoLabel value="@load(vm.anpDettaglio.attoNascita)"
                                                          bold="true"
                                                          sclass="@load(vm.dettaglio.attoNascita ne vm.anpDettaglio.attoNascita ? 'redText':'')"
                                                          if="${arg.showAnp eq true}"/>
                                    </cell>
                                    <cell align="right">
                                        <label value="@load(vm.etichette['Comune_Atto'])"/>
                                    </cell>
                                    <cell>
                                        <comuneLabel value="@load(vm.dettaglio.comuneAttoNascita)"
                                                     bold="true"
                                                     if="${arg.showAnp ne true}"/>
                                        <comuneLabel value="@load(vm.anpDettaglio.comuneAttoNascita)"
                                                     bold="true"
                                                     sclass="@load(vm.dettaglio.comuneAttoNascita ne vm.anpDettaglio.comuneAttoNascita ? 'redText':'')"
                                                     if="${arg.showAnp eq true}"/>
                                    </cell>
                                    <cell/>
                                </row>
                                <row>
                                    <cell align="right">
                                        <label value="@load(vm.etichette['Atto_Trascritto'])"/>
                                    </cell>
                                    <cell colspan="3">
                                        <estremiAttoLabel value="@load(vm.dettaglio.attoNascitaTrascritto)"
                                                          bold="true"
                                                          if="${arg.showAnp ne true}"/>
                                        <estremiAttoLabel value="@load(vm.anpDettaglio.attoNascitaTrascritto)"
                                                          bold="true"
                                                          sclass="@load(vm.dettaglio.attoNascitaTrascritto ne vm.anpDettaglio.attoNascitaTrascritto ? 'redText':'')"
                                                          if="${arg.showAnp eq true}"/>
                                    </cell>
                                    <cell/>
                                </row>
                                <row>
                                    <cell align="right">
                                        <label value="@load(vm.etichette['Cognome_Padre'])"/>
                                    </cell>
                                    <cell>
                                        <label value="@load(vm.dettaglio.cognomePadre)"
                                               sclass="grassetto"
                                               if="${arg.showAnp ne true}"/>
                                        <label value="@load(vm.anpDettaglio.cognomePadre)"
                                               sclass="@load(c:cat('grassetto', vm.dettaglio.cognomePadre ne vm.anpDettaglio.cognomePadre ? ' redText':''))"
                                               if="${arg.showAnp eq true}"/>
                                    </cell>
                                    <cell align="right">
                                        <label value="@load(vm.etichette['Nome_Padre'])"/>
                                    </cell>
                                    <cell>
                                        <label value="@load(vm.dettaglio.nomePadre)"
                                               sclass="grassetto"
                                               if="${arg.showAnp ne true}"/>
                                        <label value="@load(vm.anpDettaglio.nomePadre)"
                                               sclass="@load(c:cat('grassetto', vm.dettaglio.nomePadre ne vm.anpDettaglio.nomePadre ? ' redText':''))"
                                               if="${arg.showAnp eq true}"/>
                                    </cell>
                                    <cell>
                                        <button image="/images/icon/action/16x16/forward.png"
                                                disabled="@load(empty vm.dettaglio.padre)"
                                                onClick="@command('onOpenIndividuo', soggetto=vm.dettaglio.padre, id=null)"
                                                if="${arg.showAnp ne true}"/>
                                        <button image="/images/icon/action/16x16/forward.png"
                                                disabled="@load(empty vm.anpDettaglio.padre)"
                                                onClick="@command('onOpenIndividuo', soggetto=vm.anpDettaglio.padre, id=null)"
                                                if="${arg.showAnp eq true}"/>
                                    </cell>
                                </row>
                                <row>
                                    <cell align="right">
                                        <label value="@load(vm.etichette['Cognome_Madre'])"/>
                                    </cell>
                                    <cell>
                                        <label value="@load(vm.dettaglio.cognomeMadre)"
                                               sclass="grassetto"
                                               if="${arg.showAnp ne true}"/>
                                        <label value="@load(vm.anpDettaglio.cognomeMadre)"
                                               sclass="@load(c:cat('grassetto', vm.dettaglio.cognomeMadre ne vm.anpDettaglio.cognomeMadre ? ' redText':''))"
                                               if="${arg.showAnp eq true}"/>
                                    </cell>
                                    <cell align="right">
                                        <label value="@load(vm.etichette['Nome_Madre'])"/>
                                    </cell>
                                    <cell>
                                        <label value="@load(vm.dettaglio.nomeMadre)"
                                               sclass="grassetto"
                                               if="${arg.showAnp ne true}"/>
                                        <label value="@load(vm.anpDettaglio.nomeMadre)"
                                               sclass="@load(c:cat('grassetto', vm.dettaglio.nomeMadre ne vm.anpDettaglio.nomeMadre ? ' redText':''))"
                                               if="${arg.showAnp eq true}"/>
                                    </cell>
                                    <cell>
                                        <button image="/images/icon/action/16x16/forward.png"
                                                disabled="@load(empty vm.dettaglio.madre)"
                                                onClick="@command('onOpenIndividuo', soggetto=vm.dettaglio.madre, id=null)"
                                                if="${arg.showAnp ne true}"/>
                                        <button image="/images/icon/action/16x16/forward.png"
                                                disabled="@load(empty vm.anpDettaglio.madre)"
                                                onClick="@command('onOpenIndividuo', soggetto=vm.anpDettaglio.madre, id=null)"
                                                if="${arg.showAnp eq true}"/>
                                    </cell>
                                </row>
                            </rows>
                        </grid>
                    </groupbox>
                    <groupboxIndirizzo label="@load(vm.etichette['Residenza'])"
                                       value="@load(vm.dettaglio.indirizzo)"
                                       showAnp="${arg.showAnp}"
                                       if="${arg.showAnp ne true}">
                        <row>
                            <cell align="right">
                                <label value="@load(vm.etichette['Dal'])"/>
                            </cell>
                            <cell colspan="3">
                                <hlayout>
                                    <label value="@load(empty vm.dettaglio.dataResidenza ? null : (c:formatDate(vm.dettaglio.dataResidenza, 'dd/MM/yyyy')))"
                                           sclass="grassetto"/>
                                    <image src="/images/icon/presentation/16x16/alert.png"
                                           tooltiptext="@load(empty vm.dettaglio.dataResidenza ? '' : c:cat3(vm.etichette['Data_Convenzionale_tooltip'], ' ', c:formatDate(vm.dettaglio.dataResidenza, 'dd/MM/yyyy')))"
                                           visible="@load(vm.dettaglio.flagDataConvenzionaleRes)"/>
                                </hlayout>
                            </cell>
                        </row>
                    </groupboxIndirizzo>
                    <groupboxIndirizzo label="@load(vm.etichette['Residenza'])"
                                       value="@load(vm.anpDettaglio.indirizzo)"
                                       showAnp="${arg.showAnp}"
                                       indirizzoComparison="@load(vm.dettaglio.indirizzo)"
                                       if="${arg.showAnp eq true}">
                        <row>
                            <cell align="right">
                                <label value="@load(vm.etichette['Dal'])"/>
                            </cell>
                            <cell colspan="3">
                                <label value="@load(empty vm.anpDettaglio.dataResidenza ? null : (c:formatDate(vm.anpDettaglio.dataResidenza, 'dd/MM/yyyy')))"
                                       sclass="@load(c:cat('grassetto', vm.dettaglio.dataResidenza ne vm.anpDettaglio.dataResidenza ? ' redText':''))"/>
                            </cell>
                        </row>
                    </groupboxIndirizzo>
                    <groupbox closable="false"
                              visible="@bind(vm.dettaglio.statoCivile.hasConiugeContraente() or vm.anpDettaglio.statoCivile.hasConiugeContraente())">
                        <caption
                                label="@load(vm.dettaglio.statoCivile.isUnioneCivile() ? vm.etichette['Unione_Civile'] : vm.etichette['Matrimonio'])"
                                if="${arg.showAnp ne true}"/>
                        <caption
                                label="@load(vm.anpDettaglio.statoCivile.isUnioneCivile() ? vm.etichette['Unione_Civile'] : vm.etichette['Matrimonio'])"
                                if="${arg.showAnp eq true}"/>
                        <grid sclass="form">
                            <columns>
                                <column width="120px"/>
                                <column/>
                                <column width="120px"/>
                                <column/>
                                <column width="52px"/>
                            </columns>
                            <rows>
                                <row>
                                    <cell align="right">
                                        <label value="@load(c:cat3(vm.etichette['Cognome'], ' ',(vm.dettaglio.statoCivile.isUnioneCivile() ? vm.etichette['Contraente'] : vm.etichette['Coniuge'])))"
                                               if="${arg.showAnp ne true}"/>
                                        <label value="@load(c:cat3(vm.etichette['Cognome'], ' ',(vm.anpDettaglio.statoCivile.isUnioneCivile() ? vm.etichette['Contraente'] : vm.etichette['Coniuge'])))"
                                               if="${arg.showAnp eq true}"/>
                                    </cell>
                                    <cell>
                                        <label value="@load(vm.dettaglio.coniuge.cognome)"
                                               sclass="grassetto"
                                               if="${arg.showAnp ne true}"/>
                                        <label value="@load(vm.anpDettaglio.coniuge.cognome)"
                                               sclass="@load(c:cat('grassetto', vm.dettaglio.coniuge.cognome ne vm.anpDettaglio.coniuge.cognome ? ' redText':''))"
                                               if="${arg.showAnp eq true}"/>
                                    </cell>
                                    <cell align="right">
                                        <label value="@load(c:cat3(vm.etichette['Nome'], ' ',(vm.dettaglio.statoCivile.isUnioneCivile() ? vm.etichette['Contraente'] : vm.etichette['Coniuge'])))"
                                               if="${arg.showAnp ne true}"/>
                                        <label value="@load(c:cat3(vm.etichette['Nome'], ' ',(vm.anpDettaglio.statoCivile.isUnioneCivile() ? vm.etichette['Contraente'] : vm.etichette['Coniuge'])))"
                                               if="${arg.showAnp eq true}"/>
                                    </cell>
                                    <cell>
                                        <label value="@load(vm.dettaglio.coniuge.nome)"
                                               sclass="grassetto"
                                               if="${arg.showAnp ne true}"/>
                                        <label value="@load(vm.anpDettaglio.coniuge.nome)"
                                               sclass="@load(c:cat('grassetto', vm.dettaglio.coniuge.nome ne vm.anpDettaglio.coniuge.nome ? ' redText':''))"
                                               if="${arg.showAnp eq true}"/>
                                    </cell>
                                    <cell>
                                        <button image="/images/icon/action/16x16/forward.png"
                                                disabled="@load(empty vm.dettaglio.coniuge.anagrafe)"
                                                onClick="@command('onOpenIndividuo', soggetto=vm.dettaglio.coniuge.anagrafe, id=null)"
                                                if="${arg.showAnp ne true}"/>
                                        <button image="/images/icon/action/16x16/forward.png"
                                                disabled="@load(empty vm.anpDettaglio.coniuge.idAnagrafe)"
                                                onClick="@command('onOpenIndividuo', soggetto=null, id=vm.anpDettaglio.coniuge.idAnagrafe)"
                                                if="${arg.showAnp eq true}"/>
                                    </cell>
                                </row>
                                <row>
                                    <cell align="right">
                                        <label value="@load(vm.etichette['Data'])"/>
                                    </cell>
                                    <cell>
                                        <label value="@load(empty vm.dettaglio.dataMatrimonio ? null : (c:formatDate(vm.dettaglio.dataMatrimonio, 'dd/MM/yyyy')))"
                                               sclass="grassetto"
                                               if="${arg.showAnp ne true}"/>
                                        <image src="/images/icon/presentation/16x16/alert.png"
                                               tooltiptext="@load(vm.etichette['Data_Non_Significativa_tooltip'])"
                                               visible="@load(not empty vm.dettaglio.dataMatrimonio and vm.dettaglio.flagAnnoMatrimonio)"
                                               style="margin-left:5px"
                                               if="${arg.showAnp ne true}"/>
                                        <label value="@load(empty vm.anpDettaglio.dataMatrimonio ? null : (c:formatDate(vm.anpDettaglio.dataMatrimonio, 'dd/MM/yyyy')))"
                                               sclass="@load(c:cat('grassetto', vm.dettaglio.dataMatrimonio ne vm.anpDettaglio.dataMatrimonio ? ' redText':''))"
                                               if="${arg.showAnp eq true}"/>
                                    </cell>
                                    <cell align="right">
                                        <label value="@load(vm.etichette['Comune'])"/>
                                    </cell>
                                    <cell>
                                        <comuneLabel value="@load(vm.dettaglio.comuneMatrimonio)"
                                                     bold="true"
                                                     if="${arg.showAnp ne true}"/>
                                        <comuneLabel value="@load(vm.anpDettaglio.comuneMatrimonio)"
                                                     bold="true"
                                                     sclass="@load(vm.dettaglio.comuneMatrimonio ne vm.anpDettaglio.comuneMatrimonio ? 'redText':'')"
                                                     if="${arg.showAnp eq true}"/>
                                    </cell>
                                    <cell/>
                                </row>
                                <row>
                                    <cell align="right">
                                        <label value="@load(vm.etichette['Atto'])"/>
                                    </cell>
                                    <cell>
                                        <estremiAttoLabel value="@load(vm.dettaglio.attoMatrimonio)"
                                                          bold="true"
                                                          if="${arg.showAnp ne true}"/>
                                        <estremiAttoLabel value="@load(vm.anpDettaglio.attoMatrimonio)"
                                                          bold="true"
                                                          sclass="@load(vm.dettaglio.attoMatrimonio ne vm.anpDettaglio.attoMatrimonio ? 'redText':'')"
                                                          if="${arg.showAnp eq true}"/>
                                    </cell>
                                    <cell align="right">
                                        <label value="@load(vm.etichette['Comune_Atto'])"/>
                                    </cell>
                                    <cell>
                                        <comuneLabel value="@load(vm.dettaglio.comuneAttoMatrimonio)"
                                                     bold="true"
                                                     if="${arg.showAnp ne true}"/>
                                        <comuneLabel value="@load(vm.anpDettaglio.comuneAttoMatrimonio)"
                                                     bold="true"
                                                     sclass="@load(vm.dettaglio.comuneAttoMatrimonio ne vm.anpDettaglio.comuneAttoMatrimonio ? 'redText':'')"
                                                     if="${arg.showAnp eq true}"/>
                                    </cell>
                                    <cell/>
                                </row>
                                <row>
                                    <cell align="right">
                                        <label value="@load(vm.etichette['Atto_Trascritto'])"/>
                                    </cell>
                                    <cell colspan="3">
                                        <estremiAttoLabel value="@load(vm.dettaglio.attoMatrimonioTrascritto)"
                                                          bold="true"
                                                          if="${arg.showAnp ne true}"/>
                                        <estremiAttoLabel value="@load(vm.anpDettaglio.attoMatrimonioTrascritto)"
                                                          bold="true"
                                                          sclass="@load(vm.dettaglio.attoMatrimonioTrascritto ne vm.anpDettaglio.attoMatrimonioTrascritto ? 'redText':'')"
                                                          if="${arg.showAnp eq true}"/>
                                    </cell>
                                    <cell/>
                                </row>
                            </rows>
                        </grid>
                    </groupbox>
                    <groupbox closable="false"
                              visible="@bind(vm.dettaglio.statoCivile.isVedovo() or vm.anpDettaglio.statoCivile.isVedovo())">
                        <caption label="@load(vm.etichette['Vedovanza'])"/>
                        <grid sclass="form">
                            <columns>
                                <column width="120px"/>
                                <column/>
                                <column width="120px"/>
                                <column/>
                                <column width="52px"/>
                            </columns>
                            <rows>
                                <row>
                                    <cell align="right">
                                        <label value="@load(vm.etichette['Data'])"/>
                                    </cell>
                                    <cell>
                                        <label value="@load(empty vm.dettaglio.dataVedovanza ? null : (c:formatDate(vm.dettaglio.dataVedovanza, 'dd/MM/yyyy')))"
                                               sclass="grassetto"
                                               if="${arg.showAnp ne true}"/>
                                        <label value="@load(empty vm.anpDettaglio.dataVedovanza ? null : (c:formatDate(vm.anpDettaglio.dataVedovanza, 'dd/MM/yyyy')))"
                                               sclass="@load(c:cat('grassetto', vm.dettaglio.dataVedovanza ne vm.anpDettaglio.dataVedovanza ? ' redText':''))"
                                               if="${arg.showAnp eq true}"/>
                                    </cell>
                                    <cell align="right">
                                        <label value="@load(vm.etichette['Comune'])"/>
                                    </cell>
                                    <cell colspan="2">
                                        <comuneLabel value="@load(vm.dettaglio.comuneVedovanza)"
                                                     bold="true"
                                                     if="${arg.showAnp ne true}"/>
                                        <comuneLabel value="@load(vm.anpDettaglio.comuneVedovanza)"
