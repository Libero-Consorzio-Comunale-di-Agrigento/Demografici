<?xml version="1.0" encoding="UTF-8"?>
<?taglib uri="http://www.zkoss.org/dsp/web/core" prefix="c"?>
<?link rel="stylesheet" type="text/css" href="/css/de4gsdzk.css" ?>
<?xel-method prefix="c" name="westWidth" class="it.finmatica.de4gsdzk.utils.ConfigurazioneUtils" signature="String getWestWidth()"?>
<?component name="templateSezioneFamiglia" macroURI="/restrict/anagrafe/visualizzazione/templateSezioneFamiglia.zul" inline="true"?>
<?component name="templateDetailSituazioneStoricaFamigliaLista" macroURI="/restrict/anagrafe/visualizzazione/templateDetailSituazioneStoricaFamigliaLista.zul" inline="true"?>

<zk xmlns="http://www.zkoss.org/2005/zul"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.zkoss.org/2005/zul http://www.zkoss.org/2005/zul/zul.xsd">

    <window viewModel="@id('vm') @init('restrict.anagrafe.visualizzazione.FamigliaStoricoListaViewModel')"
            apply="org.zkoss.bind.BindComposer"
            border="none"
            width="100%" height="100%"
            sizable="false" closable="false">
        <vlayout vflex="1">

            <hlayout sclass="navigazione" valign="middle">
                <controlBar value="@load(vm.controlBarAttributes)">
                    <toolbarbuttonAllegati/>
                </controlBar>

                <label value="@load(vm.formLabel)" sclass="formTitle"/>

                <estremiIndividuoFormLabel/>
            </hlayout>
            <groupbox closable="false" hflex="1">
                <grid sclass="form">
                    <rows>
                        <row>
                            <cell align="right" width="150px">
                                <label value="@load(vm.etichette['Famiglia'])"/>
                            </cell>
                            <cell>
                                <combobox model="@load(vm.famigliaList)" readonly="true"
                                          selectedItem="@bind(vm.famiglia) @converter('it.finmatica.zk.utils.PropertyConverter', property='id')"
                                          onChange="@command('onSelectFamiglia')">
                                    <template name="model">
                                        <comboitem label="@load(c:cat3(vm.getEtichettaPluralEnum(each.fascia),' - ', each.codice))" value="@load(each)"/>
                                    </template>
                                </combobox>
                            </cell>
                        </row>
                    </rows>
                </grid>
            </groupbox>
            <templateSezioneFamiglia/>
            <listbox model="@load(vm.lista)" selectedItem="@bind(vm.dettaglio)"
                     nonselectableTags="" vflex="1"
                     emptyMessage="@load(vm.etichette['Nessun_dato_disponibile'])"
                     onSelect="@command('onSelectDettaglio')">
                <listhead>
                    <listheader label="@load(vm.etichette['Data_Evento'])"/>
                    <listheader label="@load(vm.etichette['Descrizione'])"/>
                </listhead>
                <template name="model" var="item">
                    <listitem>
                        <listcell label="@load(empty item.dataEvento? null:(c:formatDate(item.dataEvento, 'dd/MM/yyyy')))"/>
                        <listcell label="@load(item.descrizione)"/>
                    </listitem>
                </template>
            </listbox>
            <groupbox closable="false" hflex="1">
                <grid sclass="form">
                    <rows>
                        <row>
                            <cell align="right" width="150px">
                                <label value="@load(vm.etichette['Situazione_al'])"/>
                            </cell>
                            <cell>
                                <customLabel
                                        value="@load(empty vm.dettaglio.dataEvento? null:(c:formatDate(vm.dettaglio.dataEvento, 'dd/MM/yyyy')))"
                                        bold="true"/>
                            </cell>
                        </row>
                    </rows>
                </grid>
            </groupbox>
            <templateDetailSituazioneStoricaFamigliaLista/>
        </vlayout>
    </window>


</zk>