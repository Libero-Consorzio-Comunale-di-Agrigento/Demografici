<?xml version="1.0" encoding="UTF-8"?>
<?taglib uri="http://www.zkoss.org/dsp/web/core" prefix="c"?>
<?link rel="stylesheet" type="text/css" href="/css/de4gsdzk.css" ?>
<?xel-method prefix="c" name="westWidth" class="it.finmatica.de4gsdzk.utils.ConfigurazioneUtils" signature="String getWestWidth()"?>

<zk xmlns="http://www.zkoss.org/2005/zul"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.zkoss.org/2005/zul http://www.zkoss.org/2005/zul/zul.xsd">

    <window viewModel="@id('vm') @init('restrict.anagrafe.visualizzazione.VisualizzazioneFamigliaListaViewModel')"
            apply="org.zkoss.bind.BindComposer"
            border="none"
            width="100%" height="100%"
            sizable="false" closable="false"
            onOK="@command('onRicerca')">
        <vlayout vflex="1">

            <hlayout sclass="navigazione" valign="middle">
                <controlBar value="@load(vm.controlBarAttributes)"/>

                <label value="@load(vm.formLabel)" sclass="formTitle"/>
            </hlayout>
            <groupbox closable="false">
                <grid sclass="form">
                    <columns>
                        <column width="120px"/>
                        <column/>
                        <column width="120px"/>
                        <column/>
                        <column width="120px"/>
                        <column/>
                        <column width="120px"/>
                        <column/>
                        <column width="220px"/>
                    </columns>
                    <rows>
                        <row>
                            <cell align="right">
                                <customLabel mandatory="true" value="@load(vm.etichette['Indirizzo'])"/>
                            </cell>
                            <cell colspan="5">
                                <hlayout valign="middle" hflex="1">
                                    <bandboxVia hflex="1"
                                                value="@load(vm.ricercaFamiglia.via.denominazione)"
                                                onSelect="@command('onSelectVia')"/>
                                    <button image="/images/icon/action/16x16/cancel.png"
                                            tooltiptext="@load(vm.etichette['Cancella'])"
                                            onClick="@command('onCancellaCampoRicerca')">
                                        <custom-attributes proprieta="via"/>
                                    </button>
                                </hlayout>
                            </cell>
                            <cell align="right">
                                <customLabel mandatory="true" value="@load(vm.etichette['Civico'])"/>
                            </cell>
                            <cell>
                                <hlayout valign="middle" hflex="1">
                                    <intbox value="@bind(vm.ricercaFamiglia.numeroCivico)" maxlength="6" hflex="1"
                                            style="text-transform:uppercase"/>
                                    <button image="/images/icon/action/16x16/cancel.png"
                                            tooltiptext="@load(vm.etichette['Cancella'])"
                                            onClick="@command('onCancellaCampoRicerca')">
                                        <custom-attributes proprieta="numeroCivico"/>
                                    </button>
                                </hlayout>
                            </cell>
                            <cell/>
                        </row>
                        <row>
                            <cell align="right">
                                <customLabel value="@load(vm.etichette['Suffisso'])"/>
                            </cell>
                            <cell>
                                <hlayout valign="middle" hflex="1">
                                    <textbox value="@bind(vm.ricercaFamiglia.suffisso)" maxlength="10" hflex="1"
                                             style="text-transform:uppercase"/>
                                    <button image="/images/icon/action/16x16/cancel.png"
                                            tooltiptext="@load(vm.etichette['Cancella'])"
                                            onClick="@command('onCancellaCampoRicerca')">
                                        <custom-attributes proprieta="suffisso"/>
                                    </button>
                                </hlayout>
                            </cell>
                            <cell align="right">
                                <customLabel value="@load(vm.etichette['Interno'])"/>
                            </cell>
                            <cell>
                                <hlayout valign="middle" hflex="1">
                                    <intbox value="@bind(vm.ricercaFamiglia.interno)" maxlength="4"
                                            onOK="@command('onRicerca')"
                                            hflex="1"/>
                                    <label value="/"/>
                                    <textbox value="@bind(vm.ricercaFamiglia.subInterno)" maxlength="3"
                                             onOK="@command('onRicerca')"
                                             hflex="1"/>
                                    <button image="/images/icon/action/16x16/cancel.png"
                                            tooltiptext="@load(vm.etichette['Cancella'])"
                                            onClick="@command('onCancellaCampoRicerca')">
                                        <custom-attributes proprieta="interno,subInterno"/>
                                    </button>
                                </hlayout>
                            </cell>
                            <cell align="right">
                                <customLabel value="@load(vm.etichette['Scala'])"/>
                            </cell>
                            <cell>
                                <hlayout valign="middle" hflex="1">
                                    <textbox value="@bind(vm.ricercaFamiglia.scala)" maxlength="3"
                                             onOK="@command('onRicerca')"
                                             hflex="1"/>
                                    <button image="/images/icon/action/16x16/cancel.png"
                                            tooltiptext="@load(vm.etichette['Cancella'])"
                                            onClick="@command('onCancellaCampoRicerca')">
                                        <custom-attributes proprieta="scala"/>
                                    </button>
                                </hlayout>
                            </cell>
                            <cell align="right">
                                <customLabel value="@load(vm.etichette['Piano'])"/>
                            </cell>
                            <cell>
                                <hlayout valign="middle" hflex="1">
                                    <textbox value="@bind(vm.ricercaFamiglia.piano)" maxlength="3"
                                             onOK="@command('onRicerca')"
                                             hflex="1"/>
                                    <button image="/images/icon/action/16x16/cancel.png"
                                            tooltiptext="@load(vm.etichette['Cancella'])"
                                            onClick="@command('onCancellaCampoRicerca')">
                                        <custom-attributes proprieta="piano"/>
                                    </button>
                                </hlayout>
                            </cell>
                            <cell/>
                        </row>
                        <row>
                            <cell align="right">
                                <label value="@load(vm.etichette['Tipo'])"/>
                            </cell>
                            <cell>
                                <combobox model="@load(vm.listaTipoFamiglia)" readonly="true" hflex="1"
                                          selectedItem="@bind(vm.ricercaFamiglia.tipoFamiglia) @converter('it.finmatica.zk.utils.PropertyConverter', property='id')">
                                    <template name="model">
                                        <comboitem
                                                label="@load(empty each?vm.etichette['Tutti']:vm.getEtichettaEnum(each))"
                                                value="@load(each)"/>
                                    </template>
                                </combobox>
                            </cell>
                            <cell align="right">
                                <label value="@load(vm.etichette['Iscritto_in_APR'])"/>
                            </cell>
                            <cell>
                                <combobox model="@load(vm.listaIscrittoInAPR)" readonly="true" hflex="1"
                                          selectedItem="@bind(vm.ricercaFamiglia.iscrittoInAPR) @converter('it.finmatica.zk.utils.PropertyConverter', property='id')">
                                    <template name="model">
                                        <comboitem
                                                label="@load(empty each?vm.etichette['Tutti']:vm.getEtichettaEnum(each))"
                                                value="@load(each)"/>
                                    </template>
                                </combobox>
                            </cell>
                            <cell align="right">
                               <label value="@load(vm.etichette['Situazione_al'])"/>
                            </cell>
                            <cell>
                                <hlayout>
                                    <datebox format="dd/MM/yyyy" value="@bind(vm.ricercaFamiglia.data)"
                                             onOK="@command('onRicerca')" width="95px"/>
                                    <button image="/images/icon/action/16x16/cancel.png"
                                            tooltiptext="@load(vm.etichette['Cancella'])"
                                            onClick="@command('onCancellaCampoRicerca')">
                                        <custom-attributes proprieta="data"/>
                                    </button>
                                </hlayout>
                            </cell>
                            <cell colspan="2"/>
                            <cell>
                                <button label="@load(vm.etichette['Ricerca_in_Anagrafe'])"
                                        image="/images/icon/action/16x16/search.png"
                                        onClick="@command('onRicerca')"
                                        hflex="1"/>
                            </cell>
                        </row>
                    </rows>
                </grid>
            </groupbox>

            <hlayout valign="middle">
                <totalSizeBlock/>
            </hlayout>

            <listbox model="@load(vm.lista)" selectedItem="@bind(vm.dettaglio)" nonselectableTags="" vflex="1"
                     emptyMessage="@load(vm.etichette['Nessun_dato_disponibile'])">
                <auxhead>
                    <auxheader label="@load(c:cat3(vm.etichette['Capo_Famiglia'],'/',vm.etichette['Intestatario_Convivenza']))" align="center" colspan="6"/>
                    <auxheader label="@load(c:cat3(vm.etichette['Famiglia'],'/',vm.etichette['Convivenza']))" align="center" colspan="3"/>
                    <auxheader/>
                </auxhead>
                <listhead>
                    <listheader label="@load(vm.etichette['Cognome'])" hflex="2"/>
                    <listheader label="@load(vm.etichette['Nome'])" hflex="2"/>
                    <listheader label="@load(vm.etichette['Sesso'])" hflex="min"/>
                    <listheader label="@load(vm.etichette['Data_Nascita'])" hflex="1"/>
                    <listheader label="@load(vm.etichette['Comune_Nascita'])" hflex="2"/>
                    <listheader label="@load(vm.etichette['Codice_Fiscale'])" hflex="2"/>
                    <listheader label="@load(vm.etichette['Iscritto_in_APR'])" hflex="min" align="center"/>
                    <listheader label="@load(vm.etichette['Convivenza'])" hflex="2"/>
                    <listheader label="@load(vm.etichette['Indirizzo'])" hflex="3"/>
                    <listheader label="" width="52px"/>
                </listhead>
                <template name="model" var="item">
                    <listitem onDoubleClick="@command('onSeleziona')">
                        <listcell label="@load(not empty item.capoFamiglia?item.capoFamiglia.cognome : item.cognomeIntestatario)"/>
                        <listcell label="@load(not empty item.capoFamiglia?item.capoFamiglia.nome : item.nomeIntestatario)"/>
                        <listcell label="@load(not empty item.capoFamiglia?item.capoFamiglia.sesso : item.intestatarioConvivenza.sesso)"/>
                        <listcell>
                            <dateLabel value="@load(not empty item.capoFamiglia?item.capoFamiglia.dataNascita : item.intestatarioConvivenza.dataNascita)"/>
                        </listcell>
                        <listcell label="@load(not empty item.capoFamiglia?item.capoFamiglia.comuneNascita.descrizione : item.intestatarioConvivenza.comuneNascita.descrizione)"/>
                        <listcell label="@load(not empty item.capoFamiglia?item.capoFamiglia.codiceFiscale : item.intestatarioConvivenza.codiceFiscale)"/>
                        <listcell>
                            <checkbox checked="@load(item.fascia eq 'ISCRITTO_APR')" disabled="true"/>
                        </listcell>
                        <listcell label="@load(item.descrizioneConvivenza)"/>
                        <listcell
                                label="@load(c:cat3(item.indirizzo.via.denominazione, item.indirizzo.civicoEsternoFormatted, item.indirizzo.civicoInternoFormatted))"/>
                        <listcell>
                            <button image="/images/icon/action/16x16/forward.png"
                                    tooltiptext="@load(vm.etichette['seleziona_tooltip'])"
                                    visible="@load(not empty item.capoFamiglia)"
                                    onClick="@command('onSeleziona')"/>
                        </listcell>
                    </listitem>
                </template>
            </listbox>
        </vlayout>
    </window>


</zk>