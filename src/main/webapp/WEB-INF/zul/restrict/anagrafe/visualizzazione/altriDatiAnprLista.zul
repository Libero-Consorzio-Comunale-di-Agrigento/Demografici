<?xml version="1.0" encoding="UTF-8"?>
<?taglib uri="http://www.zkoss.org/dsp/web/core" prefix="c"?>
<?link rel="stylesheet" type="text/css" href="/css/de4gsdzk.css" ?>

<zk xmlns="http://www.zkoss.org/2005/zul"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.zkoss.org/2005/zul http://www.zkoss.org/2005/zul/zul.xsd">

    <window viewModel="@id('vm') @init('restrict.anagrafe.visualizzazione.AltriDatiAnprListaViewModel')"
            apply="org.zkoss.bind.BindComposer"
            border="none"
            width="100%" height="100%"
            sizable="false" closable="false">
        <vlayout vflex="1">

            <hlayout sclass="navigazione" valign="middle">
                <controlBar value="@load(vm.controlBarAttributes)"/>

                <label value="@load(vm.formLabel)" sclass="formTitle"/>

                <estremiIndividuoFormLabel/>
            </hlayout>

            <groupbox closable="false">
                <caption label="@load(vm.etichette['Dati_Traslitterati'])"/>
                <grid sclass="form">
                    <rows>
                        <row>
                            <cell align="right" width="150px">
                                <label value="@load(vm.etichette['Cognome'])"/>
                            </cell>
                            <cell>
                                <customLabel value="@load(vm.anpSoggetto.cognomeTraslitterato)" bold="true"/>
                            </cell>
                            <cell align="right" width="150px">
                                <label value="@load(vm.etichette['Nome'])"/>
                            </cell>
                            <cell>
                                <customLabel value="@load(vm.anpSoggetto.nomeTraslitterato)" bold="true"/>
                            </cell>
                        </row>
                        <row>
                            <cell align="right" width="150px">
                                <label value="@load(vm.etichette['Toponimo'])"/>
                            </cell>
                            <cell>
                                <customLabel value="@load(vm.anpSoggetto.toponimoTraslitterato)" bold="true"/>
                            </cell>
                            <cell align="right" width="150px">
                                <label value="@load(vm.etichette['Comune'])"/>
                            </cell>
                            <cell>
                                <customLabel value="@load(vm.anpSoggetto.comuneTraslitterato)" bold="true"/>
                            </cell>
                        </row>
                    </rows>
                </grid>
            </groupbox>

            <groupbox closable="false" vflex="1">
                <caption label="@load(vm.etichette['Elenco_Operazioni'])"/>
                <vlayout vflex="1">
                    <orderByBlock/>
                    <listbox model="@load(vm.lista)"
                             nonselectableTags="" vflex="1"
                             emptyMessage="@load(vm.etichette['Nessun_dato_disponibile'])">
                        <listhead>
                            <listheader label="@load(vm.etichette['Operazione'])"/>
                            <listheader label="@load(vm.etichette['Data_Richiesta'])" width="120px"/>
                            <listheader label="@load(vm.etichette['Data_Decorrenza'])" width="120px"/>
                            <listheader width="52px"/>
                            <listheader width="52px"/>
                            <listheader label="@load(vm.etichette['Id_Operazione_Comune'])"/>
                            <listheader label="@load(vm.etichette['Id_Operazione_ANPR'])"/>
                            <listheader label="@load(vm.etichette['Stato'])"/>
                        </listhead>
                        <template name="model" var="item">
                            <listitem>
                                <listcell
                                        label="@load(c:cat3(empty item.operazioneRichiesta ? '' : item.operazioneRichiesta, empty item.operazioneRichiesta or empty item.descrizioneOperazioneRichiesta ? '' : ' - ', empty item.descrizioneOperazioneRichiesta ? '' : item.descrizioneOperazioneRichiesta))"/>
                                <listcell
                                        label="@load(empty item.dataRichiesta? null:(c:formatDate(item.dataRichiesta, 'dd/MM/yyyy')))"/>
                                <listcell
                                        label="@load(empty item.dataDecorrenza? null:(c:formatDate(item.dataDecorrenza, 'dd/MM/yyyy')))"/>
                                <listcell>
                                    <button image="/images/icon/action/16x16/prev.png"
                                            tooltiptext="@load(vm.etichette['Data_Decorrenza_tooltip'])"
                                            onClick="@command('onSelezionaDataRiferimento', dataDecorrenza = item.dataDecorrenza, precedente = false)"/>
                                </listcell>
                                <listcell>
                                    <button image="/images/icon/action/16x16/first.png"
                                            tooltiptext="@load(vm.etichette['Data_Decorrenza_Precedente_tooltip'])"
                                            onClick="@command('onSelezionaDataRiferimento', dataDecorrenza = item.dataDecorrenza, precedente = true)"/>
                                </listcell>
                                <listcell label="@load(item.operazioneComune)"/>
                                <listcell label="@load(item.operazioneAnpr)"/>
                                <listcell label="@load(item.stato)"/>
                            </listitem>
                        </template>
                    </listbox>
                </vlayout>
            </groupbox>

        </vlayout>

    </window>

</zk>