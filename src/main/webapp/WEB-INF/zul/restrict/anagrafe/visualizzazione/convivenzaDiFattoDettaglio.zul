<?xml version="1.0" encoding="UTF-8"?>
<?taglib uri="http://www.zkoss.org/dsp/web/core" prefix="c"?>

<zk xmlns="http://www.zkoss.org/2005/zul"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.zkoss.org/2005/zul http://www.zkoss.org/2005/zul/zul.xsd">

    <window viewModel="@id('vm') @init('restrict.anagrafe.visualizzazione.ConvivenzaDiFattoDettaglioViewModel')"
            apply="org.zkoss.bind.BindComposer"
            border="none"
            width="100%" height="@load(vm.wCenterHeight)"
            sizable="false" closable="false">

        <vlayout width="100%" height="100%" sclass="scroll">
            <hlayout sclass="navigazione" valign="middle">
                <controlBar value="@load(vm.controlBarAttributes)"/>

                <controlBar>
                    <toolbarbuttonDocumenti/>
                </controlBar>

                <label value="@load(vm.formLabel)" sclass="formTitle"/>

                <estremiIndividuoFormLabel/>
            </hlayout>
            <grid sclass="form">
                <rows>
                    <row>
                        <cell>
                            <groupbox closable="false">
                                <caption label="@load(vm.etichette['Convivenza_di_fatto'])"/>
                                <grid sclass="form">
                                    <columns>
                                        <column width="150px"/>
                                        <column/>
                                        <column width="150px"/>
                                        <column/>
                                        <column width="60px"/>
                                    </columns>
                                    <rows>
                                        <row>
                                            <cell align="right">
                                                <label value="@load(c:cat3(vm.etichette['Cognome'], ' ',vm.etichette['Convivente']))"/>
                                            </cell>
                                            <cell>
                                                <label value="@load(vm.dettaglio.cognomeConvivente)"
                                                       sclass="grassetto"/>
                                            </cell>
                                            <cell align="right">
                                                <label value="@load(c:cat3(vm.etichette['Nome'], ' ',vm.etichette['Convivente']))"/>
                                            </cell>
                                            <cell>
                                                <label value="@load(vm.dettaglio.nomeConvivente)"
                                                       sclass="grassetto"/>
                                            </cell>
                                            <cell>
                                                <button image="/images/icon/action/16x16/forward.png"
                                                        disabled="@load(empty vm.dettaglio.convivente)"
                                                        onClick="@command('onOpenConvivente')"/>
                                            </cell>
                                        </row>
                                        <row>
                                            <cell align="right">
                                                <label value="@load(vm.etichette['Stato'])"/>
                                            </cell>
                                            <cell colspan="4">
                                                <customLabel
                                                        value="@load(vm.getEtichettaEnum(vm.dettaglio.statoConvivenza))"
                                                        bold="true"/>
                                            </cell>
                                        </row>
                                        <row>
                                            <cell align="right">
                                                <label value="@load(vm.etichette['Note'])"/>
                                            </cell>
                                            <cell colspan="4">
                                                <customLabel value="@load(vm.dettaglio.note)" bold="true"/>
                                            </cell>
                                        </row>
                                        <row>
                                            <cell colspan="5">
                                                <groupbox closable="false">
                                                    <caption label="@load(vm.etichette['Inizio'])"/>
                                                    <grid sclass="form">
                                                        <rows>
                                                            <row>
                                                                <cell align="right" width="150px">
                                                                    <label value="@load(vm.etichette['Data'])"/>
                                                                </cell>
                                                                <cell>
                                                                    <label value="@load(empty vm.dettaglio.dataInizio ? null : (c:formatDate(vm.dettaglio.dataInizio, 'dd/MM/yyyy')))"
                                                                           sclass="grassetto"/>
                                                                </cell>
                                                                <cell align="right">
                                                                    <label value="@load(vm.etichette['Comune'])"/>
                                                                </cell>
                                                                <cell>
                                                                    <comuneLabel
                                                                            value="@load(vm.dettaglio.comuneInizio)"
                                                                            bold="true"/>
                                                                </cell>
                                                            </row>
                                                            <row>
                                                                <cell align="right" width="150px">
                                                                    <label value="@load(vm.etichette['Pratica'])"/>
                                                                </cell>
                                                                <cell>
                                                                    <customLabel
                                                                            value="@load(vm.dettaglio.praticaInizio)"
                                                                            bold="true"/>
                                                                </cell>
                                                                <cell align="right">
                                                                    <label value="@load(vm.etichette['Anno'])"/>
                                                                </cell>
                                                                <cell>
                                                                    <customLabel
                                                                            value="@load(vm.dettaglio.annoPraticaInizio)"
                                                                            bold="true"/>
                                                                </cell>
                                                            </row>
                                                        </rows>
                                                    </grid>
                                                </groupbox>
                                                <groupbox closable="false">
                                                    <caption label="@load(vm.etichette['Fine'])"/>
                                                    <grid sclass="form">
                                                        <rows>
                                                            <row>
                                                                <cell align="right" width="150px">
                                                                    <label value="@load(vm.etichette['Data'])"/>
                                                                </cell>
                                                                <cell>
                                                                    <label value="@load(empty vm.dettaglio.dataFine ? null : (c:formatDate(vm.dettaglio.dataFine, 'dd/MM/yyyy')))"
                                                                           sclass="grassetto"/>
                                                                </cell>
                                                                <cell align="right">
                                                                    <label value="@load(vm.etichette['Comune'])"/>
                                                                </cell>
                                                                <cell>
                                                                    <comuneLabel
                                                                            value="@load(vm.dettaglio.comuneFine)"
                                                                            bold="true"/>
                                                                </cell>
                                                            </row>
                                                            <row>
                                                                <cell align="right" width="150px">
                                                                    <label value="@load(vm.etichette['Pratica'])"/>
                                                                </cell>
                                                                <cell>
                                                                    <customLabel value="@load(vm.dettaglio.praticaFine)"
                                                                                 bold="true"/>
                                                                </cell>
                                                                <cell align="right">
                                                                    <label value="@load(vm.etichette['Anno'])"/>
                                                                </cell>
                                                                <cell>
                                                                    <customLabel
                                                                            value="@load(vm.dettaglio.annoPraticaFine)"
                                                                            bold="true"/>
                                                                </cell>
                                                            </row>
                                                        </rows>
                                                    </grid>
                                                </groupbox>
                                            </cell>
                                        </row>

                                    </rows>
                                </grid>
                            </groupbox>
                        </cell>
                    </row>
                </rows>
            </grid>
        </vlayout>
    </window>
</zk>