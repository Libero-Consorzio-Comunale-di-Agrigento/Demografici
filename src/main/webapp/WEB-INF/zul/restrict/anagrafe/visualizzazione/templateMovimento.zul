                                    <customLabel value="@load(vm.etichette['A'])"/>
                                </cell>
                                <cell>
                                    <checkbox checked="@load(vm.dettaglio.cfCalcolato)" disabled="true"/>
                                </cell>
                            </row>

                            <!-- Paternità -->
