                                    <customLabel value="@load(vm.etichette['A'])"/>
                                </cell>
                                <cell>
                                    <estremiAttoLabel value="@load(vm.dettaglio.attoNascita)" bold="true"/>
                                </cell>
                            </row>
                            <row visible="@load(not vm.provvedimento and (vm.dettaglio.flagSoloCampiVariati ? (vm.dettaglio.attoNascitaTrascrittoPrecedente ne vm.dettaglio.attoNascitaTrascritto) : (vm.dettaglio.attoNascitaTrascrittoPrecedente.atto ne null or vm.dettaglio.attoNascitaTrascritto.atto ne null)))">
                                <cell align="right">
