                                </cell>
                                <cell align="right">
                                    <customLabel value="@load(vm.etichette['A'])"/>
                                </cell>
                                <cell>
                                    <customLabel value="@load(vm.dettaglio.codiceFiscale)" bold="true"/>
                                </cell>
                            </row>
                            <row visible="@load(not vm.provvedimento and (vm.dettaglio.flagSoloCampiVariati ? (vm.dettaglio.cfCalcolatoPrecedente ne vm.dettaglio.cfCalcolato) : (vm.dettaglio.cfCalcolatoPrecedente eq true or vm.dettaglio.cfCalcolato eq true)))">
                                <cell align="right">
                                    <customLabel value="@load(vm.etichette['CF_Calcolato'])"/>
                                </cell>
                                <cell align="right">
                                    <customLabel value="@load(vm.etichette['Da'])"/>
                                </cell>
                                <cell>
                                    <checkbox checked="@load(vm.dettaglio.cfCalcolatoPrecedente)" disabled="true"/>
