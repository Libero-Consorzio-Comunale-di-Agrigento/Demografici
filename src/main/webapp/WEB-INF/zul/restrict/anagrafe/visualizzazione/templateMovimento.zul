                            <row visible="@load(not vm.provvedimento and (vm.dettaglio.flagSoloCampiVariati ? (vm.dettaglio.nomePadrePrecedente ne vm.dettaglio.nomePadre) : (vm.dettaglio.nomePadrePrecedente ne null or vm.dettaglio.nomePadre ne null)))">
