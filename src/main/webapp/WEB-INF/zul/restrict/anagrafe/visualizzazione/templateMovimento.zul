                                                        <cell colspan="3">
                                                            <customLabel
                                                                    value="@load(vm.dettaglio.dettaglioProvvedimento.tipoSentenza)"
                                                                    bold="true"/>
                                                        </cell>
                                                        <cell align="right">
                                                            <customLabel value="@load(vm.etichette['Privacy'])"/>
                                                        </cell>
                                                        <cell>
                                                            <checkbox
                                                                    checked="@bind(vm.dettaglio.dettaglioProvvedimento.privacy)"
                                                                    disabled="true"/>
                                                        </cell>
                                                    </row>
                                                </rows>
                                            </grid>
                                        </groupbox>
                                    </cell>
                                </row>
                            </zk>
                            <zk if="${vm.provvedimento}">
                                <row>
                                    <cell colspan="5">
                                        <groupbox closable="false">
                                            <caption label="@load(vm.etichette['Dettaglio_Trascrizione'])"/>
                                            <grid sclass="form">
                                                <rows>
                                                    <row>
                                                        <cell align="right">
                                                            <label value="@load(vm.etichette['Atto_Trascritto'])"/>
                                                        </cell>
                                                        <cell colspan="5">
                                                            <estremiAttoLabel
                                                                    value="@load(vm.dettaglio.dettaglioProvvedimento.attoTrascritto)"
                                                                    bold="true"/>
                                                        </cell>
                                                    </row>
                                                    <row>
                                                        <cell align="right">
                                                            <customLabel value="@load(vm.etichette['Comune'])"/>
                                                        </cell>
                                                        <cell colspan="5">
                                                            <comuneLabel
                                                                    value="@load(vm.dettaglio.dettaglioProvvedimento.comuneAttoTrascritto)"
                                                                    bold="true"/>
                                                        </cell>
                                                    </row>
                                                    <row>
                                                        <cell align="right">
                                                            <customLabel value="@load(vm.etichette['Data'])"/>
                                                        </cell>
                                                        <cell colspan="5">
                                                            <dateLabel
                                                                    value="@load(vm.dettaglio.dettaglioProvvedimento.dataAttoTrascritto)"
                                                                    bold="true"/>
                                                        </cell>
                                                    </row>
                                                </rows>
                                            </grid>
                                        </groupbox>
                                    </cell>
                                </row>
                            </zk>
                        </rows>
                    </grid>
                </groupbox>

                <templateIdDomain/>

            </vlayout>
        </east>
    </borderlayout>

</zk>