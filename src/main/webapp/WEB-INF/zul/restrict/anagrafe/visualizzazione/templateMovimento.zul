                                    <customLabel value="@load(vm.etichette['Comune_Nascita'])"/>
                                </cell>
                                <cell align="right">
                                    <customLabel value="@load(vm.etichette['Da'])"/>
                                </cell>
                                <cell>
                                    <comuneLabel value="@load(vm.dettaglio.comuneNascitaPrecedente)" bold="true"/>
                                </cell>
                                <cell align="right">
                                    <customLabel value="@load(vm.etichette['A'])"/>
                                </cell>
                                <cell>
                                    <comuneLabel value="@load(vm.dettaglio.comuneNascita)" bold="true"/>
                                </cell>
                            </row>
                            <row visible="@load(not vm.provvedimento and (vm.dettaglio.flagSoloCampiVariati ? (vm.dettaglio.comuneAttoNascitaPrecedente.codice ne vm.dettaglio.comuneAttoNascita.codice) : (vm.dettaglio.comuneAttoNascitaPrecedente.codice ne null or vm.dettaglio.comuneAttoNascita.codice ne null)))">
                                <cell align="right">
                                    <customLabel value="@load(vm.etichette['Comune_Atto_Nascita'])"/>
                                </cell>
                                <cell align="right">
                                    <customLabel value="@load(vm.etichette['Da'])"/>
                                </cell>
                                <cell>
