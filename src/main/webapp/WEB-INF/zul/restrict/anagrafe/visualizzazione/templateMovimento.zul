<?xml version="1.0" encoding="UTF-8"?>
<zk xmlns="http://www.zkoss.org/2005/zul">

    <borderlayout vflex="1">
        <center vflex="1">
            <listbox model="@load(vm.lista)" selectedItem="@bind(vm.dettaglio)"
                     nonselectableTags="" vflex="1"
                     emptyMessage="@load(vm.etichette['Nessun_dato_disponibile'])">
                <listhead>
                    <listheader label="@load(vm.etichette['Data_Evento'])" hflex="1"/>
                    <listheader label="@load(vm.etichette['Descrizione'])" hflex="2"/>
                    <listheader label="@load(vm.etichette['Data_Registrazione'])" hflex="1"/>
                    <listheader label="@load(vm.etichette['Terminalista'])" hflex="1"/>
                </listhead>
                <template name="model" var="item">
                    <listitem>
                        <listcell>
                            <dateLabel value="@load(item.dataEvento)"/>
                        </listcell>
                        <listcell label="@load(item.descrizione)"/>
                        <listcell>
                            <dateLabel value="@load(item.dataRegistrazione)"/>
                        </listcell>
                        <listcell label="@load(item.utenteUpd.nominativo)"/>
                    </listitem>
                </template>
            </listbox>
        </center>
        <east size="50%" collapsible="true" splittable="true" open="@load(not empty vm.dettaglio)" autoscroll="true">
            <vlayout hflex="1">
                <groupbox mold="3d" style="background: #EDEFF5" closable="false">
                    <caption label="@load(vm.etichette['Dettaglio_Movimento'])"/>
                    <grid sclass="form">
                        <columns>
                            <column width="120px"/>
                            <column width="48px"/>
                            <column/>
                            <column width="48px"/>
                            <column/>
                        </columns>
                        <rows>
                            <row visible="@load(not vm.provvedimento and vm.dettaglio.pratica ne null)">
                                <cell colspan="5">
                                    <groupbox closable="false">
                                        <caption label="@load(vm.etichette['Dettaglio_Pratica'])"/>
                                        <grid sclass="form">
                                            <rows>
                                                <row>
                                                    <cell align="right" width="141px">
                                                        <customLabel value="@load(vm.etichette['Numero'])"/>
                                                    </cell>
                                                    <cell>
                                                        <customLabel
                                                                value="@load(vm.dettaglio.pratica)"
                                                                bold="true"/>
                                                    </cell>
                                                    <cell align="right" width="141px">
                                                        <customLabel value="@load(vm.etichette['Anno'])"/>
                                                    </cell>
                                                    <cell>
                                                        <customLabel
                                                                value="@load(vm.dettaglio.annoPratica)"
                                                                bold="true"/>
                                                    </cell>
                                                    <cell align="right" width="141px">
                                                        <customLabel value="@load(vm.etichette['Conteggio'])"/>
                                                    </cell>
                                                    <cell>
                                                        <checkbox
                                                                checked="@load(not vm.dettaglio.noConteggio)"
                                                                disabled="true"/>
                                                    </cell>
                                                </row>
                                                <row visible="@load(vm.dettaglio.comuneEvento.codice ne null)">
                                                    <cell align="right" width="141px">
                                                        <customLabel value="@load(vm.etichette['Comune_Evento'])"/>
                                                    </cell>
                                                    <cell colspan="5">
                                                        <comuneLabel
                                                                value="@load(vm.dettaglio.comuneEvento)"
                                                                bold="true"/>
                                                    </cell>
                                                </row>
                                                <row visible="@load(vm.dettaglio.comuneIscrizioneAire.codice ne null)">
                                                    <cell align="right" width="141px">
                                                        <customLabel value="@load(vm.etichette['Comune_Iscrizione_Aire'])"/>
                                                    </cell>
                                                    <cell colspan="5">
                                                        <comuneLabel
                                                                value="@load(vm.dettaglio.comuneIscrizioneAire)"
                                                                bold="true"/>
                                                    </cell>
                                                </row>
                                            </rows>
                                        </grid>
                                    </groupbox>
                                </cell>
                            </row>

                            <row visible="@load(vm.dettaglio.flagSoloCampiVariati ? (vm.dettaglio.cognomePrecedente ne vm.dettaglio.cognome) : (vm.dettaglio.cognomePrecedente ne null or vm.dettaglio.cognome ne null))">
                                <cell align="right">
                                    <customLabel value="@load(vm.etichette['Cognome'])"/>
                                </cell>
                                <cell align="right">
                                    <customLabel value="@load(vm.etichette['Da'])"/>
                                </cell>
                                <cell>
                                    <customLabel value="@load(vm.dettaglio.cognomePrecedente)" bold="true"/>
                                </cell>
                                <cell align="right">
                                    <customLabel value="@load(vm.etichette['A'])"/>
                                </cell>
                                <cell>
                                    <customLabel value="@load(vm.dettaglio.cognome)" bold="true"/>
                                </cell>
                            </row>
                            <row visible="@load(vm.dettaglio.flagSoloCampiVariati ? (vm.dettaglio.nomePrecedente ne vm.dettaglio.nome) : (vm.dettaglio.nomePrecedente ne null or vm.dettaglio.nome ne null))">
                                <cell align="right">
                                    <customLabel value="@load(vm.etichette['Nome'])"/>
                                </cell>
                                <cell align="right">
                                    <customLabel value="@load(vm.etichette['Da'])"/>
                                </cell>
                                <cell>
                                    <customLabel value="@load(vm.dettaglio.nomePrecedente)" bold="true"/>
                                </cell>
                                <cell align="right">
                                    <customLabel value="@load(vm.etichette['A'])"/>
                                </cell>
                                <cell>
                                    <customLabel value="@load(vm.dettaglio.nome)" bold="true"/>
                                </cell>
                            </row>
                            <row visible="@load(vm.dettaglio.flagSoloCampiVariati ? (vm.dettaglio.sessoPrecedente ne vm.dettaglio.sesso) : (vm.dettaglio.sessoPrecedente ne null or vm.dettaglio.sesso ne null))">
                                <cell align="right">
                                    <customLabel value="@load(vm.etichette['Sesso'])"/>
                                </cell>
                                <cell align="right">
                                    <customLabel value="@load(vm.etichette['Da'])"/>
                                </cell>
                                <cell>
                                    <customLabel value="@load(vm.dettaglio.sessoPrecedente)" bold="true"/>
                                </cell>
                                <cell align="right">
                                    <customLabel value="@load(vm.etichette['A'])"/>
                                </cell>
                                <cell>
                                    <customLabel value="@load(vm.dettaglio.sesso)" bold="true"/>
                                </cell>
                            </row>
                            <row visible="@load(vm.dettaglio.flagSoloCampiVariati ? (vm.dettaglio.dataNascitaPrecedente ne vm.dettaglio.dataNascita) : (vm.dettaglio.dataNascitaPrecedente ne null or vm.dettaglio.dataNascita ne null))">
                                <cell align="right">
                                    <customLabel value="@load(vm.etichette['Data_Nascita'])"/>
                                </cell>
                                <cell align="right">
                                    <customLabel value="@load(vm.etichette['Da'])"/>
                                </cell>
                                <cell>
                                    <dateLabel value="@load(vm.dettaglio.dataNascitaPrecedente)" bold="true"/>
                                </cell>
                                <cell align="right">
                                    <customLabel value="@load(vm.etichette['A'])"/>
                                </cell>
                                <cell>
                                    <dateLabel value="@load(vm.dettaglio.dataNascita)" bold="true"/>
                                </cell>
                            </row>
                            <row visible="@load(not vm.provvedimento and (vm.dettaglio.flagSoloCampiVariati ? (vm.dettaglio.annoNascitaPrecedente ne vm.dettaglio.annoNascita) : (vm.dettaglio.annoNascitaPrecedente eq true or vm.dettaglio.annoNascita eq true)))">
                                <cell align="right">
                                    <customLabel value="@load(vm.etichette['Data_Nascita_Solo_Anno'])"/>
                                </cell>
                                <cell align="right">
                                    <customLabel value="@load(vm.etichette['Da'])"/>
                                </cell>
                                <cell>
                                    <checkbox checked="@load(vm.dettaglio.annoNascitaPrecedente)" disabled="true"/>
                                </cell>
                                <cell align="right">
                                    <customLabel value="@load(vm.etichette['A'])"/>
                                </cell>
                                <cell>
                                    <checkbox checked="@load(vm.dettaglio.annoNascita)" disabled="true"/>
                                </cell>
                            </row>
                            <row visible="@load(not vm.provvedimento and (vm.dettaglio.flagSoloCampiVariati ? (vm.dettaglio.comuneNascitaPrecedente.codice ne vm.dettaglio.comuneNascita.codice) : (vm.dettaglio.comuneNascitaPrecedente.codice ne null or vm.dettaglio.comuneNascita.codice ne null)))">
