                                    <customLabel value="@load(vm.etichette['Da'])"/>
                                </cell>
                                <cell>
                                    <customLabel value="@load(vm.dettaglio.descrizioneStatoCivilePrecedente)"
                                                 bold="true"/>
                                </cell>
                                <cell align="right">
                                    <customLabel value="@load(vm.etichette['A'])"/>
                                </cell>
                                <cell>
                                    <customLabel value="@load(vm.dettaglio.descrizioneStatoCivile)" bold="true"/>
                                </cell>
                            </row>
                            <row visible="@load(vm.dettaglio.flagSoloCampiVariati ? (vm.dettaglio.nazionalitaPrecedente.descrizione ne vm.dettaglio.nazionalita.descrizione) : (vm.dettaglio.nazionalitaPrecedente.descrizione ne null or vm.dettaglio.nazionalita.descrizione ne null))">
                                <cell align="right">
                                    <customLabel value="@load(vm.etichette['Nazionalita'])"/>
                                </cell>
                                <cell align="right">
                                    <customLabel value="@load(vm.etichette['Da'])"/>
                                </cell>
                                <cell>
                                    <customLabel value="@load(vm.dettaglio.nazionalitaPrecedente.descrizione)"
                                                 bold="true"/>
                                </cell>
                                <cell align="right">
                                    <customLabel value="@load(vm.etichette['A'])"/>
                                </cell>
                                <cell>
                                    <customLabel value="@load(vm.dettaglio.nazionalita.descrizione)" bold="true"/>
                                </cell>
                            </row>
                            <row visible="@load(vm.dettaglio.flagSoloCampiVariati ? (vm.dettaglio.codiceFiscalePrecedente ne vm.dettaglio.codiceFiscale) : (vm.dettaglio.codiceFiscalePrecedente ne null or vm.dettaglio.codiceFiscale ne null))">
                                <cell align="right">
                                    <customLabel value="@load(vm.etichette['Codice_Fiscale'])"/>
