                            <row visible="@load(vm.dettaglio.flagSoloCampiVariati ? (vm.dettaglio.descrizioneStatoCivilePrecedente ne vm.dettaglio.descrizioneStatoCivile) : (vm.dettaglio.descrizioneStatoCivilePrecedente ne null or vm.dettaglio.descrizioneStatoCivile ne null))">
