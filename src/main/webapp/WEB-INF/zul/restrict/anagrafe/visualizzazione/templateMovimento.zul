                                </cell>
                                <cell align="right">
                                    <customLabel value="@load(vm.etichette['A'])"/>
                                </cell>
                                <cell>
                                    <comuneLabel value="@load(vm.dettaglio.comuneAttoNascita)" bold="true"/>
                                </cell>
                            </row>
                            <row visible="@load(not vm.provvedimento and (vm.dettaglio.flagSoloCampiVariati ? (vm.dettaglio.attoNascitaPrecedente ne vm.dettaglio.attoNascita) : (vm.dettaglio.attoNascitaPrecedente.atto ne null or vm.dettaglio.attoNascita.atto ne null)))">
                                <cell align="right">
                                    <customLabel value="@load(vm.etichette['Atto_Nascita'])"/>
