<?xml version="1.0" encoding="UTF-8"?>
<?taglib uri="http://www.zkoss.org/dsp/web/core" prefix="c"?>
<?link rel="stylesheet" type="text/css" href="/css/de4gsdzk.css" ?>
<?xel-method prefix="c" name="westWidth" class="it.finmatica.de4gsdzk.utils.ConfigurazioneUtils" signature="String getWestWidth()"?>
<?component name="templateSezioneFamiglia" macroURI="/restrict/anagrafe/visualizzazione/templateSezioneFamiglia.zul" inline="true"?>
<?component name="templateComponentiFamigliaLista" macroURI="/restrict/anagrafe/visualizzazione/templateComponentiFamigliaLista.zul" inline="true"?>

<zk xmlns="http://www.zkoss.org/2005/zul"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.zkoss.org/2005/zul http://www.zkoss.org/2005/zul/zul.xsd">

    <window viewModel="@id('vm') @init('restrict.anagrafe.visualizzazione.FamigliaListaViewModel')"
            apply="org.zkoss.bind.BindComposer"
            border="none"
            width="100%" height="100%"
            sizable="false" closable="false">
        <vlayout vflex="1">

            <hlayout sclass="navigazione" valign="middle">
                <controlBar value="@load(vm.controlBarAttributes)">
                    <toolbarbutton image="/images/icon/action/22x22/user_home.png"
                                   tooltiptext="@load(vm.etichette['Storico_famiglia_tooltip'])"
                                   onClick="@command('onOpenStorico')"/>
                    <toolbarbuttonAllegati/>
                </controlBar>

                <label value="@load(vm.formLabel)" sclass="formTitle"/>

                <estremiIndividuoFormLabel/>
            </hlayout>
            <templateSezioneFamiglia/>
            <borderlayout vflex="1">
                <center vflex="1" border="none" style="border: 1px solid #c5c5c5;">
                    <caption sclass="mainCaption">
                        <div>
                            <label value="Componenti Anagrafe" sclass="captionLabel"/>
                        </div>
                    </caption>
                    <vlayout hflex="1" vflex="1">
                        <templateComponentiFamigliaLista/>
                    </vlayout>
                </center>
                <east size="50%" vflex="true" collapsible="true"
                      visible="@load(not empty vm.anprIndividuoCorrente)"
                      style="background-color: #EDEFF5;">
                    <caption sclass="mainCaption">
                        <hlayout valign="middle">
                            <image src="/images/de4gsdzk/18x18/anpr.png"/>
                            <label value="Componenti ANPR" sclass="captionLabel"/>
                        </hlayout>
                    </caption>
                    <include vflex="1" src="/restrict/anagrafe/visualizzazione/famigliaAnprLista.zul"/>
                </east>

            </borderlayout>
        </vlayout>
    </window>


</zk>