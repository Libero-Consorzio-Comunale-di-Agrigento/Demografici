<?xml version="1.0" encoding="UTF-8"?>
<?taglib uri="http://www.zkoss.org/dsp/web/core" prefix="c"?>

<?component name="templateRowDatiIntestatario" macroURI="/restrict/anagrafe/pratiche/templateRowDatiIntestatario.zul" inline="true"?>
<?component name="templateRowDatiConvivenza" macroURI="/restrict/anagrafe/pratiche/templateRowDatiConvivenza.zul" inline="true"?>
<?component name="templateElementoCivico" macroURI="/restrict/anagrafe/pratiche/templateElementoCivico.zul" inline="true"?>

<zk xmlns="http://www.zkoss.org/2005/zul"
    xmlns:h="http://www.w3.org/1999/xhtml"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.zkoss.org/2005/zul http://www.zkoss.org/2005/zul/zul.xsd">

    <groupbox mold="3d" hflex="1" open="false">
        <caption sclass="mainCaption">
            <div>
                <updownbutton onClick="@command(self.openClose())" sclass="captionButton"/>
                <label value="@load(vm.etichette['Sezione_Famiglia_Pratica'])" sclass="captionLabel"/>
            </div>
        </caption>
        <grid sclass="form">
            <columns>
                <column width="150px"/>
                <column hflex="3"/>
                <column width="150px"/>
                <column hflex="1"/>
                <column width="150px"/>
                <column hflex="1"/>
                <column width="55px"/>
            </columns>
            <rows>
                <row>
                    <cell align="right">
                        <customLabel mandatory="true" value="@load(vm.etichette['Aggregazione'])"/>
                    </cell>
                    <cell>
                        <radiogroup selectedItem="@bind(vm.dichiarazione.flagAggregazione)"
                                    onCheck="@command('onSelectAggregazione')" hflex="1">
                            <radio label="@load(vm.etichette['SI'])" value="${true}"
                                   disabled="@load(vm.readOnly or vm.pratica.flagPerfezionamentoPreliminare)"/>
                            <radio label="@load(vm.etichette['NO'])" value="${false}"
                                   disabled="@load(vm.readOnly or vm.pratica.flagPerfezionamentoPreliminare)"/>
                        </radiogroup>
                    </cell>
                    <cell align="right">
                        <customLabel mandatory="true" value="@load(vm.etichette['Tipo'])"/>
                    </cell>
                    <cell>
                        <combobox model="@load(vm.listaTipoFamiglia)" readonly="true" hflex="1"
                                  disabled="@load(vm.readOnly or vm.pratica.flagPerfezionamentoPreliminare)"
                                  onSelect="@command('onSelectTipoFamiglia')"
                                  selectedItem="@bind(vm.dichiarazione.tipoFamiglia) @converter('it.finmatica.zk.utils.PropertyConverter', property='id')">
                            <template name="model">
                                <comboitem
                                        label="@load(empty each?'--':vm.getEtichettaEnum(each))"
                                        value="@load(each)"/>
                            </template>
                        </combobox>
                    </cell>
                    <cell colspan="3"/>
                </row>
                <!-- Riga Indirizzo + Specie Area + Toponimo -->
                <row>
                    <cell align="right">
                        <customLabel mandatory="true" value="@load(vm.etichette['Indirizzo'])"/>
                    </cell>
                    <cell>
                        <hlayout valign="middle" sclass="hlayout-indirizzo">
                            <bandboxVia sclass="bandbox-via-spacing" hflex="1"
                                        value="@load(vm.dichiarazione.indirizzo.via.denominazione)"
                                        onSelect="@command('onSelectVia')"
                                        disabled="@load(vm.readOnly)"/>
                            <button image="/images/icon/action/16x16/cancel.png" disabled="@load(vm.readOnly)"
                                    tooltiptext="@load(vm.etichette['Cancella'])"
                                    onClick="@command('onCancellaCampoPratica', sezione='F')">
                                <custom-attributes proprieta="indirizzo.via"/>
                            </button>
                        </hlayout>
                    </cell>
                    <cell align="right">
                        <customLabel value="@load(vm.etichette['Specie_Area'])"/>
                    </cell>
                    <cell>
                        <textbox value="@load(vm.dichiarazione.indirizzo.via.specieArea)" hflex="1"
                                 readonly="true" disabled="true"/>
                    </cell>
                    <cell align="right">
                        <customLabel value="@load(vm.etichette['Toponimo'])"/>
                    </cell>
                    <cell>
                        <textbox value="@load(vm.dichiarazione.indirizzo.via.toponimo)" hflex="1"
                                 readonly="true" disabled="true"/>
                    </cell>
                    <cell/>
                </row>
                <!-- Civico esterno: campi dinamici da ARCDNC -->
                <row visible="@load(not empty vm.elementiCivicoEsterno)">
                    <cell align="right">
                        <customLabel value="@load(vm.etichette['Civico_Esterno'])"/>
                    </cell>
                    <cell colspan="5">
                        <div sclass="dettagliCivicoContainer"
                             children="@load(vm.elementiCivicoEsterno)">
                            <template name="children" var="el">
                                <templateElementoCivico/>
                            </template>
                        </div>
                    </cell>
                    <cell align="right">
                        <button image="/images/icon/action/16x16/search.png" disabled="@load(vm.readOnly)"
                                visible="@load(empty vm.elementiCivicoInterno)"
                                onClick="@command('onRicercaFamiglia')"/>
                    </cell>
                </row>
                <!-- Civico interno: campi dinamici da ARCDNC -->
                <row visible="@load(not empty vm.elementiCivicoInterno)">
                    <cell align="right">
                        <customLabel value="@load(vm.etichette['Civico_Interno'])"/>
                    </cell>
                    <cell colspan="5">
                        <div sclass="dettagliCivicoContainer"
                             children="@load(vm.elementiCivicoInterno)">
                            <template name="children" var="el">
                                <templateElementoCivico/>
                            </template>
                        </div>
                    </cell>
                    <cell align="right">
                        <button image="/images/icon/action/16x16/search.png" disabled="@load(vm.readOnly)"
                                onClick="@command('onRicercaFamiglia')"/>
                    </cell>
                </row>

                <row visible="@load(vm.dichiarazione.flagAggregazione)">
                    <cell colspan="8">
                        <groupbox closable="false">
                            <caption label="@load(vm.etichette['Presso'])"/>
                            <grid sclass="form">
                                <columns>
                                    <column width="135px"/>
                                    <column/>
                                    <column width="135px"/>
                                    <column/>
                                    <column width="135px"/>
                                    <column width="100px"/>
                                    <column width="50px"/>
                                </columns>
                                <rows>
                                    <row>
                                        <cell align="right">
                                            <customLabel value="@load(vm.etichette['Cognome'])"/>
                                        </cell>
                                        <cell>
                                            <hlayout valign="middle">
                                                <textbox value="@bind(vm.dichiarazione.cognomePresso)"
                                                         hflex="1" onChanging="@command('svuotaCodiciFamiglia')"
                                                         readonly="@load(vm.readOnly)"/>
                                                <button image="/images/icon/action/16x16/cancel.png"
                                                        disabled="@load(vm.readOnly)"
                                                        tooltiptext="@load(vm.etichette['Cancella'])"
                                                        onClick="@command('onCancellaCampoPratica', sezione='F')">
                                                    <custom-attributes proprieta="cognomePresso"/>
                                                </button>
                                            </hlayout>
                                        </cell>
                                        <cell align="right">
                                            <customLabel value="@load(vm.etichette['Nome'])"/>
                                        </cell>
                                        <cell>
                                            <hlayout valign="middle">
                                                <textbox value="@bind(vm.dichiarazione.nomePresso)"
                                                         hflex="1" onChanging="@command('svuotaCodiciFamiglia')"
                                                         readonly="@load(vm.readOnly)"/>
                                                <button image="/images/icon/action/16x16/cancel.png"
                                                        disabled="@load(vm.readOnly)"
                                                        tooltiptext="@load(vm.etichette['Cancella'])"
                                                        onClick="@command('onCancellaCampoPratica', sezione='F')">
                                                    <custom-attributes proprieta="nomePresso"/>
                                                </button>
                                            </hlayout>
                                        </cell>
                                        <cell align="right">
                                            <customLabel value="@load(vm.etichette['Codice_Famiglia'])"/>
                                        </cell>
                                        <cell>
                                            <textbox hflex="1" value="@bind(vm.dichiarazione.codFamigliaDest)"
                                                     readonly="true"/>
                                        </cell>
                                        <cell/>
                                    </row>
                                </rows>
                            </grid>
                        </groupbox>
                    </cell>
                </row>

                <row visible="@load(not vm.dichiarazione.flagAggregazione and vm.dichiarazione.famigliaDest ne null and vm.dichiarazione.tipoFamiglia.id eq 'F')">
                    <cell colspan="8">
                        <templateRowDatiIntestatario codice="true"/>
                    </cell>
                </row>

                <row visible="@load(vm.dichiarazione.tipoFamiglia.id eq 'C')">
                    <cell colspan="8">
                        <templateRowDatiConvivenza codice="true"/>
                    </cell>
                </row>
            </rows>
        </grid>

    </groupbox>

</zk>