<?xml version="1.0" encoding="UTF-8"?>
<?taglib uri="http://www.zkoss.org/dsp/web/core" prefix="c"?>
<?component name="templateSezioneInformazioniPraticaDettaglio" macroURI="/restrict/anagrafe/pratiche/templateSezioneInformazioniPraticaDettaglio.zul" inline="true"?>
<?component name="templateSezioneRettificaPraticaDettaglio" macroURI="/restrict/anagrafe/pratiche/templateSezioneRettificaPraticaDettaglio.zul" inline="true"?>
<?component name="templateSezioneRettificaIndividuoPraticaDettaglio" macroURI="/restrict/anagrafe/pratiche/templateSezioneRettificaIndividuoPraticaDettaglio.zul" inline="true"?>
<?component name="templateSezioneRettificaFamigliaPraticaDettaglio" macroURI="/restrict/anagrafe/pratiche/templateSezioneRettificaFamigliaPraticaDettaglio.zul" inline="true"?>
<?component name="templateSezioneRettificaIndirizzoPraticaDettaglio" macroURI="/restrict/anagrafe/pratiche/templateSezioneRettificaIndirizzoPraticaDettaglio.zul" inline="true"?>
<?component name="templateSezioneDichiarantePraticaDettaglio" macroURI="/restrict/anagrafe/pratiche/templateSezioneDichiarantePraticaDettaglio.zul" inline="true"?>
<?component name="templateSezionePulsanti" macroURI="/restrict/anagrafe/pratiche/templateSezionePulsanti.zul" inline="true"?>

<zk xmlns="http://www.zkoss.org/2005/zul"
    xmlns:h="http://www.w3.org/1999/xhtml"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.zkoss.org/2005/zul http://www.zkoss.org/2005/zul/zul.xsd">

    <window viewModel="@id('vm') @init('restrict.anagrafe.pratiche.PraticaRettificaResDettaglioViewModel')"
            apply="org.zkoss.bind.BindComposer"
            border="none"
            width="100%" height="100%"
            sizable="false" closable="false">

        <hlayout valign="middle">
            <controlBarDettaglio/>
            <controlBarPratica/>

            <label value="@load(vm.formLabel)" sclass="formTitle"/>

            <estremiPraticaFormLabel/>
        </hlayout>

        <vlayout vflex="1" width="100%" sclass="scroll">

            <templateSezioneInformazioniPraticaDettaglio/>

            <templateSezioneRettificaPraticaDettaglio/>

            <templateSezioneRettificaIndividuoPraticaDettaglio/>

            <!-- Utilizzato sia per le rettifiche di rapporto parentela che per la visualizzazione-->
            <!-- della famiglia nelle rettifiche di indirizzo-->
            <templateSezioneRettificaFamigliaPraticaDettaglio/>

            <templateSezioneRettificaIndirizzoPraticaDettaglio/>

            <templateSezioneDichiarantePraticaDettaglio/>

            <templateSezionePulsanti/>

            <templateIdDomain/>
        </vlayout>
    </window>
</zk>