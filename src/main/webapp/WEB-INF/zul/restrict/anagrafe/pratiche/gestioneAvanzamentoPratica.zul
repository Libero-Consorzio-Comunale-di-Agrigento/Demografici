<?xml version="1.0" encoding="UTF-8"?>
<?taglib uri="http://www.zkoss.org/dsp/web/core" prefix="c"?>


<zk xmlns="http://www.zkoss.org/2005/zul"
    xmlns:h="http://www.w3.org/1999/xhtml"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.zkoss.org/2005/zul http://www.zkoss.org/2005/zul/zul.xsd">

    <window viewModel="@id('vm') @init('restrict.anagrafe.pratiche.GestioneAvanzamentoPraticaViewModel')"
            apply="org.zkoss.bind.BindComposer"
            width="100%" height="100%"
            sizable="false" closable="false">

        <hlayout valign="middle">
            <hlayout sclass="navigazione" valign="middle">
                <hlayout sclass="afc-control-bar" valign="middle">
                    <toolbarbuttonBackFromList/>

                    <toolbarbutton image="/images/icon/action/22x22/add.png"
                                   tooltiptext="@load(vm.etichette['inserisci_avanzamento_tooltip'])"
                                   onClick="@command('onInserisciAvanzamento')"/>

                    <toolbarbutton image="/images/icon/action/22x22/save.png"
                                   tooltiptext="@load(vm.etichette['salva_tooltip'])"
                                   onClick="@command('onSalva')"/>

                    <toolbarbutton image="/images/icon/action/22x22/mail.png"
                                   tooltiptext="@load(vm.etichette['comunicazioni_tooltip'])"
                                   disabled="@load(not (vm.pratica.flagPerfezionamentoPreliminare or vm.pratica.flagPerfezionamento))"
                                   onClick="@command('onOpenComunicazioni', priorita=false)"/>

                    <toolbarbutton image="/images/de4gsdzk/22x22/mail_alert.png"
                                   tooltiptext="@load(vm.etichette['adempimenti_tooltip'])"
                                   disabled="@load(vm.pratica.id eq null)"
                                   onClick="@command('onOpenComunicazioni', priorita=true)"/>

                    <toolbarbutton image="/images/icon/action/22x22/folder_edit.png"
                                   tooltiptext="@load(vm.etichette['allegati_tooltip'])"
                                   disabled="@load(vm.pratica.id eq null)"
                                   onClick="@command('onOpenAllegati')"/>
                </hlayout>
            </hlayout>

            <label value="@load(vm.formLabel)" sclass="formTitle"/>

            <estremiPraticaFormLabel/>
        </hlayout>


        <listbox model="@load(vm.pratica.avanzamentiPratica)" vflex="1"
                 emptyMessage="@load(vm.etichette['Nessun_Avanzamento_Presente'])">
            <listhead>
                <listheader label="@load(vm.etichette['Sequenza'])" width="100px"/>
                <listheader label="@load(vm.etichette['Evento_Pratica'])"/>
                <listheader label="@load(vm.etichette['Web'])" width="50px"/>
                <listheader label="@load(vm.etichette['Data_Evento'])" width="120px"/>
                <listheader label="@load(vm.etichette['Data_Restituzione'])" width="120px"/>
                <listheader label="@load(vm.etichette['Esito'])" width="100px"/>
                <listheader label="@load(vm.etichette['Note'])"/>
                <listheader label="" width="60px"/>
            </listhead>
            <template name="model" var="item">
                <listitem>
                    <listcell>
                        <textbox hflex="1" value="@bind(item.sequenza)" disabled="true"/>
                    </listcell>
                    <listcell>
                        <combobox model="@load(vm.listaEventiPratica)" readonly="true" hflex="1"
                                  disabled="@load(item.id ne null)"
                                  onSelect="@command('onSelectEvento', avanzamento=item)"
                                  selectedItem="@bind(item.eventoPratica) @converter('it.finmatica.zk.utils.PropertyConverter', property='codEp')">
                            <template name="model">
                                <comboitem label="@load(each.descrizione)" value="@load(each)"/>
                            </template>
                        </combobox>
                    </listcell>
                    <listcell>
                        <checkbox disabled="@bind(not item.eventoPratica.flagOnline)"
                                  checked="@bind(item.flagOnline)"/>
                    </listcell>
                    <listcell>
                        <datebox format="dd/MM/yyyy" value="@bind(item.dataEvento)"
                                 width="100px"/>
                    </listcell>
                    <listcell>
                        <datebox format="dd/MM/yyyy" value="@bind(item.dataRestituzione)"
                                 width="100px"/>
                    </listcell>
                    <listcell>
                        <combobox model="@load(vm.listaEsiti)" readonly="true" hflex="1"
                                  disabled="@bind(not item.eventoPratica.flagEsito)"
                                  selectedItem="@bind(item.esito) @converter('it.finmatica.zk.utils.PropertyConverter', property='id')"
                                  onSelect="@command('onSelectEsito', avanzamento=item)">
                            <template name="model">
                                <comboitem
                                        label="@load(empty each? ' ' :vm.getEtichettaEnum(each))"
                                        value="@load(each)"/>
                            </template>
                        </combobox>
                    </listcell>
                    <listcell>
                        <textbox rows="2" hflex="1" value="@bind(item.note)"/>
                    </listcell>
                    <listcell>
                        <button image="/images/icon/action/22x22/delete.png"
                                tooltiptext="@load(vm.etichette['elimina_tooltip'])"
                                onClick="@command('onEliminaAvanzamento', avanzamento=item)"/>
                    </listcell>
                </listitem>
            </template>
        </listbox>

    </window>

</zk>
