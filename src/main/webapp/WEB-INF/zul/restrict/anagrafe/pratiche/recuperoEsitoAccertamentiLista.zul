<?xml version="1.0" encoding="UTF-8"?>
<?taglib uri="http://www.zkoss.org/dsp/web/core" prefix="c"?>

<zk xmlns="http://www.zkoss.org/2005/zul"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.zkoss.org/2005/zul http://www.zkoss.org/2005/zul/zul.xsd">

    <window viewModel="@id('vm') @init('restrict.anagrafe.pratiche.RecuperoEsitoAccertamentiListaViewModel')"
            apply="org.zkoss.bind.BindComposer"
            border="none"
            width="100%" height="100%"
            sizable="false" closable="false">

        <hlayout valign="middle">
            <hlayout sclass="navigazione" valign="middle">
                <hlayout sclass="afc-control-bar" valign="middle">
                    <toolbarbuttonBackFromList/>
                    <paging sclass="afc-paging"
                            onPaging="@command('onPagina')"
                            activePage="@bind(vm.activePage)"
                            pageSize="@bind(vm.pageSize)"
                            totalSize="@load(vm.totalSize)"/>
                </hlayout>
            </hlayout>

            <label value="@load(vm.formLabel)" sclass="formTitle"/>
        </hlayout>

        <groupbox closable="false">
            <grid sclass="form">
                <rows>
                    <row>
                        <cell align="right">
                            <label value="@load(vm.etichette['Archivio_Anagrafe'])"/>
                        </cell>
                        <cell colspan="3">
                            <hlayout valign="middle">
                                <radiogroup model="@load(vm.listaTipoArchivioPratica)" hflex="1">
                                    <template name="model">
                                        <radio label="@load(vm.getEtichettaEnum(each))"
                                               value="@load(each)"
                                               selected="true"/>
                                    </template>
                                </radiogroup>
                            </hlayout>
                        </cell>
                        <cell align="right">
                            <label value="@load(vm.etichette['Tipo_Pratica'])"/>
                        </cell>
                        <cell colspan="6">
                            <hlayout valign="middle">
                                <radiogroup model="@load(vm.listaTipoPratica)" hflex="1"
                                            selectedItem="@bind(vm.tipoPratica) @converter('it.finmatica.zk.utils.PropertyConverter', property='id')"
                                            onCheck="@command('selectTipoPratica')">
                                    <template name="model">
                                        <radio label="@load(empty each? vm.etichette['Tutti'] : vm.getEtichettaEnum(each))"
                                               value="@load(each)"
                                               style="padding-left:10px"/>
                                    </template>
                                </radiogroup>
                            </hlayout>
                        </cell>
                    </row>
                </rows>
            </grid>
        </groupbox>

        <orderByBlock/>

        <listbox model="@load(vm.lista)" vflex="1"
                 emptyMessage="@load(vm.etichette['Nessun_Accertamento_Presente'])">
            <listhead>
                <listheader label="@load(vm.etichette['Tipo_Pratica'])"/>
                <listheader label="@load(vm.etichette['Numero_Pratica'])"/>
                <listheader label="@load(vm.etichette['Anno_Pratica'])"/>
                <listheader label="@load(vm.etichette['Esito'])"/>
                <listheader label="@load(vm.etichette['Data_Esito'])"/>
                <listheader label="@load(vm.etichette['Utente'])"/>
                <listheader label="@load(vm.etichette['Sequenza'])"/>
                <listheader label="@load(vm.etichette['Note'])"/>
                <listheader label="" width="52px"/>
                <listheader label="" width="52px"/>
            </listhead>
            <template name="model" var="item">
                <listitem>
                    <listcell label="@load(vm.getEtichettaEnum(item.tipoPratica))"/>
                    <listcell label="@bind(item.pratica)"/>
                    <listcell label="@bind(item.annoPratica)"/>
                    <listcell label="@load(vm.getEtichettaEnum(item.esito))"/>
                    <listcell label="@load(empty item.dataEsito? null:(c:formatDate(item.dataEsito, 'dd/MM/yyyy')))"/>
                    <listcell label="@bind(item.utente)"/>
                    <listcell label="@bind(item.sequenza)"/>
                    <listcell label="@bind(item.note)"/>
                    <listcell>
                        <button image="/images/icon/action/16x16/import.png"
                                tooltiptext="@load(vm.etichette['scarica_documento_tooltip'])"
                                disabled="@load(item.blobAllegato eq null)"
                                onClick="@command('onDownloadDocumenti', accertamento=item)"/>
                    </listcell>
                    <listcell>
                        <button image="/images/icon/action/16x16/forward.png"
                                tooltiptext="@load(vm.etichette['seleziona_tooltip'])"
                                onClick="@command('onSeleziona', accertamento=item)"/>
                    </listcell>
                </listitem>
            </template>
        </listbox>
    </window>
</zk>
