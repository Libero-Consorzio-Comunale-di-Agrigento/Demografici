<?xml version="1.0" encoding="UTF-8"?>
<?taglib uri="http://www.zkoss.org/dsp/web/core" prefix="c"?>

<zk xmlns="http://www.zkoss.org/2005/zul"
    xmlns:h="http://www.w3.org/1999/xhtml"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:w="http://www.zkoss.org/2005/zk/client"
    xsi:schemaLocation="http://www.zkoss.org/2005/zul http://www.zkoss.org/2005/zul/zul.xsd">

    <groupbox closable="false">
        <caption label="@load(vm.etichette['Convivenza'])"/>
        <grid sclass="form">
            <columns>
                <column width="135px"/>
                <column/>
                <column/>
                <column width="135px"/>
                <column/>
                <column/>
                <column width="135px"/>
                <column width="50px"/>
            </columns>
            <rows>
                <row>
                    <cell align="right">
                        <customLabel mandatory="@load(not vm.dichiarazione.flagAggregazione)"
                                     value="@load(vm.etichette['Tipo'])"/>
                    </cell>
                    <cell colspan="2">
                        <combobox model="@load(vm.listaTipoConvivenza)" readonly="true" hflex="1"
                                  selectedItem="@bind(vm.dichiarazione.tipoConvivenza)"
                                  disabled="@load(vm.readOnly or vm.dichiarazione.flagAggregazione)">
                            <template name="model">
                                <comboitem label="@load(each.descrizione)"
                                           value="@load(each)"/>
                            </template>
                        </combobox>
                    </cell>
                    <cell align="right">
                        <customLabel mandatory="@load( not vm.dichiarazione.flagAggregazione)"
                                     value="@load(vm.etichette['Denominazione'])"/>
                    </cell>
                    <cell colspan="2">
                        <hlayout valign="middle">
                            <textbox value="@bind(vm.dichiarazione.convivenza)"
                                     hflex="1" readonly="@load(vm.readOnly or vm.dichiarazione.flagAggregazione)"/>
                            <button image="/images/icon/action/16x16/cancel.png"
                                    disabled="@load(vm.readOnly or vm.dichiarazione.flagAggregazione)"
                                    tooltiptext="@load(vm.etichette['Cancella'])"
                                    onClick="@command('onCancellaCampoPratica', sezione='C')">
                                <custom-attributes proprieta="convivenza"/>
                            </button>
                        </hlayout>
                    </cell>
                    <cell/>
                    <cell/>
                </row>
                <row>
                    <cell align="right">
                        <customLabel mandatory="@load( not vm.dichiarazione.flagAggregazione)"
                                     value="@load(vm.etichette['Cognome_Intestatario_Convivenza'])"/>
                    </cell>
                    <cell colspan="2">
                        <hlayout valign="middle">
                            <textbox value="@bind(vm.dichiarazione.cognomeIntestatarioConvivenza)"
                                     hflex="1" onChanging="@command('svuotaMatricolaIntestatario')"
                                     style="text-transform:uppercase"
                                     readonly="@load(vm.readOnly or vm.dichiarazione.flagAggregazione)"/>
                            <button image="/images/icon/action/16x16/cancel.png"
                                    disabled="@load(vm.readOnly or vm.dichiarazione.flagAggregazione)"
                                    tooltiptext="@load(vm.etichette['Cancella'])"
                                    onClick="@command('onCancellaCampoPratica', sezione='C')">
                                <custom-attributes proprieta="cognomeIntestatarioConvivenza"/>
                            </button>
                        </hlayout>
                    </cell>
                    <cell align="right">
                        <customLabel mandatory="@load( not vm.dichiarazione.flagAggregazione)"
                                     value="@load(vm.etichette['Nome_Intestatario_Convivenza'])"/>
                    </cell>
                    <cell colspan="2">
                        <hlayout valign="middle">
                            <textbox value="@bind(vm.dichiarazione.nomeIntestatarioConvivenza)"
                                     hflex="1" onChanging="@command('svuotaMatricolaIntestatario')"
                                     style="text-transform:uppercase"
                                     readonly="@load(vm.readOnly or vm.dichiarazione.flagAggregazione)"/>
                            <button image="/images/icon/action/16x16/cancel.png"
                                    disabled="@load(vm.readOnly or vm.dichiarazione.flagAggregazione)"
                                    tooltiptext="@load(vm.etichette['Cancella'])"
                                    onClick="@command('onCancellaCampoPratica', sezione='C')">
                                <custom-attributes proprieta="nomeIntestatarioConvivenza"/>
                            </button>
                        </hlayout>
                    </cell>
                    <cell>
                        <textbox value="@bind(vm.dichiarazione.intestatarioConvivenza.matricola)"
                                 readonly="true" width="100px"/>
                    </cell>
                    <cell>
                        <button image="/images/icon/action/16x16/search.png"
                                disabled="@load(vm.readOnly or vm.dichiarazione.flagAggregazione)"
                                onClick="@command('onRicercaSoggetto',  sezione='I')"/>
                    </cell>
                </row>
                <row>
                    <cell align="right">
                        <customLabel mandatory="@load( not vm.dichiarazione.flagAggregazione)"
                                     value="@load(vm.etichette['Data_Decorrenza_Convivenza'])"/>
                    </cell>
                    <cell>
                        <hlayout valign="middle">
                            <datebox format="dd/MM/yyyy"
                                     disabled="@load(vm.readOnly or vm.dichiarazione.flagAggregazione)"
                                     value="@bind(vm.dichiarazione.dataIntestatarioConvivenza)"
                                     width="110px"/>
                            <button image="/images/icon/action/16x16/cancel.png"
                                    disabled="@load(vm.readOnly or vm.dichiarazione.flagAggregazione)"
                                    tooltiptext="@load(vm.etichette['Cancella'])"
                                    onClick="@command('onCancellaCampoPratica', sezione='C')">
                                <custom-attributes proprieta="dataIntestatarioConvivenza"/>
                            </button>
                        </hlayout>
                    </cell>
                    <cell/>
                    <cell align="right">
                        <customLabel mandatory="@load( not vm.dichiarazione.flagAggregazione)"
                                     value="@load(vm.etichette['Data_Istituzione_Convivenza'])"/>
                    </cell>
                    <cell>
                        <hlayout valign="middle">
                            <datebox format="dd/MM/yyyy"
                                     value="@bind(vm.dichiarazione.dataIstituzioneConvivenza)"
                                     width="110px" disabled="@load(vm.readOnly or vm.dichiarazione.flagAggregazione)"/>
                            <button image="/images/icon/action/16x16/cancel.png"
                                    disabled="@load(vm.readOnly or vm.dichiarazione.flagAggregazione)"
                                    tooltiptext="@load(vm.etichette['Cancella'])"
                                    onClick="@command('onCancellaCampoPratica', sezione='C')">
                                <custom-attributes proprieta="dataIstituzioneConvivenza"/>
                            </button>
                        </hlayout>
                    </cell>
                    <cell align="right">
                        <zk if="${arg.codice eq true}">
                            <customLabel value="@load(vm.etichette['Codice_Famiglia'])"
                                         visible="@load(not vm.dichiarazione.flagAggregazione and vm.dichiarazione.famigliaDest ne null)"/>
                        </zk>
                    </cell>
                    <cell>
                        <zk if="${arg.codice eq true}">
                            <textbox value="@bind(vm.dichiarazione.codFamigliaDest)" readonly="true" width="100px"
                                     visible="@load(not vm.dichiarazione.flagAggregazione and vm.dichiarazione.famigliaDest ne null)"/>
                        </zk>
                    </cell>
                    <cell/>
                </row>
            </rows>
        </grid>
    </groupbox>

</zk>