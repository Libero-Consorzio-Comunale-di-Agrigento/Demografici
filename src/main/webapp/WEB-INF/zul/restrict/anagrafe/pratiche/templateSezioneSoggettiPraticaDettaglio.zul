<?xml version="1.0" encoding="UTF-8"?>
<?taglib uri="http://www.zkoss.org/dsp/web/core" prefix="c"?>

<zk xmlns="http://www.zkoss.org/2005/zul"
    xmlns:h="http://www.w3.org/1999/xhtml"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.zkoss.org/2005/zul http://www.zkoss.org/2005/zul/zul.xsd">

    <groupbox mold="3d" hflex="1" open="false" visible="@load(vm.pratica.id ne null)">
        <caption sclass="mainCaption">
            <div>
                <updownbutton onClick="@command(self.openClose())" sclass="captionButton"/>
                <label value="@load(vm.etichette['Sezione_Soggetti_Pratica'])" sclass="captionLabel"/>
            </div>
        </caption>

        <hlayout valign="middle" sclass="navigazione">
            <hlayout sclass="afc-control-bar" valign="middle">
                <toolbarbutton image="/images/icon/action/22x22/add.png"
                               tooltiptext="@load(vm.etichette['inserisci_soggetto_tooltip'])"
                               onClick="@command('onInserisciSoggetto')"
                               disabled="@bind(vm.readOnly or vm.pratica.flagPerfezionamentoPreliminare or vm.dichiarazione.codFamigliaProv ne null)"/>


                <toolbarbutton image="/images/icon/action/22x22/delete.png"
                        tooltiptext="@load(vm.etichette['elimina_tooltip'])"
                        visible="@load(vm.dichiarazione.codFamigliaProv ne null)"
                        onClick="@command('onEliminaFamiglia')"
                        disabled="@bind(vm.readOnly or vm.pratica.flagPerfezionamentoPreliminare)"/>

            </hlayout>
        </hlayout>

        <listbox model="@load(vm.soggetti)" nonselectableTags=""
                 emptyMessage="@load(vm.etichette['Nessun_Soggetto_Inserito'])">
            <listhead>
                <listheader label="@load(vm.etichette['Numero_Ordine'])" width="50px"/>
                <listheader label="@load(vm.etichette['Matricola'])" width="100px"/>
                <listheader label="@load(vm.etichette['Cognome'])"/>
                <listheader label="@load(vm.etichette['Nome'])"/>
                <listheader label="@load(vm.etichette['Data_Nascita'])" width="100px"/>
                <listheader label="@load(vm.etichette['Sesso'])" width="50px"/>
                <listheader label="@load(vm.etichette['Rapporto_Parentela'])"
                            visible="@load(vm.dichiarazione.codFamigliaProv eq null)"/>
                <listheader visible="@bind(vm.dichiarazione.codFamigliaProv ne null)" width="90px">
                    <hlayout>
                        <checkbox checked="@bind(vm.tuttiSoggettiSelezionati)"
                                  onCheck="@command('onToggleTuttiSoggetti')"
                                  disabled="@load(vm.readOnly or vm.soggetti.size() eq 1)"/>
                        <label value="@load(vm.etichette['Soggetto'])" style="font-weight:bold"/>
                    </hlayout>
                </listheader>
                <listheader label="@load(vm.etichette['Rapporto_Parentela_Provenienza'])"
                            visible="@bind(vm.dichiarazione.codFamigliaProv ne null)"/>
                <listheader label="@load(vm.etichette['Rapporto_Parentela_Destinazione'])"
                            visible="@bind(vm.dichiarazione.codFamigliaProv ne null)"/>
                <listheader label="@load(vm.etichette['Annulla'])" width="70px"/>
<!--                <listheader label="@load(vm.etichette['Stato_Anagrafico'])"/>-->
                <listheader label="" width="60px"/>
                <listheader label="" width="60px" visible="@load(vm.dichiarazione.codFamigliaProv eq null)"/>
                <zk if="${vm.caratteriSpecialiEnabled}">
                    <listheader label="" width="60px"/>
                </zk>
            </listhead>
            <template name="model" var="item">
                <listitem>
                    <listcell>
                        <intbox value="@bind(item.numeroOrdine)" hflex="1" onChange="@command('onChangeNumeroOrdine', sogg=item)"
                                readonly="@load(vm.readOnly or vm.pratica.flagPerfezionamentoPreliminare)"/>
                    </listcell>
                    <listcell label="@load(item.anagrafe.matricola)"/>
                    <listcell label="@load(item.anagrafe.cognome)" style="text-transform:uppercase"/>
                    <listcell label="@load(item.anagrafe.nome)" style="text-transform:uppercase"/>
                    <listcell
                            label="@load(empty item.anagrafe.dataNascita? null:(c:formatDate(item.anagrafe.dataNascita, 'dd/MM/yyyy')))"/>
                    <listcell label="@load(item.anagrafe.sesso)"/>
                    <listcell visible="@bind(vm.dichiarazione.codFamigliaProv eq null)">
                        <combobox
                                model="@load(item.anagrafe.sesso eq 'M' ? vm.rapportoParentelaMList : vm.rapportoParentelaFList)"
                                readonly="true" hflex="1"
                                onSelect="@command('onSelectRapportoParentela', soggetto=item, rapporto='N')"
                                disabled="@bind(vm.pratica.flagPerfezionamentoPreliminare or vm.readOnly)"
                                selectedItem="@bind(item.rapportoParentelaNuovo) @converter('it.finmatica.zk.utils.PropertyConverter', property='id')">
                            <template name="model">
                                <comboitem label="@load(each.descrizione)" value="@load(each)"/>
                            </template>
                        </combobox>
                    </listcell>
                    <listcell visible="@bind(vm.dichiarazione.codFamigliaProv ne null)">
                        <checkbox checked="@bind(item.flagSoggetto)"
                                  onCheck="@command('onCheckFlagSoggetto', soggetto=item)"
                                  disabled="@load(vm.readOnly or vm.soggetti.size() eq 1)"/>
                    </listcell>
                    <listcell visible="@bind(vm.dichiarazione.codFamigliaProv ne null)">
                        <combobox
                                model="@load(item.anagrafe.sesso eq 'M' ? vm.rapportoParentelaMPrecList : vm.rapportoParentelaFPrecList)"
                                readonly="true" hflex="1"
                                onSelect="@command('onSelectRapportoParentela', soggetto=item, rapporto='P')"
                                disabled="@load(vm.isRapportoParentelaPrecedenteNonModificabile() or vm.readOnly or item.flagSoggetto or vm.pratica.flagPerfezionamentoPreliminare)"
                                selectedItem="@bind(item.rapportoParentelaPrecedente) @converter('it.finmatica.zk.utils.PropertyConverter', property='id')">
                            <template name="model">
                                <comboitem label="@load(each.descrizione)" value="@load(each)"/>
                            </template>
                        </combobox>
                    </listcell>
                    <listcell visible="@bind(vm.dichiarazione.codFamigliaProv ne null)">
                        <combobox
                                model="@load(item.anagrafe.sesso eq 'M' ? vm.rapportoParentelaMList : vm.rapportoParentelaFList)"
                                readonly="true" hflex="1"
                                onSelect="@command('onSelectRapportoParentela', soggetto=item, rapporto='N')"
                                disabled="@bind(vm.isRapportoParentelaNuovoNonModificabile() or vm.readOnly or not item.flagSoggetto or vm.pratica.flagPerfezionamentoPreliminare)"
                                selectedItem="@bind(item.rapportoParentelaNuovo) @converter('it.finmatica.zk.utils.PropertyConverter', property='id')">
                            <template name="model">
                                <comboitem label="@load(each.descrizione)" value="@load(each)"/>
                            </template>
                        </combobox>
                    </listcell>
                    <listcell>
                        <checkbox checked="@bind(item.flagAnnullamento)"
                                  disabled="@load(vm.readOnly or not item.flagSoggetto)"
                                  onCheck="@command('popolaListaDichiaranti')"/>
                    </listcell>
                    <listcell>
                        <button image="/images/icon/action/22x22/edit.png"
                                disabled="@bind(vm.readOnly or item.flagAnnullamento)"
                                tooltiptext="@load(vm.etichette['modifica_tooltip'])"
                                visible="@load(vm.pratica.tipoPratica.id ne 'R')"
                                onClick="@command('onModificaSoggetto', soggetto=item)"/>
                    </listcell>
                    <listcell visible="@load(vm.dichiarazione.codFamigliaProv eq null)">
                        <button image="/images/icon/action/22x22/delete.png"
                                tooltiptext="@load(vm.etichette['elimina_tooltip'])"
                                onClick="@command('onEliminaSoggetto', soggetto=item)"
                                disabled="@bind(vm.readOnly or vm.pratica.flagPerfezionamentoPreliminare)"/>
                    </listcell>
                    <zk if="${vm.caratteriSpecialiEnabled}">
                        <listcell>
                            <button image="/images/icon/action/22x22/blackboard.png" disabled="@load(vm.readOnly)"
                                    tooltiptext="@load(vm.etichette['caratteri_speciali_tooltip'])"
                                    onClick="@command('onOpenCaratteriSpeciali', soggetto=item)"/>
                        </listcell>
                    </zk>
                </listitem>
            </template>
        </listbox>

    </groupbox>

</zk>