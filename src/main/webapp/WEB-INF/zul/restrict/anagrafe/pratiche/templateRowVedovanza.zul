<?xml version="1.0" encoding="UTF-8"?>
<?taglib uri="http://www.zkoss.org/dsp/web/core" prefix="c"?>
<?component name="templateRowEstremiAttoSoggettoPratica" macroURI="/restrict/anagrafe/pratiche/templateRowEstremiAttoSoggettoPratica.zul" inline="true"?>

<zk xmlns="http://www.zkoss.org/2005/zul"
    xmlns:h="http://www.w3.org/1999/xhtml"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:w="http://www.zkoss.org/2005/zk/client"
    xsi:schemaLocation="http://www.zkoss.org/2005/zul http://www.zkoss.org/2005/zul/zul.xsd">

    <groupbox closable="false"
              visible="@bind(vm.soggetto.statoCivile.isVedovo())">
        <caption
                label="@load(vm.etichette['Vedovanza'])"/>
        <grid sclass="form">
            <columns>
                <column width="135px"/>
                <column width="150px"/>
                <column width="135px"/>
                <column/>
                <column width="150px"/>
            </columns>
            <rows>
                <row>
                    <cell align="right">
                        <customLabel mandatory="true" value="@load(vm.etichette['Data'])"/>
                    </cell>
                    <cell>
                        <datebox format="dd/MM/yyyy"
                                 readonly="@load(vm.readOnly)"
                                 value="@bind( vm.soggetto.dataVedovanza)"
                                 width="95px"/>
                        <button image="/images/icon/action/16x16/cancel.png"
                                disabled="@load(vm.readOnly)"
                                tooltiptext="@load(vm.etichette['Cancella'])"
                                onClick="@command('onCancellaCampo')">
                            <custom-attributes proprieta="dataVedovanza"/>
                        </button>
                    </cell>
                    <cell align="right">
                        <customLabel mandatory="true" value="@load(vm.etichette['Comune'])"/>
                    </cell>
                    <cell>
                        <hlayout valign="middle" hflex="1">
                            <bandboxComuni hflex="1"
                                           disabled="@load(vm.readOnly)"
                                           value="@load(vm.soggetto.comuneVedovanza.descrizione)"
                                           dataRiferimento="@load(vm.soggetto.dataVedovanza)"
                                           onSelect="@command('onSelectComune', campoRiferimento='SOGG_VED')"/>
                            <button image="/images/icon/action/16x16/cancel.png"
                                    disabled="@load(vm.readOnly)"
                                    tooltiptext="@load(vm.etichette['Cancella'])"
                                    onClick="@command('onCancellaComune', campoRiferimento='SOGG_VED')"
                            />
                        </hlayout>
                    </cell>
                    <cell>
                        <textbox value="@load(vm.soggetto.comuneVedovanza.siglaProvincia)" hflex="1" readonly="true" />
                    </cell>
                </row>
                <row>
                    <cell align="right">
                        <label value="@load(vm.etichette['Estremi_Atto_Vedovanza'])"/>
                    </cell>
                    <cell colspan="5">
                        <grid hflex="1">
                            <rows>
                                <row>
                                    <cell>
                                        <grid>
                                            <rows>
                                                <templateRowEstremiAttoSoggettoPratica
                                                        vedovanza="true"/>
                                            </rows>
                                        </grid>
                                    </cell>
                                </row>
                            </rows>
                        </grid>
                    </cell>
                </row>
            </rows>
        </grid>
    </groupbox>

</zk>