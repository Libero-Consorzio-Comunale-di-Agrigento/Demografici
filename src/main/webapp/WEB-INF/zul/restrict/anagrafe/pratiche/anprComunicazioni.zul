<?xml version="1.0" encoding="UTF-8"?>
<?taglib uri="http://www.zkoss.org/dsp/web/core" prefix="c"?>


<zk xmlns="http://www.zkoss.org/2005/zul"
    xmlns:h="http://www.w3.org/1999/xhtml"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.zkoss.org/2005/zul http://www.zkoss.org/2005/zul/zul.xsd">

    <window viewModel="@id('vm') @init('restrict.anagrafe.pratiche.AnprComunicazioniViewModel')"
            apply="org.zkoss.bind.BindComposer"
            width="100%" height="100%"
            sizable="false" closable="false">

        <hlayout valign="middle">
            <hlayout sclass="navigazione" valign="middle">
                <hlayout sclass="afc-control-bar" valign="middle">
                    <toolbarbuttonBackFromList/>

                </hlayout>
            </hlayout>

            <label value="@load(vm.formLabel)" sclass="formTitle"/>

            <estremiPraticaFormLabel/>
        </hlayout>

        <!--INFO-->
        <groupbox mold="3d" closable="false" open="true">
            <caption label="@load(vm.etichette['Sezione_Informazioni_Pratica'])"/>
            <grid sclass="form">
                <columns>
                    <column width="200px"/>
                    <column/>
                    <column width="200px"/>
                    <column/>
                    <column width="200px"/>
                    <column/>
                </columns>
                <rows>
                    <row>
                        <cell align="right">
                            <label value="@load(vm.etichette['Variazione_Pratica'])"/>
                        </cell>
                        <cell>
                            <label value="@load(vm.pratica.descrizioneVariazione)" sclass="grassetto"/>
                        </cell>
                        <cell align="right">
                            <label value="@load(vm.etichette['Data_Pratica'])"/>
                        </cell>
                        <cell>
                            <label value="@load(empty vm.pratica.data ? null : c:formatDate(vm.pratica.data, 'dd/MM/yyyy'))"
                                   sclass="grassetto"/>
                        </cell>
                        <cell align="right">
                            <label value="@load(vm.etichette['Data_Decorrenza'])"/>
                        </cell>
                        <cell>
                            <label value="@load(empty vm.pratica.dataDecorrenza ? null : c:formatDate(vm.pratica.dataDecorrenza, 'dd/MM/yyyy'))"
                                   sclass="grassetto"/>
                        </cell>
                    </row>
                </rows>
            </grid>
        </groupbox>

        <!--PROVENIENZA-->
        <zk if="@load(not(vm.pratica.tipoPratica.id == 'E' and vm.pratica.archivioAnagrafe.id == 'RES'))">
            <groupbox mold="3d" closable="false" open="true">
                <caption label="@load(vm.etichette['Sezione_Provenienza_Pratica'])"/>
                <grid sclass="form">
                    <columns>
                        <column width="200px"/>
                        <column/>
                    </columns>
                    <rows>
                        <row>
                            <cell align="right">
                                <label value="@load(vm.etichette['Comune_Provenienza_Soggetto'])"/>
                            </cell>
                            <cell>
                                <label value="@load(empty vm.dichiarazione.comuneProvenienza.descrizione ? '' :
                                                c:cat4(vm.dichiarazione.comuneProvenienza.descrizione, ' (',vm.dichiarazione.comuneProvenienza.siglaProvincia, ')'))"
                                       sclass="grassetto"/>
                            </cell>
                        </row>
                        <row>
                            <cell align="right">
                                <label value="@load(vm.etichette['Comune_Iscrizione_Aire'])"/>
                            </cell>
                            <cell>
                                <label value="@load(empty vm.dichiarazione.comuneIscrizioneAire.descrizione ? '' :
                                                c:cat4(vm.dichiarazione.comuneIscrizioneAire.descrizione, ' (',vm.dichiarazione.comuneIscrizioneAire.siglaProvincia, ')'))"
                                       sclass="grassetto"/>
                            </cell>
                        </row>
                    </rows>
                </grid>
            </groupbox>
        </zk>

        <groupbox mold="3d" closable="false" open="true" vflex="1">
            <caption label="@load(vm.etichette['Comunicazioni'].toUpperCase())"/>
            <grid sclass="form">
                <columns>
                    <column width="200px"/>
                    <column/>
                    <column width="200px"/>
                    <column/>
                    <column width="200px"/>
                    <column/>
                </columns>
                <rows>
                    <row>
                        <cell align="right">
                            <customLabel value="@load(vm.etichette['Comunicazioni_Per'])"/>
                        </cell>
                        <cell>
                            <combobox model="@load(vm.listaSoggetti)" readonly="true" hflex="1"
                                      onChange="@command('onSelectFiltro')"
                                      selectedItem="@bind(vm.soggettoSelezionato) @converter('it.finmatica.zk.utils.PropertyConverter', property='value')">
                                <template name="model">
                                    <comboitem
                                            label="@load(empty each ? vm.etichette['Pratica'] :
                                                        (empty each.anagrafe ? vm.etichette['Pratica_e_Soggetti'] :
                                                        c:cat3(each.anagrafe.cognome, ' ', each.anagrafe.nome)))"
                                            value="@load(each)"/>
                                </template>
                            </combobox>
                        </cell>
                        <cell align="right">
                            <customLabel value="@load(vm.etichette['Fitri_Ws'])"/>
                        </cell>
                        <cell>
                            <hlayout height="20px" valign="middle">
                                <radiogroup model="@load(vm.listaSiNo)" onCheck="@command('onSelectFiltro')"
                                            selectedItem="@bind(vm.filtroWs) @converter('it.finmatica.zk.utils.PropertyConverter', property='id')">
                                    <template name="model">
                                        <radio label="@load(empty each? vm.etichette['Tutti'] : vm.getEtichettaEnum(each))" value="@load(each)" style="padding-left:10px"/>
                                    </template>
                                </radiogroup>
                            </hlayout>
                        </cell>
                        <cell align="right">
                            <customLabel value="@load(vm.etichette['Archivio_Riferimento'])"/>
                        </cell>
                        <cell>
                            <combobox model="@load(vm.listaArchiviRif)" readonly="true" hflex="1"
                                      onChange="@command('onSelectFiltro')"
                                      selectedItem="@bind(vm.archivioRif) @converter('it.finmatica.zk.utils.PropertyConverter', property='value')">
                                <template name="model">
                                    <comboitem
                                            label="@load(empty each? vm.etichette['Tutti'] :each.descrizione))"
                                            value="@load(each)"/>
                                </template>
                            </combobox>
                        </cell>
                    </row>
                </rows>
            </grid>

            <listbox model="@load(vm.lista)"
                     emptyMessage="@load(vm.etichette['Nessun_dato_disponibile'])"
                     vflex="1">
                <listhead sizable="true">
                    <listheader label="@load(vm.etichette['Id'])" width="90px"/>
                    <listheader label="@load(vm.etichette['Servizio'])"/>
                    <listheader label="@load(vm.etichette['Variazione_Pratica'])"/>
                    <listheader label="@load(vm.etichette['Dettaglio'])"/>
                    <listheader label="@load(vm.etichette['Annullata'])" width="80px"/>
                    <listheader width="380px"/>
                </listhead>
                <template name="model" var="item">
                    <listitem>
                        <listcell label="@load(item.id)"/>
                        <listcell label="@load(c:cat3(item.servizio.id, ' - ', item.servizio.descrizione))"/>
                        <listcell label="@load(item.variazione)"/>
                        <listcell label="@load(item.dettaglio)"/>
                        <listcell sclass="testo-al-centro">
                            <checkbox checked="@load(item.flagAnnullamento)" disabled="true"/>
                        </listcell>
                        <listcell>
                            <grid>
                                <rows>
                                    <row>
                                        <cell width="40px">
                                            <button image="/images/icon/action/18x18/arrows.png"
                                                    tooltiptext="@load(vm.etichette['invio_anpr_tooltip'])"
                                                    disabled="@bind(item.inviato or not empty item.noteWSAnpr)"
                                                    onClick="@command('onInviaComunicazione', c=item)"/>
                                        </cell>
                                        <cell width="40px">
                                            <button image="/images/icon/action/18x18/refresh.png"
                                                    tooltiptext="@load(vm.etichette['ripetizione_invio_tooltip'])"
                                                    disabled="@bind(not((not item.inviato and not empty item.noteWSAnpr) or (item.inviato and item.flagAnnullamento)))"
                                                    onClick="@command('onRipetiComunicazione', c=item)"/>
                                        </cell>
                                        <cell width="40px">
                                            <hlayout>
                                                <button image="/images/icon/action/18x18/ok.png"
                                                        tooltiptext="@load(vm.etichette['Inviato'])"
                                                        visible="@load(item.inviato and empty item.noteWSAnpr and item.esitoDescrizione eq 'Servizio inviato con successo')"
                                                        onClick="@command(c:showMsgBox(vm.msgTitle, 'I', item.esitoDescrizione))"/>
                                                <button image="/images/icon/action/18x18/doc_cancel.png"
                                                        tooltiptext="@load(vm.etichette['Comunicazione_Non_Inviata'])"
                                                        visible="@load(item.inviato and empty item.noteWSAnpr and item.esitoDescrizione.startsWith('Forzato invio WS'))"
                                                        onClick="@command(c:showMsgBox(vm.msgTitle, 'I', item.esitoDescrizione))"/>
                                                <button image="/images/icon/action/18x18/warning_light.png"
                                                        tooltiptext="@load(vm.etichette['info_tooltip'])"
                                                        visible="@load(not empty item.noteWSAnpr)"
                                                        onClick="@command(c:showMsgBox(vm.msgTitle, 'E', item.noteWSAnpr))"/>
                                            </hlayout>
                                        </cell>
                                        <cell width="40px">
                                            <button image="/images/icon/action/18x18/info.png"
                                                    tooltiptext="@load(vm.etichette['info_tooltip'])"
                                                    onClick="@command('onOpenStoricoComunicazioni', id=item.id)"/>
                                        </cell>
                                        <cell width="40px">
                                            <button image="/images/icon/action/18x18/cancel.png"
                                                    tooltiptext="@load(vm.etichette['Annulla_comunicazione_tooltip'])"
                                                    disabled="@bind(not item.inviato or item.flagAnnullamento)"
                                                    onClick="@command('onAnnullaComunicazione', c=item)"/>
                                        </cell>
                                        <cell width="40px">
                                            <button image="/images/icon/action/18x18/edit.png"
                                                    tooltiptext="@load(vm.etichette['Funzioni_Ausiliarie_tooltip'])"
                                                    disabled="@bind(item.inviato)"
                                                    onClick="@command('onModificaComunicazione', id=item.id)"/>
                                        </cell>
                                    </row>
                                </rows>
                            </grid>
                        </listcell>
                    </listitem>
                </template>
            </listbox>
        </groupbox>
    </window>

</zk>
