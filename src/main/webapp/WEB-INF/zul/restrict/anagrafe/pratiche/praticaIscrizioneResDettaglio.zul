<?xml version="1.0" encoding="UTF-8"?>
<?taglib uri="http://www.zkoss.org/dsp/web/core" prefix="c"?>
<?component name="templateSezioneInformazioniPraticaDettaglio" macroURI="/restrict/anagrafe/pratiche/templateSezioneInformazioniPraticaDettaglio.zul" inline="true"?>
<?component name="templateSezioneDichiarantePraticaDettaglio" macroURI="/restrict/anagrafe/pratiche/templateSezioneDichiarantePraticaDettaglio.zul" inline="true"?>
<?component name="templateSezioneFamigliaPraticaDettaglio" macroURI="/restrict/anagrafe/pratiche/templateSezioneFamigliaPraticaDettaglio.zul" inline="true"?>
<?component name="templateSezioneProvenienzaPraticaDettaglio" macroURI="/restrict/anagrafe/pratiche/templateSezioneProvenienzaPraticaDettaglio.zul" inline="true"?>
<?component name="templateSezioneApr4PraticaDettaglio" macroURI="/restrict/anagrafe/pratiche/templateSezioneApr4PraticaDettaglio.zul" inline="true"?>
<?component name="templateSezioneOccupazioneImmobilePraticaDettaglio" macroURI="/restrict/anagrafe/pratiche/templateSezioneOccupazioneImmobilePraticaDettaglio.zul" inline="true"?>
<?component name="templateSezioneSoggettiPraticaDettaglio" macroURI="/restrict/anagrafe/pratiche/templateSezioneSoggettiPraticaDettaglio.zul" inline="true"?>
<?component name="templateSezionePulsanti" macroURI="/restrict/anagrafe/pratiche/templateSezionePulsanti.zul" inline="true"?>
<?component name="templateSezioneModelloCancellazioneAire" macroURI="/restrict/anagrafe/pratiche/templateSezioneModelloCancellazioneAire.zul" inline="true"?>

<zk xmlns="http://www.zkoss.org/2005/zul"
    xmlns:h="http://www.w3.org/1999/xhtml"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.zkoss.org/2005/zul http://www.zkoss.org/2005/zul/zul.xsd">

    <window viewModel="@id('vm') @init('restrict.anagrafe.pratiche.PraticaIscrizioneResDettaglioViewModel')"
            apply="org.zkoss.bind.BindComposer"
            border="none"
            width="100%" height="100%"
            sizable="false" closable="false">

        <hlayout valign="middle">
            <controlBarDettaglio/>
            <controlBarPratica/>

            <label value="@load(vm.formLabel)" sclass="formTitle"/>

            <estremiPraticaFormLabel/>
        </hlayout>

        <vlayout vflex="1" width="100%" sclass="scroll">

            <templateSezioneInformazioniPraticaDettaglio/>

            <templateSezioneProvenienzaPraticaDettaglio/>

            <templateSezioneFamigliaPraticaDettaglio/>

            <templateSezioneOccupazioneImmobilePraticaDettaglio/>

            <templateSezioneSoggettiPraticaDettaglio/>

            <templateSezioneModelloCancellazioneAire/>

            <templateSezioneDichiarantePraticaDettaglio/>

            <templateSezioneApr4PraticaDettaglio/>

            <templateSezionePulsanti/>

            <templateIdDomain/>
        </vlayout>


    </window>

</zk>