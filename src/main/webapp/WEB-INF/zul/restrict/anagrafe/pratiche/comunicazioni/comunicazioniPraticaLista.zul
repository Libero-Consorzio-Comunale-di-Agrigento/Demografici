<?xml version="1.0" encoding="UTF-8"?>
<?taglib uri="http://www.zkoss.org/dsp/web/core" prefix="c"?>
<?component name="templateComunicazioni" macroURI="/restrict/templateComunicazioni.zul" inline="true"?>

<zk xmlns="http://www.zkoss.org/2005/zul"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.zkoss.org/2005/zul http://www.zkoss.org/2005/zul/zul.xsd">

	<window viewModel="@id('vm') @init('restrict.anagrafe.pratiche.comunicazioni.ComunicazioniPraticaListaViewModel')"
			apply="org.zkoss.bind.BindComposer"
			border="none"
			width="100%" height="100%"
			sizable="false" closable="false">

		<hlayout valign="middle">
			<controlBarComunicazioni/>

			<label value="@load(vm.formLabel)" sclass="formTitle"/>

			<hlayout sclass="testo-a-dx" hflex="1">
        <hlayout spacing="2px">

            <estremiPraticaLabel value="@load(vm.pratica)" bold="true"/>

            <space/>

        </hlayout>
    </hlayout>
		</hlayout>

		<vlayout vflex="1">

			<totalSizeBlock/>

			<templateComunicazioni pratica="true"/>

		</vlayout>
	</window>

</zk>