<?xml version="1.0" encoding="UTF-8"?>
<?taglib uri="http://www.zkoss.org/dsp/web/core" prefix="c"?>
<?xel-method prefix="c" name="showMsgBox" class="it.finmatica.de4gsdzk.utils.MessaggioUtils" signature="void showMsgBox(java.lang.String, java.lang.String, java.lang.String)"?>

<zk xmlns="http://www.zkoss.org/2005/zul"
	xmlns:h="http://www.w3.org/1999/xhtml"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul http://www.zkoss.org/2005/zul/zul.xsd">

	<window viewModel="@id('vm') @init('restrict.anagrafe.pratiche.AnprStoricoComunicazioniViewModel')"
			apply="org.zkoss.bind.BindComposer"
			border="none"
            width="1000px" height="500px"
			title="@load(vm.etichette['ANPR'])"
			sizable="false" closable="false">

		<vlayout vflex="1">

			<hlayout valign="middle">
				<controlBarLista/>
			</hlayout>

			<totalSizeBlock/>

			<listbox model="@load(vm.lista)" multiple="true" selectedItem="@bind(vm.dettaglio)" nonselectableTags="" vflex="1"
					 emptyMessage="@load(vm.etichette['Nessun_dato_disponibile'])">
				<listhead>
					<listheader label="@load(c:cat3(vm.etichette['Id'], ' - ', vm.etichette['Data_Registrazione']) )" width="200px"/>
					<listheader label="@load(vm.etichette['Data_Invio'])" width="135px"/>
					<listheader label="@load(vm.etichette['Esito'])" width="190px"/>
					<listheader label="@load(vm.etichette['Note'])"/>
					<listheader label="" width="52px"/>
				</listhead>
				<template name="model">
					<listitem>
						<listcell>
							<label value="@load(c:cat3(each.id, ' - ', (empty each.dataRegistrazione? '' : (c:formatDate(each.dataRegistrazione, 'dd/MM/yyyy HH:mm:ss'))) ) )"/>
						</listcell>
						<listcell>
							<label value="@load(empty each.dataInvio? '' : (c:formatDate(each.dataInvio, 'dd/MM/yyyy HH:mm:ss')))"/>
						</listcell>
						<listcell>
							<label value="@load(each.esitoDescrizione)"/>
						</listcell>
						<listcell>
							<html content="@load(each.infoWSAnpr)"/>
						</listcell>
						<listcell sclass="testo-al-centro">
							<button image="/images/icon/action/18x18/warning_light.png"
									tooltiptext="@load(vm.etichette['info_tooltip'])"
									visible="@load(not empty each.noteWSAnpr)"
									onClick="@command(c:showMsgBox(vm.msgTitle, 'E', each.noteWSAnpr))"/>
						</listcell>
					</listitem>
				</template>
			</listbox>

		</vlayout>

		<h:div sclass="barraPulsanti">
			<h:div>
				<button label="@load(vm.etichette['Chiudi'])"			onClick="@command('onChiudi')" 		image="/images/icon/action/16x16/close.png"/>
			</h:div>
		</h:div>

	</window>

</zk>