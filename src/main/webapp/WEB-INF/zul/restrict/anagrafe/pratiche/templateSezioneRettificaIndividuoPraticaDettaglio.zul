<?xml version="1.0" encoding="UTF-8"?>
<?taglib uri="http://www.zkoss.org/dsp/web/core" prefix="c"?>
<?component name="templateRowIndividuo" macroURI="/restrict/anagrafe/pratiche/templateRowIndividuo.zul" inline="true"?>
<?component name="templateRowNascita" macroURI="/restrict/anagrafe/pratiche/templateRowNascita.zul" inline="true"?>
<?component name="templateRowGenitori" macroURI="/restrict/anagrafe/pratiche/templateRowGenitori.zul" inline="true"?>
<?component name="templateRowMatrimonio" macroURI="/restrict/anagrafe/pratiche/templateRowMatrimonio.zul" inline="true"?>
<?component name="templateRowVedovanza" macroURI="/restrict/anagrafe/pratiche/templateRowVedovanza.zul" inline="true"?>
<?component name="templateRowDivorzio" macroURI="/restrict/anagrafe/pratiche/templateRowDivorzio.zul" inline="true"?>
<?component name="templateRowAltriDati" macroURI="/restrict/anagrafe/pratiche/templateRowAltriDati.zul" inline="true"?>
<?component name="templateSezioneConvivenzaDiFatto" macroURI="/restrict/anagrafe/pratiche/templateSezioneConvivenzaDiFatto.zul" inline="true"?>
<?component name="templateSezioneDocumenti" macroURI="/restrict/anagrafe/pratiche/templateSezioneDocumenti.zul" inline="true"?>
<?component name="templateSezioneRecapiti" macroURI="/restrict/anagrafe/pratiche/templateSezioneRecapiti.zul" inline="true"?>
<?component name="templateSezioneUrneCinerarie" macroURI="/restrict/anagrafe/pratiche/templateSezioneUrneCinerarie.zul" inline="true"?>

<zk xmlns="http://www.zkoss.org/2005/zul"
    xmlns:h="http://www.w3.org/1999/xhtml"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.zkoss.org/2005/zul http://www.zkoss.org/2005/zul/zul.xsd">

    <vlayout>
        <div hflex="1" >
            <vlayout hflex="1">
                <groupbox mold="3d" hflex="1" open="false"
                          visible="@bind(vm.dichiarazione.tipoRettifica.id eq 'I' and vm.pratica.id ne null)">
                    <caption sclass="mainCaption">
                        <div>
                            <updownbutton onClick="@command(self.openClose())" sclass="captionButton"/>
                            <label value="@load(vm.etichette['Sezione_Individuo_Pratica'])" sclass="captionLabel"/>
                        </div>
                    </caption>

                    <hlayout valign="middle" sclass="navigazione">
                        <hlayout sclass="afc-control-bar" valign="middle">
                            <toolbarbutton image="/images/icon/action/22x22/add.png"
                                           tooltiptext="@load(vm.etichette['inserisci_soggetto_tooltip'])"
                                           onClick="@command('onInserisciSoggetto')"
                                           disabled="@bind(vm.readOnly or vm.soggetti.size() gt 0)"/>


                            <toolbarbutton image="/images/icon/action/22x22/delete.png"
                                           tooltiptext="@load(vm.etichette['elimina_tooltip'])"
                                           onClick="@command('onEliminaSoggetto', sogg=soggetto)"
                                           disabled="@bind(vm.readOnly or vm.soggetti.size() eq 0)"/>

                        </hlayout>
                    </hlayout>

                    <div width="100%" visible="@load(vm.dichiarazione.tipoRettifica.id eq 'I' and vm.soggetti.size() gt 0)">
                        <grid hflex="1" sclass="form">
                            <rows>
                                <row>
                                    <cell>
                                        <templateRowIndividuo rettifica="true"/>

                                        <templateRowNascita/>

                                        <templateRowGenitori/>

                                        <templateRowMatrimonio/>

                                        <templateRowVedovanza/>

                                        <templateRowDivorzio/>

                                        <templateRowAltriDati rettifica="true"/>
                                    </cell>
                                </row>
                            </rows>
                        </grid>
                    </div>
                </groupbox>

                <templateSezioneConvivenzaDiFatto/>

                <templateSezioneDocumenti/>

                <templateSezioneRecapiti/>

                <templateSezioneUrneCinerarie/>
            </vlayout>

        </div>
    </vlayout>


</zk>