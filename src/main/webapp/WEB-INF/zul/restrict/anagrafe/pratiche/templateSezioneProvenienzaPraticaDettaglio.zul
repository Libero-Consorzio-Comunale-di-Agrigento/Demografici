<?xml version="1.0" encoding="UTF-8"?>
<?taglib uri="http://www.zkoss.org/dsp/web/core" prefix="c"?>

<zk xmlns="http://www.zkoss.org/2005/zul"
    xmlns:h="http://www.w3.org/1999/xhtml"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.zkoss.org/2005/zul http://www.zkoss.org/2005/zul/zul.xsd">

    <groupbox mold="3d" hflex="1" open="false">
        <caption sclass="mainCaption">
            <div>
                <updownbutton onClick="@command(self.openClose())" sclass="captionButton"/>
                <label value="@load(vm.etichette['Sezione_Provenienza_Pratica'])" sclass="captionLabel"/>
            </div>
        </caption>
        <grid sclass="form">
            <columns>
                <column width="150px"/>
                <column width="800px"/>
                <column width="150px"/>
                <column/>
            </columns>
            <rows>
                <row>
                    <cell align="right">
                        <label value="@load(vm.etichette['Comune_Provenienza_Soggetto'])"/>
                    </cell>
                    <cell>
                        <hlayout valign="middle" hflex="1">
                            <bandboxComuni hflex="1"
                                           value="@load(vm.dichiarazione.comuneProvenienza.descrizione)"
                                           escludiSoppressi="true"
                                           onSelect="@command('onSelectComune', campoRiferimento='PROV')"
                                           disabled="@load(vm.readOnly)"/>
                            <button image="/images/icon/action/16x16/cancel.png" disabled="@load(vm.readOnly)"
                                    tooltiptext="@load(vm.etichette['Cancella'])"
                                    onClick="@command('onCancellaComune', campoRiferimento='PROV')"/>
                            <space/>
                        </hlayout>
                    </cell>
                    <cell>
                        <textbox value="@load(vm.dichiarazione.comuneProvenienza.siglaProvincia)" hflex="1" readonly="true"/>
                    </cell>
                    <cell/>
                </row>
                <row>
                    <cell align="right">
                        <label value="@load(vm.etichette['Comune_Iscrizione_Aire'])"/>
                    </cell>
                    <cell>
                        <hlayout valign="middle" hflex="1">
                            <bandboxComuni hflex="1"
                                           value="@load(vm.dichiarazione.comuneIscrizioneAire.descrizione)"
                                           escludiSoppressi="true"
                                           onSelect="@command('onSelectComune', campoRiferimento='ISC_AIRE')"
                                           disabled="@load(vm.readOnly or not vm.comuneProvenienzaEstero)"/>
                            <button image="/images/icon/action/16x16/cancel.png"
                                    tooltiptext="@load(vm.etichette['Cancella'])"
                                    onClick="@command('onCancellaComune', campoRiferimento='ISC_AIRE')"
                                    disabled="@load(vm.readOnly or not vm.comuneProvenienzaEstero)"/>
                            <space/>
                        </hlayout>
                    </cell>
                    <cell>
                        <textbox value="@load(vm.dichiarazione.comuneIscrizioneAire.siglaProvincia)" hflex="1" readonly="true"/>
                    </cell>
                    <cell/>
                </row>
            </rows>
        </grid>
    </groupbox>

</zk>