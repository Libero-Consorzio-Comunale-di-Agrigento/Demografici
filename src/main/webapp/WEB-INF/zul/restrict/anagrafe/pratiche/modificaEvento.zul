<?xml version="1.0" encoding="UTF-8"?>
<?taglib uri="http://www.zkoss.org/dsp/web/core" prefix="c"?>

<zk xmlns="http://www.zkoss.org/2005/zul"
    xmlns:h="http://www.w3.org/1999/xhtml"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.zkoss.org/2005/zul http://www.zkoss.org/2005/zul/zul.xsd">

    <window viewModel="@id('vm') @init('restrict.anagrafe.pratiche.ModificaEventoViewModel')"
            apply="org.zkoss.bind.BindComposer"
            border="none"
            width="700px"
            title="@load(vm.msgTitle)"
            sizable="false" closable="false">
        <vlayout>
            <grid sclass="form">
                <rows>
                    <row>
                        <cell>
                            <groupbox closable="false" visible="@load(vm.modificaEvento.aggiornamento)">
                                <caption label="@load(vm.etichette['Nuovi_Valori'])"/>
                                <grid sclass="form">
                                    <columns>
                                        <column width="140px"/>
                                        <column/>
                                        <column width="140px"/>
                                        <column/>
                                    </columns>
                                    <rows>
                                        <row>
                                            <cell align="right">
                                                <customLabel value="@load(vm.etichette['Pratica'])"/>
                                            </cell>
                                            <cell>
                                                <hlayout valign="middle" hflex="1">
                                                    <intbox value="@bind(vm.modificaEvento.pratica)"/>
                                                    <button image="/images/icon/action/16x16/cancel.png"
                                                            tooltiptext="@load(vm.etichette['Cancella'])"
                                                            onClick="@command('onCancellaCampo')">
                                                        <custom-attributes proprieta="pratica"/>
                                                    </button>
                                                </hlayout>
                                            </cell>
                                            <cell>
                                                <customLabel value="@load(vm.etichette['Anno'])"/>
                                            </cell>
                                            <cell>
                                                <hlayout valign="middle" hflex="1">
                                                    <intbox value="@bind(vm.modificaEvento.anno)"/>
                                                    <button image="/images/icon/action/16x16/cancel.png"
                                                            tooltiptext="@load(vm.etichette['Cancella'])"
                                                            onClick="@command('onCancellaCampo')">
                                                        <custom-attributes proprieta="anno"/>
                                                    </button>
                                                </hlayout>
                                            </cell>
                                        </row>
                                        <row>
                                            <cell align="right">
                                                <customLabel value="@load(vm.etichette['Comune_Evento'])"/>
                                            </cell>
                                            <cell colspan="2">
                                                <hlayout valign="middle" hflex="1">
                                                    <bandboxComuni hflex="1"
                                                                   value="@load(vm.modificaEvento.comuneEvento.descrizione)"
                                                                   escludiSoppressi="true"
                                                                   onSelect="@command('onSelectComune', campoRiferimento='PROV')"/>
                                                    <button image="/images/icon/action/16x16/cancel.png"
                                                            tooltiptext="@load(vm.etichette['Cancella'])"
                                                            onClick="@command('onCancellaComune', campoRiferimento='PROV')"/>
                                                    <space/>
                                                </hlayout>
                                            </cell>
                                            <cell>
                                                <textbox value="@load(vm.modificaEvento.comuneEvento.siglaProvincia)"
                                                         readonly="true"/>
                                            </cell>
                                        </row>
                                        <row>
                                            <cell align="right">
                                                <label value="@load(vm.etichette['Comune_Iscrizione_Aire'])"/>
                                            </cell>
                                            <cell colspan="2">
                                                <hlayout valign="middle" hflex="1">
                                                    <bandboxComuni hflex="1"
                                                                   value="@load(vm.modificaEvento.comuneIscrizioneAire.descrizione)"
                                                                   escludiSoppressi="true"
                                                                   onSelect="@command('onSelectComune', campoRiferimento='ISC_AIRE')"/>
                                                    <button image="/images/icon/action/16x16/cancel.png"
                                                            tooltiptext="@load(vm.etichette['Cancella'])"
                                                            onClick="@command('onCancellaComune', campoRiferimento='ISC_AIRE')"/>
                                                    <space/>
                                                </hlayout>
                                            </cell>
                                            <cell>
                                                <textbox
                                                        value="@load(vm.modificaEvento.comuneIscrizioneAire.siglaProvincia)"
                                                        readonly="true"/>
                                            </cell>
                                        </row>
                                        <row>
                                            <cell align="right">
                                                <customLabel value="@load(vm.etichette['Data_Registrazione'])"/>
                                            </cell>
                                            <cell colspan="2">
                                                <hlayout valign="middle" hflex="1">
                                                    <datebox format="dd/MM/yyyy"
                                                             value="@bind(vm.modificaEvento.dataRegistrazione)"
                                                             width="95px"/>
                                                    <button image="/images/icon/action/16x16/cancel.png"
                                                            tooltiptext="@load(vm.etichette['Cancella'])"
                                                            onClick="@command('onCancellaCampo')">
                                                        <custom-attributes proprieta="dataRegistrazione"/>
                                                    </button>
                                                </hlayout>
                                            </cell>
                                            <cell colspan="2"/>
                                        </row>
                                    </rows>
                                </grid>
                            </groupbox>
                            <grid sclass="form">
                                <columns>
                                    <column width="145px"/>
                                    <column/>
                                </columns>
                                <rows>
                                    <row visible="@load(vm.modificaEvento.ripristinoVisible)">
                                        <cell align="right">
                                            <label value="@load(vm.etichette['Ripristino_DL'])"/>
                                        </cell>
                                        <cell colspan="3">
                                            <checkbox checked="@bind(vm.modificaEvento.ripristino)"/>
                                        </cell>
                                    </row>
                                    <row>
                                        <cell align="right">
                                            <customLabel mandatory="true" value="@load(vm.modificaEvento.aggiornamento ? vm.etichette['Motivo_Aggiornamento'] : vm.etichette['Motivo_Eliminazione'])"/>
                                        </cell>
                                        <cell colspan="3">
                                            <hlayout valign="middle">
                                                <textbox value="@bind(vm.modificaEvento.motivo)" hflex="1"/>
                                                <button image="/images/icon/action/16x16/cancel.png"
                                                        tooltiptext="@load(vm.etichette['Cancella'])"
                                                        onClick="@command('onCancellaCampo')">
                                                    <custom-attributes proprieta="motivo"/>
                                                </button>
                                            </hlayout>
                                        </cell>
                                    </row>
                                </rows>
                            </grid>
                        </cell>
                    </row>
                </rows>
            </grid>
        </vlayout>

        <h:div sclass="barraPulsanti">
            <h:div>
                <button label="@load(vm.etichette['Conferma'])" onClick="@command('onConferma')"
                        image="/images/icon/action/16x16/save.png"/>
                <button label="@load(vm.etichette['Chiudi'])" onClick="@command('onChiudi')"
                        image="/images/icon/action/16x16/close.png"/>
            </h:div>
        </h:div>

    </window>
</zk>