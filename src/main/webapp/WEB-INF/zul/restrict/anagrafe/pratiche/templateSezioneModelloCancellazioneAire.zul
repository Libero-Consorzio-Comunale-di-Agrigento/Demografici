<?xml version="1.0" encoding="UTF-8"?>
<?taglib uri="http://www.zkoss.org/dsp/web/core" prefix="c"?>

<zk xmlns="http://www.zkoss.org/2005/zul"
    xmlns:h="http://www.w3.org/1999/xhtml"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.zkoss.org/2005/zul http://www.zkoss.org/2005/zul/zul.xsd">

    <groupbox mold="3d" hflex="1" open="false" visible="@bind(vm.dichiarazione.codFamigliaProv ne null and vm.pratica.id ne null)">
        <caption sclass="mainCaption">
            <div>
                <updownbutton onClick="@command(self.openClose())" sclass="captionButton"/>
                <label value="@load(vm.etichette['Sezione_Modello_Aire_01_Cancellazione'])" sclass="captionLabel"/>
            </div>
        </caption>
        <grid sclass="form">
            <columns>
                <column width="150px"/>
                <column/>
                <column width="150px"/>
                <column/>
            </columns>
            <rows>
                <row>
                    <cell align="right">
                        <customLabel mandatory='true' value="@load(vm.etichette['Anno_Protocollo_Aire'])"/>
                    </cell>
                    <cell>
                        <hlayout valign="middle">
                            <intbox value="@bind(vm.pratica.dichiarazioneCancellazioneAir.modelloAireCancellazione.annoProtocolloAire)"
                                    width="150px" readonly="@load(vm.readOnly or vm.pratica.dichiarazioneCancellazioneAir.id ne null)"/>
                            <button image="/images/icon/action/16x16/cancel.png" disabled="@load(vm.readOnly)"
                                    tooltiptext="@load(vm.etichette['Cancella'])"
                                    onClick="@command('onCancellaCampoPratica', sezione='M')">
                                <custom-attributes proprieta="annoProtocolloAire"/>
                            </button>
                        </hlayout>
                    </cell>
                    <cell align="right">
                        <customLabel mandatory='true' value="@load(vm.etichette['Protocollo_Aire'])"/>
                    </cell>
                    <cell>
                        <hlayout valign="middle">
                            <intbox value="@bind(vm.pratica.dichiarazioneCancellazioneAir.modelloAireCancellazione.protocolloAire)"
                                    width="150px" readonly="@load(vm.readOnly or vm.pratica.dichiarazioneCancellazioneAir.id ne null)"/>
                            <button image="/images/icon/action/16x16/calculator.png"
                                    tooltiptext="@load(vm.etichette['Numera'])"
                                    disabled="@load(vm.readOnly or not empty vm.pratica.dichiarazioneCancellazioneAir.modelloAireCancellazione.protocolloAire or vm.pratica.dichiarazioneCancellazioneAir.id ne null)"
                                    onClick="@command('onNumeraProtocolloModelloAireCancellazione')" />
                            <button image="/images/icon/action/16x16/cancel.png"
                                    tooltiptext="@load(vm.etichette['Cancella'])"
                                    disabled="@load(vm.readOnly or vm.pratica.dichiarazioneCancellazioneAir.id ne null)"
                                    onClick="@command('onCancellaCampoPratica', sezione='M')">
                                <custom-attributes proprieta="protocolloAire"/>
                            </button>
                        </hlayout>
                    </cell>
                </row>
                <row>
                    <cell align="right">
                        <customLabel mandatory='true' value="@load(vm.etichette['Motivo_Cancellazione'])"/>
                    </cell>
                    <cell>
                        <hlayout valign="middle" hflex="1">
                            <combobox model="@load(vm.listaMotivoCancellazione)"
                                      readonly="true"
                                      hflex="1"
                                      disabled="@load(vm.readOnly)"
                                      selectedItem="@bind(vm.pratica.dichiarazioneCancellazioneAir.modelloAireCancellazione.motivoCancellazione) @converter('it.finmatica.zk.utils.PropertyConverter', property='id')">
                                <template name="model">
                                    <comboitem label="@load(empty each.codice ? each.descrizione : c:cat3(each.codice, ' - ', each.descrizione))"
                                               value="@load(each)"/>
                                </template>
                            </combobox>
                            <button image="/images/icon/action/16x16/cancel.png" disabled="@load(vm.readOnly)"
                                    tooltiptext="@load(vm.etichette['Cancella'])"
                                    onClick="@command('onCancellaCampoPratica', sezione='M')">
                                <custom-attributes proprieta="motivoCancellazione"/>
                            </button>
                        </hlayout>
                    </cell>
                    <cell align="right">
                        <customLabel value="@load(vm.etichette['Numero_Foglio'])"/>
                    </cell>
                    <cell>
                        <hlayout valign="middle">
                            <intbox value="@bind(vm.pratica.dichiarazioneCancellazioneAir.modelloAireCancellazione.numeroFoglio)"
                                    width="150px" readonly="true"/>
                        </hlayout>
                    </cell>
                </row>
            </rows>
        </grid>
    </groupbox>

</zk>