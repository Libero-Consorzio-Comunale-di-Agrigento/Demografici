<?taglib uri="http://www.zkoss.org/dsp/web/core" prefix="c"?>
<?component name="templateListaDocumenti" macroURI="/restrict/anagrafe/templateListaDocumenti.zul" inline="true"?>
<?component name="templateListaAllegati" macroURI="/restrict/templateListaAllegati.zul" inline="true"?>


<zk xmlns="http://www.zkoss.org/2005/zul"
    xmlns:h="http://www.w3.org/1999/xhtml"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.zkoss.org/2005/zul http://www.zkoss.org/2005/zul/zul.xsd">


    <groupbox mold="3d" hflex="1" open="false" visible="@load(vm.soggetto.matricola ne null)">
        <caption sclass="mainCaption">
            <div>
                <updownbutton onClick="@command(self.openClose())" sclass="captionButton"/>
                <label value="@load(vm.etichette['Sezione_Convivenza_Di_Fatto_Pratica'])" sclass="captionLabel"/>
            </div>
        </caption>

        <grid sclass="form">
            <columns>
                <column width="150px"/>
                <column/>
            </columns>
            <rows>
                <row>
                    <cell align="right" >
                        <label value="@load(vm.etichette['Convivenza_di_fatto'])"/>
                    </cell>
                    <cell>
                        <hlayout height="20px">
                            <radiogroup model="@load(vm.listaSiNo)" hflex="1" onCheck="@command('onSelectConvivenza')"
                                        selectedItem="@bind(vm.convivenzaDiFatto) @converter('it.finmatica.zk.utils.PropertyConverter', property='id')">
                                <template name="model">
                                    <radio label="@load(vm.etichette[each.name()])" value="@load(each)"
                                           disabled="@load(vm.readOnly)" style="padding-left:10px"/>
                                </template>
                            </radiogroup>
                        </hlayout>
                    </cell>
                </row>
                <row visible="@bind(vm.soggetto.matricola ne null and vm.convivenzaDiFatto eq 'SI')">
                    <cell colspan="2">
                        <groupbox closable="false">
                            <caption label="@load(vm.etichette['Convivenza_di_fatto'])"/>
                            <grid sclass="form">
                                <columns>
                                    <column width="135px"/>
                                    <column width="170px"/>
                                    <column/>
                                    <column width="100px"/>
                                    <column width="150px"/>
                                    <column width="90px"/>
                                </columns>
                                <rows>
                                    <row>
                                        <cell align="right">
                                            <customLabel mandatory="true" value="@load(vm.etichette['Stato'])"/>
                                        </cell>
                                        <cell colspan="2">
                                            <combobox model="@load(vm.statoConvivenzaList)" readonly="true"
                                                      hflex="1"
                                                      disabled="@load(vm.readOnly)"
                                                      selectedItem="@bind(vm.soggetto.convivenzaDiFatto.statoConvivenza) @converter('it.finmatica.zk.utils.PropertyConverter', property='id')">
                                                <template name="model">
                                                    <comboitem
                                                            label="@load(empty each? '--' : vm.getEtichettaEnum(each))"
                                                            value="@load(each)"/>
                                                </template>
                                            </combobox>
                                        </cell>
                                        <cell colspan="3"/>
                                    </row>
                                    <row>
                                        <cell align="right">
                                            <customLabel mandatory="true"
                                                         value="@load(c:cat3(vm.etichette['Cognome'], ' ',vm.etichette['Conv']))"/>
                                        </cell>
                                        <cell colspan="2">
                                            <hlayout valign="middle" hflex="1">
                                                <textbox value="@bind(vm.soggetto.convivenzaDiFatto.cognomeConvivente)"
                                                         hflex="1"
                                                         readonly="@load(vm.readOnly)"
                                                         onChanging="@command('svuotaMatricola', sezione='CONV')"
                                                         onChange="@command('onAggiornaCaseCustom', sezione='CONV')"
                                                         style="@load(vm.minuscole.cognomeConvivente?'text-transform:none':'text-transform:uppercase')">
                                                    <custom-attributes proprieta="cognomeConvivente"/>
                                                </textbox>
                                                <button image="/images/icon/action/16x16/cancel.png"
                                                        disabled="@load(vm.readOnly)"
                                                        tooltiptext="@load(vm.etichette['Cancella'])"
                                                        onClick="@command('onCancellaCampoCustom')">
                                                    <custom-attributes proprieta="cognomeConvivente"/>
                                                </button>
                                            </hlayout>
                                        </cell>
                                        <cell align="right" width="85px">
                                            <hlayout valign="middle">
                                                <label value="@load(vm.etichette['Minuscole'])"/>
                                                <checkbox checked="@bind(vm.minuscole.cognomeConvivente)"
                                                          disabled="@load(vm.readOnly)"
                                                          onCheck="@command('onAggiornaCaseCustom', sezione='CONV')">
                                                    <custom-attributes proprieta="cognomeConvivente"/>
                                                </checkbox>
                                            </hlayout>
                                        </cell>
                                        <cell align="right">
                                            <hlayout valign="middle">
                                                <label value="@bind(vm.etichette['Senza_Cognome'])"/>
                                                <checkbox
                                                        disabled="@load(vm.readOnly)"
                                                        checked="@bind(vm.soggetto.convivenzaDiFatto.senzaCognomeConvivente)"/>
                                            </hlayout>
                                        </cell>
                                        <cell>
                                            <textbox value="@bind(vm.soggetto.convivenzaDiFatto.convivente.matricola)"
                                                     readonly="true" hflex="1"/>
                                        </cell>
                                    </row>
                                    <row>
                                        <cell align="right">
                                            <customLabel mandatory="true"
                                                         value="@load(c:cat3(vm.etichette['Nome'], ' ',vm.etichette['Conv']))"/>
                                        </cell>
                                        <cell colspan="2">
                                            <hlayout valign="middle" hflex="1">
                                                <textbox value="@bind(vm.soggetto.convivenzaDiFatto.nomeConvivente)"
                                                         hflex="1"
                                                         readonly="@load(vm.readOnly)"
                                                         onChanging="@command('svuotaMatricola', sezione='CONV')"
                                                         onChange="@command('onAggiornaCaseCustom', sezione='CONV')"
                                                         style="@load(vm.minuscole.nomeConvivente?'text-transform:none':'text-transform:uppercase')">
                                                    <custom-attributes proprieta="nomeConvivente"/>
                                                </textbox>
                                                <button image="/images/icon/action/16x16/cancel.png"
                                                        disabled="@load(vm.readOnly)"
                                                        tooltiptext="@load(vm.etichette['Cancella'])"
                                                        onClick="@command('onCancellaCampoCustom')">
                                                    <custom-attributes proprieta="nomeConvivente"/>
                                                </button>
                                            </hlayout>
                                        </cell>
                                        <cell align="right" width="85px">
                                            <hlayout valign="middle">
                                                <label value="@load(vm.etichette['Minuscole'])"/>
                                                <checkbox checked="@bind(vm.minuscole.nomeConvivente)"
                                                          disabled="@load(vm.readOnly)"
                                                          onCheck="@command('onAggiornaCaseCustom', sezione='CONV')">
                                                    <custom-attributes proprieta="nomeConvivente"/>
                                                </checkbox>
                                            </hlayout>
                                        </cell>
                                        <cell align="right">
                                            <hlayout valign="middle">
                                                <label value="@bind(vm.etichette['Senza_Nome'])"/>
                                                <checkbox
                                                        disabled="@load(vm.readOnly)"
                                                        checked="@bind(vm.soggetto.convivenzaDiFatto.senzaNomeConvivente)"/>
                                            </hlayout>
                                        </cell>
                                        <cell>
                                            <button image="/images/icon/action/16x16/search.png"
                                                    disabled="@load(vm.readOnly)"
                                                    tooltiptext="@load(vm.etichette['Seleziona'])"
                                                    onClick="@command('onRicercaSoggetto', sezione='CONV')"/>
                                        </cell>
                                    </row>
                                    <row>
                                        <cell align="right">
                                            <label value="@load(vm.etichette['Note'])"/>
                                        </cell>
                                        <cell colspan="5">
                                            <textbox value="@load(vm.soggetto.convivenzaDiFatto.note)" hflex="1" readonly="@load(vm.readOnly)"/>
                                        </cell>
                                    </row>
                                </rows>
                            </grid>
                        </groupbox>
                    </cell>
                </row>

                <row visible="@bind(vm.soggetto.matricola ne null and vm.convivenzaDiFatto eq 'SI')">
                    <cell colspan="2">
                        <groupbox closable="false">
                            <caption label="@load(vm.etichette['Inizio'])"/>
                            <grid sclass="form">
                                <columns>
                                    <column width="135px"/>
                                    <column/>
                                    <column width="135px"/>
                                    <column/>
                                    <column width="135px"/>
                                    <column/>
                                </columns>
                                <rows>
                                    <row>
                                        <cell align="right">
                                            <customLabel mandatory="true" value="@load(vm.etichette['Data'])"/>
                                        </cell>
                                        <cell>
                                            <datebox format="dd/MM/yyyy"
                                                     readonly="@load(vm.readOnly)"
                                                     value="@bind(vm.soggetto.convivenzaDiFatto.dataInizio)"
                                                     onChange="@command('onAggiornaDataRiferimento', campoRiferimento='SOGG_ATTO_CONV_I')"
                                                     width="95px"/>
                                            <button image="/images/icon/action/16x16/cancel.png"
                                                    disabled="@load(vm.readOnly)"
                                                    tooltiptext="@load(vm.etichette['Cancella'])"
                                                    onClick="@command('onCancellaCampo')">
                                                <custom-attributes proprieta="convivenzaDiFatto.dataInizio"/>
                                            </button>
                                        </cell>
                                        <cell align="right">
                                            <label value="@load(vm.etichette['Anno'])"/>
                                        </cell>
                                        <cell>
                                            <intbox value="@bind(vm.soggetto.convivenzaDiFatto.annoPraticaInizio)"
                                            readonly="@load(vm.readOnly)"
                                            onChange="@command('onAggiornaDataRiferimento', campoRiferimento='SOGG_ATTO_CONV_I')"/>
                                            <button image="/images/icon/action/16x16/cancel.png"
                                            disabled="@load(vm.readOnly)"
                                            tooltiptext="@load(vm.etichette['Cancella'])"
                                            onClick="@command('onCancellaCampo')">
                                                <custom-attributes proprieta="convivenzaDiFatto.annoPraticaInizio"/>
                                            </button>
                                        </cell>
                                        <cell align="right">
                                            <label value="@load(vm.etichette['Pratica'])"/>
                                        </cell>
                                        <cell>
                                            <intbox value="@bind(vm.soggetto.convivenzaDiFatto.praticaInizio)" readonly="@load(vm.readOnly)"/>
                                            <button image="/images/icon/action/16x16/calculator.png"
                                                    tooltiptext="@load(vm.etichette['Calcola_Numero_Pratica'])" disabled="@load(vm.readOnly)"
                                                    onClick="@command('onCalcolaNumeroPraticaCdF', tipoPratica='I')" />
                                            <button image="/images/icon/action/16x16/cancel.png"
                                                    disabled="@load(vm.readOnly)"
                                                    tooltiptext="@load(vm.etichette['Cancella'])"
                                                    onClick="@command('onCancellaCampo')">
                                                <custom-attributes proprieta="convivenzaDiFatto.praticaInizio"/>
                                            </button>
                                        </cell>
                                    </row>
                                    <row>
                                        <cell align="right">
                                            <customLabel mandatory="true" value="@load(vm.etichette['Comune'])"/>
                                        </cell>
                                        <cell colspan="2">
                                            <hlayout valign="middle" hflex="1">
                                                <bandboxComuni hflex="1"
                                                               disabled="@load(vm.readOnly)"
                                                               value="@load(vm.soggetto.convivenzaDiFatto.comuneInizio.descrizione)"
                                                               dataRiferimento="@load(vm.dataRiferimentoComuneAttoInizioConvivenza)"
                                                               onSelect="@command('onSelectComune', campoRiferimento='CONV_I')"/>
                                                <button image="/images/icon/action/16x16/cancel.png"
                                                        disabled="@load(vm.readOnly)"
                                                        tooltiptext="@load(vm.etichette['Cancella'])"
                                                        onClick="@command('onCancellaComune', campoRiferimento='CONV_I')"
                                                />
                                            </hlayout>
                                        </cell>
                                        <cell>
                                            <textbox
                                                    value="@load(vm.soggetto.convivenzaDiFatto.comuneInizio.siglaProvincia)"
                                                    hflex="1" readonly="true"/>
                                        </cell>
                                        <cell colspan="2"/>
                                    </row>
                                </rows>
                            </grid>
                        </groupbox>
                    </cell>
                </row>

                <row visible="@bind(vm.soggetto.matricola ne null and vm.convivenzaDiFatto eq 'SI')">
                    <cell colspan="2">
                        <groupbox closable="false">
                            <caption label="@load(vm.etichette['Fine'])"/>
                            <grid sclass="form">
                                <columns>
                                    <column width="135px"/>
                                    <column/>
                                    <column width="135px"/>
                                    <column/>
                                    <column width="135px"/>
                                    <column/>
                                </columns>
                                <rows>
                                    <row>
                                        <cell align="right">
                                            <label value="@load(vm.etichette['Data'])"/>
                                        </cell>
                                        <cell>
                                            <datebox format="dd/MM/yyyy"
                                                     readonly="@load(vm.readOnly)"
                                                     value="@bind(vm.soggetto.convivenzaDiFatto.dataFine)"
                                                     onChange="@command('onAggiornaDataRiferimento', campoRiferimento='SOGG_ATTO_CONV_F')"
                                                     width="95px"/>
                                            <button image="/images/icon/action/16x16/cancel.png"
                                                    disabled="@load(vm.readOnly)"
                                                    tooltiptext="@load(vm.etichette['Cancella'])"
                                                    onClick="@command('onCancellaCampo')">
                                                <custom-attributes proprieta="convivenzaDiFatto.dataFine"/>
                                            </button>
                                        </cell>
                                        <cell align="right">
                                            <label value="@load(vm.etichette['Anno'])"/>
                                        </cell>
                                        <cell>
                                            <intbox value="@load(vm.soggetto.convivenzaDiFatto.annoPraticaFine)"
                                            readonly="@load(vm.readOnly)"
                                            onChange="@command('onAggiornaDataRiferimento', campoRiferimento='SOGG_ATTO_CONV_F')"/>
                                            <button image="/images/icon/action/16x16/cancel.png"
                                            disabled="@load(vm.readOnly)"
                                            tooltiptext="@load(vm.etichette['Cancella'])"
                                            onClick="@command('onCancellaCampo')">
                                                <custom-attributes proprieta="convivenzaDiFatto.annoPraticaFine"/>
                                            </button>
                                        </cell>
                                        <cell align="right">
                                            <label value="@load(vm.etichette['Pratica'])"/>
                                        </cell>
                                        <cell>
                                            <intbox value="@load(vm.soggetto.convivenzaDiFatto.praticaFine)" readonly="@load(vm.readOnly)"/>
                                            <button image="/images/icon/action/16x16/calculator.png"
                                                    tooltiptext="@load(vm.etichette['Calcola_Numero_Pratica'])" disabled="@load(vm.readOnly)"
                                                    onClick="@command('onCalcolaNumeroPraticaCdF', tipoPratica='F')" />
                                            <button image="/images/icon/action/16x16/cancel.png"
                                                    disabled="@load(vm.readOnly)"
                                                    tooltiptext="@load(vm.etichette['Cancella'])"
                                                    onClick="@command('onCancellaCampo')">
                                                <custom-attributes proprieta="convivenzaDiFatto.praticaFine"/>
                                            </button>
                                        </cell>
                                    </row>
                                    <row>
                                        <cell align="right">
                                            <label value="@load(vm.etichette['Comune'])"/>
                                        </cell>
                                        <cell colspan="2">
                                            <hlayout valign="middle" hflex="1">
                                                <bandboxComuni hflex="1"
                                                               disabled="@load(vm.readOnly)"
                                                               value="@load(vm.soggetto.convivenzaDiFatto.comuneFine.descrizione)"
                                                               dataRiferimento="@load(vm.dataRiferimentoComuneAttoFineConvivenza)"
                                                               onSelect="@command('onSelectComune', campoRiferimento='CONV_F')"/>
                                                <button image="/images/icon/action/16x16/cancel.png"
                                                        disabled="@load(vm.readOnly)"
                                                        tooltiptext="@load(vm.etichette['Cancella'])"
                                                        onClick="@command('onCancellaComune', campoRiferimento='CONV_F')"
                                                />
                                            </hlayout>
                                        </cell>
                                        <cell>
                                            <textbox
                                                    value="@load(vm.soggetto.convivenzaDiFatto.comuneFine.siglaProvincia)"
                                                    hflex="1" readonly="true"/>
                                        </cell>
                                        <cell colspan="2"/>
                                    </row>
                                </rows>
                            </grid>
                        </groupbox>
                    </cell>
                </row>

                <row height="300px" visible="@bind(vm.soggetto.matricola ne null and vm.convivenzaDiFatto eq 'SI')">
                    <cell colspan="2">
                        <groupbox closable="false" vflex="1">
                            <caption label="@load(vm.etichette['Documenti'])"/>

                            <borderlayout>
                                <north vflex="min">
                                    <hlayout valign="middle" sclass="navigazione" height="40px">
                                        <hlayout sclass="afc-control-bar" valign="middle">
                                            <toolbarbutton image="/images/icon/action/22x22/add.png"
                                                           disabled="@load(vm.readOnly)"
                                                           tooltiptext="@load(vm.etichette['inserisci_documento_tooltip'])"
                                                           onClick="@command('onInserisciDocumento', tipologia='CDF')"/>

                                        </hlayout>
                                    </hlayout>

                                </north>
                                <center vflex="1">
                                    <listbox model="@load(vm.documentiCDF)" vflex="1"
                                             selectedItem="@bind(vm.selectedDocumentoCDF)"
                                             emptyMessage="@load(vm.etichette['Nessun_Documento_Presente'])">
                                        <templateListaDocumenti/>
                                    </listbox>
                                </center>
                                <east vflex="1" size="40%" collapsible="true" splittable="true"
                                      open="@load(not empty vm.selectedDocumentoCDF)">
                                    <vlayout sclass="scroll" vflex="1">
                                        <groupbox mold="3d" closable="false" style="background: #EDEFF5" vflex="1">
                                            <caption label="@load(vm.etichette['Allegati'])" height="27px">
                                                <hlayout sclass="testo-a-dx">

                                                    <toolbarbutton image="/images/icon/action/22x22/export.png"
                                                                   upload="true"
                                                                   disabled="@load(vm.readOnly)"
                                                                   tooltiptext="@load(vm.etichette['carica_documento_tooltip'])"
                                                                   onUpload="@command('onUploadAllegato', tipologia='CDF')"/>

                                                    <ScanToolbarbutton
                                                            disabled="@load(vm.readOnly)"
                                                            onScanCompleted="@command('onScanAllegato', tipologia='CDF')"/>

                                                    <toolbarbutton image="/images/icon/action/22x22/import.png"
                                                                   tooltiptext="@load(vm.etichette['scarica_allegati_tooltip'])"
                                                                   onClick="@command('onDownloadAllegati', tipologia='CDF')"/>
                                                </hlayout>
                                            </caption>
                                            <listbox model="@load(vm.selectedDocumentoCDF.allegati)"
                                                     nonselectableTags="" vflex="1"
                                                     emptyMessage="@load(vm.etichette['Nessun_dato_disponibile'])">
                                                <templateListaAllegati/>
                                            </listbox>
                                        </groupbox>
                                    </vlayout>
                                </east>
                            </borderlayout>

                        </groupbox>
                    </cell>
                </row>

            </rows>
        </grid>
    </groupbox>
</zk>