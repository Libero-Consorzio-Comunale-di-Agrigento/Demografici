<?xml version="1.0" encoding="UTF-8"?>
<?taglib uri="http://www.zkoss.org/dsp/web/core" prefix="c"?>

<zk xmlns="http://www.zkoss.org/2005/zul"
    xmlns:h="http://www.w3.org/1999/xhtml"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:w="http://www.zkoss.org/2005/zk/client"
    xsi:schemaLocation="http://www.zkoss.org/2005/zul http://www.zkoss.org/2005/zul/zul.xsd">

    <window viewModel="@id('vm') @init('restrict.anagrafe.dizionari.comunicazioni.ComunicazioneDettaglioViewModel')"
            apply="org.zkoss.bind.BindComposer"
            border="none"
            width="100%" height="100%"
            sizable="false" closable="false">

        <hlayout valign="middle">
            <controlBarDettaglio/>

            <label value="@load(vm.formLabel)" sclass="formTitle"/>
        </hlayout>

        <vlayout width="100%" vflex="1" style="overflow: auto">
            <grid sclass="form">
                <rows>
                    <row>
                        <cell width="150px" align="right">
                            <h:span class="mandatoryLabel">*</h:span>
                            <label value="@load(vm.etichette['Codice'])"/>
                        </cell>
                        <cell>
                            <textbox value="@bind(vm.dettaglio.id)" hflex="1" maxlength="5"
                                     disabled="@load(vm.tipoOperazione.isUpdate())"/>
                        </cell>
                    </row>
                    <row>
                        <cell align="right">
                            <h:span class="mandatoryLabel">*</h:span>
                            <label value="@load(vm.etichette['Tipo_Comunicazione'])"/>
                        </cell>
                        <cell>
                            <combobox model="@load(vm.listaTipiComunicazione)"
                                      disabled="@load(vm.tipoOperazione.isUpdate())" onSelect="@command('onSelectTipoComunicazione')"
                                      selectedItem="@bind(vm.dettaglio.tipoComunicazione)" readonly="true"
                                      width="400px">
                                <template name="model">
                                    <comboitem label="@load(vm.getEtichettaEnum(each))" value="@load(each)"/>
                                </template>
                            </combobox>
                        </cell>
                    </row>
                    <row>
                        <cell width="150px" align="right">
                            <h:span class="mandatoryLabel">*</h:span>
                            <label value="@load(vm.etichette['Modello'])"/>
                        </cell>
                        <cell>
                            <combobox model="@load(vm.listaModelli)"
                                      selectedItem="@bind(vm.dettaglio.modello)" readonly="true"
                                      width="400px">
                                <template name="model">
                                    <comboitem label="@load(each.descrizione)" value="@load(each)"/>
                                </template>
                            </combobox>
                        </cell>
                    </row>
                    <row>
                        <cell align="right">
                            <h:span class="mandatoryLabel">*</h:span>
                            <label value="@load(vm.etichette['Descrizione'])"/>
                        </cell>
                        <cell>
                            <textbox value="@bind(vm.dettaglio.descrizione)" hflex="1" maxlength="60"/>
                        </cell>
                    </row>
                    <row visible="@bind(vm.dettaglio.tipoComunicazione.id eq 'C')">
                        <cell align="right">
                            <label value="@load(vm.etichette['Ente_Destinatario'])"/>
                        </cell>
                        <cell>
                            <combobox model="@load(vm.listaEnti)"
                                      selectedItem="@bind(vm.dettaglio.enteDestinatario)" readonly="true"
                                      width="400px">
                                <template name="model">
                                    <comboitem label="@load(each.descrizione)" value="@load(each)"/>
                                </template>
                            </combobox>
                        </cell>
                    </row>
                    <row visible="@bind(vm.dettaglio.tipoComunicazione.id eq 'C')">
                        <cell align="right">
                            <label value="@load(vm.etichette['Tipo_Documento'])"/>
                        </cell>
                        <cell>
                            <combobox model="@load(vm.listaTipiDocumento)"
                                      selectedItem="@bind(vm.dettaglio.tipoDocumento)" readonly="true"
                                      width="400px">
                                <template name="model">
                                    <comboitem label="@load(each.descrizione)" value="@load(each)"/>
                                </template>
                            </combobox>
                        </cell>
                    </row>
                </rows>
            </grid>

            <!-- Groupbox Tipi di Pratica -->
            <groupbox  width="100%" open="true" closable="false" visible="@load(vm.tipoOperazione.isUpdate())">
                <caption label="@load(vm.etichette['Tipi_Pratica'])"/>
                <include comunicazione="@bind(vm.dettaglio)" opener="@load(vm.self)"
                         src="@load(vm.getUriPraticaLista())"/>
            </groupbox>

            <!-- Groupbox Condizioni -->
            <groupbox width="100%" open="true" closable="false" visible="@load(vm.tipoOperazione.isUpdate())">
                <caption label="@load(vm.etichette['Condizioni'])"/>
                <include comunicazione="@bind(vm.dettaglio)" opener="@load(vm.self)"
                         src="@load(vm.getUriCondizioneLista())"/>
            </groupbox>

        </vlayout>

    </window>

</zk>