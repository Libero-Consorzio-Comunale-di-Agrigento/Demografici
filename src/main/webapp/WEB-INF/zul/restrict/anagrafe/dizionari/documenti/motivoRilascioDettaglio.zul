<?xml version="1.0" encoding="UTF-8"?>
<?taglib uri="http://www.zkoss.org/dsp/web/core" prefix="c"?>

<zk xmlns="http://www.zkoss.org/2005/zul"
	xmlns:h="http://www.w3.org/1999/xhtml"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul http://www.zkoss.org/2005/zul/zul.xsd">

	<window viewModel="@id('vm') @init('restrict.anagrafe.dizionari.documenti.MotivoRilascioDettaglioViewModel')"
			apply="org.zkoss.bind.BindComposer"
			border="none"
			width="100%" height="100%"
			sizable="false" closable="false">

		<vlayout vflex="1">

			<hlayout valign="middle">
				<controlBarDettaglio/>

				<label value="@load(vm.formLabel)" sclass="formTitle"/>
			</hlayout>

			<grid sclass="form">
				<columns>
					<column width="150px"/>
					<column/>
				</columns>
				<rows>
					<row>
						<cell align="right">
							<h:span class="mandatoryLabel">*</h:span><label value="@load(vm.etichette['Codice'])"/>
						</cell>
						<cell>
							<intbox value="@bind(vm.dettaglio.codice)" mold="rounded" cols="4" maxlength="2" disabled="@load(vm.tipoOperazione.isUpdate())"/>
						</cell>
					</row>
					<row>
						<cell align="right">
                            <h:span class="mandatoryLabel">*</h:span><label value="@load(vm.etichette['Descrizione'])"/>
						</cell>
						<cell>
							<hlayout valign="middle" hflex="1">
								<textbox value="@bind(vm.dettaglio.descrizione)" hflex="1" maxlength="30"/>
								<button image="/images/icon/action/16x16/cancel.png"
										tooltiptext="@load(vm.etichette['Cancella'])"
										onClick="@command('onCancellaCampoDizionario')">
									<custom-attributes proprieta="descrizione"/>
								</button>
							</hlayout>
						</cell>
					</row>
				</rows>
			</grid>

		</vlayout>

	</window>

</zk>
