<?xml version="1.0" encoding="UTF-8"?>
<?taglib uri="http://www.zkoss.org/dsp/web/core" prefix="c"?>

<zk xmlns="http://www.zkoss.org/2005/zul"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.zkoss.org/2005/zul http://www.zkoss.org/2005/zul/zul.xsd">

    <window viewModel="@id('vm') @init('restrict.anagrafe.dizionari.documenti.DocumentiViewModel')"
            apply="org.zkoss.bind.BindComposer"
            border="none"
            width="100%" height="@load(vm.wCenterHeight)"
            sizable="false" closable="false">

        <tabbox hflex="1" vflex="1">
            <tabs>
                <tab label="@load(vm.etichette['Tipi_Documento'])" tooltiptext="@load(vm.etichette['Tipi_Documento'])"/>
                <tab label="@load(vm.etichette['Enti_Emissione'])" tooltiptext="@load(vm.etichette['Enti_Emissione'])"/>
                <tab label="@load(vm.etichette['Categorie'])" tooltiptext="@load(vm.etichette['Categorie'])"/>
                <tab label="@load(vm.etichette['Motivi_Rilascio'])" tooltiptext="@load(vm.etichette['Motivi_Rilascio'])"/>
            </tabs>
            <tabpanels>
                <tabpanel>
                    <include hflex="1" vflex="1" src="/restrict/anagrafe/dizionari/documenti/tipoDocumentoLista.zul"/>
                </tabpanel>
                <tabpanel>
                    <include hflex="1" vflex="1" src="/restrict/anagrafe/dizionari/enteLista.zul" comunicazioni="false"/>
                </tabpanel>
                <tabpanel>
                    <include hflex="1" vflex="1" src="/restrict/anagrafe/dizionari/documenti/categoriaLista.zul"/>
                </tabpanel>
                <tabpanel>
                    <include hflex="1" vflex="1" src="/restrict/anagrafe/dizionari/documenti/motivoRilascioLista.zul"/>
                </tabpanel>
            </tabpanels>
        </tabbox>

    </window>

</zk>