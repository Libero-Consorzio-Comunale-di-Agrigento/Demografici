<?xml version="1.0" encoding="UTF-8"?>
<?taglib uri="http://www.zkoss.org/dsp/web/core" prefix="c"?>

<zk xmlns="http://www.zkoss.org/2005/zul"
    xmlns:h="http://www.w3.org/1999/xhtml"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.zkoss.org/2005/zul http://www.zkoss.org/2005/zul/zul.xsd">

    <window viewModel="@id('vm') @init('restrict.anagrafe.dizionari.comunicazioni.ComunicazionePraticaListaViewModel')"
            apply="org.zkoss.bind.BindComposer"
            border="none"
            width="100%" height="100%"
            sizable="false" closable="false">

        <vlayout vflex="1">
            <controlBarLista/>
            <totalSizeBlock/>
            <!-- Lista pratiche -->
            <listbox model="@load(vm.lista)" selectedItem="@bind(vm.dettaglio)"
                     nonselectableTags="" rows="4"
                     emptyMessage="@load(vm.etichette['Nessun_dato_disponibile'])"
                     vflex="1">
                <listhead>
                    <listheader label="@load(vm.etichette['Archivio_Anagrafe'])"/>
                    <listheader label="@load(vm.etichette['Tipo_Pratica'])"/>
                    <listheader label="@load(vm.etichette['Numero_copie'])"/>
                    <listheader label="@load(vm.etichette['Evento_Pratica_Automatico'])"/>
                </listhead>
                <template name="model" var="item">
                    <listitem onDoubleClick="@command('onModifica')">
                        <listcell label="@load(vm.getEtichettaEnum(item.archivioAnagrafe))"/>
                        <listcell label="@load(vm.getEtichettaEnum(item.tipoPratica))"/>
                        <listcell label="@load(item.numeroCopie)"/>
                        <listcell>
                            <checkbox checked="@load(item.eventoPratica ne null)" disabled="true"/>
                        </listcell>
                    </listitem>
                </template>
            </listbox>
        </vlayout>

    </window>
</zk>