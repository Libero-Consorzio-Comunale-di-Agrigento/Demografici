<?xml version="1.0" encoding="UTF-8"?>
<?taglib uri="http://www.zkoss.org/dsp/web/core" prefix="c"?>

<zk xmlns="http://www.zkoss.org/2005/zul"
	xmlns:h="http://www.w3.org/1999/xhtml"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul http://www.zkoss.org/2005/zul/zul.xsd">

	<window viewModel="@id('vm') @init('restrict.anagrafe.dizionari.documenti.TipoDocumentoDettaglioViewModel')"
			apply="org.zkoss.bind.BindComposer"
			border="none"
			width="100%" height="100%"
			sizable="false" closable="false">

		<vlayout vflex="1">

			<hlayout valign="middle">
				<controlBarDettaglio/>

				<label value="@load(vm.formLabel)" sclass="formTitle"/>
			</hlayout>

			<grid sclass="form">
				<rows>
					<row>
						<cell align="right" width="200px">
							<h:span class="mandatoryLabel">*</h:span><label value="@load(vm.etichette['Codice'])"/>
						</cell>
						<cell colspan="2">
							<textbox value="@bind(vm.dettaglio.id)" mold="rounded" cols="8" maxlength="2" disabled="@load(vm.tipoOperazione.isUpdate())"/>
						</cell>
					</row>
					<row>
						<cell align="right">
                            <h:span class="mandatoryLabel">*</h:span><label value="@load(vm.etichette['Descrizione'])"/>
						</cell>
						<cell colspan="2">
							<hlayout valign="middle">
								<textbox value="@bind(vm.dettaglio.descrizione)" hflex="1" maxlength="30"/>
								<button image="/images/icon/action/16x16/cancel.png"
										tooltiptext="@load(vm.etichette['Cancella'])"
										onClick="@command('onCancellaCampoDizionario')">
									<custom-attributes proprieta="descrizione"/>
								</button>
							</hlayout>
						</cell>
					</row>
					<row>
						<cell align="right">
							<label value="@load(vm.etichette['Doc_Soggiorno'])"/>
						</cell>
						<cell colspan="2">
							<checkbox checked="@bind(vm.dettaglio.flagStranieri)"
									  tooltiptext="@load(vm.etichette['Doc_Soggiorno_tooltip'])"/>
						</cell>
					</row>
					<row>
						<cell align="right">
							<label value="@load(vm.etichette['Doc_Identita'])"/>
						</cell>
						<cell colspan="2">
							<checkbox checked="@bind(vm.dettaglio.flagIdentita)"
									  tooltiptext="@load(vm.etichette['Doc_Identita_tooltip'])"/>
						</cell>
					</row>
					<row>
						<cell align="right">
							<label value="@load(vm.etichette['Doc_Riconoscimento'])"/>
						</cell>
						<cell colspan="2">
							<checkbox checked="@bind(vm.dettaglio.flagRiconoscimento)"
									  tooltiptext="@load(vm.etichette['Doc_Riconoscimento_tooltip'])"/>
						</cell>
					</row>
					<row>
						<cell align="right">
							<label value="@load(vm.etichette['AODI'])"/>
						</cell>
						<cell colspan="2">
							<checkbox checked="@bind(vm.dettaglio.flagArchiviazione)"
									  onChange="@command('onToggleFlagArchiviazione')"/>
						</cell>
					</row>
					<row>
						<cell align="right">
							<label value="@load(vm.etichette['Tipo_Acquisizione'])"/>
						</cell>
						<cell colspan="2">
							<combobox model="@load(vm.listaTipoAcquisizione)" readonly="true" width="300px"
									  selectedItem="@bind(vm.dettaglio.tipoAcquisizione) @converter('it.finmatica.zk.utils.PropertyConverter', property='id')"
									  disabled="@load(not vm.dettaglio.flagArchiviazione)">
								<template name="model">
									<comboitem label="@load(empty each? '- -' : vm.getEtichettaEnum(each))"
											   value="@load(each)"/>
								</template>
							</combobox>
						</cell>
					</row>
					<row>
						<cell align="right">
							<label value="@load(vm.etichette['CdF'])"/>
						</cell>
						<cell colspan="2">
							<combobox model="@load(vm.listaFlagCdf)" readonly="true" width="300px"
									  selectedItem="@bind(vm.dettaglio.flagConvivenzaDiFatto) @converter('it.finmatica.zk.utils.PropertyConverter', property='id')">
								<template name="model">
									<comboitem label="@load(empty each? '- -' : vm.getEtichettaEnum(each))"
											   value="@load(each)"/>
								</template>
							</combobox>
						</cell>
					</row>
					<row visible="@bind(vm.dettaglio.flagStranieri)">
						<cell align="right">
							<label value="@load(vm.etichette['Codice_ANPR'])"/>
						</cell>
						<cell colspan="2">
							<combobox model="@load(vm.listaAnpCodici)" readonly="true" width="500px"
									  selectedItem="@bind(vm.dettaglio.codiceAnpr) @converter('it.finmatica.zk.utils.PropertyConverter', property='codice')">
								<template name="model">
									<comboitem label="@load(empty each? '- -' : c:cat3(each.codice, ' - ', each.descrizione))"
											   value="@load(each)"/>
								</template>
							</combobox>
						</cell>
					</row>
				</rows>
			</grid>

		</vlayout>

	</window>

</zk>