<?xml version="1.0" encoding="UTF-8"?>
<?taglib uri="http://www.zkoss.org/dsp/web/core" prefix="c"?>

<zk xmlns="http://www.zkoss.org/2005/zul"
    xmlns:h="http://www.w3.org/1999/xhtml"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.zkoss.org/2005/zul http://www.zkoss.org/2005/zul/zul.xsd">

    <window viewModel="@id('vm') @init('restrict.anagrafe.dizionari.comunicazioni.ComunicazioneCondizioneListaViewModel')"
            apply="org.zkoss.bind.BindComposer"
            border="none"
            width="100%" height="100%"
            sizable="false" closable="false">

        <vlayout vflex="1">
            <controlBarLista/>

            <totalSizeBlock/>

            <vlayout vflex="1">
                <!-- Lista condizioni -->
                <listbox model="@load(vm.lista)" selectedItem="@bind(vm.dettaglio)"
                         nonselectableTags="" rows="4"
                         emptyMessage="@load(vm.etichette['Nessun_dato_disponibile'])"
                         vflex="1">
                    <listhead sizable="true">
                        <listheader label="@load(vm.etichette['Codice'])" width="70px"/>
                        <listheader label="@load(vm.etichette['Descrizione'])" hflex="1"/>
                        <listheader label="@load(vm.etichette['Condizione'])" hflex="2"/>
                    </listhead>
                    <template name="model" var="item">
                        <listitem>
                            <listcell label="@load(item.condizioneSql.id)"/>
                            <listcell label="@load(item.descrizioneCondizione)"/>
                            <listcell label="@load(item.condizioneSql.condizione)"/>
                        </listitem>
                    </template>
                </listbox>
            </vlayout>

        </vlayout>
    </window>
</zk>
