<?xml version="1.0" encoding="UTF-8"?>
<?taglib uri="http://www.zkoss.org/dsp/web/core" prefix="c"?>

<zk xmlns="http://www.zkoss.org/2005/zul"
    xmlns:h="http://www.w3.org/1999/xhtml"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.zkoss.org/2005/zul http://www.zkoss.org/2005/zul/zul.xsd">

    <window viewModel="@id('vm') @init('restrict.anagrafe.dizionari.anpr.AnpUtenteDettaglioViewModel')"
            apply="org.zkoss.bind.BindComposer"
            border="none"
            width="100%" height="100%"
            sizable="false" closable="false">

        <hlayout valign="middle">
            <controlBarDettaglio/>

            <label value="@load(vm.formLabel)" sclass="formTitle"/>
        </hlayout>

        <vlayout vflex="1" width="100%" sclass="scroll">

            <grid sclass="form">
                <rows>
                    <!-- Codice Utente (ID) - Obbligatorio, disabilitato in update -->
                    <row>
                        <cell align="right" width="150px">
                            <customLabel mandatory="true" value="@load(vm.etichette['Codice_Utente'])"/>
                        </cell>
                        <cell>
                            <combobox model="@load(vm.utenti)" readonly="true" disabled="@load(vm.tipoOperazione.isUpdate())"
                                      selectedItem="@bind(vm.utenteSelected)" onSelect="@command('selezionaUtente')">
                                <template name="model">
                                    <comboitem label="@load(each.utente)" value="@load(each)"/>
                                </template>
                            </combobox>
                        </cell>
                    </row>

                    <!-- Cognome - Obbligatorio, con pulsante cancella -->
                    <row>
                        <cell align="right">
                            <customLabel mandatory="true" value="@load(vm.etichette['Cognome'])"/>
                        </cell>
                        <cell>
                            <hlayout valign="middle">
                                <textbox value="@bind(vm.dettaglio.cognome)" hflex="1"/>
                                <button image="/images/icon/action/16x16/cancel.png"
                                        tooltiptext="@load(vm.etichette['Cancella'])"
                                        onClick="@command('onCancellaCampoDizionario')">
                                    <custom-attributes proprieta="cognome"/>
                                </button>
                            </hlayout>
                        </cell>
                    </row>

                    <!-- Nome - Obbligatorio, con pulsante cancella -->
                    <row>
                        <cell align="right">
                            <customLabel mandatory="true" value="@load(vm.etichette['Nome'])"/>
                        </cell>
                        <cell>
                            <hlayout valign="middle">
                                <textbox value="@bind(vm.dettaglio.nome)" hflex="1"/>
                                <button image="/images/icon/action/16x16/cancel.png"
                                        tooltiptext="@load(vm.etichette['Cancella'])"
                                        onClick="@command('onCancellaCampoDizionario')">
                                    <custom-attributes proprieta="nome"/>
                                </button>
                            </hlayout>
                        </cell>
                    </row>

                    <!-- Codice Fiscale - Obbligatorio, con pulsante cancella -->
                    <row>
                        <cell align="right">
                            <customLabel mandatory="true" value="@load(vm.etichette['Codice_Fiscale'])"/>
                        </cell>
                        <cell>
                            <hlayout valign="middle">
                                <textbox value="@bind(vm.dettaglio.codiceFiscale)"
                                         hflex="1"
                                         maxlength="16"/>
                                <button image="/images/icon/action/16x16/cancel.png"
                                        tooltiptext="@load(vm.etichette['Cancella'])"
                                        onClick="@command('onCancellaCampoDizionario')">
                                    <custom-attributes proprieta="codiceFiscale"/>
                                </button>
                            </hlayout>
                        </cell>
                    </row>

                    <!-- Flag Default - Checkbox -->
                    <row>
                        <cell align="right">
                            <label value="@load(vm.etichette['Default'])"/>
                        </cell>
                        <cell>
                            <checkbox checked="@bind(vm.dettaglio.flagDefault)"/>
                        </cell>
                    </row>

                    <!-- Flag Notifiche - Checkbox -->
                    <row>
                        <cell align="right">
                            <label value="@load(vm.etichette['Notifiche'])"/>
                        </cell>
                        <cell>
                            <checkbox checked="@bind(vm.dettaglio.flagNotifiche)"/>
                        </cell>
                    </row>

                    <!-- Flag Notifiche Elettorali - Checkbox -->
                    <row>
                        <cell align="right">
                            <label value="@load(vm.etichette['Notifiche_Elettorali'])"/>
                        </cell>
                        <cell>
                            <checkbox checked="@bind(vm.dettaglio.flagNotificheEle)"/>
                        </cell>
                    </row>

                    <!-- Flag Notifiche Stato Civile - Checkbox -->
                    <row>
                        <cell align="right">
                            <label value="@load(vm.etichette['Notifiche_Stato_Civile'])"/>
                        </cell>
                        <cell>
                            <checkbox checked="@bind(vm.dettaglio.flagNotificheCiv)"/>
                        </cell>
                    </row>

                </rows>
            </grid>

            <templateIdDomain/>

        </vlayout>

    </window>

</zk>