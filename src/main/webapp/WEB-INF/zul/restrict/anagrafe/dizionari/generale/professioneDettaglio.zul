<?xml version="1.0" encoding="UTF-8"?>
<?taglib uri="http://www.zkoss.org/dsp/web/core" prefix="c"?>

<zk xmlns="http://www.zkoss.org/2005/zul"
	xmlns:h="http://www.w3.org/1999/xhtml"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul http://www.zkoss.org/2005/zul/zul.xsd">

	<window viewModel="@id('vm') @init('restrict.anagrafe.dizionari.generale.ProfessioneDettaglioViewModel')"
			apply="org.zkoss.bind.BindComposer"
			border="none"
			width="100%" height="100%"
			sizable="false" closable="false">

		<vlayout vflex="1">

			<hlayout valign="middle">
				<controlBarDettaglio/>

				<label value="@load(vm.formLabel)" sclass="formTitle"/>
			</hlayout>

			<grid sclass="form">
				<rows>
					<row>
						<cell align="right" width="150px">
							<h:span class="mandatoryLabel">*</h:span><label value="@load(vm.etichette['Codice'])"/>
						</cell>
						<cell colspan="2">
							<intbox value="@bind(vm.dettaglio.codice)" mold="rounded" cols="10" disabled="@load(vm.tipoOperazione.isUpdate())"/>
						</cell>
					</row>
					<row>
						<cell align="right">
							<h:span class="mandatoryLabel">*</h:span><label value="@load(vm.etichette['Sesso'])"/>
						</cell>
						<cell colspan="2">
							<combobox model="@load(vm.listaSesso)" readonly="true" width="300px"
									  selectedItem="@bind(vm.dettaglio.sesso) @converter('it.finmatica.zk.utils.PropertyConverter', property='id')">
								<template name="model">
									<comboitem label="@load(empty each? '- -' : vm.getEtichettaEnum(each))"
											   value="@load(each)"/>
								</template>
							</combobox>
						</cell>
					</row>
					<row>
						<cell align="right">
                            <h:span class="mandatoryLabel">*</h:span><label value="@load(vm.etichette['Descrizione'])"/>
						</cell>
						<cell colspan="2">
							<hlayout valign="middle">
								<textbox value="@bind(vm.dettaglio.descrizione)" hflex="1"/>
								<button image="/images/icon/action/16x16/cancel.png"
										tooltiptext="@load(vm.etichette['Cancella'])"
										onClick="@command('onCancellaCampoDizionario')">
									<custom-attributes proprieta="descrizione"/>
								</button>
							</hlayout>
						</cell>
					</row>
					<row>
						<cell align="right">
							<label value="@load(vm.etichette['Codice_ANPR'])"/>
						</cell>
						<cell colspan="2">
							<combobox model="@load(vm.listaAnpCodiceProfessione)" readonly="true" width="400px"
									  selectedItem="@bind(vm.dettaglio.codiceAnpr) @converter('it.finmatica.zk.utils.PropertyConverter', property='codice')">
								<template name="model">
									<comboitem label="@load(empty each? '- -' : c:cat3(each.codice, ' - ', each.descrizione))"
											   value="@load(each)"/>
								</template>
							</combobox>
						</cell>
					</row>
				</rows>
			</grid>

		</vlayout>

	</window>

</zk>