<?xml version="1.0" encoding="UTF-8"?>
<?taglib uri="http://www.zkoss.org/dsp/web/core" prefix="c"?>

<zk xmlns="http://www.zkoss.org/2005/zul"
	xmlns:h="http://www.w3.org/1999/xhtml"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul http://www.zkoss.org/2005/zul/zul.xsd">

	<window viewModel="@id('vm') @init('restrict.anagrafe.dizionari.EnteDettaglioViewModel')"
			apply="org.zkoss.bind.BindComposer"
			border="none"
			width="100%" height="100%"
			sizable="false" closable="false">

		<vlayout vflex="1">

			<hlayout valign="middle">
				<controlBarDettaglio/>

				<label value="@load(vm.formLabel)" sclass="formTitle"/>
			</hlayout>

			<grid sclass="form">
				<columns>
					<column width="150px"/>
					<column/>
				</columns>
				<rows>
					<row>
						<cell align="right">
							<h:span class="mandatoryLabel">*</h:span><label value="@load(vm.etichette['Codice'])"/>
						</cell>
						<cell>
							<intbox value="@bind(vm.dettaglio.id)" mold="rounded" cols="8" maxlength="2" disabled="@load(vm.tipoOperazione.isUpdate())"/>
						</cell>
					</row>
					<row>
						<cell align="right">
                            <h:span class="mandatoryLabel">*</h:span><label value="@load(vm.etichette['Descrizione'])"/>
						</cell>
						<cell>
							<hlayout valign="middle" hflex="1">
								<textbox value="@bind(vm.dettaglio.descrizione)" hflex="1"/>
								<button image="/images/icon/action/16x16/cancel.png"
										tooltiptext="@load(vm.etichette['Cancella'])"
										onClick="@command('onCancellaCampoDizionario')">
									<custom-attributes proprieta="descrizione"/>
								</button>
							</hlayout>
						</cell>
					</row>
					<row>
						<cell align="right">
							<label value="@load(vm.etichette['Indirizzo'])"/>
						</cell>
						<cell>
							<hlayout valign="middle" hflex="1">
								<textbox value="@bind(vm.dettaglio.indirizzo)" hflex="1"/>
								<button image="/images/icon/action/16x16/cancel.png"
										tooltiptext="@load(vm.etichette['Cancella'])"
										onClick="@command('onCancellaCampoDizionario')">
									<custom-attributes proprieta="indirizzo"/>
								</button>
							</hlayout>
						</cell>
					</row>
					<row>
						<cell align="right">
							<label value="@load(vm.etichette['CAP'])"/>
						</cell>
						<cell>
							<hlayout valign="middle">
								<textbox value="@bind(vm.dettaglio.cap)" cols="10" maxlength="10"/>
								<button image="/images/icon/action/16x16/cancel.png"
										tooltiptext="@load(vm.etichette['Cancella'])"
										onClick="@command('onCancellaCampoDizionario')">
									<custom-attributes proprieta="cap"/>
								</button>
							</hlayout>
						</cell>
					</row>
					<row>
						<cell align="right">
							<label value="@load(vm.etichette['Comune'])"/>
						</cell>
						<cell>
							<hlayout valign="middle" hflex="1">
								<bandboxComuni hflex="1"
											   value="@load(vm.dettaglio.comune.descrizione)"
											   onSelect="@command('onSelectComune', campoRiferimento='ENTE')"/>
								<textbox value="@load(vm.dettaglio.comune.siglaProvincia)" readonly="true" cols="5"/>
								<button image="/images/icon/action/16x16/cancel.png"
										tooltiptext="@load(vm.etichette['Cancella'])"
										onClick="@command('onCancellaComune', campoRiferimento='ENTE')"/>
							</hlayout>
						</cell>
					</row>
					<row visible="@load(vm.sezioneComunicazioni)">
						<cell align="right">
                            <h:span class="mandatoryLabel">*</h:span><label value="@load(vm.etichette['Riferimento'])"/>
						</cell>
						<cell>
                            <combobox model="@load(vm.listaSigle)" readonly="true" width="400px"
                                      selectedItem="@bind(vm.dettaglio.sigla)">
                                <template name="model">
                                    <comboitem label="@load(c:cat3(each, ' - ' , each.getDescrizione()))" value="@load(each)"/>
                                </template>
                            </combobox>
						</cell>
					</row>
					<!--<row>
						<cell align="right">
							<label value="@load(vm.etichette['CdF'])"/>
						</cell>
						<cell>
							<checkbox checked="@bind(vm.dettaglio.cdf)"/>
						</cell>
					</row>
					<row>
						<cell align="right">
							<label value="@load(vm.etichette['Codice_ANPR'])"/>
						</cell>
						<cell>
							<combobox model="@load(vm.listaCodiceEnte)" readonly="true" width="400px"
									  selectedItem="@bind(vm.dettaglio.codiceAnpr) @converter('it.finmatica.zk.utils.PropertyConverter', property='codice')">
								<template name="model">
									<comboitem label="@load(empty each? '- -' : c:cat3(each.codice, ' - ', each.descrizione))"
											   value="@load(each)"/>
								</template>
							</combobox>
						</cell>
					</row>-->
					<row>
						<cell align="right">
							<label value="@load(vm.etichette['Indirizzo_PEC'])"/>
						</cell>
						<cell>
							<hlayout valign="middle" hflex="1">
								<textbox value="@bind(vm.dettaglio.pec)" hflex="1" />
								<button image="/images/icon/action/16x16/cancel.png"
										tooltiptext="@load(vm.etichette['Cancella'])"
										onClick="@command('onCancellaCampoDizionario')">
									<custom-attributes proprieta="pec"/>
								</button>
							</hlayout>
						</cell>
					</row>
					<row>
						<cell align="right">
							<label value="@load(vm.etichette['Codice_AMM'])"/>
						</cell>
						<cell>
							<hlayout valign="middle">
								<textbox value="@bind(vm.dettaglio.codAmm)"/>
								<button image="/images/icon/action/16x16/cancel.png"
										tooltiptext="@load(vm.etichette['Cancella'])"
										onClick="@command('onCancellaCampoDizionario')">
									<custom-attributes proprieta="codAmm"/>
								</button>
							</hlayout>
						</cell>
					</row>
					<row>
						<cell align="right">
							<label value="@load(vm.etichette['Codice_UO'])"/>
						</cell>
						<cell>
							<hlayout valign="middle">
								<textbox value="@bind(vm.dettaglio.codiceUo)"/>
								<button image="/images/icon/action/16x16/cancel.png"
										tooltiptext="@load(vm.etichette['Cancella'])"
										onClick="@command('onCancellaCampoDizionario')">
									<custom-attributes proprieta="codiceUo"/>
								</button>
							</hlayout>
						</cell>
					</row>
				</rows>
			</grid>

		</vlayout>

	</window>

</zk>