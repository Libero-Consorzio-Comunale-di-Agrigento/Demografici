<?xml version="1.0" encoding="UTF-8"?>
<?taglib uri="http://www.zkoss.org/dsp/web/core" prefix="c"?>

<zk xmlns="http://www.zkoss.org/2005/zul"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.zkoss.org/2005/zul http://www.zkoss.org/2005/zul/zul.xsd">

    <window viewModel="@id('vm') @init('restrict.anagrafe.dizionari.comunicazioni.ComunicazioniViewModel')"
            apply="org.zkoss.bind.BindComposer"
            border="none"
            width="100%" height="@load(vm.wCenterHeight)"
            sizable="false" closable="false">

        <tabbox hflex="1" vflex="1">
            <tabs>
                <tab label="@load(vm.etichette['Modelli'])" tooltiptext="@load(vm.etichette['Modelli'])"/>
                <tab label="@load(vm.etichette['Modelli_Ente'])" tooltiptext="@load(vm.etichette['Modelli_Ente'])"/>
                <tab label="@load(vm.etichette['Enti'])" tooltiptext="@load(vm.etichette['Enti'])"/>
                <tab label="@load(vm.etichette['Comunicazioni'])" tooltiptext="@load(vm.etichette['Comunicazioni'])"/>
                <tab label="@load(vm.etichette['Parametri_Protocollo'])" tooltiptext="@load(vm.etichette['Parametri_Protocollo'])"/>
            </tabs>
            <tabpanels>
                <tabpanel>
                    <include hflex="1" vflex="1" src="/restrict/anagrafe/dizionari/comunicazioni/modelloLista.zul"/>
                </tabpanel>
                <tabpanel>
                    <include hflex="1" vflex="1" src="/restrict/anagrafe/dizionari/comunicazioni/modelloEnteLista.zul"/>
                </tabpanel>
                <tabpanel>
                    <include hflex="1" vflex="1" src="/restrict/anagrafe/dizionari/enteLista.zul" comunicazioni="true"/>
                </tabpanel>
                <tabpanel>
                    <include hflex="1" vflex="1" src="/restrict/anagrafe/dizionari/comunicazioni/comunicazioneLista.zul"/>
                </tabpanel>
                <tabpanel>
                    <include hflex="1" vflex="1" src="/restrict/anagrafe/dizionari/comunicazioni/parametroProtocolloLista.zul"/>
                </tabpanel>
            </tabpanels>
        </tabbox>

    </window>

</zk>