<?xml version="1.0" encoding="UTF-8"?>
<?taglib uri="http://www.zkoss.org/dsp/web/core" prefix="c"?>

<zk xmlns="http://www.zkoss.org/2005/zul"
    xmlns:h="http://www.w3.org/1999/xhtml"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.zkoss.org/2005/zul http://www.zkoss.org/2005/zul/zul.xsd">

    <window viewModel="@id('vm') @init('restrict.anagrafe.dizionari.comunicazioni.ModelloDettaglioViewModel')"
            apply="org.zkoss.bind.BindComposer"
            border="none"
            width="100%" height="100%"
            sizable="false" closable="false">

        <vlayout vflex="1">

            <hlayout valign="middle">
                <controlBarDettaglio/>

                <label value="@load(vm.formLabel)" sclass="formTitle"/>
            </hlayout>

            <grid sclass="form">
                <columns>
                    <column width="150px"/>
                    <column/>
                </columns>
                <rows>
                    <row>
                        <cell align="right">
                            <h:span class="mandatoryLabel">*</h:span><label value="@load(vm.etichette['Tipo'])"/>
                        </cell>
                        <cell>
<!--                            <textbox value="@load(vm.getEtichettaEnum(vm.dettaglio.tipoModello))" cols="20" disabled="true"/>-->
                            <combobox model="@load(vm.listaTipiModello)" disabled="@load(vm.tipoOperazione.isUpdate())"
                                      selectedItem="@bind(vm.dettaglio.tipoModello) @converter('it.finmatica.zk.utils.PropertyConverter', property='id')" readonly="true">
                                <template name="model">
                                    <comboitem label="@load(vm.getEtichettaEnum(each))" tooltiptext="@load(vm.getEtichettaEnum(each))" value="@load(each)"/>
                                </template>
                            </combobox>
                        </cell>
                    </row>
                    <row>
                        <cell align="right">
                            <h:span class="mandatoryLabel">*</h:span><label value="@load(vm.etichette['Codice'])"/>
                        </cell>
                        <cell>
                            <textbox value="@bind(vm.dettaglio.codModello)" cols="6" maxlength="4" disabled="@load(vm.tipoOperazione.isUpdate())"/>
                        </cell>
                    </row>
                    <row>
                        <cell align="right">
                            <h:span class="mandatoryLabel">*</h:span><label value="@load(vm.etichette['Descrizione'])"/>
                        </cell>
                        <cell>
                            <textbox value="@bind(vm.dettaglio.descrizione)" hflex="1" maxlength="100"/>
                        </cell>
                    </row>
                    <row>
                        <cell align="right">
                            <label value="@load(vm.etichette['Note'])"/>
                        </cell>
                        <cell>
                            <textbox value="@bind(vm.dettaglio.note)" hflex="1" multiline="true" rows="5" maxlength="2000"/>
                        </cell>
                    </row>
                    <row>
                        <cell align="right">
                            <customLabel value="@load(vm.etichette['Modello'])"/>
                        </cell>
                        <cell>
                            <hlayout valign="middle" hflex="1">
                                <textbox value="@bind(vm.modelloRelazione.modello.nome)"
                                         tooltiptext="@load(vm.modelloRelazione.modello.nome)"/>
                                <button visible="@bind(not empty vm.modelloRelazione.modello.id)"
                                        image="/images/icon/action/16x16/import.png"
                                        tooltiptext="@load(vm.etichette['scarica_modello_tooltip'])"
                                        onClick="@command('onDownloadAllegato')"/>
                                <button image="/images/icon/action/16x16/export.png" upload="true"
                                        tooltiptext="@load(vm.etichette['inserisci_modello_tooltip'])"
                                        onUpload="@command('onUploadAllegato')"/>
                            </hlayout>
                        </cell>
                    </row>
                    <row>
                        <cell align="right">
                            <label value="@load(vm.etichette['Formato_testo'])"/>
                        </cell>
                        <cell>
                            <combobox model="@load(vm.listaFormatiTesto)" readonly="true"
                                      selectedItem="@bind(vm.modelloRelazione.modello.formatoTesto)">
                                <template name="model">
                                    <comboitem label="@load(empty each?'- -':each)" value="@load(each)"/>
                                </template>
                            </combobox>
                        </cell>
                    </row>
                </rows>
            </grid>

        </vlayout>

    </window>

</zk>