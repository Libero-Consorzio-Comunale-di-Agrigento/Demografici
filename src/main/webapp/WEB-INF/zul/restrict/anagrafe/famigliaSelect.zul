<?xml version="1.0" encoding="UTF-8"?>
<?taglib uri="http://www.zkoss.org/dsp/web/core" prefix="c"?>
<?component name="templateRicercaFamiglia" macroURI="/restrict/anagrafe/templateRicercaFamiglia.zul" inline="true"?>

<zk xmlns="http://www.zkoss.org/2005/zul"
    xmlns:h="http://www.w3.org/1999/xhtml"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.zkoss.org/2005/zul http://www.zkoss.org/2005/zul/zul.xsd">

    <window viewModel="@id('vm') @init('restrict.anagrafe.FamigliaSelectViewModel')"
            apply="org.zkoss.bind.BindComposer"
            border="none"
            width="1300px" height="600px"
            title="@load(vm.etichette['Seleziona_Famiglie_Interni'])"
            sizable="false" closable="false">

        <controlBar value="@load(vm.controlBarAttributes)"/>

        <vlayout vflex="1">
            <groupbox closable="false">
                <templateRicercaFamiglia/>
            </groupbox>

            <hlayout sclass="navigazione" valign="middle">
                <totalSizeBlock/>
            </hlayout>

            <listbox model="@load(vm.lista)" selectedItem="@bind(vm.dettaglio)" nonselectableTags="" vflex="1"
                      emptyMessage="@load(vm.etichette['Nessun_dato_disponibile'])">
            <listhead>
                <listheader label="@load(vm.etichette['Indirizzo'])" hflex="3"/>
                <listheader label="@load(vm.etichette['Stato'])" hflex="3"/>
                <listheader label="@load(vm.etichette['Intestatario'])" hflex="2"/>
                <listheader label="@load(vm.etichette['Convivenza'])" hflex="2"/>
                <listheader label="" width="52px"/>
            </listhead>
            <template name="model" var="item">
                <listitem onDoubleClick="@command('onSeleziona')">
                    <listcell
                            label="@load(c:cat3(item.indirizzo.indirizzo.via.denominazione, item.indirizzo.civicoEsternoFormatted, item.indirizzo.civicoInternoFormatted))"/>
                    <listcell label="@load(item.stato)"/>
                    <listcell label="@load(item.intestatarioInterno)"/>
                    <listcell label="@load(item.convivenza)"/>
                    <listcell>
                        <button image="/images/icon/action/16x16/forward.png"
                                tooltiptext="@load(vm.etichette['seleziona_tooltip'])"
                                onClick="@command('onSeleziona')"/>
                    </listcell>
                </listitem>
            </template>
        </listbox>

        </vlayout>

        <h:div sclass="barraPulsanti">
            <h:div>
                <button label="@load(vm.etichette['Seleziona'])" onClick="@command('onSeleziona')"
                        image="/images/icon/action/16x16/ok.png"/>
                <button label="@load(vm.etichette['Chiudi'])" onClick="@command('onChiudi')"
                        image="/images/icon/action/16x16/close.png"/>
            </h:div>
        </h:div>
    </window>
</zk>