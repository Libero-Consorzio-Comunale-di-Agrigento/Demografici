<?xml version="1.0" encoding="UTF-8"?>
<?taglib uri="http://www.zkoss.org/dsp/web/core" prefix="c"?>

<zk xmlns="http://www.zkoss.org/2005/zul"
	xmlns:h="http://www.w3.org/1999/xhtml"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul http://www.zkoss.org/2005/zul/zul.xsd">

	<hlayout sclass="navigazione" valign="middle">
		<totalSizeBlock/>
		<hlayout hflex="1" valign="middle" sclass="testo-a-dx">
			<label value="@load(vm.etichette['Ordina_per'])" sclass="grassetto"/>
			<combobox model="@load(vm.listaOrder)" readonly="true" width="230px"
					  selectedItem="@bind(vm.selectedOrder)" onChange="@command('onRicarica')">
				<template name="model">
					<comboitem label="@load(each.etichetta)" value="@load(each)"/>
				</template>
			</combobox>
		</hlayout>
	</hlayout>

</zk>