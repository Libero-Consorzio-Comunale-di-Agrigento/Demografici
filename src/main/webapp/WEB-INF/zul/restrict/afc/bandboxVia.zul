<?xml version="1.0" encoding="UTF-8"?>
<?taglib uri="http://www.zkoss.org/dsp/web/core" prefix="c"?>

<zk xmlns="http://www.zkoss.org/2005/zul"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.zkoss.org/2005/zul http://www.zkoss.org/2005/zul/zul.xsd">

    <bandpopup>

        <hlayout sclass="navigazione" valign="middle">
            <hlayout sclass="afc-control-bar" valign="middle">

                <paging sclass="afc-paging"/>

                <hlayout sclass="campo-ricerca" visible="false">
                    <textbox width="180px"
                             mold="default"
                             disabled="true"
                             style="border-width:0px; text-transform:uppercase"/>
                    <image src="/images/de4gsdzk/10x10/cancelSimple.png"
                           style="padding:5px;"
                           sclass="toolbar-mini-button"/>
                </hlayout>
            </hlayout>
        </hlayout>

        <listbox width="750px" height="250px" multiple="false">
            <listhead>
                <customlistheader label="@load(self.bbParent.etichette['Codice'])" width="60px"/>
                <customlistheader label="@load(self.bbParent.etichette['Denominazione'])"/>
            </listhead>
            <template name="model">
                <listitem>
                    <listcell label="${each.id}"/>
                    <listcell label="${each.denominazione}" style="text-transform:uppercase"/>
                </listitem>
            </template>
        </listbox>

    </bandpopup>

</zk>