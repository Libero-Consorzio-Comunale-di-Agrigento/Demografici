<?xml version="1.0" encoding="UTF-8"?>

<zk xmlns="http://www.zkoss.org/2005/zul"
    xmlns:h="http://www.w3.org/1999/xhtml"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.zkoss.org/2005/zul http://www.zkoss.org/2005/zul/zul.xsd">

    <hlayout valign="middle">
        <label value="@load(vm.etichette['Stato'])"/>
        <combobox model="@load(vm.listaStati)" readonly="true"
                  selectedItem="@bind(vm.ricercaAtto.stato) @converter('it.finmatica.zk.utils.PropertyConverter', property='id')"
                  onChange="@command('onRicerca')" style="padding:5px">
            <template name="model">
                <comboitem label="@load(empty each?vm.etichette['Tutti']:vm.etichette[each.name()])" value="@load(each)"/>
            </template>
        </combobox>
    </hlayout>

</zk>