<?xml version="1.0" encoding="UTF-8"?>
<?taglib uri="http://www.zkoss.org/dsp/web/core" prefix="c"?>

<zk xmlns="http://www.zkoss.org/2005/zul"
    xmlns:h="http://www.w3.org/1999/xhtml"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.zkoss.org/2005/zul http://www.zkoss.org/2005/zul/zul.xsd">

    <window apply="org.zkoss.bind.BindComposer"
            viewModel="@id('vm') @init('restrict.afc.PopupAvvisiViewModel')"
            title="@load(vm.etichette['Messaggi'])"
            width="700px"
            border="normal"
            closable="false"
            sizable="false">

        <groupbox style="@load(empty vm.listaAvvisi ? 'display:none' : '')">
            <caption>
                <hlayout valign="middle">
                    <div class="z-msgbox z-msgbox-exclamation z-div"/>
                    <label value="@load(c:cat3('Avvisi (', vm.listaAvvisi.size(), ')'))"/>
                </hlayout>
            </caption>
            <grid model="@load(vm.listaAvvisi)"
                  emptyMessage="@load(vm.etichette['Nessun_dato_disponibile'])">
                <template name="model" var="item">
                    <row>
                        <cell>
                            <hlayout valign="middle">
                                <label value="@load(empty item.dettaglio ? item.messaggio : c:cat3(item.messaggio, ' | ', item.dettaglio))"/>
                            </hlayout>
                        </cell>
                    </row>
                </template>
            </grid>
        </groupbox>
        <groupbox style="@load(empty vm.listaBloccanti ? 'display:none' : '')">
            <caption>
                <hlayout valign="middle">
                    <div class="z-msgbox z-msgbox-error z-div"/>
                    <label value="@load(c:cat3('Bloccanti (', vm.listaBloccanti.size(), ')'))"/>
                </hlayout>
            </caption>
            <grid model="@load(vm.listaBloccanti)"
                  emptyMessage="@load(vm.etichette['Nessun_dato_disponibile'])">
                <template name="model" var="item">
                    <row>
                        <cell>
                            <hlayout valign="middle">
                                <label value="@load(empty item.dettaglio ? item.messaggio : c:cat3(item.messaggio, ' | ', item.dettaglio))"/>
                            </hlayout>
                        </cell>
                    </row>
                </template>
            </grid>
        </groupbox>

        <h:div sclass="barraPulsanti">
            <h:div>
                <button label="@load(vm.etichette['Chiudi'])" onClick="@command('onChiudi')"
                        image="/images/icon/action/16x16/close.png"/>
            </h:div>
        </h:div>

    </window>
</zk>