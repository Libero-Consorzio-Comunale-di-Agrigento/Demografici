								</cell>
								<cell align="center">
									<image src="@load(vm.passwordVerificata ? '/images/icon/show/16x16/view_green.png' : '/images/icon/show/16x16/viewcancel.png')"
										   tooltiptext="@load(vm.passwordVerificata ? vm.etichette['Password_Coincidono_tooltip'] : vm.etichette['Password_Diverse_tooltip'])" />
								</cell>
							</row>
							<row>
								<cell  colspan="6" align="right">
									<button label="@load(vm.etichette['Cambio_Password'])" onClick="@command('onCambiaPassword')" disabled="@load(not vm.passwordVerificata)"  mold="trendy" image="/images/icon/action/16x16/save.png" />
								</cell>
							</row>
						</rows>
					</grid>
				</tabpanel>
