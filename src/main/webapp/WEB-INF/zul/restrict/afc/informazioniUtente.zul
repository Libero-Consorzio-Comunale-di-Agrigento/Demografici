				<tab label="@load(vm.etichette['Cambio_Password'])" />
				<!--<tab label="@load(vm.etichette['Informazioni'])" />
				<tab label="@load(vm.etichette['Preferenze'])" />-->
	 		</tabs>
	 		<tabpanels>
				<!-- Cambio Password -->
				<tabpanel vflex="1">
					<grid sclass="form">
						<rows>
							<row>
