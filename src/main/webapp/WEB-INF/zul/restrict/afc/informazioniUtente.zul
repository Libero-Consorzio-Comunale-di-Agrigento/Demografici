									<label value="@load(vm.etichette['Password_Corrente'])"/>
								</cell>
								<cell colspan="3">
									<passwordTextbox value="@bind(vm.vecchiaPassword)"/>
								</cell>
								<cell/>
							</row>
<!--							<row>-->
<!--								<cell colspan="2">-->
<!--									<label value="@load(vm.etichette['Password_Corrente'])" />-->
