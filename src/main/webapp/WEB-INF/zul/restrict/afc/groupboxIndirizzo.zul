<?xml version="1.0" encoding="UTF-8"?>
<?taglib uri="http://www.zkoss.org/dsp/web/core" prefix="c"?>

<zk xmlns="http://www.zkoss.org/2005/zul">
    <caption label="${arg.label}"/>
    <grid sclass="form" hflex="1">
        <zk if="${arg.tipoIndirizzo eq 'NONE'}">
            <columns>
                <column width="120px"/>
                <column/>
            </columns>
            <rows>
                <row>
                    <cell align="right">
                        <label value="@load(vm.etichette['Via'])"/>
                    </cell>
                    <cell/>
                </row>
            </rows>
        </zk>
        <zk if="${arg.tipoIndirizzo eq 'RESIDENTE_SENZA_COMUNE'}">
            <columns>
                <column width="150px"/>
                <column/>
            </columns>
            <rows>
                <row>
                    <cell align="right">
                        <label value="@load(vm.etichette['Via'])"/>
                    </cell>
                    <cell>
                        <customLabel value="${arg.indirizzo.viaFormatted}"
                                     bold="true"/>
                    </cell>
                </row>
            </rows>
        </zk>
        <zk if="${arg.tipoIndirizzo eq 'RESIDENTE'}">
            <columns>
                <column width="150px"/>
                <column/>
            </columns>
            <rows>
                <row>
                    <cell align="right">
                        <label value="@load(vm.etichette['Via'])"/>
                    </cell>
                    <cell>
                        <customLabel value="${arg.indirizzo.viaFormatted}"
                                     bold="true"/>
                    </cell>
                </row>
                <row>
                    <cell align="right">
                        <label value="@load(vm.etichette['Comune'])"/>
                    </cell>
                    <cell>
                        <comuneLabel
                                value="${arg.indirizzo.comune}"
                                bold="true"/>
                    </cell>
                </row>
            </rows>
        </zk>
        <zk if="${arg.tipoIndirizzo eq 'NON_RESIDENTE'}">
            <columns>
                <column width="100px"/>
                <column/>
            </columns>
            <rows>
                <row>
                    <cell align="right">
                        <label value="@load(vm.etichette['Via'])"/>
                    </cell>
                    <cell>
                        <customLabel
                                value="${arg.indirizzo.via}"
                                bold="true"/>
                    </cell>
                </row>
                <row>
                    <cell align="right">
                        <label value="@load(vm.etichette['Comune'])"/>
                    </cell>
                    <cell>
                        <comuneLabel
                                value="${arg.indirizzo.comune}"
                                bold="true"/>
                    </cell>
                </row>
            </rows>
        </zk>
        <zk if="${arg.tipoIndirizzo eq 'RESIDENTE_ESTERO'}">
            <columns>
                <column width="150px"/>
                <column/>
            </columns>
            <rows>
                <row>
                    <cell align="right">
                        <label value="@load(vm.etichette['Via'])"/>
                    </cell>
                    <cell>
                        <customLabel value="${arg.indirizzo.via}" bold="true"/>
                    </cell>
                </row>
                <row>
                    <cell align="right">
                        <label value="@load(vm.etichette['Zipcode'])"/>
                    </cell>
                    <cell>
                        <customLabel value="${arg.indirizzo.zipcode}" bold="true"/>
                    </cell>
                </row>
                <row>
                    <cell align="right">
                        <label value="@load(vm.etichette['Provincia_Contea'])"/>
                    </cell>
                    <cell>
                        <customLabel value="${arg.indirizzo.provinciaContea}" bold="true"/>
                    </cell>
                </row>
                <row>
                    <cell align="right">
                        <label value="@load(vm.etichette['Presso'])"/>
                    </cell>
                    <cell>
                        <customLabel value="${arg.indirizzo.presso}" bold="true"/>
                    </cell>
                </row>
                <row>
                    <cell align="right">
                        <label value="@load(vm.etichette['Comune'])"/>
                    </cell>
                    <cell>
                        <comuneLabel value="${arg.indirizzo.comune}"
                                     bold="true"/>
                    </cell>
                </row>
                <row>
                    <cell align="right">
                        <label value="@load(vm.etichette['Consolato'])"/>
                    </cell>
                    <cell>
                        <customLabel value="${arg.indirizzo.codiceConsolato}"
                                     bold="true"/>
                    </cell>
                </row>
                <row>
                    <cell align="right">
                        <label value="@load(vm.etichette['Sede'])"/>
                    </cell>
                    <cell>
                        <customLabel value="${arg.indirizzo.sedeConsolato}"
                                     bold="true"/>
                    </cell>
                </row>
            </rows>
        </zk>
    </grid>
</zk>
