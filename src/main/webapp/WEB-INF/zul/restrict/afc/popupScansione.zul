<?xml version="1.0" encoding="UTF-8"?>
<?taglib uri="http://www.zkoss.org/dsp/web/core" prefix="c"?>

<zk xmlns="http://www.zkoss.org/2005/zul"
    xmlns:h="http://www.w3.org/1999/xhtml"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.zkoss.org/2005/zul http://www.zkoss.org/2005/zul/zul.xsd">

	<window apply="org.zkoss.bind.BindComposer"
			viewModel="@id('vm') @init('restrict.afc.PopupScansioneViewModel')"
			title="@load(vm.etichette['Scansione'])"
			width="470px"
			height="382px"
			border="normal"
			closable="false"
			sizable="false">

		<iframe src="@load(vm.urlScansione)" width="100%" height="265px"/>

		<grid sclass="form">
			<rows>
				<row>
					<cell align="right" width="150px">
						<label value="Nome file scansionato"/>
					</cell>
					<cell >
						<textbox value="@bind(vm.nomeFileScansionato)" placeholder="@load(vm.nomeFileScansionatoPlaceholder)" hflex="1"/>
					</cell>
				</row>
			</rows>
		</grid>

		<h:div sclass="barraPulsanti">
			<h:div>
				<button label="@load(vm.etichette['Chiudi'])"	onClick="@command('onChiudi')"	image="/images/icon/action/16x16/close.png"/>
			</h:div>
		</h:div>

    </window>

</zk>