<?xml version="1.0" encoding="UTF-8"?>
<?taglib uri="http://www.zkoss.org/dsp/web/core" prefix="c"?>

<zk xmlns="http://www.zkoss.org/2005/zul"
    xmlns:h="http://www.w3.org/1999/xhtml"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.zkoss.org/2005/zul http://www.zkoss.org/2005/zul/zul.xsd">	

	<bandpopup>

		<hlayout sclass="navigazione" valign="middle">
			<hlayout sclass="afc-control-bar" valign="middle">

				<paging sclass="afc-paging"/>

				<hlayout sclass="campo-ricerca" visible="false">
					<textbox width="180px"
							 mold="default"
							 disabled="true"
							 style="border-width:0px; text-transform:uppercase"/>
					<image src="/images/de4gsdzk/10x10/cancelSimple.png"
						   style="padding:5px;"
						   sclass="toolbar-mini-button"/>
				</hlayout>
			</hlayout>
		</hlayout>

		<listbox width="750px" height="250px" multiple="false">
			<listhead>
				<customlistheader label="@load(self.bbParent.etichette['Denominazione_Comune'])"/>
				<customlistheader label="@load(self.bbParent.etichette['Sigla_Provincia'])" width="10%"/>
				<customlistheader label="@load(self.bbParent.etichette['Codice_Provincia'])" width="10%"/>
				<customlistheader label="@load(self.bbParent.etichette['Codice_Comune'])" width="10%"/>
				<customlistheader label="@load(self.bbParent.etichette['Soppresso'])" width="10%"/>
				<customlistheader label="@load(self.bbParent.etichette['Il'])" width="10%" 			visibilityHandler="AR" 	visible="true"/>
				<customlistheader label="@load(self.bbParent.etichette['Valido_Dal'])" width="10%" 	visibilityHandler="ST" 	visible="false"/>
				<customlistheader label="@load(self.bbParent.etichette['Al'])" width="10%" 			visibilityHandler="ST" 	visible="false"/>
				<customlistheader label="@load(self.bbParent.etichette['Catasto'])" width="10%"/>
			</listhead>
			<template name="model">
				<listitem>
					<listcell label="${each.descrizioneComune}"/>
					<listcell label="${each.siglaProvincia}"/>
					<listcell label="${each.codiceProvincia}"/>
					<listcell label="${each.codiceComune}"/>
					<listcell>
						<checkbox checked="${each.soppresso eq 'S'}" disabled="true"/>
					</listcell>
					<listcell label="${not each.isStorico?(empty each.dataSoppressione? '' : (c:formatDate(each.dataSoppressione, 'dd/MM/yyyy'))):''}"/>
					<listcell label="${each.isStorico?(empty each.dataInizioValidita? '' : (c:formatDate(each.dataInizioValidita, 'dd/MM/yyyy'))):''}"/>
					<listcell label="${each.isStorico?(empty each.dataFineValidita? '' : (c:formatDate(each.dataFineValidita, 'dd/MM/yyyy'))):''}"/>
					<listcell label="${each.codiceCatasto}"/>
				</listitem>
			</template>
		</listbox>

	</bandpopup>	
	
</zk>