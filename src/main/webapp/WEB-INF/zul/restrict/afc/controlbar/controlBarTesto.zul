<?xml version="1.0" encoding="UTF-8"?>
<?taglib uri="http://www.zkoss.org/dsp/web/core" prefix="c"?>

<zk xmlns="http://www.zkoss.org/2005/zul"
	xmlns:h="http://www.w3.org/1999/xhtml"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul http://www.zkoss.org/2005/zul/zul.xsd">

	<hlayout sclass="navigazione" valign="middle">
		<hlayout sclass="afc-control-bar" valign="middle">

            <toolbarbuttonBloccoSbloccoTesto/>

			<toolbarbutton image="/images/icon/action/22x22/editcopy.png"
						   visible="@load(vm.atto.hasMargine())"
						   tooltiptext="@load(vm.etichette['blocca_margine_tooltip'])"
						   onClick="@command('onBloccaSbloccaMargine')"/>
		</hlayout>
	</hlayout>

</zk>