<?xml version="1.0" encoding="UTF-8"?>
<?taglib uri="http://www.zkoss.org/dsp/web/core" prefix="c"?>

<zk xmlns="http://www.zkoss.org/2005/zul"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.zkoss.org/2005/zul http://www.zkoss.org/2005/zul/zul.xsd">

    <hlayout sclass="navigazione" valign="middle">
        <hlayout sclass="afc-control-bar" valign="middle">

            <toolbarbutton image="/images/icon/action/22x22/world.png"
                           tooltiptext="@load(vm.etichette['Recupero_Pratiche_Web'])"
                           onClick="@command('onFunzioniAggiuntive', archivio='WEB')"/>


            <toolbarbutton image="/images/de4gsdzk/22x22/anpr.png"
                           tooltiptext="@load(vm.etichette['Recupero_Pratiche_ANPR'])"
                           onClick="@command('onFunzioniAggiuntive', archivio='ANPR')"/>


            <toolbarbutton image="/images/icon/action/22x22/profile.png"
                           tooltiptext="@load(vm.etichette['Recupero_Esito_Accertamenti'])"
                           onClick="@command('onFunzioniAggiuntive', archivio='ACC')"/>


        </hlayout>
    </hlayout>
</zk>