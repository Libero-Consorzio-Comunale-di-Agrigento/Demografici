<?xml version="1.0" encoding="UTF-8"?>
<?taglib uri="http://www.zkoss.org/dsp/web/core" prefix="c"?>

<zk xmlns="http://www.zkoss.org/2005/zul"
	xmlns:h="http://www.w3.org/1999/xhtml"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul http://www.zkoss.org/2005/zul/zul.xsd">

	<hlayout sclass="navigazione" valign="middle">
		<hlayout sclass="afc-control-bar" valign="middle">

			<zk if="${vm.backFromListFascicoloEnabled}">
				<toolbarbuttonBackFromList/>
			</zk>

			<zk if="${vm.pagingFascicoloEnabled}">
				<paging sclass="afc-paging"
						onPaging="@command('onPagina')"
						activePage="@bind(vm.activePage)"
						pageSize="@bind(vm.pageSize)"
						totalSize="@load(vm.totalSize)"/>
			</zk>

			<include hflex="1" vflex="1" src="@load(vm.additionalFascicoloSearchFilter)"
					 if="${not empty vm.additionalFascicoloSearchFilter}"/>

			<zk if="${vm.uploadFascicoloEnabled}">
				<toolbarbutton image="/images/icon/action/22x22/export.png"
							   upload="true"
							   tooltiptext="@load(vm.etichette['carica_documento_tooltip'])"
							   onUpload="@command('onUploadFascicolo')"/>
			</zk>

			<zk if="${vm.scansionaEnabled}">
				<ScanToolbarbutton onScanCompleted="@command('onScanFascicolo')"/>
			</zk>

			<zk if="${vm.importaDaProtocolloEnabled}">
				<!--<toolbarbutton image="/images/icon/action/22x22/search.png"
							   tooltiptext="@load(vm.etichette['importa_da_protocollo_tooltip'])"
							   onClick="@command('onImportaDaProtocollo')"/>-->
			</zk>

			<zk if="${vm.deleteFascicoloEnabled}">
				<toolbarbuttonDeleteFromList/>
			</zk>

		</hlayout>
	</hlayout>

</zk>