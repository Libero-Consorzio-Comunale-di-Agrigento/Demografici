<?xml version="1.0" encoding="UTF-8"?>
<?taglib uri="http://www.zkoss.org/dsp/web/core" prefix="c"?>

<zk xmlns="http://www.zkoss.org/2005/zul"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.zkoss.org/2005/zul http://www.zkoss.org/2005/zul/zul.xsd">

	<hlayout sclass="navigazione" valign="middle">
		<hlayout sclass="afc-control-bar" valign="middle">

			<zk if="${vm.backFromListANSCEnabled}">
				<toolbarbuttonBackFromList/>
			</zk>

            <zk if="${vm.goToFascicoloANSCEnabled}">
                <toolbarbuttonGoToFascicolo/>
            </zk>

            <zk if="${vm.goToFirmatariANSCEnabled}">
                <toolbarbutton image="/images/icon/action/22x22/customers.png"
                               tooltiptext="@load(vm.etichette['firmatari_tooltip'])"
                               disabled="@load(vm.atto.getFlagFirmatoUscAnsc())"
                               onClick="@command('onPreviewFirmatari')"/>
            </zk>

            <zk if="${vm.goToAllegatiANSCEnabled}">
                <toolbarbutton image="/images/icon/action/22x22/folder_edit.png"
                               tooltiptext="@load(vm.etichette['allegati_ansc_tooltip'])"
                               disabled="@load(vm.goToAllegatiANSCGrayed)"
                               onClick="@command('onPreviewAllegati')"/>
            </zk>

            <zk if="${vm.saveANSCEnabled}">
                <toolbarbutton image="/images/icon/action/22x22/save.png"
                               tooltiptext="@load(vm.etichette['salva_tooltip'])"
                               onClick="@command('onSalvaAnsc')"/>
            </zk>

            <zk if="${vm.goToANSCEnabled}">
                <toolbarbutton image="/images/de4gsdzk/22x22/ansc.png"
                               tooltiptext="@load(vm.etichette['ansc_tooltip'])"
                               onClick="@command('onPreviewANSC')"/>
            </zk>
		</hlayout>
	</hlayout>

</zk>