<?xml version="1.0" encoding="UTF-8"?>
<?taglib uri="http://www.zkoss.org/dsp/web/core" prefix="c"?>

<zk xmlns="http://www.zkoss.org/2005/zul"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.zkoss.org/2005/zul http://www.zkoss.org/2005/zul/zul.xsd">

    <hlayout sclass="navigazione" valign="middle">
        <hlayout sclass="afc-control-bar" valign="middle">

            <zk if="${vm.backFromRecordEnabled}">
                <toolbarbuttonBackFromRecord/>
            </zk>

            <zk if="${vm.saveRecordEnabled}">
                <toolbarbutton image="/images/icon/action/22x22/save.png"
                               tooltiptext="@load(vm.etichette['salva_tooltip'])"
                               onClick="@command('onSalvaRecord')"
                               disabled="@load(vm.dettaglio.isAnnullato())"/>
            </zk>

            <toolbarbutton image="/images/icon/action/22x22/doc_cancel.png"
                           tooltiptext="@load(vm.etichette['annulla_certificato_tooltip'])"
                           onClick="@command('onAnnullaCertificato')"
                           visible="@load(not vm.dettaglio.isAnnullato())"/>

            <toolbarbutton image="/images/de4gsdzk/22x22/health_doc.png"
                           tooltiptext="@load(vm.etichette['ripristina_certificato_tooltip'])"
                           onClick="@command('onRipristinaCertificato')"
                           visible="@load(vm.dettaglio.isAnnullato())"/>

            <toolbarbutton image="/images/icon/action/22x22/import.png"
                           disabled="@load(not vm.dettaglio.isDownloadAllegatoEnabled())"
                           tooltiptext="@load(vm.etichette['scarica_allegato_tooltip'])"
                           onClick="@command('onDownloadAllegato', idCertificatoEmesso=vm.dettaglio.id)"/>

        </hlayout>
    </hlayout>
</zk>