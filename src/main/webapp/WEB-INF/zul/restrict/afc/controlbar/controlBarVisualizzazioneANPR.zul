<?xml version="1.0" encoding="UTF-8"?>
<?taglib uri="http://www.zkoss.org/dsp/web/core" prefix="c"?>

<zk xmlns="http://www.zkoss.org/2005/zul"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.zkoss.org/2005/zul http://www.zkoss.org/2005/zul/zul.xsd">

    <hlayout sclass="navigazione" valign="middle" visible="@load(not empty vm.anpDettaglio)">
        <hlayout sclass="afc-control-bar" valign="middle">

            <toolbarbutton image="/images/icon/action/22x22/detail.png"
                           tooltiptext="@load(vm.etichette['Altri_Dati_ANPR_tooltip'])"
                           onClick="@command('onOpenAltriDatiAnpr')"/>
            <toolbarbutton image="/images/icon/action/22x22/profile.png"
                           tooltiptext="@load(vm.etichette['Dati_Elettore_ANPR_tooltip'])"
                           onClick="@command('onOpenDatiElettoreAnpr')"/>
            <toolbarbutton image="/images/de4gsdzk/22x22/users_heart.png"
                           tooltiptext="@load(vm.etichette['Famiglia_Anpr_tooltip'])"
                           disabled="@load(not vm.famigliaAnprButtonEnabled)"
                           onClick="@command('onOpenFamiglia', tipo='A')"/>

        </hlayout>
    </hlayout>
</zk>