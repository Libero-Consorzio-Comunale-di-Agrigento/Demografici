<?xml version="1.0" encoding="UTF-8"?>
<?taglib uri="http://www.zkoss.org/dsp/web/core" prefix="c"?>

<zk xmlns="http://www.zkoss.org/2005/zul"
	xmlns:h="http://www.w3.org/1999/xhtml"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul http://www.zkoss.org/2005/zul/zul.xsd">

	<hlayout sclass="navigazione" valign="middle">
		<hlayout sclass="afc-control-bar" valign="middle">

			<zk if="${vm.backFromListComunicazioneEnabled}">
				<toolbarbuttonBackFromList/>
			</zk>

			<zk if="${vm.pagingComunicazioneEnabled}">
				<paging sclass="afc-paging"
						onPaging="@command('onPagina')"
						activePage="@bind(vm.activePage)"
						pageSize="@bind(vm.pageSize)"
						totalSize="@load(vm.totalSize)"/>
			</zk>

			<zk if="${vm.addComunicazioneEnabled}">
				<toolbarbuttonInsFromList/>
			</zk>

			<zk if="${vm.generaTestoComunicazioneEnabled}">
				<toolbarbutton image="/images/icon/action/22x22/edit.png"
							   tooltiptext="@load(vm.etichette['genera_testo_tooltip'])"
							   onClick="@command('onGeneraTesti')"/>
			</zk>

			<toolbarbutton image="/images/icon/action/22x22/legitimate.png"
						   visible="@load(vm.protocollaComunicazioneEnabled)"
						   disabled="@load(not vm.protocollaComunicazioneEnabled)"
						   tooltiptext="@load(vm.etichette['protocolla_tooltip'])"
						   onClick="@command('onProtocolla')"/>

			<toolbarbutton image="/images/icon/action/22x22/customer_doc.png"
						   visible="@load(vm.sendAlboComunicazioneEnabled)"
						   disabled="@load(not vm.sendAlboComunicazioneEnabled)"
						   tooltiptext="@load(vm.etichette['invio_albo_tooltip'])"
						   onClick="@command('onInviaAlbo')"/>

			<zk if="${vm.goToFascicoloEnabled}">
				<toolbarbuttonGoToFascicolo/>
			</zk>

		</hlayout>
	</hlayout>

</zk>