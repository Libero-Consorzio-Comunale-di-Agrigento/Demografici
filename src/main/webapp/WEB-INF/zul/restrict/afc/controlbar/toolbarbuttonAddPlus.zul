<?xml version="1.0" encoding="UTF-8"?>
<?taglib uri="http://www.zkoss.org/dsp/web/core" prefix="c"?>

<zk xmlns="http://www.zkoss.org/2005/zul"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.zkoss.org/2005/zul http://www.zkoss.org/2005/zul/zul.xsd">

    <toolbarbutton image="/images/icon/action/22x22/add.png"
                   disabled="@load(c:length(vm.addPlusList) lt 1)"
                   tooltiptext="@load(empty vm.etichetteCustom['inserisci_plus']?vm.etichette['inserisci_tooltip']:vm.etichetteCustom['inserisci_plus'] )"
                   popup="sceltaNuovo"/>

    <menupopup id="sceltaNuovo" children="@load(vm.addPlusList)">
        <template name="children" var="i">
            <menuitem label="@load(i.descrizione)" visible="@load(i.tipo eq 'T')"
                      onClick="@command('onInserisciPlus', idDomain=i.idDomain, tipo=i.tipo)"/>

            <menu label="@load(i.descrizione)" visible="@load(i.tipo eq 'C')">
                <menupopup children="@load(i.subList)">
                    <template name="children" var="ii">
                        <menuitem label="@load(ii.descrizione)"
                                  onClick="@command('onInserisciPlus', idDomain=ii.id, tipo=i.tipo)"/>
                    </template>
                </menupopup>
            </menu>

            <!--<menuseparator visible="@load(i.tipo eq 'P')"/>  -->

            <menu label="@load(i.descrizione)" visible="@load(i.tipo eq 'P')">
                <menupopup children="@load(i.subList)">
                    <template name="children" var="ii">
                        <menuitem label="@load(ii.descrizione)"
                                  onClick="@command('onInserisciPlus', idDomain=ii.id, tipo=i.tipo)"/>
                    </template>
                </menupopup>
            </menu>
        </template>
    </menupopup>
</zk>