<?xml version="1.0" encoding="UTF-8"?>
<?taglib uri="http://www.zkoss.org/dsp/web/core" prefix="c"?>

<zk xmlns="http://www.zkoss.org/2005/zul"
	xmlns:h="http://www.w3.org/1999/xhtml"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul http://www.zkoss.org/2005/zul/zul.xsd">

	<hlayout sclass="navigazione" valign="middle">
		<hlayout sclass="afc-control-bar" valign="middle">

			<zk if="${vm.backFromListEnabled}">
				<toolbarbuttonBackFromList/>
			</zk>

			<zk if="${vm.pagingEnabled}">
				<paging sclass="afc-paging"
						onPaging="@command('onPagina')"
						activePage="@bind(vm.activePage)"
						pageSize="@bind(vm.pageSize)"
						totalSize="@load(vm.totalSize)"/>
			</zk>

			<zk if="${vm.excelExportEnabled}">
				<toolbarbuttonExportXls/>
			</zk>

			<zk if="${vm.csvExportEnabled}">
				<toolbarbuttonExportCsv/>
			</zk>

			<zk if="${vm.pdfExportEnabled}">
				<toolbarbutton image="/images/icon/action/22x22/pdf.png"
							   tooltiptext="@load(vm.etichette['pdf_export_tooltip'])"
							   onClick="@command('onEsportaPDF')"/>
			</zk>

			<zk if="${vm.xmlExportEnabled}">
				<toolbarbutton image="/images/icon/action/22x22/xml.png"
							   tooltiptext="@load(vm.etichette['xml_export_tooltip'])"
							   onClick="@command('onEsportaXML')"/>
			</zk>

			<zk if="${vm.selectStampaEnabled}">
				<toolbarbutton image="/images/icon/action/22x22/print.png"
							   popup="sceltaStampa"/>
			</zk>

		</hlayout>

		<zk if="${vm.selectStampaEnabled}">
			<menupopup id="sceltaStampa" children="@load(vm.stampaList)">
				<template name="children" var="i">
					<menuitem label="@load(i.descrizione)" onClick="@command('onSelectStampa', codice=i.codice)"/>
				</template>
			</menupopup>
		</zk>
	</hlayout>

</zk>