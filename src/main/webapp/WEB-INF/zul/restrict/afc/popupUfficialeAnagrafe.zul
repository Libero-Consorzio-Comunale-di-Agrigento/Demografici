<?xml version="1.0" encoding="UTF-8"?>
<?taglib uri="http://www.zkoss.org/dsp/web/core" prefix="c"?>

<zk xmlns="http://www.zkoss.org/2005/zul"
    xmlns:h="http://www.w3.org/1999/xhtml"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.zkoss.org/2005/zul http://www.zkoss.org/2005/zul/zul.xsd">

	<window apply="org.zkoss.bind.BindComposer"
			viewModel="@id('vm') @init('restrict.afc.PopupUfficialeAnagrafeViewModel')"
			title="@load(vm.etichette['Ufficiale_Anagrafe'])"
			width="500px"
			border="normal"
			closable="false"
			sizable="false">

		<vlayout vflex="1">
			<grid sclass="form">
				<rows>
					<row>
                        <cell align="right" width="100px">
                            <label value="@load(vm.etichette['Firma'])"/>
                        </cell>
                        <cell>
                            <hlayout valign="middle" hflex="1">
                                <bandboxTerminalista
                                        value="@bind(vm.ufficialeAnagrafe)"
                                        hflex="1"
                                        onSelect="@command('onSelectUfficialeAnagrafe')"
                                        onChangePreventDefault="@command('onChangeUfficialeAnagrafe', valore=self.value)"/>
                                <label value="@load(vm.etichette['In_Stampa'])" style="padding-left:10px"/>
                                <checkbox checked="@bind(vm.firmaInStampa)"/>
                            </hlayout>
                        </cell>

                    </row>
				</rows>
			</grid>

			<h:div sclass="barraPulsanti">
				<h:div>
					<button label="@load(vm.sorgente eq 'C' ? vm.etichette['Salva'] : vm.etichette['Stampa'])" onClick="@command('onStampa')" 	image="@load(vm.sorgente eq 'C' ? '/images/icon/action/16x16/save.png' : '/images/icon/action/16x16/print.png')" />
					<button label="@load(vm.etichette['Chiudi'])"		onClick="@command('onChiudi')" 	image="/images/icon/action/16x16/close.png"/>
				</h:div>
			</h:div>

		</vlayout>

    </window>

</zk>