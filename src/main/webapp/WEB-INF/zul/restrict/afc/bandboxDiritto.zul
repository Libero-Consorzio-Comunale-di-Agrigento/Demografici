<?xml version="1.0" encoding="UTF-8"?>
<?taglib uri="http://www.zkoss.org/dsp/web/core" prefix="c"?>

<zk xmlns="http://www.zkoss.org/2005/zul"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.zkoss.org/2005/zul http://www.zkoss.org/2005/zul/zul.xsd">

    <popup>

        <vlayout>

            <hlayout sclass="navigazione" valign="middle">
                <hlayout sclass="afc-control-bar" valign="middle">

                    <paging sclass="afc-paging"/>
                </hlayout>
            </hlayout>

            <hlayout sclass="navigazione" valign="middle" hflex="1">
                <label multiline="true" sclass="grassetto"/>
            </hlayout>

            <listbox width="750px" height="250px" multiple="false">
                <listhead>
                    <customlistheader label="@load(self.dfbParent.etichette['Importo_1'])"
                                      visibilityHandler="IMPORTO_1"
                                      hflex="1"/>
                    <customlistheader label="@load(self.dfbParent.etichette['Importo_2'])"
                                      visibilityHandler="IMPORTO_2"
                                      hflex="1"/>
                    <customlistheader label="@load(self.dfbParent.etichette['Descrizione'])"
                                      hflex="4"/>
                </listhead>
                <template name="model">
                    <listitem>
                        <listcell>
                            <currencylabel value="${each.importo1}"/>
                        </listcell>
                        <listcell>
                            <currencylabel value="${each.importo2}"/>
                        </listcell>
                        <listcell label="${each.descrizione}"/>
                    </listitem>
                </template>
            </listbox>

        </vlayout>

    </popup>

</zk>