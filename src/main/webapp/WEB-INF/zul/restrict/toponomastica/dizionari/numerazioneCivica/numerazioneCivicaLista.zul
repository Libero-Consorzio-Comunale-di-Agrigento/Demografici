<?xml version="1.0" encoding="UTF-8"?>
<?taglib uri="http://www.zkoss.org/dsp/web/core" prefix="c"?>

<zk xmlns="http://www.zkoss.org/2005/zul"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.zkoss.org/2005/zul http://www.zkoss.org/2005/zul/zul.xsd">

    <window viewModel="@id('vm') @init('restrict.toponomastica.dizionari.numerazioneCivica.NumerazioneCivicaListaViewModel')"
            apply="org.zkoss.bind.BindComposer"
            border="none"
            width="100%" height="100%"
            sizable="false" closable="false">

        <vlayout hflex="1" vflex="1">

            <hlayout valign="middle">
                <controlBarLista/>
                <label value="@load(vm.formLabel)" sclass="formTitle"/>
            </hlayout>

            <groupbox closable="false">
                <grid sclass="form">
                    <rows>
                        <row>
                            <cell align="right" width="100px">
                                <label value="@load(vm.etichette['Via'])"/>
                            </cell>
                            <cell>
                                <hlayout hflex="1">
                                    <combobox model="@load(vm.listaOpzioniVia)" readonly="true" hflex="1"
                                              selectedItem="@bind(vm.viaSelezionata)"
                                              onSelect="@command('onSelectVia')">
                                        <template name="model">
                                            <comboitem label="@load(vm.getLabelOpzione(each))" value="@load(each)"/>
                                        </template>
                                    </combobox>
                                    <space hflex="2"/>
                                </hlayout>
                            </cell>
                        </row>
                    </rows>
                </grid>
            </groupbox>

            <orderByBlock/>

            <listbox model="@load(vm.lista)" selectedItem="@bind(vm.dettaglio)" nonselectableTags="" hflex="1" vflex="1"
                     emptyMessage="@load(vm.etichette['Nessun_dato_disponibile'])">
                <listhead sizable="true">
                    <listheader label="@load(vm.etichette['Via'])"            hflex="3" visible="@load(!vm.colonnaViaNascosta)" align="left"/>
                    <listheader label="@load(vm.etichette['Elemento'])"       hflex="@load(vm.colonnaViaNascosta ? '3' : '1')" align="left"/>
                    <listheader label="@load(vm.etichette['Civico_Esterno'])" hflex="1" align="center"/>
                    <listheader label="@load(vm.etichette['Civico_Interno'])" hflex="1" align="center"/>
                    <listheader label="@load(vm.etichette['Sequenza'])"       hflex="1" align="left"/>
                    <listheader label="@load(vm.etichette['Separatore'])"     hflex="1" align="left"/>
                    <listheader label="@load(vm.etichette['Visibile'])"       hflex="1" align="center"/>
                    <listheader label="@load(vm.etichette['Default'])"        hflex="1" align="center"/>
                    <listheader width="52px"/>
                </listhead>
                <template name="model" var="item">
                    <listitem onDoubleClick="@command('onModifica')">
                        <listcell label="@load(c:cat3(item.via.id, ' - ', item.via.denominazione))" visible="@load(!vm.colonnaViaNascosta)"/>
                        <listcell label="@load(item.elemento)"/>
                        <listcell>
                            <checkbox checked="@load(item.flagEsterno)" disabled="true"/>
                        </listcell>
                        <listcell>
                            <checkbox checked="@load(item.flagInterno)" disabled="true"/>
                        </listcell>
                        <listcell label="@load(item.sequenza)"/>
                        <listcell label="@load(item.separatore)"/>
                        <listcell>
                            <checkbox checked="@load(item.flagVisibile)" disabled="true"/>
                        </listcell>
                        <listcell>
                            <checkbox checked="@load(item.flagDefault)" disabled="true"/>
                        </listcell>
                        <listcell>
                            <button image="/images/icon/action/18x18/edit.png"
                                    tooltiptext="@load(vm.etichette['modifica_tooltip'])"
                                    onClick="@command('onModifica')"/>
                        </listcell>
                    </listitem>
                </template>
            </listbox>

        </vlayout>

    </window>

</zk>