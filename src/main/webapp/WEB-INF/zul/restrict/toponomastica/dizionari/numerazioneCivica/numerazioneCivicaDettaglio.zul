<?xml version="1.0" encoding="UTF-8"?>
<?taglib uri="http://www.zkoss.org/dsp/web/core" prefix="c"?>

<zk xmlns="http://www.zkoss.org/2005/zul"
    xmlns:h="http://www.w3.org/1999/xhtml"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.zkoss.org/2005/zul http://www.zkoss.org/2005/zul/zul.xsd">

    <window viewModel="@id('vm') @init('restrict.toponomastica.dizionari.numerazioneCivica.NumerazioneCivicaDettaglioViewModel')"
            apply="org.zkoss.bind.BindComposer"
            border="none"
            width="100%" height="100%"
            sizable="false" closable="false">

        <vlayout vflex="1">

            <hlayout valign="middle">
                <controlBarDettaglio/>
                <label value="@load(vm.formLabel)" sclass="formTitle"/>
            </hlayout>

            <grid sclass="form">
                <columns>
                    <column width="180px"/>
                    <column/>
                </columns>
                <rows>
                    <row visible="@load(not empty vm.dettaglio.via)">
                        <cell align="right">
                            <label value="@load(vm.etichette['Via'])"/>
                        </cell>
                        <cell>
                            <label value="@load(c:cat3(vm.dettaglio.via.id, ' - ', vm.dettaglio.via.denominazione))"/>
                        </cell>
                    </row>
                    <row>
                        <cell align="right">
                            <label value="@load(vm.etichette['Elemento'])"/>
                        </cell>
                        <cell>
                            <textbox value="@bind(vm.dettaglio.elemento)" mold="rounded" maxlength="30" cols="20"
                                     disabled="@load(not vm.tipoOperazione.insert)"/>
                        </cell>
                    </row>
                    <row>
                        <cell align="right">
                            <label value="@load(vm.etichette['Civico_Esterno'])"/>
                        </cell>
                        <cell>
                            <checkbox checked="@bind(vm.dettaglio.flagEsterno)"/>
                        </cell>
                    </row>
                    <row>
                        <cell align="right">
                            <label value="@load(vm.etichette['Civico_Interno'])"/>
                        </cell>
                        <cell>
                            <checkbox checked="@bind(vm.dettaglio.flagInterno)"/>
                        </cell>
                    </row>
                    <row>
                        <cell align="right">
                            <label value="@load(vm.etichette['Sequenza'])"/>
                        </cell>
                        <cell>
                            <intbox value="@bind(vm.dettaglio.sequenza)" mold="rounded" cols="4" maxlength="2"/>
                        </cell>
                    </row>
                    <row>
                        <cell align="right">
                            <label value="@load(vm.etichette['Separatore'])"/>
                        </cell>
                        <cell>
                            <textbox value="@bind(vm.dettaglio.separatore)" mold="rounded" maxlength="10" cols="12"/>
                        </cell>
                    </row>
                    <row>
                        <cell align="right">
                            <label value="@load(vm.etichette['Visibile'])"/>
                        </cell>
                        <cell>
                            <checkbox checked="@bind(vm.dettaglio.flagVisibile)"/>
                        </cell>
                    </row>
                    <row>
                        <cell align="right">
                            <label value="@load(vm.etichette['Default'])"/>
                        </cell>
                        <cell>
                            <checkbox checked="@bind(vm.dettaglio.flagDefault)"/>
                        </cell>
                    </row>
                </rows>
            </grid>

        </vlayout>

    </window>

</zk>