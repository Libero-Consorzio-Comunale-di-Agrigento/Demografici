<?xml version="1.0" encoding="UTF-8"?>
<?taglib uri="http://www.zkoss.org/dsp/web/core" prefix="c"?>
<?component name="templateSezioneDocumentiPvuUciProcessoVerbaleDettaglio" macroURI="/restrict/statocivile/unione/templateSezioneDocumentiPvuUciProcessoVerbaleDettaglio.zul" inline="true"?>
<?component name="templateRowDatiProvenienza" macroURI="/restrict/statocivile/templateRowDatiProvenienza.zul" inline="true"?>

<zk xmlns="http://www.zkoss.org/2005/zul"
	xmlns:h="http://www.w3.org/1999/xhtml"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul http://www.zkoss.org/2005/zul/zul.xsd">

		<groupbox mold="3d" hflex="1" open="false" visible="@load(not empty vm.dettaglio.natura)">
			<caption sclass="mainCaption">
				<div>
					<updownbutton onClick="@command(self.openClose())" sclass="captionButton"/>
					<label value="@load(vm.etichette['SEZIONE_REDAZIONE'])" sclass="captionLabel"/>
				</div>
			</caption>

			<!-- AUTORITA GIUDIZIARIA-->
			<zk if="${vm.dettaglio.isAutoritaGiudiziaria()}">
                <groupbox closable="false">
                    <caption label="@load(vm.etichette['Provenienza'])"/>
                    <grid sclass="form">
                        <rows>
                            <templateRowDatiProvenienza/>
                        </rows>
                    </grid>
                </groupbox>

				<groupbox closable="false" open="@load(vm.dettaglio.isAutoritaGiudiziaria())">
					<caption label="@load(vm.etichette['Dati_Tribunale'])" visible="@load(vm.dettaglio.isAutoritaGiudiziaria())"/>
					<grid sclass="form">
						<rows>
							<row>
								<cell align="right" width="160px">
									<label value="@load(vm.etichette['Autorizzazione_tribunale_di'])"/>
								</cell>
								<cell colspan="3">
									<hlayout valign="middle" hflex="1">
										<textbox hflex="1" value="@bind(vm.datiProvenienza.tribunaleSentenza)"
												 disabled="@load(not vm.dettaglio.isAutoritaGiudiziaria())"/>
										<button image="/images/icon/action/16x16/cancel.png"
												tooltiptext="@load(vm.etichette['Cancella'])" onClick="@command('onCancellaCampoProvenienza')"
												disabled="@load(not vm.dettaglio.isAutoritaGiudiziaria())">
											<custom-attributes proprieta="tribunaleSentenza"/>
										</button>
									</hlayout>
								</cell>
								<cell align="right">
									<label value="@load(vm.etichette['In_data'])"/>
								</cell>
								<cell>
									<hlayout valign="middle" hflex="1">
										<datebox value="@bind(vm.datiProvenienza.dataSentenza)" width="100px" format="dd/MM/yyyy"
												 disabled="@load(not vm.dettaglio.isAutoritaGiudiziaria())"/>
										<button image="/images/icon/action/16x16/cancel.png"
												disabled="@load(not vm.dettaglio.isAutoritaGiudiziaria())"
												tooltiptext="@load(vm.etichette['Cancella'])" onClick="@command('onCancellaCampoProvenienza')">
											<custom-attributes proprieta="dataSentenza"/>
										</button>
									</hlayout>
								</cell>
							</row>
						</rows>
					</grid>
				</groupbox>
			</zk>

			<!-- SEZIONE REDAZIONE -->
			<groupbox closable="false">
				<caption label="@load(vm.etichette['Dati_Redazione'])"/>
				<grid sclass="form">
					<rows>
						<templateSezioneRowRedazioneDettaglio/>

						<zk if="${vm.dettaglio.isFuoriCasaComunale()}">
							<row>
								<cell align="right">
									<label value="@load(vm.etichette['Luogo'])"/>
								</cell>
								<cell colspan="5">
									<hlayout valign="middle" hflex="1">
										<textbox value="@bind(vm.datiProvenienza.luogoPvuUci)" hflex="1"
												 disabled="@load( not vm.dettaglio.isFuoriCasaComunale() )" />
										<button image="/images/icon/action/16x16/cancel.png"
												disabled="@load( not vm.dettaglio.isFuoriCasaComunale() )"
												tooltiptext="@load(vm.etichette['Cancella'])" onClick="@command('onCancellaCampoProvenienza')">
											<custom-attributes proprieta="luogoPvuUci"/>
										</button>
									</hlayout>
								</cell>
							</row>

							<row>
								<cell align="right">
									<label value="@load(vm.etichette['Impossibilitato'])"/>
								</cell>
								<cell>
									<combobox model="@load(vm.listaImpossibilitato)" readonly="true" hflex="1"
											  disabled="@load(not vm.dettaglio.isFuoriCasaComunale() )"
											  selectedItem="@bind(vm.datiProvenienza.impossibilitato) @converter('it.finmatica.zk.utils.PropertyConverter', property='value')">
										<template name="model">
											<comboitem label="@load(empty each?'- -':each.label)" value="@load(each.value)"/>
										</template>
									</combobox>
								</cell>

								<cell align="right">
									<label value="@load(vm.etichette['Certificato_del'])"/>
								</cell>
								<cell>
									<textbox value="@bind(vm.datiProvenienza.certificato)"
											 disabled="@load(not vm.dettaglio.isFuoriCasaComunale() )" hflex="1"/>
								</cell>

								<cell align="right">
									<label value="@load(vm.etichette['In_data'])"/>
								</cell>
								<cell>
									<hlayout valign="middle" hflex="1">
										<datebox value="@bind(vm.datiProvenienza.dataCertificato)" width="100px" format="dd/MM/yyyy"
												 disabled="@load(not vm.dettaglio.isFuoriCasaComunale() )"/>
										<button image="/images/icon/action/16x16/cancel.png"
												disabled="@load(not vm.dettaglio.isFuoriCasaComunale() )"
												tooltiptext="@load(vm.etichette['Cancella'])" onClick="@command('onCancellaCampoProvenienza')">
											<custom-attributes proprieta="dataCertificato"/>
										</button>
									</hlayout>
								</cell>
							</row>
						</zk>
					</rows>
				</grid>
			</groupbox>

			<templateSezioneDocumentiPvuUciProcessoVerbaleDettaglio/>

			<templateSezioneAccessoComposizioneDettaglio/>

		</groupbox>

</zk>