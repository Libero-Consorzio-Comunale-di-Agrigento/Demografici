<?xml version="1.0" encoding="UTF-8"?>
<?taglib uri="http://www.zkoss.org/dsp/web/core" prefix="c"?>
<?component name="templateSezioneContraentiUnioneCivileDettaglio" macroURI="/restrict/statocivile/unione/unione/templateSezioneContraentiUnioneCivileDettaglio.zul" inline="true"?>
<?component name="templateSezioneDatiUnioneCivileDettaglio" macroURI="/restrict/statocivile/unione/unione/templateSezioneDatiUnioneCivileDettaglio.zul" inline="true"?>
<?component name="templateSezioneTestimoniUnioneCivileDettaglio" macroURI="/restrict/statocivile/unione/unione/templateSezioneTestimoniUnioneCivileDettaglio.zul" inline="true"?>
<?component name="templateSezioneRedazioneUnioneCivileDettaglio" macroURI="/restrict/statocivile/unione/unione/templateSezioneRedazioneUnioneCivileDettaglio.zul" inline="true"?>
<?component name="templateSezioneComposizioneUnioneCivileDettaglio" macroURI="/restrict/statocivile/unione/unione/templateSezioneComposizioneUnioneCivileDettaglio.zul" inline="true"?>

<zk xmlns="http://www.zkoss.org/2005/zul"
	xmlns:h="http://www.w3.org/1999/xhtml"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul http://www.zkoss.org/2005/zul/zul.xsd">

	<window viewModel="@id('vm') @init('restrict.statocivile.unione.unione.UnioneCivilePregressoDettaglioViewModel')"
			apply="org.zkoss.bind.BindComposer"
			border="none"
			width="100%" height="100%"
			sizable="false" closable="false">

			<hlayout valign="middle">
				<controlBarDettaglio/>

				<controlBarAtto/>

				<label value="@load(vm.formLabel)" sclass="@load(vm.attoSclass)"/>

				<estremiAttoFormLabel/>
			</hlayout>

			<vlayout vflex="1" width="100%" sclass="scroll">

				<templateSezioneInformazioniNasMatDecUciCitPregressoDettaglio/>

				<templateSezioneContraentiUnioneCivileDettaglio/>

				<templateSezioneDatiUnioneCivileDettaglio/>

				<templateSezioneAttoOriginaleDettaglio/>

				<templateSezioneTestimoniUnioneCivileDettaglio/>

				<templateSezioneRedazioneUnioneCivileDettaglio/>

				<vlayout hflex="1" visible="@load(vm.composizioneTestoAttiva and (vm.statoFrammenti lt 2) and (vm.dettaglio.natura ne 'N'))">
					<templateSezioneAccessoComposizionePregressoDettaglio/>
				</vlayout>

				<vlayout hflex="1" visible="@load(vm.composizioneTestoAttiva and (vm.statoFrammenti eq 2) and (vm.dettaglio.natura ne 'N'))">
					<templateSezioneComposizioneUnioneCivileDettaglio/>
				</vlayout>

				<templateIdDomain/>

			</vlayout>

	</window>

</zk>