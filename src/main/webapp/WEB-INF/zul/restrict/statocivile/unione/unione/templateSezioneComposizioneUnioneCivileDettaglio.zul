<?xml version="1.0" encoding="UTF-8"?>
<?taglib uri="http://www.zkoss.org/dsp/web/core" prefix="c"?>
<?xel-method prefix="c" name="addFormulaUnioneCivile" class="it.finmatica.de4gsdzk.utils.FormulaUtils" signature="java.lang.Boolean addFormulaUnioneCivile(java.lang.String chiave, it.finmatica.de4gsdzk.utils.ETipoOperazione tipoOperazione, it.finmatica.de4gsdzk.statocivile.CivUnioneCivile obj, it.finmatica.de4gsdzk.statocivile.CivDocumentoPubblicazione documentoPubblicazione)"?>

<zk xmlns="http://www.zkoss.org/2005/zul"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul http://www.zkoss.org/2005/zul/zul.xsd">

		<!-- - - - - - - - - - - - - - - - - - - - - - - - COMPOSIZIONE - - - - - - - - - - - - - - - - - - - - - - - -->

		<groupbox mold="3d" hflex="1" open="true" visible="@load(vm.tipoOperazione.isUpdate())">
			<caption>
				<hlayout hflex="1" sclass="customCaption25">
					<hlayout sclass="testo-a-sx" hflex="1">
						<updownbutton onClick="@command(self.openClose())" />
						<label value="@load(vm.etichette['SEZIONE_COMPOSIZIONE'])" sclass="captionLabel"/>
					</hlayout>
					<hlayout sclass="testo-a-dx" hflex="1" style="padding-right:8px">
						<button onClick="@command('onRefreshAllFormule')"
								image="/images/icon/action/16x16/refresh.png"
								tooltiptext="@load(vm.etichette['Aggiorna_Formule'])"/>
					</hlayout>
				</hlayout>
			</caption>
			<grid sclass="form">
				<rows>
					<!-- TESTO LIBERO -->
					<row visible="@load(c:addFormulaUnioneCivile('formulaTestoLibero', vm.tipoOperazione, vm.dettaglio, vm.documentoPubblicazione))">
						<cell align="right" width="150px">
							<label value="@load(vm.etichette['Testo_Libero'])"/>
						</cell>
						<cell colspan="5">
							<hlayout hflex="1" valign="middle">
								<textbox placeholder="@load(vm.etichette['Testo_Libero_placeholder'])"
										 rows="@load(not empty vm.mapFormule.formulaTestoLibero.numeroRighe?vm.mapFormule.formulaTestoLibero.numeroRighe:5)"
										 sclass="testoAtto"
										 value="@bind(vm.mapFormule.formulaTestoLibero.testo)" hflex="1"
										 disabled="@load(not (c:addFormulaUnioneCivile('formulaTestoLibero', vm.tipoOperazione, vm.dettaglio, vm.documentoPubblicazione)) )"/>
								<hlayout sclass="testo-a-dx" width="85px">
									<button image="/images/icon/action/16x16/grid.png"
											tooltiptext="@load(vm.etichette['Seleziona_Formula'])" onClick="@command('onCaricaFormuleFrammento', chiave='formulaTestoLibero')"
											disabled="@load(not (c:addFormulaUnioneCivile('formulaTestoLibero', vm.tipoOperazione, vm.dettaglio, vm.documentoPubblicazione)) )"/>
									<button image="/images/icon/action/16x16/refresh.png"
											tooltiptext="@load(vm.etichette['Aggiorna_Formula'])" onClick="@command('onRefreshFormula', chiave='formulaTestoLibero')"
											disabled="@load(not (c:addFormulaUnioneCivile('formulaTestoLibero', vm.tipoOperazione, vm.dettaglio, vm.documentoPubblicazione)) )"/>
								</hlayout>
							</hlayout>
						</cell>
					</row>
					<!-- TESTATA TRASCRIZIONE -->
					<row visible="@load(c:addFormulaUnioneCivile('formulaTestataTrascrizione', vm.tipoOperazione, vm.dettaglio, vm.documentoPubblicazione))">
						<cell align="right">
							<label value="@load(vm.etichette['Testata_Trascrizione'])"/>
						</cell>
						<cell colspan="5">
							<hlayout hflex="1" valign="middle">
								<textbox rows="@load(not empty vm.mapFormule.formulaTestataTrascrizione.numeroRighe?vm.mapFormule.formulaTestataTrascrizione.numeroRighe:5)"
									sclass="testoAtto"
									value="@bind(vm.mapFormule.formulaTestataTrascrizione.testo)" hflex="1"
									disabled="@load(not (c:addFormulaUnioneCivile('formulaTestataTrascrizione', vm.tipoOperazione, vm.dettaglio, vm.documentoPubblicazione)) )"/>
								<hlayout sclass="testo-a-dx" width="85px">
									<button image="/images/icon/action/16x16/refresh.png"
										tooltiptext="@load(vm.etichette['Aggiorna_Formula'])" onClick="@command('onRefreshFormula', chiave='formulaTestataTrascrizione')"
										disabled="@load(not (c:addFormulaUnioneCivile('formulaTestataTrascrizione', vm.tipoOperazione, vm.dettaglio, vm.documentoPubblicazione)) )"/>
								</hlayout>
							</hlayout>
						</cell>
					</row>
					<!-- TESTATA -->
					<row visible="@load(c:addFormulaUnioneCivile('formulaTestata', vm.tipoOperazione, vm.dettaglio, vm.documentoPubblicazione))">
						<cell align="right" width="150px">
							<label value="@load(vm.etichette['Testata'])"/>
						</cell>
						<cell colspan="5">
							<hlayout hflex="1" valign="middle">
								<textbox rows="@load(not empty vm.mapFormule.formulaTestata.numeroRighe?vm.mapFormule.formulaTestata.numeroRighe:5)"
									sclass="testoAtto"
									value="@bind(vm.mapFormule.formulaTestata.testo)" hflex="1"
									disabled="@load(not (c:addFormulaUnioneCivile('formulaTestata', vm.tipoOperazione, vm.dettaglio, vm.documentoPubblicazione)) )"/>
								<hlayout sclass="testo-a-dx" width="85px">
									<button image="/images/icon/action/16x16/grid.png"
											tooltiptext="@load(vm.etichette['Seleziona_Formula'])" onClick="@command('onCaricaFormuleFrammento', chiave='formulaTestata')"
											disabled="@load(not (c:addFormulaUnioneCivile('formulaTestata', vm.tipoOperazione, vm.dettaglio, vm.documentoPubblicazione)) )"/>
									<button image="/images/icon/action/16x16/refresh.png"
											tooltiptext="@load(vm.etichette['Aggiorna_Formula'])" onClick="@command('onRefreshFormula', chiave='formulaTestata')"
											disabled="@load(not (c:addFormulaUnioneCivile('formulaTestata', vm.tipoOperazione, vm.dettaglio, vm.documentoPubblicazione)) )"/>
								</hlayout>
							</hlayout>
						</cell>
					</row>

					<!-- CONTRAENTI -->
					<row visible="@load(c:addFormulaUnioneCivile('formulaContraenti', vm.tipoOperazione, vm.dettaglio, vm.documentoPubblicazione))">
						<cell align="right">
							<label value="@load(vm.etichette['Contraenti'])"/>
						</cell>
						<cell colspan="5">
							<vlayout hflex="1">
								<hlayout hflex="1" valign="middle">
									<textbox rows="@load(not empty vm.mapFormule.formulaContraenti.numeroRighe?vm.mapFormule.formulaContraenti.numeroRighe:5)"
											 sclass="testoAtto"
											 value="@bind(vm.mapFormule.formulaContraenti.testo)" hflex="1"
											 disabled="@load(not (c:addFormulaUnioneCivile('formulaContraenti', vm.tipoOperazione, vm.dettaglio, vm.documentoPubblicazione)) )"/>
									<hlayout sclass="testo-a-dx" width="85px">
										<button image="/images/icon/action/16x16/grid.png"
												tooltiptext="@load(vm.etichette['Seleziona_Formula'])" onClick="@command('onCaricaFormuleFrammento', chiave='formulaContraenti')"
												disabled="@load(not (c:addFormulaUnioneCivile('formulaContraenti', vm.tipoOperazione, vm.dettaglio, vm.documentoPubblicazione)) )"/>
										<button image="/images/icon/action/16x16/refresh.png"
												tooltiptext="@load(vm.etichette['Aggiorna_Formula'])" onClick="@command('onRefreshFormula', chiave='formulaContraenti')"
												disabled="@load(not (c:addFormulaUnioneCivile('formulaContraenti', vm.tipoOperazione, vm.dettaglio, vm.documentoPubblicazione)) )"/>
									</hlayout>
								</hlayout>
							</vlayout>
						</cell>
					</row>

					<!-- RICHIESTA -->
					<row visible="@load(c:addFormulaUnioneCivile('formulaRichiestaFissa', vm.tipoOperazione, vm.dettaglio, vm.documentoPubblicazione))">
						<cell align="right">
							<label value="@load(vm.etichette['Richiesta'])"/>
						</cell>
						<cell colspan="5">
							<vlayout hflex="1">
								<hlayout hflex="1" valign="middle">
									<textbox rows="@load(not empty vm.mapFormule.formulaRichiestaFissa.numeroRighe?vm.mapFormule.formulaRichiestaFissa.numeroRighe:8)"
											 sclass="testoAtto"
											 value="@bind(vm.mapFormule.formulaRichiestaFissa.testo)" hflex="1"
											 disabled="@load(not (c:addFormulaUnioneCivile('formulaRichiestaFissa', vm.tipoOperazione, vm.dettaglio, vm.documentoPubblicazione)) )"/>
									<hlayout sclass="testo-a-dx" width="85px">
										<button image="/images/icon/action/16x16/refresh.png"
												tooltiptext="@load(vm.etichette['Aggiorna_Formula'])" onClick="@command('onRefreshFormula', chiave='formulaRichiestaFissa')"
												disabled="@load(not (c:addFormulaUnioneCivile('formulaRichiestaFissa', vm.tipoOperazione, vm.dettaglio, vm.documentoPubblicazione)) )"/>
									</hlayout>
								</hlayout>
							</vlayout>
						</cell>
					</row>

					<!-- TESTIMONI -->
					<row visible="@load(c:addFormulaUnioneCivile('formulaTestimoni', vm.tipoOperazione, vm.dettaglio, vm.documentoPubblicazione))">
						<cell align="right">
							<label value="@load(vm.etichette['Testimoni'])"/>
						</cell>
						<cell colspan="5">
							<vlayout hflex="1">
								<hlayout hflex="1" valign="middle">
									<textbox rows="@load(not empty vm.mapFormule.formulaTestimoni.numeroRighe?vm.mapFormule.formulaTestimoni.numeroRighe:5)"
											 sclass="testoAtto"
											 value="@bind(vm.mapFormule.formulaTestimoni.testo)" hflex="1"
											 disabled="@load(not (c:addFormulaUnioneCivile('formulaTestimoni', vm.tipoOperazione, vm.dettaglio, vm.documentoPubblicazione)) )"/>
									<hlayout sclass="testo-a-dx" width="85px">
										<button image="/images/icon/action/16x16/refresh.png"
												tooltiptext="@load(vm.etichette['Aggiorna_Formula'])" onClick="@command('onRefreshFormula', chiave='formulaTestimoni')"
												disabled="@load(not (c:addFormulaUnioneCivile('formulaTestimoni', vm.tipoOperazione, vm.dettaglio, vm.documentoPubblicazione)) )"/>
									</hlayout>
								</hlayout>
							</vlayout>
						</cell>
					</row>

					<!-- DOCUMENTI -->
					<row visible="@load(c:addFormulaUnioneCivile('formulaDocumenti', vm.tipoOperazione, vm.dettaglio, vm.documentoPubblicazione))">
						<cell align="right">
							<label value="@load(vm.etichette['Documenti'])"/>
						</cell>
						<cell colspan="5">
							<vlayout hflex="1">
								<hlayout hflex="1" valign="middle">
									<textbox rows="@load(not empty vm.mapFormule.formulaDocumenti.numeroRighe?vm.mapFormule.formulaDocumenti.numeroRighe:4)"
											 sclass="testoAtto"
											 value="@bind(vm.mapFormule.formulaDocumenti.testo)" hflex="1"
											 disabled="@load(not (c:addFormulaUnioneCivile('formulaDocumenti', vm.tipoOperazione, vm.dettaglio, vm.documentoPubblicazione)) )"/>
									<hlayout sclass="testo-a-dx" width="85px">
										<button image="/images/icon/action/16x16/grid.png"
												tooltiptext="@load(vm.etichette['Seleziona_Formula'])" onClick="@command('onCaricaFormuleFrammento', chiave='formulaDocumenti')"
												disabled="@load(not (c:addFormulaUnioneCivile('formulaDocumenti', vm.tipoOperazione, vm.dettaglio, vm.documentoPubblicazione)) )"/>
										<button image="/images/icon/action/16x16/refresh.png"
												tooltiptext="@load(vm.etichette['Aggiorna_Formula'])" onClick="@command('onRefreshFormula', chiave='formulaDocumenti')"
												disabled="@load(not (c:addFormulaUnioneCivile('formulaDocumenti', vm.tipoOperazione, vm.dettaglio, vm.documentoPubblicazione)) )"/>
									</hlayout>
								</hlayout>
							</vlayout>
						</cell>
					</row>

					<!-- IMPEDIMENTI -->
					<row visible="@load(c:addFormulaUnioneCivile('formulaAmmissioneOltreImpedimenti', vm.tipoOperazione, vm.dettaglio, vm.documentoPubblicazione))">
						<cell align="right">
							<label value="@load(vm.etichette['Impedimenti'])"/>
						</cell>
						<cell colspan="5" align="center">
							<vlayout hflex="1" spacing="10px">
								<hlayout hflex="1" valign="middle" visible="@load(c:addFormulaUnioneCivile('formulaAmmissioneOltreImpedimenti', vm.tipoOperazione, vm.dettaglio, vm.documentoPubblicazione) )">
									<textbox rows="@load(not empty vm.mapFormule.formulaAmmissioneOltreImpedimenti.numeroRighe?(vm.mapFormule.formulaAmmissioneOltreImpedimenti.numeroRighe/2):4)"
											 sclass="testoAtto"
											 value="@bind(vm.mapFormule.formulaAmmissioneOltreImpedimenti.testo)" hflex="1"
											 disabled="@load(not (c:addFormulaUnioneCivile('formulaAmmissioneOltreImpedimenti', vm.tipoOperazione, vm.dettaglio, vm.documentoPubblicazione)) )"/>
									<hlayout sclass="testo-a-dx" width="85px">
										<button image="/images/icon/action/16x16/grid.png"
												tooltiptext="@load(vm.etichette['Seleziona_Formula'])" onClick="@command('onCaricaFormuleFrammento', chiave='formulaAmmissioneOltreImpedimenti')"
												disabled="@load(not (c:addFormulaUnioneCivile('formulaAmmissioneOltreImpedimenti', vm.tipoOperazione, vm.dettaglio, vm.documentoPubblicazione)) )"/>
										<button image="/images/icon/action/16x16/refresh.png"
												tooltiptext="@load(vm.etichette['Aggiorna_Formula'])" onClick="@command('onRefreshFormula', chiave='formulaAmmissioneOltreImpedimenti')"
												disabled="@load(not (c:addFormulaUnioneCivile('formulaAmmissioneOltreImpedimenti', vm.tipoOperazione, vm.dettaglio, vm.documentoPubblicazione)) )"/>
									</hlayout>
								</hlayout>
							</vlayout>
						</cell>
					</row>

					<!-- SCELTA COGNOME -->
					<row visible="@load(c:addFormulaUnioneCivile('formulaSceltaCognome', vm.tipoOperazione, vm.dettaglio, vm.documentoPubblicazione))">
						<cell align="right">
							<label value="@load(vm.etichette['Scelta_Cognome'])"/>
						</cell>
						<cell colspan="5" align="center">
							<hlayout hflex="1" valign="middle" visible="@load(c:addFormulaUnioneCivile('formulaSceltaCognome', vm.tipoOperazione, vm.dettaglio, vm.documentoPubblicazione) )">
								<textbox rows="@load(not empty vm.mapFormule.formulaSceltaCognome.numeroRighe?vm.mapFormule.formulaSceltaCognome.numeroRighe:4)"
										 sclass="testoAtto"
										 hflex="1" value="@bind(vm.mapFormule.formulaSceltaCognome.testo)"
										 disabled="@load(not (c:addFormulaUnioneCivile('formulaSceltaCognome', vm.tipoOperazione, vm.dettaglio, vm.documentoPubblicazione)) )"/>
								<hlayout sclass="testo-a-dx" width="85px">
									<button image="/images/icon/action/16x16/grid.png"
											tooltiptext="@load(vm.etichette['Seleziona_Formula'])" onClick="@command('onCaricaFormuleFrammento', chiave='formulaSceltaCognome')"
											disabled="@load(not (c:addFormulaUnioneCivile('formulaSceltaCognome', vm.tipoOperazione, vm.dettaglio, vm.documentoPubblicazione)) )"/>
									<button image="/images/icon/action/16x16/refresh.png"
											tooltiptext="@load(vm.etichette['Aggiorna_Formula'])" onClick="@command('onRefreshFormula', chiave='formulaSceltaCognome')"
											disabled="@load(not (c:addFormulaUnioneCivile('formulaSceltaCognome', vm.tipoOperazione, vm.dettaglio, vm.documentoPubblicazione)) )"/>
								</hlayout>
							</hlayout>
						</cell>
					</row>

					<!-- REGIME PATRIMONIALE -->
					<row visible="@load(c:addFormulaUnioneCivile('formulaRegimePatrimoniale', vm.tipoOperazione, vm.dettaglio, vm.documentoPubblicazione))">
						<cell align="right">
							<label value="@load(vm.etichette['Convenzioni_Patrimoniali'])"/>
						</cell>
						<cell colspan="5" align="center">
							<hlayout hflex="1" valign="middle" visible="@load(c:addFormulaUnioneCivile('formulaRegimePatrimoniale', vm.tipoOperazione, vm.dettaglio, vm.documentoPubblicazione) )">
								<textbox rows="@load(not empty vm.mapFormule.formulaRegimePatrimoniale.numeroRighe?vm.mapFormule.formulaRegimePatrimoniale.numeroRighe:4)"
										 sclass="testoAtto"
										 hflex="1" value="@bind(vm.mapFormule.formulaRegimePatrimoniale.testo)"
										 disabled="@load(not (c:addFormulaUnioneCivile('formulaRegimePatrimoniale', vm.tipoOperazione, vm.dettaglio, vm.documentoPubblicazione)) )"/>
								<hlayout sclass="testo-a-dx" width="85px">
									<button image="/images/icon/action/16x16/grid.png"
											tooltiptext="@load(vm.etichette['Seleziona_Formula'])" onClick="@command('onCaricaFormuleFrammento', chiave='formulaRegimePatrimoniale')"
											disabled="@load(not (c:addFormulaUnioneCivile('formulaRegimePatrimoniale', vm.tipoOperazione, vm.dettaglio, vm.documentoPubblicazione)) )"/>
									<button image="/images/icon/action/16x16/refresh.png"
											tooltiptext="@load(vm.etichette['Aggiorna_Formula'])" onClick="@command('onRefreshFormula', chiave='formulaRegimePatrimoniale')"
											disabled="@load(not (c:addFormulaUnioneCivile('formulaRegimePatrimoniale', vm.tipoOperazione, vm.dettaglio, vm.documentoPubblicazione)) )"/>
								</hlayout>
							</hlayout>
						</cell>
					</row>

					<!-- CHIUSURA -->
					<row visible="@load(c:addFormulaUnioneCivile('formulaChiusura', vm.tipoOperazione, vm.dettaglio, vm.documentoPubblicazione))">
						<cell align="right">
							<label value="@load(vm.etichette['Chiusura'])"/>
						</cell>
						<cell colspan="5" align="center">
							<hlayout hflex="1" valign="middle">
								<textbox rows="@load(not empty vm.mapFormule.formulaChiusura.numeroRighe?vm.mapFormule.formulaChiusura.numeroRighe:4)"
									sclass="testoAtto"
									value="@bind(vm.mapFormule.formulaChiusura.testo)" hflex="1"
									disabled="@load(not (c:addFormulaUnioneCivile('formulaChiusura', vm.tipoOperazione, vm.dettaglio, vm.documentoPubblicazione)) )"/>
								<hlayout sclass="testo-a-dx" width="85px">
									<button image="/images/icon/action/16x16/grid.png"
										tooltiptext="@load(vm.etichette['Seleziona_Formula'])" onClick="@command('onCaricaFormuleFrammento', chiave='formulaChiusura')"
										disabled="@load(not (c:addFormulaUnioneCivile('formulaChiusura', vm.tipoOperazione, vm.dettaglio, vm.documentoPubblicazione)) )"/>
									<button image="/images/icon/action/16x16/refresh.png"
										tooltiptext="@load(vm.etichette['Aggiorna_Formula'])" onClick="@command('onRefreshFormula', chiave='formulaChiusura')"
										disabled="@load(not (c:addFormulaUnioneCivile('formulaChiusura', vm.tipoOperazione, vm.dettaglio, vm.documentoPubblicazione)) )"/>
								</hlayout>
							</hlayout>
