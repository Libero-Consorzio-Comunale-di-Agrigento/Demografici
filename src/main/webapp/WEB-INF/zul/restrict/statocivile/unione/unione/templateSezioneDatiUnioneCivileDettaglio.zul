<?xml version="1.0" encoding="UTF-8"?>
<?taglib uri="http://www.zkoss.org/dsp/web/core" prefix="c"?>
<?component name="templateRowEstremiAttoMatrimonioDivScio" macroURI="/restrict/statocivile/templateRowEstremiAttoMatrimonioDivScio.zul" inline="true"?>

<zk xmlns="http://www.zkoss.org/2005/zul"
	xmlns:h="http://www.w3.org/1999/xhtml"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul http://www.zkoss.org/2005/zul/zul.xsd">

	<!-- DATI UNIONE CIVILE -->
	<groupbox mold="3d" hflex="1" open="false">
		<caption sclass="mainCaption">
			<div>
				<updownbutton onClick="@command(self.openClose())" sclass="captionButton"/>
				<label value="@load(vm.etichette['SEZIONE_DATI_UNIONE_CIVILE'])" sclass="captionLabel"/>
			</div>
		</caption>
		<grid sclass="form">
			<rows>
				<row>
					<cell align="right" width="135px">
                        <zk if="${vm.anscOn and vm.dettaglio.isDataOraMatrimonioMandatory()}">
                            <h:span class="mandatoryLabel">*</h:span>
                        </zk>
						<label value="@load(vm.etichette['Data_Unione_Civile'])"/>
					</cell>
					<cell colspan="6">
						<hlayout valign="middle" hflex="1" spacing="9px">
							<datebox format="dd/MM/yyyy" value="@bind(vm.dettaglio.dataMatrimonio)" width="100px"/>
							<label value="@load(vm.etichette['Ore'])"/>
							<textbox value="@bind(vm.dettaglio.oraMatrimonio)" maxlength="2" width="28px"/>
							<label value="@load(vm.etichette['Minuti'])"/>
							<textbox value="@bind(vm.dettaglio.minutoMatrimonio)" maxlength="2" width="28px"/>
							<button image="/images/icon/action/16x16/cancel.png"
									tooltiptext="@load(vm.etichette['Cancella'])" onClick="@command('onCancellaCampoAtto')">
								<custom-attributes proprieta="dataMatrimonio,oraMatrimonio,minutoMatrimonio"/>
							</button>
						</hlayout>
					</cell>
					<cell align="right">
						<label value="@load(vm.etichette['Imprecisati'])"/>
					</cell>
					<cell colspan="4">
						<hlayout valign="middle" hflex="1" spacing="6px">
							<label value="@load(vm.etichette['Giorno'])"/>
							<checkbox checked="@bind(vm.dettaglio.giornoMatrimonioImprecisato)"/>
							<label value="@load(vm.etichette['Mese'])"/>
							<checkbox checked="@bind(vm.dettaglio.meseMatrimonioImprecisato)"/>
							<label value="@load(vm.etichette['Anno'])"/>
							<checkbox checked="@bind(vm.dettaglio.annoMatrimonioImprecisato)"/>
						</hlayout>
					</cell>
                </row>
                <row>
					<cell align="right">
						<h:span class="mandatoryLabel">*</h:span><label value="@load(vm.etichette['Comune_Unione_Civile'])"/>
					</cell>
					<cell colspan="6">
						<hlayout valign="middle" hflex="1">
							<bandboxComuni hflex="1"
										   value="@load(vm.dettaglio.descrizioneComuneMatrimonio)"
										   dataRiferimento="@load(vm.dettaglio.dataMatrimonio)"
										   onSelect="@command('onSelectComune', campoRiferimento='CC_MATR')"/>
							<button image="/images/icon/action/16x16/cancel.png"
									tooltiptext="@load(vm.etichette['Cancella'])" onClick="@command('onCancellaComune', campoRiferimento='CC_MATR')"
							/>
						</hlayout>
					</cell>
					<cell>
						<textbox value="@load(vm.dettaglio.siglaProvinciaMatrimonio)" hflex="1" readonly="true"/>
					</cell>
					<cell colspan="4"/>
				</row>
				<row>
					<cell align="right">
						<label value="@load(vm.etichette['Convenzioni'])"/>
					</cell>
					<cell colspan="2">
						<hlayout height="20px">
							<radiogroup model="@load(vm.listaBoolean)" onCheck="@command('onSelectConvenzioni')"
										selectedItem="@bind(vm.dettaglio.convenzioni) @converter('it.finmatica.zk.utils.PropertyConverter', property='value')">
								<template name="model">
									<radio label="@load(each.label)" value="@load(each.value)" style="padding-left:5px"/>
								</template>
							</radiogroup>
						</hlayout>
					</cell>
					<cell align="right" colspan="2">
						<label value="@load(vm.etichette['Data_Convenzioni'])"/>
					</cell>
					<cell colspan="2">
						<hlayout>
							<datebox format="dd/MM/yyyy" value="@bind(vm.dettaglio.dataConvenzioni)" width="100px"/>
							<button image="/images/icon/action/16x16/cancel.png"
									tooltiptext="@load(vm.etichette['Cancella'])" onClick="@command('onCancellaCampoAtto')">
								<custom-attributes proprieta="dataConvenzioni"/>
							</button>
						</hlayout>
					</cell>
					<cell colspan="5">
						<vlayout visible="@load(vm.dettaglio.convenzioni)">
							<radiogroup model="@load(vm.listaConvenzioni)"
										selectedItem="@bind(vm.margine.sceltaConvenzioni) @converter('it.finmatica.zk.utils.PropertyConverter', property='value')">
								<template name="model">
									<radio label="@load(each.label)" value="@load(each.value)"
										   disabled="@load(not vm.dettaglio.convenzioni)" style="padding-left:20px"/>
								</template>
							</radiogroup>
							<textbox value="@bind(vm.margine.leggeConvenzioni)" hflex="1" rows="3" visible="@load(vm.margine.sceltaConvenzioni eq 2)"
									 disabled="@load(not vm.dettaglio.convenzioni)" onChange="@command('onChangeLeggeConvenzioni')"/>
						</vlayout>
					</cell>
				</row>

				<zk if="${vm.dettaglio.isUnioneCivileConiugi()}">
					<row>
						<cell align="right">
							<label value="@load(vm.etichette['Estremi_Atto_Matrimonio'])"/>
						</cell>
						<cell colspan="11">
							<grid hflex="1">
								<rows>
									<row>
										<cell>
											<grid>
												<rows>

													<templateRowEstremiAttoMatrimonioDivScio/>

													<row visible="@load( (vm.dettaglio.natura eq 'O') and vm.dettaglio.isCodRec3() and (c:length(vm.listaAnnotazioniMatrimonio) gt 1) )">
														<cell align="right">
															<label value="@load(vm.etichette['Annotazione'])"/>
														</cell>
														<cell colspan="11">
															<hlayout valign="middle" hflex="1">
																<combobox model="@load(vm.listaAnnotazioniMatrimonio)" readonly="false" hflex="1" onSelect="@command('onSelectFormulaAnnotazione')"
																		  selectedItem="@bind(vm.datiProvenienza.formulaDfaAnnotazioneMatrimonio) @converter('it.finmatica.zk.utils.PropertyConverter', property='id')">
																	<template name="model">
																		<comboitem label="@load(empty each?'- -':each.descrizioneEstesa)" value="@load(each.id)"/>
																	</template>
																	<custom-attributes proprieta="formulaDfaAnnotazioneMatrimonio" tipoFormula="MAT"/>
																</combobox>
																<button image="/images/icon/action/16x16/cancel.png"
																		tooltiptext="@load(vm.etichette['Cancella'])" onClick="@command('onCancellaFormulaAnnotazione')">
																	<custom-attributes proprieta="formulaDfaAnnotazioneMatrimonio" tipoFormula="MAT"/>
																</button>
															</hlayout>
														</cell>
													</row>
												</rows>
											</grid>
										</cell>
										<cell width="42px">
											<button image="/images/icon/action/16x16/grid.png"
													tooltiptext="@load(vm.etichette['Recupera_Estremi_Atto_Matrimonio'])" onClick="@command('onRecuperaEstremiMatrimonioDaAttoDiMatrimonio')"/>
										</cell>
									</row>
								</rows>
							</grid>
						</cell>
					</row>
				</zk>

				<row>
					<cell align="right">
						<label value="@load(vm.etichette['Note'])"/>
					</cell>
					<cell colspan="6">
						<textbox value="@bind(vm.dettaglio.note)" hflex="1" rows="4"/>
					</cell>
					<cell align="right" colspan="1">
						<label value="@load(vm.etichette['Certificazione_atto'])" visible="@load( (vm.dettaglio.natura eq 'O') or (vm.dettaglio.natura eq 'T'))"/>
					</cell>
					<cell colspan="4">
						<hlayout height="20px">
							<radiogroup model="@load(vm.listaSiNo)"
										selectedItem="@bind(vm.dettaglio.certificabile) @converter('it.finmatica.zk.utils.PropertyConverter', property='id')"
										visible="@load( (vm.dettaglio.natura eq 'O') or (vm.dettaglio.natura eq 'T') )">
								<template name="model">
									<radio label="@load(vm.etichette[each.name()])" value="@load(each)" style="padding-left:10px"
										   disabled="@load((vm.dettaglio.natura ne 'O' and vm.dettaglio.natura ne 'T') or (vm.dettaglio.codiceRecord ne 3) )"/>
								</template>
							</radiogroup>
						</hlayout>
					</cell>
				</row>
			</rows>
		</grid>
	</groupbox>

</zk>