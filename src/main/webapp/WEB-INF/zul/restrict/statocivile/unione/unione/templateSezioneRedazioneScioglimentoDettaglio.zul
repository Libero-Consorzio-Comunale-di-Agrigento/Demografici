<?xml version="1.0" encoding="UTF-8"?>
<?taglib uri="http://www.zkoss.org/dsp/web/core" prefix="c"?>
<?component name="templateRowDicCompFirmDivScioDettaglio" macroURI="/restrict/statocivile/templateRowDicCompFirmDivScioDettaglio.zul" inline="true"?>
<?component name="templateRowAutoritaGiudiziariaDettaglio" macroURI="/restrict/statocivile/templateRowAutoritaGiudiziariaDettaglio.zul" inline="true"?>
<?component name="templateRowDatiProvenienza" macroURI="/restrict/statocivile/templateRowDatiProvenienza.zul" inline="true"?>

<zk xmlns="http://www.zkoss.org/2005/zul"
	xmlns:h="http://www.w3.org/1999/xhtml"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul http://www.zkoss.org/2005/zul/zul.xsd">

	<groupbox mold="3d" hflex="1" open="false" visible="@load(not empty vm.dettaglio.natura)">
		<caption sclass="mainCaption">
			<div>
				<updownbutton onClick="@command(self.openClose())" sclass="captionButton"/>
				<label value="@load(vm.etichette['SEZIONE_REDAZIONE'])" sclass="captionLabel"/>
			</div>
		</caption>

		<!-- SEZIONE DICHIARANTE/COMPARENTE/FIRMATARIO -->
		<zk if="${vm.anscOn}">
			<groupbox closable="false" visible="@load(vm.dettaglio.isDichDivScioVisibile() or vm.dettaglio.isCompDivScioVisibile() or vm.dettaglio.isFirmDivScioVisibile() )">
				<templateRowDicCompFirmDivScioDettaglio/>
			</groupbox>
		</zk>

        <groupbox closable="false">
            <caption label="@load(vm.etichette['Provenienza'])"/>
            <grid sclass="form">
                <rows>
                    <templateRowDatiProvenienza/>
                </rows>
            </grid>
        </groupbox>

		<!-- SEZIONE DATI REDAZIONE -->
		<groupbox closable="false">
			<caption label="@load(vm.etichette['Dati_Redazione'])"/>
			<grid sclass="form">
				<rows>
					<templateSezioneRowRedazioneDettaglio/>

					<zk if="${not vm.anscOn and (vm.dettaglio.isVolontaScioglimento() or vm.dettaglio.isUfficialeAltro())}">
						<row visible="@load(vm.dettaglio.isVolontaScioglimento() or vm.dettaglio.isTestoLibero())">
							<cell align="right">
								<label value="@load(vm.etichette['Dichiarante'])"/>
							</cell>
							<cell colspan="2">
								<combobox model="@load(vm.listaDichiarante)" readonly="true"
										  selectedItem="@bind(vm.datiProvenienza.tipoDichiarante) @converter('it.finmatica.zk.utils.PropertyConverter', property='value')">
									<template name="model">
										<comboitem label="@load(empty each?'- -':each.label)" value="@load(each.value)"/>
									</template>
								</combobox>
							</cell>
							<cell colspan="3"/>
						</row>
					</zk>

				</rows>
			</grid>
		</groupbox>

		<templateSezioneAccessoComposizioneDettaglio/>

	</groupbox>

</zk>