<?xml version="1.0" encoding="UTF-8"?>
<?taglib uri="http://www.zkoss.org/dsp/web/core" prefix="c"?>

<zk xmlns="http://www.zkoss.org/2005/zul"
	xmlns:h="http://www.w3.org/1999/xhtml"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul http://www.zkoss.org/2005/zul/zul.xsd">

	<!-- DATI PUBBLICAZIONE -->
	<groupbox mold="3d" hflex="1" open="false">
		<caption sclass="mainCaption">
			<div>
				<updownbutton onClick="@command(self.openClose())" sclass="captionButton"/>
				<label value="@load(vm.etichette['SEZIONE_DATI_PUBBLICAZIONE'])" sclass="captionLabel"/>
			</div>
		</caption>
		<groupbox closable="false">
			<caption label="@load(vm.etichette['Dati_Affissione'])"/>
			<grid sclass="form">
				<rows>
					<row>
						<cell align="right" width="150px">
							<h:span class="mandatoryLabel">*</h:span><label value="@load(vm.etichette['Comune_Unione_Civile'])"/>
						</cell>
						<cell colspan="5">
							<hlayout valign="middle" hflex="1">
								<bandboxComuni hflex="1"
											   value="@load(vm.dettaglio.descrizioneComuneMatrimonio)"
											   dataRiferimento="@load(vm.dettaglio.dataPubblicazione)"
											   onSelect="@command('onSelectComune', campoRiferimento='CC_MATR')"/>
								<button image="/images/icon/action/16x16/cancel.png"
										tooltiptext="@load(vm.etichette['Cancella'])" onClick="@command('onCancellaComune', campoRiferimento='CC_MATR')"
								/>
							</hlayout>
						</cell>
						<cell width="40px">
							<textbox value="@load(vm.dettaglio.siglaProvinciaMatrimonio)" hflex="1" readonly="true"/>
						</cell>
						<cell colspan="6"/>
					</row>
					<row>
						<cell align="right">
							<label value="@load(vm.etichette['Data_Pubblicazione'])"/>
						</cell>
						<cell colspan="3">
							<hlayout valign="middle">
								<datebox format="dd/MM/yyyy" value="@bind(vm.dettaglio.dataPubblicazione)" width="100px"/>
								<button image="/images/icon/action/16x16/cancel.png" style="padding-left:3px"
										tooltiptext="@load(vm.etichette['Cancella'])" onClick="@command('onCancellaCampoAtto')">
									<custom-attributes proprieta="dataPubblicazione"/>
								</button>
							</hlayout>
						</cell>
						<cell colspan="2" align="right">
							<label value="@load(vm.etichette['Data_Unione_Civile'])"/>
						</cell>
						<cell colspan="7">
							<hlayout valign="middle" hflex="1">
								<datebox format="dd/MM/yyyy" value="@bind(vm.dettaglio.dataUnioneCivile)" width="100px" />
								<button image="/images/icon/action/16x16/cancel.png"
										tooltiptext="@load(vm.etichette['Cancella'])" onClick="@command('onCancellaCampoAtto')">
									<custom-attributes proprieta="dataUnioneCivile"/>
								</button>
							</hlayout>
						</cell>
					</row>
				</rows>
			</grid>
		</groupbox>

	</groupbox>

</zk>