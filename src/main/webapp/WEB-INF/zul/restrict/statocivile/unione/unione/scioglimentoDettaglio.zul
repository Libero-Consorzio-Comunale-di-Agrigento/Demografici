<?xml version="1.0" encoding="UTF-8"?>
<?taglib uri="http://www.zkoss.org/dsp/web/core" prefix="c"?>
<?component name="templateSezioneTipoAccordoScioglimentoDettaglio" macroURI="/restrict/statocivile/unione/unione/templateSezioneTipoAccordoScioglimentoDettaglio.zul" inline="true"?>
<?component name="templateSezioneRichiedentiScioglimentoDettaglio" macroURI="/restrict/statocivile/unione/unione/templateSezioneRichiedentiScioglimentoDettaglio.zul" inline="true"?>
<?component name="templateSezioneDatiScioglimentoDettaglio" macroURI="/restrict/statocivile/unione/unione/templateSezioneDatiScioglimentoDettaglio.zul" inline="true"?>
<?component name="templateSezioneAvvocatiDivScioDettaglio" macroURI="/restrict/statocivile/templateSezioneAvvocatiDivScioDettaglio.zul" inline="true"?>
<?component name="templateSezioneRedazioneScioglimentoDettaglio" macroURI="/restrict/statocivile/unione/unione/templateSezioneRedazioneScioglimentoDettaglio.zul" inline="true"?>
<?component name="templateSezioneComposizioneScioglimentoDettaglio" macroURI="/restrict/statocivile/unione/unione/templateSezioneComposizioneScioglimentoDettaglio.zul" inline="true"?>

<zk xmlns="http://www.zkoss.org/2005/zul"
	xmlns:h="http://www.w3.org/1999/xhtml"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul http://www.zkoss.org/2005/zul/zul.xsd">

	<window viewModel="@id('vm') @init('restrict.statocivile.unione.unione.ScioglimentoDettaglioViewModel')"
			apply="org.zkoss.bind.BindComposer"
			border="none"
			width="100%" height="100%"
			sizable="false" closable="false">

			<hlayout valign="middle">
				<controlBarDettaglio/>

				<controlBarAtto/>

				<label value="@load(vm.formLabel)" sclass="@load(vm.attoSclass)"/>

				<estremiAttoFormLabel/>
			</hlayout>

			<vlayout vflex="1" width="100%" sclass="scroll">

				<templateSezioneInformazioniDettaglio/>

				<templateSezioneTipoAccordoScioglimentoDettaglio/>

				<templateSezioneRichiedentiScioglimentoDettaglio/>

				<templateSezioneDatiScioglimentoDettaglio/>

				<templateSezioneAvvocatiDivScioDettaglio/>

                <templateSezioneRedazioneScioglimentoDettaglio/>

				<vlayout hflex="1" visible="@load((vm.statoFrammenti eq 2) and (vm.dettaglio.natura ne 'N'))">
                    <templateSezioneComposizioneScioglimentoDettaglio/>
                </vlayout>

				<templateSezioneAnnotazioniDaAttoDettaglio/>

				<templateIdDomain/>

			</vlayout>

	</window>

</zk>