<?xml version="1.0" encoding="UTF-8"?>
<?taglib uri="http://www.zkoss.org/dsp/web/core" prefix="c"?>

<zk xmlns="http://www.zkoss.org/2005/zul"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul http://www.zkoss.org/2005/zul/zul.xsd">

	<grid hflex="1">
		<rows>
			<row>
				<cell align="right" width="90px">
					<hlayout>
						<label value="@load(vm.etichette['Numero_Atto'])"/>
					</hlayout>
				</cell>
				<cell width="80px">
					<intbox value="@bind(vm.datiProvenienza.numeroAttoRiconoscimento1)" width="75px"/>
				</cell>
				<cell align="right" width="40px">
					<label value="@load(vm.etichette['Parte'])"/>
				</cell>
				<cell width="50px">
					<textbox value="@bind(vm.datiProvenienza.parteAttoRiconoscimento1)" width="45px"/>
				</cell>
				<cell align="right" width="40px">
					<label value="@load(vm.etichette['Serie'])"/>
				</cell>
				<cell width="50px">
					<textbox value="@bind(vm.datiProvenienza.serieAttoRiconoscimento1)" width="45px" maxlength="1" style="text-transform:uppercase"/>
				</cell>
				<cell align="right" width="40px">
					<label value="@load(vm.etichette['Ufficio'])"/>
				</cell>
				<cell width="50px">
					<intbox value="@bind(vm.datiProvenienza.ufficioAttoRiconoscimento1)" width="45px"/>
				</cell>
				<cell align="right" width="45px">
					<hlayout>
						<!--<hbox visible="@load(vm.anscOn)">
							<h:span class="mandatoryLabel" style="top:0.15em;right:0px;">*</h:span>
						</hbox>-->
						<label value="@load(vm.etichette['Anno'])"/>
					</hlayout>
				</cell>
				<cell width="50px">
					<intbox value="@bind(vm.datiProvenienza.annoAttoRiconoscimento1)"
							maxlength="4" width="45px"/>
				</cell>
				<cell align="right" width="75px">
					<label value="@load(vm.etichette['Id_Atto_Ansc'])"/>
				</cell>
				<cell>
					<textbox value="@bind(vm.datiProvenienza.idAttoAnscRiconoscimento1)" hflex="1"/>
				</cell>
			</row>
			<row>
				<cell align="right">
					<label value="@load(vm.etichette['Comune_Atto'])"/>
				</cell>
				<cell colspan="8">
					<hlayout valign="middle" hflex="1">
						<bandboxComuni hflex="1"
									   value="@bind(vm.datiProvenienza.comuneAttoRiconoscimento1.descrizione)"
									   onSelect="@command('onSelectComune', campoRiferimento='CA_RIC_1')"/>
						<button image="/images/icon/action/16x16/cancel.png"
								tooltiptext="@load(vm.etichette['Cancella'])" onClick="@command('onCancellaComune', campoRiferimento='CA_RIC_1')"/>
					</hlayout>
				</cell>
				<cell>
					<textbox value="@load(vm.datiProvenienza.comuneAttoRiconoscimento1.siglaProvincia)" hflex="1" readonly="true"/>
				</cell>
				<cell align="right">
					<label value="@load(vm.etichette['Data_Atto'])"/>
				</cell>
				<cell>
					<datebox format="dd/MM/yyyy" value="@bind(vm.datiProvenienza.dataAttoRiconoscimento1)" width="95px"/>
				</cell>
			</row>
		</rows>
	</grid>

</zk>