												<textbox value="@bind(vm.testimoni.testimone4.cognome)" hflex="1" style="@load(vm.minuscole.cognomeTestimone4?'text-transform:none':'text-transform:uppercase')"
														 onChange="@command('onAggiornaCaseTestimoni')">
													<custom-attributes proprieta="cognomeTestimone4"/>
												</textbox>
												<button image="/images/icon/action/16x16/cancel.png"
														tooltiptext="@load(vm.etichette['Cancella'])" onClick="@command('onCancellaCampoTestimoni')">
