											<checkbox checked="@bind(vm.minuscole.cognomeTestimone2)" onCheck="@command('onAggiornaCaseTestimoni')">
												<custom-attributes proprieta="cognomeTestimone2"/>
											</checkbox>
										</hlayout>
									</cell>
								</row>
								<row>
									<cell align="right">
                                        <hlayout>
                                            <hbox visible="@load(vm.anscOn and vm.dettaglio.isTestimoniMandatory())">
                                                <h:span class="mandatoryLabel" style="top:0.15em;right:0px;">*</h:span>
                                            </hbox>
                                            <label value="@load(vm.etichette['Nome'])"/>
                                        </hlayout>
									</cell>
									<cell colspan="6">
										<hlayout valign="middle" hflex="1">
