									</row>
									<row>
										<cell align="right">
                                            <hlayout>
                                                <hbox visible="@load(vm.anscOn and vm.dettaglio.isTestimoniMandatory())">
                                                    <h:span class="mandatoryLabel" style="top:0.15em;right:0px;">*</h:span>
                                                </hbox>
                                                <label value="@load(vm.etichette['Comune_Residenza'])"/>
                                            </hlayout>
										</cell>
										<cell colspan="4">
											<hlayout valign="middle" hflex="1">
												<bandboxComuni hflex="1"
															   value="@load(vm.testimoni.testimone3.comuneResidenza.descrizione)"
															   onSelect="@command('onSelectComune', campoRiferimento='CR_TEST3')"/>
												<button image="/images/icon/action/16x16/cancel.png"
														tooltiptext="@load(vm.etichette['Cancella'])" onClick="@command('onCancellaComune', campoRiferimento='CR_TEST3')"
												/>
