															   value="@load(vm.testimoni.testimone4.comuneNascita.descrizione)"
															   dataRiferimento="@load(vm.testimoni.testimone4.dataNascita)"
															   onSelect="@command('onSelectComune', campoRiferimento='CN_TEST4')"/>
												<button image="/images/icon/action/16x16/cancel.png"
														tooltiptext="@load(vm.etichette['Cancella'])" onClick="@command('onCancellaComune', campoRiferimento='CN_TEST4')"
												/>
											</hlayout>
