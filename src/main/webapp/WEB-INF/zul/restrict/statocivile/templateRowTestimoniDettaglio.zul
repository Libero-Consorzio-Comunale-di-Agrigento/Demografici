												<checkbox checked="@bind(vm.minuscole.nomeTestimone4)" onCheck="@command('onAggiornaCaseTestimoni')">
													<custom-attributes proprieta="nomeTestimone4"/>
												</checkbox>
											</hlayout>
										</cell>
									</row>
									<row>
										<cell align="right">
											<customLabel mandatory="true" value="@load(vm.etichette['Sesso'])"/>
										</cell>
										<cell>
											<combobox model="@load(vm.listaSesso)" readonly="true" width="100px"
													  selectedItem="@bind(vm.testimoni.testimone4.sesso) @converter('it.finmatica.zk.utils.PropertyConverter', property='id')">
												<template name="model">
													<comboitem label="@load(empty each?'- -':vm.getEtichettaEnum(each))" value="@load(each)"/>
												</template>
											</combobox>
										</cell>
										<cell align="right">
                                            <hlayout>
                                                <hbox visible="@load(vm.anscOn and vm.dettaglio.isTestimoniMandatory())">
                                                    <h:span class="mandatoryLabel" style="top:0.15em;right:0px;">*</h:span>
                                                </hbox>
                                                <label value="@load(vm.etichette['Data_Nascita'])"/>
                                            </hlayout>
										</cell>
										<cell colspan="5">
											<hlayout>
												<datebox format="dd/MM/yyyy" value="@bind(vm.testimoni.testimone4.dataNascita)" width="95px"/>
												<button image="/images/icon/action/16x16/cancel.png"
														tooltiptext="@load(vm.etichette['Cancella'])" onClick="@command('onCancellaCampoTestimoni')">
													<custom-attributes proprieta="testimone4.dataNascita"/>
												</button>
											</hlayout>
