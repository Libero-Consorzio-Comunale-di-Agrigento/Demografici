											/>
										</hlayout>
									</cell>
									<cell>
										<textbox value="@load(vm.testimoni.testimone2.comuneResidenza.siglaProvincia)" hflex="1" readonly="true"/>
									</cell>
									<cell align="right">
                                        <hlayout>
                                            <label value="@load(vm.etichette['Nazionalita'])"/>
                                        </hlayout>
									</cell>
									<cell>
										<combobox model="@load(vm.listaNazionalita)" readonly="false" hflex="1"
												  selectedItem="@bind(vm.testimoni.testimone2.nazionalita) @converter('it.finmatica.zk.utils.PropertyConverter', property='id')">
											<template name="model">
												<comboitem label="@load(empty each?'- -':each.descrizione)" tooltiptext="@load(each.descrizione)" value="@load(each)"/>
