														tooltiptext="@load(vm.etichette['Cancella'])" onClick="@command('onCancellaComune', campoRiferimento='CN_TEST3')"
												/>
											</hlayout>
										</cell>
										<cell>
											<textbox value="@load(vm.testimoni.testimone3.comuneNascita.siglaProvincia)" hflex="1" readonly="true"/>
										</cell>
