<?xml version="1.0" encoding="UTF-8"?>
<?taglib uri="http://www.zkoss.org/dsp/web/core" prefix="c"?>

<zk xmlns="http://www.zkoss.org/2005/zul"
	xmlns:h="http://www.w3.org/1999/xhtml"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul http://www.zkoss.org/2005/zul/zul.xsd">

	<!-- TESTIMONI -->
	<groupbox mold="3d" hflex="1" open="false">
		<caption sclass="mainCaption">
			<div>
				<updownbutton onClick="@command(self.openClose())" sclass="captionButton"/>
				<label value="@load(vm.etichette['SEZIONE_TESTIMONI'])" sclass="captionLabel"/>
			</div>
		</caption>
		<grid sclass="form">
			<rows>
				<zk if="${vm.anscOn}">
					<row>
						<cell align="right" width="160px">
                            <hlayout>
                                <hbox visible="@load(vm.anscOn and vm.dettaglio.isTestimoniMandatory())">
                                    <h:span class="mandatoryLabel" style="top:0.15em;right:0px;">*</h:span>
                                </hbox>
                                <label value="@load(vm.etichette['Numero_testimoni'])"/>
                            </hlayout>
						</cell>
						<cell>
                            <combobox model="@load(vm.listaNumeroTestimoni)" readonly="true" width="100px"
                                      selectedItem="@bind(vm.testimoni.numeroTestimoni) @converter('it.finmatica.zk.utils.PropertyConverter', property='id')">
                                <template name="model">
									<comboitem label="@load(empty each?'- -':each)" value="@load(each)"/>
								</template>
							</combobox>
						</cell>
						<cell width="42px"/>
					</row>
				</zk>
				<!-- TESTIMONE 1 -->
				<row visible="@load(empty vm.testimoni.numeroTestimoni or vm.testimoni.numeroTestimoni gt 0)">
					<cell colspan="2">
						<groupbox closable="false">
						<caption label="@load(c:cat(vm.etichette['Testimone'], ' 1'))"/>
						<grid sclass="form">
							<rows>
								<row>
									<cell align="right" width="150px">
										<label value="@load(vm.etichette['Cognome'])"/>
									</cell>
									<cell colspan="6">
										<hlayout valign="middle" hflex="1">
											<textbox value="@bind(vm.testimoni.testimone1.cognome)" hflex="1" style="@load(vm.minuscole.cognomeTestimone1?'text-transform:none':'text-transform:uppercase')"
													 onChange="@command('onAggiornaCaseTestimoni')">
												<custom-attributes proprieta="cognomeTestimone1"/>
											</textbox>
											<button image="/images/icon/action/16x16/cancel.png"
													tooltiptext="@load(vm.etichette['Cancella'])" onClick="@command('onCancellaCampoTestimoni')">
												<custom-attributes proprieta="cognomeTestimone1"/>
											</button>
										</hlayout>
									</cell>
									<cell align="right" width="85px">
										<hlayout valign="middle" >
											<label value="@load(vm.etichette['Minuscole'])"/>
											<checkbox checked="@bind(vm.minuscole.cognomeTestimone1)" onCheck="@command('onAggiornaCaseTestimoni')">
												<custom-attributes proprieta="cognomeTestimone1"/>
											</checkbox>
										</hlayout>
									</cell>
								</row>
								<row>
									<cell align="right">
                                        <hlayout>
                                            <hbox visible="@load(vm.anscOn and vm.dettaglio.isTestimoniMandatory())">
                                                <h:span class="mandatoryLabel" style="top:0.15em;right:0px;">*</h:span>
                                            </hbox>
                                            <label value="@load(vm.etichette['Nome'])"/>
                                        </hlayout>
									</cell>
									<cell colspan="6">
										<hlayout valign="middle" hflex="1">
											<textbox value="@bind(vm.testimoni.testimone1.nome)" hflex="1" style="@load(vm.minuscole.nomeTestimone1?'text-transform:none':'text-transform:uppercase')"
													 onChange="@command('onAggiornaCaseTestimoni')">
												<custom-attributes proprieta="nomeTestimone1"/>
											</textbox>
											<button image="/images/icon/action/16x16/search.png"
													tooltiptext="@load(vm.etichette['Seleziona'])" onClick="@command('onCaricaSoggetti', tipoSoggetto='TESTIMONE_1')"
											/>
											<button image="/images/icon/action/16x16/cancel.png"
													tooltiptext="@load(vm.etichette['Cancella'])" onClick="@command('onCancellaCampoTestimoni')">
												<custom-attributes proprieta="nomeTestimone1"/>
											</button>
										</hlayout>
									</cell>
									<cell align="right">
										<hlayout valign="middle" >
											<label value="@load(vm.etichette['Minuscole'])"/>
											<checkbox checked="@bind(vm.minuscole.nomeTestimone1)" onCheck="@command('onAggiornaCaseTestimoni')">
												<custom-attributes proprieta="nomeTestimone1"/>
											</checkbox>
										</hlayout>
									</cell>
								</row>
								<row>
									<cell align="right">
										<customLabel mandatory="true" value="@load(vm.etichette['Sesso'])"/>
									</cell>
									<cell>
										<combobox model="@load(vm.listaSesso)" readonly="true" width="100px"
												  selectedItem="@bind(vm.testimoni.testimone1.sesso) @converter('it.finmatica.zk.utils.PropertyConverter', property='id')">
											<template name="model">
												<comboitem label="@load(empty each?'- -':vm.getEtichettaEnum(each))" value="@load(each)"/>
											</template>
										</combobox>
									</cell>
									<cell align="right">
                                        <hlayout>
                                            <hbox visible="@load(vm.anscOn and vm.dettaglio.isTestimoniMandatory())">
                                                <h:span class="mandatoryLabel" style="top:0.15em;right:0px;">*</h:span>
                                            </hbox>
                                            <label value="@load(vm.etichette['Data_Nascita'])"/>
                                        </hlayout>
									</cell>
									<cell colspan="5">
										<hlayout>
											<datebox format="dd/MM/yyyy" value="@bind(vm.testimoni.testimone1.dataNascita)" width="95px"/>
											<button image="/images/icon/action/16x16/cancel.png"
													tooltiptext="@load(vm.etichette['Cancella'])" onClick="@command('onCancellaCampoTestimoni')">
												<custom-attributes proprieta="testimone1.dataNascita"/>
											</button>
										</hlayout>
									</cell>
								</row>
								<row>
									<cell align="right">
                                        <hlayout>
                                            <hbox visible="@load(vm.anscOn and vm.dettaglio.isTestimoniMandatory())">
                                                <h:span class="mandatoryLabel" style="top:0.15em;right:0px;">*</h:span>
                                            </hbox>
                                            <label value="@load(vm.etichette['Comune_Nascita'])"/>
                                        </hlayout>
									</cell>
									<cell colspan="4">
										<hlayout valign="middle" hflex="1">
											<bandboxComuni hflex="1"
														   value="@load(vm.testimoni.testimone1.comuneNascita.descrizione)"
														   dataRiferimento="@load(vm.testimoni.testimone1.dataNascita)"
														   onSelect="@command('onSelectComune', campoRiferimento='CN_TEST1')"/>
											<button image="/images/icon/action/16x16/cancel.png"
													tooltiptext="@load(vm.etichette['Cancella'])" onClick="@command('onCancellaComune', campoRiferimento='CN_TEST1')"
											/>
										</hlayout>
									</cell>
									<cell>
										<textbox value="@load(vm.testimoni.testimone1.comuneNascita.siglaProvincia)" hflex="1" readonly="true"/>
									</cell>
									<cell colspan="2"/>
								</row>
								<row>
									<cell align="right">
                                        <hlayout>
                                            <hbox visible="@load(vm.anscOn and vm.dettaglio.isTestimoniMandatory())">
                                                <h:span class="mandatoryLabel" style="top:0.15em;right:0px;">*</h:span>
                                            </hbox>
                                            <label value="@load(vm.etichette['Comune_Residenza'])"/>
                                        </hlayout>
									</cell>
									<cell colspan="4">
										<hlayout valign="middle" hflex="1">
											<bandboxComuni hflex="1"
														   value="@load(vm.testimoni.testimone1.comuneResidenza.descrizione)"
														   onSelect="@command('onSelectComune', campoRiferimento='CR_TEST1')"/>
											<button image="/images/icon/action/16x16/cancel.png"
													tooltiptext="@load(vm.etichette['Cancella'])" onClick="@command('onCancellaComune', campoRiferimento='CR_TEST1')"
											/>
										</hlayout>
									</cell>
									<cell>
										<textbox value="@load(vm.testimoni.testimone1.comuneResidenza.siglaProvincia)" hflex="1" readonly="true"/>
									</cell>
									<cell align="right">
                                        <hlayout>
                                            <label value="@load(vm.etichette['Nazionalita'])"/>
                                        </hlayout>
									</cell>
									<cell>
										<combobox model="@load(vm.listaNazionalita)" readonly="false" hflex="1"
												  selectedItem="@bind(vm.testimoni.testimone1.nazionalita) @converter('it.finmatica.zk.utils.PropertyConverter', property='id')">
											<template name="model">
												<comboitem label="@load(empty each?'- -':each.descrizione)" tooltiptext="@load(each.descrizione)" value="@load(each)"/>
											</template>
										</combobox>
									</cell>
								</row>
							</rows>
						</grid>
						</groupbox>
					</cell>
					<cell width="42px">
						<button image="/images/icon/action/16x16/cancel.png"
								tooltiptext="@load(vm.etichette['Cancella'])"
								onClick="@command('onCancellaAnagrafica', tipoSoggetto='TESTIMONE_1')"/>
					</cell>
				</row>
				<!-- TESTIMONE 2 -->
				<row visible="@load(empty vm.testimoni.numeroTestimoni or vm.testimoni.numeroTestimoni gt 1)">
                    <cell colspan="2">
						<groupbox closable="false">
						<caption label="@load(c:cat(vm.etichette['Testimone'], ' 2'))"/>
						<grid sclass="form">
							<rows>
								<row>
