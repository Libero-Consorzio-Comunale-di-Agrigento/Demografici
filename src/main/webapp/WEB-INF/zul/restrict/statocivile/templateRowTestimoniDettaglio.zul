							</rows>
						</grid>
						</groupbox>
					</cell>
					<cell width="42px">
						<button image="/images/icon/action/16x16/cancel.png"
								tooltiptext="@load(vm.etichette['Cancella'])"
								onClick="@command('onCancellaAnagrafica', tipoSoggetto='TESTIMONE_2')"/>
					</cell>
				</row>
				<!-- TESTIMONE 3 -->
                <row visible="@load(vm.testimoni.numeroTestimoni gt 2)">
                    <cell colspan="2">
						<groupbox closable="false">
							<caption label="@load(c:cat(vm.etichette['Testimone'], ' 3'))"/>
							<grid sclass="form">
								<rows>
									<row>
										<cell align="right" width="150px">
											<label value="@load(vm.etichette['Cognome'])"/>
										</cell>
										<cell colspan="6">
