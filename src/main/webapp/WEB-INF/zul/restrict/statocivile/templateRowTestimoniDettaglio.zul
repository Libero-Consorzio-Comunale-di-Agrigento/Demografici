													 onChange="@command('onAggiornaCaseTestimoni')">
												<custom-attributes proprieta="nomeTestimone2"/>
											</textbox>
											<button image="/images/icon/action/16x16/search.png"
													tooltiptext="@load(vm.etichette['Seleziona'])" onClick="@command('onCaricaSoggetti', tipoSoggetto='TESTIMONE_2')"
											/>
											<button image="/images/icon/action/16x16/cancel.png"
													tooltiptext="@load(vm.etichette['Cancella'])" onClick="@command('onCancellaCampoTestimoni')">
												<custom-attributes proprieta="nomeTestimone2"/>
											</button>
										</hlayout>
									</cell>
									<cell align="right">
										<hlayout valign="middle" >
											<label value="@load(vm.etichette['Minuscole'])"/>
											<checkbox checked="@bind(vm.minuscole.nomeTestimone2)" onCheck="@command('onAggiornaCaseTestimoni')">
												<custom-attributes proprieta="nomeTestimone2"/>
											</checkbox>
										</hlayout>
									</cell>
								</row>
								<row>
									<cell align="right">
										<customLabel mandatory="true" value="@load(vm.etichette['Sesso'])"/>
									</cell>
									<cell>
										<combobox model="@load(vm.listaSesso)" readonly="true" width="100px"
												  selectedItem="@bind(vm.testimoni.testimone2.sesso) @converter('it.finmatica.zk.utils.PropertyConverter', property='id')">
											<template name="model">
												<comboitem label="@load(empty each?'- -':vm.getEtichettaEnum(each))" value="@load(each)"/>
											</template>
										</combobox>
									</cell>
									<cell align="right">
                                        <hlayout>
                                            <hbox visible="@load(vm.anscOn and vm.dettaglio.isTestimoniMandatory())">
                                                <h:span class="mandatoryLabel" style="top:0.15em;right:0px;">*</h:span>
                                            </hbox>
                                            <label value="@load(vm.etichette['Data_Nascita'])"/>
                                        </hlayout>
									</cell>
									<cell colspan="5">
										<hlayout>
											<datebox format="dd/MM/yyyy" value="@bind(vm.testimoni.testimone2.dataNascita)" width="95px"/>
											<button image="/images/icon/action/16x16/cancel.png"
													tooltiptext="@load(vm.etichette['Cancella'])" onClick="@command('onCancellaCampoTestimoni')">
												<custom-attributes proprieta="testimone2.dataNascita"/>
											</button>
										</hlayout>
									</cell>
								</row>
								<row>
									<cell align="right">
                                        <hlayout>
                                            <hbox visible="@load(vm.anscOn and vm.dettaglio.isTestimoniMandatory())">
                                                <h:span class="mandatoryLabel" style="top:0.15em;right:0px;">*</h:span>
                                            </hbox>
                                            <label value="@load(vm.etichette['Comune_Nascita'])"/>
                                        </hlayout>
									</cell>
									<cell colspan="4">
										<hlayout valign="middle" hflex="1">
											<bandboxComuni hflex="1"
														   value="@load(vm.testimoni.testimone2.comuneNascita.descrizione)"
														   dataRiferimento="@load(vm.testimoni.testimone2.dataNascita)"
														   onSelect="@command('onSelectComune', campoRiferimento='CN_TEST2')"/>
											<button image="/images/icon/action/16x16/cancel.png"
													tooltiptext="@load(vm.etichette['Cancella'])" onClick="@command('onCancellaComune', campoRiferimento='CN_TEST2')"
											/>
										</hlayout>
									</cell>
									<cell>
										<textbox value="@load(vm.testimoni.testimone2.comuneNascita.siglaProvincia)" hflex="1" readonly="true"/>
									</cell>
									<cell colspan="2"/>
								</row>
								<row>
									<cell align="right">
                                        <hlayout>
                                            <hbox visible="@load(vm.anscOn and vm.dettaglio.isTestimoniMandatory())">
                                                <h:span class="mandatoryLabel" style="top:0.15em;right:0px;">*</h:span>
                                            </hbox>
                                            <label value="@load(vm.etichette['Comune_Residenza'])"/>
                                        </hlayout>
