<?xml version="1.0" encoding="UTF-8"?>
<?taglib uri="http://www.zkoss.org/dsp/web/core" prefix="c"?>
<?xel-method prefix="c" name="addFormulaNascita" class="it.finmatica.de4gsdzk.utils.FormulaUtils" signature="java.lang.Boolean addFormulaNascita(java.lang.String chiave, it.finmatica.de4gsdzk.utils.ETipoOperazione tipoOperazione, it.finmatica.de4gsdzk.statocivile.CivNascita obj, it.finmatica.de4gsdzk.statocivile.CivDatiProvenienzaAtto datiProvenienza)"?>
<?xel-method prefix="c" name="showInfoMsg" class="it.finmatica.de4gsdzk.utils.MessaggioUtils" signature="void showInfoMsg(org.zkoss.zk.ui.Component, java.lang.String)"?>

<zk xmlns="http://www.zkoss.org/2005/zul"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul http://www.zkoss.org/2005/zul/zul.xsd">

		<!-- - - - - - - - - - - - - - - - - - - - - - - - COMPOSIZIONE - - - - - - - - - - - - - - - - - - - - - - - -->

		<groupbox mold="3d" hflex="1" open="true"
							 visible="@load(vm.tipoOperazione.isUpdate())">
			<!--<caption label="@load(vm.etichette['SEZIONE_COMPOSIZIONE'])" sclass="capimg" image="/images/de4gsdzk/16x16/down_light.png">
				<hlayout sclass="testo-a-dx" style="padding-right:8px">
					<button image="/images/icon/action/16x16/refresh.png"
							tooltiptext="@load(vm.etichette['Aggiorna_Formule'])" onClick="@command('onRefreshAllFormule')"
					/>
				</hlayout>
			</caption> -->
				<caption>
					<hlayout hflex="1" sclass="customCaption25">
						<hlayout sclass="testo-a-sx" hflex="1">
							<updownbutton onClick="@command(self.openClose())"/>
							<label value="@load(vm.etichette['SEZIONE_COMPOSIZIONE'])" sclass="captionLabel"/>
						</hlayout>
						<hlayout sclass="testo-a-dx" hflex="1" style="padding-right:8px">
							<button onClick="@command('onRefreshAllFormule')"
									image="/images/icon/action/16x16/refresh.png"
									tooltiptext="@load(vm.etichette['Aggiorna_Formule'])"/>
						</hlayout>
					</hlayout>
				</caption>
				<grid sclass="form">
					<rows>
						<!-- TESTO LIBERO -->
						<row visible="@load(c:addFormulaNascita('formulaTestoLibero', vm.tipoOperazione, vm.dettaglio, vm.datiProvenienza))">
							<cell align="right" width="150px">
								<label value="@load(vm.etichette['Testo_Libero'])"/>
							</cell>
							<cell colspan="5">
								<hlayout hflex="1" valign="middle">
									<textbox placeholder="@load(vm.etichette['Testo_Libero_placeholder'])"
											 rows="@load(not empty vm.mapFormule.formulaTestoLibero.numeroRighe?vm.mapFormule.formulaTestoLibero.numeroRighe:5)"
											 sclass="testoAtto"
											 value="@bind(vm.mapFormule.formulaTestoLibero.testo)" hflex="1"
											 disabled="@load(not (c:addFormulaNascita('formulaTestoLibero', vm.tipoOperazione, vm.dettaglio, vm.datiProvenienza)) )"/>
									<hlayout sclass="testo-a-dx" width="85px">
										<button image="/images/icon/action/16x16/grid.png"
											tooltiptext="@load(vm.etichette['Seleziona_Formula'])" onClick="@command('onCaricaFormuleFrammento', chiave='formulaTestoLibero')"
											disabled="@load(not (c:addFormulaNascita('formulaTestoLibero', vm.tipoOperazione, vm.dettaglio, vm.datiProvenienza)) )"/>
										<button image="/images/icon/action/16x16/refresh.png"
											tooltiptext="@load(vm.etichette['Aggiorna_Formula'])" onClick="@command('onRefreshFormula', chiave='formulaTestoLibero')"
											disabled="@load(not (c:addFormulaNascita('formulaTestoLibero', vm.tipoOperazione, vm.dettaglio, vm.datiProvenienza)) )"/>
									</hlayout>
								</hlayout>
							</cell>
						</row>
						<!-- TESTATA TRASCRIZIONE -->
						<row visible="@load(c:addFormulaNascita('formulaTestataTrascrizione', vm.tipoOperazione, vm.dettaglio, vm.datiProvenienza))">
							<cell align="right">
								<label value="@load(vm.etichette['Testata_Trascrizione'])"/>
							</cell>
							<cell colspan="5">
								<hlayout hflex="1" valign="middle">
									<textbox rows="@load(not empty vm.mapFormule.formulaTestataTrascrizione.numeroRighe?vm.mapFormule.formulaTestataTrascrizione.numeroRighe:5)"
										sclass="testoAtto"
										value="@bind(vm.mapFormule.formulaTestataTrascrizione.testo)" hflex="1"
										disabled="@load(not (c:addFormulaNascita('formulaTestataTrascrizione', vm.tipoOperazione, vm.dettaglio, vm.datiProvenienza)) )"/>
									<hlayout sclass="testo-a-dx" width="85px">
										<button image="/images/icon/action/16x16/refresh.png"
											tooltiptext="@load(vm.etichette['Aggiorna_Formula'])" onClick="@command('onRefreshFormula', chiave='formulaTestataTrascrizione')"
											disabled="@load(not (c:addFormulaNascita('formulaTestataTrascrizione', vm.tipoOperazione, vm.dettaglio, vm.datiProvenienza)) )"/>
									</hlayout>
								</hlayout>
							</cell>
						</row>
						<!-- TESTATA -->
						<row visible="@load(c:addFormulaNascita('formulaTestata', vm.tipoOperazione, vm.dettaglio, vm.datiProvenienza))">
							<cell align="right" width="150px">
								<!--<hlayout hflex="1" valign="middle">
									<button image="/images/icon/action/16x16/info.png"
									        onClick="@command(c:showInfoMsg(self, c:cat3(vm.etichette['Richiamo'], ': ', vm.mapFormule.formulaTestata.richiamo))"
											disabled="@load(not (c:addFormulaNascita('formulaTestata', vm.tipoOperazione, vm.dettaglio, vm.datiProvenienza)) )"/> -->
									<label value="@load(vm.etichette['Testata'])"/>
								<!--</hlayout> -->
							</cell>
							<cell colspan="5">
								<hlayout hflex="1" valign="middle">
									<textbox rows="@load(not empty vm.mapFormule.formulaTestata.numeroRighe?vm.mapFormule.formulaTestata.numeroRighe:5)"
										sclass="testoAtto"
										value="@bind(vm.mapFormule.formulaTestata.testo)" hflex="1"
										disabled="@load(not (c:addFormulaNascita('formulaTestata', vm.tipoOperazione, vm.dettaglio, vm.datiProvenienza)) )"/>
									<hlayout sclass="testo-a-dx" width="85px">
										<button image="/images/icon/action/16x16/grid.png"
												visible="@load(vm.dettaglio.isCentroNascita())"
												tooltiptext="@load(vm.etichette['Seleziona_Formula'])" onClick="@command('onCaricaFormuleFrammento', chiave='formulaTestata')"
												disabled="@load(not (c:addFormulaNascita('formulaTestata', vm.tipoOperazione, vm.dettaglio, vm.datiProvenienza)) )"/>
										<button image="/images/icon/action/16x16/refresh.png"
											tooltiptext="@load(vm.etichette['Aggiorna_Formula'])" onClick="@command('onRefreshFormula', chiave='formulaTestata')"
											disabled="@load(not (c:addFormulaNascita('formulaTestata', vm.tipoOperazione, vm.dettaglio, vm.datiProvenienza)) )"/>
									</hlayout>
								</hlayout>
							</cell>
						</row>
						<!-- DICHIARANTE -->
						<!-- piloto la visibilità sul blocco con le condizioni meno stringenti -->
						<row visible="@load(c:addFormulaNascita('formulaDichiarante', vm.tipoOperazione, vm.dettaglio, vm.datiProvenienza)?true:(c:addFormulaNascita('formulaDichiaranteFissa', vm.tipoOperazione, vm.dettaglio, vm.datiProvenienza)) )">
							<cell align="right">
								<label value="@load(vm.etichette['Dichiarante'])"/>
							</cell>
							<cell colspan="5">
								<vlayout hflex="1">
									<hlayout hflex="1" valign="middle" visible="@load(c:addFormulaNascita('formulaDichiaranteFissa', vm.tipoOperazione, vm.dettaglio, vm.datiProvenienza))">
										<textbox rows="@load(not empty vm.mapFormule.formulaDichiaranteFissa.numeroRighe?(vm.mapFormule.formulaDichiaranteFissa.numeroRighe/2):4)"
											sclass="testoAtto"
											value="@bind(vm.mapFormule.formulaDichiaranteFissa.testo)" hflex="1"
											disabled="@load(not (c:addFormulaNascita('formulaDichiaranteFissa', vm.tipoOperazione, vm.dettaglio, vm.datiProvenienza)) )"/>
										<hlayout sclass="testo-a-dx" width="85px">
											<button image="/images/icon/action/16x16/refresh.png"
												tooltiptext="@load(vm.etichette['Aggiorna_Formula'])" onClick="@command('onRefreshFormula', chiave='formulaDichiaranteFissa')"
												disabled="@load(not (c:addFormulaNascita('formulaDichiaranteFissa', vm.tipoOperazione, vm.dettaglio, vm.datiProvenienza)) )"/>
										</hlayout>
									</hlayout>
									<hlayout hflex="1" valign="middle" visible="@load(c:addFormulaNascita('formulaDichiarante', vm.tipoOperazione, vm.dettaglio, vm.datiProvenienza))">
										<textbox rows="@load(not empty vm.mapFormule.formulaDichiarante.numeroRighe?((vm.mapFormule.formulaDichiarante.numeroRighe gt 4?(vm.mapFormule.formulaDichiarante.numeroRighe/2):vm.mapFormule.formulaDichiarante.numeroRighe)):4)"
											sclass="testoAtto"
											value="@bind(vm.mapFormule.formulaDichiarante.testo)" hflex="1"
											disabled="@load(not (c:addFormulaNascita('formulaDichiarante', vm.tipoOperazione, vm.dettaglio, vm.datiProvenienza)) )"/>
										<hlayout sclass="testo-a-dx" width="85px">
											<button image="/images/icon/action/16x16/grid.png"
												tooltiptext="@load(vm.etichette['Seleziona_Formula'])" onClick="@command('onCaricaFormuleFrammento', chiave='formulaDichiarante')"
												disabled="@load(not (c:addFormulaNascita('formulaDichiarante', vm.tipoOperazione, vm.dettaglio, vm.datiProvenienza)) )"/>
											<button image="/images/icon/action/16x16/refresh.png"
												tooltiptext="@load(vm.etichette['Aggiorna_Formula'])" onClick="@command('onRefreshFormula', chiave='formulaDichiarante')"
												disabled="@load(not (c:addFormulaNascita('formulaDichiarante', vm.tipoOperazione, vm.dettaglio, vm.datiProvenienza)) )"/>
										</hlayout>
									</hlayout>
								</vlayout>
							</cell>
						</row>
						<!-- FILIAZIONE -->
						<!-- piloto la visibilità sul blocco con le condizioni meno stringenti -->
						<row visible="@load(c:addFormulaNascita('formulaFiliazioneFissa', vm.tipoOperazione, vm.dettaglio, vm.datiProvenienza))">
							<cell align="right">
								<label value="@load(vm.etichette['Filiazione'])"/>
							</cell>
							<cell colspan="5">
								<vlayout hflex="1">
									<hlayout hflex="1" valign="middle" visible="@load(c:addFormulaNascita('formulaFiliazioneFissa', vm.tipoOperazione, vm.dettaglio, vm.datiProvenienza))">
										<textbox rows="@load(not empty vm.mapFormule.formulaFiliazioneFissa.numeroRighe?(vm.mapFormule.formulaFiliazioneFissa.numeroRighe/2):4)"
											sclass="testoAtto"
											value="@bind(vm.mapFormule.formulaFiliazioneFissa.testo)" hflex="1"
											disabled="@load(not (c:addFormulaNascita('formulaFiliazioneFissa', vm.tipoOperazione, vm.dettaglio, vm.datiProvenienza)) )"/>
										<hlayout sclass="testo-a-dx" width="85px">
											<button image="/images/icon/action/16x16/grid.png"
													visible="@load(vm.dettaglio.isCentroNascita())"
													tooltiptext="@load(vm.etichette['Seleziona_Formula'])" onClick="@command('onCaricaFormuleFrammento', chiave='formulaFiliazioneFissa')"
													disabled="@load(not (c:addFormulaNascita('formulaFiliazioneFissa', vm.tipoOperazione, vm.dettaglio, vm.datiProvenienza)) )"/>
											<button image="/images/icon/action/16x16/refresh.png"
												tooltiptext="@load(vm.etichette['Aggiorna_Formula'])" onClick="@command('onRefreshFormula', chiave='formulaFiliazioneFissa')"
												disabled="@load(not (c:addFormulaNascita('formulaFiliazioneFissa', vm.tipoOperazione, vm.dettaglio, vm.datiProvenienza)) )"/>
										</hlayout>
									</hlayout>
									<hlayout hflex="1" valign="middle">
										<textbox rows="@load(not empty vm.mapFormule.formulaFiliazione.numeroRighe?((vm.mapFormule.formulaFiliazione.numeroRighe gt 4?(vm.mapFormule.formulaFiliazione.numeroRighe/2):vm.mapFormule.formulaFiliazione.numeroRighe)):4)"
											sclass="testoAtto"
											value="@bind(vm.mapFormule.formulaFiliazione.testo)" hflex="1"
											disabled="@load(not (c:addFormulaNascita('formulaFiliazione', vm.tipoOperazione, vm.dettaglio, vm.datiProvenienza)) )"/>
										<hlayout sclass="testo-a-dx" width="85px">
											<button image="/images/icon/action/16x16/grid.png"
												tooltiptext="@load(vm.etichette['Seleziona_Formula'])" onClick="@command('onCaricaFormuleFrammento', chiave='formulaFiliazione')"
												disabled="@load(not (c:addFormulaNascita('formulaFiliazione', vm.tipoOperazione, vm.dettaglio, vm.datiProvenienza)) )"/>
											<button image="/images/icon/action/16x16/refresh.png"
												tooltiptext="@load(vm.etichette['Aggiorna_Formula'])" onClick="@command('onRefreshFormula', chiave='formulaFiliazione')"
												disabled="@load(not (c:addFormulaNascita('formulaFiliazione', vm.tipoOperazione, vm.dettaglio, vm.datiProvenienza)) )"/>
										</hlayout>
									</hlayout>
								</vlayout>
							</cell>
						</row>
						<!-- PRESENTAZIONE -->
						<row visible="@load(c:addFormulaNascita('formulaPresentazione', vm.tipoOperazione, vm.dettaglio, vm.datiProvenienza))">
							<cell align="right">
								<label value="@load(vm.etichette['Presentazione'])"/>
							</cell>
							<cell colspan="5">
								<hlayout hflex="1" valign="middle">
									<textbox rows="@load(not empty vm.mapFormule.formulaPresentazione.numeroRighe?vm.mapFormule.formulaPresentazione.numeroRighe:8)"
										sclass="testoAtto"
										value="@bind(vm.mapFormule.formulaPresentazione.testo)" hflex="1"
										disabled="@load(not (c:addFormulaNascita('formulaPresentazione', vm.tipoOperazione, vm.dettaglio, vm.datiProvenienza)) )"/>
									<hlayout sclass="testo-a-dx" width="85px">
										<button image="/images/icon/action/16x16/refresh.png"
											tooltiptext="@load(vm.etichette['Aggiorna_Formula'])" onClick="@command('onRefreshFormula', chiave='formulaPresentazione')"
											disabled="@load(not (c:addFormulaNascita('formulaPresentazione', vm.tipoOperazione, vm.dettaglio, vm.datiProvenienza)) )"/>
									</hlayout>
								</hlayout>
							</cell>
						</row>
						<!-- CIRCOSTANZE PARTICOLARI -->
						<row visible="@load(c:addFormulaNascita('formulaCircostanzeParticolari', vm.tipoOperazione, vm.dettaglio, vm.datiProvenienza))">
							<cell align="right">
								<label value="@load(vm.etichette['Circostanze_Particolari'])"/>
							</cell>
							<cell colspan="5" align="center">
								<vlayout hflex="1" spacing="10px">
									<hlayout hflex="1" valign="middle" visible="@load(c:addFormulaNascita('formulaPartoPlurimo', vm.tipoOperazione, vm.dettaglio, vm.datiProvenienza) )">
										<textbox rows="@load(not empty vm.mapFormule.formulaPartoPlurimo.numeroRighe?(vm.mapFormule.formulaPartoPlurimo.numeroRighe/2):4)"
											sclass="testoAtto"
											value="@bind(vm.mapFormule.formulaPartoPlurimo.testo)" hflex="1"
											disabled="@load(not (c:addFormulaNascita('formulaPartoPlurimo', vm.tipoOperazione, vm.dettaglio, vm.datiProvenienza)) )"/>
										<hlayout sclass="testo-a-dx" width="85px">
											<button image="/images/icon/action/16x16/grid.png"
												tooltiptext="@load(vm.etichette['Seleziona_Formula'])" onClick="@command('onCaricaFormuleFrammento', chiave='formulaPartoPlurimo')"
												disabled="@load(not (c:addFormulaNascita('formulaPartoPlurimo', vm.tipoOperazione, vm.dettaglio, vm.datiProvenienza)) )"/>
											<button image="/images/icon/action/16x16/refresh.png"
												tooltiptext="@load(vm.etichette['Aggiorna_Formula'])" onClick="@command('onRefreshFormula', chiave='formulaPartoPlurimo')"
												disabled="@load(not (c:addFormulaNascita('formulaPartoPlurimo', vm.tipoOperazione, vm.dettaglio, vm.datiProvenienza)) )"/>
										</hlayout>
									</hlayout>

									<hlayout hflex="1" valign="middle" visible="@load(c:addFormulaNascita('formulaStatoNascita', vm.tipoOperazione, vm.dettaglio, vm.datiProvenienza) )">
										<textbox rows="@load(not empty vm.mapFormule.formulaStatoNascita.numeroRighe?(vm.mapFormule.formulaStatoNascita.numeroRighe/2):4)"
											sclass="testoAtto"
											value="@bind(vm.mapFormule.formulaStatoNascita.testo)" hflex="1"
											disabled="@load(not (c:addFormulaNascita('formulaStatoNascita', vm.tipoOperazione, vm.dettaglio, vm.datiProvenienza)) )"/>
										<hlayout sclass="testo-a-dx" width="85px">
											<button image="/images/icon/action/16x16/grid.png"
												tooltiptext="@load(vm.etichette['Seleziona_Formula'])" onClick="@command('onCaricaFormuleFrammento', chiave='formulaStatoNascita')"
												disabled="@load(not (c:addFormulaNascita('formulaStatoNascita', vm.tipoOperazione, vm.dettaglio, vm.datiProvenienza)) )"/>
											<button image="/images/icon/action/16x16/refresh.png"
												tooltiptext="@load(vm.etichette['Aggiorna_Formula'])" onClick="@command('onRefreshFormula', chiave='formulaStatoNascita')"
												disabled="@load(not (c:addFormulaNascita('formulaStatoNascita', vm.tipoOperazione, vm.dettaglio, vm.datiProvenienza)) )"/>
										</hlayout>
									</hlayout>

									<hlayout hflex="1" valign="middle">
										<textbox rows="@load(not empty vm.mapFormule.formulaCircostanzeParticolari.numeroRighe?vm.mapFormule.formulaCircostanzeParticolari.numeroRighe:4)"
											sclass="testoAtto"
											hflex="1" value="@bind(vm.mapFormule.formulaCircostanzeParticolari.testo)"
											disabled="@load(not (c:addFormulaNascita('formulaCircostanzeParticolari', vm.tipoOperazione, vm.dettaglio, vm.datiProvenienza)) )"/>
										<hlayout sclass="testo-a-dx" width="85px">
											<button image="/images/icon/action/16x16/grid.png"
												tooltiptext="@load(vm.etichette['Seleziona_Formula'])" onClick="@command('onCaricaFormuleFrammento', chiave='formulaCircostanzeParticolari')"
												disabled="@load(not (c:addFormulaNascita('formulaCircostanzeParticolari', vm.tipoOperazione, vm.dettaglio, vm.datiProvenienza)) )"/>
											<button image="/images/icon/action/16x16/refresh.png"
												tooltiptext="@load(vm.etichette['Aggiorna_Formula'])" onClick="@command('onRefreshFormula', chiave='formulaCircostanzeParticolari')"
												disabled="@load(not (c:addFormulaNascita('formulaCircostanzeParticolari', vm.tipoOperazione, vm.dettaglio, vm.datiProvenienza)) )"/>
										</hlayout>
									</hlayout>
								</vlayout>
							</cell>
						</row>
						<!-- CHIUSURA -->
						<row visible="@load(c:addFormulaNascita('formulaChiusura', vm.tipoOperazione, vm.dettaglio, vm.datiProvenienza))">
							<cell align="right">
								<label value="@load(vm.etichette['Chiusura'])"/>
							</cell>
							<cell colspan="5" align="center">
								<hlayout hflex="1" valign="middle">
									<textbox rows="@load(not empty vm.mapFormule.formulaChiusura.numeroRighe?vm.mapFormule.formulaChiusura.numeroRighe:4)"
										sclass="testoAtto"
										value="@bind(vm.mapFormule.formulaChiusura.testo)" hflex="1"
										disabled="@load(not (c:addFormulaNascita('formulaChiusura', vm.tipoOperazione, vm.dettaglio, vm.datiProvenienza)) )"/>
									<hlayout sclass="testo-a-dx" width="85px">
										<button image="/images/icon/action/16x16/grid.png"
											tooltiptext="@load(vm.etichette['Seleziona_Formula'])" onClick="@command('onCaricaFormuleFrammento', chiave='formulaChiusura')"
											disabled="@load(not (c:addFormulaNascita('formulaChiusura', vm.tipoOperazione, vm.dettaglio, vm.datiProvenienza)) )"/>
										<button image="/images/icon/action/16x16/refresh.png"
											tooltiptext="@load(vm.etichette['Aggiorna_Formula'])" onClick="@command('onRefreshFormula', chiave='formulaChiusura')"
											disabled="@load(not (c:addFormulaNascita('formulaChiusura', vm.tipoOperazione, vm.dettaglio, vm.datiProvenienza)) )"/>
									</hlayout>
								</hlayout>
							</cell>
						</row>
						<!-- FIRMA -->
						<row visible="@load(c:addFormulaNascita('formulaFirma', vm.tipoOperazione, vm.dettaglio, vm.datiProvenienza))">
							<cell align="right" width="150px">
								<label value="@load(vm.etichette['Firma'])"/>
							</cell>
							<cell colspan="5">
								<hlayout hflex="1" valign="middle">
									<textbox rows="@load(not empty vm.mapFormule.formulaFirma.numeroRighe?vm.mapFormule.formulaFirma.numeroRighe:5)"
											 sclass="testoAtto"
											 value="@bind(vm.mapFormule.formulaFirma.testo)" hflex="1"
											 disabled="@load(not (c:addFormulaNascita('formulaFirma', vm.tipoOperazione, vm.dettaglio, vm.datiProvenienza)) )"/>
									<hlayout sclass="testo-a-dx" width="85px">
										<button image="/images/icon/action/16x16/refresh.png"
												tooltiptext="@load(vm.etichette['Aggiorna_Formula'])" onClick="@command('onRefreshFormula', chiave='formulaFirma')"
												disabled="@load(not (c:addFormulaNascita('formulaFirma', vm.tipoOperazione, vm.dettaglio, vm.datiProvenienza)) )"/>
									</hlayout>
								</hlayout>
