<?xml version="1.0" encoding="UTF-8"?>
<?taglib uri="http://www.zkoss.org/dsp/web/core" prefix="c"?>
<?component name=bandboxLuoghiNascita extends=bandbox class=it.finmatica.de4gsdzk.zkutils.BandboxLuoghiNascita?>
<?component name="templateRowAttoNotarileDettaglio" macroURI="/restrict/statocivile/templateRowAttoNotarileDettaglio.zul" inline="true"?>
<?component name="templateRowSanitarioDettaglio" macroURI="/restrict/statocivile/templateRowSanitarioDettaglio.zul" inline="true"?>
<?component name="templateRowProcuratorePadreDettaglio" macroURI="/restrict/statocivile/templateRowProcuratorePadreDettaglio.zul" inline="true"?>
<?component name="templateRowProcuratoreMadreDettaglio" macroURI="/restrict/statocivile/templateRowProcuratoreMadreDettaglio.zul" inline="true"?>
<?component name="templateRowEstremiAttoAssenso" macroURI="/restrict/statocivile/templateRowEstremiAttoAssenso.zul" inline="true"?>
<?component name="templateRowDatiProvenienza" macroURI="/restrict/statocivile/templateRowDatiProvenienza.zul" inline="true"?>
<?component name="templateRowTrascrizioneAdozioneAutoritaDettaglio" macroURI="/restrict/statocivile/templateRowTrascrizioneAdozioneAutoritaDettaglio.zul" inline="true"?>
<?component name="templateRowEnteStranieroDettaglio" macroURI="/restrict/statocivile/templateRowEnteStranieroDettaglio.zul" inline="true"?>

<zk xmlns="http://www.zkoss.org/2005/zul"
	xmlns:h="http://www.w3.org/1999/xhtml"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul http://www.zkoss.org/2005/zul/zul.xsd">

		<groupbox mold="3d" hflex="1" open="false" visible="@load(not empty vm.dettaglio.natura)">
			<caption sclass="mainCaption">
				<div>
					<updownbutton onClick="@command(self.openClose())" sclass="captionButton"/>
					<label value="@load(vm.etichette['SEZIONE_REDAZIONE'])" sclass="captionLabel"/>
				</div>
			</caption>

			<!-- 2A -->
			<zk if="${vm.dettaglio.isSecondaA()}">
                <groupbox closable="false">
                    <caption label="@load(vm.etichette['Provenienza'])"/>
                    <grid sclass="form">
                        <rows>
                            <templateRowDatiProvenienza/>
                        </rows>
                    </grid>
                </groupbox>
			</zk>

			<!-- CENTRO NASCITA-->
			<zk if="${vm.dettaglio.isCentroNascita()}">
				<groupbox closable="false" open="@load(vm.dettaglio.isCentroNascita())">
					<caption label="@load(vm.etichette['Provenienza'])" visible="@load(vm.dettaglio.isCentroNascita() )"/>
					<grid sclass="form">
						<rows>
							<row>
								<cell align="right" width="160px">
									<h:span class="mandatoryLabel">*</h:span><label value="@load(vm.etichette['Estremi_Centro_Nascita'])"/>
								</cell>
								<cell colspan="5">
									<hlayout valign="middle" hflex="1">
										<bandboxAutorita hflex="1"
														 value="@bind(vm.datiProvenienza.autorita)"
														 tipoAtto="@load(vm.dettaglio.tipoAtto)"
														 parte="@load(vm.dettaglio.parte)"
														 serie="@load(vm.dettaglio.serie)"
														 categoria="@load(vm.dettaglio.tipoAttoDomain.categoriaDomain.codice)"
														 disabled="@load(not vm.dettaglio.isCentroNascita())"
														 onSelect="@command('onSelectAutorita')"/>
										<button image="/images/icon/action/16x16/cancel.png"
												disabled="@load(not vm.dettaglio.isCentroNascita())"
												tooltiptext="@load(vm.etichette['Cancella'])"
                                                onClick="@command('onCancellaCampoProvenienza')">
                                            <custom-attributes proprieta="autorita"/>
                                        </button>
									</hlayout>
								</cell>
							</row>
							<row>
								<cell align="right">
									<label value="@load(vm.etichette['In'])"/>
								</cell>
								<cell colspan="5">
									<hlayout valign="middle" hflex="1">
										<textbox hflex="1"
												 value="@bind(vm.datiProvenienza.comune)"
												 disabled="@load(not vm.dettaglio.isCentroNascita())"/>
										<button image="/images/icon/action/16x16/cancel.png"
												disabled="@load(not vm.dettaglio.isCentroNascita())"
												tooltiptext="@load(vm.etichette['Cancella'])" onClick="@command('onCancellaCampoProvenienza')">
											<custom-attributes proprieta="comune"/>
										</button>
									</hlayout>
								</cell>
							</row>
							<row>
								<cell align="right">
									<hlayout>
										<hbox visible="@load(vm.anscOn)">
											<h:span class="mandatoryLabel" style="top:0.15em;right:0px;">*</h:span>
										</hbox>
										<label value="@load(vm.etichette['Atto_dichiarazione_anno'])"/>
									</hlayout>
								</cell>
								<cell colspan="3" valign="middle">
									<hlayout>
										<textbox value="@bind(vm.datiProvenienza.notaRif)" maxlength="25"
												 disabled="@load(not vm.dettaglio.isCentroNascita())"/>
										<label value="/"/>
										<textbox value="@bind(vm.datiProvenienza.annoNotaRif)"
												 disabled="@load(not vm.dettaglio.isCentroNascita())"/>
										<button image="/images/icon/action/16x16/cancel.png"
												disabled="@load(not vm.dettaglio.isCentroNascita())"
												tooltiptext="@load(vm.etichette['Cancella'])" onClick="@command('onCancellaCampoProvenienza')">
											<custom-attributes proprieta="notaRif,annoNotaRif"/>
										</button>
									</hlayout>
								</cell>
								<cell align="right">
									<hlayout>
										<hbox visible="@load(vm.anscOn)">
											<h:span class="mandatoryLabel" style="top:0.15em;right:0px;">*</h:span>
										</hbox>
										<label value="@load(vm.etichette['Data_Richiesta'])"/>
									</hlayout>
								</cell>
								<cell>
									<hlayout valign="middle" hflex="1">
										<datebox value="@bind(vm.datiProvenienza.dataNotaRif)" width="100px" format="dd/MM/yyyy"
												 disabled="@load(not vm.dettaglio.isCentroNascita())"/>
										<button image="/images/icon/action/16x16/cancel.png"
												disabled="@load(not vm.dettaglio.isCentroNascita())"
												tooltiptext="@load(vm.etichette['Cancella'])" onClick="@command('onCancellaCampoProvenienza')">
											<custom-attributes proprieta="dataNotaRif"/>
										</button>
									</hlayout>
								</cell>
							</row>
							<row>
								<cell align="right">
									<h:span class="mandatoryLabel">*</h:span><label value="@load(vm.etichette['Addetto_Dichiarazione'])"/>
								</cell>
								<cell colspan="5">
									<hlayout valign="middle" hflex="1">
										<textbox hflex="1"
												 value="@bind(vm.datiProvenienza.ufficiale)"
												 disabled="@load(not vm.dettaglio.isCentroNascita())"/>
										<button image="/images/icon/action/16x16/cancel.png"
												disabled="@load(not vm.dettaglio.isCentroNascita())"
												tooltiptext="@load(vm.etichette['Cancella'])" onClick="@command('onCancellaCampoProvenienza')">
											<custom-attributes proprieta="ufficiale"/>
										</button>
									</hlayout>
								</cell>
							</row>
							<row>
								<cell align="right">
									<h:span class="mandatoryLabel">*</h:span><label value="@load(vm.etichette['Qualifica'])"/>
								</cell>
								<cell colspan="5">
									<combobox model="@load(vm.listaAddettoDichiarazione)" readonly="true"
											  disabled="@load(not vm.dettaglio.isCentroNascita())"
											  selectedItem="@bind(vm.datiProvenienza.tipoAddettoDichiarazione) @converter('it.finmatica.zk.utils.PropertyConverter', property='id')">
										<template name="model">
											<comboitem label="@load(vm.getEtichettaEnum(each))" value="@load(each)"/>
										</template>
									</combobox>
								</cell>
							</row>
							<row>
								<cell align="right">
									<customLabel mandatory="true" value="@load(vm.etichette['Data_Dichiarazione'])" />
								</cell>
								<cell>
									<datebox format="dd/MM/yyyy" value="@bind(vm.datiProvenienza.dataAttoOriginale)" width="100px"
											 disabled="@load(not vm.dettaglio.isCentroNascita())"/>
								</cell>
								<cell align="right">
									<label value="@load(vm.etichette['Ore'])" />
								</cell>
								<cell>
									<textbox value="@bind(vm.datiProvenienza.oraAttoOriginale)" width="30px" maxlength="2"
											 disabled="@load(not vm.dettaglio.isCentroNascita())"/>
								</cell>
								<cell align="right">
									<label value="@load(vm.etichette['Minuti'])"/>
								</cell>
								<cell>
									<textbox value="@bind(vm.datiProvenienza.minutoAttoOriginale)" width="30px" maxlength="2"
											 disabled="@load(not vm.dettaglio.isCentroNascita())"/>
								</cell>
							</row>
						</rows>
					</grid>
				</groupbox>
			</zk>

			<!-- TRASCRIZIONE ESTERO (PRIVATO) -->
			<templateRowTrascrizioneEsteroPrivatoDettaglio/>

			<!-- TRASCRIZIONE ESTERO (AUTORITA’) -->
			<zk if="${vm.dettaglio.isTrascrizioneEsteroDaAutorita()}">
			    <templateRowTrascrizioneEsteroAutoritaDettaglio mandatory="true"/>
			</zk>

			<zk if="${vm.dettaglio.isAdozione()}">
				<templateRowTrascrizioneAdozioneAutoritaDettaglio/>
			</zk>

			<!--OMESSA DIC. DI NASCITA-->
			<zk if="${vm.dettaglio.isOmessaDichiarazioneNascita()}">
				<templateRowEnteStranieroDettaglio/>
			</zk>

			<!-- ADOZIONE / ATTO IN BIANCO -->
			<zk if="${vm.dettaglio.isTestoLibero()}">
                <groupbox closable="false">
                    <caption label="@load(vm.etichette['Provenienza'])"/>
                    <grid sclass="form">
                        <rows>
                            <templateRowDatiProvenienza/>
                        </rows>
                    </grid>
                </groupbox>
			</zk>

			<!-- RICONOSCIMENTO PRE-NATALE -->
			<zk if="${vm.dettaglio.isRiconoscimentoPrenatale()}">
				<groupbox closable="false" open="@load(vm.dettaglio.isRiconoscimentoPrenatale())">
					<caption label="@load(vm.etichette['Dati_Dichiarazione'])" visible="@load(vm.dettaglio.isRiconoscimentoPrenatale())"/>
					<grid sclass="form">
						<rows>
							<row>
								<cell align="right" width="185px">
									<h:span class="mandatoryLabel">*</h:span><label value="@load(vm.etichette['Dichiarante'])"/>
								</cell>
								<cell width="280px">
									<combobox model="@load(vm.listaDichiaranteRic)" readonly="true" width="130px"
											  disabled="@load(not vm.dettaglio.isRiconoscimentoPrenatale())"
											  onChange="@command('onSelectDichiarante')"
											  selectedItem="@bind(vm.datiProvenienza.tipoDichiarante) @converter('it.finmatica.zk.utils.PropertyConverter', property='value')">
										<template name="model">
											<comboitem label="@load(empty each?'- -':each.label)" value="@load(each.value)"/>
										</template>
									</combobox>
								</cell>
								<cell align="right" width="170px">
									<h:span class="mandatoryLabel">*</h:span><label value="@load(vm.etichette['Comparente'])"/>
								</cell>
								<cell>
									<combobox model="@load(vm.listaComparenteRic)" readonly="true" width="130px"
											  disabled="@load(not vm.dettaglio.isRiconoscimentoPrenatale())"
											  onChange="@command('onSelectComparente')"
											  selectedItem="@bind(vm.datiProvenienza.tipoComparente) @converter('it.finmatica.zk.utils.PropertyConverter', property='value')">
										<template name="model">
											<comboitem label="@load(empty each?'- -':each.label)" value="@load(each.value)"/>
										</template>
									</combobox>
								</cell>
								<cell align="right" width="170px">
									<h:span class="mandatoryLabel">*</h:span><label value="@load(vm.etichette['Firmatario'])"/>
								</cell>
								<cell>
									<combobox model="@load(vm.listaFirmatarioRic)" readonly="true" width="130px"
											  disabled="@load(not vm.dettaglio.isRiconoscimentoPrenatale())"
											  onChange="@command('onSelectFirmatario')"
											  selectedItem="@bind(vm.datiProvenienza.tipoFirmatario) @converter('it.finmatica.zk.utils.PropertyConverter', property='value')">
										<template name="model">
											<comboitem label="@load(empty each?'- -':each.label)" value="@load(each.value)"/>
										</template>
									</combobox>
								</cell>
							</row>
							<row>
								<cell align="right">
									<h:span class="mandatoryLabel">*</h:span><label value="@load(vm.etichette['Condizioni_dichiarante'])"/>
								</cell>
								<cell colspan="1">
									<combobox hflex="1" model="@load(vm.listaTipiComprensione)" readonly="true"
											  disabled="@load(not vm.dettaglio.isRiconoscimentoPrenatale())"
											  selectedItem="@bind(vm.datiProvenienza.comprensioneDichiarante) @converter('it.finmatica.zk.utils.PropertyConverter', property='id')">
										<template name="model">
											<comboitem label="@load(empty each?'- -':each.descrizione)" value="@load(each)"/>
										</template>
									</combobox>
								</cell>
								<cell align="right">
									<hlayout>
										<hbox visible="@load(vm.datiProvenienza.comprensioneDichiarante.flagMotivazioneImpedimento)">
											<h:span class="mandatoryLabel" style="top:0.15em;right:0px;">*</h:span>
										</hbox>
										<label value="@load(vm.etichette['Motivo_Impedimento'])"
											   visible="@load(vm.datiProvenienza.comprensioneDichiarante.flagMotivazioneImpedimento)"/>
									</hlayout>
								</cell>
								<cell colspan="3">
									<hlayout valign="middle" hflex="1" visible="@load(vm.datiProvenienza.comprensioneDichiarante.flagMotivazioneImpedimento)">
										<textbox value="@bind(vm.datiProvenienza.motivoImpedimentoDichiarante)"
												 disabled="@load(not vm.dettaglio.isRiconoscimentoPrenatale())"
												 hflex="1" rows="2"/>
										<button image="/images/icon/action/16x16/cancel.png"
												tooltiptext="@load(vm.etichette['Cancella'])"
												disabled="@load(not vm.dettaglio.isRiconoscimentoPrenatale())"
												onClick="@command('onCancellaCampoProvenienza')">
											<custom-attributes proprieta="motivoImpedimentoDichiarante"/>
										</button>
									</hlayout>
								</cell>
							</row>
							<row>
								<cell align="right">
									<zk if="${vm.anscOn}">
										<h:span class="mandatoryLabel">*</h:span>
									</zk>
									<label value="@load(vm.etichette['Certificato_sanitario'])"/>
								</cell>
								<cell>
                                    <hlayout valign="middle" hflex="1">
                                        <textbox rows="2" hflex="1" value="@bind(vm.datiProvenienza.autoritaAttoOriginale)"
                                                 disabled="@load(not vm.dettaglio.isRiconoscimentoPrenatale())"/>
                                        <button image="/images/icon/action/16x16/cancel.png"
                                                tooltiptext="@load(vm.etichette['Cancella'])" onClick="@command('onCancellaCampoProvenienza')"
                                                disabled="@load(not vm.dettaglio.isRiconoscimentoPrenatale())">
                                            <custom-attributes proprieta="autoritaAttoOriginale"/>
                                        </button>
                                    </hlayout>
								</cell>
								<cell align="right">
									<zk if="${vm.anscOn}">
										<h:span class="mandatoryLabel">*</h:span>
									</zk>
									<label value="@load(vm.etichette['In_data'])"/>
								</cell>
								<cell>
									<hlayout valign="middle" hflex="1">
										<datebox format="dd/MM/yyyy" value="@bind(vm.datiProvenienza.dataAttoOriginale)" width="95px"
												 disabled="@load(not vm.dettaglio.isRiconoscimentoPrenatale())"/>
										<button image="/images/icon/action/16x16/cancel.png"
												tooltiptext="@load(vm.etichette['Cancella'])" onClick="@command('onCancellaCampoProvenienza')"
												disabled="@load(not vm.dettaglio.isRiconoscimentoPrenatale())">
											<custom-attributes proprieta="dataAttoOriginale"/>
										</button>
									</hlayout>
								</cell>
								<cell align="right">
									<zk if="${vm.anscOn}">
										<h:span class="mandatoryLabel">*</h:span>
									</zk>
									<label value="@load(vm.etichette['Concepito_da_Mesi'])"/>
								</cell>
								<cell>
									<hlayout valign="middle" hflex="1">
										<intbox value="@bind(vm.dettaglio.mesiDalConcepimento)" width="40px"
												disabled="@load(not vm.dettaglio.isRiconoscimentoPrenatale())"/>
										<button image="/images/icon/action/16x16/cancel.png"
												tooltiptext="@load(vm.etichette['Cancella'])" onClick="@command('onCancellaCampoAtto')"
												disabled="@load(not vm.dettaglio.isRiconoscimentoPrenatale())">
											<custom-attributes proprieta="mesiDalConcepimento"/>
										</button>
									</hlayout>
								</cell>
							</row>
						</rows>
					</grid>
				</groupbox>
			</zk>

			<!-- RICONOSCIMENTO POST NASCITA -->
			<zk if="${vm.dettaglio.isRiconoscimentoPostNascita()}">
				<groupbox closable="false" open="@load(vm.dettaglio.isRiconoscimentoPostNascita())">
					<caption label="@load(vm.etichette['Dati_Dichiarazione'])" visible="@load(vm.dettaglio.isRiconoscimentoPostNascita())"/>
					<grid sclass="form">
						<rows>
							<row>
								<cell align="right" width="160px">
									<h:span class="mandatoryLabel">*</h:span><label value="@load(vm.etichette['Dichiarante'])"/>
								</cell>
								<cell>
									<combobox model="@load(vm.listaDichiaranteRic)" readonly="true" width="130px"
											  disabled="@load(not vm.dettaglio.isRiconoscimentoPostNascita())"
											  onChange="@command('onSelectDichiarante')"
											  selectedItem="@bind(vm.datiProvenienza.tipoDichiarante) @converter('it.finmatica.zk.utils.PropertyConverter', property='value')">
										<template name="model">
											<comboitem label="@load(empty each?'- -':each.label)" value="@load(each.value)"/>
										</template>
									</combobox>
								</cell>

								<cell align="right">
									<h:span class="mandatoryLabel">*</h:span><label value="@load(vm.etichette['Comparente'])"/>
								</cell>
								<cell>
									<combobox model="@load(vm.listaComparenteRic)" readonly="true" width="130px"
											  disabled="@load(not vm.dettaglio.isRiconoscimentoPostNascita())"
											  onChange="@command('onSelectComparente')"
											  selectedItem="@bind(vm.datiProvenienza.tipoComparente) @converter('it.finmatica.zk.utils.PropertyConverter', property='value')">
										<template name="model">
											<comboitem label="@load(empty each?'- -':each.label)" value="@load(each.value)"/>
										</template>
									</combobox>
								</cell>

								<cell align="right">
									<h:span class="mandatoryLabel">*</h:span><label value="@load(vm.etichette['Firmatario'])"/>
								</cell>
								<cell>
									<combobox model="@load(vm.listaFirmatarioRic)" readonly="true" width="130px"
											  onChange="@command('onSelectFirmatario')"
											  disabled="@load(not vm.dettaglio.isRiconoscimentoPostNascita())"
											  selectedItem="@bind(vm.datiProvenienza.tipoFirmatario) @converter('it.finmatica.zk.utils.PropertyConverter', property='value')">
										<template name="model">
											<comboitem label="@load(empty each?'- -':each.label)" value="@load(each.value)"/>
										</template>
									</combobox>
								</cell>
							</row>

							<row>
								<cell align="right">
									<h:span class="mandatoryLabel">*</h:span><label value="@load(vm.etichette['Condizioni_dichiarante'])"/>
								</cell>
								<cell colspan="1">
									<combobox hflex="1" model="@load(vm.listaTipiComprensione)" readonly="true"
											  disabled="@load(not vm.dettaglio.isRiconoscimentoPostNascita())"
											  selectedItem="@bind(vm.datiProvenienza.comprensioneDichiarante) @converter('it.finmatica.zk.utils.PropertyConverter', property='id')">
										<template name="model">
											<comboitem label="@load(empty each?'- -':each.descrizione)" value="@load(each)"/>
										</template>
									</combobox>
								</cell>
								<cell align="right">
									<hlayout>
										<hbox visible="@load(vm.datiProvenienza.comprensioneDichiarante.flagMotivazioneImpedimento)">
											<h:span class="mandatoryLabel" style="top:0.15em;right:0px;">*</h:span>
										</hbox>
										<label value="@load(vm.etichette['Motivo_Impedimento'])"
											   visible="@load(vm.datiProvenienza.comprensioneDichiarante.flagMotivazioneImpedimento)"/>
									</hlayout>
								</cell>
								<cell colspan="3">
									<hlayout valign="middle" hflex="1" visible="@load(vm.datiProvenienza.comprensioneDichiarante.flagMotivazioneImpedimento)">
										<textbox value="@bind(vm.datiProvenienza.motivoImpedimentoDichiarante)"
												 disabled="@load(not vm.dettaglio.isRiconoscimentoPostNascita())"
												 hflex="1" rows="2"/>
										<button image="/images/icon/action/16x16/cancel.png"
												tooltiptext="@load(vm.etichette['Cancella'])"
												disabled="@load(not vm.dettaglio.isRiconoscimentoPostNascita())"
												onClick="@command('onCancellaCampoProvenienza')">
											<custom-attributes proprieta="motivoImpedimentoDichiarante"/>
										</button>
									</hlayout>
								</cell>
							</row>

							<zk if="${vm.anscOn}">
								<!--<row visible="@load( (vm.datiProvenienza.tipoDichiarante eq 'PD') or (vm.datiProvenienza.tipoDichiarante eq 'MD'))">
                                    <cell align="right">
                                        <h:span class="mandatoryLabel">*</h:span><label value="@load((vm.datiProvenienza.tipoDichiarante eq 'PD')?vm.etichette['Tipo_consenso_padre']:vm.etichette['Tipo_consenso_madre'])"/>
                                    </cell>
                                    <cell colspan="1">
                                        <combobox model="@load(vm.listaTipoConsensoRiconoscimento)" readonly="true" hflex="1"
                                                  disabled="@load(not vm.dettaglio.isRiconoscimentoPostNascita())"
                                                  selectedItem="@bind(vm.dettaglio.tipoConsensoRiconoscimento) @converter('it.finmatica.zk.utils.PropertyConverter', property='id')">
                                            <template name="model">
                                                <comboitem label="@load(empty each?'- -':vm.getEtichettaEnum(each))" value="@load(each)"/>
                                            </template>
                                        </combobox>
                                    </cell>
                                    <cell colspan="4"/>
                                </row>-->
								<row>
									<cell align="right">
										<label value="@load(vm.etichette['Scelta_cambio_cognome'])"/>
									</cell>
									<cell colspan="1">
										<combobox model="@load(vm.listaSceltaCognome)" readonly="true" hflex="1"
												  selectedItem="@bind(vm.dettaglio.tipoSceltaCognome) @converter('it.finmatica.zk.utils.PropertyConverter', property='value')">
											<template name="model">
												<comboitem label="@load(empty each?'- -':vm.getEtichettaEnum(each))" value="@load(each)"/>
											</template>
										</combobox>
									</cell>
									<cell colspan="4"/>
								</row>

								<row>
									<cell align="right">
										<label value="@load(vm.etichette['Tipo_dichiarazione_assenso'])"/>
									</cell>
									<cell colspan="1">
										<combobox model="@load(vm.listaTipoAssenso)" readonly="true" hflex="1"
												  disabled="@load(not vm.dettaglio.isRiconoscimentoPostNascita())"
												  selectedItem="@bind(vm.dettaglio.tipoAssenso) @converter('it.finmatica.zk.utils.PropertyConverter', property='id')">
											<template name="model">
												<comboitem label="@load(empty each?'- -':vm.getEtichettaEnum(each))" value="@load(each)"/>
											</template>
										</combobox>
									</cell>
									<cell colspan="4"/>
								</row>
								<row visible="@load(vm.dettaglio.tipoAssenso eq 'UF')">
									<cell align="right">
										<label value="@load(vm.etichette['Estremi_Atto_Assenso'])"/>
									</cell>
									<cell colspan="5">
										<templateRowEstremiAttoAssenso/>
									</cell>
								</row>
							</zk>
						</rows>
					</grid>
				</groupbox>
			</zk>

			<!-- CAMBIO GENERALITA’ -->
			<zk if="${vm.dettaglio.isCambioGeneralita()}">
				<groupbox closable="false" open="@load(vm.dettaglio.isCambioGeneralita())">
					<caption label="@load(vm.etichette['Provenienza'])" visible="@load(vm.dettaglio.isCambioGeneralita())"/>
					<grid sclass="form">
						<rows>
							<row>
								<cell align="right" width="160px">
									<label value="@load(vm.etichette['Da'])"/>
								</cell>
								<cell colspan="2">
									<hlayout valign="middle" hflex="1">
										<bandboxAutorita hflex="1"
														 value="@bind(vm.datiProvenienza.autorita)"
														 tipoAtto="@load(vm.dettaglio.tipoAtto)"
														 parte="@load(vm.dettaglio.parte)"
														 serie="@load(vm.dettaglio.serie)"
														 disabled="@load(not vm.dettaglio.isCambioGeneralita())"
														 onSelect="@command('onSelectAutorita')"/>
										<button image="/images/icon/action/16x16/cancel.png"
												disabled="@load(not vm.dettaglio.isCambioGeneralita())"
												tooltiptext="@load(vm.etichette['Cancella'])"
                                                onClick="@command('onCancellaCampoProvenienza')">
                                            <custom-attributes proprieta="autorita"/>
                                        </button>
									</hlayout>
								</cell>
								<cell align="right" width="90px">
									<label value="@load(vm.etichette['In'])"/>
								</cell>
								<cell colspan="2">
									<hlayout valign="middle" hflex="1">
										<textbox hflex="1"
												 value="@bind(vm.datiProvenienza.comune)"
												 disabled="@load(not vm.dettaglio.isCambioGeneralita())"/>
										<button image="/images/icon/action/16x16/cancel.png"
												disabled="@load(not vm.dettaglio.isCambioGeneralita())"
												tooltiptext="@load(vm.etichette['Cancella'])" onClick="@command('onCancellaCampoProvenienza')">
											<custom-attributes proprieta="comune"/>
										</button>
									</hlayout>
								</cell>
							</row>
							<row>
								<cell align="right">
									<label value="@load(vm.etichette['Ufficio'])"/>
								</cell>
								<cell colspan="5">
									<hlayout valign="middle" hflex="1">
										<textbox hflex="1" value="@bind(vm.datiProvenienza.frazione)"
												 disabled="@load(not vm.dettaglio.isCambioGeneralita())"/>
										<button image="/images/icon/action/16x16/cancel.png"
												disabled="@load(not vm.dettaglio.isCambioGeneralita())"
												tooltiptext="@load(vm.etichette['Cancella'])" onClick="@command('onCancellaCampoProvenienza')">
											<custom-attributes proprieta="frazione"/>
										</button>
									</hlayout>
								</cell>
							</row>
							<row>
								<cell align="right">
									<label value="@load(vm.etichette['Nota_Rif_Anno'])"/>
								</cell>
								<cell colspan="3" valign="middle">
									<hlayout>
										<textbox value="@bind(vm.datiProvenienza.notaRif)" maxlength="25"
												 disabled="@load(not vm.dettaglio.isCambioGeneralita())"/>
										<label value="/"/>
										<textbox value="@bind(vm.datiProvenienza.annoNotaRif)"
												 disabled="@load(not vm.dettaglio.isCambioGeneralita())"/>
										<button image="/images/icon/action/16x16/cancel.png"
												disabled="@load(not vm.dettaglio.isCambioGeneralita())"
												tooltiptext="@load(vm.etichette['Cancella'])" onClick="@command('onCancellaCampoProvenienza')">
											<custom-attributes proprieta="notaRif,annoNotaRif"/>
										</button>
									</hlayout>
								</cell>
								<cell align="right">
									<label value="@load(vm.etichette['In_data'])"/>
								</cell>
								<cell>
									<hlayout valign="middle" hflex="1">
										<datebox value="@bind(vm.datiProvenienza.dataNotaRif)" width="100px" format="dd/MM/yyyy"
												 disabled="@load(not vm.dettaglio.isCambioGeneralita())"/>
										<button image="/images/icon/action/16x16/cancel.png"
												disabled="@load(not vm.dettaglio.isCambioGeneralita())"
												tooltiptext="@load(vm.etichette['Cancella'])" onClick="@command('onCancellaCampoProvenienza')">
											<custom-attributes proprieta="dataNotaRif"/>
										</button>
									</hlayout>
								</cell>
							</row>
						</rows>
					</grid>
				</groupbox>
				<groupbox closable="false" open="@load(vm.dettaglio.isCambioGeneralita())">
					<caption label="@load(vm.etichette['Dati_Dichiarante'])" visible="@load(vm.dettaglio.isCambioGeneralita())"/>
					<grid sclass="form">
						<rows>
							<row>
								<cell align="right" width="160px">
									<label value="@load(vm.etichette['Dichiarante'])"/>
								</cell>
								<cell colspan="2">
									<combobox model="@load(vm.listaRichiedenteGen)" readonly="true" hflex="1"
											  disabled="@load(not vm.dettaglio.isCambioGeneralita())"
											  selectedItem="@bind(vm.datiProvenienza.tipoDichiarante) @converter('it.finmatica.zk.utils.PropertyConverter', property='value')">
										<template name="model">
											<comboitem label="@load(empty each?'- -':each.label)" value="@load(each.value)"/>
										</template>
									</combobox>
								</cell>
								<cell colspan="3"/>
							</row>
						</rows>
					</grid>
				</groupbox>
			</zk>

			<!-- SEZIONE DICHIARANTE/COMPARENTE/FIRMATARIO -->
			<groupbox closable="false" visible="@load(vm.dettaglio.isDicCompFirmNasVisibile())">
				<caption label="@load(vm.etichette['Dati_Dichiarazione'])"/>
				<grid sclass="form">
					<rows>
						<row visible="@load(vm.dettaglio.isDicCompFirmNasVisibile())">
							<cell align="right" width="160px">
								<h:span class="mandatoryLabel">*</h:span><label value="@load(vm.etichette['Dichiarante'])"/>
							</cell>
							<cell>
								<combobox model="@load(vm.listaDichiarante)" readonly="true" hflex="1"
										  onChange="@command('onSelectDichiarante')"
										  disabled="@load(not vm.dettaglio.isDicCompFirmNasVisibile() )"
										  selectedItem="@bind(vm.datiProvenienza.tipoDichiarante) @converter('it.finmatica.zk.utils.PropertyConverter', property='value')">
									<template name="model">
										<comboitem label="@load(empty each?'- -':each.label)" value="@load(each.value)"/>
									</template>
								</combobox>
							</cell>

							<cell align="right">
								<h:span class="mandatoryLabel">*</h:span><label value="@load(vm.etichette['Comparente'])"/>
							</cell>
							<cell>
								<combobox model="@load(vm.listaComparente)" readonly="true" hflex="1"
										  onChange="@command('onSelectComparente')"
										  disabled="@load(not vm.dettaglio.isDicCompFirmNasVisibile() )"
										  selectedItem="@bind(vm.datiProvenienza.tipoComparente) @converter('it.finmatica.zk.utils.PropertyConverter', property='value')">
									<template name="model">
										<comboitem label="@load(empty each?'- -':each.label)" value="@load(each.value)"/>
									</template>
								</combobox>
							</cell>

							<cell align="right" visible="@load(vm.dettaglio.tipoFiliazione eq 'C'))" width="190px">
								<customLabel mandatory="@load(vm.listaTipoConsenso.size() gt 2 )"
											 value="@load(vm.etichette['Consenso'])"
											 visible="@load(vm.dettaglio.tipoFiliazione eq 'C')"/>
							</cell>
							<cell visible="@load(vm.dettaglio.tipoFiliazione eq 'C'))">
								<combobox model="@load(vm.listaTipoConsenso)" readonly="true" hflex="1"
										  visible="@load(vm.dettaglio.tipoFiliazione eq 'C') and (c:length(vm.listaTipoConsenso) gt 1) )"
										  disabled="@load(not( (vm.dettaglio.tipoFiliazione eq 'C') and (c:length(vm.listaTipoConsenso) gt 1) ) )"
										  selectedItem="@bind(vm.dettaglio.tipoConsenso) @converter('it.finmatica.zk.utils.PropertyConverter', property='id')">
									<template name="model">
										<comboitem label="@load(empty each?'- -':vm.getEtichettaEnum(each))" value="@load(each)"/>
									</template>
								</combobox>
							</cell>

							<cell align="right" width="170px">
								<h:span class="mandatoryLabel">*</h:span><label value="@load(vm.etichette['Firmatario'])"/>
							</cell>
							<cell>
								<combobox model="@load(vm.listaFirmatario)" readonly="true" hflex="1"
										  onChange="@command('onSelectFirmatario')"
										  disabled="@load(not vm.dettaglio.isDicCompFirmNasVisibile() )"
										  selectedItem="@bind(vm.datiProvenienza.tipoFirmatario) @converter('it.finmatica.zk.utils.PropertyConverter', property='value')">
									<template name="model">
										<comboitem label="@load(empty each?'- -':each.label)" value="@load(each.value)"/>
									</template>
								</combobox>
							</cell>

							<cell colspan="2" visible="@load(vm.dettaglio.tipoFiliazione ne 'C'))"/>
						</row>

						<!-- SEZIONE DATI DICHIARANTE - COMPRENSIONE -->
						<row visible="@load(vm.dettaglio.isDicCompFirmNasVisibile())">
							<cell align="right" width="160px">
								<h:span class="mandatoryLabel">*</h:span><label value="@load(vm.etichette['Condizioni_dichiarante'])"/>
							</cell>
							<cell colspan="3">
								<combobox hflex="1" model="@load(vm.listaTipiComprensione)" readonly="true"
										  disabled="@load(not vm.dettaglio.isDicCompFirmNasVisibile())"
										  selectedItem="@bind(vm.datiProvenienza.comprensioneDichiarante) @converter('it.finmatica.zk.utils.PropertyConverter', property='id')">
									<template name="model">
										<comboitem label="@load(empty each?'- -':each.descrizione)" value="@load(each)"/>
									</template>
								</combobox>
							</cell>
							<cell align="right">
								<hlayout>
									<hbox visible="@load(vm.datiProvenienza.comprensioneDichiarante.flagMotivazioneImpedimento)">
										<h:span class="mandatoryLabel" style="top:0.15em;right:0px;">*</h:span>
									</hbox>
									<label value="@load(vm.etichette['Motivo_Impedimento'])"
										   visible="@load(vm.datiProvenienza.comprensioneDichiarante.flagMotivazioneImpedimento)"/>
								</hlayout>
							</cell>
							<cell colspan="3">
								<hlayout valign="middle" hflex="1" visible="@load(vm.datiProvenienza.comprensioneDichiarante.flagMotivazioneImpedimento)">
									<textbox value="@bind(vm.datiProvenienza.motivoImpedimentoDichiarante)"
											 disabled="@load(not vm.dettaglio.isDicCompFirmNasVisibile())"
											 hflex="1" rows="2"/>
									<button image="/images/icon/action/16x16/cancel.png"
											tooltiptext="@load(vm.etichette['Cancella'])"
											disabled="@load(not vm.dettaglio.isDicCompFirmNasVisibile())"
											onClick="@command('onCancellaCampoProvenienza')">
										<custom-attributes proprieta="motivoImpedimentoDichiarante"/>
									</button>
								</hlayout>
							</cell>
						</row>

						<!-- SOLO 1B -->
						<zk if="${vm.anscOn and vm.dettaglio.isPrimaB()}">
							<row>
								<cell align="right" width="160px">
									<h:span class="mandatoryLabel">*</h:span><label value="@load(vm.etichette['Motivo_ritardo'])"/>
								</cell>
								<cell colspan="3">
									<hlayout valign="middle" hflex="1">
										<textbox value="@bind(vm.dettaglio.motivoRitardo)"
												 disabled="@load(not vm.dettaglio.isPrimaB())"
												 hflex="1" rows="2"/>
										<button image="/images/icon/action/16x16/cancel.png"
												tooltiptext="@load(vm.etichette['Cancella'])"
												disabled="@load(not vm.dettaglio.isPrimaB())"
												onClick="@command('onCancellaCampoAtto')">
											<custom-attributes proprieta="motivoRitardo"/>
										</button>
									</hlayout>
								</cell>
								<cell align="right">
									<hlayout visible="@load(vm.datiProvenienza.isComparenteSanitario() and (vm.dettaglio.tipoFiliazione eq 'C') )">
										<hbox>
											<h:span class="mandatoryLabel" style="top:0.15em;right:0px;">*</h:span>
										</hbox>
										<label value="@load(vm.etichette['Motivo_mancato_consenso_madre'])"/>
									</hlayout>
								</cell>
								<cell colspan="3">
									<combobox model="@load(vm.listaTipoMancatoConsensoMadre)" readonly="true" hflex="1"
											  visible="@load(vm.datiProvenienza.isComparenteSanitario() and (vm.dettaglio.tipoFiliazione eq 'C') )"
											  selectedItem="@bind(vm.dettaglio.tipoMancatoConsensoMadre) @converter('it.finmatica.zk.utils.PropertyConverter', property='id')">
										<template name="model">
											<comboitem label="@load(empty each?'- -':vm.getEtichettaEnum(each))" value="@load(each)"/>
										</template>
									</combobox>
								</cell>
							</row>
						</zk>
					</rows>
				</grid>
			</groupbox>

			<!--SEZIONE INTERPRETE -->
			<zk if="${vm.anscOn}">
				<grid sclass="form" style="@load(vm.datiProvenienza.isComparenteInterprete() ? '' : 'display:none')">
					<rows visible="@load(vm.datiProvenienza.isComparenteInterprete())">
						<templateRowInterpreteDettaglio/>
					</rows>
				</grid>
			</zk>

			<!--SEZIONE OPERATORE SANITARIO -->
			<zk if="${vm.anscOn}">
				<grid sclass="form" style="@load(vm.datiProvenienza.isComparenteSanitario() ? '' : 'display:none')">
					<rows visible="@load(vm.datiProvenienza.isComparenteSanitario())">
						<templateRowSanitarioDettaglio/>
					</rows>
				</grid>
			</zk>

			<!--SEZIONE PROCURATORE PADRE -->
			<zk if="${vm.anscOn}">
				<grid sclass="form" style="@load(vm.datiProvenienza.isComparenteProcuratorePadre() ? '' : 'display:none')">
					<rows visible="@load(vm.datiProvenienza.isComparenteProcuratorePadre())">
						<templateRowProcuratorePadreDettaglio/>
					</rows>
				</grid>
			</zk>

			<!--SEZIONE PROCURATORE MADRE -->
			<zk if="${vm.anscOn}">
				<grid sclass="form" style="@load(vm.datiProvenienza.isComparenteProcuratoreMadre() ? '' : 'display:none')">
					<rows visible="@load(vm.datiProvenienza.isComparenteProcuratoreMadre())">
						<templateRowProcuratoreMadreDettaglio/>
					</rows>
				</grid>
			</zk>

			<!-- SEZIONE ATTO NOTARILE -->
			<zk if="${vm.anscOn}">
				<grid sclass="form" style="@load( (vm.dettaglio.tipoFiliazione eq 'C') and (vm.dettaglio.tipoConsenso eq 'CM' or vm.dettaglio.tipoConsenso eq 'CP') ? '' : 'display:none')">
					<rows visible="@load( (vm.dettaglio.tipoFiliazione eq 'C') and (vm.dettaglio.tipoConsenso eq 'CM' or vm.dettaglio.tipoConsenso eq 'CP') )">
						<templateRowAttoNotarileDettaglio/>
					</rows>
				</grid>
			</zk>

			<!-- SEZIONE ALTRI DATI PER ANSC -->
			<groupbox closable="false"
					  style="@load(vm.dettaglio.isPrimaA() or vm.dettaglio.isPrimaB() or vm.dettaglio.isSecondaA() or vm.dettaglio.isCentroNascita() or vm.dettaglio.isTestoLibero() or vm.dettaglio.isTipoAccertamentoVisibile() or vm.dettaglio.isOmessaDichiarazioneNascita() or vm.dettaglio.isRiconoscimentoPostNascita()? '' : 'display:none')">
                <caption label="@load(vm.etichette['Altri_Dati'])"/>
                <grid sclass="form">
                    <rows>
                        <row visible="@load(vm.dettaglio.isPrimaA() or vm.dettaglio.isPrimaB() or vm.dettaglio.isSecondaA() or vm.dettaglio.isCentroNascita() or vm.dettaglio.isTestoLibero())">
                            <cell align="right" width="160px">
								<customLabel mandatory="@load(vm.dettaglio.isSedePartoMandatory())"
											 value="@load(vm.etichette['Sede_parto'])"/>
							</cell>
                            <cell colspan="3">
                                <hlayout valign="middle" hflex="1">
                                    <textbox width="25px" value="@bind(vm.datiProvenienza.nelLuogoNascita)"
                                             tooltiptext="@load(vm.etichette['Nel'])"
                                             disabled="@load(not (vm.dettaglio.isPrimaA() or vm.dettaglio.isPrimaB() or vm.dettaglio.isSecondaA() or vm.dettaglio.isCentroNascita() or vm.dettaglio.isTestoLibero()) )"/>
                                    <bandboxLuoghiNascita hflex="1"
                                                          value="@bind(vm.datiProvenienza.luogoNascita)"
                                                          disabled="@load(not (vm.dettaglio.isPrimaA() or vm.dettaglio.isPrimaB() or vm.dettaglio.isSecondaA() or vm.dettaglio.isCentroNascita() or vm.dettaglio.isTestoLibero()) )"
                                                          onSelect="@command('onSelectLuogoNascita')"/>
                                    <button image="/images/icon/action/16x16/cancel.png"
                                            disabled="@load(not (vm.dettaglio.isPrimaA() or vm.dettaglio.isPrimaB() or vm.dettaglio.isSecondaA() or vm.dettaglio.isCentroNascita() or vm.dettaglio.isTestoLibero()) )"
                                            tooltiptext="@load(vm.etichette['Cancella'])" onClick="@command('onCancellaLuogoNascita')"
                                    />
                                </hlayout>
                            </cell>
                        </row>
                        <row visible="@load(vm.dettaglio.isTipoAccertamentoVisibile())">
                            <cell align="right">
                                <hlayout visible="@load(vm.dettaglio.isTipoAccertamentoVisibile())">
                                    <hbox>
                                        <h:span class="mandatoryLabel" style="top:0.15em;right:0px;">*</h:span>
                                    </hbox>
                                    <label value="@load(vm.etichette['Tipo_Accertamento'])"/>
                                </hlayout>
                            </cell>
                            <cell colspan="3">
                                <combobox model="@load(vm.listaTipoAccertamento)" readonly="true" width="250px"
                                          visible="@load(vm.dettaglio.isTipoAccertamentoVisibile())"
                                          disabled="@load(not vm.dettaglio.isTipoAccertamentoVisibile())"
                                          selectedItem="@bind(vm.datiProvenienza.tipoAccertamento) @converter('it.finmatica.zk.utils.PropertyConverter', property='id')">
                                    <template name="model">
                                        <comboitem label="@load(empty each?'- -':vm.getEtichettaEnum(each))" value="@load(each)"/>
                                    </template>
                                </combobox>
                            </cell>
                        </row>
					<!--<zk if="${vm.anscOn}">
                            <row>
                                <cell align="right" width="150px">
                                    <h:span class="mandatoryLabel">*</h:span><label value="@load(vm.etichette['Presentazione_documenti'])"/>
                                </cell>
                                <cell colspan="2">
                                    <combobox model="@load(vm.listaPresentazioneDocumenti)" readonly="true" width="200px"
                                              selectedItem="@bind(vm.datiProvenienza.presentazioneDocumentiAnsc) @converter('it.finmatica.zk.utils.PropertyConverter', property='id')">
                                        <template name="model">
                                            <comboitem label="@load(empty each?'- -':vm.getEtichettaEnum(each))" value="@load(each)"/>
                                        </template>
                                    </combobox>
                                </cell>
                                <cell colspan="3"/>
                            </row>
					    </zk>-->
						<row visible="@load(vm.dettaglio.isOmessaDichiarazioneNascita() or vm.dettaglio.isRiconoscimentoPostNascita())">
							<cell colspan="1" align="right">
								<label value="@load(vm.etichette['Figlio_di_ignoti'])"/>
							</cell>
							<cell colspan="8" align="left">
								<checkbox checked="@bind(vm.dettaglio.flagFiglioDiIgnoti)"/>
							</cell>
						</row>
					</rows>
        		</grid>
        	</groupbox>

			<!-- SEZIONE REDAZIONE -->
			<groupbox closable="false">
				<caption label="@load(vm.etichette['Dati_Redazione'])"/>
				<grid sclass="form">
					<rows>
						<templateSezioneRowRedazioneDettaglio/>
					</rows>
				</grid>
			</groupbox>

			<templateSezioneAccessoComposizioneDettaglio/>

		</groupbox>

</zk>