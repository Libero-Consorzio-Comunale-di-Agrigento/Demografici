<?xml version="1.0" encoding="UTF-8"?>
<?taglib uri="http://www.zkoss.org/dsp/web/core" prefix="c"?>
<?component name="templateRowMotivoRichiesta" macroURI="/restrict/statocivile/templateRowMotivoRichiesta.zul" inline="true"?>
<?component name="templateRowEstremiAttoNascita1NasMorCit" macroURI="/restrict/statocivile/templateRowEstremiAttoNascita1NasMorCit.zul" inline="true"?>

<zk xmlns="http://www.zkoss.org/2005/zul"
	xmlns:h="http://www.w3.org/1999/xhtml"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul http://www.zkoss.org/2005/zul/zul.xsd">

	<!-- DATI NASCITA -->
	<groupbox mold="3d" hflex="1" open="false">
		<!--<caption label="@load(vm.etichette['SEZIONE_DATI_NASCITA'])" sclass="capimg" image="/images/de4gsdzk/16x16/down_light.png"/>-->
		<caption sclass="mainCaption">
			<div>
				<updownbutton onClick="@command(self.openClose())" sclass="captionButton"/>
				<label value="@load(vm.etichette['SEZIONE_DATI_NASCITA'])" sclass="captionLabel"/>
			</div>
		</caption>
		<grid sclass="form">
			<rows>
				<zk if="${vm.anscOn and vm.dettaglio.isAdozione()}">
					<templateRowMotivoRichiesta colspans="1,3,1,4"/>
				</zk>
				<row>
					<cell align="right" width="150px">
						<customLabel  mandatory="@load(not (vm.dettaglio.isRiconoscimentoPrenatale()))"
									  value="@load(vm.etichette['Cognome'])"/>
					</cell>
					<cell colspan="5">
						<hlayout valign="middle" hflex="1">
							<textbox value="@bind(vm.dettaglio.cognome)" hflex="1" onChange="@command('onAggiornaCase')"
									 style="@load(vm.minuscole.cognome?'text-transform:none':'text-transform:uppercase')">
								<custom-attributes proprieta="cognome"/>
							</textbox>
							<button image="/images/icon/action/16x16/cancel.png"
									tooltiptext="@load(vm.etichette['Cancella'])" onClick="@command('onCancellaCampoAtto')">
								<custom-attributes proprieta="cognome"/>
							</button>
						</hlayout>
					</cell>
					<cell align="right" width="85px">
						<hlayout valign="middle" >
							<label value="@load(vm.etichette['Minuscole'])"/>
							<checkbox checked="@bind(vm.minuscole.cognome)" onCheck="@command('onAggiornaCase')" >
								<custom-attributes proprieta="cognome"/>
							</checkbox>
						</hlayout>
					</cell>
					<cell width="100px"/>
					<cell align="right">
						<hlayout valign="middle" >
							<label value="@load(vm.etichette['Senza_Cognome'])"/>
							<checkbox checked="@bind(vm.dettaglio.senzaCognome)"/>
						</hlayout>
					</cell>
				</row>
				<row>
					<cell align="right">
						<zk if="${not (vm.dettaglio.isRiconoscimentoPrenatale())}">
							<h:span class="mandatoryLabel">*</h:span>
						</zk>
						<label value="@load(vm.etichette['Nome'])"/>
					</cell>
					<cell colspan="5">
						<hlayout valign="middle" hflex="1">
							<textbox value="@bind(vm.dettaglio.nome)" hflex="1" onChange="@command('onAggiornaCase')"
									 style="@load(vm.minuscole.nome?'text-transform:none':'text-transform:uppercase')">
								<custom-attributes proprieta="nome"/>
							</textbox>
							<zk if="${vm.dettaglio.isCambioGeneralita() or vm.dettaglio.isRiconoscimentoPostNascita()}">
								<button image="/images/icon/action/16x16/search.png"
										tooltiptext="@load(vm.etichette['Seleziona'])" onClick="@command('onCaricaSoggetti', tipoSoggetto='NATO_A')"/>
							</zk>
							<button image="/images/icon/action/16x16/cancel.png"
									tooltiptext="@load(vm.etichette['Cancella'])" onClick="@command('onCancellaCampoAtto')">
								<custom-attributes proprieta="nome"/>
							</button>
						</hlayout>
					</cell>
					<cell align="right">
						<hlayout valign="middle" >
							<label value="@load(vm.etichette['Minuscole'])"/>
							<checkbox checked="@bind(vm.minuscole.nome)" onCheck="@command('onAggiornaCase')" >
								<custom-attributes proprieta="nome"/>
							</checkbox>
						</hlayout>
					</cell>
					<cell/>
					<cell align="right">
						<hlayout valign="middle" >
							<label value="@load(vm.etichette['Senza_Nome'])"/>
							<checkbox checked="@bind(vm.dettaglio.senzaNome)" />
						</hlayout>
					</cell>
				</row>
				<row>
					<cell align="right">
						<label value="@load(vm.etichette['Secondo_Nome'])"/>
					</cell>
					<cell colspan="5">
						<hlayout valign="middle" hflex="1">
							<textbox value="@bind(vm.dettaglio.secondoNome)" hflex="1" onChange="@command('onAggiornaCase')"
									 style="@load(vm.minuscole.secondoNome?'text-transform:none':'text-transform:uppercase')">
								<custom-attributes proprieta="secondoNome"/>
							</textbox>
							<button image="/images/icon/action/16x16/cancel.png"
									tooltiptext="@load(vm.etichette['Cancella'])" onClick="@command('onCancellaCampoAtto')">
								<custom-attributes proprieta="secondoNome"/>
							</button>
						</hlayout>
					</cell>
					<cell align="right">
						<label value="@load(vm.etichette['Terzo_Nome'])"/>
					</cell>
					<cell colspan="2">
						<hlayout valign="middle" hflex="1">
							<textbox value="@bind(vm.dettaglio.terzoNome)" hflex="1" onChange="@command('onAggiornaCase')"
									 style="@load(vm.minuscole.terzoNome?'text-transform:none':'text-transform:uppercase')">
								<custom-attributes proprieta="terzoNome"/>
							</textbox>
							<button image="/images/icon/action/16x16/cancel.png"
									tooltiptext="@load(vm.etichette['Cancella'])" onClick="@command('onCancellaCampoAtto')">
								<custom-attributes proprieta="terzoNome"/>
							</button>
						</hlayout>
					</cell>
				</row>
				<row>
					<cell align="right">
						<zk if="${not (vm.dettaglio.isRiconoscimentoPrenatale())}">
							<h:span class="mandatoryLabel">*</h:span>
						</zk>
						<label value="@load(vm.etichette['Sesso'])"/>
					</cell>
					<cell>
						<combobox model="@load(vm.listaSesso)" readonly="false" width="115px"
								  selectedItem="@bind(vm.dettaglio.sesso) @converter('it.finmatica.zk.utils.PropertyConverter', property='id')">
							<template name="model">
								<comboitem label="@load(empty each?vm.etichette['Non_conosciuto']:vm.getEtichettaEnum(each))" value="@load(each)"/>
							</template>
						</combobox>
					</cell>
					<cell colspan="3">
						<hlayout valign="middle" hflex="1" spacing="9px">
							<zk if="${not (vm.dettaglio.isRiconoscimentoPrenatale())}">
								<hbox>
									<h:span class="mandatoryLabel" style="top:0.15em;right:0px;">*</h:span>
								</hbox>
							</zk>
							<label value="@load(vm.etichette['Data_Nascita'])"/>
							<datebox format="dd/MM/yyyy" value="@bind(vm.dettaglio.dataNascita)" width="95px" onChange="@command('onSelectDataNascita')"/>
							<label value="@load(vm.etichette['Ore'])"/>
							<textbox value="@bind(vm.dettaglio.oraNascita)" maxlength="2" width="28px"/>
							<label value="@load(vm.etichette['Minuti'])"/>
							<textbox value="@bind(vm.dettaglio.minutoNascita)" maxlength="2" width="28px"/>
							<button image="/images/icon/action/16x16/cancel.png"
									tooltiptext="@load(vm.etichette['Cancella'])" onClick="@command('onCancellaCampoAtto')">
								<custom-attributes proprieta="dataNascita,oraNascita,minutoNascita"/>
							</button>
						</hlayout>
					</cell>
					<cell align="right">
						<label value="@load(vm.etichette['Imprecisati'])"/>
					</cell>
					<cell colspan="3">
						<hlayout valign="middle" hflex="1" spacing="6px">
							<label value="@load(vm.etichette['Giorno'])"/>
							<checkbox checked="@bind(vm.dettaglio.giornoNascitaImprecisato)"/>
							<label value="@load(vm.etichette['Mese'])"/>
							<checkbox checked="@bind(vm.dettaglio.meseNascitaImprecisato)"/>
							<label value="@load(vm.etichette['Anno'])"/>
							<checkbox checked="@bind(vm.dettaglio.annoNascitaImprecisato)"/>
							<label value="@load(vm.etichette['Ore'])"/>
							<checkbox checked="@bind(vm.dettaglio.oraNascitaImprecisata)"/>
							<label value="@load(vm.etichette['Minuti'])"/>
							<checkbox checked="@bind(vm.dettaglio.minutoNascitaImprecisato)"/>
						</hlayout>
					</cell>
				</row>
				<row>
					<cell align="right">
						<hlayout>
							<customLabel mandatory="@load(vm.dettaglio.isComuneNascitaMandatory() or vm.datiProvenienza.flagInViaggio)"
										 value="@load(vm.etichette['Comune_Nascita'])"/>
						</hlayout>
					</cell>
					<cell colspan="5">
						<hlayout valign="middle" hflex="1">
							<bandboxComuni hflex="1"
										   value="@load(vm.dettaglio.descrizioneComuneNascita)"
										   dataRiferimento="@load(vm.dettaglio.dataNascita)"
										   onSelect="@command('onSelectComune', campoRiferimento='CN_NATO')"/>
							<button image="/images/icon/action/16x16/cancel.png"
									tooltiptext="@load(vm.etichette['Cancella'])" onClick="@command('onCancellaComune', campoRiferimento='CN_NATO')"
							/>
						</hlayout>
					</cell>
					<cell>
						<textbox value="@load(vm.dettaglio.siglaProvinciaNascita)" hflex="1" readonly="true"/>
					</cell>
					<cell align="right">
						<customLabel value="@load(vm.etichette['Nazionalita'])"
									 mandatory="@load(vm.dettaglio.isNazionalitaMandatory())"/>
					</cell>
					<cell>
						<combobox model="@load(vm.listaNazionalita)" readonly="false" hflex="1"
								  selectedItem="@bind(vm.dettaglio.nazionalita) @converter('it.finmatica.zk.utils.PropertyConverter', property='id')">
							<template name="model">
								<comboitem label="@load(empty each?'- -':each.descrizione)" tooltiptext="@load(each.descrizione)" value="@load(each)"/>
							</template>
						</combobox>
					</cell>
				</row>
				<row>
					<cell align="right">
						<label value="@load(vm.etichette['Codice_Fiscale'])"/>
					</cell>
					<cell colspan="5">
						<hlayout valign="middle" hflex="1">
							<textbox value="@bind(vm.dettaglio.codiceFiscale)" hflex="1" style="text-transform:uppercase"/>
							<button image="/images/icon/action/16x16/calculator.png"
									tooltiptext="@load(vm.etichette['Calcolo_Codice_Fiscale'])" onClick="@command('onCalcolaCf', tipoSoggetto='SOGGETTO_1')" />
							<button image="/images/icon/action/16x16/cancel.png"
									tooltiptext="@load(vm.etichette['Cancella'])" onClick="@command('onCancellaCampoAtto')">
								<custom-attributes proprieta="codiceFiscale"/>
							</button>
						</hlayout>
					</cell>
					<cell colspan="3">
						<hlayout valign="middle" hflex="1">
							<label  value="@load(vm.etichette['Non_Validato']))"/>
							<checkbox checked="@bind(vm.dettaglio.cfCalcolato1)" />
						</hlayout>
					</cell>
				</row>
				<row>
					<cell align="right">
						<customLabel mandatory="@load(not (vm.dettaglio.isRiconoscimentoPrenatale() or vm.datiProvenienza.flagInViaggio))"
									 value="@load(vm.etichette['Comune_Residenza'])"/>
					</cell>
					<cell colspan="5">
						<hlayout valign="middle" hflex="1">
							<bandboxComuni hflex="1"
										   value="@load(vm.dettaglio.descrizioneComuneResidenza)"
										   onSelect="@command('onSelectComune', campoRiferimento='CR_SOGG_1')"/>
							<button image="/images/icon/action/16x16/cancel.png"
									tooltiptext="@load(vm.etichette['Cancella'])" onClick="@command('onCancellaComune', campoRiferimento='CR_SOGG_1')"
							/>
						</hlayout>
					</cell>
					<cell>
						<textbox value="@load(vm.dettaglio.siglaProvinciaResidenza)" hflex="1" readonly="true"/>
					</cell>
					<cell colspan="2"/>
				</row>
				<row visible="@load(vm.dettaglio.isPrimaA() or vm.dettaglio.isPrimaB() or vm.dettaglio.isSecondaA() or vm.dettaglio.isCentroNascita() or vm.dettaglio.isTestoLibero() or vm.dettaglio.isSenzaSerie())">
					<cell align="right">
						<label value="@load(vm.etichette['Stato_nato_nascita'])"/>
					</cell>
					<cell colspan="2">
						<combobox model="@load(vm.listaStato)" readonly="true" hflex="1"
						  	disabled="@load(not (vm.dettaglio.isPrimaA() or vm.dettaglio.isPrimaB() or vm.dettaglio.isSecondaA() or vm.dettaglio.isCentroNascita() or vm.dettaglio.isTestoLibero() or vm.dettaglio.isSenzaSerie()) )"
					  		selectedItem="@bind(vm.dettaglio.natoMorto) @converter('it.finmatica.zk.utils.PropertyConverter', property='id')">
							<template name="model">
								<comboitem label="@load(vm.etichette[each.name()])" value="@load(each)"/>
							</template>
						</combobox>
					</cell>
					<cell align="right" colspan="2">
						<label value="@load(vm.etichette['Parto_plurimo'])"/>
					</cell>
					<cell colspan="2">
						<hlayout height="20px">
							<radiogroup model="@load(vm.listaBoolean)"
								selectedItem="@bind(vm.dettaglio.partoPlurimo) @converter('it.finmatica.zk.utils.PropertyConverter', property='value')">
								<template name="model">
									<radio label="@load(each.label)" value="@load(each.value)"
								   		disabled="@load(not (vm.dettaglio.isPrimaA() or vm.dettaglio.isPrimaB() or vm.dettaglio.isSecondaA() or vm.dettaglio.isCentroNascita() or vm.dettaglio.isTestoLibero() or vm.dettaglio.isSenzaSerie()) )"
									   	style="padding-left:10px"/>
								</template>
							</radiogroup>
						</hlayout>
					</cell>
					<cell colspan="2">
						<hlayout valign="middle" hflex="3" spacing="8px">
							<label value="@load(vm.etichette['Numero_gemello'])"/>
							<combobox model="@load(vm.listaCardinali)" readonly="true" width="55px"
							  	disabled="@load(not vm.dettaglio.partoPlurimo or not (vm.dettaglio.isPrimaA() or vm.dettaglio.isPrimaB() or vm.dettaglio.isSecondaA() or vm.dettaglio.isCentroNascita() or vm.dettaglio.isTestoLibero() or vm.dettaglio.isSenzaSerie()) )"
							  	selectedItem="@bind(vm.dettaglio.numeroGemello) @converter('it.finmatica.zk.utils.PropertyConverter', property='id')">
								<template name="model">
									<comboitem label="@load(each)" value="@load(each)"/>
								</template>
							</combobox>
							<label value="@load(vm.etichette['di'])"/>
							<combobox model="@load(vm.listaCardinali)" readonly="true" width="55px"
									  disabled="@load(not vm.dettaglio.partoPlurimo or not (vm.dettaglio.isPrimaA() or vm.dettaglio.isPrimaB() or vm.dettaglio.isSecondaA() or vm.dettaglio.isCentroNascita() or vm.dettaglio.isTestoLibero() or vm.dettaglio.isSenzaSerie()) )"
							  	selectedItem="@bind(vm.dettaglio.totaleGemelli) @converter('it.finmatica.zk.utils.PropertyConverter', property='id')">
								<template name="model">
									<comboitem label="@load(each)" value="@load(each)"/>
								</template>
							</combobox>
						</hlayout>
					</cell>
				</row>
				<!-- RICONOSCIMENTO POST NASCITA | ESTREMI ATTO NASCITA PER ADOZIONE -->
				<zk>
					<row visible="@load(vm.dettaglio.isRiconoscimentoPostNascita() or vm.dettaglio.isAdozioneEstremiAttoNascitaVisible())">
						<cell align="right">
							<customLabel mandatory="@load(vm.dettaglio.isAdozioneEstremiAttoNascitaMandatory() or vm.dettaglio.isRiconoscimentoPostNascita())" value="@load(vm.etichette['Estremi_Atto_Nascita'])"/>
						</cell>
						<cell colspan="8">
							<grid hflex="1">
								<rows>
									<row>
										<cell>
											<grid>
												<rows>

													<templateRowEstremiAttoNascita1NasMorCit/>

												</rows>
											</grid>
										</cell>
										<cell width="42px">
											<button image="/images/icon/action/16x16/grid.png"
													tooltiptext="@load(vm.etichette['Recupera_Estremi_Atto_Nascita'])" onClick="@command('onRecuperaEstremiSoggetto1DaAttoDiNascita')"/>
										</cell>
									</row>
								</rows>
							</grid>
						</cell>
					</row>
				</zk>
				<row>
					<cell align="right">
						<label value="@load(vm.etichette['Note'])"/>
					</cell>
					<cell colspan="5">
						<textbox value="@bind(vm.dettaglio.note)" hflex="1" rows="4"/>
					</cell>
					<cell align="right" colspan="2">
						<label value="@load(vm.etichette['Certificazione_atto'])" visible="@load( (vm.dettaglio.natura eq 'O') or (vm.dettaglio.natura eq 'T'))"/>
					</cell>
					<cell>
						<hlayout height="20px">
							<radiogroup model="@load(vm.listaSiNo)"
										selectedItem="@bind(vm.dettaglio.certificabile) @converter('it.finmatica.zk.utils.PropertyConverter', property='id')"
										visible="@load( (vm.dettaglio.natura eq 'O') or (vm.dettaglio.natura eq 'T') )">
								<template name="model">
									<radio label="@load(vm.etichette[each.name()])" value="@load(each)" style="padding-left:10px"
										   disabled="@load((vm.dettaglio.natura ne 'O' and vm.dettaglio.natura ne 'T') or (vm.dettaglio.codiceRecord ne 3) )"/>
								</template>
							</radiogroup>
						</hlayout>
					</cell>
				</row>
			</rows>
		</grid>
	</groupbox>

</zk>