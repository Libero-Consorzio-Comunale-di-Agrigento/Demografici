<?xml version="1.0" encoding="UTF-8"?>
<?taglib uri="http://www.zkoss.org/dsp/web/core" prefix="c"?>

<zk xmlns="http://www.zkoss.org/2005/zul"
	xmlns:h="http://www.w3.org/1999/xhtml"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul http://www.zkoss.org/2005/zul/zul.xsd">

	<window viewModel="@id('vm') @init('restrict.statocivile.dizionari.registro.ModelloDATDettaglioViewModel')"
			apply="org.zkoss.bind.BindComposer"
			contentStyle="overflow:auto;"
			border="none"
			width="100%" height="100%"
			sizable="false" closable="false">

		<hlayout valign="middle">
			<controlBarDettaglio/>

			<label value="@load(vm.formLabel)" sclass="formTitle"/>
		</hlayout>

		<grid sclass="form">
			<rows>
				<row>
					<cell align="right" width="150px">
						<h:span class="mandatoryLabel">*</h:span><label value="@load(vm.etichette['Descrizione'])"/>
					</cell>
					<cell>
						<hlayout valign="middle">
							<textbox value="@bind(vm.dettaglio.descrizione)" width="300px"/>
							<button image="/images/icon/action/16x16/cancel.png"
									tooltiptext="@load(vm.etichette['Cancella'])"
									onClick="@command('onCancellaCampo')">
								<custom-attributes proprieta="descrizione"/>
							</button>
						</hlayout>
					</cell>
				</row>
				<row>
					<cell align="right">
						<label value="@load(vm.etichette['Modello'])"/>
					</cell>
					<cell>
						<hlayout valign="middle" hflex="1">
							<textbox value="@bind(vm.dettaglio.nome)" cols="80"/>
							<button visible="@bind(not empty vm.dettaglio.id)"
									image="/images/icon/action/16x16/import.png"
									tooltiptext="@load(vm.etichette['scarica_modello_tooltip'])"
									onClick="@command('onDownloadAllegato')"/>
							<button image="/images/icon/action/16x16/export.png" upload="true"
									tooltiptext="@load(vm.etichette['inserisci_modello_tooltip'])"
									onUpload="@command('onUploadAllegato')" />
						</hlayout>
					</cell>
				</row>
				<row>
					<cell align="right">
						<label value="@load(vm.etichette['Formato_testo'])"/>
					</cell>
					<cell>
						<combobox model="@load(vm.listaFormatiTesto)" readonly="true"
								  selectedItem="@bind(vm.dettaglio.formatoTesto)">
							<template name="model">
								<comboitem label="@load(empty each? '- -':each)" value="@load(each)"/>
							</template>
						</combobox>
					</cell>
				</row>
			</rows>
		</grid>

	</window>

</zk>