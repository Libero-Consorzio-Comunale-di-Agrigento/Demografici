<?xml version="1.0" encoding="UTF-8"?>
<?taglib uri="http://www.zkoss.org/dsp/web/core" prefix="c"?>

<zk xmlns="http://www.zkoss.org/2005/zul"
	xmlns:h="http://www.w3.org/1999/xhtml"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul http://www.zkoss.org/2005/zul/zul.xsd">

	<window viewModel="@id('vm') @init('restrict.statocivile.dizionari.generale.LuogoNascitaDettaglioViewModel')"
			apply="org.zkoss.bind.BindComposer"
			border="none"
			width="100%" height="100%"
			sizable="false" closable="false">

			<hlayout valign="middle">
				<controlBarDettaglio/>

				<label value="@load(vm.formLabel)" sclass="formTitle"/>
			</hlayout>

			<grid sclass="form">
				<rows>
					<row>
						<cell width="150px" align="right">
							<label value="@load(vm.etichette['Codice'])"/>
						</cell>
						<cell>
                            <label value="@load(vm.dettaglio.id)"/>
						</cell>
					</row>
					<row>
						<cell align="right">
							<label value="@load(vm.etichette['Nel'])"/>
						</cell>
						<cell>
							<textbox value="@bind(vm.dettaglio.nel)" hflex="1"/>
						</cell>
					</row>
					<row>
						<cell align="right">
                            <h:span class="mandatoryLabel">*</h:span><label value="@load(vm.etichette['Descrizione'])"/>
						</cell>
						<cell>
							<textbox value="@bind(vm.dettaglio.descrizione)" maxlength="150" hflex="1"/>
						</cell>
					</row>
				</rows>
			</grid>

	</window>

</zk>