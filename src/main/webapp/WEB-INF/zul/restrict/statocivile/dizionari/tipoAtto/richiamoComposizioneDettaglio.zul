<?xml version="1.0" encoding="UTF-8"?>
<?taglib uri="http://www.zkoss.org/dsp/web/core" prefix="c"?>

<zk xmlns="http://www.zkoss.org/2005/zul"
	xmlns:h="http://www.w3.org/1999/xhtml"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul http://www.zkoss.org/2005/zul/zul.xsd">

	<window viewModel="@id('vm') @init('restrict.statocivile.dizionari.tipoAtto.RichiamoComposizioneDettaglioViewModel')"
			apply="org.zkoss.bind.BindComposer"
			border="none"
			width="100%" height="100%"
			sizable="false" closable="false">

		<vlayout vflex="1">

			<hlayout valign="middle">
				<controlBarDettaglio/>

				<label value="@load(vm.formLabel)" sclass="formTitle"/>
			</hlayout>

			<grid sclass="form">
				<rows>
					<row>
						<cell align="right" width="150px">
							<label value="@load(vm.etichette['Tipo_Atto'])"/>
						</cell>
						<cell width="200px">
							<label value="@load(vm.getEtichettaEnum(vm.tipoAttoEnum))" hflex="1"/>
						</cell>
						<cell width="150px"/>
						<cell/>
					</row>
					<row>
						<cell align="right">
							<h:span class="mandatoryLabel">*</h:span><label value="@load(vm.etichette['Richiamo'])"/>
						</cell>
						<cell>
							<intbox value="@load(vm.dettaglio.richiamo)" disabled="@load(vm.tipoOperazione.isUpdate())"/>
						</cell>
						<cell align="right">
							<h:span class="mandatoryLabel">*</h:span><label value="@load(vm.etichette['Progressivo'])"/>
						</cell>
						<cell>
							<intbox value="@bind(vm.dettaglio.progressivo)" disabled="@load(vm.tipoOperazione.isUpdate())"/>
						</cell>
					</row>
					<row>
						<cell align="right">
							<h:span class="mandatoryLabel">*</h:span><label value="@load(vm.etichette['Descrizione'])"/>
						</cell>
						<cell colspan="3">
							<textbox value="@bind(vm.dettaglio.descrizione)" hflex="1" rows="2"/>
						</cell>
					</row>
					<row>
						<cell align="right">
							<label value="@load(vm.etichette['Numero_righe'])"/>
						</cell>
						<cell>
							<intbox value="@bind(vm.dettaglio.numeroRighe)" cols="2" maxlength="2"/>
						</cell>
						<cell colspan="2"/>
					</row>
				</rows>
			</grid>

			<groupbox width="100%" vflex="1" open="true" closable="false">
				<caption label="@load(vm.etichette['Formule_Associate'])"/>
				<include richiamoComposizione="@load(vm.dettaglio)" opener="@load(vm.self)"
						 src="@load(vm.getUriListaDettaglio())"
						 vflex="1"/>
			</groupbox>

		</vlayout>

	</window>

</zk>