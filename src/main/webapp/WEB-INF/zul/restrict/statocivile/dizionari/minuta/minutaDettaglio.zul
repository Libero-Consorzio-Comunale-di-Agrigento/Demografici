<?xml version="1.0" encoding="UTF-8"?>
<?taglib uri="http://www.zkoss.org/dsp/web/core" prefix="c"?>

<zk xmlns="http://www.zkoss.org/2005/zul"
	xmlns:h="http://www.w3.org/1999/xhtml"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul http://www.zkoss.org/2005/zul/zul.xsd">

	<window viewModel="@id('vm') @init('restrict.statocivile.dizionari.minuta.MinutaDettaglioViewModel')"
			apply="org.zkoss.bind.BindComposer"
			border="none"
			width="100%" height="100%"
			sizable="false" closable="false">

		<hlayout valign="middle">
			<controlBarDettaglio/>

			<label value="@load(vm.formLabel)" sclass="formTitle"/>
		</hlayout>

		<vlayout vflex="1" width="100%" sclass="scroll">
			<grid sclass="form">
				<rows>
					<row>
						<cell align="right" width="150px">
							<label value="@load(vm.etichette['Tipo_Atto'])"/>
						</cell>
						<cell>
							<label value="@load(vm.getEtichettaEnum(vm.tipoAttoEnum))" hflex="1"/>
						</cell>
					</row>
					<row>
						<cell align="right" width="150px">
							<h:span class="mandatoryLabel">*</h:span><label value="@load(vm.etichette['Codice'])"/>
						</cell>
						<cell>
							<intbox value="@bind(vm.dettaglio.codice)" maxlength="2" disabled="@load(vm.tipoOperazione.isUpdate())"/>
						</cell>
					</row>
					<row>
						<cell align="right">
							<label value="@load(vm.etichette['Descrizione'])"/>
						</cell>
						<cell>
							<textbox value="@bind(vm.dettaglio.descrizione)" maxlength="40" hflex="1"/>
						</cell>
					</row>
					<row>
						<cell align="right">
							<label value="@load(vm.etichette['Descrizione_Estesa'])"/>
						</cell>
						<cell>
							<textbox value="@bind(vm.dettaglio.descrizioneEstesa)" rows="3" hflex="1"/>
						</cell>
					</row>
					<row>
						<cell align="right">
							<label value="@load(vm.etichette['Categoria'])"/>
						</cell>
						<cell>
							<combobox model="@load(vm.listaCategoria)" readonly="true" width="400px"
									  selectedItem="@bind(vm.dettaglio.categoriaDomain) @converter('it.finmatica.zk.utils.PropertyConverter', property='id')"
									  onSelect="@command('onSelectCategoria')">
								<template name="model">
									<comboitem label="@load(empty each? '- -':each.descrizione)" value="@load(each)"/>
								</template>
							</combobox>
						</cell>
					</row>
					<row visible="@load(vm.listaTipoRichieste.size() gt 1)">
						<cell align="right">
							<label value="@load(vm.etichette['Tipo_richiesta'])"/>
						</cell>
						<cell>
							<combobox model="@load(vm.listaTipoRichieste)" readonly="true" width="400px"
									  selectedItem="@bind(vm.dettaglio.tipoRichiesta) @converter('it.finmatica.zk.utils.PropertyConverter', property='tipoRichiesta')">
								<template name="model">
									<comboitem label="@load(empty each? '- -':each.descrizione)"
											   value="@load(each.tipoRichiesta)"/>
								</template>
							</combobox>
						</cell>
					</row>
					<row>
						<cell align="right">
							<label value="@load(vm.etichette['Testo'])"/>
						</cell>
						<cell>
							<hlayout>
								<textbox id="testoConVariabili" value="@bind(vm.dettaglio.testo.clob)" rows="30" hflex="1" droppable="true"/>
								<templateListaStringhe/>
							</hlayout>
						</cell>
					</row>
				</rows>
			</grid>

			<templateIdDomain/>

		</vlayout>

	</window>

</zk>