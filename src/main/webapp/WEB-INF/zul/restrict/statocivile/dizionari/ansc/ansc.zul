<?xml version="1.0" encoding="UTF-8"?>
<?taglib uri="http://www.zkoss.org/dsp/web/core" prefix="c"?>

<zk xmlns="http://www.zkoss.org/2005/zul"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.zkoss.org/2005/zul http://www.zkoss.org/2005/zul/zul.xsd">

    <window viewModel="@id('vm') @init('restrict.statocivile.dizionari.ansc.AnscViewModel')"
            apply="org.zkoss.bind.BindComposer"
            border="none"
            width="100%" height="@load(vm.wCenterHeight)"
            sizable="false" closable="false">

        <tabbox hflex="1" vflex="1">
            <tabs>
                <tab label="@load(vm.etichette['Parametri'])" 				/>
                <tab label="@load(vm.etichette['Utenti'])" tooltiptext="@load(vm.etichette['Utenti'])"/>
			    <tab label="@load(vm.etichette['Servizi'])" tooltiptext="@load(vm.etichette['Servizi'])"/>
			    <tab label="@load(vm.etichette['Casi_Uso_Servizi'])" tooltiptext="@load(vm.etichette['Casi_Uso_Servizi'])"/>
			    <tab label="@load(vm.etichette['Casi_Uso_Allegati'])" tooltiptext="@load(vm.etichette['Casi_Uso_Allegati'])"/>
                <tab label="@load(vm.etichette['Motivi_richiesta'])" tooltiptext="@load(vm.etichette['Motivi_richiesta'])"/>
            </tabs>
            <tabpanels>
                <tabpanel>
                    <include src="/restrict/statocivile/dizionari/ansc/parametroLista.zul" />
                </tabpanel>
                <tabpanel>
                    <include src="/restrict/statocivile/dizionari/ansc/anscUtenteLista.zul" />
                </tabpanel>
                <tabpanel>
                    <include src="/restrict/statocivile/dizionari/ansc/anscServiziLista.zul" />
                </tabpanel>
                <tabpanel>
                    <include src="/restrict/statocivile/dizionari/ansc/anscCasiUsoArchiviLista.zul" />
                </tabpanel>
                <tabpanel>
                    <include src="/restrict/statocivile/dizionari/ansc/anscCasiUsoAllegatiLista.zul" />
                </tabpanel>
                <tabpanel>
                    <include src="/restrict/statocivile/dizionari/ansc/motivoRichiestaLista.zul" />
                </tabpanel>
            </tabpanels>
        </tabbox>

    </window>

</zk>