<?xml version="1.0" encoding="UTF-8"?>
<?taglib uri="http://www.zkoss.org/dsp/web/core" prefix="c"?>

<zk xmlns="http://www.zkoss.org/2005/zul"
	xmlns:h="http://www.w3.org/1999/xhtml"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul http://www.zkoss.org/2005/zul/zul.xsd">

	<window viewModel="@id('vm') @init('restrict.statocivile.dizionari.registro.RegistroDocumentoDettaglioViewModel')"
			apply="org.zkoss.bind.BindComposer"
			border="none"
			width="100%" height="100%"
			sizable="false" closable="false">

		<hlayout valign="middle">
			<controlBarDettaglio/>

			<label value="@load(vm.formLabel)" sclass="formTitle"/>
		</hlayout>

		<vlayout vflex="1" width="100%" sclass="scroll">
			<grid sclass="form">
				<rows>
					<row>
						<cell width="150px" align="right">
							<label value="@load(vm.etichette['Tipo_Documento'])"/>
						</cell>
						<cell>
							<label value="@load(vm.getEtichettaEnum(vm.tipoDocumento))"/>
						</cell>
					</row>
					<row>
						<cell align="right">
							<h:span class="mandatoryLabel" >*</h:span><label value="@load(vm.etichette['Codice'])"/>
						</cell>
						<cell>
							<intbox value="@bind(vm.dettaglio.id)" cols="2" maxlength="2"
									disabled="@load(vm.tipoOperazione.isUpdate())"/>
						</cell>
					</row>
					<row>
						<cell align="right">
							<h:span class="mandatoryLabel">*</h:span><label value="@load(vm.etichette['Descrizione'])"/>
						</cell>
						<cell>
							<textbox value="@bind(vm.dettaglio.descrizione)" hflex="1"/>
						</cell>
					</row>
					<row>
						<cell align="right">
							<h:span class="mandatoryLabel">*</h:span><label value="@load(vm.etichette['Tipo_Registro'])"/>
						</cell>
						<cell>
							<combobox model="@load(vm.listaTipiRegistro)" readonly="true" width="300px"
									  selectedItem="@bind(vm.dettaglio.tipoRegistro) @converter('it.finmatica.zk.utils.PropertyConverter', property='id')">
								<template name="model">
									<comboitem label="@load(vm.getDescTipoRegistro(each))"  tooltiptext="@load(vm.getDescTipoRegistro(each))" value="@load(each)"/>
								</template>
							</combobox>
						</cell>
					</row>
					<row visible="@load(vm.tipoOperazione.isUpdate())">
						<cell align="right">
							<label value="@load(vm.etichette['Numeratori'])"/>
						</cell>
						<cell>
							<listbox model="@load(vm.listaNumeriDocumenti)" hflex="1">
								<listhead>
									<listheader label="@load(vm.etichette['Anno'])" />
									<listheader label="@load(vm.etichette['Protocollo'])" />
								</listhead>
								<template name="model">
									<listitem>
										<listcell label="@load(each.anno)"/>
										<listcell>
											<intbox value="@bind(each.numero)" cols="2" inplace="true" onChange="@command('onCambiaNumero', numerazione=each)"/>
										</listcell>
									</listitem>
								</template>
							</listbox>
						</cell>
					</row>
				</rows>
			</grid>

		</vlayout>

	</window>

</zk>