<?xml version="1.0" encoding="UTF-8"?>
<?taglib uri="http://www.zkoss.org/dsp/web/core" prefix="c"?>

<zk xmlns="http://www.zkoss.org/2005/zul"
	xmlns:h="http://www.w3.org/1999/xhtml"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul http://www.zkoss.org/2005/zul/zul.xsd">

	<window viewModel="@id('vm') @init('restrict.statocivile.dizionari.comunicazione.ComunicazioneAttoDettaglioViewModel')"
			apply="org.zkoss.bind.BindComposer"
			contentStyle="overflow:auto;"
			border="none"
			width="100%" height="100%"
			sizable="false" closable="false">

		<hlayout valign="middle">
			<controlBarDettaglio/>

			<label value="@load(vm.formLabel)" sclass="formTitle"/>
		</hlayout>

		<grid sclass="form">
			<rows>
				<row>
					<cell align="right" width="170px">
						<label value="@load(vm.etichette['Tipo_Atto'])"/>
					</cell>
					<cell>
						<label value="@load(vm.getEtichettaEnum(vm.tipoAttoEnum))" hflex="1"/>
					</cell>
				</row>
				<row>
					<cell align="right" width="150px">
						<h:span class="mandatoryLabel">*</h:span><label value="@load(vm.etichette['Comunicazione'])"/>
					</cell>
					<cell>
						<label value="@load(vm.dettaglio.comunicazione.descrizioneEstesa)" tooltiptext="@load(vm.dettaglio.comunicazione.descrizioneEstesa)" hflex="1"/>
					</cell>
				</row>
				<row>
					<cell align="right">
						<h:span class="mandatoryLabel">*</h:span><label value="@load(vm.etichette['Tipo_Individui'])"/>
					</cell>
					<cell>
						<combobox model="@load(vm.listaIndividui)" readonly="true"
								  selectedItem="@bind(vm.dettaglio.tipoIndividuiAtto)">
							<template name="model">
								<comboitem label="@load(vm.getEtichettaEnum(each))" value="@load(each)"/>
							</template>
						</combobox>
					</cell>
				</row>
				<row>
					<cell align="right">
						<label value="@load(vm.etichette['Natura_Atto'])"/>
					</cell>
					<cell>
						<combobox model="@load(vm.listaNature)" readonly="false"
								  selectedItem="@bind(vm.dettaglio.natura)">
							<template name="model">
								<comboitem label="@load(vm.getEtichettaEnum(each))" value="@load(each)"/>
							</template>
						</combobox>
					</cell>
				</row>
				<row>
					<cell align="right">
						<label value="@load(vm.etichette['Numero_copie'])"/>
					</cell>
					<cell>
						<intbox value="@bind(vm.dettaglio.numeroCopie)" cols="2" maxlength="2"/>
					</cell>
				</row>
				<row>
					<cell align="right">
						<label value="@load(vm.etichette['Modello'])"/>
					</cell>
					<cell>
						<hlayout valign="middle" hflex="1">
							<textbox value="@bind(vm.modelloRelazione.modello.nome)" cols="80"/>
							<button visible="@bind(not empty vm.modelloRelazione.modello.id)"
									image="/images/icon/action/16x16/import.png"
									tooltiptext="@load(vm.etichette['scarica_modello_tooltip'])"
									onClick="@command('onDownloadAllegato')"/>
							<button image="/images/icon/action/16x16/export.png" upload="true"
									tooltiptext="@load(vm.etichette['inserisci_modello_tooltip'])"
									onUpload="@command('onUploadAllegato')" />
						</hlayout>
					</cell>
				</row>
				<row>
					<cell align="right">
						<label value="@load(vm.etichette['Formato_testo'])"/>
					</cell>
					<cell>
						<combobox model="@load(vm.listaFormatiTesto)" readonly="true"
								  selectedItem="@bind(vm.modelloRelazione.modello.formatoTesto)">
							<template name="model">
								<comboitem label="@load(each)" value="@load(each)"/>
							</template>
						</combobox>
					</cell>
				</row>
				<row>
					<cell align="right">
						<label value="@load(vm.etichette['Tipo_Documento_Fascicolo'])"/>
					</cell>
					<cell>
						<combobox model="@load(vm.listaTipoDocumento)" readonly="true" width="350px"
								  selectedItem="@bind(vm.dettaglio.tipoDocumentoFascicolo) @converter('it.finmatica.zk.utils.PropertyConverter', property='id')">
							<template name="model">
								<comboitem label="@load(empty each?'- -':each.descrizione)" tooltiptext="@load(each.descrizione)" value="@load(each)"/>
							</template>
						</combobox>
					</cell>
				</row>
			</rows>
		</grid>

	</window>

</zk>