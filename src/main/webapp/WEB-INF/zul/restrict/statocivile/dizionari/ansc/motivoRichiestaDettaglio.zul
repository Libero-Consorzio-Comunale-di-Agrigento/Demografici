<?xml version="1.0" encoding="UTF-8"?>
<?taglib uri="http://www.zkoss.org/dsp/web/core" prefix="c"?>

<zk xmlns="http://www.zkoss.org/2005/zul"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.zkoss.org/2005/zul http://www.zkoss.org/2005/zul/zul.xsd">

    <window viewModel="@id('vm') @init('restrict.statocivile.dizionari.ansc.MotivoRichiestaDettaglioViewModel')"
            apply="org.zkoss.bind.BindComposer"
            border="none"
            width="100%" height="100%"
            sizable="false" closable="false">


            <hlayout valign="middle">
                <controlBarDettaglio/>

                <label value="@load(vm.formLabel)" sclass="formTitle"/>
            </hlayout>

            <vlayout vflex="1" width="100%" sclass="scroll">

                <grid sclass="form">
                    <rows>
                        <row>
                            <cell align="right" width="130px">
                                <label value="@load(vm.etichette['Codice'])"/>
                            </cell>
                            <cell>
                                <label value="@load(vm.dettaglio.id)" hflex="1"/>
                            </cell>
                        </row>
                        <row>
                            <cell align="right" width="130px">
                                <customLabel mandatory="true" value="@load(vm.etichette['Descrizione'])"/>
                            </cell>
                            <cell>
                                <textbox value="@bind(vm.dettaglio.descrizione)" hflex="1"/>
                            </cell>
                        </row>
                        <row>
                            <cell align="right" width="130px">
                                <label value="@load(vm.etichette['Caso_Uso_Ansc'])"/>
                            </cell>
                            <cell>
                                <label value="@load(vm.dettaglio.descrizioneUseCase)" hflex="1"/>
                            </cell>
                        </row>
                        <row>
                            <cell align="right">
                                <label value="@load(vm.etichette['Tipo'])"/>
                            </cell>
                            <cell>
                                <hlayout height="20px">
                                    <radiogroup model="@load(vm.listaTipoRichiesta)" hflex="1"
                                                selectedItem="@bind(vm.dettaglio.tipoRichiesta) @converter('it.finmatica.zk.utils.PropertyConverter', property='id')">
                                        <template name="model">
                                            <radio label="@load(each.descrizione)" disabled="true"
                                                   value="@load(each.tipoRichiesta)" style="padding-left:10px"/>
                                        </template>
                                    </radiogroup>
                                </hlayout>
                            </cell>
                        </row>
                        <row>
                            <cell align="right">
                                <label value="@load(vm.etichette['Ricorrente'])"/>
                            </cell>
                            <cell>
                                <checkbox checked="@bind(vm.dettaglio.flagRicorrente)"/>
                            </cell>
                        </row>
                    </rows>
                </grid>

                <templateIdDomain/>

            </vlayout>

    </window>

</zk>