<?xml version="1.0" encoding="UTF-8"?>
<?taglib uri="http://www.zkoss.org/dsp/web/core" prefix="c"?>

<zk xmlns="http://www.zkoss.org/2005/zul"
	xmlns:h="http://www.w3.org/1999/xhtml"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xmlns:w="http://www.zkoss.org/2005/zk/client"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul http://www.zkoss.org/2005/zul/zul.xsd">

	<window viewModel="@id('vm') @init('restrict.statocivile.dizionari.minuta.MinutaListaViewModel')"
			apply="org.zkoss.bind.BindComposer"
			border="none"
			width="100%" height="@load(vm.wCenterHeight)"
			sizable="false" closable="false">

		<hlayout valign="middle">
			<controlBarLista/>

			<label value="@load(vm.formLabel)" sclass="formTitle"/>
		</hlayout>

		<groupbox closable="false">
			<grid sclass="form">
				<rows>
					<templateRowTipoAttoRicerca/>
				</rows>
			</grid>
		</groupbox>

		<vlayout vflex="1">

			<totalSizeBlock/>

			<listbox model="@load(vm.lista)" selectedItem="@bind(vm.dettaglio)" nonselectableTags="" vflex="1"
					 emptyMessage="@load(vm.etichette['Nessun_dato_disponibile'])">
				<listhead>
					<listheader label="@load(vm.etichette['Codice'])" 	/>
					<listheader label="@load(vm.etichette['Descrizione'])" 			width="28%"/>
					<listheader label="@load(vm.etichette['Descrizione_Estesa'])" 	width="30%"/>
					<listheader label="@load(vm.etichette['Categoria'])" 			width="15%"/>
					<listheader label="@load(vm.etichette['Tipi_Atto_associati'])" 	width="15%"/>
					<listheader label="" width="52px"/>
				</listhead>
				<template name="model" var="item">
					<listitem onDoubleClick="@command('onModifica')">
						<listcell label="@load(item.getFirst().codice)"/>
						<listcell label="@load(item.getFirst().descrizione)"/>
						<listcell label="@load(item.getFirst().descrizioneEstesa)"/>
						<listcell label="@load(item.getFirst().categoriaDomain.descrizione)"/>
						<listcell>
							<listbox model="@load(item.getSecond())">
								<template name="model" var="subItem">
									<listitem>
										<listcell label="@load(subItem.descrizione)"
												  tooltiptext="@load(subItem.descrizione)"/>
									</listitem>
								</template>
							</listbox>
						</listcell>
						<listcell>
							<button image="/images/icon/action/18x18/edit.png"
									tooltiptext="@load(vm.etichette['modifica_tooltip'])"
									visible="@load(not empty item.getFirst().id)"
									onClick="@command('onModifica')"/>
						</listcell>
					</listitem>
				</template>
			</listbox>

		</vlayout>

	</window>

</zk>