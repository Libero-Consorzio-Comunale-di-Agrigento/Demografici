<?xml version="1.0" encoding="UTF-8"?>

<zk xmlns="http://www.zkoss.org/2005/zul"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.zkoss.org/2005/zul http://www.zkoss.org/2005/zul/zul.xsd">

    <hlayout valign="middle">
        <combobox model="@load(vm.listaComunicazioni)" cols="50" selectedItem="@bind(vm.comunicazione)"
                  onChange="@command('onRicerca')" style="padding:5px">
            <template name="model">
                <comboitem label="@load(each.descrizioneEstesa)" value="@load(each)"/>
            </template>
        </combobox>
    </hlayout>

</zk>