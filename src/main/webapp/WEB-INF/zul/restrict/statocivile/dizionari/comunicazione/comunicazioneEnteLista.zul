<?xml version="1.0" encoding="UTF-8"?>
<?taglib uri="http://www.zkoss.org/dsp/web/core" prefix="c"?>
<?component name=bandboxComunicazioni extends=bandbox class=it.finmatica.de4gsdzk.zkutils.BandboxComunicazioni?>

<zk xmlns="http://www.zkoss.org/2005/zul"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul http://www.zkoss.org/2005/zul/zul.xsd">

	<window viewModel="@id('vm') @init('restrict.statocivile.dizionari.comunicazione.ComunicazioneEnteListaViewModel')"
			apply="org.zkoss.bind.BindComposer"
			border="none"
			width="100%" height="100%"
			sizable="false" closable="false">

		<vlayout vflex="1">

			<hlayout valign="middle">
				<controlBarLista/>

				<label value="@load(vm.formLabel)" sclass="formTitle"/>
			</hlayout>

			<groupbox closable="false">
				<grid sclass="form">
					<rows>
						<row>
							<cell align="right" width="90px">
								<label value="@load(vm.etichette['Tipo'])"/>
							</cell>
							<cell>
								<hlayout hflex="1">
									<radiogroup model="@load(vm.listaTipiComunicazione)" onCheck="@command('onSelectTipoComunicazione')"
												selectedItem="@bind(vm.tipoComunicazione) @converter('it.finmatica.zk.utils.PropertyConverter', property='id')">
										<template name="model">
											<radio label="@load(vm.getEtichettaEnum(each))" value="@load(each)" style="padding:10px"/>
										</template>
									</radiogroup>
								</hlayout>
							</cell>
						</row>
						<row visible="@load(not empty vm.tipoComunicazione and not vm.tipoComunicazione.isAnnotazione())">
							<cell align="right" width="60px">
								<label value="@load(vm.etichette['Tipo_Atto'])"/>
							</cell>
							<cell>
								<hlayout hflex="1">
									<radiogroup model="@load(vm.listaTipiAtto)" onCheck="@command('onRicarica')"
												selectedItem="@bind(vm.tipoAttoEnum) @converter('it.finmatica.zk.utils.PropertyConverter', property='id')">
										<template name="model">
											<radio label="@load(vm.getEtichettaEnum(each))" value="@load(each)" style="padding:10px"/>
										</template>
									</radiogroup>
								</hlayout>
							</cell>
						</row>
						<row visible="@load(not empty vm.tipoComunicazione and vm.tipoComunicazione.isAnnotazione())">
							<cell align="right" width="60px">
								<label value="@load(vm.etichette['Comunicazione'])"/>
							</cell>
							<cell>
								<hlayout valign="middle" hflex="1">
									<bandboxComunicazioni width="580px" style="text-transform:uppercase"
														  value="@load(vm.comunicazione.descrizioneEstesa)"
														  tipoComunicazione="@load(vm.tipoComunicazione)"
														  onSelect="@command('onSelectComunicazione')"/>
									<button image="/images/icon/action/16x16/cancel.png"
											tooltiptext="@load(vm.etichette['Cancella'])" onClick="@command('onCancellaComunicazione')"/>
								</hlayout>
							</cell>
						</row>
					</rows>
				</grid>
			</groupbox>

			<totalSizeBlock/>

			<listbox model="@load(vm.lista)" selectedItem="@bind(vm.dettaglio)" nonselectableTags="" vflex="1"
					 emptyMessage="@load(vm.etichette['Nessun_dato_disponibile'])">
				<listhead sizable="true">
					<listheader label="@load(vm.etichette['Codice'])" width="52px"/>
					<listheader label="@load(vm.etichette['Descrizione'])"/>
					<listheader label="@load(vm.etichette['Ente'])"/>
					<listheader label="@load(vm.etichette['Sequenza'])"
								tooltiptext="@load(vm.etichette['Sequenza'])"
								style="text-overflow: ellipsis" width="52px"/>
					<listheader label="" width="52px"/>
				</listhead>
				<template name="model" var="item">
					<listitem onDoubleClick="@command('onModifica')">
						<listcell label="@load(item.comunicazione.id)"/>
						<listcell label="@load(item.comunicazione.descrizione)"/>
						<listcell label="@load(item.ente.descrizione)"/>
						<listcell label="@load(item.sequenza)"/>
						<listcell>
							<button image="/images/icon/action/18x18/edit.png"
									tooltiptext="@load(vm.etichette['modifica_tooltip'])"
									visible="@load(not empty item.id)"
									onClick="@command('onModifica')"/>
						</listcell>
					</listitem>
				</template>
			</listbox>

		</vlayout>

	</window>

</zk>