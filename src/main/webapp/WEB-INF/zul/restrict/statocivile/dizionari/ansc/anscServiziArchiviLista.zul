<?xml version="1.0" encoding="UTF-8"?>
<?taglib uri="http://www.zkoss.org/dsp/web/core" prefix="c"?>

<zk xmlns="http://www.zkoss.org/2005/zul"
    xmlns:h="http://www.w3.org/1999/xhtml"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:w="http://www.zkoss.org/2005/zk/client"
    xsi:schemaLocation="http://www.zkoss.org/2005/zul http://www.zkoss.org/2005/zul/zul.xsd">

    <window viewModel="@id('vm') @init('restrict.statocivile.dizionari.ansc.AnscServiziArchiviListaViewModel')"
            apply="org.zkoss.bind.BindComposer"
            border="none"
            width="100%" height="100%"
            sizable="false" closable="false">

        <hlayout valign="middle">
            <controlBarLista/>

            <label value="@load(vm.formLabel)" sclass="formTitle"/>
        </hlayout>

        <groupbox closable="false">
            <grid sclass="form">
                <rows>
                    <row>
                        <cell align="right" width="80px">
                            <label value="@load(vm.etichette['Archivio'])"/>
                        </cell>
                        <cell>
                            <hlayout hflex="1">
                                <radiogroup model="@load(vm.listaTipiArchivioAnsc)" onCheck="@command('onSelectArchivio')"
                                            selectedItem="@bind(vm.tipoArchivioAnscEnum) @converter('it.finmatica.zk.utils.PropertyConverter', property='id')">
                                    <template name="model">
                                        <radio label="@load(vm.getEtichettaEnum(each))" value="@load(each)" style="padding:20px"/>
                                    </template>
                                </radiogroup>
                            </hlayout>
                        </cell>
                        <!--<cell width="40px">
                            <hlayout valign="middle">
                                <button image="/images/icon/action/16x16/search.png"
                                        tooltiptext="@load(vm.etichette['Effettua_Ricerca'])" onClick="@command('onRicerca')"/>
                            </hlayout>
                        </cell>-->
                    </row>
                </rows>
            </grid>
        </groupbox>

        <vlayout vflex="1">
            <listbox model="@load(vm.lista)" selectedItem="@bind(vm.dettaglio)" nonselectableTags="" vflex="1"
                     emptyMessage="@load(vm.etichette['Nessun_dato_disponibile'])">
                <listhead>
                    <listheader label="@load(vm.etichette['Servizio'])"/>
                    <listheader label="@load(vm.etichette['Sequenza'])" width="100px"/>
                    <listheader width="52px"/>
                </listhead>
                <template name="model" var="item">
                    <listitem>
                        <listcell label="@load(item.servizio.descrizioneEstesa)"/>
                        <listcell label="@load(item.sequenza)"/>
                        <listcell>
                            <button image="/images/icon/action/18x18/edit.png"
                                    tooltiptext="@load(vm.etichette['modifica_tooltip'])"
                                    visible="@load(not empty item)"
                                    onClick="@command('onModifica')"/>
                        </listcell>
                    </listitem>
                </template>
            </listbox>

        </vlayout>

    </window>

</zk>