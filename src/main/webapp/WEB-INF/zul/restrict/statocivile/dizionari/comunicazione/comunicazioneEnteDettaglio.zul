<?xml version="1.0" encoding="UTF-8"?>
<?taglib uri="http://www.zkoss.org/dsp/web/core" prefix="c"?>
<?component name=bandboxComunicazioni extends=bandbox class=it.finmatica.de4gsdzk.zkutils.BandboxComunicazioni?>

<zk xmlns="http://www.zkoss.org/2005/zul"
	xmlns:h="http://www.w3.org/1999/xhtml"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul http://www.zkoss.org/2005/zul/zul.xsd">

	<window viewModel="@id('vm') @init('restrict.statocivile.dizionari.comunicazione.ComunicazioneEnteDettaglioViewModel')"
			apply="org.zkoss.bind.BindComposer"
			contentStyle="overflow:auto;"
			border="none"
			width="100%" height="100%"
			sizable="false" closable="false">

		<vlayout>

		<hlayout valign="middle">
			<controlBarDettaglio/>

			<label value="@load(vm.formLabel)" sclass="formTitle"/>
		</hlayout>

		<grid sclass="form">
			<rows>
				<row>
					<cell align="right" width="150px">
						<label value="@load(vm.etichette['Tipo'])"/>
					</cell>
					<cell>
						<label value="@load(vm.getTipo())" hflex="1"/>
					</cell>
				</row>
				<row>
					<cell align="right" width="150px">
						<h:span class="mandatoryLabel">*</h:span><label value="@load(vm.etichette['Comunicazione'])"/>
					</cell>
					<cell>
						<hlayout valign="middle" hflex="1">
							<bandboxComunicazioni width="400px" style="text-transform:uppercase"
												  value="@load(vm.dettaglio.comunicazione.descrizioneEstesa)"
												  tipoAtto="@load(vm.dettaglio.tipoAtto gt 0?vm.dettaglio.tipoAtto:null)"
												  tipoComunicazione="@load(vm.tipoComunicazione)"
												  disabled="@load(vm.tipoOperazione.isUpdate())"
												  onSelect="@command('onSelectComunicazione')"/>
							<button image="/images/icon/action/16x16/cancel.png"
									visible="@load(vm.tipoOperazione.isInsert())"
									disabled="@load(vm.tipoOperazione.isUpdate())"
									tooltiptext="@load(vm.etichette['Cancella'])" onClick="@command('onCancellaComunicazione')"/>
						</hlayout>
					</cell>
				</row>
				<row>
					<cell align="right" width="150px">
						<h:span class="mandatoryLabel">*</h:span><label value="@load(vm.etichette['Ente'])"/>
					</cell>
					<cell>
						<combobox model="@load(vm.listaEnti)" width="400px" readonly="true"
								  selectedItem="@bind(vm.dettaglio.ente) @converter('it.finmatica.zk.utils.PropertyConverter', property='id')">
							<template name="model">
								<comboitem label="@load(empty each? '- -':each.descrizioneEstesa)" value="@load(each)"/>
							</template>
						</combobox>
					</cell>
				</row>
				<row>
					<cell align="right">
						<h:span class="mandatoryLabel">*</h:span><label value="@load(vm.etichette['Sequenza'])"/>
					</cell>
					<cell>
						<intbox value="@bind(vm.dettaglio.sequenza)" cols="2"/>
					</cell>
				</row>
			</rows>
		</grid>

		<templateIdDomain/>

		</vlayout>

	</window>

</zk>