<?xml version="1.0" encoding="UTF-8"?>
<?taglib uri="http://www.zkoss.org/dsp/web/core" prefix="c"?>

<zk xmlns="http://www.zkoss.org/2005/zul"
	xmlns:h="http://www.w3.org/1999/xhtml"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xmlns:w="http://www.zkoss.org/2005/zk/client"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul http://www.zkoss.org/2005/zul/zul.xsd">

	<window viewModel="@id('vm') @init('restrict.statocivile.dizionari.comunicazione.ComunicazioneDettaglioViewModel')"
			apply="org.zkoss.bind.BindComposer"
			border="none"
			width="100%" height="100%"
			sizable="false" closable="false">

		<hlayout valign="middle">
			<controlBarDettaglio/>

			<label value="@load(vm.formLabel)" sclass="formTitle"/>
		</hlayout>

		<vlayout width="100%">
			<!--<groupbox hflex="1" open="true" closable="false">
			<caption label="@load(vm.etichette['Comunicazione'])"/> -->
				<grid sclass="form">
					<rows>
						<row>
							<cell align="right" width="150px">
								<h:span class="mandatoryLabel">*</h:span><label value="@load(vm.etichette['Codice'])"/>
							</cell>
							<cell  width="300px">
								<intbox value="@bind(vm.dettaglio.id)" cols="2" maxlength="2" disabled="@load(vm.tipoOperazione.isUpdate())"/>
							</cell>
							<cell  width="150px"/>
							<cell/>
						</row>
						<row>
							<cell align="right">
								<h:span class="mandatoryLabel">*</h:span><label value="@load(vm.etichette['Descrizione'])"/>
							</cell>
							<cell colspan="3">
								<textbox value="@bind(vm.dettaglio.descrizione)" hflex="1"/>
							</cell>
						</row>
						<row>
							<cell align="right">
								<h:span class="mandatoryLabel">*</h:span><label value="@load(vm.etichette['Tipo_Comunicazione'])"/>
							</cell>
							<cell colspan="3">
								<combobox model="@load(vm.listaTipiComunicazione)" disabled="@load(vm.tipoOperazione.isUpdate())"
										  selectedItem="@bind(vm.dettaglio.tipoComunicazione) @converter('it.finmatica.zk.utils.PropertyConverter', property='id')">
									<template name="model">
										<comboitem label="@load(vm.getEtichettaEnum(each))" tooltiptext="@load(vm.getEtichettaEnum(each))" value="@load(each)"/>
									</template>
								</combobox>
							</cell>
						</row>
						<row visible="@load(vm.dettaglio.tipoComunicazione.isAnnotazione())">
							<cell align="right">
								<label value="@load(vm.etichette['Modello'])"/>
							</cell>
							<cell>
								<hlayout valign="middle" hflex="1">
									<textbox value="@bind(vm.modelloRelazione.modello.nome)" tooltiptext="@load(vm.modelloRelazione.modello.nome)" width="210px"/>
									<button visible="@bind(not empty vm.modelloRelazione.modello.id)"
											image="/images/icon/action/16x16/import.png"
											tooltiptext="@load(vm.etichette['scarica_modello_tooltip'])"
											onClick="@command('onDownloadAllegato')"/>
									<button image="/images/icon/action/16x16/export.png" upload="true"
											tooltiptext="@load(vm.etichette['inserisci_modello_tooltip'])"
											onUpload="@command('onUploadAllegato')" />
								</hlayout>
							</cell>
							<cell align="right">
								<label value="@load(vm.etichette['Formato_testo'])"/>
							</cell>
							<cell>
								<combobox model="@load(vm.listaFormatiTesto)" readonly="true"
										  selectedItem="@bind(vm.modelloRelazione.modello.formatoTesto)">
									<template name="model">
										<comboitem label="@load(empty each?'- -':each)" value="@load(each)"/>
									</template>
								</combobox>
							</cell>
						</row>
						<row>
							<!--<cell align="right">-->
							<!--	<label value="@load(vm.etichette['Atto_Allegato'])"/>
							</cell>
							<cell>
								<checkbox checked="@bind(vm.dettaglio.attoAllegato)"/>
							</cell> -->
							<cell align="right">
								<label value="@load(vm.etichette['Adempimenti'])"/>
							</cell>
							<cell colspan="3">
								<checkbox checked="@bind(vm.dettaglio.priorita)"/>
							</cell>
						</row>
					</rows>
				</grid>
			<!--</groupbox> -->
		</vlayout>

		<groupbox width="100%" vflex="1" open="true" closable="false">
			<caption label="@load(vm.labelAssociazione)"/>
			<include comunicazione="@load(vm.dettaglio)" opener="@load(vm.self)"
					 src="@load(vm.getUriListaDettaglio())"
					 vflex="1"/>
		</groupbox>

	</window>

</zk>