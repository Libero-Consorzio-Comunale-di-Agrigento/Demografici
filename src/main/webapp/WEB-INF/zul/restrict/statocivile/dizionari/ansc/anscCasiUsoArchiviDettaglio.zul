<?xml version="1.0" encoding="UTF-8"?>
<?taglib uri="http://www.zkoss.org/dsp/web/core" prefix="c"?>

<zk xmlns="http://www.zkoss.org/2005/zul"
    xmlns:h="http://www.w3.org/1999/xhtml"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:w="http://www.zkoss.org/2005/zk/client"
    xsi:schemaLocation="http://www.zkoss.org/2005/zul http://www.zkoss.org/2005/zul/zul.xsd">

    <window viewModel="@id('vm') @init('restrict.statocivile.dizionari.ansc.AnscCasiUsoArchiviDettaglioViewModel')"
            apply="org.zkoss.bind.BindComposer"
            border="none"
            width="100%" height="100%"
            sizable="false" closable="false">

        <hlayout valign="middle">
            <controlBarDettaglio/>

            <label value="@load(vm.formLabel)" sclass="formTitle"/>
        </hlayout>

        <vlayout vflex="1" width="100%" sclass="scroll">
            <grid sclass="form">
                <columns>
                    <column width="200px"/>
                    <column/>
                </columns>
                <rows>
                    <row>
                        <cell align="right">
                            <label value="@load(vm.etichette['Archivio'])"/>
                        </cell>
                        <cell>
                            <label value="@load(vm.getEtichettaEnum(vm.tipoArchivioAnsc))"/>
                        </cell>
                    </row>
                    <row>
                        <cell align="right">
                            <customLabel mandatory="true" value="@load(vm.etichette['Caso_Uso_Ansc'])"/>
                        </cell>
                        <cell>
                            <combobox model="@load(vm.listaCasiUso)" readonly="true" hflex="1"
                                      selectedItem="@bind(vm.casoUso)  @converter('it.finmatica.zk.utils.PropertyConverter', property='id')">
                                <template name="model">
                                    <comboitem label="@load(each.descrizioneEstesa)"
                                               value="@load(each)"/>
                                </template>
                            </combobox>
                        </cell>
                    </row>
                    <row>
                        <cell align="right">
                            <customLabel mandatory="true" value="@load(vm.etichette['Servizio'])"/>
                        </cell>
                        <cell>
                            <combobox model="@load(vm.listaServizi)" readonly="true" hflex="1"
                                      selectedItem="@bind(vm.dettaglio.servizio) @converter('it.finmatica.zk.utils.PropertyConverter', property='id')">
                                <template name="model">
                                    <comboitem label="@load(empty each ? '- -' :each.descrizioneEstesa)" value="@load(each)"/>
                                </template>
                            </combobox>
                        </cell>
                    </row>
                    <row>
                        <cell align="right">
                            <label value="@load(vm.etichette['Servizio_Precedente'])"/>
                        </cell>
                        <cell>
                            <combobox model="@load(vm.listaServizi)" readonly="true" hflex="1"
                                      selectedItem="@bind(vm.dettaglio.servizioPrecedente) @converter('it.finmatica.zk.utils.PropertyConverter', property='id')">
                                <template name="model">
                                    <comboitem label="@load(empty each ? '- -' :each.descrizioneEstesa)" value="@load(each)"/>
                                </template>
                            </combobox>
                        </cell>
                    </row>
                    <row>
                        <cell align="right">
                            <label value="@load(vm.etichette['Sequenza'])"/>
                        </cell>
                        <cell>
                            <intbox value="@bind(vm.dettaglio.sequenza)" maxlength="3"/>
                        </cell>
                    </row>
                    <row visible="@bind(vm.tipoOperazione.isUpdate())">
                        <cell align="right">
                            <label value="@load(vm.etichette['Tipo_Evento'])"/>
                        </cell>
                        <cell>
                            <textbox value="@bind(vm.dettaglio.tipoEvento)" readonly="true"/>
                        </cell>
                    </row>
                </rows>
            </grid>
        </vlayout>

    </window>

</zk>