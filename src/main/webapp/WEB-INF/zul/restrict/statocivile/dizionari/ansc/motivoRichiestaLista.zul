<?xml version="1.0" encoding="UTF-8"?>
<?taglib uri="http://www.zkoss.org/dsp/web/core" prefix="c"?>

<zk xmlns="http://www.zkoss.org/2005/zul"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.zkoss.org/2005/zul http://www.zkoss.org/2005/zul/zul.xsd">

    <window viewModel="@id('vm') @init('restrict.statocivile.dizionari.ansc.MotivoRichiestaListaViewModel')"
            apply="org.zkoss.bind.BindComposer"
            border="none"
            width="100%" height="100%"
            sizable="false" closable="false">

        <vlayout vflex="1">

            <hlayout valign="middle">
                <controlBarLista/>

                <label value="@load(vm.formLabel)" sclass="formTitle"/>
            </hlayout>
            <groupbox closable="false">
                <grid sclass="form">
                    <rows>
                        <row>
                            <cell align="right" width="120px">
                                <label value="@load(vm.etichette['Tipi_di_Atto'])"/>
                            </cell>
                            <cell hflex="6">
                                <hlayout hflex="1">
                                    <radiogroup model="@load(vm.listaTipiAtto)" onCheck="@command('onSelectTipoAtto')"
                                                selectedItem="@bind(vm.tipoAttoEnum) @converter('it.finmatica.zk.utils.PropertyConverter', property='id')">
                                        <template name="model">
                                            <radio label="@load(vm.getEtichettaPluralEnum(each) )" value="@load(each)"
                                                   style="padding:20px"/>
                                        </template>
                                    </radiogroup>
                                </hlayout>
                            </cell>
                        </row>
                    </rows>
                </grid>
            </groupbox>

            <totalSizeBlock/>

            <listbox model="@load(vm.lista)" selectedItem="@bind(vm.dettaglio)" nonselectableTags="" vflex="1"
                     emptyMessage="@load(vm.etichette['Nessun_dato_disponibile'])">
                <listhead>
                    <listheader label="@load(vm.etichette['Codice'])" width="10%"/>
                    <listheader label="@load(vm.etichette['Descrizione'])"/>
                    <listheader label="@load(vm.etichette['Tipo'])"         width="120px"/>
                    <listheader label="@load(vm.etichette['Ricorrente'])"   width="100px"/>
                    <listheader label="" width="52px"/>
                </listhead>
                <template name="model" var="item">
                    <listitem onDoubleClick="@command('onModifica')">
                        <listcell label="@load(item.id)"/>
                        <listcell label="@load(item.descrizione)"/>
                        <listcell label="@load(vm.getEtichettaEnum(item.tipoRichiesta))"/>
                        <listcell sclass="testo-al-centro">
                            <checkbox checked="@load(item.flagRicorrente)" disabled="true"/>
                        </listcell>
                        <listcell>
                            <button image="/images/icon/action/18x18/edit.png"
                                    tooltiptext="@load(vm.etichette['modifica_tooltip'])"
                                    visible="@load(not empty item.id)"
                                    onClick="@command('onModifica')"/>
                        </listcell>
                    </listitem>
                </template>
            </listbox>

        </vlayout>

    </window>

</zk>