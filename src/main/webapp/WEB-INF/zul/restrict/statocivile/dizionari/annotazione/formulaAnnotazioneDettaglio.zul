<?xml version="1.0" encoding="UTF-8"?>
<?taglib uri="http://www.zkoss.org/dsp/web/core" prefix="c"?>
<?component name=bandboxCampiAnnotazione extends=bandbox class=it.finmatica.de4gsdzk.zkutils.BandboxCampiAnnotazione?>

<zk xmlns="http://www.zkoss.org/2005/zul"
	xmlns:h="http://www.w3.org/1999/xhtml"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xmlns:w="http://www.zkoss.org/2005/zk/client"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul http://www.zkoss.org/2005/zul/zul.xsd">

	<window viewModel="@id('vm') @init('restrict.statocivile.dizionari.annotazione.FormulaAnnotazioneDettaglioViewModel')"
			apply="org.zkoss.bind.BindComposer"
			border="none"
			width="100%" height="100%"
			sizable="false" closable="false">

		<vlayout sclass="bordered-container" vflex="1">

			<hlayout valign="middle">
				<controlBarDettaglio/>

				<label value="@load(vm.formLabel)" sclass="formTitle"/>
			</hlayout>

			<vlayout sclass="scroll" vflex="1" >

				<grid sclass="form">
					<rows>
						<row>
							<cell align="right" width="150px">
								<label value="@load(vm.etichette['Tipo_Atto'])"/>
							</cell>
							<cell>
								<label value="@load(vm.getEtichettaEnum(vm.dettaglio.getTipoAttoEnum()))" hflex="1"/>
							</cell>
						</row>
						<row>
							<cell align="right">
								<h:span class="mandatoryLabel">*</h:span><label value="@load(vm.etichette['Formula'])"/>
							</cell>
							<cell>
								<textbox value="@bind(vm.dettaglio.id)" disabled="@load(vm.tipoOperazione.isUpdate())"
										 maxlength="10" style="text-transform:uppercase"/>
							</cell>
						</row>
						<row>
							<cell align="right">
								<h:span class="mandatoryLabel">*</h:span><label value="@load(vm.etichette['Descrizione'])"/>
							</cell>
							<cell>
								<textbox value="@bind(vm.dettaglio.descrizione)" hflex="1" rows="3" style="text-transform:uppercase"/>
							</cell>
						</row>
						<row>
							<cell align="right">
								<h:span class="mandatoryLabel">*</h:span><label value="@load(vm.etichette['Tipo'])"/>
							</cell>
							<cell>
								<combobox model="@load(vm.listaTipoAnnotazione)" readonly="true"
										  selectedItem="@bind(vm.dettaglio.tipoAnnotazione) @converter('it.finmatica.zk.utils.PropertyConverter', property='id')">
									<template name="model">
										<comboitem label="@load(vm.getEtichettaEnum(each))" tooltiptext="@load(vm.getEtichettaEnum(each))" value="@load(each)"/>
									</template>
								</combobox>
							</cell>
						</row>
						<row>
							<cell align="right">
								<label value="@load(vm.etichette['Genere'])"/>
							</cell>
							<cell>
								<combobox model="@load(vm.listaGenereAnnotazione)" readonly="true"
										  selectedItem="@bind(vm.dettaglio.genere) @converter('it.finmatica.zk.utils.PropertyConverter', property='id')">
									<template name="model">
										<comboitem label="@load(empty each?'- -':vm.getEtichettaEnum(each))" tooltiptext="@load(vm.getEtichettaEnum(each))" value="@load(each)"/>
									</template>
								</combobox>
							</cell>
						</row>
						<row>
							<cell align="right">
								<label value="@load(vm.etichette['Istat'])"/>
							</cell>
							<cell>
								<checkbox checked="@bind(vm.dettaglio.flagIstat)"/>
							</cell>
						</row>
						<zk if="${vm.anscOn}">
							<row>
								<cell align="right">
									<label value="@load(vm.etichette['Secretato'])"/>
								</cell>
								<cell>
									<checkbox checked="@bind(vm.dettaglio.flagSecretato)"/>
								</cell>
							</row>
						</zk>
						<row>
							<cell align="right">
								<label value="@load(vm.etichette['Nuovo_Ordinamento'])"/>
							</cell>
							<cell>
								<checkbox checked="@bind(vm.dettaglio.nuovoOrdinamento)"/>
							</cell>
						</row>
						<row>
							<cell align="right">
								<label value="@load(vm.etichette['Testo'])"/>
							</cell>
							<cell>
								<vlayout sclass="testo-annotazione">
									<vlayout children="@load(vm.listaFrammentiFormula)">
										<template name="children" var="item">
											<hlayout hflex="1" valign="middle">

												<textbox value="@bind(item.testoFisso)"  hflex="1" rows="3"
														 placeholder="@load(empty item.notaFormula?vm.etichette['Eventuale_Testo_fisso_finale']:vm.etichette['Eventuale_Testo_fisso'])"/>

												<hlayout sclass="campo-nota-annotazione" valign="bottom" hflex="1"
														 visible="@load(not empty item.notaFormula)">
													<textbox placeholder="@load(c:cat4((empty item.notaFormula.testoVariabile?'':item.notaFormula.testoVariabile),(empty item.notaFormula.note?'':' [...'), item.notaFormula.note, (empty item.notaFormula.note?'':'...]') ))"
															 hflex="1"
															 rows="3"
															 mold="default"
															 readonly="true"
															 style="border-width:0px;"/>
													<button image="/images/icon/show/10x10/point_blue.png"
														   	sclass="toolbar-mini-button"
															tooltiptext="@load(item.notaFormula.variabile)"
														   	onClick="@command('onShowHelp', notaFormula=item.notaFormula)"/>
												</hlayout>
											</hlayout>
										</template>
									</vlayout>

									<hlayout sclass="navigazione" valign="middle">
										<hlayout sclass="afc-control-bar" valign="middle">
											<toolbarbutton image="/images/icon/action/16x16/add.png"
														   tooltiptext="@load(vm.etichette['inserisci_tooltip'])"
														   onClick="@command('onAddNotaFormula')" />
											<toolbarbutton image="/images/icon/action/16x16/minus.png"
														   tooltiptext="@load(vm.etichette['elimina_tooltip'])"
														   onClick="@command('onRemoveNotaFormula')" />
											<toolbarbutton image="/images/icon/action/22x22/note.png"
														   tooltiptext="@load(vm.etichette['anteprima_testo_tooltip'])"
														   onClick="@command('onShowAnteprima')"/>
										</hlayout>
									</hlayout>

									<popup use="it.finmatica.de4gsdzk.zkutils.CustomPopup" id="ppNota" width="450px">
										<vlayout>
											<grid sclass="form">
												<rows>
													<row>
														<cell align="right" width="30%">
															<label value="@load(vm.etichette['Descrizione'])"/>
														</cell>
														<cell>
															<textbox value="@bind(vm.ppNota.notaFormula.note)" hflex="1"/>
														</cell>
													</row>
													<row>
														<cell align="right">
															<label value="@load(vm.etichette['Valore'])"/>
														</cell>
														<cell>
															<hlayout valign="middle" hflex="1">
																<bandboxCampiAnnotazione width="225px" style="text-transform:uppercase"
																						 value="@bind(vm.ppNota.notaFormula.testoVariabile)"
																						 tipoAtto="@load(vm.dettaglio.tipoAtto)"
																						 campoDb="VARIABILE"
																						 onSelect="@command('onSelectCampoAnnotazione', ppNota=vm.ppNota, campo='testoVariabile')"/>
																<button image="/images/icon/action/16x16/cancel.png"
																		tooltiptext="@load(vm.etichette['Cancella'])" onClick="@command('onCancellaCampoAnnotazione', ppNota=vm.ppNota, campo='testoVariabile')"/>
															</hlayout>
														</cell>
													</row>
													<row>
														<cell align="right">
															<label value="@load(vm.etichette['Testo_Fisso_Maschile'])"/>
														</cell>
														<cell>
															<textbox value="@bind(vm.ppNota.notaFormula.testoMaschile)" hflex="1"/>
														</cell>
													</row>
													<row>
														<cell align="right">
															<label value="@load(vm.etichette['Testo_Fisso_Femminile'])"/>
														</cell>
														<cell>
															<textbox value="@bind(vm.ppNota.notaFormula.testoFemminile)" hflex="1"/>
														</cell>
													</row>
                                                    <zk if="${vm.annotazioniAutomaticheEnabled}">
                                                        <row>
                                                            <cell colspan="2">
                                                                <groupbox closable="true" open="true">
                                                                    <caption label="Configurazione annotazioni automatiche"/>
                                                                    <grid sclass="form">
                                                                        <rows>
                                                                            <row>
                                                                                <cell align="right" width="28%">
                                                                                    <label value="@load(vm.etichette['Testo_fisso'])"/>
                                                                                </cell>
                                                                                <cell>
                                                                                    <textbox value="@bind(vm.ppNota.notaFormula.testoAutomatico)" hflex="1"/>
                                                                                </cell>
                                                                            </row>
                                                                            <row>
                                                                                <cell align="right">
                                                                                    <label value="@load(vm.etichette['Valore'])"/>
                                                                                </cell>
                                                                                <cell>
                                                                                    <hlayout valign="middle" hflex="1">
                                                                                        <bandboxCampiAnnotazione width="225px" style="text-transform:uppercase"
                                                                                                                 value="@bind(vm.ppNota.notaFormula.testoVariabileAutomatico)"
                                                                                                                 tipoAtto="@load(vm.dettaglio.tipoAtto)"
                                                                                                                 campoDb="VARIABILE_AUTO"
                                                                                                                 onSelect="@command('onSelectCampoAnnotazione', ppNota=vm.ppNota, campo='testoVariabileAutomatico')"/>
                                                                                        <button image="/images/icon/action/16x16/cancel.png"
                                                                                                tooltiptext="@load(vm.etichette['Cancella'])" onClick="@command('onCancellaCampoAnnotazione', ppNota=vm.ppNota, campo='testoVariabileAutomatico')"/>
                                                                                    </hlayout>
                                                                                </cell>
                                                                            </row>
                                                                        </rows>
                                                                    </grid>
                                                                </groupbox>
                                                            </cell>
                                                        </row>
                                                    </zk>
												</rows>
											</grid>
											<h:div sclass="barraPulsanti">
												<h:div>
													<button label="@load(vm.etichette['Chiudi'])" onClick="@command('onCloseHelp')"/>
												</h:div>
											</h:div>
										</vlayout>
									</popup>

									<popup use="it.finmatica.de4gsdzk.zkutils.CustomPopup" id="ppAnteprima" width="450px">
										<vlayout>
											<!--<label value="@load(vm.etichette['Testo'])"/>-->
											<grid sclass="form">
												<rows>
													<row>
														<cell>
															<label value="@load(vm.ppAnteprima.testo)" hflex="1"/>
														</cell>
													</row>
												</rows>
											</grid>
											<h:div sclass="barraPulsanti">
												<h:div>
													<button label="@load(vm.etichette['Chiudi'])" onClick="@command('onCloseAnteprima')"/>
												</h:div>
											</h:div>
										</vlayout>
									</popup>
								</vlayout>
							</cell>
						</row>
					</rows>
				</grid>
			</vlayout>

		</vlayout>

	</window>

</zk>