<?xml version="1.0" encoding="UTF-8"?>
<?taglib uri="http://www.zkoss.org/dsp/web/core" prefix="c"?>
<?xel-method prefix="x" name="min" class="java.lang.Math" signature="int min(int,int)"?>

<zk xmlns="http://www.zkoss.org/2005/zul"
	xmlns:h="http://www.w3.org/1999/xhtml"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul http://www.zkoss.org/2005/zul/zul.xsd">

	<window viewModel="@id('vm') @init('restrict.statocivile.dizionari.comunicazioni.ComunicazioneListaViewModel')"
			apply="org.zkoss.bind.BindComposer"
			border="none"
			width="100%" height="100%"
			sizable="false" closable="false">

		<vlayout vflex="1">

			<hlayout valign="middle">
				<controlBarLista/>

				<label value="@load(vm.formLabel)" sclass="formTitle"/>
			</hlayout>

			<groupbox closable="false">
				<grid sclass="form">
					<rows>
						<row>
							<cell align="right" width="60px">
								<label value="@load(vm.etichette['Tipo'])"/>
							</cell>
							<cell>
								<hlayout hflex="1">
									<radiogroup model="@load(vm.listaTipiComunicazione)" onCheck="@command('onSelectTipoComunicazione')"
												selectedItem="@bind(vm.tipoComunicazione) @converter('it.finmatica.zk.utils.PropertyConverter', property='id')">
										<template name="model">
											<radio label="@load(vm.getEtichettaEnum(each))" value="@load(each)" style="padding:10px"/>
										</template>
									</radiogroup>
								</hlayout>
							</cell>
							<!--cell width="40px"/>-->
						</row>
						<row visible="@load(not empty vm.tipoComunicazione and not vm.tipoComunicazione.isAnnotazione())">
							<cell align="right" width="60px">
								<label value="@load(vm.etichette['Tipo_Atto'])"/>
							</cell>
							<cell>
								<hlayout hflex="1">
									<radiogroup model="@load(vm.listaTipiAtto)" onCheck="@command('onRicarica')"
												selectedItem="@bind(vm.tipoAttoEnum) @converter('it.finmatica.zk.utils.PropertyConverter', property='id')">
										<template name="model">
											<radio label="@load(empty each? vm.etichette['Tutti']:vm.getEtichettaEnum(each))" value="@load(each)" style="padding:10px"/>
										</template>
									</radiogroup>
								</hlayout>
							</cell>
							<!--cell width="40px"/>-->
						</row>
						<row visible="@load(not empty vm.tipoComunicazione and vm.tipoComunicazione.isAnnotazione())">
							<cell align="right" width="60px">
								<label value="@load(vm.etichette['Formula'])"/>
							</cell>
							<cell>
								<hlayout valign="middle" hflex="1">
									<bandboxAnnotazioni width="580px"
														value="@load(vm.formulaDfa.descrizioneEstesa)"
														listaTipoAnnotazione="@load(vm.listaTipoAnnotazione)"
														tipoOrdinamentoDefaultValue="@load(vm.tipoOrdinamentoDefaultValue)"
														onSelect="@command('onSelectFormulaAnnotazione')"/>
									<button image="/images/icon/action/16x16/cancel.png"
											tooltiptext="@load(vm.etichette['Cancella'])" onClick="@command('onCancellaFormulaAnnotazione')"/>
								</hlayout>
							</cell>
						<!--<cell>
                            <hlayout valign="middle">
                                <button image="/images/icon/action/16x16/search.png"
                                        tooltiptext="@load(vm.etichette['Effettua_Ricerca'])" onClick="@command('onRicerca')"/>
                            </hlayout>
                        </cell>-->
                    </row>
					</rows>
				</grid>
			</groupbox>

			<orderByBlock/>

			<listbox model="@load(vm.lista)" selectedItem="@bind(vm.dettaglio)" nonselectableTags="" vflex="1"
					 emptyMessage="@load(vm.etichette['Nessun_dato_disponibile'])">
				<listhead>
					<listheader label="@load(vm.etichette['Codice'])" width="52px"/>
					<listheader label="@load(vm.etichette['Descrizione'])"/>
					<listheader label="@load(vm.etichette['Tipo_Comunicazione'])" width="104px"
								tooltiptext="@load(vm.etichette['Tipo_Comunicazione'])"
								style="text-overflow: ellipsis"/>
					<listheader label="@load(vm.etichette['Adempimenti'])" width="78px"
								tooltiptext="@load(vm.etichette['Adempimenti'])"
								style="text-overflow: ellipsis"/>
					<listheader label="@load(vm.etichette['Associazioni'])"/>
					<listheader label="" width="52px"/>
				</listhead>
				<template name="model" var="item">
					<listitem onDoubleClick="@command('onModifica')">
						<listcell label="@load(item.getFirst().id)"/>
						<listcell label="@load(item.getFirst().descrizione)"/>
						<listcell label="@load(vm.getEtichettaEnum(item.getFirst().tipoComunicazione) )"/>
						<listcell sclass="testo-al-centro">
							<checkbox checked="@load(item.getFirst().priorita)" disabled="true"/>
						</listcell>
						<listcell>
							<listbox model="@load(item.getSecond())" emptyMessage="@load(vm.etichette['Nessun_dato_disponibile'])"
									 rows="@load(x:min(item.getSecond().size(),4))">
								<template name="model" var="subItem">
									<listitem>
										<listcell label="@load(vm.getSubItemText(subItem))"
												  tooltiptext="@load(vm.getSubItemText(subItem))"/>
									</listitem>
								</template>
							</listbox>
						</listcell>
						<listcell>
							<button image="/images/icon/action/18x18/edit.png"
								   tooltiptext="@load(vm.etichette['modifica_tooltip'])"
								   onClick="@command('onModifica')"/>
						</listcell>
					</listitem>
				</template>
			</listbox>

		</vlayout>

	</window>

</zk>