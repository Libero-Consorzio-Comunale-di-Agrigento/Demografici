<?xml version="1.0" encoding="UTF-8"?>
<?taglib uri="http://www.zkoss.org/dsp/web/core" prefix="c"?>

<zk xmlns="http://www.zkoss.org/2005/zul"
	xmlns:h="http://www.w3.org/1999/xhtml"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul http://www.zkoss.org/2005/zul/zul.xsd">

	<window viewModel="@id('vm') @init('restrict.statocivile.dizionari.tipoAtto.RichiamoFormulaDettaglioViewModel')"
			apply="org.zkoss.bind.BindComposer"
			border="none"
			width="100%" height="100%"
			sizable="false" closable="false">


		<hlayout valign="middle">
			<controlBarRichiamo/>

			<label value="@load(vm.formLabel)" sclass="formTitle"/>
		</hlayout>

		<vlayout width="100%">
			<groupbox hflex="1" open="true" closable="false">
				<caption label="@load(vm.etichette['Richiamo'])"/>
				<grid sclass="form">
					<rows>
						<row>
							<cell align="right" width="170px">
								<label value="@load(vm.etichette['Tipo_Atto'])"/>
							</cell>
							<cell width="200px">
								<label value="@load(vm.getEtichettaEnum(vm.tipoAttoEnum))" hflex="1"/>
							</cell>
							<cell width="150px"/>
							<cell/>
						</row>
						<row>
							<cell align="right" width="170px">
								<label value="@load(vm.etichette['Descrizione'])"/>
							</cell>
							<cell colspan="3">
								<label value="@load(vm.richiamoComposizione.descrizione)" hflex="1"/>
							</cell>
						</row>
						<row>
							<cell align="right">
								<label value="@load(vm.etichette['Richiamo'])"/>
							</cell>
							<cell>
								<intbox value="@load(vm.dettaglio.richiamo)" disabled="true"/>
							</cell>
							<cell align="right">
								<label value="@load(vm.etichette['Progressivo'])"/>
							</cell>
							<cell>
								<intbox value="@load(vm.dettaglio.progressivo)" disabled="true"/>
							</cell>
						</row>
					</rows>
				</grid>
			</groupbox>
		</vlayout>

		<vlayout vflex="1" width="100%" sclass="scroll">
			<groupbox hflex="1" open="true" closable="false">
				<caption label="@load(vm.etichette['Formula_Associata'])"/>
				<grid sclass="form">
					<rows>
						<row>
							<cell align="right" width="170px">
								<h:span class="mandatoryLabel">*</h:span><label value="@load(vm.etichette['Formula'])"/>
							</cell>
							<cell colspan="5">
								<hlayout valign="middle" hflex="1">
									<bandboxFormule width="780px"
													value="@load(vm.dettaglio.formula.descrizioneEstesa)"
													tipoAtto="@load(vm.dettaglio.tipoAtto)"
													listaTipoAnnotazione="@load(vm.listaTipoAnnotazione)"
													onSelect="@command('onSelectFormulaRichiamo')"
													disabled="@load(vm.tipoOperazione.isUpdate())"/>
									<button image="/images/icon/action/16x16/cancel.png"
											tooltiptext="@load(vm.etichette['Cancella'])"
											onClick="@command('onCancellaFormulaRichiamo')"
											visible="@load(vm.tipoOperazione.isInsert())"/>
								</hlayout>
							</cell>
						</row>
						<row>
							<cell align="right">
								<label value="@load(vm.etichette['Descrizione'])"/>
							</cell>
							<cell colspan="5">
								<textbox value="@load(vm.dettaglio.formula.descrizione)" hflex="1" disabled="true" rows="2"/>
							</cell>
						</row>
						<row>
							<cell align="right">
								<label value="@load(vm.etichette['Default'])"/>
							</cell>
							<cell colspan="1">
								<checkbox checked="@bind(vm.dettaglio.predefinito)" />
							</cell>
							<cell align="right">
								<label value="@load(vm.etichette['Ricorrente'])"/>
							</cell>
							<cell colspan="1">
								<checkbox checked="@bind(vm.dettaglio.ricorrente)" />
							</cell>
							<cell align="right">
								<label value="@load(vm.etichette['Testo_fisso'])"/>
							</cell>
							<cell colspan="1">
								<checkbox checked="@bind(vm.dettaglio.testoFisso)" />
							</cell>
						</row>
						<row>
							<cell align="right">
								<label value="@load(vm.etichette['Testo_ACapo'])"/>
							</cell>
							<cell colspan="5">
								<checkbox checked="@bind(vm.dettaglio.aCapo)" />
							</cell>
						</row>
						<row>
							<cell align="right">
								<label value="@load(vm.etichette['Testo'])"/>
							</cell>
							<cell colspan="5">
								<borderlayout height="280px">
									<north height="18px" visible="@load(not empty vm.notaTesto)">
										<label sclass="redText" value="@load(vm.notaTesto)"/>
									</north>
									<center autoscroll="true">
										<textbox id="testoConVariabili" droppable="true" value="@bind(vm.dettaglio.formula.testo.testoA4)"
												 rows="20" hflex="1" vflex="1" disabled="@load(!vm.testoEditabile)"/>
									</center>
									<east collapsible="true" open="@load(vm.testoEditabile)">
										<templateListaStringhe/>
									</east>
								</borderlayout>
							</cell>
						</row>
					</rows>
				</grid>

				<templateIdDomain/>
			</groupbox>
		</vlayout>

	</window>

</zk>