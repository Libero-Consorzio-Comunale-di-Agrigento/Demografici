<?xml version="1.0" encoding="UTF-8"?>
<?taglib uri="http://www.zkoss.org/dsp/web/core" prefix="c"?>

<zk xmlns="http://www.zkoss.org/2005/zul"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul http://www.zkoss.org/2005/zul/zul.xsd">

    <hlayout spacing="40px">

        <hlayout valign="middle" spacing="8px">
            <label value="@load(vm.etichette['Ufficio'])"/>
            <label value="@load(vm.datiProvenienza.ufficioAttoOriginale)" sclass="grassetto"/>
        </hlayout>

        <hlayout valign="middle" spacing="8px">
            <label value="@load(vm.etichette['Anno'])"/>
            <label value="@load(vm.datiProvenienza.annoAttoOriginale)" sclass="grassetto"/>
        </hlayout>

        <hlayout valign="middle" spacing="8px">
            <label value="@load(vm.etichette['Numero_Atto'])"/>
            <label value="@load(vm.datiProvenienza.attoAttoOriginale)" sclass="grassetto" visible="@load(vm.datiProvenienza.attoAttoOriginale gt 0)" />
            <label value="@load(vm.etichette['Provvisorio'])" sclass="grassetto" visible="@load(vm.datiProvenienza.attoAttoOriginale le 0)"/>
        </hlayout>

        <hlayout valign="middle" spacing="8px">
            <label value="@load(vm.etichette['Parte'])"/>
            <label value="@load(vm.datiProvenienza.parteAttoOriginale)" sclass="grassetto"/>
        </hlayout>

        <hlayout valign="middle" spacing="8px">
            <label value="@load(vm.etichette['Serie'])"/>
            <label value="@load(vm.datiProvenienza.serieAttoOriginale)" sclass="grassetto"/>
        </hlayout>

        <hlayout valign="middle" spacing="8px">
            <label value="@load(vm.etichette['Comune'])"
                   visible="@load(not empty vm.datiProvenienza.comuneAttoOriginale.descrizione or not empty vm.datiProvenienza.comuneAttoOriginale.siglaProvincia)"/>
            <label value="@load(c:cat4(vm.datiProvenienza.comuneAttoOriginale.descrizione, ' (', vm.datiProvenienza.comuneAttoOriginale.siglaProvincia, ')'))"
                   visible="@load(not empty vm.datiProvenienza.comuneAttoOriginale.descrizione or not empty vm.datiProvenienza.comuneAttoOriginale.siglaProvincia)" sclass="grassetto"/>
        </hlayout>

    </hlayout>

</zk>