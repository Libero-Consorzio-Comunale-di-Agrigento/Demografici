<?xml version="1.0" encoding="UTF-8"?>
<?taglib uri="http://www.zkoss.org/dsp/web/core" prefix="c"?>
<?component name="templateComunicazioniAtto" macroURI="/restrict/statocivile/templateComunicazioniAtto.zul" inline="true"?>

<zk xmlns="http://www.zkoss.org/2005/zul"
	xmlns:h="http://www.w3.org/1999/xhtml"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xmlns:w="http://www.zkoss.org/2005/zk/client"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul http://www.zkoss.org/2005/zul/zul.xsd">

	<window viewModel="@id('vm') @init('restrict.statocivile.comunicazioni.ArchivioComunicazioniXDestinatarioListaViewModel')"
			apply="org.zkoss.bind.BindComposer"
			border="none"
			width="100%" height="100%"
			sizable="false" closable="false">

		<hlayout valign="middle">
			<controlBarComunicazioni/>

			<label value="@load(vm.formLabel)" sclass="formTitle"/>
		</hlayout>

		<groupbox closable="false">
			<grid sclass="form">
				<rows>

					<templateRowTipoAttoRicerca/>

					<row>
						<cell align="right">
							<label value="@load(vm.etichette['Destinatario'])"/>
						</cell>
						<cell>
							<combobox model="@load(vm.destinatariLista)" readonly="true" width="350px"
									  onChange="@command('onSelectDestinatario')"
									  selectedItem="@bind(vm.destinatarioSelezionato) @converter('it.finmatica.zk.utils.PropertyConverter', property='id')">
								<template name="model">
									<comboitem label="@load(each.denominazione)" value="@load(each)" />
								</template>
							</combobox>
						</cell>
						<!--<cell align="right">
							<hlayout valign="middle">
								<button image="/images/icon/action/16x16/search.png"
										tooltiptext="@load(vm.etichette['Effettua_Ricerca'])" onClick="@command('onRicerca')"/>
							</hlayout>
						</cell>-->
					</row>
				</rows>
			</grid>
		</groupbox>

		<orderByBlock/>

		<templateComunicazioniAtto/>

	</window>

</zk>