<?xml version="1.0" encoding="UTF-8"?>
<?taglib uri="http://www.zkoss.org/dsp/web/core" prefix="c"?>

<zk xmlns="http://www.zkoss.org/2005/zul"
	xmlns:h="http://www.w3.org/1999/xhtml"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul http://www.zkoss.org/2005/zul/zul.xsd">

	<window viewModel="@id('vm') @init('restrict.statocivile.FirmatariANSCListaViewModel')"
			apply="org.zkoss.bind.BindComposer"
			border="none"
			width="100%" height="100%"
			sizable="false" closable="false">

		<hlayout valign="middle">
			<controlBarANSC/>

			<label value="@load(vm.formLabel)" sclass="formTitle"/>

			<estremiAttoFormLabel/>

		</hlayout>

		<vlayout vflex="1" width="100%" sclass="scroll">

			<totalSizeBlock/>

			<grid model="@load(vm.lista)" vflex="1" emptyMessage="@load(vm.etichette['Nessun_dato_disponibile'])">
				<columns>
				    <column label="@load(vm.etichette['Firmatario'])"        width="150px"/>
					<column label="@load(vm.etichette['Cognome'])"/>
					<column label="@load(vm.etichette['Nome'])"/>
					<column label="@load(vm.etichette['Data_Nascita'])" width="110px"/>
					<column label="@load(vm.etichette['Tipo_firma'])"   width="140px"/>
					<column label="@load(vm.etichette['Email'])"/>
					<!--<column label=""                                    width="50px"/> -->
				</columns>
				<template name="model" var="item">
					<row>
					    <cell>
                            <label value="@load(item.descrizioneRuolo)"/>
                        </cell>
						<cell>
                            <label value="@load(item.cognome)"/>
                        </cell>
						<cell>
                            <label value="@load(item.nome)"/>
                        </cell>
						<cell>
                            <label value="@load(empty item.dataNascita? null:(c:formatDate(item.dataNascita, 'dd/MM/yyyy')))"/>
                        </cell>
                        <cell>
                            <combobox model="@load(vm.listaTipoFirma)" readonly="true" hflex="1"
                                      selectedItem="@bind(item.tipoFirma) @converter('it.finmatica.zk.utils.PropertyConverter', property='id')">
                                <template name="model">
                                    <comboitem label="@load(empty each?'- -':vm.getEtichettaEnum(each))" value="@load(each)"/>
                                </template>
                            </combobox>
                        </cell>
                        <cell>
                            <textbox value="@bind(item.indirizzoMail)" inplace="true" width="98%"
                                     readonly="@load(item.tipoFirma eq 'CA')" placeholder="@load(item.tipoFirma eq 'EL'?'Compilare indirizzo e-mail':'')"/>
                        </cell>
                        <!-- se non viene lanciato il servizio di verifica non sappiamo con certezza in che stato è la presa visione
                        <cell>
                            <button image="/images/icon/action/18x18/ok.png"
                                    tooltiptext="@load(vm.etichette['Inviato'])"
                                    visible="@load(not empty item.idAnscPresaVisione)"/>
                        </cell> -->
					</row>
				</template>
			</grid>

		</vlayout>

	</window>

</zk>