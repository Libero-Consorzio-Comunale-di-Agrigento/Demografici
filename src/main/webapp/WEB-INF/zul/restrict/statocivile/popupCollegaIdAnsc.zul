<?xml version="1.0" encoding="UTF-8"?>
<?taglib uri="http://www.zkoss.org/dsp/web/core" prefix="c"?>

<zk xmlns="http://www.zkoss.org/2005/zul"
    xmlns:h="http://www.w3.org/1999/xhtml"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.zkoss.org/2005/zul http://www.zkoss.org/2005/zul/zul.xsd">

    <window apply="org.zkoss.bind.BindComposer"
            viewModel="@id('vm') @init('restrict.statocivile.PopupCollegaIdAnscViewModel')"
            title="@load(vm.etichette['Collega_Ansc'])"
            width="500px"
            border="normal"
            closable="false"
            sizable="false">

        <grid sclass="form">
            <rows>
                <row>
                    <cell align="right" hflex="1">
                        <customLabel mandatory="true" value="Id ANSC"/>
                    </cell>
                    <cell hflex="3">
                        <hlayout valign="middle">
                            <textbox value="@bind(vm.newIdAnsc)" hflex="1"/>
                            <button image="/images/icon/action/16x16/cancel.png"
									tooltiptext="@load(vm.etichette['Cancella'])"
									onClick="@command('onCancellaCampoPopup')">
								<custom-attributes proprieta="newIdAnsc"/>
							</button>
                        </hlayout>
                    </cell>
                </row>
            </rows>
        </grid>

        <h:div sclass="barraPulsanti">
            <h:div>
                <button label="@load(vm.etichette['Salva'])" onClick="@command('onSalva')"
                        image="/images/icon/action/16x16/save.png"/>
                <button label="@load(vm.etichette['Chiudi'])" onClick="@command('onChiudi')"
                        image="/images/icon/action/16x16/close.png"/>
            </h:div>
        </h:div>

    </window>

</zk>