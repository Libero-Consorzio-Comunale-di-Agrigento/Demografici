<?xml version="1.0" encoding="UTF-8"?>
<?taglib uri="http://www.zkoss.org/dsp/web/core" prefix="c"?>

<zk xmlns="http://www.zkoss.org/2005/zul"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul http://www.zkoss.org/2005/zul/zul.xsd">

		<!-- RIEPILOGO -->
		<row>
			<cell align="right">
				<label value="@load(vm.etichette['Riepilogo_Atto'])"/>
			</cell>
			<cell colspan="5" align="center">
				<hlayout spacing="7px">

					<hlayout valign="middle" spacing="5px" hflex="1">
						<label value="@load(vm.etichette['Ufficio'])"/>
						<intbox value="@load(vm.dettaglio.ufficio)" disabled="true" />
					</hlayout>

					<hlayout valign="middle" spacing="5px" hflex="1">
						<label value="@load(vm.etichette['Anno'])"/>
						<intbox value="@load(vm.dettaglio.anno)" disabled="true"/>
					</hlayout>

					<hlayout valign="middle" spacing="5px" hflex="1">
						<label value="@load(vm.etichette['Numero_Atto'])"/>
						<intbox value="@load(vm.dettaglio.atto)" disabled="true" visible="@load(vm.dettaglio.atto gt 0)" />
						<textbox value="@load(vm.etichette['Provvisorio'])" hflex="1" disabled="true" style="font-weight:bold" visible="@load(vm.dettaglio.atto le 0)"/>
					</hlayout>

					<zk if="${vm.dettaglio.hasParte()}">
						<hlayout valign="middle" spacing="5px" hflex="1">
							<label value="@load(vm.etichette['Parte'])"/>
							<intbox value="@load(vm.dettaglio.parte)" disabled="true"/>
						</hlayout>
					</zk>

					<zk if="${vm.dettaglio.hasSerie()}">
						<hlayout valign="middle" spacing="5px" hflex="1">
							<label value="@load(vm.etichette['Serie'])" visible="@load(not empty vm.dettaglio.serie)"/>
							<textbox value="@load(vm.dettaglio.serie)" 	visible="@load(not empty vm.dettaglio.serie)" hflex="1" disabled="true" style="font-weight:bold"/>
						</hlayout>
					</zk>

					<zk if="${vm.dettaglio.hasMargine() and vm.margineOn}">
						<hlayout valign="middle" spacing="5px" hflex="1">
							<label value="@load(vm.etichette['Margine'])"/>
							<combobox model="@load(vm.listaMargineLaterale)" readonly="true" hflex="1"
									  selectedItem="@bind(vm.margine.tipoMargineLaterale) @converter('it.finmatica.zk.utils.PropertyConverter', property='id')">
								<template name="model">
									<comboitem label="@load(vm.getEtichettaEnum(each))" value="@load(each)"/>
								</template>
							</combobox>
						</hlayout>
					</zk>

				</hlayout>
			</cell>
		</row>

</zk>