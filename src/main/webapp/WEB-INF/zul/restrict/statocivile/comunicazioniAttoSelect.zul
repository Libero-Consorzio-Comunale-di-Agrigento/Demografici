<?xml version="1.0" encoding="UTF-8"?>
<?taglib uri="http://www.zkoss.org/dsp/web/core" prefix="c"?>

<zk xmlns="http://www.zkoss.org/2005/zul"
	xmlns:h="http://www.w3.org/1999/xhtml"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul http://www.zkoss.org/2005/zul/zul.xsd">

	<window viewModel="@id('vm') @init('restrict.statocivile.ComunicazioniAttoSelectViewModel')"
			apply="org.zkoss.bind.BindComposer"
			border="none"
			width="600px" height="500px"
			title="@load(vm.etichette['Seleziona_Comunicazione'])"
			sizable="false" closable="false">

		<vlayout vflex="1">

			<totalSizeBlock/>

			<listbox model="@load(vm.lista)" selectedItem="@bind(vm.dettaglio)" nonselectableTags="" vflex="1"
					 emptyMessage="@load(vm.etichette['Nessun_dato_disponibile'])">
				<listhead>
					<listheader label="@load(vm.etichette['Descrizione'])" width="80%"/>
					<listheader label="@load(vm.etichette['Numero_copie'])"/>
					<listheader label="" width="52px"/>
				</listhead>
				<template name="model" var="item">
					<listitem onDoubleClick="@command('onSalva')">
						<listcell label="@load(item.comunicazione.descrizione)" />
						<listcell label="@load(item.numeroCopie)"/>
						<listcell>
							<button image="/images/icon/action/16x16/save.png"
									tooltiptext="@load(vm.etichette['seleziona_salva_tooltip'])"
									visible="@load(not empty item.id)"
									onClick="@command('onSalva')"/>
						</listcell>
					</listitem>
				</template>
			</listbox>

		</vlayout>

		<h:div sclass="barraPulsanti">
			<h:div>
				<button label="@load(vm.etichette['Salva'])"		onClick="@command('onSalva')" 		image="/images/icon/action/16x16/save.png" />
				<button label="@load(vm.etichette['Chiudi'])"		onClick="@command('onChiudi')" 		image="/images/icon/action/16x16/close.png"/>
			</h:div>
		</h:div>

	</window>

</zk>