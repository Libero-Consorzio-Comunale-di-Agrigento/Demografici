<?xml version="1.0" encoding="UTF-8"?>
<?taglib uri="http://www.zkoss.org/dsp/web/core" prefix="c"?>

<zk xmlns="http://www.zkoss.org/2005/zul"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul http://www.zkoss.org/2005/zul/zul.xsd">

	<window viewModel="@id('vm') @init('restrict.statocivile.PreviewAttoA4ViewModel')"
			apply="org.zkoss.bind.BindComposer"
			border="none"
			width="100%" height="100%"
			sizable="false" closable="false">

		<hlayout>
			<controlBarDettaglio/>

			<controlBarTesto/>
		</hlayout>

		<vlayout sclass="scroll" vflex="1">
			<hlayout sclass="testo-al-centro" hflex="1">
				<vbox sclass="bordered-container" vflex="1">

					<grid sclass="form" width="700px">
						<rows>
							<row>
								<zk if="${vm.margine.isMargineDestro()}">
									<cell>
										<vbox sclass="bordered-container" vflex="1" hflex="1" pack="center" align="center">
											<label value="@load(vm.descrizioneAtto)" multiline="true" sclass="testoAttoA4"/>
										</vbox>
									</cell>
								</zk>
								<cell width="250px">
									<grid sclass="form">
										<rows>
											<row>
												<cell width="58px">
													<label value="@load(vm.etichette['Cognome'])" sclass="testoAttoA4"/>
												</cell>
												<cell>
													<textbox value="@bind(vm.occhiello.cognome)" tooltiptext="@load(vm.occhiello.cognome)" sclass="testoAttoA4"
															 disabled="@load(not vm.margineEditable)" rows="2" hflex="1"/>
												</cell>
											</row>
											<row>
												<cell>
													<label value="@load(vm.etichette['Nome'])" sclass="testoAttoA4"/>
												</cell>
												<cell>
													<textbox value="@bind(vm.occhiello.nome)" tooltiptext="@load(vm.occhiello.nome)" sclass="testoAttoA4"
															 disabled="@load(not vm.margineEditable)" rows="2" hflex="1"/>
												</cell>
											</row>

											<zk if="${(vm.atto.getTipoAttoEnum() eq 'MAT') || (vm.atto.getTipoAttoEnum() eq 'UCI')}">
												<row>
													<cell>
														<label value="@load(vm.etichette['Cognome'])" sclass="testoAttoA4"/>
													</cell>
													<cell>
														<textbox value="@bind(vm.occhiello.cognomeConiuge)" tooltiptext="@load(vm.occhiello.cognomeConiuge)" sclass="testoAttoA4"
																 disabled="@load(not vm.margineEditable)" rows="2" hflex="1"/>
													</cell>
												</row>
												<row>
													<cell>
														<label value="@load(vm.etichette['Nome'])" sclass="testoAttoA4"/>
													</cell>
													<cell>
														<textbox value="@bind(vm.occhiello.nomeConiuge)" tooltiptext="@load(vm.occhiello.nomeConiuge)" sclass="testoAttoA4"
																 disabled="@load(not vm.margineEditable)" rows="2" hflex="1"/>
													</cell>
												</row>
											</zk>

											<zk if="${vm.atto.getTipoAttoEnum() eq 'NAS'}">
												<row>
													<cell>
														<label value="@load(vm.etichette['Sesso'])" sclass="testoAttoA4"/>
													</cell>
													<cell>
														<textbox value="@bind(vm.occhiello.descrizioneSesso)" sclass="testoAttoA4" disabled="@load(not vm.margineEditable)" hflex="1"/>
													</cell>
												</row>
												<row>
													<cell colspan="2">
														<textbox value="@bind(vm.occhiello.descrizioneStatoNascita)"
																 visible="@load(not empty vm.occhiello.descrizioneStatoNascita)"
																 disabled="@load(empty vm.occhiello.descrizioneStatoNascita or not vm.margineEditable)"
																 sclass="testoAttoA4" hflex="1"/>
													</cell>
												</row>
											</zk>
										</rows>
									</grid>
								</cell>
								<zk if="${vm.margine.isMargineSinistro()}">
									<cell>
										<vbox sclass="bordered-container" vflex="1" hflex="1" pack="center" align="center">
											<label value="@load(vm.descrizioneAtto)" multiline="true" sclass="testoAttoA4"/>
										</vbox>
									</cell>
								</zk>
							</row>
							<row>
								<cell colspan="2">
									<templateTestoA4/>
								</cell>
							</row>
						</rows>
					</grid>
				</vbox>
			</hlayout>
		</vlayout>

	</window>

</zk>