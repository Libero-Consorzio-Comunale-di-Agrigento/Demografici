<?xml version="1.0" encoding="UTF-8"?>
<?taglib uri="http://www.zkoss.org/dsp/web/core" prefix="c"?>

<zk xmlns="http://www.zkoss.org/2005/zul"
	xmlns:h="http://www.w3.org/1999/xhtml"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul http://www.zkoss.org/2005/zul/zul.xsd">

	<!-- FCC PDV-->
	<zk if="${vm.dettaglio.isFuoriCasaComunale() or vm.dettaglio.isPericoloVita() or vm.dettaglio.isCivileXDelega()}">
		<groupbox closable="false">
			<caption label="@load(vm.etichette['Luogo_Celebrazione'])"/>
			<grid sclass="form">
				<rows>
					<row>
						<cell align="right" width="160px">
							<zk if="${vm.anscOn}">
								<h:span class="mandatoryLabel">*</h:span>
							</zk>
							<label value="Casa Comunale"/>
						</cell>
						<cell colspan="5">
							<hlayout height="20px">
								<radiogroup model="@load(vm.listaTipoLuogoCelebrazione)"
											selectedItem="@bind(vm.datiProvenienza.flagCasaComunale) @converter('it.finmatica.zk.utils.PropertyConverter', property='value')">
									<template name="model">
										<radio label="@load(each.label)" disabled="@load(not vm.dettaglio.isCivileXDelega())"
											   value="@load(each.value)" style="padding-left:10px"/>
									</template>
								</radiogroup>
							</hlayout>
						</cell>
					</row>

					<row visible="@load(not empty vm.datiProvenienza.flagCasaComunale and vm.datiProvenienza.flagCasaComunale eq false)">
						<cell align="right">
							<zk if="${vm.anscOn}">
								<h:span class="mandatoryLabel">*</h:span>
							</zk>
							<label value="@load(vm.etichette['Luogo'])"/>
						</cell>
						<cell colspan="5">
							<hlayout valign="middle" hflex="1">
								<textbox value="@bind(vm.datiProvenienza.luogoPvuUci)" hflex="1"/>
								<button image="/images/icon/action/16x16/cancel.png"
										tooltiptext="@load(vm.etichette['Cancella'])" onClick="@command('onCancellaCampoProvenienza')">
									<custom-attributes proprieta="luogoPvuUci"/>
								</button>
							</hlayout>
						</cell>
					</row>

					<row visible="@load(not empty vm.datiProvenienza.flagCasaComunale and vm.datiProvenienza.flagCasaComunale eq false)">
						<cell align="right">
							<zk if="${vm.anscOn}">
								<h:span class="mandatoryLabel">*</h:span>
							</zk>
							<label value="@load(vm.etichette['Indirizzo'])"/>
						</cell>
						<cell colspan="3">
							<hlayout valign="middle" hflex="1">
								<textbox value="@bind(vm.datiProvenienza.indirizzo)" hflex="1"/>
								<button image="/images/icon/action/16x16/cancel.png"
										tooltiptext="@load(vm.etichette['Cancella'])" onClick="@command('onCancellaCampoProvenienza')">
									<custom-attributes proprieta="indirizzo"/>
								</button>
							</hlayout>
						</cell>
						<cell align="right">
							<zk if="${vm.anscOn}">
								<h:span class="mandatoryLabel">*</h:span>
							</zk>
							<label value="@load(vm.etichette['Civico'])"/>
						</cell>
						<cell colspan="1">
							<hlayout valign="middle" hflex="1">
								<textbox value="@bind(vm.datiProvenienza.civico)" hflex="1"/>
								<button image="/images/icon/action/16x16/cancel.png"
										tooltiptext="@load(vm.etichette['Cancella'])" onClick="@command('onCancellaCampoProvenienza')">
									<custom-attributes proprieta="civico"/>
								</button>
							</hlayout>
						</cell>
					</row>

					<row visible="@load(not empty vm.datiProvenienza.flagCasaComunale and vm.datiProvenienza.flagCasaComunale eq false)">
						<cell align="right">
							<zk if="${vm.anscOn}">
								<h:span class="mandatoryLabel">*</h:span>
							</zk>
							<label value="@load(vm.etichette['Segretario_comunale'])"/>
						</cell>
						<cell colspan="5">
							<hlayout valign="middle" hflex="1">
								<textbox value="@bind(vm.datiProvenienza.segretario)" hflex="1"/>
								<button image="/images/icon/action/16x16/cancel.png"
										tooltiptext="@load(vm.etichette['Cancella'])" onClick="@command('onCancellaCampoProvenienza')">
									<custom-attributes proprieta="segretario"/>
								</button>
							</hlayout>
						</cell>
					</row>

					<row visible="@load(not empty vm.datiProvenienza.flagCasaComunale and vm.datiProvenienza.flagCasaComunale eq false)">
						<cell align="right">
							<zk if="${vm.anscOn}">
								<h:span class="mandatoryLabel">*</h:span>
							</zk>
							<label value="@load(vm.etichette['Impossibilitato'])"/>
						</cell>
						<cell>
							<combobox model="@load(vm.listaImpossibilitato)" readonly="true" hflex="1"
									  selectedItem="@bind(vm.datiProvenienza.impossibilitato) @converter('it.finmatica.zk.utils.PropertyConverter', property='value')">
								<template name="model">
									<comboitem label="@load(empty each?'- -':each.label)" value="@load(each.value)"/>
								</template>
							</combobox>
						</cell>
						<cell colspan="4"/>
					</row>
					<row visible="@load(not empty vm.datiProvenienza.flagCasaComunale and vm.datiProvenienza.flagCasaComunale eq false)">
						<cell align="right">
							<label value="Impossibilitato - Certificato"/>
						</cell>
						<cell colspan="5">
							<groupbox closable="false">
								<vlayout>
									<grid sclass="form">
										<rows>
											<row>
												<cell align="right" width="150px">
													<hlayout>
														<h:span class="mandatoryLabel">*</h:span>
														<label value="@load(vm.etichette['Nome_Ente'])"/>
													</hlayout>
												</cell>
												<cell colspan="6">
													<hlayout valign="middle" hflex="1">
														<textbox hflex="1"
																 value="@bind(vm.datiProvenienza.certificato)"/>
														<button image="/images/icon/action/16x16/cancel.png"
																tooltiptext="@load(vm.etichette['Cancella'])"
																onClick="@command('onCancellaCampoProvenienza')">
															<custom-attributes proprieta="certificato"/>
														</button>
													</hlayout>
												</cell>
											</row>
											<row>
												<cell align="right">
													<hlayout>
														<customLabel mandatory="true"
																	 value="@load(vm.etichette['Comune_Ente'])"/>
													</hlayout>
												</cell>
												<cell colspan="5">
													<hlayout valign="middle" hflex="1">
														<bandboxComuni hflex="1"
																	   value="@load(vm.datiProvenienza.comuneCertificato.descrizione)"
																	   dataRiferimento="@load(vm.datiProvenienza.dataCertificato)"
																	   onSelect="@command('onSelectComune', campoRiferimento='CA_CERT')"/>
														<button image="/images/icon/action/16x16/cancel.png"
																tooltiptext="@load(vm.etichette['Cancella'])"
																onClick="@command('onCancellaComune', campoRiferimento='CA_CERT')"
														/>
													</hlayout>
												</cell>
												<cell>
													<textbox
															value="@load(vm.datiProvenienza.comuneCertificato.siglaProvincia)"
															hflex="1" readonly="true"/>
												</cell>
											</row>
											<row>
												<cell align="right">
													<hlayout>
														<customLabel mandatory="true"
																	 value="@load(vm.etichette['Estremi_documento'])"/>
													</hlayout>
												</cell>
												<cell colspan="2">
													<hlayout>
														<textbox
																value="@bind(vm.datiProvenienza.estremiCertificato)"
																hflex="1"/>
														<button image="/images/icon/action/16x16/cancel.png"
																tooltiptext="@load(vm.etichette['Cancella'])"
																onClick="@command('onCancellaCampoProvenienza')">
															<custom-attributes
																	proprieta="estremiCertificato"/>
														</button>
													</hlayout>
												</cell>
												<cell align="right" colspan="2">
													<hlayout>
														<h:span class="mandatoryLabel">*</h:span>
														<label value="@load(vm.etichette['Data_Formazione'])"/>
													</hlayout>
												</cell>
												<cell colspan="2">
													<hlayout valign="middle" hflex="1">
														<datebox format="dd/MM/yyyy"
																 value="@bind(vm.datiProvenienza.dataCertificato)"
																 width="100px"/>
														<button image="/images/icon/action/16x16/cancel.png"
																tooltiptext="@load(vm.etichette['Cancella'])"
																onClick="@command('onCancellaCampoProvenienza')">
															<custom-attributes proprieta="dataCertificato"/>
														</button>
													</hlayout>
												</cell>
											</row>
										</rows>
									</grid>
								</vlayout>
							</groupbox>
						</cell>
					</row>
				</rows>
			</grid>
		</groupbox>
	</zk>

</zk>