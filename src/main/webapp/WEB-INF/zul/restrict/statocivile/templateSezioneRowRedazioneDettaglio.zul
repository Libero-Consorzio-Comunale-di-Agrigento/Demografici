<?xml version="1.0" encoding="UTF-8"?>
<?taglib uri="http://www.zkoss.org/dsp/web/core" prefix="c"?>

<zk xmlns="http://www.zkoss.org/2005/zul"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:h="http://www.w3.org/1999/xhtml"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul http://www.zkoss.org/2005/zul/zul.xsd">

	<!-- SEZIONE DATI REDAZIONE -->
	<row>
		<cell align="right" width="160px">
			<label value="@load(vm.etichette['Data'])" />
		</cell>
		<cell>
			<datebox format="dd/MM/yyyy" value="@bind(vm.datiProvenienza.dataAtto)" width="100px"/>
		</cell>
		<cell align="right">
			<label value="@load(vm.etichette['Ore'])" />
		</cell>
		<cell>
			<textbox value="@bind(vm.datiProvenienza.oraAtto)" width="30px" maxlength="2"/>
		</cell>
		<cell align="right">
			<label value="@load(vm.etichette['Minuti'])"/>
		</cell>
		<cell>
			<textbox value="@bind(vm.datiProvenienza.minutoAtto)" width="30px" maxlength="2"/>
		</cell>
	</row>
	<row>
		<cell align="right">
			<zk if="${vm.anscOn and vm.dettaglio.isUfficialeStatoCivileMandatory()}">
				<h:span class="mandatoryLabel">*</h:span>
			</zk>
			<label value="@load(vm.etichette['Ufficiale_Stato_Civile'])"/>
		</cell>
		<cell colspan="5">
			<hlayout valign="middle" hflex="1">
				<bandboxUfficiale hflex="1" value="@bind(vm.datiProvenienza.ufficialeUtente)"
								  onSelect="@command('onSelectUfficiale')"/>
				<button image="/images/icon/action/16x16/cancel.png"
				        tooltiptext="@load(vm.etichette['Cancella'])" onClick="@command('onCancellaCampoProvenienza')">
                    <custom-attributes proprieta="ufficialeUtente"/>
                </button>
			</hlayout>
		</cell>
	</row>
	<row>
		<cell align="right">
			<label value="@load(vm.etichette['Qualifica'])"/>
		</cell>
		<cell colspan="5">
			<hlayout valign="middle" hflex="1">
				<bandboxQualifica hflex="1" value="@bind(vm.datiProvenienza.qualificaUtente)" maxlength="30"
								  onSelect="@command('onSelectQualifica')"/>
				<button image="/images/icon/action/16x16/cancel.png"
				        tooltiptext="@load(vm.etichette['Cancella'])" onClick="@command('onCancellaCampoProvenienza')">
                    <custom-attributes proprieta="qualificaUtente"/>
                </button>
			</hlayout>
		</cell>
	</row>

</zk>