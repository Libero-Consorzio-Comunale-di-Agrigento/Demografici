<?xml version="1.0" encoding="UTF-8"?>
<?taglib uri="http://www.zkoss.org/dsp/web/core" prefix="c"?>
<?component name="templateRowEstremiAttoNascitaRubricaNascite" macroURI="/restrict/statocivile/templateRowEstremiAttoNascitaRubricaNascite.zul" inline="true"?>
<zk xmlns="http://www.zkoss.org/2005/zul"
    xmlns:h="http://www.w3.org/1999/xhtml"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.zkoss.org/2005/zul http://www.zkoss.org/2005/zul/zul.xsd">

    <window viewModel="@id('vm') @init('restrict.statocivile.rubricaNascite.RubricaNasciteDettaglioViewModel')"
            apply="org.zkoss.bind.BindComposer"
            border="none"
            width="100%" height="100%"
            sizable="false" closable="false">

        <hlayout valign="middle">
            <controlBarDettaglio/>

            <label value="@load(vm.formLabel)" sclass="formTitle"/>
        </hlayout>

        <vlayout vflex="1" sclass="scroll">

            <groupbox mold="3d" hflex="1" closable="false">
                <caption sclass="mainCaption">
                    <div>
                        <updownbutton onClick="@command(self.openClose())" sclass="captionButton"/>
                        <label value="@load(vm.etichette['SEZIONE_DATI_REGISTRAZIONE'])" sclass="captionLabel"/>
                    </div>
                </caption>
                <grid sclass="form">
                    <rows>
                        <row>
                            <cell align="right" width="140px">
                                <h:span class="mandatoryLabel">*</h:span><label value="@load(vm.etichette['Anno_Registrazione'])"/>
                            </cell>
                            <cell>
                                <textbox value="@bind(vm.dettaglio.annoRegistrazione)" cols="4"/>
                            </cell>
                            <cell align="right" width="140px">
                                <label value="@load(vm.etichette['Data_Registrazione'])"/>
                            </cell>
                            <cell>
                                <datebox format="dd/MM/yyyy" value="@load(vm.dettaglio.dataRegistrazione)" disabled="true"/>
                            </cell>
                        </row>
                    </rows>
                </grid>
            </groupbox>

            <groupbox mold="3d" hflex="1">
                <caption sclass="mainCaption">
                    <div>
                        <updownbutton onClick="@command(self.openClose())" sclass="captionButton"/>
                        <label value="@load(vm.etichette['SEZIONE_DATI_NASCITA'])" sclass="captionLabel"/>
                    </div>
                </caption>
                <grid sclass="form">
                    <rows>
                        <row>
                            <cell align="right" width="140px">
                                <h:span class="mandatoryLabel">*</h:span><label value="@load(vm.etichette['Cognome'])"/>
                            </cell>
                            <cell colspan="4">
                                <hlayout valign="middle" hflex="1">
                                    <textbox value="@bind(vm.dettaglio.cognome)" hflex="1"
                                             onChange="@command('onAggiornaCase')"
                                             style="@load(vm.minuscole.cognome?'text-transform:none':'text-transform:uppercase')">
                                        <custom-attributes proprieta="cognome"/>
                                    </textbox>
                                    <button image="/images/icon/action/16x16/cancel.png"
                                            tooltiptext="@load(vm.etichette['Cancella'])" onClick="@command('onCancellaCampoRubrica')">
                                        <custom-attributes proprieta="cognome"/>
                                    </button>
                                    <space/>
                                </hlayout>
                            </cell>
                            <cell align="right" width="85px">
                                <hlayout valign="middle" >
                                    <label value="@load(vm.etichette['Minuscole'])"/>
                                    <checkbox checked="@bind(vm.minuscole.cognome)" onCheck="@command('onAggiornaCase')" >
                                        <custom-attributes proprieta="cognome"/>
                                    </checkbox>
                                </hlayout>
                            </cell>
                        </row>
                        <row>
                            <cell align="right">
                                <h:span class="mandatoryLabel">*</h:span><label value="@load(vm.etichette['Nome'])"/>
                            </cell>
                            <cell colspan="4">
                                <hlayout valign="middle" hflex="1">
                                    <textbox value="@bind(vm.dettaglio.nome)" hflex="1"
                                             onChange="@command('onAggiornaCase')"
                                             style="@load(vm.minuscole.nome?'text-transform:none':'text-transform:uppercase')">
                                        <custom-attributes proprieta="nome"/>
                                    </textbox>
                                    <button image="/images/icon/action/16x16/search.png"
                                            tooltiptext="@load(vm.etichette['Seleziona'])" onClick="@command('onCaricaSoggetti', tipoSoggetto='NATO_A')"
                                    />
                                    <button image="/images/icon/action/16x16/cancel.png"
                                            tooltiptext="@load(vm.etichette['Cancella'])" onClick="@command('onCancellaCampoRubrica')">
                                        <custom-attributes proprieta="nome"/>
                                    </button>
                                    <space/>
                                </hlayout>
                            </cell>
                            <cell align="right" width="85px">
                                <hlayout valign="middle" >
                                    <label value="@load(vm.etichette['Minuscole'])"/>
                                    <checkbox checked="@bind(vm.minuscole.nome)" onCheck="@command('onAggiornaCase')" >
                                        <custom-attributes proprieta="nome"/>
                                    </checkbox>
                                </hlayout>
                            </cell>
                        </row>
                        <row>
                            <cell align="right">
                                <label value="@load(vm.etichette['Sesso'])"/>
                            </cell>
                            <cell>
                                <combobox model="@load(vm.listaSesso)" readonly="true" width="105px"
                                          selectedItem="@bind(vm.dettaglio.sesso) @converter('it.finmatica.zk.utils.PropertyConverter', property='id')">
                                    <template name="model">
                                        <comboitem label="@load(vm.getEtichettaEnum(each))" value="@load(each)"/>
                                    </template>
                                </combobox>
                            </cell>
                            <cell align="right">
                                <h:span class="mandatoryLabel">*</h:span><label value="@load(vm.etichette['Data_Nascita'])"/>
                            </cell>
                            <cell>
                                <hlayout valign="middle">
                                    <datebox format="dd/MM/yyyy" value="@bind(vm.dettaglio.dataNascita)" width="100px" onChange="@command('onSelectDataNascita')"/>
                                    <button image="/images/icon/action/16x16/cancel.png"
                                            tooltiptext="@load(vm.etichette['Cancella'])" onClick="@command('onCancellaCampoRubrica')">
                                        <custom-attributes proprieta="dataNascita"/>
                                    </button>
                                </hlayout>
                            </cell>
                            <cell colspan="2"/>
                        </row>
                        <row>
                            <cell align="right">
                                <h:span class="mandatoryLabel">*</h:span><label value="@load(vm.etichette['Comune_Nascita'])"/>
                            </cell>
                            <cell colspan="4">
                                <hlayout valign="middle" hflex="1">
                                    <bandboxComuni hflex="1"
                                                   value="@load(vm.dettaglio.comuneNascita.descrizione)"
                                                   onSelect="@command('onSelectComune', campoRiferimento='CN_NATO')"/>
                                    <button image="/images/icon/action/16x16/cancel.png"
                                            tooltiptext="@load(vm.etichette['Cancella'])" onClick="@command('onCancellaComune', campoRiferimento='CN_NATO')"
                                    />
                                </hlayout>
                            </cell>
                            <cell>
                                <textbox value="@load(vm.dettaglio.comuneNascita.siglaProvincia)" hflex="1" readonly="true"/>
                            </cell>
                        </row>
                    </rows>
                </grid>
            </groupbox>

            <groupbox mold="3d" hflex="1">
                <caption sclass="mainCaption">
                    <div>
                        <updownbutton onClick="@command(self.openClose())" sclass="captionButton"/>
                        <label value="@load(vm.etichette['SEZIONE_DATI_ATTO'])" sclass="captionLabel"/>
                    </div>
                </caption>
                <grid sclass="form">
                    <rows>
                        <row>
                            <cell align="right" width="150px">
                                <customLabel mandatory="true" value="@load(vm.etichette['Estremi_Atto_Nascita'])"/>
                            </cell>
                            <cell>
                                <grid hflex="1">
                                    <rows>
                                        <row>
                                            <cell>
                                                <grid>
                                                    <rows>
                                                        <templateRowEstremiAttoNascitaRubricaNascite/>
                                                    </rows>
                                                </grid>
                                            </cell>
                                        </row>
                                    </rows>
                                </grid>
                            </cell>
                        </row>
                    </rows>
                </grid>
            </groupbox>

            <groupbox mold="3d" hflex="1">
                <caption sclass="mainCaption">
                    <div>
                        <updownbutton onClick="@command(self.openClose())" sclass="captionButton"/>
                        <label value="@load(vm.etichette['SEZIONE_GENITORI'])" sclass="captionLabel"/>
                    </div>
                </caption>
                <grid sclass="form">
                    <rows>
                        <row>
                            <cell align="right" width="140px">
                                <label value="@load(vm.etichette['Cognome_Padre'])"/>
                            </cell>
                            <cell colspan="9">
                                <hlayout valign="middle" hflex="1">
                                    <textbox value="@bind(vm.dettaglio.cognomePadre)" hflex="1"
                                             onChange="@command('onAggiornaCase')"
                                             style="@load(vm.minuscole.cognomePadre?'text-transform:none':'text-transform:uppercase')">
                                        <custom-attributes proprieta="cognomePadre"/>
                                    </textbox>
                                    <button image="/images/icon/action/16x16/cancel.png"
                                            tooltiptext="@load(vm.etichette['Cancella'])" onClick="@command('onCancellaCampoRubrica')">
                                        <custom-attributes proprieta="cognomePadre"/>
                                    </button>
                                </hlayout>
                            </cell>
                            <cell align="right" width="85px">
                                <hlayout valign="middle" >
                                    <label value="@load(vm.etichette['Minuscole'])"/>
                                    <checkbox checked="@bind(vm.minuscole.cognomePadre)" onCheck="@command('onAggiornaCase')" >
                                        <custom-attributes proprieta="cognomePadre"/>
                                    </checkbox>
                                </hlayout>
                            </cell>
                        </row>
                        <row>
                            <cell align="right">
                                <label value="@load(vm.etichette['Nome_Padre'])"/>
                            </cell>
                            <cell colspan="9">
                                <hlayout valign="middle" hflex="1">
                                    <textbox value="@bind(vm.dettaglio.nomePadre)" hflex="1"
                                             onChange="@command('onAggiornaCase')"
                                             style="@load(vm.minuscole.nomePadre?'text-transform:none':'text-transform:uppercase')">
                                        <custom-attributes proprieta="nomePadre"/>
                                    </textbox>
                                    <button image="/images/icon/action/16x16/cancel.png"
                                            tooltiptext="@load(vm.etichette['Cancella'])" onClick="@command('onCancellaCampoRubrica')">
                                        <custom-attributes proprieta="nomePadre"/>
                                    </button>
                                </hlayout>
                            </cell>
                            <cell align="right" width="85px">
                                <hlayout valign="middle" >
                                    <label value="@load(vm.etichette['Minuscole'])"/>
                                    <checkbox checked="@bind(vm.minuscole.nomePadre)" onCheck="@command('onAggiornaCase')" >
                                        <custom-attributes proprieta="nomePadre"/>
                                    </checkbox>
                                </hlayout>
                            </cell>
                        </row>
                        <row>
                            <cell colspan="11"/>
                        </row>
                        <row>
                            <cell align="right">
                                <label value="@load(vm.etichette['Cognome_Madre'])"/>
                            </cell>
                            <cell colspan="9">
                                <hlayout valign="middle" hflex="1">
                                    <textbox value="@bind(vm.dettaglio.cognomeMadre)" hflex="1"
                                             onChange="@command('onAggiornaCase')"
                                             style="@load(vm.minuscole.cognomeMadre?'text-transform:none':'text-transform:uppercase')">
                                        <custom-attributes proprieta="cognomeMadre"/>
                                    </textbox>
                                    <button image="/images/icon/action/16x16/cancel.png"
                                            tooltiptext="@load(vm.etichette['Cancella'])" onClick="@command('onCancellaCampoRubrica')">
                                        <custom-attributes proprieta="cognomeMadre"/>
                                    </button>
                                </hlayout>
                            </cell>
                            <cell align="right" width="85px">
                                <hlayout valign="middle" >
                                    <label value="@load(vm.etichette['Minuscole'])"/>
                                    <checkbox checked="@bind(vm.minuscole.cognomeMadre)" onCheck="@command('onAggiornaCase')" >
                                        <custom-attributes proprieta="cognomeMadre"/>
                                    </checkbox>
                                </hlayout>
                            </cell>
                        </row>
                        <row>
                            <cell align="right">
                                <label value="@load(vm.etichette['Nome_Madre'])"/>
                            </cell>
                            <cell colspan="9">
                                <hlayout valign="middle" hflex="1">
                                    <textbox value="@bind(vm.dettaglio.nomeMadre)" hflex="1"
                                             onChange="@command('onAggiornaCase')"
                                             style="@load(vm.minuscole.nomeMadre?'text-transform:none':'text-transform:uppercase')">
                                        <custom-attributes proprieta="nomeMadre"/>
                                    </textbox>
                                    <button image="/images/icon/action/16x16/cancel.png"
                                            tooltiptext="@load(vm.etichette['Cancella'])" onClick="@command('onCancellaCampoRubrica')">
                                        <custom-attributes proprieta="nomeMadre"/>
                                    </button>
                                </hlayout>
                            </cell>
                            <cell align="right" width="85px">
                                <hlayout valign="middle" >
                                    <label value="@load(vm.etichette['Minuscole'])"/>
                                    <checkbox checked="@bind(vm.minuscole.nomeMadre)" onCheck="@command('onAggiornaCase')" >
                                        <custom-attributes proprieta="nomeMadre"/>
                                    </checkbox>
                                </hlayout>
                            </cell>
                        </row>

                    </rows>
                </grid>
            </groupbox>

            <templateIdDomain/>

        </vlayout>

    </window>

</zk>