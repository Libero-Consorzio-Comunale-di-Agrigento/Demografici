<?xml version="1.0" encoding="UTF-8"?>
<?taglib uri="http://www.zkoss.org/dsp/web/core" prefix="c"?>

<zk xmlns="http://www.zkoss.org/2005/zul"
	xmlns:h="http://www.w3.org/1999/xhtml"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xmlns:w="http://www.zkoss.org/2005/zk/client"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul http://www.zkoss.org/2005/zul/zul.xsd">

	<!-- i dati non modificabili li leggo dall'atto -->
	<row>
		<cell align="right" width="165px">
			<label value="@load(vm.etichette['Cognome'])"/>
		</cell>
		<cell colspan="3">
			<label value="@load(vm.atto.cognome2)" sclass="grassetto"/>
		</cell>
		<cell align="right" width="150px">
			<label value="@load(vm.etichette['Nome'])"/>
		</cell>
		<cell colspan="3">
			<label value="@load(vm.atto.nome2)" sclass="grassetto"/>
		</cell>
	</row>
	<row>
		<cell align="right">
			<label value="@load(vm.etichette['Data_Nascita'])"/>
		</cell>
		<cell colspan="3">
			<label value="@load(empty vm.atto.dataNascita2? null:(c:formatDate(vm.atto.dataNascita2, 'dd/MM/yyyy')))" sclass="grassetto"/>
		</cell>
		<cell align="right">
			<label value="@load(vm.etichette['Luogo_Nascita'])"/>
		</cell>
		<cell colspan="3">
			<label value="@load(c:cat4(vm.atto.descrizioneComuneNascita2, empty vm.atto.siglaProvinciaNascita2?'':' (', vm.atto.siglaProvinciaNascita2, empty vm.atto.siglaProvinciaNascita2?'':') '))" sclass="grassetto"/>
		</cell>
	</row>
	<row>
		<cell align="right">
			<label value="@load(vm.etichette['Sesso'])"/>
		</cell>
		<cell colspan="3">
			<label value="@load(vm.getEtichettaEnum(vm.atto.sesso2))" sclass="grassetto"/>
		</cell>
		<cell align="right">
			<label value="@load(vm.etichette['Luogo_Residenza'])"/>
		</cell>
		<cell colspan="3">
			<!--<label value="@load(c:cat4(vm.atto.descrizioneComuneResidenza2, empty vm.atto.siglaProvinciaResidenza2?'':' (', vm.atto.siglaProvinciaResidenza2, empty vm.atto.siglaProvinciaResidenza2?'':') '))" sclass="grassetto"/>-->
			<hlayout valign="middle" hflex="1">
				<bandboxComuni hflex="1"
							   value="@load(vm.dettaglio.comuneResidenza2.descrizione)"
							   onSelect="@command('onSelectComune', campoRiferimento='CR_SOGG_2')"/>
				<button image="/images/icon/action/16x16/cancel.png"
						tooltiptext="@load(vm.etichette['Cancella'])" onClick="@command('onCancellaComune', campoRiferimento='CR_SOGG_2')"/>
			</hlayout>
		</cell>
	</row>

	<row>
		<cell align="right">
			<label value="@load(vm.etichette['Codice_Fiscale'])"/>
		</cell>
		<cell colspan="3">
			<hlayout>
				<textbox value="@bind(vm.dettaglio.codiceFiscale2)" hflex="1" style="text-transform:uppercase"/>
				<button image="/images/icon/action/16x16/calculator.png"
						tooltiptext="@load(vm.etichette['Calcolo_Codice_Fiscale'])" onClick="@command('onCalcolaCf', tipoSoggetto='SOGGETTO_2')" />
				<button image="/images/icon/action/16x16/cancel.png"
						tooltiptext="@load(vm.etichette['Cancella'])" onClick="@command('onCancellaCampoIstat')">
					<custom-attributes proprieta="codiceFiscale2"/>
				</button>
			</hlayout>
		</cell>
		<cell align="right">
			<label value="@load(vm.etichetteCustom['statoCivilePre'])"/>
		</cell>
		<cell colspan="3">
			<combobox model="@load(vm.listaStatoCivile2)" readonly="false" hflex="1"
					  selectedItem="@bind(vm.dettaglio.statoCivile2) @converter('it.finmatica.zk.utils.PropertyConverter', property='codice')">
				<template name="model">
					<comboitem label="@load(empty each?'- -':c:cat3(each.codice, ' - ', each.descrizione) )" value="@load(each.codice)"/>
				</template>
			</combobox>
		</cell>
	</row>

	<row>
		<cell align="right">
			<label value="@load(vm.etichette['Cittadinanza'])"/>
		</cell>
		<cell colspan="3">
			<label value="@load(vm.atto.nazionalita2.descrizione)" hflex="1" sclass="grassetto" />
		</cell>
		<cell colspan="2">
			<hlayout height="20px">
				<radiogroup model="@load(vm.listaTipoCittadinanza)" hflex="1"
							selectedItem="@bind(vm.dettaglio.nazionalitaItaliana2) @converter('it.finmatica.zk.utils.PropertyConverter', property='codice')">
					<template name="model">
						<radio label="@load(each.descrizione)" value="@load(each.codice)" style="padding-left:15px;font-weight: bold"/>
					</template>
				</radiogroup>
			</hlayout>
		</cell>
		<cell colspan="2" align="right">
			<hlayout valign="middle">
				<label value="@load(vm.etichette['Dal'])"/>
				<space/>
				<datebox format="dd/MM/yyyy" value="@bind(vm.dettaglio.dataNazionalita2)" width="95px"/>
				<button image="/images/icon/action/16x16/cancel.png"
						tooltiptext="@load(vm.etichette['Cancella'])" onClick="@command('onCancellaCampoIstat')">
					<custom-attributes proprieta="dataNazionalita2"/>
				</button>
				<space/>
			</hlayout>
		</cell>
	</row>


</zk>