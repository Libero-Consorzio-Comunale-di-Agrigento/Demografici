<?xml version="1.0" encoding="UTF-8"?>
<?taglib uri="http://www.zkoss.org/dsp/web/core" prefix="c"?>
<?component name="templateSezioneTipoAccordoDivorzioDettaglio" macroURI="/restrict/statocivile/matrimonio/matrimonio/templateSezioneTipoAccordoDivorzioDettaglio.zul" inline="true"?>
<?component name="templateSezioneSposiDivorzioDettaglio" macroURI="/restrict/statocivile/matrimonio/matrimonio/templateSezioneSposiDivorzioDettaglio.zul" inline="true"?>
<?component name="templateSezioneDatiDivorzioDettaglio" macroURI="/restrict/statocivile/matrimonio/matrimonio/templateSezioneDatiDivorzioDettaglio.zul" inline="true"?>
<?component name="templateSezioneAvvocatiDivScioDettaglio" macroURI="/restrict/statocivile/templateSezioneAvvocatiDivScioDettaglio.zul" inline="true"?>
<?component name="templateSezioneRedazioneDivorzioDettaglio" macroURI="/restrict/statocivile/matrimonio/matrimonio/templateSezioneRedazioneDivorzioDettaglio.zul" inline="true"?>
<?component name="templateSezioneComposizioneDivorzioDettaglio" macroURI="/restrict/statocivile/matrimonio/matrimonio/templateSezioneComposizioneDivorzioDettaglio.zul" inline="true"?>

<zk xmlns="http://www.zkoss.org/2005/zul"
	xmlns:h="http://www.w3.org/1999/xhtml"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul http://www.zkoss.org/2005/zul/zul.xsd">

	<window viewModel="@id('vm') @init('restrict.statocivile.matrimonio.matrimonio.DivorzioDettaglioViewModel')"
			apply="org.zkoss.bind.BindComposer"
			border="none"
			width="100%" height="100%"
			sizable="false" closable="false">

			<hlayout valign="middle">
				<controlBarDettaglio/>

				<controlBarAtto/>

				<label value="@load(vm.formLabel)" sclass="@load(vm.attoSclass)"/>

				<estremiAttoFormLabel/>
			</hlayout>

			<vlayout vflex="1" width="100%" sclass="scroll">

				<templateSezioneInformazioniDettaglio/>

				<templateSezioneTipoAccordoDivorzioDettaglio/>

				<templateSezioneSposiDivorzioDettaglio/>

				<templateSezioneDatiDivorzioDettaglio/>

				<zk if="${not vm.dettaglio.isRiconciliazione()}">
					<templateSezioneAvvocatiDivScioDettaglio/>
				</zk>

				<templateSezioneRedazioneDivorzioDettaglio/>

				<vlayout hflex="1" visible="@load((vm.statoFrammenti eq 2) and (vm.dettaglio.natura ne 'N'))">
					<templateSezioneComposizioneDivorzioDettaglio/>
				</vlayout>

				<templateSezioneAnnotazioniDaAttoDettaglio/>

				<templateIdDomain/>

			</vlayout>

	</window>

</zk>