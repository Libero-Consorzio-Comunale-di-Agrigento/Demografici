					<!-- ALTRI DATI (1 FRAMMENTO) -->
					<row visible="@load(c:addFormulaMatrimonio('formulaMatrimonioConcordatario', vm.tipoOperazione, vm.dettaglio, vm.margine))">
						<cell align="right">
							<label value="@load(vm.etichette['Altri_Dati'])"/>
						</cell>
						<cell colspan="5" align="center">
							<hlayout hflex="1" valign="middle">
								<textbox rows="@load(not empty vm.mapFormule.formulaMatrimonioConcordatario.numeroRighe?vm.mapFormule.formulaMatrimonioConcordatario.numeroRighe:8)"
										 sclass="testoAtto"
										 value="@bind(vm.mapFormule.formulaMatrimonioConcordatario.testo)" hflex="1"
										 disabled="@load(not (c:addFormulaMatrimonio('formulaMatrimonioConcordatario', vm.tipoOperazione, vm.dettaglio, vm.margine)) )"/>
								<hlayout sclass="testo-a-dx" width="85px">
									<button image="/images/icon/action/16x16/grid.png"
											tooltiptext="@load(vm.etichette['Seleziona_Formula'])" onClick="@command('onCaricaFormuleFrammento', chiave='formulaMatrimonioConcordatario')"
											disabled="@load(not (c:addFormulaMatrimonio('formulaMatrimonioConcordatario', vm.tipoOperazione, vm.dettaglio, vm.margine)) )"/>
									<button image="/images/icon/action/16x16/refresh.png"
											tooltiptext="@load(vm.etichette['Aggiorna_Formula'])" onClick="@command('onRefreshFormula', chiave='formulaMatrimonioConcordatario')"
											disabled="@load(not (c:addFormulaMatrimonio('formulaMatrimonioConcordatario', vm.tipoOperazione, vm.dettaglio, vm.margine)) )"/>
								</hlayout>
							</hlayout>
						</cell>
					</row>
					<!-- CHIUSURA -->
					<row visible="@load(c:addFormulaMatrimonio('formulaChiusura', vm.tipoOperazione, vm.dettaglio, vm.margine))">
						<cell align="right">
							<label value="@load(vm.etichette['Chiusura'])"/>
						</cell>
						<cell colspan="5" align="center">
							<hlayout hflex="1" valign="middle">
								<textbox rows="@load(not empty vm.mapFormule.formulaChiusura.numeroRighe?vm.mapFormule.formulaChiusura.numeroRighe:4)"
									sclass="testoAtto"
									value="@bind(vm.mapFormule.formulaChiusura.testo)" hflex="1"
									disabled="@load(not (c:addFormulaMatrimonio('formulaChiusura', vm.tipoOperazione, vm.dettaglio, vm.margine)) )"/>
								<hlayout sclass="testo-a-dx" width="85px">
									<button image="/images/icon/action/16x16/grid.png"
										tooltiptext="@load(vm.etichette['Seleziona_Formula'])" onClick="@command('onCaricaFormuleFrammento', chiave='formulaChiusura')"
										disabled="@load(not (c:addFormulaMatrimonio('formulaChiusura', vm.tipoOperazione, vm.dettaglio, vm.margine)) )"/>
									<button image="/images/icon/action/16x16/refresh.png"
										tooltiptext="@load(vm.etichette['Aggiorna_Formula'])" onClick="@command('onRefreshFormula', chiave='formulaChiusura')"
										disabled="@load(not (c:addFormulaMatrimonio('formulaChiusura', vm.tipoOperazione, vm.dettaglio, vm.margine)) )"/>
								</hlayout>
							</hlayout>
						</cell>
					</row>
					<!-- FIRMA -->
					<row visible="@load(c:addFormulaMatrimonio('formulaFirma', vm.tipoOperazione, vm.dettaglio, vm.margine))">
						<cell align="right" width="150px">
							<label value="@load(vm.etichette['Firma'])"/>
						</cell>
						<cell colspan="5">
							<hlayout hflex="1" valign="middle">
								<textbox rows="@load(not empty vm.mapFormule.formulaFirma.numeroRighe?vm.mapFormule.formulaFirma.numeroRighe:5)"
										 sclass="testoAtto"
										 value="@bind(vm.mapFormule.formulaFirma.testo)" hflex="1"
										 disabled="@load(not (c:addFormulaMatrimonio('formulaFirma', vm.tipoOperazione, vm.dettaglio, vm.margine)) )"/>
								<hlayout sclass="testo-a-dx" width="85px">
									<button image="/images/icon/action/16x16/refresh.png"
											tooltiptext="@load(vm.etichette['Aggiorna_Formula'])" onClick="@command('onRefreshFormula', chiave='formulaFirma')"
											disabled="@load(not (c:addFormulaMatrimonio('formulaFirma', vm.tipoOperazione, vm.dettaglio, vm.margine)) )"/>
								</hlayout>
							</hlayout>
						</cell>
					</row>

					<!-- RIEPILOGO -->
					<templateRowRiepilogoAttoDettaglio/>

					<row>
						<cell colspan="3">
							<hlayout hflex="1" sclass="testo-al-centro">
								<button label="@load(vm.etichette['Preview'])"
										height="35px" width="150px"
										style="font-size:12px; font-weight: bold;"
										disabled="@load(vm.tipoOperazione.isInsert())"
										onClick="@command('onPreviewRecord')"
								/>
							</hlayout>
						</cell>
						<cell colspan="3">
							<hlayout hflex="1" sclass="testo-al-centro">
								<button label="@load(vm.buttonConsolidamentoLabel)"
										height="35px" width="150px"
										style="font-size:12px; font-weight: bold;"
										visible="@load(not empty vm.buttonConsolidamentoLabel)"
										disabled="@load(vm.tipoOperazione.isInsert())"
										onClick="@command('onCheckConsolidamento')"
								/>
							</hlayout>
						</cell>
					</row>
				</rows>
			</grid>
		</groupbox>

</zk>