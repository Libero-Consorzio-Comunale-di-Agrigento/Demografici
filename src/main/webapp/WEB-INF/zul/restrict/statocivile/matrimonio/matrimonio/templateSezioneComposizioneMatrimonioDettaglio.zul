<?xml version="1.0" encoding="UTF-8"?>
<?taglib uri="http://www.zkoss.org/dsp/web/core" prefix="c"?>
<?xel-method prefix="c" name="addFormulaMatrimonio" class="it.finmatica.de4gsdzk.utils.FormulaUtils" signature="java.lang.Boolean addFormulaMatrimonio(java.lang.String chiave, it.finmatica.de4gsdzk.utils.ETipoOperazione tipoOperazione, it.finmatica.de4gsdzk.statocivile.CivMatrimonio obj, it.finmatica.de4gsdzk.statocivile.CivMargine margine)"?>

<zk xmlns="http://www.zkoss.org/2005/zul"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul http://www.zkoss.org/2005/zul/zul.xsd">

		<!-- - - - - - - - - - - - - - - - - - - - - - - - COMPOSIZIONE - - - - - - - - - - - - - - - - - - - - - - - -->

		<groupbox mold="3d" hflex="1" open="true" visible="@load(vm.tipoOperazione.isUpdate())">
			<caption>
				<hlayout hflex="1" sclass="customCaption25">
					<hlayout sclass="testo-a-sx" hflex="1">
						<updownbutton onClick="@command(self.openClose())"/>
						<label value="@load(vm.etichette['SEZIONE_COMPOSIZIONE'])" sclass="captionLabel"/>
					</hlayout>
					<hlayout sclass="testo-a-dx" hflex="1" style="padding-right:8px">
						<button onClick="@command('onRefreshAllFormule')"
								image="/images/icon/action/16x16/refresh.png"
								tooltiptext="@load(vm.etichette['Aggiorna_Formule'])" />
					</hlayout>
				</hlayout>
			</caption>
			<grid sclass="form">
				<rows>
					<!-- TESTO LIBERO -->
					<row visible="@load(c:addFormulaMatrimonio('formulaTestoLibero', vm.tipoOperazione, vm.dettaglio, vm.margine))">
						<cell align="right" width="150px">
							<label value="@load(vm.etichette['Testo_Libero'])"/>
						</cell>
						<cell colspan="5">
							<hlayout hflex="1" valign="middle">
								<textbox placeholder="@load(vm.etichette['Testo_Libero_placeholder'])"
										 rows="@load(not empty vm.mapFormule.formulaTestoLibero.numeroRighe?vm.mapFormule.formulaTestoLibero.numeroRighe:5)"
										 sclass="testoAtto"
										 value="@bind(vm.mapFormule.formulaTestoLibero.testo)" hflex="1"
										 disabled="@load(not (c:addFormulaMatrimonio('formulaTestoLibero', vm.tipoOperazione, vm.dettaglio, vm.margine)) )"/>
								<hlayout sclass="testo-a-dx" width="85px">
									<button image="/images/icon/action/16x16/grid.png"
											tooltiptext="@load(vm.etichette['Seleziona_Formula'])" onClick="@command('onCaricaFormuleFrammento', chiave='formulaTestoLibero')"
											disabled="@load(not (c:addFormulaMatrimonio('formulaTestoLibero', vm.tipoOperazione, vm.dettaglio, vm.margine)) )"/>
									<button image="/images/icon/action/16x16/refresh.png"
											tooltiptext="@load(vm.etichette['Aggiorna_Formula'])" onClick="@command('onRefreshFormula', chiave='formulaTestoLibero')"
											disabled="@load(not (c:addFormulaMatrimonio('formulaTestoLibero', vm.tipoOperazione, vm.dettaglio, vm.margine)) )"/>
								</hlayout>
							</hlayout>
						</cell>
					</row>
					<!-- TESTATA TRASCRIZIONE -->
					<row visible="@load(c:addFormulaMatrimonio('formulaTestataTrascrizione', vm.tipoOperazione, vm.dettaglio, vm.margine))">
						<cell align="right">
							<label value="@load(vm.etichette['Testata_Trascrizione'])"/>
						</cell>
						<cell colspan="5">
							<hlayout hflex="1" valign="middle">
								<textbox rows="@load(not empty vm.mapFormule.formulaTestataTrascrizione.numeroRighe?vm.mapFormule.formulaTestataTrascrizione.numeroRighe:5)"
									sclass="testoAtto"
									value="@bind(vm.mapFormule.formulaTestataTrascrizione.testo)" hflex="1"
									disabled="@load(not (c:addFormulaMatrimonio('formulaTestataTrascrizione', vm.tipoOperazione, vm.dettaglio, vm.margine)) )"/>
								<hlayout sclass="testo-a-dx" width="85px">
									<button image="/images/icon/action/16x16/refresh.png"
										tooltiptext="@load(vm.etichette['Aggiorna_Formula'])" onClick="@command('onRefreshFormula', chiave='formulaTestataTrascrizione')"
										disabled="@load(not (c:addFormulaMatrimonio('formulaTestataTrascrizione', vm.tipoOperazione, vm.dettaglio, vm.margine)) )"/>
								</hlayout>
							</hlayout>
						</cell>
					</row>
					<!-- TESTATA -->
					<row visible="@load(c:addFormulaMatrimonio('formulaTestata', vm.tipoOperazione, vm.dettaglio, vm.margine))">
						<cell align="right" width="150px">
							<label value="@load(vm.etichette['Testata'])"/>
						</cell>
						<cell colspan="5">
							<hlayout hflex="1" valign="middle">
								<textbox rows="@load(not empty vm.mapFormule.formulaTestata.numeroRighe?vm.mapFormule.formulaTestata.numeroRighe:5)"
									sclass="testoAtto"
									value="@bind(vm.mapFormule.formulaTestata.testo)" hflex="1"
									disabled="@load(not (c:addFormulaMatrimonio('formulaTestata', vm.tipoOperazione, vm.dettaglio, vm.margine)) )"/>
								<hlayout sclass="testo-a-dx" width="85px">
									<button image="/images/icon/action/16x16/refresh.png"
										tooltiptext="@load(vm.etichette['Aggiorna_Formula'])" onClick="@command('onRefreshFormula', chiave='formulaTestata')"
										disabled="@load(not (c:addFormulaMatrimonio('formulaTestata', vm.tipoOperazione, vm.dettaglio, vm.margine)) )"/>
								</hlayout>
							</hlayout>
						</cell>
					</row>
					<!-- DATI MATRIMONIO -->
					<row visible="@load(c:addFormulaMatrimonio('formulaDatiMatrimonio', vm.tipoOperazione, vm.dettaglio, vm.margine))">
						<cell align="right">
							<label value="@load(vm.etichette['Dati_Matrimonio'])"/>
						</cell>
						<cell colspan="5">
							<vlayout hflex="1">
								<hlayout hflex="1" valign="middle">
									<textbox rows="@load(not empty vm.mapFormule.formulaDatiMatrimonio.numeroRighe?vm.mapFormule.formulaDatiMatrimonio.numeroRighe:5)"
											 sclass="testoAtto"
											 value="@bind(vm.mapFormule.formulaDatiMatrimonio.testo)" hflex="1"
											 disabled="@load(not (c:addFormulaMatrimonio('formulaDatiMatrimonio', vm.tipoOperazione, vm.dettaglio, vm.margine)) )"/>
									<hlayout sclass="testo-a-dx" width="85px">
										<button image="/images/icon/action/16x16/refresh.png"
												tooltiptext="@load(vm.etichette['Aggiorna_Formula'])" onClick="@command('onRefreshFormula', chiave='formulaDatiMatrimonio')"
												disabled="@load(not (c:addFormulaMatrimonio('formulaDatiMatrimonio', vm.tipoOperazione, vm.dettaglio, vm.margine)) )"/>
									</hlayout>
								</hlayout>
							</vlayout>
						</cell>
					</row>
					<!-- SPOSI -->
					<row visible="@load(c:addFormulaMatrimonio('formulaSposi', vm.tipoOperazione, vm.dettaglio, vm.margine))">
						<cell align="right">
							<label value="@load(vm.etichette['Sposi'])"/>
						</cell>
						<cell colspan="5">
							<vlayout hflex="1">
								<hlayout hflex="1" valign="middle">
									<textbox rows="@load(not empty vm.mapFormule.formulaSposi.numeroRighe?vm.mapFormule.formulaSposi.numeroRighe:5)"
											 sclass="testoAtto"
											 value="@bind(vm.mapFormule.formulaSposi.testo)" hflex="1"
											 disabled="@load(not (c:addFormulaMatrimonio('formulaSposi', vm.tipoOperazione, vm.dettaglio, vm.margine)) )"/>
									<hlayout sclass="testo-a-dx" width="85px">
										<button image="/images/icon/action/16x16/refresh.png"
												tooltiptext="@load(vm.etichette['Aggiorna_Formula'])" onClick="@command('onRefreshFormula', chiave='formulaSposi')"
												disabled="@load(not (c:addFormulaMatrimonio('formulaSposi', vm.tipoOperazione, vm.dettaglio, vm.margine)) )"/>
									</hlayout>
								</hlayout>
							</vlayout>
						</cell>
					</row>
					<!-- RICHIESTA -->
					<row visible="@load(c:addFormulaMatrimonio('formulaRichiestaFissa', vm.tipoOperazione, vm.dettaglio, vm.margine))">
						<cell align="right">
							<label value="@load(vm.etichette['Richiesta'])"/>
						</cell>
						<cell colspan="5">
							<vlayout hflex="1">
								<hlayout hflex="1" valign="middle">
									<textbox rows="@load(not empty vm.mapFormule.formulaRichiestaFissa.numeroRighe?vm.mapFormule.formulaRichiestaFissa.numeroRighe:8)"
											 sclass="testoAtto"
											 value="@bind(vm.mapFormule.formulaRichiestaFissa.testo)" hflex="1"
											 disabled="@load(not (c:addFormulaMatrimonio('formulaRichiestaFissa', vm.tipoOperazione, vm.dettaglio, vm.margine)) )"/>
									<hlayout sclass="testo-a-dx" width="85px">
										<button image="/images/icon/action/16x16/refresh.png"
												tooltiptext="@load(vm.etichette['Aggiorna_Formula'])" onClick="@command('onRefreshFormula', chiave='formulaRichiestaFissa')"
												disabled="@load(not (c:addFormulaMatrimonio('formulaRichiestaFissa', vm.tipoOperazione, vm.dettaglio, vm.margine)) )"/>
									</hlayout>
								</hlayout>
							</vlayout>
						</cell>
					</row>
					<!-- TESTIMONI -->
					<row visible="@load(c:addFormulaMatrimonio('formulaTestimoni', vm.tipoOperazione, vm.dettaglio, vm.margine))">
						<cell align="right">
							<label value="@load(vm.etichette['Testimoni'])"/>
						</cell>
						<cell colspan="5">
							<vlayout hflex="1">
								<hlayout hflex="1" valign="middle">
									<textbox rows="@load(not empty vm.mapFormule.formulaTestimoni.numeroRighe?vm.mapFormule.formulaTestimoni.numeroRighe:5)"
											 sclass="testoAtto"
											 value="@bind(vm.mapFormule.formulaTestimoni.testo)" hflex="1"
											 disabled="@load(not (c:addFormulaMatrimonio('formulaTestimoni', vm.tipoOperazione, vm.dettaglio, vm.margine)) )"/>
									<hlayout sclass="testo-a-dx" width="85px">
										<button image="/images/icon/action/16x16/refresh.png"
												tooltiptext="@load(vm.etichette['Aggiorna_Formula'])" onClick="@command('onRefreshFormula', chiave='formulaTestimoni')"
												disabled="@load(not (c:addFormulaMatrimonio('formulaTestimoni', vm.tipoOperazione, vm.dettaglio, vm.margine)) )"/>
									</hlayout>
								</hlayout>
							</vlayout>
						</cell>
					</row>
					<!-- DOCUMENTI -->
					<row visible="@load(c:addFormulaMatrimonio('formulaDocumenti', vm.tipoOperazione, vm.dettaglio, vm.margine))">
						<cell align="right">
							<label value="@load(vm.etichette['Documenti'])"/>
						</cell>
						<cell colspan="5">
							<vlayout hflex="1">
								<hlayout hflex="1" valign="middle">
									<textbox rows="2"
											 sclass="testoAtto"
											 value="@bind(vm.mapFormule.formulaDocumentiFissa.testo)" hflex="1"
											 disabled="@load(not (c:addFormulaMatrimonio('formulaDocumentiFissa', vm.tipoOperazione, vm.dettaglio, vm.margine)) )"/>
									<hlayout sclass="testo-a-dx" width="85px">
										<button image="/images/icon/action/16x16/refresh.png"
												tooltiptext="@load(vm.etichette['Aggiorna_Formula'])" onClick="@command('onRefreshFormula', chiave='formulaDocumentiFissa')"
												disabled="@load(not (c:addFormulaMatrimonio('formulaDocumentiFissa', vm.tipoOperazione, vm.dettaglio, vm.margine)) )"/>
									</hlayout>
								</hlayout>
								<hlayout hflex="1" valign="middle">
									<textbox rows="@load(not empty vm.mapFormule.formulaDocumenti.numeroRighe?vm.mapFormule.formulaDocumenti.numeroRighe:4)"
											 sclass="testoAtto"
											 value="@bind(vm.mapFormule.formulaDocumenti.testo)" hflex="1"
											 disabled="@load(not (c:addFormulaMatrimonio('formulaDocumenti', vm.tipoOperazione, vm.dettaglio, vm.margine)) )"/>
									<hlayout sclass="testo-a-dx" width="85px">
										<button image="/images/icon/action/16x16/grid.png"
												tooltiptext="@load(vm.etichette['Seleziona_Formula'])" onClick="@command('onCaricaFormuleFrammento', chiave='formulaDocumenti')"
												disabled="@load(not (c:addFormulaMatrimonio('formulaDocumenti', vm.tipoOperazione, vm.dettaglio, vm.margine)) )"/>
										<button image="/images/icon/action/16x16/refresh.png"
												tooltiptext="@load(vm.etichette['Aggiorna_Formula'])" onClick="@command('onRefreshFormula', chiave='formulaDocumenti')"
												disabled="@load(not (c:addFormulaMatrimonio('formulaDocumenti', vm.tipoOperazione, vm.dettaglio, vm.margine)) )"/>
									</hlayout>
								</hlayout>
							</vlayout>
						</cell>
					</row>
					<!-- PUBBLICAZIONI -->
					<row visible="@load(c:addFormulaMatrimonio('formulaPubblicazioni', vm.tipoOperazione, vm.dettaglio, vm.margine))">
						<cell align="right">
							<label value="@load(vm.etichette['Articoli_Pubblicazioni'])"/>
						</cell>
						<cell colspan="5" align="center">
							<vlayout hflex="1">
								<hlayout hflex="1" valign="middle">
									<textbox rows="@load(not empty vm.mapFormule.formulaPubblicazioniFissa.numeroRighe?(vm.mapFormule.formulaPubblicazioniFissa.numeroRighe/2):4)"
											 sclass="testoAtto"
											 value="@bind(vm.mapFormule.formulaPubblicazioniFissa.testo)" hflex="1"
											 disabled="@load(not (c:addFormulaMatrimonio('formulaPubblicazioniFissa', vm.tipoOperazione, vm.dettaglio, vm.margine)) )"/>
									<hlayout sclass="testo-a-dx" width="85px">
										<button image="/images/icon/action/16x16/refresh.png"
												tooltiptext="@load(vm.etichette['Aggiorna_Formula'])" onClick="@command('onRefreshFormula', chiave='formulaPubblicazioniFissa')"
												disabled="@load(not (c:addFormulaMatrimonio('formulaPubblicazioniFissa', vm.tipoOperazione, vm.dettaglio, vm.margine)) )"/>
									</hlayout>
								</hlayout>
								<hlayout hflex="1" valign="middle">
									<textbox rows="@load(not empty vm.mapFormule.formulaPubblicazioni.numeroRighe?((vm.mapFormule.formulaPubblicazioni.numeroRighe gt 4?(vm.mapFormule.formulaPubblicazioni.numeroRighe/2):vm.mapFormule.formulaPubblicazioni.numeroRighe)):4)"
											 sclass="testoAtto"
											 value="@bind(vm.mapFormule.formulaPubblicazioni.testo)" hflex="1"
											 disabled="@load(not (c:addFormulaMatrimonio('formulaPubblicazioni', vm.tipoOperazione, vm.dettaglio, vm.margine)) )"/>
									<hlayout sclass="testo-a-dx" width="85px">
										<button image="/images/icon/action/16x16/grid.png"
												tooltiptext="@load(vm.etichette['Seleziona_Formula'])" onClick="@command('onCaricaFormuleFrammento', chiave='formulaPubblicazioni')"
												disabled="@load(not (c:addFormulaMatrimonio('formulaPubblicazioni', vm.tipoOperazione, vm.dettaglio, vm.margine)) )"/>
										<button image="/images/icon/action/16x16/refresh.png"
												tooltiptext="@load(vm.etichette['Aggiorna_Formula'])" onClick="@command('onRefreshFormula', chiave='formulaPubblicazioni')"
												disabled="@load(not (c:addFormulaMatrimonio('formulaPubblicazioni', vm.tipoOperazione, vm.dettaglio, vm.margine)) )"/>
									</hlayout>
								</hlayout>
							</vlayout>
						</cell>
					</row>
					<!-- ALTRI DATI (3 FRAMMENTI) -->
					<!-- IMPEDIMENTI -->
					<row visible="@load(c:addFormulaMatrimonio('formulaAmmissioneOltreImpedimenti', vm.tipoOperazione, vm.dettaglio, vm.margine))">
						<cell align="right">
							<label value="@load(vm.etichette['Impedimenti'])"/>
						</cell>
						<cell colspan="5" align="center">
							<vlayout hflex="1" spacing="10px">
								<hlayout hflex="1" valign="middle" visible="@load(c:addFormulaMatrimonio('formulaAmmissioneOltreImpedimenti', vm.tipoOperazione, vm.dettaglio, vm.margine) )">
									<textbox rows="@load(not empty vm.mapFormule.formulaAmmissioneOltreImpedimenti.numeroRighe?(vm.mapFormule.formulaAmmissioneOltreImpedimenti.numeroRighe/2):4)"
											 sclass="testoAtto"
											 value="@bind(vm.mapFormule.formulaAmmissioneOltreImpedimenti.testo)" hflex="1"
											 disabled="@load(not (c:addFormulaMatrimonio('formulaAmmissioneOltreImpedimenti', vm.tipoOperazione, vm.dettaglio, vm.margine)) )"/>
									<hlayout sclass="testo-a-dx" width="85px">
										<button image="/images/icon/action/16x16/grid.png"
												tooltiptext="@load(vm.etichette['Seleziona_Formula'])" onClick="@command('onCaricaFormuleFrammento', chiave='formulaAmmissioneOltreImpedimenti')"
												disabled="@load(not (c:addFormulaMatrimonio('formulaAmmissioneOltreImpedimenti', vm.tipoOperazione, vm.dettaglio, vm.margine)) )"/>
										<button image="/images/icon/action/16x16/refresh.png"
												tooltiptext="@load(vm.etichette['Aggiorna_Formula'])" onClick="@command('onRefreshFormula', chiave='formulaAmmissioneOltreImpedimenti')"
												disabled="@load(not (c:addFormulaMatrimonio('formulaAmmissioneOltreImpedimenti', vm.tipoOperazione, vm.dettaglio, vm.margine)) )"/>
									</hlayout>
								</hlayout>
							</vlayout>
