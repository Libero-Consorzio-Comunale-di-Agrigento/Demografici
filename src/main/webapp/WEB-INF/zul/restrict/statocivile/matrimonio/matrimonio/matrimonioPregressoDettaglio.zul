<?xml version="1.0" encoding="UTF-8"?>
<?taglib uri="http://www.zkoss.org/dsp/web/core" prefix="c"?>
<?component name="templateSezioneSposiMatrimonioDettaglio" macroURI="/restrict/statocivile/matrimonio/matrimonio/templateSezioneSposiMatrimonioDettaglio.zul" inline="true"?>
<?component name="templateSezioneDatiMatrimonioDettaglio" macroURI="/restrict/statocivile/matrimonio/matrimonio/templateSezioneDatiMatrimonioDettaglio.zul" inline="true"?>
<?component name="templateSezioneTestimoniMatrimonioDettaglio" macroURI="/restrict/statocivile/matrimonio/matrimonio/templateSezioneTestimoniMatrimonioDettaglio.zul" inline="true"?>
<?component name="templateSezioneAttoOriginaleMatrimonioDettaglio" macroURI="/restrict/statocivile/matrimonio/matrimonio/templateSezioneAttoOriginaleMatrimonioDettaglio.zul" inline="true"?>
<?component name="templateSezioneRedazioneMatrimonioDettaglio" macroURI="/restrict/statocivile/matrimonio/matrimonio/templateSezioneRedazioneMatrimonioDettaglio.zul" inline="true"?>
<?component name="templateSezioneComposizioneMatrimonioDettaglio" macroURI="/restrict/statocivile/matrimonio/matrimonio/templateSezioneComposizioneMatrimonioDettaglio.zul" inline="true"?>

<zk xmlns="http://www.zkoss.org/2005/zul"
	xmlns:h="http://www.w3.org/1999/xhtml"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul http://www.zkoss.org/2005/zul/zul.xsd">

	<window viewModel="@id('vm') @init('restrict.statocivile.matrimonio.matrimonio.MatrimonioPregressoDettaglioViewModel')"
			apply="org.zkoss.bind.BindComposer"
			border="none"
			width="100%" height="100%"
			sizable="false" closable="false">

			<hlayout valign="middle">
				<controlBarDettaglio/>

				<controlBarAtto/>

				<label value="@load(vm.formLabel)" sclass="@load(vm.attoSclass)"/>

				<estremiAttoFormLabel/>
			</hlayout>

			<vlayout vflex="1" width="100%" sclass="scroll">

				<templateSezioneInformazioniNasMatDecUciCitPregressoDettaglio/>

				<templateSezioneSposiMatrimonioDettaglio/>

				<templateSezioneDatiMatrimonioDettaglio/>

				<templateSezioneAttoOriginaleMatrimonioDettaglio/>

				<templateSezioneTestimoniMatrimonioDettaglio/>

				<vlayout hflex="1" visible="@load(vm.composizioneTestoAttiva and (vm.statoFrammenti lt 2) and (vm.dettaglio.natura ne 'N'))">
					<templateSezioneAccessoComposizionePregressoDettaglio/>
				</vlayout>

				<vlayout hflex="1" visible="@load(vm.composizioneTestoAttiva and (vm.statoFrammenti eq 2) and (vm.dettaglio.natura ne 'N'))">
					<templateSezioneRedazioneMatrimonioDettaglio/>
					<templateSezioneComposizioneMatrimonioDettaglio/>
				</vlayout>

				<templateIdDomain/>

			</vlayout>

	</window>

</zk>