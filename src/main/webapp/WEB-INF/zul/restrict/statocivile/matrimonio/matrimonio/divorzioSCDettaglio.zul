															<datebox format="dd/MM/yyyy" value="@bind(vm.dettaglio.dataNascitaFiglio4)" width="100px"
																	 disabled="@load((vm.dettaglio.numeroFigliMinori + vm.dettaglio.numeroFigliMaggiorenni) lt 4)"/>
															/
															<intbox value="@bind(vm.dettaglio.etaFiglio4)" width="32px"
																	disabled="@load((vm.dettaglio.numeroFigliMinori + vm.dettaglio.numeroFigliMaggiorenni) lt 4)"/>
														</hlayout>
													</cell>
													<cell align="right">
														<label value="@load(vm.etichette['Codice_Fiscale'])"/>
													</cell>
													<cell colspan="4">
														<hlayout>
															<textbox value="@bind(vm.dettaglio.codiceFiscaleFiglio4)" hflex="1" style="text-transform:uppercase"
																	 disabled="@load((vm.dettaglio.numeroFigliMinori + vm.dettaglio.numeroFigliMaggiorenni) lt 4)"/>
															<button image="/images/icon/action/16x16/cancel.png"
																	tooltiptext="@load(vm.etichette['Cancella'])" onClick="@command('onCancellaCampoIstat')"
																	disabled="@load((vm.dettaglio.numeroFigliMinori + vm.dettaglio.numeroFigliMaggiorenni) lt 4)">
																<custom-attributes proprieta="codiceFiscaleFiglio4"/>
															</button>
														</hlayout>
													</cell>
												</row>

												<row>
													<cell align="right">
														<label value="@load(vm.etichette['Tipo_Affidamento'])"/>
													</cell>
													<cell colspan="4">
														<combobox model="@load(vm.listaTipoAffidamento)" readonly="true" hflex="1"
																  disabled="@load((vm.dettaglio.numeroFigliMinori + vm.dettaglio.numeroFigliMaggiorenni) lt 4)"
																  selectedItem="@bind(vm.dettaglio.affidamentoFiglio4) @converter('it.finmatica.zk.utils.PropertyConverter', property='codice')">
															<template name="model">
																<comboitem label="@load(empty each?'- -':c:cat3(each.codice, ' - ', each.descrizione) )" value="@load(each.codice)"/>
															</template>
														</combobox>
													</cell>
													<cell align="right">
														<label value="@load(vm.etichette['Numero_Pernotti'])"/>
													</cell>
													<cell colspan="4">
														<intbox value="@bind(vm.dettaglio.pernottamentiFiglio4)"
																disabled="@load((vm.dettaglio.numeroFigliMinori + vm.dettaglio.numeroFigliMaggiorenni) lt 4)"/>
													</cell>
												</row>
											</rows>
										</grid>
									</groupbox>
								</cell>
							</row>

							<row>
								<cell>
									<groupbox closable="false" open="true">
										<grid sclass="form">
											<rows>
												<row>
													<cell align="right" width="140px">
														<label value="@load(vm.etichette['Mantenimento'])"/>
													</cell>
													<cell colspan="4">
														<combobox model="@load(vm.listaTipoMantenimentoFigli)" readonly="true" hflex="1"
																  selectedItem="@bind(vm.dettaglio.mantenimentoFigli) @converter('it.finmatica.zk.utils.PropertyConverter', property='codice')">
															<template name="model">
																<comboitem label="@load(empty each?'- -':c:cat3(each.codice, ' - ', each.descrizione) )" value="@load(each.codice)"/>
															</template>
														</combobox>
													</cell>
													<cell colspan="5">
														<grid sclass="form">
															<rows>
																<row>
																	<cell align="right" width="100px">
																		<label value="1. Abitazione"/>
																	</cell>
																	<cell>
																		<intbox value="@bind(vm.dettaglio.capitoloSpesa1)"/>
																	</cell>
																</row>
																<row>
																	<cell align="right">
																		<label value="2. Abbigliamento"/>
																	</cell>
																	<cell>
																		<intbox value="@bind(vm.dettaglio.capitoloSpesa2)"/>
																	</cell>
																</row>
																<row>
																	<cell align="right">
																		<label value="3. Salute"/>
																	</cell>
																	<cell>
																		<intbox value="@bind(vm.dettaglio.capitoloSpesa3)"/>
																	</cell>
																</row>
																<row>
																	<cell align="right">
																		<label value="4. Istruzione"/>
																	</cell>
																	<cell>
																		<intbox value="@bind(vm.dettaglio.capitoloSpesa4)"/>
																	</cell>
																</row>
																<row>
																	<cell align="right">
																		<label value="5. Attività"/>
																	</cell>
																	<cell>
																		<intbox value="@bind(vm.dettaglio.capitoloSpesa5)"/>
																	</cell>
																</row>
															</rows>
														</grid>
													</cell>
												</row>
												<row>
													<cell align="right" width="140px">
														<label value="@load(vm.etichette['Chi_obbligato'])"/>
													</cell>
													<cell colspan="2">
														<combobox model="@load(vm.listaSostentamentoFigliChi)" readonly="true" width="100px"
																  selectedItem="@bind(vm.dettaglio.sostentamentoFigliChi) @converter('it.finmatica.zk.utils.PropertyConverter', property='codice')">
															<template name="model">
																<comboitem label="@load(empty each?'- -':c:cat3(each.codice, ' - ', each.descrizione) )" value="@load(each.codice)"/>
															</template>
														</combobox>
													</cell>
													<cell align="right" width="140px">
														<label value="@load(vm.etichette['Importo'])"/>
													</cell>
													<cell>
														<intbox value="@bind(vm.dettaglio.importoMensileFigli)" hflex="1"/>
													</cell>
													<cell colspan="2" align="right" width="140px">
														<label value="@load(vm.etichette['Mantenimento_Maggiorenni'])"/>
													</cell>
													<cell colspan="3">
														<combobox model="@load(vm.listaTipoMantenimentoFigliMaggiorenni)" readonly="true" hflex="1"
																  selectedItem="@bind(vm.dettaglio.mantenimentoFigliMaggiorenni) @converter('it.finmatica.zk.utils.PropertyConverter', property='codice')">
															<template name="model">
																<comboitem label="@load(empty each?'- -':c:cat3(each.codice, ' - ', each.descrizione) )" value="@load(each.codice)"/>
															</template>
														</combobox>
													</cell>
												</row>
											</rows>
										</grid>
									</groupbox>
								</cell>
							</row>
						</rows>
					</grid>
				</groupbox>
			</zk>

			<templateIdDomain/>

		</vlayout>

	</window>

</zk>