<?xml version="1.0" encoding="UTF-8"?>
<?taglib uri="http://www.zkoss.org/dsp/web/core" prefix="c"?>

<zk xmlns="http://www.zkoss.org/2005/zul"
	xmlns:h="http://www.w3.org/1999/xhtml"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xmlns:w="http://www.zkoss.org/2005/zk/client"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul http://www.zkoss.org/2005/zul/zul.xsd">

	<window viewModel="@id('vm') @init('restrict.statocivile.matrimonio.pubblicazione.PubblicazioneD3DettaglioViewModel')"
			apply="org.zkoss.bind.BindComposer"
			border="none"
			width="100%" height="100%"
			sizable="false" closable="false">

		<hlayout valign="middle">
			<controlBarDettaglio/>

			<label value="@load(vm.formLabel)" sclass="formTitle"/>

			<estremiAttoFormLabel/>

		</hlayout>

		<vlayout vflex="1" width="100%" sclass="scroll">

			<groupbox closable="false" open="true">
				<grid sclass="form">
					<rows>
						<row>
							<cell align="right" width="165px">
								<label value="@load(vm.etichette['Completo'])"/>
							</cell>
							<cell colspan="7">
								<checkbox checked="@bind(vm.dettaglio.flagCompleto)"
										  disabled="@load(empty vm.dettaglio.ufficioMatrimonio or empty vm.dettaglio.annoMatrimonio or empty vm.dettaglio.attoMatrimonio or (vm.dettaglio.attoMatrimonio le 0) or empty vm.dettaglio.parteMatrimonio)"/>
							</cell>
						</row>
					</rows>
				</grid>
			</groupbox>

			<groupbox mold="3d" closable="false" open="true" visible="@load(not (empty vm.dettaglio.ufficioMatrimonio or empty vm.dettaglio.annoMatrimonio or empty vm.dettaglio.attoMatrimonio or empty vm.dettaglio.parteMatrimonio))">
				<caption label="@load(vm.etichette['SEZIONE_DATI_MATRIMONIO'])"/>
				<grid sclass="form">
					<rows>
						<row>
							<cell align="right" width="165px">
								<label value="@load(vm.etichette['Estremi_Atto'])"/>
							</cell>
							<cell colspan="7">
								<hlayout valign="middle" spacing="5px">
									<label value="@load(vm.etichette['Numero_Atto'])" sclass="grassetto"/>
									<label value="@load(vm.dettaglio.attoMatrimonio)" sclass="grassetto" visible="@load(vm.dettaglio.attoMatrimonio gt 0)" />
									<label value="@load(vm.etichette['Provvisorio'])" sclass="grassetto" visible="@load(vm.dettaglio.attoMatrimonio le 0)"/>

									<label value=" - " visible="@load(not empty vm.dettaglio.parteMatrimonio)"/>
									<label value="@load(vm.etichette['Parte'])" sclass="grassetto" visible="@load(not empty vm.dettaglio.parteMatrimonio)"/>
									<label value="@load(vm.dettaglio.parteMatrimonio)" sclass="grassetto" visible="@load(not empty vm.dettaglio.parteMatrimonio)"/>

									<label value=" - " visible="@load(not empty vm.dettaglio.serieMatrimonio)"/>
									<label value="@load(vm.etichette['Serie'])" sclass="grassetto" visible="@load(not empty vm.dettaglio.serieMatrimonio)"/>
									<label value="@load(vm.dettaglio.serieMatrimonio)" sclass="grassetto" visible="@load(not empty vm.dettaglio.serieMatrimonio)"/>

									<label value=" - "/>
									<label value="@load(vm.etichette['Anno'])" sclass="grassetto"/>
									<label value="@load(vm.dettaglio.annoMatrimonio)" sclass="grassetto"/>

									<label value=" - "/>
									<label value="@load(vm.etichette['Ufficio'])" sclass="grassetto"/>
									<label value="@load(vm.dettaglio.ufficioMatrimonio)" sclass="grassetto"/>
								</hlayout>
							</cell>
						</row>
					</rows>
				</grid>
			</groupbox>
			
			<groupbox mold="3d" closable="false" open="true">
				<caption label="@load(vm.etichette['SEZIONE_SPOSO'])"/>
				<grid sclass="form">
					<rows>
                		<!-- i dati non modificabili li leggo dall'atto -->
						<row>
							<cell align="right" width="165px">
								<label value="@load(vm.etichette['Cognome'])"/>
							</cell>
							<cell colspan="3">
								<label value="@load(vm.atto.cognome1)" sclass="grassetto"/>
							</cell>
							<cell align="right" width="165px">
								<label value="@load(vm.etichette['Nome'])"/>
							</cell>
							<cell colspan="3">
								<label value="@load(vm.atto.nome1)" sclass="grassetto"/>
							</cell>
						</row>
						<row>
							<cell align="right">
								<label value="@load(vm.etichette['Data_Nascita'])"/>
							</cell>
							<cell colspan="3">
								<label value="@load(empty vm.atto.dataNascita1? null:(c:formatDate(vm.atto.dataNascita1, 'dd/MM/yyyy')))" sclass="grassetto"/>
							</cell>
							<cell align="right">
								<label value="@load(vm.etichette['Luogo_Nascita'])"/>
							</cell>
							<cell colspan="3">
                                <label value="@load(c:cat4(vm.atto.descrizioneComuneNascita1, empty vm.atto.siglaProvinciaNascita1?'':' (', vm.atto.siglaProvinciaNascita1, empty vm.atto.siglaProvinciaNascita1?'':') '))" sclass="grassetto"/>
                            </cell>
						</row>
						<row>
							<cell align="right">
								<label value="@load(vm.etichette['Codice_Fiscale'])"/>
							</cell>
							<cell colspan="3">
								<label value="@load(vm.atto.codiceFiscale1)" hflex="1" sclass="grassetto" />
							</cell>
							<cell align="right">
								<label value="@load(vm.etichette['Luogo_Residenza'])"/>
							</cell>
							<cell colspan="3">
                                <label value="@load(c:cat4(vm.atto.descrizioneComuneResidenza1, empty vm.atto.siglaProvinciaResidenza1?'':' (', vm.atto.siglaProvinciaResidenza1, empty vm.atto.siglaProvinciaResidenza1?'':') '))" sclass="grassetto"/>
                            </cell>
						</row>

						<row>
							<cell align="right">
								<label value="@load(vm.etichette['Luogo_Residenza_Post_Matrimonio'])"/>
							</cell>
							<cell colspan="3">
								<hlayout valign="middle" hflex="1">
									<bandboxComuni hflex="1"
												   value="@load(vm.dettaglio.comuneResidenza1.descrizione)"
												   onSelect="@command('onSelectComune', campoRiferimento='CR_SOGG_1')"/>
									<button image="/images/icon/action/16x16/cancel.png"
											tooltiptext="@load(vm.etichette['Cancella'])" onClick="@command('onCancellaComune', campoRiferimento='CR_SOGG_1')"/>
								</hlayout>
							</cell>
							<cell>
								<textbox value="@load(vm.dettaglio.comuneResidenza1.siglaProvincia)" readonly="true" hflex="1"/>
							</cell>
							<cell colspan="3"/>
						</row>

                        <templateRowCIT_1/>

						<row>
							<cell align="right">
								<h:span class="mandatoryLabel" >*</h:span><label value="@load(vm.etichette['Stato_Civile_Pre_Matrimonio'])"/>
							</cell>
							<cell colspan="3">
								<combobox model="@load(vm.listaStatoCivile1)" readonly="true" hflex="1"
										  selectedItem="@bind(vm.dettaglio.statoCivile1) @converter('it.finmatica.zk.utils.PropertyConverter', property='codiceAds')">
									<template name="model">
										<comboitem label="@load(empty each?'- -':c:cat3(each.codice, ' - ', each.descrizione) )" value="@load(each.codiceAds)"/>
									</template>
								</combobox>
							</cell>
							<cell align="right">
								<label value="@load(vm.etichette['Data_cessazione_matrimonio_precedente'])"/>
							</cell>
							<cell colspan="3">
								<hlayout>
									<datebox format="dd/MM/yyyy" value="@bind(vm.dettaglio.dataFineMatrimonio1)" width="100px"/>
									<button image="/images/icon/action/16x16/cancel.png"
											tooltiptext="@load(vm.etichette['Cancella'])" onClick="@command('onCancellaCampoIstat')">
										<custom-attributes proprieta="dataFineMatrimonio1"/>
									</button>
								</hlayout>
							</cell>
						</row>

						<templateRowGDI_PNP_CNP_RDA_1/>
					</rows>
				</grid>
			</groupbox>

			<groupbox mold="3d" closable="false" open="true">
				<caption label="@load(vm.etichette['SEZIONE_SPOSA'])"/>
				<grid sclass="form">
					<rows>
						<!-- i dati non modificabili li leggo dall'atto -->
						<row>
							<cell align="right" width="165px">
								<label value="@load(vm.etichette['Cognome'])"/>
							</cell>
							<cell colspan="3">
								<label value="@load(vm.atto.cognome2)" sclass="grassetto"/>
							</cell>
							<cell align="right" width="165px">
								<label value="@load(vm.etichette['Nome'])"/>
							</cell>
							<cell colspan="3">
								<label value="@load(vm.atto.nome2)" sclass="grassetto"/>
							</cell>
						</row>
						<row>
							<cell align="right">
								<label value="@load(vm.etichette['Data_Nascita'])"/>
							</cell>
							<cell colspan="3">
								<label value="@load(empty vm.atto.dataNascita2? null:(c:formatDate(vm.atto.dataNascita2, 'dd/MM/yyyy')))" sclass="grassetto"/>
							</cell>
							<cell align="right">
								<label value="@load(vm.etichette['Luogo_Nascita'])"/>
							</cell>
							<cell colspan="3">
                                <label value="@load(c:cat4(vm.atto.descrizioneComuneNascita2, empty vm.atto.siglaProvinciaNascita2?'':' (', vm.atto.siglaProvinciaNascita2, empty vm.atto.siglaProvinciaNascita2?'':') '))" sclass="grassetto"/>
							</cell>
						</row>
						<row>
							<cell align="right">
								<label value="@load(vm.etichette['Codice_Fiscale'])"/>
							</cell>
							<cell colspan="3">
								<label value="@load(vm.atto.codiceFiscale2)" hflex="1" sclass="grassetto" />
							</cell>
							<cell align="right">
								<label value="@load(vm.etichette['Luogo_Residenza'])"/>
							</cell>
							<cell colspan="3">
                                <label value="@load(c:cat4(vm.atto.descrizioneComuneResidenza2, empty vm.atto.siglaProvinciaResidenza2?'':' (', vm.atto.siglaProvinciaResidenza2, empty vm.atto.siglaProvinciaResidenza2?'':') '))" sclass="grassetto"/>
                            </cell>
						</row>

						<row>
							<cell align="right">
								<label value="@load(vm.etichette['Luogo_Residenza_Post_Matrimonio'])"/>
							</cell>
							<cell colspan="3">
								<hlayout valign="middle" hflex="1">
									<bandboxComuni hflex="1"
												   value="@load(vm.dettaglio.comuneResidenza2.descrizione)"
												   onSelect="@command('onSelectComune', campoRiferimento='CR_SOGG_2')"/>
									<button image="/images/icon/action/16x16/cancel.png"
											tooltiptext="@load(vm.etichette['Cancella'])" onClick="@command('onCancellaComune', campoRiferimento='CR_SOGG_2')"/>
								</hlayout>
							</cell>
							<cell>
								<textbox value="@load(vm.dettaglio.comuneResidenza2.siglaProvincia)" readonly="true" hflex="1"/>
							</cell>
							<cell colspan="3"/>
						</row>

                        <templateRowCIT_2/>

						<row>
							<cell align="right">
								<h:span class="mandatoryLabel" >*</h:span><label value="@load(vm.etichette['Stato_Civile_Pre_Matrimonio'])"/>
							</cell>
							<cell colspan="3">
								<combobox model="@load(vm.listaStatoCivile2)" readonly="true" hflex="1"
										  selectedItem="@bind(vm.dettaglio.statoCivile2) @converter('it.finmatica.zk.utils.PropertyConverter', property='codiceAds')">
									<template name="model">
										<comboitem label="@load(empty each?'- -':c:cat3(each.codice, ' - ', each.descrizione) )" value="@load(each.codiceAds)"/>
									</template>
								</combobox>
							</cell>
							<cell align="right">
								<label value="@load(vm.etichette['Data_cessazione_matrimonio_precedente'])"/>
							</cell>
							<cell colspan="3">
								<hlayout>
									<datebox format="dd/MM/yyyy" value="@bind(vm.dettaglio.dataFineMatrimonio2)" width="100px"/>
									<button image="/images/icon/action/16x16/cancel.png"
											tooltiptext="@load(vm.etichette['Cancella'])" onClick="@command('onCancellaCampoIstat')">
										<custom-attributes proprieta="dataFineMatrimonio2"/>
									</button>
								</hlayout>
							</cell>
						</row>

						<templateRowGDI_PNP_CNP_RDA_2/>
					</rows>
				</grid>
			</groupbox>

			<templateIdDomain/>

		</vlayout>

	</window>

</zk>