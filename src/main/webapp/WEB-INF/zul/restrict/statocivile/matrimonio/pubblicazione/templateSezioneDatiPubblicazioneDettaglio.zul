<?xml version="1.0" encoding="UTF-8"?>
<?taglib uri="http://www.zkoss.org/dsp/web/core" prefix="c"?>

<zk xmlns="http://www.zkoss.org/2005/zul"
	xmlns:h="http://www.w3.org/1999/xhtml"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul http://www.zkoss.org/2005/zul/zul.xsd">

	<!-- DATI PUBBLICAZIONE -->
	<groupbox mold="3d" hflex="1" open="false">
		<caption sclass="mainCaption">
			<div>
				<updownbutton onClick="@command(self.openClose())" sclass="captionButton"/>
				<label value="@load(vm.etichette['SEZIONE_DATI_PUBBLICAZIONE'])" sclass="captionLabel"/>
			</div>
		</caption>
		<groupbox closable="false">
			<caption label="@load(vm.etichette['Dati_Affissione'])"/>
			<grid sclass="form">
				<rows>
					<row>
						<cell align="right" width="150px">
							<h:span class="mandatoryLabel">*</h:span><label value="@load(vm.etichette['Comune_Matrimonio'])"/>
						</cell>
						<cell colspan="5">
							<hlayout valign="middle" hflex="1">
								<bandboxComuni hflex="1"
											   value="@load(vm.dettaglio.descrizioneComuneMatrimonio)"
											   dataRiferimento="@load(vm.dettaglio.dataPubblicazione)"
											   onSelect="@command('onSelectComune', campoRiferimento='CC_MATR')"/>
								<button image="/images/icon/action/16x16/cancel.png"
										tooltiptext="@load(vm.etichette['Cancella'])" onClick="@command('onCancellaComune', campoRiferimento='CC_MATR')"
								/>
							</hlayout>
						</cell>
						<cell width="40px">
							<textbox value="@load(vm.dettaglio.siglaProvinciaMatrimonio)" hflex="1" readonly="true"/>
						</cell>
						<cell width="20px"/>
						<cell/>
						<cell width="20px"/>
						<cell colspan="3"/>
					</row>
					<row>
						<cell align="right">
							<label value="@load(vm.etichette['Data_Pubblicazione'])"/>
						</cell>
						<cell colspan="5">
							<hlayout valign="middle">
								<datebox format="dd/MM/yyyy" value="@bind(vm.dettaglio.dataPubblicazione)" width="100px"/>
								<button image="/images/icon/action/16x16/cancel.png" style="padding-left:3px"
										tooltiptext="@load(vm.etichette['Cancella'])" onClick="@command('onCancellaCampoAtto')">
									<custom-attributes proprieta="dataPubblicazione"/>
								</button>
							</hlayout>
						</cell>
						<cell colspan="7"/>
					</row>
					<row>
						<cell align="right">
							<h:span class="mandatoryLabel">*</h:span><label value="@load(vm.etichette['Comuni_pubblicazione'])"/>
						</cell>
						<cell colspan="12">
							<radiogroup model="@load(vm.listaDocumentiPresentati)" onCheck="@command('onSelectDocumentoPresentato')"
										selectedItem="@bind(vm.margine.documentoPresentatoMatrimonio) @converter('it.finmatica.zk.utils.PropertyConverter', property='id')">
								<template name="model">
									<radio label="@load(vm.getEtichettaEnum(each))" value="@load(each)" style="padding-left:10px"/>
								</template>
							</radiogroup>
						</cell>
					</row>
					<row>
						<cell align="right">
							<label value="@load(vm.etichette['Affissione_nel_Comune_di'])" />
						</cell>
						<cell colspan="5">
							<hlayout valign="middle" hflex="1">
								<bandboxComuni hflex="1"
											   value="@load(vm.margine.comuneAffissione1.descrizione)"
											   dataRiferimento="@load(vm.margine.dataAffissioneDa1)"
											   disabled="@load(vm.margine.documentoPresentatoMatrimonio.isOmessaPubblicazione())"
											   onSelect="@command('onSelectComune', campoRiferimento='CA_PUBB1')"/>
								<button image="/images/icon/action/16x16/cancel.png"
										tooltiptext="@load(vm.etichette['Cancella'])"
										disabled="@load(vm.margine.documentoPresentatoMatrimonio.isOmessaPubblicazione())"
										onClick="@command('onCancellaComune', campoRiferimento='CA_PUBB1')"
								/>
							</hlayout>
						</cell>
						<cell>
							<textbox value="@load(vm.margine.comuneAffissione1.siglaProvincia)" hflex="1" readonly="true"/>
						</cell>
						<cell align="right">
							<label value="@load(vm.etichette['Dal'])" />
						</cell>
						<cell>
							<datebox format="dd/MM/yyyy" width="95px" disabled="@load(vm.margine.documentoPresentatoMatrimonio.isOmessaPubblicazione())"
									 value="@bind(vm.margine.dataAffissioneDa1)"/>
						</cell>
						<cell align="right">
							<label value="@load(vm.etichette['Al'])" />
						</cell>
						<cell>
							<datebox format="dd/MM/yyyy" width="95px" disabled="@load(vm.margine.documentoPresentatoMatrimonio.isOmessaPubblicazione())"
									 value="@bind(vm.margine.dataAffissioneA1)"/>
						</cell>
						<cell align="right">
							<label value="@load(vm.etichette['durata_giorni_pubblicazione'])" />
						</cell>
						<cell>
							<textbox value="@bind(vm.margine.giorniAffissione)" width="100px" disabled="@load(vm.margine.documentoPresentatoMatrimonio.isOmessaPubblicazione())"/>
						</cell>
					</row>
					<row>
						<cell align="right">
							<label value="@load(vm.etichette['Affissione_nel_Comune_di'])" />
						</cell>
						<cell colspan="5">
							<hlayout valign="middle" hflex="1">
								<bandboxComuni hflex="1"
											   value="@load(vm.margine.comuneAffissione2.descrizione)"
											   dataRiferimento="@load(vm.margine.dataAffissioneDa2)"
											   disabled="@load(vm.margine.documentoPresentatoMatrimonio.isUno() or vm.margine.documentoPresentatoMatrimonio.isOmessaPubblicazione())"
											   onSelect="@command('onSelectComune', campoRiferimento='CA_PUBB2')"/>
								<button image="/images/icon/action/16x16/cancel.png"
										tooltiptext="@load(vm.etichette['Cancella'])"
										disabled="@load(vm.margine.documentoPresentatoMatrimonio.isUno() or vm.margine.documentoPresentatoMatrimonio.isOmessaPubblicazione())"
										onClick="@command('onCancellaComune', campoRiferimento='CA_PUBB2')"
								/>
							</hlayout>
						</cell>
						<cell>
							<textbox value="@load(vm.margine.comuneAffissione2.siglaProvincia)" hflex="1" readonly="true"/>
						</cell>
						<cell align="right">
							<label value="@load(vm.etichette['Dal'])" />
						</cell>
						<cell>
							<datebox format="dd/MM/yyyy" width="95px" disabled="@load(vm.margine.documentoPresentatoMatrimonio.isUno() or vm.margine.documentoPresentatoMatrimonio.isOmessaPubblicazione())"
									 value="@bind(vm.margine.dataAffissioneDa2)"/>
						</cell>
						<cell align="right">
							<label value="@load(vm.etichette['Al'])" />
						</cell>
						<cell>
							<datebox format="dd/MM/yyyy" width="95px" disabled="@load(vm.margine.documentoPresentatoMatrimonio.isUno() or vm.margine.documentoPresentatoMatrimonio.isOmessaPubblicazione())"
									 value="@bind(vm.margine.dataAffissioneA2)"/>
						</cell>
						<cell colspan="2"/>
						<!--<cell align="right">
							<label value="@load(vm.etichette['durata_giorni_pubblicazione'])" />
						</cell>
						<cell>
							<textbox value="xxxxxxx" hflex="1"/>
						</cell> -->
					</row>
				</rows>
			</grid>
		</groupbox>

		<groupbox closable="false">
			<caption label="@load(vm.etichette['Dati_Certificato'])"/>
			<grid sclass="form">
				<rows>
					<row>
						<cell align="right" width="200px">
							<label value="@load(vm.etichette['Articolo_Certificato_rilasciato'])"/>
						</cell>
						<cell>
							<intbox value="@bind(vm.margine.articoloCertificato)" hflex="1"/>
						</cell>
						<cell align="right" width="135px">
							<label value="@load(vm.etichette['Legge_Certificato_rilasciato'])"/>
						</cell>
						<cell colspan="7">
							<textbox value="@bind(vm.margine.leggeCertificato)" hflex="1"/>
						</cell>
					</row>
				</rows>
			</grid>
		</groupbox>

	</groupbox>

</zk>