<?xml version="1.0" encoding="UTF-8"?>
<?taglib uri="http://www.zkoss.org/dsp/web/core" prefix="c"?>

<zk xmlns="http://www.zkoss.org/2005/zul"
	xmlns:h="http://www.w3.org/1999/xhtml"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul http://www.zkoss.org/2005/zul/zul.xsd">

	<row>
		<cell>
			<groupbox closable="false">
				<caption label="@load(vm.etichette['Dati_Atto_Notarile'])"/>
				<grid sclass="form">
					<rows>
						<row>
							<cell align="right" width="160px">
								<label value="@load(vm.etichette['Atto_Notarile'])" />
							</cell>
							<cell colspan="5">
								<hlayout height="20px">
									<radiogroup model="@load(vm.listaSiNo)" hflex="1"
												selectedItem="@bind(vm.datiProvenienza.attoNotarile) @converter('it.finmatica.zk.utils.PropertyConverter', property='id')">
										<template name="model">
											<radio label="@load(vm.getEtichettaEnum(each))" value="@load(each)" style="padding-left:10px"/>
										</template>
									</radiogroup>
								</hlayout>
							</cell>
						</row>
						<row visible="@load(vm.datiProvenienza.attoNotarile eq 'SI')">
							<cell align="right">
								<zk if="${vm.anscOn}">
									<h:span class="mandatoryLabel">*</h:span>
								</zk>
								<label value="@load(vm.etichette['Nome_Ente'])"/>
							</cell>
							<cell colspan="5">
								<hlayout valign="middle" hflex="1">
									<textbox hflex="1" value="@bind(vm.datiProvenienza.nomeEnteNotarile)"/>
									<button image="/images/icon/action/16x16/cancel.png"
											tooltiptext="@load(vm.etichette['Cancella'])" onClick="@command('onCancellaCampoProvenienza')">
										<custom-attributes proprieta="nomeEnteNotarile"/>
									</button>
								</hlayout>
							</cell>
						</row>
						<row visible="@load(vm.datiProvenienza.attoNotarile eq 'SI')">
							<cell align="right">
								<zk if="${vm.anscOn}">
									<h:span class="mandatoryLabel">*</h:span>
								</zk>
								<label value="@load(vm.etichette['Comune_Atto'])"/>
							</cell>
							<cell colspan="4">
								<hlayout valign="middle" hflex="1">
									<bandboxComuni hflex="1"
												   value="@load(vm.datiProvenienza.comuneAttoNotarile.descrizione)"
												   dataRiferimento="@load(vm.datiProvenienza.dataAttoNotarile)"
												   onSelect="@command('onSelectComune', campoRiferimento='CA_NOT')"/>
									<button image="/images/icon/action/16x16/cancel.png"
											tooltiptext="@load(vm.etichette['Cancella'])" onClick="@command('onCancellaComune', campoRiferimento='CA_NOT')"
									/>
								</hlayout>
							</cell>
							<cell>
								<textbox value="@load(vm.datiProvenienza.comuneAttoNotarile.siglaProvincia)" readonly="true" hflex="1"/>
							</cell>
						</row>
						<row visible="@load(vm.datiProvenienza.attoNotarile eq 'SI')">
							<cell align="right">
								<zk if="${vm.anscOn}">
									<h:span class="mandatoryLabel">*</h:span>
								</zk>
								<label value="@load(vm.etichette['Estremi_Atto_Notarile'])"/>
							</cell>
							<cell colspan="3">
								<hlayout valign="middle">
									<textbox value="@bind(vm.datiProvenienza.estremiAttoNotarile)" hflex="1"/>
									<button image="/images/icon/action/16x16/cancel.png"
											tooltiptext="@load(vm.etichette['Cancella'])" onClick="@command('onCancellaCampoProvenienza')">
										<custom-attributes proprieta="estremiAttoNotarile"/>
									</button>
								</hlayout>
							</cell>
							<cell align="right">
								<zk if="${vm.anscOn}">
									<h:span class="mandatoryLabel">*</h:span>
								</zk>
								<label value="@load(vm.etichette['In_data'])"/>
							</cell>
							<cell colspan="1">
								<hlayout valign="middle" hflex="1">
									<datebox format="dd/MM/yyyy" value="@bind(vm.datiProvenienza.dataAttoNotarile)" width="100px"/>
									<button image="/images/icon/action/16x16/cancel.png"
											tooltiptext="@load(vm.etichette['Cancella'])" onClick="@command('onCancellaCampoProvenienza')">
										<custom-attributes proprieta="dataAttoNotarile"/>
									</button>
								</hlayout>
							</cell>
						</row>
					</rows>
				</grid>
			</groupbox>
		</cell>
	</row>

</zk>