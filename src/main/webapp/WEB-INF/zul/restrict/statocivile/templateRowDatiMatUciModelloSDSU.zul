<?xml version="1.0" encoding="UTF-8"?>
<?taglib uri="http://www.zkoss.org/dsp/web/core" prefix="c"?>

<zk xmlns="http://www.zkoss.org/2005/zul"
	xmlns:h="http://www.w3.org/1999/xhtml"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xmlns:w="http://www.zkoss.org/2005/zk/client"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul http://www.zkoss.org/2005/zul/zul.xsd">

	<row>
		<cell align="right" width="165px">
			<h:span class="mandatoryLabel" >*</h:span><label value="@load(vm.etichetteCustom['DataMatUci'])"/>
		</cell>
		<cell colspan="3">
			<hlayout>
				<datebox format="dd/MM/yyyy" value="@bind(vm.dettaglio.dataMatUci)" width="100px"/>
				<button image="/images/icon/action/16x16/cancel.png"
						tooltiptext="@load(vm.etichette['Cancella'])" onClick="@command('onCancellaCampoIstat')">
					<custom-attributes proprieta="dataMatUci"/>
				</button>
			</hlayout>
		</cell>
		<cell align="right" width="150px">
			<h:span class="mandatoryLabel" >*</h:span><label value="@load(vm.etichetteCustom['ComuneMatUci'])"/>
		</cell>
		<cell colspan="3">
			<hlayout valign="middle" hflex="1">
				<bandboxComuni hflex="1"
							   value="@load(vm.dettaglio.comuneMatUci.descrizione)"
							   dataRiferimento="@load(vm.dettaglio.dataMatUci)"
							   onSelect="@command('onSelectComune', campoRiferimento='CC_MATR')"/>
				<button image="/images/icon/action/16x16/cancel.png"
						tooltiptext="@load(vm.etichette['Cancella'])" onClick="@command('onCancellaComune', campoRiferimento='CC_MATR')"
				/>
				<textbox value="@load(vm.dettaglio.comuneMatUci.siglaProvincia)" readonly="true" width="60px"/>
			</hlayout>
		</cell>
	</row>
	<row>
		<zk if="${vm.tipoAttoEnum.isMatrimonio()}">
			<cell align="right">
				<h:span class="mandatoryLabel" >*</h:span><label value="@load(vm.etichette['Rito'])"/>
			</cell>
			<cell colspan="3">
				<hlayout height="20px">
					<radiogroup model="@load(vm.listaRito)" hflex="1"
								selectedItem="@bind(vm.dettaglio.rito) @converter('it.finmatica.zk.utils.PropertyConverter', property='codice')">
						<template name="model">
							<radio label="@load(c:cat3(each.codice, ' - ', each.descrizione))" value="@load(each.codice)" style="padding-left:20px;font-weight: bold"/>
						</template>
					</radiogroup>
				</hlayout>
			</cell>
		</zk>		
		<cell align="right">
			<label value="@load(vm.etichette['Regime_patrimoniale'])"/>
		</cell>
		<cell colspan="3">
			<hlayout height="20px">
				<radiogroup model="@load(vm.listaRegimePatrimoniale)" hflex="1"
							selectedItem="@bind(vm.dettaglio.regimePatrimoniale) @converter('it.finmatica.zk.utils.PropertyConverter', property='codice')">
					<template name="model">
						<radio label="@load(c:cat3(each.codice, ' - ', each.descrizione))" value="@load(each.codice)" style="padding-left:20px;font-weight: bold"/>
					</template>
				</radiogroup>
			</hlayout>
		</cell>
		<zk if="${vm.tipoAttoEnum.isUnioneCivile()}">
			<cell colspan="4"/>
		</zk>
	</row>

</zk>