<?xml version="1.0" encoding="UTF-8"?>
<?taglib uri="http://www.zkoss.org/dsp/web/core" prefix="c"?>

<zk xmlns="http://www.zkoss.org/2005/zul"
	xmlns:h="http://www.w3.org/1999/xhtml"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul http://www.zkoss.org/2005/zul/zul.xsd">

	<grid hflex="1">
		<rows>
			<row>
				<cell align="right" width="90px">
					<h:span class="mandatoryLabel">*</h:span><label value="@load(vm.etichette['Numero_Atto'])"/>
				</cell>
				<cell width="80px">
					<intbox value="@bind(vm.datiProvenienza.numeroAttoAssenso)" width="75px"/>
				</cell>
				<cell align="right" width="40px">
					<label value="@load(vm.etichette['Parte'])"/>
				</cell>
				<cell width="50px">
					<textbox value="@bind(vm.datiProvenienza.parteAttoAssenso)" width="45px"/>
				</cell>
				<cell align="right" width="40px">
					<label value="@load(vm.etichette['Serie'])"/>
				</cell>
				<cell width="50px">
					<textbox value="@bind(vm.datiProvenienza.serieAttoAssenso)" width="45px" maxlength="1" style="text-transform:uppercase"/>
				</cell>
				<cell align="right" width="40px">
					<label value="@load(vm.etichette['Ufficio'])"/>
				</cell>
				<cell width="50px">
					<intbox value="@bind(vm.datiProvenienza.ufficioAttoAssenso)" width="45px"/>
				</cell>
				<cell align="right" width="40px">
					<h:span class="mandatoryLabel">*</h:span><label value="@load(vm.etichette['Anno'])"/>
				</cell>
				<cell width="50px">
					<intbox value="@bind(vm.datiProvenienza.annoAttoAssenso)"
							maxlength="4" width="45px"/>
				</cell>
				<cell align="right" width="75px">
					<label value="@load(vm.etichette['Id_Atto_Ansc'])"/>
				</cell>
				<cell>
					<textbox value="@bind(vm.datiProvenienza.idAttoAnscAssenso)" hflex="1"/>
				</cell>
			</row>
			<row>
				<cell align="right">
					<h:span class="mandatoryLabel">*</h:span><label value="@load(vm.etichette['Comune_Atto'])"/>
				</cell>
				<cell colspan="8">
					<hlayout valign="middle" hflex="1">
						<bandboxComuni hflex="1"
									   value="@bind(vm.datiProvenienza.comuneAttoAssenso.descrizione)"
									   onSelect="@command('onSelectComune', campoRiferimento='CA_ASS')"/>
						<button image="/images/icon/action/16x16/cancel.png"
								tooltiptext="@load(vm.etichette['Cancella'])" onClick="@command('onCancellaComune', campoRiferimento='CA_ASS')"/>
					</hlayout>
				</cell>
				<cell>
					<textbox value="@load(vm.datiProvenienza.comuneAttoAssenso.siglaProvincia)" hflex="1" readonly="true"/>
				</cell>
				<cell align="right">
					<h:span class="mandatoryLabel">*</h:span><label value="@load(vm.etichette['Data_Atto'])"/>
				</cell>
				<cell>
					<datebox format="dd/MM/yyyy" value="@bind(vm.datiProvenienza.dataAttoAssenso)" width="95px"/>
				</cell>
			</row>
		</rows>
	</grid>

</zk>