<?xml version="1.0" encoding="UTF-8"?>
<?taglib uri="http://www.zkoss.org/dsp/web/core" prefix="c"?>

<zk xmlns="http://www.zkoss.org/2005/zul"
	xmlns:h="http://www.w3.org/1999/xhtml"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul http://www.zkoss.org/2005/zul/zul.xsd">

	<window viewModel="@id('vm') @init('restrict.statocivile.documenti.DocumentoListaSelectViewModel')"
			apply="org.zkoss.bind.BindComposer"
			border="none"
			width="860px" height="400px"
			title="@load(vm.etichette['Seleziona'])"
			sizable="false" closable="false">

		<vlayout vflex="1">

			<hlayout sclass="navigazione" valign="middle">
				<totalSizeBlock/>
			</hlayout>

			<listbox model="@load(vm.lista)" selectedItem="@bind(vm.dettaglio)" nonselectableTags="" vflex="1"
					 emptyMessage="@load(vm.etichette['Nessun_dato_disponibile'])">
				<listhead>
					<listheader label="@load(vm.etichette['Documento_identita'])"	/>
					<listheader label="@load(vm.etichette['Numero'])"			 	width="120px"/>
					<listheader label="@load(vm.etichette['Ente_Rilascio'])"	 	/>
					<listheader label="@load(vm.etichette['Comune'])"	 			/>
					<listheader label="@load(vm.etichette['Data_Rilascio'])"	    width="90px"/>
					<listheader label="@load(vm.etichette['Data_Scadenza'])"	    width="90px"/>
					<listheader label="" width="52px"/>
				</listhead>
				<template name="model" var="item">
					<listitem onDoubleClick="@command('onSeleziona')">
						<listcell label="@load(c:cat3(item.TIPO_DI, ' - ', item.DESCRIZIONE_DI))" />
						<listcell label="@load(item.NUMERO_DI)" />
						<listcell label="@load(item.DESCRIZIONE_ENTE_EMISSIONE_DI)" />
						<listcell label="@load(item.DESCRIZIONE_COM_ENTE_DI)" />
						<listcell label="@load(empty item.D_DATA_EMISSIONE_DI? null:(c:formatDate(item.D_DATA_EMISSIONE_DI, 'dd/MM/yyyy')))"/>
						<listcell label="@load(empty item.D_DATA_SCADENZA_DI? null:(c:formatDate(item.D_DATA_SCADENZA_DI, 'dd/MM/yyyy')))"/>
						<listcell>
							<button image="/images/icon/action/16x16/forward.png"
									tooltiptext="@load(vm.etichette['seleziona_tooltip'])"
									visible="@load(not empty item)"
									onClick="@command('onSeleziona')"/>
						</listcell>
					</listitem>
				</template>
			</listbox>

		</vlayout>

		<h:div sclass="barraPulsanti">
			<h:div>
				<button label="@load(vm.etichette['Seleziona'])"		onClick="@command('onSeleziona')" 	image="/images/icon/action/16x16/ok.png" />
				<button label="@load(vm.etichette['Chiudi'])"			onClick="@command('onChiudi')" 		image="/images/icon/action/16x16/close.png"/>
			</h:div>
		</h:div>

	</window>

</zk>