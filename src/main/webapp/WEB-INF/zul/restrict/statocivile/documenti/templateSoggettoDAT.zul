<?xml version="1.0" encoding="UTF-8"?>
<?taglib uri="http://www.zkoss.org/dsp/web/core" prefix="c"?>

<zk xmlns="http://www.zkoss.org/2005/zul"
    xmlns:h="http://www.w3.org/1999/xhtml"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.zkoss.org/2005/zul http://www.zkoss.org/2005/zul/zul.xsd">

    <window viewModel="@id('vm') @init('restrict.statocivile.documenti.SoggettoDATViewModel')"
            apply="org.zkoss.bind.BindComposer"
            border="none"
            width="100%" height="100%"
            sizable="false" closable="false">

            <groupbox closable="false">
                <caption label="@load(vm.etichette['Dati_Anagrafici'])"/>
                <grid sclass="form">
                    <rows>
                        <row>
                            <cell align="right" width="160px">
                                <hlayout>
                                    <hbox visible="@load(vm.isDisponente)">
                                        <h:span class="mandatoryLabel" style="top:0.15em;right:0px;">*</h:span>
                                    </hbox>
                                    <label value="@load(vm.etichette['Cognome'])"/>
                                </hlayout>
                            </cell>
                            <cell colspan="5">
                                <hlayout valign="middle" hflex="1">
                                    <textbox value="@bind(vm.dettaglio.cognome)" hflex="1"
                                             onChange="@command('onAggiornaCaseAndAna', campoAnagrafe='COGNOME_SOGGETTO')"
                                             style="@load(vm.minuscole.cognome?'text-transform:none':'text-transform:uppercase')">
                                        <custom-attributes proprieta="cognome"/>
                                    </textbox>
                                    <button image="/images/icon/action/16x16/cancel.png"
                                            tooltiptext="@load(vm.etichette['Cancella'])"
                                            onClick="@command('onCancellaCampoDAT', campoAnagrafe='COGNOME_SOGGETTO')">
                                        <custom-attributes proprieta="cognome"/>
                                    </button>
                                    <space/>
                                </hlayout>
                            </cell>
                            <cell align="right" width="85px">
                                <hlayout valign="middle">
                                    <label value="@load(vm.etichette['Minuscole'])"/>
                                    <checkbox checked="@bind(vm.minuscole.cognome)" onCheck="@command('onAggiornaCase')">
                                        <custom-attributes proprieta="cognome"/>
                                    </checkbox>
                                </hlayout>
                            </cell>
                            <cell align="right" width="90px">
                                <label value="@load(vm.etichette['Matricola'])"/>
                            </cell>
                            <cell>
                                <intbox value="@load(vm.dettaglio.matricola)" disabled="true" hflex="1" cols="7"/>
                            </cell>
                        </row>
                        <row>
                            <cell align="right">
                                <hlayout>
                                    <hbox visible="@load(vm.isDisponente)">
                                        <h:span class="mandatoryLabel" style="top:0.15em;right:0px;">*</h:span>
                                    </hbox>
                                    <label value="@load(vm.etichette['Nome'])"/>
                                </hlayout>
                            </cell>
                            <cell colspan="5">
                                <hlayout valign="middle" hflex="1">
                                    <textbox value="@bind(vm.dettaglio.nome)" hflex="1"
                                             onChange="@command('onAggiornaCaseAndAna', campoAnagrafe='NOME_SOGGETTO')"
                                             style="@load(vm.minuscole.nome?'text-transform:none':'text-transform:uppercase')">
                                        <custom-attributes proprieta="nome"/>
                                    </textbox>
                                    <button image="/images/icon/action/16x16/search.png"
                                            tooltiptext="@load(vm.etichette['Seleziona'])" onClick="@command('onCaricaSoggetti', tipoSoggetto='SOGGETTO')"/>
                                    <button image="/images/icon/action/16x16/cancel.png"
                                            tooltiptext="@load(vm.etichette['Cancella'])"
                                            onClick="@command('onCancellaCampoDAT', campoAnagrafe='NOME_SOGGETTO')">
                                        <custom-attributes proprieta="nome"/>
                                    </button>
                                    <space/>
                                </hlayout>
                            </cell>
                            <cell align="right" width="85px">
                                <hlayout valign="middle" >
                                    <label value="@load(vm.etichette['Minuscole'])"/>
                                    <checkbox checked="@bind(vm.minuscole.nome)" onCheck="@command('onAggiornaCase')">
                                        <custom-attributes proprieta="nome"/>
                                    </checkbox>
                                </hlayout>
                            </cell>
                            <cell colspan="2"/>
                        </row>
                        <row>
                            <cell align="right">
                                <hlayout>
                                    <hbox visible="@load(vm.isDisponente)">
                                        <h:span class="mandatoryLabel" style="top:0.15em;right:0px;">*</h:span>
                                    </hbox>
                                    <label value="@load(vm.etichette['Sesso'])"/>
                                </hlayout>
                            </cell>
                            <cell>
                                <combobox model="@load(vm.listaSesso)" readonly="true" hflex="1"
                                          selectedItem="@bind(vm.dettaglio.sesso) @converter('it.finmatica.zk.utils.PropertyConverter', property='id')">
                                    <template name="model">
                                        <comboitem label="@load(vm.getEtichettaEnum(each))" value="@load(each)"/>
                                    </template>
                                </combobox>
                            </cell>
                            <cell align="right">
                                <hlayout>
                                    <hbox visible="@load(vm.isDisponente)">
                                        <h:span class="mandatoryLabel" style="top:0.15em;right:0px;">*</h:span>
                                    </hbox>
                                    <label value="@load(vm.etichette['Data_Nascita'])"/>
                                </hlayout>
                            </cell>
                            <cell colspan="2">
                                <hlayout valign="middle">
                                    <datebox format="dd/MM/yyyy" value="@bind(vm.dettaglio.dataNascita)" width="100px"
                                             onChange="@command('onAggiornaCaseAndAna', campoAnagrafe='DATA_NASCITA_SOGGETTO')"/>
                                    <button image="/images/icon/action/16x16/cancel.png"
                                            tooltiptext="@load(vm.etichette['Cancella'])"
                                            onClick="@command('onCancellaCampoDAT', campoAnagrafe='DATA_NASCITA_SOGGETTO')">
                                        <custom-attributes proprieta="dataNascita"/>
                                    </button>
                                </hlayout>
                            </cell>
                            <cell align="right">
                                <hlayout>
                                    <hbox visible="@load(vm.isDisponente)">
                                        <h:span class="mandatoryLabel" style="top:0.15em;right:0px;">*</h:span>
                                    </hbox>
                                    <label value="@load(vm.etichette['Codice_Fiscale'])"/>
                                </hlayout>
                            </cell>
                            <cell colspan="3">
                                <hlayout valign="middle" hflex="1">
                                    <textbox value="@bind(vm.dettaglio.codiceFiscale)" hflex="1" style="text-transform:uppercase"/>
                                    <button image="/images/icon/action/16x16/calculator.png"
                                            tooltiptext="@load(vm.etichette['Calcolo_Codice_Fiscale'])" onClick="@command('onCalcolaCf')" />
                                    <button image="/images/icon/action/16x16/cancel.png"
                                            tooltiptext="@load(vm.etichette['Cancella'])" onClick="@command('onCancellaCampoDAT')">
                                        <custom-attributes proprieta="codiceFiscale"/>
                                    </button>
                                    <space/>
                                </hlayout>
                            </cell>
                        </row>
                        <row>
                            <cell align="right">
                                <hlayout>
                                    <hbox visible="@load(vm.isDisponente)">
                                        <h:span class="mandatoryLabel" style="top:0.15em;right:0px;">*</h:span>
                                    </hbox>
                                    <label value="@load(vm.etichette['Comune_Nascita'])"/>
                                </hlayout>
                            </cell>
                            <cell colspan="5">
                                <hlayout valign="middle" hflex="1">
                                    <bandboxComuni hflex="1"
                                                   value="@load(vm.dettaglio.comuneNascita.descrizione)"
                                                   onSelect="@command('onSelectComune', campoRiferimento='CN')"/>
                                    <button image="/images/icon/action/16x16/cancel.png"
                                            tooltiptext="@load(vm.etichette['Cancella'])"
                                            onClick="@command('onCancellaComune', campoRiferimento='CN')"/>
                                    <space/>
                                </hlayout>
                            </cell>
                            <cell>
                                <textbox value="@load(vm.dettaglio.comuneNascita.siglaProvincia)" hflex="1" readonly="true"/>
                            </cell>
                            <cell colspan="2"/>
                        </row>

                        <row>
                            <cell align="right">
                                <label value="@load(vm.etichette['Indirizzo'])"/>
                            </cell>
                            <cell colspan="8">
                                <hlayout valign="middle" hflex="1">
                                    <textbox value="@bind(vm.dettaglio.indirizzo)" hflex="1" rows="2"/>
                                    <button image="/images/icon/action/16x16/cancel.png"
                                            tooltiptext="@load(vm.etichette['Cancella'])" onClick="@command('onCancellaCampoDAT')">
                                        <custom-attributes proprieta="indirizzo"/>
                                    </button>
                                    <space/>
                                </hlayout>
                            </cell>
                        </row>

                        <row>
                            <cell align="right">
                                <label value="@load(vm.etichette['Comune_Residenza'])"/>
                            </cell>
                            <cell colspan="5">
                                <hlayout valign="middle" hflex="1">
                                    <bandboxComuni hflex="1"
                                                   value="@load(vm.dettaglio.comuneResidenza.descrizione)"
                                                   onSelect="@command('onSelectComune', campoRiferimento='CR')"/>
                                    <button image="/images/icon/action/16x16/cancel.png"
                                            tooltiptext="@load(vm.etichette['Cancella'])"
                                            onClick="@command('onCancellaComune', campoRiferimento='CR')"/>
                                    <space/>
                                </hlayout>
                            </cell>
                            <cell>
                                <textbox value="@load(vm.dettaglio.comuneResidenza.siglaProvincia)" hflex="1" readonly="true"/>
                            </cell>
                            <cell align="right">
                                <label value="@load(vm.etichette['CAP'])"/>
                            </cell>
                            <cell>
                                <intbox value="@bind(vm.dettaglio.cap)" cols="5"/>
                            </cell>
                        </row>

                        <row>
                            <cell align="right">
                                <label value="@load(vm.etichette['Numero_telefono'])"/>
                            </cell>
                            <cell colspan="2">
                                <hlayout valign="middle" hflex="1">
                                    <textbox value="@bind(vm.dettaglio.telefono)" hflex="1"/>
                                    <button image="/images/icon/action/16x16/cancel.png"
                                            tooltiptext="@load(vm.etichette['Cancella'])" onClick="@command('onCancellaCampoDAT')">
                                        <custom-attributes proprieta="telefono"/>
                                    </button>
                                    <space/>
                                </hlayout>
                            </cell>
                            <cell align="right">
                                <label value="@load(vm.etichette['Email'])"/>
                            </cell>
                            <cell colspan="5">
                                <hlayout valign="middle" hflex="1">
                                    <textbox type="email" value="@bind(vm.dettaglio.indirizzoMail)" hflex="1"/>
                                    <button image="/images/icon/action/16x16/cancel.png"
                                            tooltiptext="@load(vm.etichette['Cancella'])" onClick="@command('onCancellaCampoDAT')">
                                        <custom-attributes proprieta="indirizzoMail"/>
                                    </button>
                                    <space/>
                                </hlayout>
                            </cell>
                        </row>
                    </rows>
                </grid>
            </groupbox>

            <groupbox closable="false">
                <caption label="@load(vm.etichette['Documenti'])"/>
                <grid sclass="form">
                    <rows>
                        <row>
                            <cell width="160px"/>
                            <cell colspan="2"/>
                            <cell width="160px"/>
                            <cell colspan="6"/>
                        </row>
                        <row>
                            <cell colspan="9">
                                <grid hflex="1">
                                    <rows>
                                        <row>
                                            <cell align="right" width="150px">
                                                <label value="@load(vm.etichette['Documento_identita'])"/>
                                            </cell>
                                            <cell colspan="5">
                                                <hlayout valign="middle" hflex="1">
                                                    <bandboxTipoDocumentoAnagrafe hflex="1"
                                                                              value="@load(vm.dettaglio.tipoDocumento.descrizioneEstesa)"
                                                                              onSelect="@command('onSelectTipoDocumento')"/>
                                                    <button image="/images/icon/action/16x16/cancel.png"
                                                            tooltiptext="@load(vm.etichette['Cancella'])"
                                                            onClick="@command('onCancellaTipoDocumento')"/>
                                                    <space/>
                                                </hlayout>
                                            </cell>
                                            <cell align="right" width="55px">
                                                <label value="@load(vm.etichette['Numero'])"/>
                                            </cell>
                                            <cell colspan="3">
                                                <hlayout valign="middle" hflex="1">
                                                    <textbox value="@bind(vm.dettaglio.numeroDocumento)" hflex="1" style="text-transform:uppercase"/>
                                                    <button image="/images/icon/action/16x16/cancel.png"
                                                            tooltiptext="@load(vm.etichette['Cancella'])"
                                                            onClick="@command('onCancellaCampoDAT')">
                                                        <custom-attributes proprieta="numeroDocumento"/>
                                                    </button>
                                                </hlayout>
                                            </cell>
                                        </row>

                                        <row>
                                            <cell align="right">
                                                <label value="@load(vm.etichette['Data_Rilascio'])"/>
                                            </cell>
                                            <cell colspan="3">
                                                <hlayout valign="middle">
                                                    <datebox format="dd/MM/yyyy" value="@bind(vm.dettaglio.dataRilascioDocumento)" width="100px"/>
                                                    <button image="/images/icon/action/16x16/cancel.png"
                                                            tooltiptext="@load(vm.etichette['Cancella'])"
                                                            onClick="@command('onCancellaCampoDAT')">
                                                        <custom-attributes proprieta="dataRilascioDocumento"/>
                                                    </button>
                                                </hlayout>
                                            </cell>
                                            <cell align="right">
                                                <label value="@load(vm.etichette['Data_Scadenza'])"/>
                                            </cell>
                                            <cell colspan="5">
                                                <hlayout valign="middle">
                                                    <datebox format="dd/MM/yyyy" value="@bind(vm.dettaglio.dataScadenzaDocumento)" width="100px"/>
                                                    <button image="/images/icon/action/16x16/cancel.png"
                                                            tooltiptext="@load(vm.etichette['Cancella'])"
                                                            onClick="@command('onCancellaCampoDAT')">
                                                        <custom-attributes proprieta="dataScadenzaDocumento"/>
                                                    </button>
                                                </hlayout>
                                            </cell>
                                        </row>

                                        <row>
                                            <cell align="right">
                                                <label value="@load(vm.etichette['Ente_Rilascio'])"/>
                                            </cell>
                                            <cell colspan="3">
                                                <hlayout valign="middle" hflex="1">
                                                    <bandboxEnteAnagrafe hflex="1"
                                                                         value="@load(vm.dettaglio.ente.descrizioneEstesa)"
                                                                         onSelect="@command('onSelectEnte')"/>
                                                    <button image="/images/icon/action/16x16/cancel.png"
                                                            tooltiptext="@load(vm.etichette['Cancella'])"
                                                            onClick="@command('onCancellaEnte')"/>
                                                    <space/>
                                                </hlayout>
                                            </cell>
                                            <cell align="right">
                                                <label value="@load(vm.etichette['Comune'])"/>
                                            </cell>
                                            <cell colspan="4">
                                                <hlayout valign="middle" hflex="1">
                                                    <bandboxComuni hflex="1"
                                                                   value="@load(vm.dettaglio.comuneDocumento.descrizione)"
                                                                   onSelect="@command('onSelectComune', campoRiferimento='CD')"/>
                                                    <button image="/images/icon/action/16x16/cancel.png"
                                                            tooltiptext="@load(vm.etichette['Cancella'])"
                                                            onClick="@command('onCancellaComune', campoRiferimento='CD')"/>
                                                    <space/>
                                                </hlayout>
                                            </cell>
                                            <cell>
                                                <textbox value="@load(vm.dettaglio.comuneDocumento.siglaProvincia)" hflex="1" readonly="true"/>
                                            </cell>
                                        </row>
                                    </rows>
                                </grid>
                            </cell>
                            <cell width="42px">
                                <button image="/images/icon/action/16x16/grid.png"
                                        tooltiptext="@load(vm.etichette['Recupera_Documento_Anagrafe'])" onClick="@command('onRecuperaDocumentoIdentita')"/>
                            </cell>
                        </row>

                        <row>
                            <cell align="right">
                                <h:span class="mandatoryLabel">*</h:span><label value="@load(vm.etichette['Consenso_Trattamento_Dati'])"/>
                            </cell>
                            <cell colspan="2">
                                <hlayout height="20px">
                                    <radiogroup model="@load(vm.listaSN)" selectedItem="@bind(vm.dettaglio.consensoTrattamento)">
                                        <template name="model">
                                            <radio label="@load(each eq 'S'?vm.etichette['SI']:vm.etichette['NO'])"
                                                   value="@load(each)" style="padding-left:15px"/>
                                        </template>
                                    </radiogroup>
                                </hlayout>
                            </cell>
                            <cell align="right">
                                <zk if="${not vm.isDisponente}">
                                    <h:span class="mandatoryLabel">*</h:span><label value="@load(vm.etichette['Sottoscrizione_DAT'])" visible="@load(not vm.isDisponente)"/>
                                </zk>
                            </cell>
                            <cell colspan="6">
                                <zk if="${not vm.isDisponente}">
                                    <hlayout height="20px" visible="@load(not vm.isDisponente)">
                                        <radiogroup model="@load(vm.listaSN)" selectedItem="@bind(vm.dettaglio.sottoscrittoDAT)">
                                            <template name="model">
                                                <radio label="@load(each eq 'S'?vm.etichette['SI']:vm.etichette['NO'])"
                                                       value="@load(each)" style="padding-left:15px"/>
                                            </template>
                                        </radiogroup>
                                    </hlayout>
                                </zk>
                            </cell>
                        </row>
                    </rows>
                </grid>
            </groupbox>

    </window>

</zk>