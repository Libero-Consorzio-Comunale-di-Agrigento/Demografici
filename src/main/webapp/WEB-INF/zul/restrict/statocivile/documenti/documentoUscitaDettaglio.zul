<?xml version="1.0" encoding="UTF-8"?>
<?taglib uri="http://www.zkoss.org/dsp/web/core" prefix="c"?>

<zk xmlns="http://www.zkoss.org/2005/zul"
	xmlns:h="http://www.w3.org/1999/xhtml"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul http://www.zkoss.org/2005/zul/zul.xsd">

	<window viewModel="@id('vm') @init('restrict.statocivile.documenti.DocumentoUscitaDettaglioViewModel')"
			apply="org.zkoss.bind.BindComposer"
			border="none"
			width="100%" height="100%"
			sizable="false" closable="false">

			<hlayout valign="middle">
				<controlBarDettaglio/>
				<label value="@load(vm.formLabel)" sclass="formTitle"/>

				<!--<estremiAttoFormLabel/>-->
			</hlayout>

			<vlayout vflex="1" width="100%" sclass="scroll">

				<groupbox mold="3d" closable="false">
					<caption label="@load(vm.etichette['SEZIONE_ESTREMI_ATTO'])"/>
					<grid sclass="form">
						<rows>
							<row>
								<cell>
									<hlayout spacing="40px">

										<hlayout valign="middle" spacing="8px">
											<label value="@load(vm.etichette['Ufficio'])"/>
											<label value="@load(vm.atto.ufficio)" sclass="grassetto"/>
										</hlayout>

										<hlayout valign="middle" spacing="8px">
											<label value="@load(vm.etichette['Anno'])"/>
											<label value="@load(vm.atto.anno)" sclass="grassetto"/>
										</hlayout>

										<hlayout valign="middle" spacing="8px">
											<label value="@load(vm.etichette['Numero_Atto'])"/>
											<label value="@load(vm.atto.atto)" sclass="grassetto" visible="@load(vm.atto.atto gt 0)" />
											<label value="@load(vm.etichette['Provvisorio'])" sclass="grassetto" visible="@load(vm.atto.atto le 0)"/>
										</hlayout>

										<hlayout valign="middle" spacing="8px">
											<label value="@load(vm.etichette['Parte'])"/>
											<label value="@load(vm.atto.parte)" sclass="grassetto"/>
										</hlayout>

										<hlayout valign="middle" spacing="8px">
											<label value="@load(vm.etichette['Serie'])" visible="@load(not empty vm.atto.serie)"/>
											<label value="@load(vm.atto.serie)" visible="@load(not empty vm.atto.serie)" sclass="grassetto"/>
										</hlayout>

									</hlayout>
								</cell>
							</row>
							<row>
								<cell>
									<label value="@load(vm.atto.getNominativo())" sclass="grassetto"/>
								</cell>
							</row>
							<row>
								<cell>
									<label value="@load(vm.etichette['Data_Nascita'])"/>
									<label value=" : "/>
									<label value="@load(empty vm.atto.dataNascita? null:(c:formatDate(vm.atto.dataNascita, 'dd/MM/yyyy')))" sclass="grassetto"/>
									<label value=" - "/>
									<label value="@load(vm.etichette['Data_Decesso'])"/>
									<label value=" : "/>
									<label value="@load(empty vm.atto.dataMorte? null:(c:formatDate(vm.atto.dataMorte, 'dd/MM/yyyy')))" sclass="grassetto"/>
								</cell>
							</row>
						</rows>
					</grid>
				</groupbox>

				<templateSezioneEstremiTrasporto/>

				<templateSezioneEstremiCremazione/>

				<templateIdDomain/>

			</vlayout>

	</window>

</zk>