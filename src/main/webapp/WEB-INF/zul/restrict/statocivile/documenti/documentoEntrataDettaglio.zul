<?xml version="1.0" encoding="UTF-8"?>
<?taglib uri="http://www.zkoss.org/dsp/web/core" prefix="c"?>

<zk xmlns="http://www.zkoss.org/2005/zul"
	xmlns:h="http://www.w3.org/1999/xhtml"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul http://www.zkoss.org/2005/zul/zul.xsd">

	<window viewModel="@id('vm') @init('restrict.statocivile.documenti.DocumentoEntrataDettaglioViewModel')"
			apply="org.zkoss.bind.BindComposer"
			border="none"
			width="100%" height="100%"
			sizable="false" closable="false">

			<hlayout valign="middle">
				<controlBarDettaglio/>
				<label value="@load(vm.formLabel)" sclass="formTitle"/>
			</hlayout>

			<vlayout vflex="1" width="100%" sclass="scroll">

				<groupbox mold="3d" hflex="1">
					<grid sclass="form">
						<rows>
							<row>
								<cell align="right" width="160px">
									<label value="@load(vm.etichette['Numero_Protocollo_Anno'])"/>
								</cell>
								<cell colspan="3" width="460px">
									<hlayout valign="middle">
										<intbox value="@bind(vm.dettaglio.protocollo.numero)" width="100px"/>
										<label value="/"/>
										<intbox value="@bind(vm.dettaglio.protocollo.anno)"  width="80px"/>
										<button image="/images/icon/action/16x16/calculator.png"
												tooltiptext="@load(vm.etichette['Numera'])"
												disabled="@load( not empty vm.dettaglio.protocollo.numero )"
												onClick="@command('onNumeraProtocolloDAT')" />
										<button image="/images/icon/action/16x16/cancel.png"
												tooltiptext="@load(vm.etichette['Cancella'])" onClick="@command('onCancellaCampoDAT')">
											<custom-attributes proprieta="protocollo.numero,protocollo.anno"/>
										</button>
									</hlayout>
								</cell>
								<cell align="right" width="100px">
									<label value="@load(vm.etichette['Data'])"/>
								</cell>
								<cell colspan="4">
									<hlayout valign="middle">
										<datebox format="dd/MM/yyyy" value="@bind(vm.dettaglio.protocollo.data)" width="100px"/>
										<button image="/images/icon/action/16x16/cancel.png"
												tooltiptext="@load(vm.etichette['Cancella'])"
												onClick="@command('onCancellaCampoDAT')">
											<custom-attributes proprieta="protocollo.data"/>
										</button>
									</hlayout>
								</cell>
							</row>

							<row>
								<cell align="right">
									<label value="@load(vm.etichette['Data_Consegna'])"/>
								</cell>
								<cell>
									<hlayout valign="middle">
										<datebox format="dd/MM/yyyy" value="@bind(vm.dettaglio.dataPresentazione)" width="100px"/>
										<button image="/images/icon/action/16x16/cancel.png"
												tooltiptext="@load(vm.etichette['Cancella'])"
												onClick="@command('onCancellaCampoDAT')">
											<custom-attributes proprieta="dataPresentazione"/>
										</button>
									</hlayout>
								</cell>
								<cell align="right">
									<label value="@load(vm.etichette['Data_Modifica'])"/>
								</cell>
								<cell>
									<hlayout valign="middle">
										<datebox format="dd/MM/yyyy" value="@bind(vm.dettaglio.dataModifica)" width="100px"/>
										<button image="/images/icon/action/16x16/cancel.png"
												tooltiptext="@load(vm.etichette['Cancella'])"
												onClick="@command('onCancellaCampoDAT')">
											<custom-attributes proprieta="dataModifica"/>
										</button>
									</hlayout>
								</cell>
								<cell align="right">
									<label value="@load(vm.etichette['Data_Revoca'])"/>
								</cell>
								<cell colspan="4">
									<hlayout valign="middle">
										<datebox format="dd/MM/yyyy" value="@bind(vm.dettaglio.dataRevoca)" width="100px"/>
										<button image="/images/icon/action/16x16/cancel.png"
												tooltiptext="@load(vm.etichette['Cancella'])"
												onClick="@command('onCancellaCampoDAT')">
											<custom-attributes proprieta="dataRevoca"/>
										</button>
									</hlayout>
								</cell>
							</row>

							<row>
								<cell align="right">
									<h:span class="mandatoryLabel">*</h:span><label value="@load(vm.etichette['Tipo_Atto'])"/>
								</cell>
								<cell colspan="3">
									<combobox model="@load(vm.listaTipiAttoDAT)" readonly="true" hflex="1" onChange="@command('onSelectTipoAttoDAT')"
											  selectedItem="@bind(vm.dettaglio.tipoAttoDAT)  @converter('it.finmatica.zk.utils.PropertyConverter', property='id')">
										<template name="model">
											<comboitem label="@load(c:cat3(each.id, ' - ' , each.descrizione) )" value="@load(each)"/>
										</template>
									</combobox>
								</cell>
								<cell align="right">
									<hlayout>
										<hbox visible="@load(vm.dettaglio.tipoAttoDAT.id eq 99)">
											<h:span class="mandatoryLabel" style="top:0.15em;right:0px;">*</h:span>
										</hbox>
										<label value="@load(vm.etichette['Note'])"/>
									</hlayout>
								</cell>
								<cell colspan="4">
									<hlayout valign="middle">
										<textbox value="@bind(vm.dettaglio.noteTipoAtto)" hflex="1" rows="2"/>
										<button image="/images/icon/action/16x16/cancel.png"
												tooltiptext="@load(vm.etichette['Cancella'])"
												onClick="@command('onCancellaCampoDAT')">
											<custom-attributes proprieta="noteTipoAtto"/>
										</button>
									</hlayout>
								</cell>
							</row>

							<row>
								<cell align="right">
									<label value="@load(vm.etichette['Consenso_Notifica_Mail'])"/>
								</cell>
								<cell colspan="1">
									<hlayout height="20px">
										<radiogroup model="@load(vm.listaSN)" selectedItem="@bind(vm.dettaglio.consensoNotificaMail)">
											<template name="model">
												<radio label="@load(each eq 'S'?vm.etichette['SI']:vm.etichette['NO'])"
													   value="@load(each)" style="padding-left:15px"/>
											</template>
										</radiogroup>
									</hlayout>
								</cell>
								<cell align="right">
									<h:span class="mandatoryLabel">*</h:span><label value="@load(vm.etichette['Consenso_Invio_DAT'])"/>
								</cell>
								<cell>
									<hlayout height="20px">
										<radiogroup model="@load(vm.listaSN)" selectedItem="@bind(vm.dettaglio.consensoInvioDAT)">
											<template name="model">
												<radio label="@load(each eq 'S'?vm.etichette['SI']:vm.etichette['NO'])"
													   value="@load(each)" style="padding-left:15px"/>
											</template>
										</radiogroup>
									</hlayout>
								</cell>
								<cell align="right">
									<label value="@load(vm.etichette['Reperibilta_DAT'])"/>
								</cell>
								<cell colspan="4">
									<hlayout valign="middle">
										<textbox value="@bind(vm.dettaglio.reperibilitaDAT)" hflex="1" rows="3"/>
										<button image="/images/icon/action/16x16/cancel.png"
												tooltiptext="@load(vm.etichette['Cancella'])"
												onClick="@command('onCancellaCampoDAT')">
											<custom-attributes proprieta="reperibilitaDAT"/>
										</button>
									</hlayout>
								</cell>
							</row>

						</rows>
					</grid>
				</groupbox>

				<groupbox mold="3d" hflex="1">
					<caption sclass="mainCaption">
						<div>
							<updownbutton onClick="@command(self.openClose())" sclass="captionButton"/>
							<label value="@load(vm.etichette['SEZIONE_DISPONENTE'])" sclass="captionLabel"/>
						</div>
					</caption>
					<include height="470px" opener="@load(vm.self)" tipoSoggettoDAT="disponente" isDisponente="true" src="@load(vm.urlTemplateSoggettoDAT)"/>
				</groupbox>

				<groupbox mold="3d" hflex="1">
					<caption sclass="mainCaption">
						<div>
							<updownbutton onClick="@command(self.openClose())" onCreate="@command(self.openClose())" sclass="captionButton"/>
							<label value="@load(vm.etichette['SEZIONE_FIDUCIARIO_1'])" sclass="captionLabel"/>
						</div>
					</caption>
					<include height="470px" opener="@load(vm.self)" tipoSoggettoDAT="fiduciario1" src="@load(vm.urlTemplateSoggettoDAT)"/>
				</groupbox>

				<groupbox mold="3d" hflex="1">
					<caption sclass="mainCaption">
						<div>
							<updownbutton onClick="@command(self.openClose())" onCreate="@command(self.openClose())" sclass="captionButton"/>
							<label value="@load(vm.etichette['SEZIONE_FIDUCIARIO_2'])" sclass="captionLabel"/>
						</div>
					</caption>
					<include height="470px" opener="@load(vm.self)" tipoSoggettoDAT="fiduciario2" src="@load(vm.urlTemplateSoggettoDAT)"/>
				</groupbox>

				<groupbox mold="3d" hflex="1">
					<caption sclass="mainCaption">
						<div>
							<updownbutton onClick="@command(self.openClose())" onCreate="@command(self.openClose())" sclass="captionButton"/>
							<label value="@load(vm.etichette['SEZIONE_NOTAIO'])" sclass="captionLabel"/>
						</div>
					</caption>

					<groupbox closable="false">
						<grid sclass="form">
							<rows>
								<row>
									<cell align="right" width="160px">
										<label value="@load(vm.etichette['Notaio'])"/>
									</cell>
									<cell colspan="7">
										<hlayout valign="middle" hflex="1">
											<textbox value="@bind(vm.dettaglio.notaio)" hflex="1"
													 onChange="@command('onAggiornaCase')"
													 style="@load(vm.minuscole.notaio?'text-transform:none':'text-transform:uppercase')">
												<custom-attributes proprieta="notaio"/>
											</textbox>
											<button image="/images/icon/action/16x16/cancel.png"
													tooltiptext="@load(vm.etichette['Cancella'])"
													onClick="@command('onCancellaCampoDAT')">
												<custom-attributes proprieta="notaio"/>
											</button>
											<space/>
										</hlayout>
									</cell>
									<cell align="right" width="85px">
										<hlayout valign="middle">
											<label value="@load(vm.etichette['Minuscole'])"/>
											<checkbox checked="@bind(vm.minuscole.notaio)" onCheck="@command('onAggiornaCase')">
												<custom-attributes proprieta="notaio"/>
											</checkbox>
										</hlayout>
									</cell>
								</row>

								<row>
									<cell align="right">
										<label value="@load(vm.etichette['Indirizzo'])"/>
									</cell>
									<cell colspan="8">
										<hlayout valign="middle" hflex="1">
											<textbox value="@bind(vm.dettaglio.indirizzoNotaio)" hflex="1"/>
											<button image="/images/icon/action/16x16/cancel.png"
													tooltiptext="@load(vm.etichette['Cancella'])"
													onClick="@command('onCancellaCampoDAT')">
												<custom-attributes proprieta="indirizzoNotaio"/>
											</button>
											<space/>
										</hlayout>
									</cell>
								</row>

								<row>
									<cell align="right">
										<label value="@load(vm.etichette['Comune'])"/>
									</cell>
									<cell colspan="7">
										<hlayout valign="middle" hflex="1">
											<bandboxComuni hflex="1"
														   value="@load(vm.dettaglio.comuneNotaio.descrizione)"
														   onSelect="@command('onSelectComune', campoRiferimento='CC_NOTAIO')"/>
											<button image="/images/icon/action/16x16/cancel.png"
													tooltiptext="@load(vm.etichette['Cancella'])"
													onClick="@command('onCancellaComune', campoRiferimento='CC_NOTAIO')"/>
											<space/>
										</hlayout>
									</cell>
									<cell>
										<textbox value="@load(vm.dettaglio.comuneNotaio.siglaProvincia)" hflex="1" readonly="true"/>
									</cell>
								</row>

								<row>
									<cell align="right">
										<label value="@load(vm.etichette['Collegio_Notarile'])"/>
									</cell>
									<cell colspan="7">
										<hlayout valign="middle" hflex="1">
											<bandboxComuni hflex="1"
														   value="@load(vm.dettaglio.comuneCollegioNotarile.descrizione)"
														   onSelect="@command('onSelectComune', campoRiferimento='CC_COLLEGIO')"/>
											<button image="/images/icon/action/16x16/cancel.png"
													tooltiptext="@load(vm.etichette['Cancella'])"
													onClick="@command('onCancellaComune', campoRiferimento='CC_COLLEGIO')"/>
											<space/>
										</hlayout>
									</cell>
									<cell>
										<textbox value="@load(vm.dettaglio.comuneCollegioNotarile.siglaProvincia)" hflex="1" readonly="true"/>
									</cell>
								</row>

								<row>
									<cell align="right">
										<label value="@load(vm.etichette['Note'])"/>
									</cell>
									<cell colspan="8">
										<hlayout valign="middle">
											<textbox value="@bind(vm.dettaglio.note)" hflex="1" rows="3"/>
											<button image="/images/icon/action/16x16/cancel.png"
													tooltiptext="@load(vm.etichette['Cancella'])"
													onClick="@command('onCancellaCampoDAT')">
												<custom-attributes proprieta="note"/>
											</button>
											<space/>
										</hlayout>
									</cell>
								</row>

							</rows>
						</grid>
					</groupbox>
				</groupbox>

				<templateIdDomain/>

			</vlayout>

	</window>

</zk>