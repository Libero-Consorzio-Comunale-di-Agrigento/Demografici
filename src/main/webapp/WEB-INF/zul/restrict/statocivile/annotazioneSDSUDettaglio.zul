<?xml version="1.0" encoding="UTF-8"?>
<?taglib uri="http://www.zkoss.org/dsp/web/core" prefix="c"?>

<zk xmlns="http://www.zkoss.org/2005/zul"
	xmlns:h="http://www.w3.org/1999/xhtml"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xmlns:w="http://www.zkoss.org/2005/zk/client"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul http://www.zkoss.org/2005/zul/zul.xsd">

	<window viewModel="@id('vm') @init('restrict.statocivile.AnnotazioneSDSUDettaglioViewModel')"
			apply="org.zkoss.bind.BindComposer"
			border="none"
			width="100%" height="100%"
			sizable="false" closable="false">

		<hlayout valign="middle">
			<controlBarDettaglio/>

			<label value="@load(vm.formLabel)" sclass="formTitle"/>

			<estremiAttoFormLabel/>

		</hlayout>

		<vlayout vflex="1" width="100%" sclass="scroll">

			<groupbox closable="false" open="true">
				<grid sclass="form">
					<rows>
						<row>
							<cell align="right" width="165px">
								<label value="@load(vm.etichette['Completo'])"/>
							</cell>
							<cell colspan="7">
								<checkbox checked="@bind(vm.dettaglio.flagCompleto)"/>
							</cell>
						</row>
					</rows>
				</grid>
			</groupbox>

			<groupbox mold="3d" closable="false" open="true">
				<caption label="@load(vm.etichette['SEZIONE_DATI_PROCEDURA'])"/>
				<grid sclass="form">
					<rows>
						<row>
							<cell align="right" width="165px">
								<h:span class="mandatoryLabel" >*</h:span><label value="@load(vm.etichette['Tipo_procedura'])"/>
							</cell>
							<cell colspan="3">
								<radiogroup model="@load(vm.listaTipoProcedura)" hflex="1" orient="vertical"
											selectedItem="@bind(vm.dettaglio.tipoProcedura) @converter('it.finmatica.zk.utils.PropertyConverter', property='codice')">
									<template name="model">
										<radio label="@load(c:cat3(each.codice, ' - ', each.descrizione))" value="@load(each.codice)" style="padding-left:15px;font-weight: bold"/>
									</template>
								</radiogroup>
							</cell>
							<cell width="150px"/>
							<cell colspan="3"/>
						</row>
						<row>
							<cell align="right">
								<h:span class="mandatoryLabel" >*</h:span><label value="@load(vm.etichette['Comune_provvedimento_trib_cda'])"/>
							</cell>
							<cell colspan="3">
								<hlayout valign="middle" hflex="1">
									<label value="@load(vm.dettaglio.comuneTribCda.descrizione)" sclass="grassetto"/>
                                	<label value="@load(c:cat3(' (', vm.dettaglio.comuneTribCda.siglaProvincia, ')'))" sclass="grassetto"/>
                            	</hlayout>
							</cell>
							<cell align="right">
								<label value="@load(vm.etichette['Data_iscrizione_procedimento'])"/>
							</cell>
							<cell colspan="3">
								<hlayout>
									<datebox format="dd/MM/yyyy" value="@bind(vm.dettaglio.dataIscrizioneRuoloProcedimento)" width="100px"/>
									<button image="/images/icon/action/16x16/cancel.png"
											tooltiptext="@load(vm.etichette['Cancella'])" onClick="@command('onCancellaCampoIstat')">
										<custom-attributes proprieta="dataIscrizioneRuoloProcedimento"/>
									</button>
								</hlayout>
							</cell>
						</row>
						<row>
							<cell align="right">
                                <h:span class="mandatoryLabel" >*</h:span><label value="@load(vm.etichette['Data_provvedimento'])"/>
							</cell>
							<cell colspan="3">
								<!--<hlayout>
									<datebox format="dd/MM/yyyy" value="@bind(vm.dettaglio.dataProvvedimento)" width="100px"/>
									<button image="/images/icon/action/16x16/cancel.png"
											tooltiptext="@load(vm.etichette['Cancella'])" onClick="@command('onCancellaCampoIstat')">
										<custom-attributes proprieta="dataProvvedimento"/>
									</button>
								</hlayout>-->
								<label value="@load(empty vm.dettaglio.dataProvvedimento? null:(c:formatDate(vm.dettaglio.dataProvvedimento, 'dd/MM/yyyy')))" sclass="grassetto"/>
							</cell>
							<cell align="right">
								<label value="@load(vm.etichette['Data_trascrizione_provvedimento'])"/>
							</cell>
							<cell colspan="3">
								<!--<hlayout>
									<datebox format="dd/MM/yyyy" value="@bind(vm.dettaglio.dataTrascrizioneProvvedimento)" width="100px"/>
									<button image="/images/icon/action/16x16/cancel.png"
											tooltiptext="@load(vm.etichette['Cancella'])" onClick="@command('onCancellaCampoIstat')">
										<custom-attributes proprieta="dataTrascrizioneProvvedimento"/>
									</button>
								</hlayout>-->
								<label value="@load(empty vm.dettaglio.dataTrascrizioneProvvedimento? null:(c:formatDate(vm.dettaglio.dataTrascrizioneProvvedimento, 'dd/MM/yyyy')))" sclass="grassetto"/>
							</cell>
						</row>
						<row>
							<cell>
								<h:span class="mandatoryLabel" >*</h:span><label value="@load(vm.etichette['Tipo_provvedimento_trib_cda'])"/>
							</cell>
							<cell colspan="3">
								<radiogroup model="@load(vm.listaTipoProvvedimento)" hflex="1" orient="vertical"
											selectedItem="@bind(vm.dettaglio.tipoProvvedimentoTribCda) @converter('it.finmatica.zk.utils.PropertyConverter', property='codice')">
									<template name="model">
										<radio label="@load(c:cat3(each.codice, ' - ', each.descrizione))" value="@load(each.codice)" style="padding-left:15px;font-weight: bold"/>
									</template>
								</radiogroup>
							</cell>
							<cell colspan="4"/>
						</row>
						<zk if="${vm.tipoAttoEnum.isMatrimonio()}">
							<row>
								<cell align="right">
									<hlayout>
										<hbox visible="@load(vm.dettaglio.tipoProvvedimentoTribCda eq 3 or vm.dettaglio.tipoProvvedimentoTribCda eq 4)">
											<h:span class="mandatoryLabel" style="top:0.15em;right:0px;">*</h:span>
										</hbox>
										<label value="@load(vm.etichette['Causa_divorzio'])"/>
									</hlayout>
								</cell>
								<cell colspan="7">
									<vlayout>
										<radiogroup model="@load(vm.listaCauseScioglimento)" orient="vertical"
													selectedItem="@bind(vm.dettaglio.causaScioglimento) @converter('it.finmatica.zk.utils.PropertyConverter', property='codice')">
											<template name="model">
												<radio label="@load(c:cat3(each.codice, ' - ', each.descrizione))" value="@load(each.codice)" style="padding-left:15px;font-weight: bold"
													   disabled="@load( not (vm.dettaglio.tipoProvvedimentoTribCda eq 3 or vm.dettaglio.tipoProvvedimentoTribCda eq 4) )"/>
											</template>
										</radiogroup>
									</vlayout>
								</cell>
							</row>
							<row>
								<cell align="right">
									<label value="@load(vm.etichette['Data_Separazione'])"/>
								</cell>
								<cell colspan="7">
									<hlayout>
										<datebox format="dd/MM/yyyy" value="@bind(vm.dettaglio.dataSentenzaSeparazione)" width="100px"
												 disabled="@load(empty vm.dettaglio.causaScioglimento or vm.dettaglio.causaScioglimento eq 5)"/>
										<button image="/images/icon/action/16x16/cancel.png"
												disabled="@load(empty vm.dettaglio.causaScioglimento or vm.dettaglio.causaScioglimento eq 5)"
												tooltiptext="@load(vm.etichette['Cancella'])" onClick="@command('onCancellaCampoIstat')">
											<custom-attributes proprieta="dataSentenzaSeparazione"/>
										</button>
									</hlayout>
								</cell>
							</row>
						</zk>
					</rows>
				</grid>
			</groupbox>

			<groupbox mold="3d" closable="false" open="true">
				<caption label="@load(vm.etichetteCustom['SEZIONE_MATUCI'])"/>
				<grid sclass="form">
					<rows>
						<templateRowDatiMatUciModelloSDSU/>
					</rows>
				</grid>
			</groupbox>

            <groupbox mold="3d" closable="false" open="true">
                <caption label="@load(vm.etichetteCustom['SEZIONE_SOGGETTO1'])"/>
                <grid sclass="form">
                    <rows>
                        <templateRowIntestatario1ModelloSDSU/>
                    </rows>
                </grid>
            </groupbox>

			<groupbox mold="3d" closable="false" open="true">
				<caption label="@load(vm.etichetteCustom['SEZIONE_SOGGETTO2'])"/>
				<grid sclass="form">
					<rows>
						<templateRowIntestatario2ModelloSDSU/>
					</rows>
				</grid>
			</groupbox>

			<templateIdDomain/>

		</vlayout>

	</window>

</zk>