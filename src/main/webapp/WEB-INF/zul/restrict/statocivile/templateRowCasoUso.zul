<?xml version="1.0" encoding="UTF-8"?>
<?taglib uri="http://www.zkoss.org/dsp/web/core" prefix="c"?>

<zk xmlns="http://www.zkoss.org/2005/zul"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.zkoss.org/2005/zul http://www.zkoss.org/2005/zul/zul.xsd">

    <groupbox mold="3d" closable="false" open="true">
        <caption label="DATI ANSC"/>
        <grid sclass="form">
            <rows>
                <row>
                    <cell align="right" width="120px">
                        <label value="@load(vm.etichette['Caso_Uso_Ansc'])"/>
                    </cell>
                    <cell>
                        <label value="@load(vm.casoUso.descrizioneEstesa)" sclass="grassetto" multiline="true"/>
                    </cell>
                    <cell width="40px">
                        <button image="/images/icon/action/16x16/search.png" visible="@load(vm.casiUsoEnabled)" disabled="@load(not vm.casiUsoEnabled)"
                                tooltiptext="@load(vm.etichette['Seleziona'])" onClick="@command('onCaricaCasiUso')"/>
                    </cell>
                    <cell align="right" width="150px">
                        <label value="@load(vm.etichette['Numero_comunale'])"/>
                    </cell>
                    <cell width="50px">
                        <label value="@load(vm.atto.numeroUnico)" sclass="grassetto"/>
                    </cell>
                    <cell align="right" width="120px">
                        <label visible="@load(not empty vm.atto.idAttoAnsc)"
                               value="@load(vm.etichette['Id_Atto_Ansc'])"/>
                    </cell>
                    <cell width="180px">
                        <label visible="@load(not empty vm.atto.idAttoAnsc)" value="@load(vm.atto.idAttoAnsc)" sclass="grassetto"/>
                    </cell>
                </row>
                <row visible="${arg.showMotivoRecupero eq true ? 'true' : 'false'}">
                    <cell align="right">
                        <label value="@load(vm.etichette['Motivo_recupero'])"/>
                    </cell>
                    <cell colspan="4">
                        <hlayout height="25px">
                            <radiogroup model="@load(vm.listaSiNo)"
                                        selectedItem="@bind(vm.atto.motivoRecuperoAnscValorizzato) @converter('it.finmatica.zk.utils.PropertyConverter', property='id')">
                                <template name="model">
                                    <radio label="@load(vm.getEtichettaEnum(each))" value="@load(each)" style="padding-left:10px"
                                           disabled="@load(vm.atto.flagFirmatoUscAnsc)"/>
                                </template>
                            </radiogroup>

                            <space/>

                            <combobox model="@load(vm.listaMotivoRecupero)" readonly="true" width="280px"
                                      visible="@load(vm.atto.motivoRecuperoAnscValorizzato eq 'SI')"
                                      disabled="@load(vm.atto.flagFirmatoUscAnsc)"
                                      selectedItem="@bind(vm.atto.motivoRecuperoAnsc) @converter('it.finmatica.zk.utils.PropertyConverter', property='id')">
                                <template name="model">
                                    <comboitem label="@load(empty each?'- -':vm.getEtichettaEnum(each))" value="@load(each)"/>
                                </template>
                            </combobox>
                        </hlayout>
                    </cell>
                    <cell align="right">
                        <label value="@load(vm.etichette['Forza_Id_Atto_Ansc'])"
                               visible="@load(empty vm.atto.idAttoAnsc)"/>
                    </cell>
                    <cell>
                        <hlayout height="25px" visible="@load(empty vm.atto.idAttoAnsc)">
                            <radiogroup model="@load(vm.listaSiNo)"
                                        selectedItem="@bind(vm.selectedForzaIdAttoAnsc)"
                                        onCheck="@command('onForzaIdAttoAnsc')">
                                <template name="model">
                                    <radio label="@load(vm.getEtichettaEnum(each))" value="@load(each)"
                                           style="padding-left:10px"/>
                                </template>
                            </radiogroup>
                        </hlayout>
                    </cell>
                </row>
            </rows>
        </grid>
    </groupbox>

</zk>