<?xml version="1.0" encoding="UTF-8"?>
<?taglib uri="http://www.zkoss.org/dsp/web/core" prefix="c"?>

<zk xmlns="http://www.zkoss.org/2005/zul"
    xmlns:h="http://www.w3.org/1999/xhtml"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.zkoss.org/2005/zul http://www.zkoss.org/2005/zul/zul.xsd">

    <groupbox closable="false"
              style="@load(vm.dettaglio.isAdozioneAutoritaMittenteVisible() ? 'display: block': 'display: none')">
        <caption label="@load(vm.etichette['Autorita_mittente'])"/>
        <grid sclass="form" visible="@load(vm.dettaglio.isAdozioneAutoritaMittenteVisible())">
            <rows>
                <row>
                    <cell align="right" width="160px">
                        <h:span class="mandatoryLabel">*</h:span>
                        <label value="@load(vm.etichette['Da'])"/>
                    </cell>
                    <cell colspan="2">
                        <hlayout valign="middle" hflex="1">
                            <bandboxAutorita hflex="1"
                                             showLuogo="false"
                                             value="@bind(vm.datiProvenienza.autorita)"
                                             tipoAtto="@load(vm.dettaglio.tipoAtto)"
                                             parte="@load(vm.dettaglio.parte)"
                                             serie="@load(vm.dettaglio.serie)"
                                             categoria="@load(vm.dettaglio.tipoAttoDomain.categoriaDomain.codice)"
                                             onSelect="@command('onSelectAutorita')"/>
                            <button image="/images/icon/action/16x16/cancel.png"
                                    tooltiptext="@load(vm.etichette['Cancella'])"
                                    onClick="@command('onCancellaCampoProvenienza')">
                                <custom-attributes proprieta="autorita"/>
                            </button>
                        </hlayout>
                    </cell>
                    <cell/>
                </row>
                <row>
                    <cell align="right">
                        <zk if="${vm.anscOn}">
                            <h:span class="mandatoryLabel">*</h:span>
                        </zk>
                        <label value="@load(vm.etichette['Comune'])"/>
                    </cell>
                    <cell colspan="2">
                        <hlayout valign="middle" hflex="1">
                            <bandboxComuni hflex="1"
                                           value="@load(vm.datiProvenienza.comuneProvenienza.descrizione)"
                                           dataRiferimento="@load(vm.datiProvenienza.dataNotaRif)"
                                           onSelect="@command('onSelectComune', campoRiferimento='CA_PROV')"/>
                            <button image="/images/icon/action/16x16/cancel.png"
                                    tooltiptext="@load(vm.etichette['Cancella'])"
                                    onClick="@command('onCancellaComune', campoRiferimento='CA_PROV')"
                            />
                        </hlayout>
                    </cell>
                    <cell>
                        <textbox value="@load(vm.datiProvenienza.comuneProvenienza.siglaProvincia)" width="60px"
                                 readonly="true"/>
                    </cell>
                </row>
                <row visible="@load(vm.dettaglio.motivoNascita.flagAutoritaEstremi)">
                    <cell align="right">
                        <customLabel mandatory="true" value="@load(vm.etichette['Nota_Rif_Anno'])"/>
                    </cell>
                    <cell valign="middle" colspan="3">
                        <textbox value="@bind(vm.datiProvenienza.notaRif)"/>
                        <label value="/"/>
                        <textbox value="@bind(vm.datiProvenienza.annoNotaRif)"/>
                        <button image="/images/icon/action/16x16/cancel.png"
                                tooltiptext="@load(vm.etichette['Cancella'])"
                                onClick="@command('onCancellaCampoProvenienza')">
                            <custom-attributes proprieta="notaRif,annoNotaRif"/>
                        </button>
                    </cell>
                </row>
                <row visible="@load(vm.dettaglio.motivoNascita.flagAutoritaEstremi)">
                    <cell align="right">
                        <customLabel mandatory="true"
                                     value="@load(vm.etichette['In_data'])"/>
                    </cell>
                    <cell colspan="3">
                        <hlayout valign="middle" hflex="1">
                            <datebox value="@bind(vm.datiProvenienza.dataNotaRif)"
                                     width="100px"
                                     format="dd/MM/yyyy"/>
                            <button image="/images/icon/action/16x16/cancel.png"
                                    tooltiptext="@load(vm.etichette['Cancella'])"
                                    onClick="@command('onCancellaCampoProvenienza')">
                                <custom-attributes proprieta="dataNotaRif"/>
                            </button>
                        </hlayout>
                    </cell>
                </row>
            </rows>
        </grid>
    </groupbox>
    <groupbox closable="false">
        <caption label="@load(vm.etichette['Atto_da_trascrivere_sentenza_tribunale'])"/>
        <grid sclass="form">
            <rows>
                <row>
                    <cell align="right" width="180px">
                        <h:span class="mandatoryLabel">*</h:span>
                        <label value="@load(vm.etichette['Data_Formazione'])"/>
                    </cell>
                    <cell colspan="2">
                        <hlayout valign="middle" hflex="1">
                            <datebox format="dd/MM/yyyy" value="@bind(vm.datiProvenienza.dataAttoEnteStraniero)"
                                     width="100px"/>
                            <button image="/images/icon/action/16x16/cancel.png"
                                    tooltiptext="@load(vm.etichette['Cancella'])"
                                    onClick="@command('onCancellaCampoProvenienza')">
                                <custom-attributes proprieta="dataAttoEnteStraniero"/>
                            </button>
                        </hlayout>
                    </cell>
                    <cell align="right" width="180px">
                        <h:span class="mandatoryLabel">*</h:span>
                        <label value="@load(vm.etichette['Estremi_Atto'])"/>
                    </cell>
                    <cell valign="middle">
                        <hlayout valign="middle" hflex="1">
                            <textbox hflex="1" value="@bind(vm.datiProvenienza.estremiAttoEnteStraniero)"/>
                            <button image="/images/icon/action/16x16/cancel.png"
                                    tooltiptext="@load(vm.etichette['Cancella'])"
                                    onClick="@command('onCancellaCampoProvenienza')">
                                <custom-attributes proprieta="estremiAttoEnteStraniero"/>
                            </button>
                        </hlayout>
                    </cell>
                    <cell/>
                </row>
                <row>
                    <cell align="right">
                        <h:span class="mandatoryLabel">*</h:span>
                        <label value="@load(vm.etichette['Nome_Ente'])"/>
                    </cell>
                    <cell colspan="2">
                        <hlayout valign="middle" hflex="1">
                            <textbox hflex="1" value="@bind(vm.datiProvenienza.autoritaEnteStraniero)"/>
                            <button image="/images/icon/action/16x16/cancel.png"
                                    tooltiptext="@load(vm.etichette['Cancella'])"
                                    onClick="@command('onCancellaCampoProvenienza')">
                                <custom-attributes proprieta="autoritaEnteStraniero"/>
                            </button>
                        </hlayout>
                    </cell>
                    <cell align="right">
                        <h:span class="mandatoryLabel">*</h:span>
                        <label value="@load(vm.etichette['Comune_Ente'])"/>
                    </cell>
                    <cell>
                        <hlayout valign="middle" hflex="1">
                            <bandboxComuni hflex="1"
                                           value="@load(vm.datiProvenienza.comuneEnteStraniero.descrizione)"
                                           dataRiferimento="@load(vm.datiProvenienza.dataAttoEnteStraniero)"
                                           onSelect="@command('onSelectComune', campoRiferimento='CE_STRA')"/>
                            <button image="/images/icon/action/16x16/cancel.png"
                                    tooltiptext="@load(vm.etichette['Cancella'])"
                                    onClick="@command('onCancellaComune', campoRiferimento='CE_STRA')"
                            />
                        </hlayout>
                    </cell>
                    <cell>
                        <textbox value="@load(vm.datiProvenienza.comuneEnteStraniero.siglaProvincia)" width="60px"
                                 readonly="true"/>
                    </cell>
                </row>
            </rows>
        </grid>
    </groupbox>
    <groupbox closable="false">
        <caption label="@load(vm.etichette['Dati_della_trascrizione'])"/>
        <grid sclass="form">
            <rows>
                <row>
                    <cell align="right" width="160px">
                        <h:span class="mandatoryLabel">*</h:span>
                        <label value="@load(vm.etichette['Data_Richiesta'])"/>
                    </cell>
                    <cell>
                        <hlayout valign="middle" hflex="1">
                            <datebox format="dd/MM/yyyy" value="@bind(vm.datiProvenienza.dataRichiestaTrascrizione)"
                                     width="100px"/>
                            <button image="/images/icon/action/16x16/cancel.png"
                                    tooltiptext="@load(vm.etichette['Cancella'])"
                                    onClick="@command('onCancellaCampoProvenienza')">
                                <custom-attributes proprieta="dataRichiestaTrascrizione"/>
                            </button>
                        </hlayout>
                    </cell>
                    <cell width="160px">
                        <customLabel mandatory="@load(vm.dettaglio.isTipoRichiestaTrascrizioneMandatory())"
                                     value="@load(vm.etichette['Tipo_richiesta'])"
                                     visible="@load(vm.dettaglio.motivoNascita.flagTipoRichiestaTrascrizione)"/>
                    </cell>
                    <cell>
                        <combobox visible="@load(vm.dettaglio.motivoNascita.flagTipoRichiestaTrascrizione)"
                                  model="@load(vm.listaTipoRichiestaTrascrizione)" readonly="true" width="200px"
                                  selectedItem="@bind(vm.datiProvenienza.tipoRichiestaTrascrizione) @converter('it.finmatica.zk.utils.PropertyConverter', property='id')">
                            <template name="model">
                                <comboitem label="@load(empty each?'- -':vm.getEtichettaEnum(each))"
                                           value="@load(each)"/>
                            </template>
                        </combobox>
                    </cell>
                </row>
                <row visible="@load(vm.dettaglio.motivoNascita.flagCambioGeneralita)">
                    <cell align="right">
                        <label value="@load(vm.etichette['Nuovo_nome'])"/>
                    </cell>
                    <cell colspan="3">
                        <hlayout valign="middle" hflex="1">
                            <textbox hflex="1" value="@bind(vm.dettaglio.nuovoNome)"
                                     onChange="@command('onAggiornaCase')"
                                     style="@load(vm.minuscole.cognome?'text-transform:none':'text-transform:uppercase')">
                                <custom-attributes proprieta="nuovoNome"/>
                            </textbox>
                            <button image="/images/icon/action/16x16/cancel.png"
                                    tooltiptext="@load(vm.etichette['Cancella'])"
                                    onClick="@command('onCancellaCampoAtto')">
                                <custom-attributes proprieta="nuovoNome"/>
                            </button>
                        </hlayout>
                    </cell>
                </row>
                <row visible="@load(vm.dettaglio.motivoNascita.flagCambioGeneralita)">
                    <cell align="right" width="165px">
                        <customLabel value="@load(vm.etichette['Nuovo_cognome'])"
                                     mandatory="@load(vm.dettaglio.isCambioGeneralitaTrascrizioneMandatory())"/>
                    </cell>
                    <cell colspan="3">
                        <hlayout valign="middle" hflex="1">
                            <textbox hflex="1" value="@bind(vm.dettaglio.nuovoCognome)"
                                     onChange="@command('onAggiornaCase')"
                                     style="@load(vm.minuscole.cognome?'text-transform:none':'text-transform:uppercase')">
                                <custom-attributes proprieta="nuovoCognome"/>
                            </textbox>
                            <button image="/images/icon/action/16x16/cancel.png"
                                    tooltiptext="@load(vm.etichette['Cancella'])"
                                    onClick="@command('onCancellaCampoAtto')">
                                <custom-attributes proprieta="nuovoCognome"/>
                            </button>
                        </hlayout>
                    </cell>
                </row>
            </rows>
        </grid>
    </groupbox>
</zk>