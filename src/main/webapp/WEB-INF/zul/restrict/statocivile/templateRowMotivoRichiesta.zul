<?xml version="1.0" encoding="UTF-8"?>
<?taglib uri="http://www.zkoss.org/dsp/web/core" prefix="c"?>

<zk xmlns="http://www.zkoss.org/2005/zul"
    xmlns:h="http://www.w3.org/1999/xhtml"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.zkoss.org/2005/zul http://www.zkoss.org/2005/zul/zul.xsd">
    <custom-attributes colspans="${arg.colspans.split(',')}" scope="page"/>
    <row>
        <cell align="right" width="150px" colspan="${page.getAttribute('colspans')[0]}">
            <hlayout>
                <hbox>
                    <h:span class="mandatoryLabel" style="top:0.15em;right:0px;">*</h:span>
                </hbox>
                <label value="@load(vm.etichette['Tipo_richiesta'])"/>
            </hlayout>
        </cell>
        <cell colspan="${page.getAttribute('colspans')[1]}">
            <hlayout height="20px">
                <radiogroup model="@load(vm.listaTipoRichiesta)" hflex="1"
                            onCheck="@command('onSelectTipoRichiesta')"
                            selectedItem="@bind(vm.dettaglio.tipoRichiesta) @converter('it.finmatica.zk.utils.PropertyConverter', property='tipoRichiesta')">
                    <template name="model">
                        <radio label="@load(each.descrizione)" disabled="@load(not vm.casiUsoEnabled)"
                               value="@load(each.tipoRichiesta)" style="padding-left:10px"/>
                    </template>
                </radiogroup>
            </hlayout>
        </cell>
        <cell align="right" width="120px" colspan="${page.getAttribute('colspans')[2]}">
            <hlayout>
                <hbox>
                    <h:span class="mandatoryLabel" style="top:0.15em;right:0px;">*</h:span>
                </hbox>
                <label value="@load(vm.etichette['Motivo_richiesta'])"/>
            </hlayout>
        </cell>
        <cell colspan="${page.getAttribute('colspans')[3]}">
            <hlayout valign="middle" hflex="1">
                <textbox value="@bind(vm.dettaglio[vm.getMotivoRichiestaField()].descrizione)" readonly="true"
                         rows="4"
                         hflex="1"
                         placeholder="Selezionare il motivo utilizzando il pulsante di ricerca"
                         tooltiptext="@load(vm.dettaglio[vm.getMotivoRichiestaField()].descrizione)"/>
                <button image="/images/icon/action/16x16/search.png"
                        tooltiptext="@load(vm.etichette['Seleziona'])"
                        disabled="@load(not vm.casiUsoEnabled)"
                        onClick="@command('onCaricaMotiviRichiesta')"/>
                <button image="/images/icon/action/16x16/cancel.png"
                        disabled="@load(not vm.casiUsoEnabled)"
                        tooltiptext="@load(vm.etichette['Cancella'])" onClick="@command('onCancellaCampoAtto')">
                    <custom-attributes proprieta="${vm.getMotivoRichiestaField()}"/>
                </button>
            </hlayout>
        </cell>
    </row>

</zk>