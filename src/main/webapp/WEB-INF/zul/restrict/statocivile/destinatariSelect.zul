<?xml version="1.0" encoding="UTF-8"?>
<?taglib uri="http://www.zkoss.org/dsp/web/core" prefix="c"?>
<?component name="templateDestinatariSelect" macroURI="/restrict/templateDestinatariSelect.zul" inline="true"?>

<zk xmlns="http://www.zkoss.org/2005/zul"
	xmlns:h="http://www.w3.org/1999/xhtml"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul http://www.zkoss.org/2005/zul/zul.xsd">

	<window viewModel="@id('vm') @init('restrict.statocivile.DestinatariSelectViewModel')"
			apply="org.zkoss.bind.BindComposer"
			border="none"
			width="500px"
			title="@load(vm.etichette['Seleziona'])"
			sizable="false" closable="true">

        <templateDestinatariSelect/>

	</window>

</zk>