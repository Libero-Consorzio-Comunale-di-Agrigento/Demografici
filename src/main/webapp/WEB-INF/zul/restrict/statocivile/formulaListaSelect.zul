<?xml version="1.0" encoding="UTF-8"?>
<?taglib uri="http://www.zkoss.org/dsp/web/core" prefix="c"?>

<zk xmlns="http://www.zkoss.org/2005/zul"
	xmlns:h="http://www.w3.org/1999/xhtml"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul http://www.zkoss.org/2005/zul/zul.xsd">

	<window viewModel="@id('vm') @init('restrict.statocivile.FormulaListaSelectViewModel')"
			apply="org.zkoss.bind.BindComposer"
			border="none"
			width="600px" height="500px"
			title="@load(vm.etichette['Seleziona'])"
			sizable="false" closable="true">

		<vlayout vflex="1">

			<controlBarFrammenti/>

			<totalSizeBlock/>

			<listbox model="@load(vm.lista)" multiple="true" checkmark="true" selectedItems="@bind(vm.dettagli)" vflex="1"
					 emptyMessage="@load(vm.etichette['Nessun_dato_disponibile'])">
				<listhead>
					<listheader label="@load(vm.etichette['Formula'])"/>
					<!--<listheader label="@load(vm.etichette['Testo'])"/> -->
				</listhead>
				<template name="model" var="item">
					<listitem>
						<listcell label="@load(item.DES_FORMULA)"/>
						<!-- <listcell label="@load(item.TESTO_FORMULA)"/> -->
					</listitem>
				</template>
			</listbox>

		</vlayout>

		<h:div sclass="barraPulsanti">
			<h:div>
				<button label="@load(vm.etichette['Seleziona'])"		onClick="@command('onSeleziona')" 	image="/images/icon/action/16x16/ok.png" />
				<button label="@load(vm.etichette['Chiudi'])"			onClick="@command('onChiudi')" 		image="/images/icon/action/16x16/close.png"/>
			</h:div>
		</h:div>

	</window>

</zk>