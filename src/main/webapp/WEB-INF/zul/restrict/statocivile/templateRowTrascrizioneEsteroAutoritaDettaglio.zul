<?xml version="1.0" encoding="UTF-8"?>
<?taglib uri="http://www.zkoss.org/dsp/web/core" prefix="c"?>
<?component name="templateRowEnteStranieroDettaglio" macroURI="/restrict/statocivile/templateRowEnteStranieroDettaglio.zul" inline="true"?>
<?component name=bandboxLuoghiNascita extends=bandbox class=it.finmatica.de4gsdzk.zkutils.BandboxLuoghiNascita?>

<zk xmlns="http://www.zkoss.org/2005/zul"
	xmlns:h="http://www.w3.org/1999/xhtml"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul http://www.zkoss.org/2005/zul/zul.xsd">

	<groupbox closable="false" visible="@load((vm.dettaglio.tipoAttoEnum eq 'MOR' or (vm.dettaglio.tipoAttoEnum eq 'MAT' and not vm.dettaglio.isDivorzioEstero())  or vm.dettaglio.tipoAttoEnum eq 'NAS'))">
		<caption label="@load(vm.etichette['Altri_Dati'])"/>
		<grid sclass="form">
			<rows>
				<row>
					<cell colspan="2" align="right">
						<label value="@load(vm.etichette['Durante_viaggio'])"/>
					</cell>
					<cell colspan="3" align="left">
						<checkbox checked="@bind(vm.datiProvenienza.flagInViaggio)"/>
					</cell>
					<cell colspan="2" align="right">
						<customLabel mandatory="@load(vm.datiProvenienza.flagInViaggio)" value="@load(vm.etichette['Tipo_Luogo_Nascita'])"
									 visible="@load(vm.dettaglio.tipoAttoEnum eq 'NAS')"/>
					</cell>
					<cell colspan="3" align="left">
						<combobox model="@load(vm.listaTipoLuogoNascita)" readonly="true" width="300px" disabled="@load(not vm.datiProvenienza.flagInViaggio)"
								  selectedItem="@bind(vm.datiProvenienza.tipoLuogoNascita) @converter('it.finmatica.zk.utils.PropertyConverter', property='id')"
								  visible="@load(vm.dettaglio.tipoAttoEnum eq 'NAS')">
							<template name="model">
								<comboitem label="@load(empty each?'- -':vm.getEtichettaEnum(each))" value="@load(each)"/>
							</template>
						</combobox>
					</cell>
				</row>
				<row visible="@load(vm.dettaglio.tipoAttoEnum eq 'NAS')">
					<cell align="right" colspan="2">
						<customLabel mandatory="false)"
									 value="@load(vm.etichette['Sede_parto'])"/>
					</cell>
					<cell colspan="8">
						<hlayout valign="middle" hflex="1">
							<textbox width="35px" value="@bind(vm.datiProvenienza.nelLuogoNascita)"
									 tooltiptext="@load(vm.etichette['Nel'])"/>
							<bandboxLuoghiNascita hflex="1"
												  value="@bind(vm.datiProvenienza.luogoNascita)"
												  onSelect="@command('onSelectLuogoNascita')"/>
							<button image="/images/icon/action/16x16/cancel.png"
									tooltiptext="@load(vm.etichette['Cancella'])" onClick="@command('onCancellaLuogoNascita')"/>
						</hlayout>
					</cell>
				</row>
			</rows>
		</grid>
	</groupbox>

		<groupbox closable="false">
			<caption label="@load(vm.etichette['Autorita_mittente'])" visible="@load(vm.dettaglio.isAutoritaMittenteEnabled())"/>
			<grid sclass="form">
				<rows>
				    <zk if="${vm.anscOn and vm.dettaglio.tipoAttoEnum eq 'NAS'}">
                        <row visible="@load(vm.anscOn and vm.dettaglio.tipoAtto eq 2 and not vm.datiProvenienza.flagInViaggio)">
                            <cell align="right" width="160px">
                                <customLabel mandatory="${arg.mandatory}" value="@load(vm.etichette['Dichiarazione_giudiziale'])"/>
                            </cell>
                            <cell colspan="3">
                                <hlayout height="20px">
                                    <radiogroup model="@load(vm.listaSiNo)" hflex="1"
                                                selectedItem="@bind(vm.datiProvenienza.dichiarazioneGiudiziale) @converter('it.finmatica.zk.utils.PropertyConverter', property='id')">
                                        <template name="model">
                                            <radio label="@load(vm.getEtichettaEnum(each))" value="@load(each)" style="padding-left:10px"/>
                                        </template>
                                    </radiogroup>
                                </hlayout>
                            </cell>
                            <cell width="70px"/>
                            <cell align="right" width="80px"/>
                            <cell colspan="3"/>
                        </row>
					</zk>
					<row>
						<cell align="right" width="160px">
							<customLabel mandatory="${arg.mandatory}" value="@load(vm.etichette['Da'])"/>
						</cell>
						<cell colspan="4">
							<hlayout valign="middle" hflex="1">
								<bandboxAutorita hflex="1"
												 value="@bind(vm.datiProvenienza.autorita)"
												 tipoAtto="@load(vm.dettaglio.tipoAtto)"
												 parte="@load(vm.dettaglio.parte)"
												 serie="@load(vm.dettaglio.serie)"
												 categoria="@load(vm.dettaglio.tipoAttoDomain.categoriaDomain.codice)"
												 disabled="@load(not vm.dettaglio.isAutoritaMittenteEnabled())"
												 onSelect="@command('onSelectAutorita')"/>
								<button image="/images/icon/action/16x16/cancel.png"
								        disabled="@load(not vm.dettaglio.isAutoritaMittenteEnabled())"
								        tooltiptext="@load(vm.etichette['Cancella'])"
										onClick="@command('onCancellaCampoProvenienza')">
                                    <custom-attributes proprieta="autorita"/>
                                </button>
							</hlayout>
						</cell>
						<cell align="right" width="70px">
							<label value="@load(vm.etichette['In'])"/>
						</cell>
						<cell colspan="3">
							<hlayout valign="middle" hflex="1">
								<textbox hflex="1"
										 value="@bind(vm.datiProvenienza.comune)"
										 disabled="@load(not vm.dettaglio.isAutoritaMittenteEnabled())"/>
								<button image="/images/icon/action/16x16/cancel.png"
										disabled="@load(not vm.dettaglio.isAutoritaMittenteEnabled())"
										tooltiptext="@load(vm.etichette['Cancella'])" onClick="@command('onCancellaCampoProvenienza')">
									<custom-attributes proprieta="comune"/>
								</button>
							</hlayout>
						</cell>
					</row>
					<row visible="@load(vm.dettaglio.tipoAttoEnum ne 'CIT' or (vm.dettaglio.tipoAttoEnum eq 'CIT' and vm.dettaglio.motivoCittadinanza.flagAutoritaEstremi))">
						<cell align="right">
							<customLabel mandatory="${arg.mandatory}" value="@load(vm.etichette['Comune'])"/>
						</cell>
						<cell colspan="3">
							<hlayout valign="middle" hflex="1">
								<bandboxComuni hflex="1"
											   value="@load(vm.datiProvenienza.comuneProvenienza.descrizione)"
											   dataRiferimento="@load(vm.datiProvenienza.dataNotaRif)"
											   onSelect="@command('onSelectComune', campoRiferimento='CA_PROV')"/>
								<button image="/images/icon/action/16x16/cancel.png"
										tooltiptext="@load(vm.etichette['Cancella'])" onClick="@command('onCancellaComune', campoRiferimento='CA_PROV')"
								/>
							</hlayout>
						</cell>
						<cell>
							<textbox value="@load(vm.datiProvenienza.comuneProvenienza.siglaProvincia)" hflex="1" readonly="true"/>
						</cell>
                        <cell align="right">
							<zk if="${vm.anscOn}">
                                <hlayout valign="middle" hflex="1"
                                         visible="@load(vm.dettaglio.tipoAttoEnum.isMatUci() or vm.dettaglio.tipoAttoEnum eq 'NAS' or vm.dettaglio.tipoAttoEnum eq 'MOR' or (vm.dettaglio.tipoAttoEnum eq 'CIT' and vm.dettaglio.motivoCittadinanza.flagConsolato))">
                                    <customLabel if="${arg.mandatory}"
											     mandatory="@load(vm.dettaglio.isConsolatoMandatory() and not vm.datiProvenienza.flagInViaggio)"
												 value="@load(vm.etichette['Consolato'])"/>
									<customLabel if="${not arg.mandatory}"
												 mandatory="false"
												 value="@load(vm.etichette['Consolato'])"/>
                                </hlayout>
							</zk>
						</cell>
						<cell colspan="3">
							<zk if="${vm.anscOn}">
                                <hlayout valign="middle" hflex="1"
                                    visible="@load(vm.dettaglio.tipoAttoEnum.isMatUci() or vm.dettaglio.tipoAttoEnum eq 'NAS' or vm.dettaglio.tipoAttoEnum eq 'MOR' or (vm.dettaglio.tipoAttoEnum eq 'CIT' and not empty vm.dettaglio.motivoCittadinanza and vm.dettaglio.motivoCittadinanza.flagConsolato))">
                                    <bandboxConsolati hflex="1"
							                value="@load(vm.datiProvenienza.consolato.descrizione)"
							                onSelect="@command('onSelectConsolato', campoRiferimento='PROVENIENZA')"/>
                                    <button image="/images/icon/action/16x16/cancel.png"
                                            tooltiptext="@load(vm.etichette['Cancella'])" onClick="@command('onCancellaCampoProvenienza')">
                                        <custom-attributes proprieta="consolato"/>
                                    </button>
                                </hlayout>
							</zk>
						</cell>
					</row>
					<row visible="@load(vm.dettaglio.tipoAttoEnum ne 'CIT' or (vm.dettaglio.tipoAttoEnum eq 'CIT' and vm.dettaglio.motivoCittadinanza.flagAutoritaEstremi))">
						<cell align="right">
							<label value="@load(vm.etichette['Ufficio'])"/>
						</cell>
						<cell colspan="7">
							<hlayout valign="middle" hflex="1">
								<textbox hflex="1" value="@bind(vm.datiProvenienza.frazione)"
										 disabled="@load(not vm.dettaglio.isAutoritaMittenteEnabled())"/>
								<button image="/images/icon/action/16x16/cancel.png"
										disabled="@load(not vm.dettaglio.isAutoritaMittenteEnabled())"
										tooltiptext="@load(vm.etichette['Cancella'])" onClick="@command('onCancellaCampoProvenienza')">
									<custom-attributes proprieta="frazione"/>
								</button>
							</hlayout>
						</cell>
						<cell/>
					</row>
					<row visible="@load(vm.dettaglio.tipoAttoEnum ne 'CIT' or (vm.dettaglio.tipoAttoEnum eq 'CIT' and vm.dettaglio.motivoCittadinanza.flagAutoritaEstremi))">
						<cell align="right">
							<customLabel if="${arg.mandatory}"
									mandatory="@load(vm.dettaglio.tipoAttoEnum eq 'CIT' and not empty vm.dettaglio.motivoCittadinanza and vm.dettaglio.motivoCittadinanza.flagAutoritaEstremi
													or (vm.dettaglio.tipoAttoEnum eq 'MAT' and vm.datiProvenienza.flagInViaggio))"
									value="@load(vm.etichette['Nota_Rif_Anno'])"/>
							<customLabel if="${not arg.mandatory}"
										 mandatory="false"
										 value="@load(vm.etichette['Nota_Rif_Anno'])"/>
						</cell>
						<cell colspan="4" valign="middle">
							<hlayout>
								<textbox value="@bind(vm.datiProvenienza.notaRif)"
										 disabled="@load(not vm.dettaglio.isAutoritaMittenteEnabled())"/>
								<label value="/"/>
								<textbox value="@bind(vm.datiProvenienza.annoNotaRif)"
										 disabled="@load(not vm.dettaglio.isAutoritaMittenteEnabled())"/>
								<button image="/images/icon/action/16x16/cancel.png"
										disabled="@load(not vm.dettaglio.isAutoritaMittenteEnabled())"
										tooltiptext="@load(vm.etichette['Cancella'])" onClick="@command('onCancellaCampoProvenienza')">
									<custom-attributes proprieta="notaRif,annoNotaRif"/>
								</button>
							</hlayout>
						</cell>
						<cell align="right">
							<customLabel if="${arg.mandatory}"
										 mandatory="@load((vm.dettaglio.tipoAttoEnum eq 'CIT' and not empty vm.dettaglio.motivoCittadinanza and vm.dettaglio.motivoCittadinanza.flagAutoritaEstremi and vm.dettaglio.motivoCittadinanza.flagDataTrascrizioneMandatory)
																				or
																				(vm.dettaglio.tipoAttoEnum eq 'NAS' and vm.dettaglio.isAutoritaMittenteEnabled() )
																				or (vm.datiProvenienza.flagInViaggio))"
										 value="@load(vm.etichette['In_data'])"/>
							<customLabel if="${not arg.mandatory}"
										 mandatory="false"
										 value="@load(vm.etichette['In_data'])"/>
						</cell>
						<cell colspan="3">
							<hlayout valign="middle" hflex="1">
								<datebox value="@bind(vm.datiProvenienza.dataNotaRif)" width="100px" format="dd/MM/yyyy"
										 disabled="@load(not vm.dettaglio.isAutoritaMittenteEnabled())"/>
								<button image="/images/icon/action/16x16/cancel.png"
										disabled="@load(not vm.dettaglio.isAutoritaMittenteEnabled())"
										tooltiptext="@load(vm.etichette['Cancella'])" onClick="@command('onCancellaCampoProvenienza')">
									<custom-attributes proprieta="dataNotaRif"/>
								</button>
							</hlayout>
						</cell>
					</row>
                    <!-- solo unioni civili -->
                    <zk if="${vm.dettaglio.tipoAttoEnum eq 'UCI'}">
                        <row>
                            <cell align="right">
                                <zk if="${vm.dettaglio.tipoAttoEnum eq 'UCI'}">
                                    <hlayout visible="@load(vm.dettaglio.tipoAttoEnum eq 'UCI')">
                                        <customLabel mandatory="${arg.mandatory}" value="@load(vm.etichette['Tipo_richiesta'])"/>
                                    </hlayout>
                                </zk>
                            </cell>
                            <cell colspan="8">
                                <zk if="${vm.dettaglio.tipoAttoEnum eq 'UCI'}">
                                    <combobox model="@load(vm.listaTipoRichiestaTrascrizione)" readonly="true" width="200px"
                                              selectedItem="@bind(vm.datiProvenienza.tipoRichiestaTrascrizione) @converter('it.finmatica.zk.utils.PropertyConverter', property='id')">
                                        <template name="model">
                                            <comboitem label="@load(empty each?'- -':vm.getEtichettaEnum(each))" value="@load(each)"/>
                                        </template>
                                    </combobox>
                                </zk>
                            </cell>
                        </row>
                    </zk>
					<!-- RIMPIAZZATO DA ENTE STRANIERO -->
					<!--<row>
						<cell align="right">
							<label value="@load(vm.etichette['Registrato_da'])"/>
						</cell>
						<cell colspan="3">
							<hlayout valign="middle" hflex="1">
								<textbox hflex="1" value="@bind(vm.datiProvenienza.autoritaAttoOriginale)"
										 disabled="@load(not vm.dettaglio.isAutoritaMittenteEnabled())"/>
								<button image="/images/icon/action/16x16/cancel.png"
										tooltiptext="@load(vm.etichette['Cancella'])" onClick="@command('onCancellaCampoProvenienza')"
										disabled="@load(not vm.dettaglio.isAutoritaMittenteEnabled())">
									<custom-attributes proprieta="autoritaAttoOriginale"/>
								</button>
							</hlayout>
						</cell>
						<cell align="right">
							<label value="@load(vm.etichette['In_data'])"/>
						</cell>
						<cell>
							<hlayout valign="middle" hflex="1">
								<datebox format="dd/MM/yyyy" value="@bind(vm.datiProvenienza.dataAttoOriginale)" width="100px"
										 disabled="@load(not vm.dettaglio.isAutoritaMittenteEnabled())"/>
								<button image="/images/icon/action/16x16/cancel.png"
										tooltiptext="@load(vm.etichette['Cancella'])" onClick="@command('onCancellaCampoProvenienza')"
										disabled="@load(not vm.dettaglio.isAutoritaMittenteEnabled())">
									<custom-attributes proprieta="dataAttoOriginale"/>
								</button>
							</hlayout>
						</cell>
					</row>-->
				</rows>
			</grid>
		</groupbox>

        <vlayout visible="@load(vm.dettaglio.isEnteStranieroEnabled())">
            <templateRowEnteStranieroDettaglio/>
        </vlayout>

</zk>