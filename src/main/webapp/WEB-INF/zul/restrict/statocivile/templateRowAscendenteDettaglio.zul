<?xml version="1.0" encoding="UTF-8"?>
<?taglib uri="http://www.zkoss.org/dsp/web/core" prefix="c"?>

<zk xmlns="http://www.zkoss.org/2005/zul"
    xmlns:h="http://www.w3.org/1999/xhtml"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.zkoss.org/2005/zul http://www.zkoss.org/2005/zul/zul.xsd">

    <!-- SEZIONE ASCENDENTE -->
    <row visible="@load(vm.dettaglio.motivoCittadinanza.flagAscendente)">
        <cell>
            <groupbox closable="false">
                <caption label="@load(vm.etichette['Generalita_ascendente'])"/>
                <grid sclass="form">
                    <rows>
                        <row>
                            <cell align="right" width="140px">
                                <label value="@load(vm.etichette['Cognome'])"/>
                            </cell>
                            <cell colspan="7">
                                <hlayout valign="middle" hflex="1">
                                    <textbox value="@bind(vm.ascendente.cognome)" hflex="1" style="@load(vm.minuscole.cognomeAscendente?'text-transform:none':'text-transform:uppercase')"
                                             onChange="@command('onAggiornaCaseSoggettoCollegato', tipoSoggettoCollegato='AS')">
                                        <custom-attributes proprieta="cognomeAscendente"/>
                                    </textbox>
                                    <button image="/images/icon/action/16x16/cancel.png"
                                            tooltiptext="@load(vm.etichette['Cancella'])"
                                            onClick="@command('onCancellaCampoSoggettoCollegato', tipoSoggettoCollegato='AS')">
                                        <custom-attributes proprieta="cognome"/>
                                    </button>
                                </hlayout>
                            </cell>
                            <cell align="right">
                                <hlayout valign="middle">
                                    <label value="@load(vm.etichette['Minuscole'])"/>
                                    <checkbox checked="@bind(vm.minuscole.cognomeAscendente)" onCheck="@command('onAggiornaCaseSoggettoCollegato', tipoSoggettoCollegato='AS')" >
                                        <custom-attributes proprieta="cognomeAscendente"/>
                                    </checkbox>
                                </hlayout>
                            </cell>
                        </row>
                        <row>
                            <cell align="right">
                                <h:span class="mandatoryLabel">*</h:span><label value="@load(vm.etichette['Nome'])"/>
                            </cell>
                            <cell colspan="7">
                                <hlayout valign="middle" hflex="1">
                                    <textbox value="@bind(vm.ascendente.nome)" hflex="1" style="@load(vm.minuscole.nomeAscendente?'text-transform:none':'text-transform:uppercase')"
                                             onChange="@command('onAggiornaCaseSoggettoCollegato', tipoSoggettoCollegato='AS')">
                                        <custom-attributes proprieta="nomeAscendente"/>
                                    </textbox>
                                    <button image="/images/icon/action/16x16/search.png"
                                            tooltiptext="@load(vm.etichette['Seleziona'])" onClick="@command('onCaricaSoggetti', tipoSoggetto='ASCENDENTE')"
                                    />
                                    <button image="/images/icon/action/16x16/cancel.png"
                                            tooltiptext="@load(vm.etichette['Cancella'])"
                                            onClick="@command('onCancellaCampoSoggettoCollegato', tipoSoggettoCollegato='AS')">
                                        <custom-attributes proprieta="nome"/>
                                    </button>
                                </hlayout>
                            </cell>
                            <cell align="right">
                                <hlayout valign="middle">
                                    <label value="@load(vm.etichette['Minuscole'])"/>
                                    <checkbox checked="@bind(vm.minuscole.nomeAscendente)" onCheck="@command('onAggiornaCaseSoggettoCollegato', tipoSoggettoCollegato='AS')" >
                                        <custom-attributes proprieta="nomeAscendente"/>
                                    </checkbox>
                                </hlayout>
                            </cell>
                        </row>
                        <row>
                            <cell align="right">
                                <label value="@load(vm.etichette['Sesso'])"/>
                            </cell>
                            <cell colspan="2">
                                <combobox model="@load(vm.listaSessoSoggettoCollegato)" readonly="true" width="100px"
                                          selectedItem="@bind(vm.ascendente.sesso) @converter('it.finmatica.zk.utils.PropertyConverter', property='id')">
                                    <template name="model">
                                        <comboitem label="@load(empty each?'- -':vm.getEtichettaEnum(each))" value="@load(each)"/>
                                    </template>
                                </combobox>
                            </cell>
                            <cell align="right">
                                <h:span class="mandatoryLabel">*</h:span><label value="@load(vm.etichette['Data_Nascita'])"/>
                            </cell>
                            <cell colspan="2">
                                <hlayout>
                                    <datebox format="dd/MM/yyyy" value="@bind(vm.ascendente.dataNascita)" width="95px"/>
                                    <button image="/images/icon/action/16x16/cancel.png"
                                            tooltiptext="@load(vm.etichette['Cancella'])"
                                            onClick="@command('onCancellaCampoSoggettoCollegato', tipoSoggettoCollegato='AS')">
                                        <custom-attributes proprieta="dataNascita"/>
                                    </button>
                                </hlayout>
                            </cell>
                            <cell/>
                            <cell align="right">
                                <h:span class="mandatoryLabel">*</h:span><label value="@load(vm.etichette['Grado_parentela'])"/>
                            </cell>
                            <cell>
                                <combobox model="@load(vm.listaGradoParentela)" readonly="true" hflex="1"
                                          selectedItem="@bind(vm.ascendente.gradoParentela) @converter('it.finmatica.zk.utils.PropertyConverter', property='id')">
                                    <template name="model">
                                        <comboitem label="@load(empty each?'- -':vm.getEtichettaEnum(each))" value="@load(each)"/>
                                    </template>
                                </combobox>
                            </cell>
                        </row>
                        <row>
                            <cell align="right">
                                <h:span class="mandatoryLabel">*</h:span><label value="@load(vm.etichette['Comune_Nascita'])"/>
                            </cell>
                            <cell colspan="5">
                                <hlayout valign="middle" hflex="1">
                                    <bandboxComuni hflex="1"
                                                   value="@load(vm.ascendente.comuneNascita.descrizione)"
                                                   dataRiferimento="@load(vm.ascendente.dataNascita)"
                                                   onSelect="@command('onSelectComune', campoRiferimento='CN_ASC')"/>
                                    <button image="/images/icon/action/16x16/cancel.png"
                                            tooltiptext="@load(vm.etichette['Cancella'])" onClick="@command('onCancellaComune', campoRiferimento='CN_ASC')"
                                    />
                                </hlayout>
                            </cell>
                            <cell>
                                <textbox value="@load(vm.ascendente.comuneNascita.siglaProvincia)" hflex="1" readonly="true"/>
                            </cell>
                            <cell colspan="2"/>
                        </row>
                        <row>
                            <cell align="right">
                                <h:span class="mandatoryLabel">*</h:span><label value="@load(vm.etichette['Comune_Residenza'])"/>
                            </cell>
                            <cell colspan="5">
                                <hlayout valign="middle" hflex="1">
                                    <bandboxComuni hflex="1"
                                                   value="@load(vm.ascendente.comuneResidenza.descrizione)"
                                                   onSelect="@command('onSelectComune', campoRiferimento='CR_ASC')"/>
                                    <button image="/images/icon/action/16x16/cancel.png"
                                            tooltiptext="@load(vm.etichette['Cancella'])" onClick="@command('onCancellaComune', campoRiferimento='CR_ASC')"
                                    />
                                </hlayout>
                            </cell>
                            <cell>
                                <textbox value="@load(vm.ascendente.comuneResidenza.siglaProvincia)" hflex="1" readonly="true"/>
                            </cell>
                            <cell align="right">
                                <h:span class="mandatoryLabel">*</h:span><label value="@load(vm.etichette['Nazionalita'])"/>
                            </cell>
                            <cell>
                                <combobox model="@load(vm.listaNazionalita)" readonly="false" hflex="1"
                                          selectedItem="@bind(vm.ascendente.nazionalita) @converter('it.finmatica.zk.utils.PropertyConverter', property='id')">
                                    <template name="model">
                                        <comboitem label="@load(empty each?'- -':each.descrizione)" tooltiptext="@load(each.descrizione)" value="@load(each)"/>
                                    </template>
                                </combobox>
                            </cell>
                        </row>
                    </rows>
                </grid>
            </groupbox>
        </cell>
        <cell width="42px">
            <button image="/images/icon/action/16x16/cancel.png"
                    tooltiptext="@load(vm.etichette['Cancella'])"
                    onClick="@command('onCancellaAnagrafica', tipoSoggetto='ASCENDENTE')"/>
        </cell>
    </row>

</zk>