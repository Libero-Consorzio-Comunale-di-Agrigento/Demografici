<?xml version="1.0" encoding="UTF-8"?>
<?taglib uri="http://www.zkoss.org/dsp/web/core" prefix="c"?>
<?component name="templateSezioneDatiDecedutoDettaglio" macroURI="/restrict/statocivile/morte/templateSezioneDatiDecedutoDettaglio.zul" inline="true"?>
<?component name="templateSezioneDatiDecessoDettaglio" macroURI="/restrict/statocivile/morte/templateSezioneDatiDecessoDettaglio.zul" inline="true"?>
<?component name="templateSezioneRedazioneDecessoDettaglio" macroURI="/restrict/statocivile/morte/templateSezioneRedazioneDecessoDettaglio.zul" inline="true"?>
<?component name="templateSezioneComposizioneDecessoDettaglio" macroURI="/restrict/statocivile/morte/templateSezioneComposizioneDecessoDettaglio.zul" inline="true"?>

<zk xmlns="http://www.zkoss.org/2005/zul"
	xmlns:h="http://www.w3.org/1999/xhtml"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul http://www.zkoss.org/2005/zul/zul.xsd">

	<window viewModel="@id('vm') @init('restrict.statocivile.morte.MortePregressoDettaglioViewModel')"
			apply="org.zkoss.bind.BindComposer"
			border="none"
			width="100%" height="100%"
			sizable="false" closable="false">

			<hlayout valign="middle">
				<controlBarDettaglio/>

				<controlBarAtto/>

				<label value="@load(vm.formLabel)" sclass="@load(vm.attoSclass)"/>

				<estremiAttoFormLabel/>
			</hlayout>

			<vlayout vflex="1" width="100%" sclass="scroll">

				<templateSezioneInformazioniNasMatDecUciCitPregressoDettaglio/>

				<templateSezioneDatiDecedutoDettaglio/>

				<templateSezioneDatiDecessoDettaglio/>

				<templateSezioneAttoOriginaleDettaglio/>

				<templateSezioneEstremiTrasporto/>

				<templateSezioneEstremiCremazione/>

				<vlayout hflex="1" visible="@load(vm.composizioneTestoAttiva and (vm.statoFrammenti lt 2) and (vm.dettaglio.natura ne 'N'))">
					<templateSezioneAccessoComposizionePregressoDettaglio/>
				</vlayout>

				<vlayout hflex="1" visible="@load(vm.composizioneTestoAttiva and (vm.statoFrammenti eq 2) and (vm.dettaglio.natura ne 'N'))">
					<!-- FIXME ATTI ANNULLATI? -->
                    <templateSezioneRedazioneDecessoDettaglio/>
					<templateSezioneComposizioneDecessoDettaglio/>
				</vlayout>

				<templateIdDomain/>

			</vlayout>

	</window>

</zk>