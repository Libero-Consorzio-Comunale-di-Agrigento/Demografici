<?xml version="1.0" encoding="UTF-8"?>
<?taglib uri="http://www.zkoss.org/dsp/web/core" prefix="c"?>
<?component name=bandboxLuoghiDecesso extends=bandbox class=it.finmatica.de4gsdzk.zkutils.BandboxLuoghiDecesso?>
<?component name=bandboxRicevuto extends=bandbox class=it.finmatica.de4gsdzk.zkutils.BandboxRicevuto?>
<?component name=bandboxDocumentoDecesso extends=bandbox class=it.finmatica.de4gsdzk.zkutils.BandboxDocumentoDecesso?>
<?component name="templateRowDichiaranteDettaglio" macroURI="/restrict/statocivile/templateRowDichiaranteDettaglio.zul" inline="true"?>
<?component name="templateRowDatiProvenienza" macroURI="/restrict/statocivile/templateRowDatiProvenienza.zul" inline="true"?>

<zk xmlns="http://www.zkoss.org/2005/zul"
	xmlns:h="http://www.w3.org/1999/xhtml"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul http://www.zkoss.org/2005/zul/zul.xsd">

		<groupbox mold="3d" hflex="1" open="false" visible="@load(not empty vm.dettaglio.natura)">
			<caption sclass="mainCaption">
				<div>
					<updownbutton onClick="@command(self.openClose())" sclass="captionButton"/>
					<label value="@load(vm.etichette['SEZIONE_REDAZIONE'])" sclass="captionLabel"/>
				</div>
			</caption>

			<!-- 2A 2B BIS-->
			<zk if="${vm.dettaglio.isSecondaA() or vm.dettaglio.isSecondaBBis() or vm.dettaglio.isSecondaCEx2BBis() or vm.dettaglio.isTestoLibero()}">
                <groupbox closable="false">
                    <caption label="@load(vm.etichette['Provenienza'])"/>
                    <grid sclass="form">
                        <rows>
                            <templateRowDatiProvenienza/>
                        </rows>
                    </grid>
                </groupbox>
			</zk>

			<!-- 2A o 1 -->
			<zk if="${vm.dettaglio.isCompFirmMorVisibile()}">
				<groupbox closable="false">
					<caption label="@load(vm.etichette['Dati_Dichiarazione'])"/>
					<grid sclass="form">
						<rows>
							<row>
								<cell align="right" width="160px">
									<h:span class="mandatoryLabel">*</h:span><label value="@load(vm.etichette['Comparente'])"/>
								</cell>
								<cell>
									<combobox model="@load(vm.listaComparente)" readonly="true" hflex="1"
											  onChange="@command('onSelectComparente')"
											  selectedItem="@bind(vm.datiProvenienza.tipoComparente) @converter('it.finmatica.zk.utils.PropertyConverter', property='value')">
										<template name="model">
											<comboitem label="@load(empty each?'- -':each.label)" value="@load(each.value)"/>
										</template>
									</combobox>
								</cell>

								<cell align="right">
									<h:span class="mandatoryLabel">*</h:span><label value="@load(vm.etichette['Firmatario'])"/>
								</cell>
								<cell>
									<combobox model="@load(vm.listaFirmatario)" readonly="true" hflex="1"
											  onChange="@command('onSelectFirmatario')"
											  selectedItem="@bind(vm.datiProvenienza.tipoFirmatario) @converter('it.finmatica.zk.utils.PropertyConverter', property='value')">
										<template name="model">
											<comboitem label="@load(empty each?'- -':each.label)" value="@load(each.value)"/>
										</template>
									</combobox>
								</cell>
								<cell colspan="2"/>
							</row>
						</rows>
					</grid>
				</groupbox>

				<!-- DICHIARANTE DECESSO -->
				<grid sclass="form">
					<rows visible="@load(vm.datiProvenienza.isPresenteComparenteDecesso())">
						<row visible="@load(vm.datiProvenienza.isPresenteComparenteDecesso())">
							<cell visible="@load(vm.datiProvenienza.isPresenteComparenteDecesso())">
								<groupbox closable="false">
									<caption label="@load(vm.etichette['Dati_Dichiarante'])" visible="@load(vm.datiProvenienza.isPresenteComparenteDecesso())"/>
									<grid sclass="form">
										<rows>
											<templateRowDichiaranteDettaglio mandatory="true"/>

                                            <row visible="@load(vm.dettaglio.isComprensioneDichiaranteVisibile())">
                                                <cell align="right">
                                                    <zk if="${vm.anscOn}">
                                                        <h:span class="mandatoryLabel">*</h:span>
                                                    </zk>
                                                    <label value="@load(vm.etichette['Condizioni_dichiarante'])"/>
                                                </cell>
                                                <cell colspan="2">
                                                    <combobox hflex="1" model="@load(vm.listaTipiComprensione)" readonly="true"
                                                              disabled="@load(not vm.dettaglio.isComprensioneDichiaranteVisibile())"
                                                              selectedItem="@bind(vm.datiProvenienza.comprensioneDichiarante) @converter('it.finmatica.zk.utils.PropertyConverter', property='id')">
                                                        <template name="model">
                                                            <comboitem label="@load(empty each?'- -':each.descrizione)" value="@load(each)"/>
                                                        </template>
                                                    </combobox>
                                                </cell>
                                                <cell align="right" colspan="2">
                                                    <hlayout>
                                                        <hbox visible="@load(vm.datiProvenienza.comprensioneDichiarante.flagMotivazioneImpedimento)">
                                                            <h:span class="mandatoryLabel" style="top:0.15em;right:0px;">*</h:span>
                                                        </hbox>
                                                        <label value="@load(vm.etichette['Motivo_Impedimento'])"
                                                               visible="@load(vm.datiProvenienza.comprensioneDichiarante.flagMotivazioneImpedimento)"/>
                                                    </hlayout>
                                                </cell>
                                                <cell colspan="3">
                                                    <hlayout valign="middle" hflex="1" visible="@load(vm.datiProvenienza.comprensioneDichiarante.flagMotivazioneImpedimento)">
                                                        <textbox value="@bind(vm.datiProvenienza.motivoImpedimentoDichiarante)"
                                                                 disabled="@load(not vm.dettaglio.isComprensioneDichiaranteVisibile())"
                                                                 hflex="1" rows="2"/>
                                                        <button image="/images/icon/action/16x16/cancel.png"
                                                                tooltiptext="@load(vm.etichette['Cancella'])"
                                                                disabled="@load(not vm.dettaglio.isComprensioneDichiaranteVisibile())"
                                                                onClick="@command('onCancellaCampoProvenienza')">
                                                            <custom-attributes proprieta="motivoImpedimentoDichiarante"/>
                                                        </button>
                                                    </hlayout>
                                                </cell>
                                                <cell/>
                                            </row>

										</rows>
									</grid>
								</groupbox>
							</cell>
							<cell width="42px" visible="@load(vm.datiProvenienza.isPresenteComparenteDecesso())">
								<button image="/images/icon/action/16x16/cancel.png"
										tooltiptext="@load(vm.etichette['Cancella'])" onClick="@command('onCancellaAnagrafica', tipoSoggetto='ALTRO')"/>
							</cell>
						</row>
					</rows>
				</grid>
			</zk>

            <!--SEZIONE INTERPRETE -->
            <zk if="${vm.anscOn}">
                <grid sclass="form">
                    <rows visible="@load(vm.datiProvenienza.isComparenteInterprete())">
                        <templateRowInterpreteDettaglio/>
                    </rows>
                </grid>
            </zk>

			<!-- TRASCRIZIONE ESTERO (PRIVATO) -->
			<templateRowTrascrizioneEsteroPrivatoDettaglio/>

			<!-- TRASCRIZIONE ESTERO (AUTORITA’) -->
			<zk if="${vm.dettaglio.isTrascrizioneEsteroDaAutorita()}">
			    <templateRowTrascrizioneEsteroAutoritaDettaglio mandatory="true"/>
			</zk>

            <!-- MORTE PRESUNTA -->
            <zk if="${vm.dettaglio.isMortePresunta()}">
                <groupbox closable="false" open="@load(vm.dettaglio.isMortePresunta())">
                    <caption label="@load(vm.etichette['Dati_Richiedente'])" visible="@load(vm.dettaglio.isMortePresunta())"/>
                    <grid sclass="form">
                        <rows>
                            <row>
                                <cell align="right" width="150px">
                                    <label value="@load(vm.etichette['Da'])"/>
                                </cell>
                                <cell colspan="5">
                                    <hlayout valign="middle" hflex="1">
                                        <bandboxAutorita hflex="1"
                                                         value="@bind(vm.datiProvenienza.autorita)"
                                                         tipoAtto="@load(vm.dettaglio.tipoAtto)"
                                                         parte="@load(vm.dettaglio.parte)"
                                                         serie="@load(vm.dettaglio.serie)"
                                                         categoria="@load(vm.dettaglio.tipoAttoDomain.categoriaDomain.codice)"
                                                         disabled="@load(not vm.dettaglio.isMortePresunta())"
                                                         onSelect="@command('onSelectAutorita')"/>
                                        <button image="/images/icon/action/16x16/cancel.png"
                                                disabled="@load(not vm.dettaglio.isMortePresunta())"
                                                tooltiptext="@load(vm.etichette['Cancella'])"
                                                onClick="@command('onCancellaCampoProvenienza')">
                                            <custom-attributes proprieta="autorita"/>
                                        </button>
                                    </hlayout>
                                </cell>
                            </row>
                            <row>
                                <cell align="right">
                                    <label value="@load(vm.etichette['In'])"/>
                                </cell>
                                <cell colspan="5">
                                    <hlayout valign="middle" hflex="1">
                                        <textbox hflex="1"
                                                 value="@bind(vm.datiProvenienza.comune)"
                                                 disabled="@load(not vm.dettaglio.isMortePresunta())"/>
                                        <button image="/images/icon/action/16x16/cancel.png"
                                                disabled="@load(not vm.dettaglio.isMortePresunta())"
                                                tooltiptext="@load(vm.etichette['Cancella'])" onClick="@command('onCancellaCampoProvenienza')">
                                            <custom-attributes proprieta="comune"/>
                                        </button>
                                    </hlayout>
                                </cell>
                            </row>
                            <row>
                                <cell align="right">
                                    <label value="@load(vm.etichette['Ufficio'])"/>
                                </cell>
                                <cell colspan="5">
                                    <hlayout valign="middle" hflex="1">
                                        <textbox hflex="1" value="@bind(vm.datiProvenienza.frazione)"
                                                 disabled="@load(not vm.dettaglio.isMortePresunta())"/>
                                        <button image="/images/icon/action/16x16/cancel.png"
                                                disabled="@load(not vm.dettaglio.isMortePresunta())"
                                                tooltiptext="@load(vm.etichette['Cancella'])" onClick="@command('onCancellaCampoProvenienza')">
                                            <custom-attributes proprieta="frazione"/>
                                        </button>
                                    </hlayout>
                                </cell>
                            </row>
                            <row>
                                <cell align="right">
                                    <label value="@load(vm.etichette['Nota_Rif_Anno'])"/>
                                </cell>
                                <cell colspan="3" valign="middle">
                                    <hlayout>
                                        <textbox value="@bind(vm.datiProvenienza.notaRif)"
                                                 disabled="@load(not vm.dettaglio.isMortePresunta())"/>
                                        <label value="/"/>
                                        <textbox value="@bind(vm.datiProvenienza.annoNotaRif)"
                                                 disabled="@load(not vm.dettaglio.isMortePresunta())"/>
                                        <button image="/images/icon/action/16x16/cancel.png"
                                                disabled="@load(not vm.dettaglio.isMortePresunta())"
                                                tooltiptext="@load(vm.etichette['Cancella'])" onClick="@command('onCancellaCampoProvenienza')">
                                            <custom-attributes proprieta="dataNotaRif"/>
                                        </button>
                                    </hlayout>
                                </cell>
                                <cell align="right">
                                    <label value="@load(vm.etichette['In_data'])"/>
                                </cell>
                                <cell>
                                    <hlayout valign="middle" hflex="1">
                                        <datebox value="@bind(vm.datiProvenienza.dataNotaRif)" width="100px" format="dd/MM/yyyy"
                                                 disabled="@load(not vm.dettaglio.isMortePresunta())"/>
                                        <button image="/images/icon/action/16x16/cancel.png"
                                                disabled="@load(not vm.dettaglio.isMortePresunta())"
                                                tooltiptext="@load(vm.etichette['Cancella'])" onClick="@command('onCancellaCampoProvenienza')">
                                            <custom-attributes proprieta="dataNotaRif"/>
                                        </button>
                                    </hlayout>
                                </cell>
                            </row>
                            <row>
                                <cell align="right">
                                    <label value="@load(vm.etichette['Tribunale'])"/>
                                </cell>
                                <cell colspan="5">
                                    <hlayout valign="middle" hflex="1">
                                        <textbox hflex="1" value="@bind(vm.datiProvenienza.tribunaleSentenza)"
                                                 disabled="@load(not vm.dettaglio.isMortePresunta())"/>
                                        <button image="/images/icon/action/16x16/cancel.png"
                                                tooltiptext="@load(vm.etichette['Cancella'])" onClick="@command('onCancellaCampoProvenienza')"
                                                disabled="@load(not vm.dettaglio.isMortePresunta())">
                                            <custom-attributes proprieta="tribunaleSentenza"/>
                                        </button>
                                    </hlayout>
                                </cell>
                            </row>
							<row>
								<cell align="right">
									<label value="@load(vm.etichette['Sentenza_n'])"/>
								</cell>
								<cell colspan="3" valign="middle">
									<hlayout>
										<textbox value="@bind(vm.datiProvenienza.numeroSentenza)"
												 disabled="@load(not vm.dettaglio.isMortePresunta())"/>
										<button image="/images/icon/action/16x16/cancel.png"
												disabled="@load(not vm.dettaglio.isMortePresunta())"
												tooltiptext="@load(vm.etichette['Cancella'])" onClick="@command('onCancellaCampoProvenienza')">
											<custom-attributes proprieta="numeroSentenza"/>
										</button>
									</hlayout>
								</cell>
								<cell align="right">
									<label value="@load(vm.etichette['In_data'])"/>
								</cell>
								<cell>
									<hlayout valign="middle" hflex="1">
										<datebox value="@bind(vm.datiProvenienza.dataSentenza)" width="100px" format="dd/MM/yyyy"
												 disabled="@load(not vm.dettaglio.isMortePresunta())"/>
										<button image="/images/icon/action/16x16/cancel.png"
												disabled="@load(not vm.dettaglio.isMortePresunta())"
												tooltiptext="@load(vm.etichette['Cancella'])" onClick="@command('onCancellaCampoProvenienza')">
											<custom-attributes proprieta="dataSentenza"/>
										</button>
									</hlayout>
								</cell>
							</row>
                        </rows>
                    </grid>
                </groupbox>
            </zk>

			<!-- CADUTO IN GUERRA -->
			<zk if="${vm.dettaglio.isCadutoInGuerra()}">
				<groupbox closable="false" open="@load(vm.dettaglio.isCadutoInGuerra())">
					<caption label="@load(vm.etichette['Dati_Richiedente'])" visible="@load(vm.dettaglio.isCadutoInGuerra())"/>
					<grid sclass="form">
						<rows>
							<row>
								<cell align="right" width="150px">
									<label value="@load(vm.etichette['Da'])"/>
								</cell>
								<cell colspan="5">
									<hlayout valign="middle" hflex="1">
										<bandboxAutorita hflex="1"
														 value="@bind(vm.datiProvenienza.autorita)"
														 tipoAtto="@load(vm.dettaglio.tipoAtto)"
														 parte="@load(vm.dettaglio.parte)"
														 serie="@load(vm.dettaglio.serie)"
														 categoria="@load(vm.dettaglio.tipoAttoDomain.categoriaDomain.codice)"
														 disabled="@load(not vm.dettaglio.isCadutoInGuerra())"
														 onSelect="@command('onSelectAutorita')"/>
										<button image="/images/icon/action/16x16/cancel.png"
										        disabled="@load(not vm.dettaglio.isCadutoInGuerra())"
												tooltiptext="@load(vm.etichette['Cancella'])"
                                                onClick="@command('onCancellaCampoProvenienza')">
                                            <custom-attributes proprieta="autorita"/>
                                        </button>
									</hlayout>
								</cell>
							</row>
							<row>
								<cell align="right">
									<label value="@load(vm.etichette['In'])"/>
								</cell>
								<cell colspan="5">
									<hlayout valign="middle" hflex="1">
										<textbox hflex="1"
												 value="@bind(vm.datiProvenienza.comune)"
												 disabled="@load(not vm.dettaglio.isCadutoInGuerra())"/>
										<button image="/images/icon/action/16x16/cancel.png"
												disabled="@load(not vm.dettaglio.isCadutoInGuerra())"
												tooltiptext="@load(vm.etichette['Cancella'])" onClick="@command('onCancellaCampoProvenienza')">
											<custom-attributes proprieta="comune"/>
										</button>
									</hlayout>
								</cell>
							</row>
							<row>
								<cell align="right">
									<label value="@load(vm.etichette['Ufficio'])"/>
								</cell>
								<cell colspan="5">
									<hlayout valign="middle" hflex="1">
										<textbox hflex="1" value="@bind(vm.datiProvenienza.frazione)"
												 disabled="@load(not vm.dettaglio.isCadutoInGuerra())"/>
										<button image="/images/icon/action/16x16/cancel.png"
												disabled="@load(not vm.dettaglio.isCadutoInGuerra())"
												tooltiptext="@load(vm.etichette['Cancella'])" onClick="@command('onCancellaCampoProvenienza')">
											<custom-attributes proprieta="frazione"/>
										</button>
									</hlayout>
								</cell>
							</row>
							<row>
								<cell align="right">
									<label value="@load(vm.etichette['Nota_Rif_Anno'])"/>
								</cell>
								<cell colspan="3" valign="middle">
									<hlayout>
										<textbox value="@bind(vm.datiProvenienza.notaRif)"
												 disabled="@load(not vm.dettaglio.isCadutoInGuerra())"/>
										<label value="/"/>
										<textbox value="@bind(vm.datiProvenienza.annoNotaRif)"
												 disabled="@load(not vm.dettaglio.isCadutoInGuerra())"/>
										<button image="/images/icon/action/16x16/cancel.png"
												disabled="@load(not vm.dettaglio.isCadutoInGuerra())"
												tooltiptext="@load(vm.etichette['Cancella'])" onClick="@command('onCancellaCampoProvenienza')">
											<custom-attributes proprieta="dataNotaRif"/>
										</button>
									</hlayout>
								</cell>
								<cell align="right">
									<label value="@load(vm.etichette['In_data'])"/>
								</cell>
								<cell>
									<hlayout valign="middle" hflex="1">
										<datebox value="@bind(vm.datiProvenienza.dataNotaRif)" width="100px" format="dd/MM/yyyy"
												 disabled="@load(not vm.dettaglio.isCadutoInGuerra())"/>
										<button image="/images/icon/action/16x16/cancel.png"
												disabled="@load(not vm.dettaglio.isCadutoInGuerra())"
												tooltiptext="@load(vm.etichette['Cancella'])" onClick="@command('onCancellaCampoProvenienza')">
											<custom-attributes proprieta="dataNotaRif"/>
										</button>
									</hlayout>
								</cell>
							</row>
							<row>
								<cell align="right">
									<label value="@load(vm.etichette['Atto_morte_n'])"/>
								</cell>
								<cell colspan="3" valign="middle">
									<hlayout>
										<textbox value="@bind(vm.datiProvenienza.numeroSentenza)"
												 disabled="@load(not vm.dettaglio.isCadutoInGuerra())"/>
										<button image="/images/icon/action/16x16/cancel.png"
												disabled="@load(not vm.dettaglio.isCadutoInGuerra())"
												tooltiptext="@load(vm.etichette['Cancella'])" onClick="@command('onCancellaCampoProvenienza')">
											<custom-attributes proprieta="numeroSentenza"/>
										</button>
									</hlayout>
								</cell>
								<cell align="right">
									<label value="@load(vm.etichette['In_data'])"/>
								</cell>
								<cell>
									<hlayout valign="middle" hflex="1">
										<datebox value="@bind(vm.datiProvenienza.dataSentenza)" width="100px" format="dd/MM/yyyy"
												 disabled="@load(not vm.dettaglio.isCadutoInGuerra())"/>
										<button image="/images/icon/action/16x16/cancel.png"
												disabled="@load(not vm.dettaglio.isCadutoInGuerra())"
												tooltiptext="@load(vm.etichette['Cancella'])" onClick="@command('onCancellaCampoProvenienza')">
											<custom-attributes proprieta="dataSentenza"/>
										</button>
									</hlayout>
								</cell>
							</row>
						</rows>
					</grid>
				</groupbox>
			</zk>

            <!-- SEZIONE REDAZIONE -->
			<groupbox closable="false">
				<caption label="@load(vm.etichette['Dati_Redazione'])"/>
				<grid sclass="form">
					<rows>
						<templateSezioneRowRedazioneDettaglio/>

						<row visible="@load( vm.dettaglio.isSecondaB() )">
							<cell align="right">
								<label value="@load(vm.etichette['Ricevuto_da'])"/>
							</cell>
							<cell colspan="5">
								<hlayout valign="middle" hflex="1">
									<bandboxRicevuto hflex="1" value="@bind(vm.datiProvenienza.ricevuto)"
													 onSelect="@command('onSelectRicevuto')"
													 disabled="@load(not (vm.dettaglio.isSecondaB()))"/>
									<button image="/images/icon/action/16x16/cancel.png"
											disabled="@load(not (vm.dettaglio.isSecondaB()))"
											tooltiptext="@load(vm.etichette['Cancella'])" onClick="@command('onCancellaRicevuto')"
									/>
								</hlayout>
							</cell>
						</row>
                        <row visible="@load( vm.dettaglio.isSecondaB() )">
                            <cell align="right">
								<zk if="${vm.anscOn}">
									<h:span class="mandatoryLabel">*</h:span>
								</zk>
                                <label value="@load(vm.etichette['Documento_i'])"/>
                            </cell>
                            <cell colspan="3">
                                <hlayout valign="middle" hflex="1">
                                    <bandboxDocumentoDecesso hflex="1" value="@bind(vm.datiProvenienza.documentoDecesso)"
                                                     		 onSelect="@command('onSelectDocumentoDecesso')"
                                                     		 disabled="@load(not (vm.dettaglio.isSecondaB()))"/>
                                    <button image="/images/icon/action/16x16/cancel.png"
                                            disabled="@load(not (vm.dettaglio.isSecondaB()))"
                                            tooltiptext="@load(vm.etichette['Cancella'])" onClick="@command('onCancellaDocumentoDecesso')"
                                    />
                                </hlayout>
                            </cell>
							<cell align="right">
								<zk if="${vm.anscOn}">
									<h:span class="mandatoryLabel">*</h:span>
								</zk>
								<label value="@load(vm.etichette['In_data'])"/>
							</cell>
							<cell>
								<hlayout valign="middle" hflex="1">
									<datebox value="@bind(vm.datiProvenienza.dataDocumentoDecesso)" width="100px" format="dd/MM/yyyy"
											 disabled="@load(not (vm.dettaglio.isSecondaB()))"/>
									<button image="/images/icon/action/16x16/cancel.png"
											disabled="@load(not (vm.dettaglio.isSecondaB()))"
											tooltiptext="@load(vm.etichette['Cancella'])" onClick="@command('onCancellaCampoProvenienza')">
										<custom-attributes proprieta="dataDocumentoDecesso"/>
									</button>
								</hlayout>
							</cell>
                        </row>
						<row visible="@load(not ( vm.dettaglio.isTrascrizioneEsteroDaPrivato() or vm.dettaglio.isTrascrizioneEsteroDaAutorita() or vm.dettaglio.isMortePresunta() or vm.dettaglio.isTestoLibero()) )">
							<cell align="right">
								<label value="@load(vm.etichette['Luogo_decesso'])"/>
							</cell>
							<cell colspan="5">
								<hlayout valign="middle" hflex="1">
									<textbox width="25px" value="@bind(vm.datiProvenienza.nelLuogoMorte)"
											 tooltiptext="@load(vm.etichette['Nel'])"
											 disabled="@load( vm.dettaglio.isTrascrizioneEsteroDaPrivato() or vm.dettaglio.isTrascrizioneEsteroDaAutorita() or vm.dettaglio.isMortePresunta() or vm.dettaglio.isTestoLibero())"/>
									<bandboxLuoghiDecesso hflex="1"
														  value="@bind(vm.datiProvenienza.luogoMorte1)"
                                                          disabled="@load( vm.dettaglio.isTrascrizioneEsteroDaPrivato() or vm.dettaglio.isTrascrizioneEsteroDaAutorita() or vm.dettaglio.isMortePresunta() or vm.dettaglio.isTestoLibero())"
														  onSelect="@command('onSelectLuogoDecesso')"/>
									                 <!-- onChange="@command('onChangeLuogoDecesso')" -->
									<button image="/images/icon/action/16x16/cancel.png"
                                            disabled="@load( vm.dettaglio.isTrascrizioneEsteroDaPrivato() or vm.dettaglio.isTrascrizioneEsteroDaAutorita() or vm.dettaglio.isMortePresunta() or vm.dettaglio.isTestoLibero())"
											tooltiptext="@load(vm.etichette['Cancella'])" onClick="@command('onCancellaLuogoDecesso')"
									/>
								</hlayout>
							</cell>
						</row>
					</rows>
				</grid>
			</groupbox>

			<templateSezioneAccessoComposizioneDettaglio/>

		</groupbox>

</zk>