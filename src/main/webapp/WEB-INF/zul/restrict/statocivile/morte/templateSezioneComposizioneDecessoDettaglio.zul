<?xml version="1.0" encoding="UTF-8"?>
<?taglib uri="http://www.zkoss.org/dsp/web/core" prefix="c"?>
<?xel-method prefix="c" name="addFormulaDecesso" class="it.finmatica.de4gsdzk.utils.FormulaUtils" signature="java.lang.Boolean addFormulaDecesso(java.lang.String chiave, it.finmatica.de4gsdzk.utils.ETipoOperazione tipoOperazione, it.finmatica.de4gsdzk.statocivile.CivMorte obj)"?>

<zk xmlns="http://www.zkoss.org/2005/zul"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul http://www.zkoss.org/2005/zul/zul.xsd">

		<!-- - - - - - - - - - - - - - - - - - - - - - - - COMPOSIZIONE - - - - - - - - - - - - - - - - - - - - - - - -->

		<groupbox mold="3d" hflex="1" open="true" visible="@load(vm.tipoOperazione.isUpdate())">
			<caption>
				<hlayout hflex="1" sclass="customCaption25">
					<hlayout sclass="testo-a-sx" hflex="1">
						<updownbutton onClick="@command(self.openClose())"/>
						<label value="@load(vm.etichette['SEZIONE_COMPOSIZIONE'])" sclass="captionLabel"/>
					</hlayout>
					<hlayout sclass="testo-a-dx" hflex="1" style="padding-right:8px">
						<button onClick="@command('onRefreshAllFormule')"
								image="/images/icon/action/16x16/refresh.png"
								tooltiptext="@load(vm.etichette['Aggiorna_Formule'])"/>
					</hlayout>
				</hlayout>
			</caption>
			<grid sclass="form">
				<rows>
					<!-- TESTO LIBERO -->
					<row visible="@load(c:addFormulaDecesso('formulaTestoLibero', vm.tipoOperazione, vm.dettaglio))">
						<cell align="right" width="150px">
							<label value="@load(vm.etichette['Testo_Libero'])"/>
						</cell>
						<cell colspan="5">
							<hlayout hflex="1" valign="middle">
								<textbox placeholder="@load(vm.etichette['Testo_Libero_placeholder'])"
										 rows="@load(not empty vm.mapFormule.formulaTestoLibero.numeroRighe?vm.mapFormule.formulaTestoLibero.numeroRighe:5)"
										 sclass="testoAtto"
										 value="@bind(vm.mapFormule.formulaTestoLibero.testo)" hflex="1"
										 disabled="@load(not (c:addFormulaDecesso('formulaTestoLibero', vm.tipoOperazione, vm.dettaglio)) )"/>
								<hlayout sclass="testo-a-dx" width="85px">
									<button image="/images/icon/action/16x16/grid.png"
											tooltiptext="@load(vm.etichette['Seleziona_Formula'])" onClick="@command('onCaricaFormuleFrammento', chiave='formulaTestoLibero')"
											disabled="@load(not (c:addFormulaDecesso('formulaTestoLibero', vm.tipoOperazione, vm.dettaglio)) )"/>
									<button image="/images/icon/action/16x16/refresh.png"
											tooltiptext="@load(vm.etichette['Aggiorna_Formula'])" onClick="@command('onRefreshFormula', chiave='formulaTestoLibero')"
											disabled="@load(not (c:addFormulaDecesso('formulaTestoLibero', vm.tipoOperazione, vm.dettaglio)) )"/>
								</hlayout>
							</hlayout>
						</cell>
					</row>
					<!-- TESTATA TRASCRIZIONE -->
					<row visible="@load(c:addFormulaDecesso('formulaTestataTrascrizione', vm.tipoOperazione, vm.dettaglio))">
						<cell align="right">
							<label value="@load(vm.etichette['Testata_Trascrizione'])"/>
						</cell>
						<cell colspan="5">
							<hlayout hflex="1" valign="middle">
								<textbox rows="@load(not empty vm.mapFormule.formulaTestataTrascrizione.numeroRighe?vm.mapFormule.formulaTestataTrascrizione.numeroRighe:5)"
										 sclass="testoAtto"
										 value="@bind(vm.mapFormule.formulaTestataTrascrizione.testo)" hflex="1"
										 disabled="@load(not (c:addFormulaDecesso('formulaTestataTrascrizione', vm.tipoOperazione, vm.dettaglio)) )"/>
								<hlayout sclass="testo-a-dx" width="85px">
									<button image="/images/icon/action/16x16/refresh.png"
											tooltiptext="@load(vm.etichette['Aggiorna_Formula'])" onClick="@command('onRefreshFormula', chiave='formulaTestataTrascrizione')"
											disabled="@load(not (c:addFormulaDecesso('formulaTestataTrascrizione', vm.tipoOperazione, vm.dettaglio)) )"/>
								</hlayout>
							</hlayout>
						</cell>
					</row>
					<!-- TESTATA -->
					<row visible="@load(c:addFormulaDecesso('formulaTestata', vm.tipoOperazione, vm.dettaglio))">
						<cell align="right">
							<label value="@load(vm.etichette['Testata'])"/>
						</cell>
						<cell colspan="5">
							<hlayout hflex="1" valign="middle">
								<textbox rows="@load(not empty vm.mapFormule.formulaTestata.numeroRighe?vm.mapFormule.formulaTestata.numeroRighe:5)"
									sclass="testoAtto"
									value="@bind(vm.mapFormule.formulaTestata.testo)" hflex="1"
									disabled="@load(not (c:addFormulaDecesso('formulaTestata', vm.tipoOperazione, vm.dettaglio)) )"/>
								<hlayout sclass="testo-a-dx" width="85px">
									<button image="/images/icon/action/16x16/refresh.png"
										tooltiptext="@load(vm.etichette['Aggiorna_Formula'])" onClick="@command('onRefreshFormula', chiave='formulaTestata')"
										disabled="@load(not (c:addFormulaDecesso('formulaTestata', vm.tipoOperazione, vm.dettaglio)) )"/>
								</hlayout>
							</hlayout>
						</cell>
					</row>
					<!-- DICHIARANTE FISSO -->
					<row visible="@load(c:addFormulaDecesso('formulaDichiaranteFissa', vm.tipoOperazione, vm.dettaglio))">
						<cell align="right">
							<label value="@load(vm.etichette['Dichiarante'])"/>
						</cell>
						<cell colspan="5">
							<hlayout hflex="1" valign="middle">
								<textbox rows="@load(not empty vm.mapFormule.formulaDichiaranteFissa.numeroRighe?vm.mapFormule.formulaDichiaranteFissa.numeroRighe:5)"
										 sclass="testoAtto"
										 value="@bind(vm.mapFormule.formulaDichiaranteFissa.testo)" hflex="1"
										 disabled="@load(not (c:addFormulaDecesso('formulaDichiaranteFissa', vm.tipoOperazione, vm.dettaglio)) )"/>
								<hlayout sclass="testo-a-dx" width="85px">
									<button image="/images/icon/action/16x16/refresh.png"
											tooltiptext="@load(vm.etichette['Aggiorna_Formula'])" onClick="@command('onRefreshFormula', chiave='formulaDichiaranteFissa')"
											disabled="@load(not (c:addFormulaDecesso('formulaDichiaranteFissa', vm.tipoOperazione, vm.dettaglio)) )"/>
								</hlayout>
							</hlayout>
						</cell>
					</row>
					<!-- DATI DECESSO / CONGIUNTI-->
					<row visible="@load(c:addFormulaDecesso('formulaDatiDecesso', vm.tipoOperazione, vm.dettaglio))">
						<cell align="right">
							<label value="@load(vm.etichette['Dati_Decesso'])"/>
						</cell>
						<cell colspan="5">
							<vlayout hflex="1">
								<hlayout hflex="1" valign="middle" visible="@load(c:addFormulaDecesso('formulaDatiDecesso', vm.tipoOperazione, vm.dettaglio))">
									<textbox rows="@load(not empty vm.mapFormule.formulaDatiDecesso.numeroRighe?vm.mapFormule.formulaDatiDecesso.numeroRighe:5)"
											 sclass="testoAtto"
											 value="@bind(vm.mapFormule.formulaDatiDecesso.testo)" hflex="1"
											 disabled="@load(not (c:addFormulaDecesso('formulaDatiDecesso', vm.tipoOperazione, vm.dettaglio)) )"/>
									<hlayout sclass="testo-a-dx" width="85px">
										<button image="/images/icon/action/16x16/refresh.png"
												tooltiptext="@load(vm.etichette['Aggiorna_Formula'])" onClick="@command('onRefreshFormula', chiave='formulaDatiDecesso')"
												disabled="@load(not (c:addFormulaDecesso('formulaDatiDecesso', vm.tipoOperazione, vm.dettaglio)) )"/>
									</hlayout>
								</hlayout>

								<hlayout hflex="1" valign="middle" visible="@load(c:addFormulaDecesso('formulaCongiunti', vm.tipoOperazione, vm.dettaglio))">
									<textbox rows="@load(not empty vm.mapFormule.formulaCongiunti.numeroRighe?vm.mapFormule.formulaCongiunti.numeroRighe:5)"
											 sclass="testoAtto"
											 value="@bind(vm.mapFormule.formulaCongiunti.testo)" hflex="1"
											 disabled="@load(not (c:addFormulaDecesso('formulaCongiunti', vm.tipoOperazione, vm.dettaglio)) )"/>
									<hlayout sclass="testo-a-dx" width="85px">
										<button image="/images/icon/action/16x16/refresh.png"
												tooltiptext="@load(vm.etichette['Aggiorna_Formula'])" onClick="@command('onRefreshFormula', chiave='formulaCongiunti')"
												disabled="@load(not (c:addFormulaDecesso('formulaCongiunti', vm.tipoOperazione, vm.dettaglio)) )"/>
									</hlayout>
								</hlayout>
							</vlayout>
						</cell>
					</row>
					<!-- ALTRI DATI -->
					<!-- piloto la visibilità sul blocco con le condizioni meno stringenti -->
					<row visible="@load(c:addFormulaDecesso('formulaApostille', vm.tipoOperazione, vm.dettaglio))">
						<cell align="right">
							<label value="@load(vm.etichette['Altri_Dati'])"/>
						</cell>
						<cell colspan="5">
							<vlayout hflex="1" spacing="10px">
								<hlayout hflex="1" valign="middle" visible="@load(c:addFormulaDecesso('formulaDatiIntegrativi', vm.tipoOperazione, vm.dettaglio) )">
									<textbox rows="@load(not empty vm.mapFormule.formulaDatiIntegrativi.numeroRighe?(vm.mapFormule.formulaDatiIntegrativi.numeroRighe/2):4)"
											 sclass="testoAtto"
											 value="@bind(vm.mapFormule.formulaDatiIntegrativi.testo)" hflex="1"
											 disabled="@load(not (c:addFormulaDecesso('formulaDatiIntegrativi', vm.tipoOperazione, vm.dettaglio)) )"/>
									<hlayout sclass="testo-a-dx" width="85px">
										<button image="/images/icon/action/16x16/grid.png"
												tooltiptext="@load(vm.etichette['Seleziona_Formula'])" onClick="@command('onCaricaFormuleFrammento', chiave='formulaDatiIntegrativi')"
												disabled="@load(not (c:addFormulaDecesso('formulaDatiIntegrativi', vm.tipoOperazione, vm.dettaglio)) )"/>
										<button image="/images/icon/action/16x16/refresh.png"
												tooltiptext="@load(vm.etichette['Aggiorna_Formula'])" onClick="@command('onRefreshFormula', chiave='formulaDatiIntegrativi')"
												disabled="@load(not (c:addFormulaDecesso('formulaDatiIntegrativi', vm.tipoOperazione, vm.dettaglio)) )"/>
									</hlayout>
								</hlayout>

								<hlayout hflex="1" valign="middle" visible="@load(c:addFormulaDecesso('formulaApostille', vm.tipoOperazione, vm.dettaglio) )">
									<textbox rows="@load(not empty vm.mapFormule.formulaApostille.numeroRighe?(vm.mapFormule.formulaApostille.numeroRighe/2):4)"
											 sclass="testoAtto"
											 value="@bind(vm.mapFormule.formulaApostille.testo)" hflex="1"
											 disabled="@load(not (c:addFormulaDecesso('formulaApostille', vm.tipoOperazione, vm.dettaglio)) )"/>
									<hlayout sclass="testo-a-dx" width="85px">
										<button image="/images/icon/action/16x16/grid.png"
												tooltiptext="@load(vm.etichette['Seleziona_Formula'])" onClick="@command('onCaricaFormuleFrammento', chiave='formulaApostille')"
												disabled="@load(not (c:addFormulaDecesso('formulaApostille', vm.tipoOperazione, vm.dettaglio)) )"/>
										<button image="/images/icon/action/16x16/refresh.png"
												tooltiptext="@load(vm.etichette['Aggiorna_Formula'])" onClick="@command('onRefreshFormula', chiave='formulaApostille')"
												disabled="@load(not (c:addFormulaDecesso('formulaApostille', vm.tipoOperazione, vm.dettaglio)) )"/>
									</hlayout>
								</hlayout>
							</vlayout>
						</cell>
					</row>
					<!-- CHIUSURA -->
					<row visible="@load(c:addFormulaDecesso('formulaChiusura', vm.tipoOperazione, vm.dettaglio))">
						<cell align="right">
							<label value="@load(vm.etichette['Chiusura'])"/>
						</cell>
						<cell colspan="5" align="center">
							<hlayout hflex="1" valign="middle">
								<textbox rows="@load(not empty vm.mapFormule.formulaChiusura.numeroRighe?vm.mapFormule.formulaChiusura.numeroRighe:4)"
									sclass="testoAtto"
									value="@bind(vm.mapFormule.formulaChiusura.testo)" hflex="1"
									disabled="@load(not (c:addFormulaDecesso('formulaChiusura', vm.tipoOperazione, vm.dettaglio)) )"/>
								<hlayout sclass="testo-a-dx" width="85px">
									<button image="/images/icon/action/16x16/grid.png"
										tooltiptext="@load(vm.etichette['Seleziona_Formula'])" onClick="@command('onCaricaFormuleFrammento', chiave='formulaChiusura')"
										disabled="@load(not (c:addFormulaDecesso('formulaChiusura', vm.tipoOperazione, vm.dettaglio)) )"/>
									<button image="/images/icon/action/16x16/refresh.png"
										tooltiptext="@load(vm.etichette['Aggiorna_Formula'])" onClick="@command('onRefreshFormula', chiave='formulaChiusura')"
										disabled="@load(not (c:addFormulaDecesso('formulaChiusura', vm.tipoOperazione, vm.dettaglio)) )"/>
								</hlayout>
							</hlayout>
						</cell>
					</row>
					<!-- FIRMA -->
					<row visible="@load(c:addFormulaDecesso('formulaFirma', vm.tipoOperazione, vm.dettaglio))">
						<cell align="right" width="150px">
							<label value="@load(vm.etichette['Firma'])"/>
						</cell>
						<cell colspan="5">
							<hlayout hflex="1" valign="middle">
								<textbox rows="@load(not empty vm.mapFormule.formulaFirma.numeroRighe?vm.mapFormule.formulaFirma.numeroRighe:5)"
										 sclass="testoAtto"
										 value="@bind(vm.mapFormule.formulaFirma.testo)" hflex="1"
										 disabled="@load(not (c:addFormulaDecesso('formulaFirma', vm.tipoOperazione, vm.dettaglio)) )"/>
								<hlayout sclass="testo-a-dx" width="85px">
									<button image="/images/icon/action/16x16/refresh.png"
											tooltiptext="@load(vm.etichette['Aggiorna_Formula'])" onClick="@command('onRefreshFormula', chiave='formulaFirma')"
											disabled="@load(not (c:addFormulaDecesso('formulaFirma', vm.tipoOperazione, vm.dettaglio)) )"/>
								</hlayout>
							</hlayout>
						</cell>
					</row>

					<!-- RIEPILOGO -->
					<templateRowRiepilogoAttoDettaglio/>

					<row>
						<cell colspan="3">
							<hlayout hflex="1" sclass="testo-al-centro">
								<button label="@load(vm.etichette['Preview'])"
										height="35px" width="150px"
										style="font-size:12px; font-weight: bold;"
										disabled="@load(vm.tipoOperazione.isInsert())"
										onClick="@command('onPreviewRecord')"
								/>
							</hlayout>
						</cell>
						<cell colspan="3">
							<hlayout hflex="1" sclass="testo-al-centro">
								<button label="@load(vm.buttonConsolidamentoLabel)"
										height="35px" width="150px"
										style="font-size:12px; font-weight: bold;"
										visible="@load(not empty vm.buttonConsolidamentoLabel)"
										disabled="@load(vm.tipoOperazione.isInsert())"
										onClick="@command('onCheckConsolidamento')"
								/>
							</hlayout>
						</cell>
					</row>
				</rows>
			</grid>
		</groupbox>

</zk>