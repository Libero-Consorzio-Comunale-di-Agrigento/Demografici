<?xml version="1.0" encoding="UTF-8"?>
<?taglib uri="http://www.zkoss.org/dsp/web/core" prefix="c"?>
<?import org.zkoss.zul.Filedownload?>
<zk xmlns="http://www.zkoss.org/2005/zul"
    xmlns:h="http://www.w3.org/1999/xhtml"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.zkoss.org/2005/zul http://www.zkoss.org/2005/zul/zul.xsd">

    <window viewModel="@id('vm') @init('restrict.statocivile.morte.MorteXPMOViewModel')"
            apply="org.zkoss.bind.BindComposer"
            border="none"
            width="100%" height="100%"
            sizable="false" closable="false">

        <hlayout valign="middle">
            <controlBarStampa/>

            <label value="@load(vm.formLabel)" sclass="formTitle"/>
        </hlayout>

        <vlayout vflex="1">

            <groupbox closable="false">
                <grid sclass="form">
                    <rows>
                        <row>
                            <cell align="right" width="120px">
                                <h:span class="mandatoryLabel">*</h:span><label value="@load(vm.etichette['Cognome_Referente'])"/>
                            </cell>
                            <cell colspan="3">
                                <textbox value="@bind(vm.richiesta.cognome)" hflex="1"/>
                            </cell>
                        </row>
                        <row>
                            <cell align="right">
                                <h:span class="mandatoryLabel">*</h:span><label value="@load(vm.etichette['Nome_Referente'])"/>
                            </cell>
                            <cell colspan="3">
                                <textbox value="@bind(vm.richiesta.nome)" hflex="1"/>
                            </cell>
                        </row>
                        <row>
                            <cell align="right">
                                <label value="@load(vm.etichette['Numero_Richiesta'])"/>
                            </cell>
                            <cell>
                                <intbox value="@load(vm.richiesta.numero)" disabled="true"/>
                            </cell>
                            <cell align="right">
                                <label value="@load(vm.etichette['Data'])"/>
                            </cell>
                            <cell>
                                <datebox format="dd/MM/yyyy" value="@load(vm.richiesta.data)" disabled="true"/>
                            </cell>
                        </row>
                    </rows>
                </grid>
            </groupbox>

            <space/>

            <groupbox closable="false">
                <grid sclass="form">
                    <rows>
                        <row>
                            <cell align="right" width="120px">
                                <label value="@load(vm.etichette['Numero_Protocollo_Anno'])"/>
                            </cell>
                            <cell>
                                <intbox value="@bind(vm.protocollo.numero)" cols="10"/><space/>/<space/>
                                <intbox value="@bind(vm.protocollo.anno)" cols="4"/>
                            </cell>
                        </row>
                        <row>
                            <cell align="right" width="120px">
                                <label value="@load(vm.etichette['Ricerca_per'])"/>
                            </cell>
                            <cell>
                                <radiogroup onCheck="@command('onSelectTipoRicerca')">
                                    <radio label="@load(vm.etichette['Estremi_Atto'])"          checked="@load(not not vm.ricercaPerAtto)"   style="padding:20px"/>
                                    <radio label="@load(vm.etichette['Data_Registrazione'])"    checked="@load(not vm.ricercaPerAtto)"       style="padding:20px"/>
                                </radiogroup>
                            </cell>
                        </row>
                        <row>
                            <cell align="right">
                                <label value="@load(vm.etichette['Estremi_Atto'])"/>
                            </cell>
                            <cell>
                                <grid>
                                    <rows>
                                        <row>
                                            <cell align="right" width="90px">
                                                <label value="@load(vm.etichette['Cognome_Nome'])"/>
                                            </cell>
                                            <cell colspan="9">
                                                <hlayout valign="middle">
                                                    <bandboxDecessi hflex="1"
                                                                    value="@load(vm.nominativo)"
                                                                    onSelect="@command('onSelectDatiDecesso')"
                                                                    disabled="@load(not vm.ricercaPerAtto)"/>
                                                    <button image="/images/icon/action/16x16/cancel.png"
                                                            tooltiptext="@load(vm.etichette['Cancella'])"
                                                            disabled="@load(not vm.ricercaPerAtto)"
                                                            onClick="@command('onCancellaDatiDecesso')"/>
                                                </hlayout>
                                            </cell>
                                        </row>
                                        <row>
                                            <cell align="right" width="50px">
                                                <label value="@load(vm.etichette['Ufficio'])"/>
                                            </cell>
                                            <cell width="60px">
                                                <combobox model="@load(vm.listaUffici)" readonly="true" hflex="1" disabled="@load(not vm.ricercaPerAtto)"
                                                          selectedItem="@bind(vm.ricerca.ufficio)  @converter('it.finmatica.zk.utils.PropertyConverter', property='id')">
                                                    <template name="model">
                                                        <comboitem label="@load(each)" value="@load(each)"/>
                                                    </template>
                                                </combobox>
                                            </cell>
                                            <cell align="right" width="50px">
                                                <label value="@load(vm.etichette['Anno'])"/>
                                            </cell>
                                            <cell width="40px">
                                                <intbox value="@bind(vm.ricerca.anno)"
                                                        disabled="@load(not vm.ricercaPerAtto)" maxlength="4" hflex="1"/>
                                            </cell>
                                            <cell align="right" width="35px">
                                                <label value="@load(vm.etichette['Parte'])"/>
                                            </cell>
                                            <cell width="30px">
                                                <intbox value="@bind(vm.ricerca.parte)"
                                                        disabled="@load(not vm.ricercaPerAtto)" hflex="1"/>
                                            </cell>
                                            <cell align="right" width="35px">
                                                <label value="@load(vm.etichette['Serie'])"/>
                                            </cell>
                                            <cell width="30px">
                                                <textbox value="@bind(vm.ricerca.serie)" style="text-transform:uppercase"
                                                         disabled="@load(not vm.ricercaPerAtto)" hflex="1"/>
                                            </cell>
                                            <cell align="right" width="50px">
                                                <label value="@load(vm.etichette['Numero_Atto'])"/>
                                            </cell>
                                            <cell>
                                                <intbox value="@bind(vm.ricerca.atto)"
                                                        disabled="@load(not vm.ricercaPerAtto)" hflex="1"/>
                                            </cell>
                                        </row>
                                    </rows>
                                </grid>
                            </cell>
                        </row>
                        <row>
                            <cell align="right">
                                <label value="@load(vm.etichette['Data_Registrazione'])"/>
                            </cell>
                            <cell>
                                <hlayout valign="middle">
                                    <label value="@load(vm.etichette['Da'])"/>
                                    <datebox format="dd/MM/yyyy" value="@bind(vm.ricerca.dataRegistrazioneDa)" width="100px" disabled="@load(vm.ricercaPerAtto)"/>
                                    <button image="/images/icon/action/16x16/cancel.png" disabled="@load(vm.ricercaPerAtto)"
                                            tooltiptext="@load(vm.etichette['Cancella'])" onClick="@command('onCancellaCampoRicerca')">
                                        <custom-attributes proprieta="dataRegistrazioneDa"/>
                                    </button>
                                    <space/>
                                    <label value="@load(vm.etichette['A'])"/>
                                    <datebox format="dd/MM/yyyy" value="@bind(vm.ricerca.dataRegistrazioneA)" width="100px" disabled="@load(vm.ricercaPerAtto)"/>
                                    <button image="/images/icon/action/16x16/cancel.png" disabled="@load(vm.ricercaPerAtto)"
                                            tooltiptext="@load(vm.etichette['Cancella'])" onClick="@command('onCancellaCampoRicerca')">
                                        <custom-attributes proprieta="dataRegistrazioneA"/>
                                    </button>
                                </hlayout>
                            </cell>
                        </row>
                    </rows>
                </grid>
            </groupbox>

        </vlayout>

    </window>

</zk>