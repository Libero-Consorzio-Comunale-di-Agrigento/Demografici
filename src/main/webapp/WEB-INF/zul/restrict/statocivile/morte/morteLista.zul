<?xml version="1.0" encoding="UTF-8"?>
<?taglib uri="http://www.zkoss.org/dsp/web/core" prefix="c"?>
<?xel-method prefix="c" name="getAttoCellSclass" class="it.finmatica.de4gsdzk.utils.FormUtils" signature="java.lang.String getAttoCellSclass(it.finmatica.de4gsdzk.CivAttoBaseDomain)"?>

<zk xmlns="http://www.zkoss.org/2005/zul"
	xmlns:h="http://www.w3.org/1999/xhtml"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xmlns:w="http://www.zkoss.org/2005/zk/client"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul http://www.zkoss.org/2005/zul/zul.xsd">

	<window viewModel="@id('vm') @init('restrict.statocivile.morte.MorteListaViewModel')"
			apply="org.zkoss.bind.BindComposer"
			border="none"
			width="100%" height="@load(vm.wCenterHeight)"
			sizable="false" closable="false">

			<hlayout valign="middle">
				<controlBarLista/>

				<label value="@load(vm.formLabel)" sclass="formTitle"/>
			</hlayout>

			<templateRowRicercaAtto/>

			<orderByBlock/>

			<listbox model="@load(vm.lista)" selectedItem="@bind(vm.dettaglio)" nonselectableTags="" vflex="1"
					 emptyMessage="@load(vm.etichette['Nessun_dato_disponibile'])">
				<listhead sizable="true">
					<listheader label="@load(vm.etichette['Cognome'])" 					width="35%"/>
					<listheader label="@load(vm.etichette['Nome'])" 					width="20%"/>
                    <listheader label="@load(vm.etichette['Sesso'])" 					width="5%"/>
                    <listheader label="@load(vm.etichette['Data_Decesso'])"				width="10%"/>
					<listheader label="@load(vm.etichette['Anno'])" 					width="5%"/>
					<listheader label="@load(vm.etichette['Numero'])" 				width="5%"/>
					<listheader label="@load(vm.etichette['Parte'])" 					width="5%"/>
					<listheader label="@load(vm.etichette['Serie'])" 					width="5%"/>
                    <listheader label="@load(vm.etichette['Ufficio'])" 					width="5%"/>
					<zk if="${vm.anscOn}">
						<listheader label="@load(vm.etichette['Id_Atto_Ansc'])" 		width="160px"/>
					</zk>
					<listheader label="@load(vm.etichette['Comunicazioni_pendenti'])"	width="5%"/>
					<listheader label="" width="52px"/>
				</listhead>
				<template name="model" var="item">
					<listitem onDoubleClick="@command('onModifica')">
						<listcell>
							<label value="@load(item.cognome1Lista)"
								   sclass="@load(c:getAttoCellSclass(item))"/>
						</listcell>
						<listcell>
							<label value="@load(item.nome1Lista)"
								   sclass="@load(c:getAttoCellSclass(item))"/>
						</listcell>
						<listcell>
							<label value="@load(item.sesso1Lista)"
								   sclass="@load(c:getAttoCellSclass(item))"/>
						</listcell>
						<listcell>
							<label value="@load(empty item.dataEventoLista? null:(c:formatDate(item.dataEventoLista, 'dd/MM/yyyy')))"
								   sclass="@load(c:getAttoCellSclass(item))"/>
						</listcell>
						<listcell>
							<label value="@load(item.attoLista.anno)"
								   sclass="@load(c:getAttoCellSclass(item))"/>
						</listcell>
						<listcell>
							<label value="@load(item.attoLista.atto lt 0? vm.etichette['Provvisorio']: item.attoLista.atto)"
								   sclass="@load(c:getAttoCellSclass(item))"/>
						</listcell>
						<listcell>
							<label value="@load(item.attoLista.parte)"
								   sclass="@load(c:getAttoCellSclass(item))"/>
						</listcell>
						<listcell>
							<label value="@load(item.attoLista.serie)"
								   sclass="@load(c:getAttoCellSclass(item))"/>
						</listcell>
						<listcell>
							<label value="@load(item.attoLista.ufficio)"
								   sclass="@load(c:getAttoCellSclass(item))"/>
						</listcell>
						<zk if="${vm.anscOn}">
							<listcell>
								<label value="@load(item.attoLista.idAttoAnsc)"
									   sclass="@load(c:getAttoCellSclass(item))"/>
							</listcell>
						</zk>
						<listcell>
							<label value="@load(item.comunicazioniPendenti.name())"
								   sclass="@load(c:getAttoCellSclass(item))"/>
						</listcell>
						<listcell>
							<button image="/images/icon/action/18x18/edit.png"
								   tooltiptext="@load(vm.etichette['modifica_tooltip'])"
								   visible="@load(not empty item.id)"
								   onClick="@command('onModifica')"/>
						</listcell>
					</listitem>
				</template>
			</listbox>

	</window>

</zk>