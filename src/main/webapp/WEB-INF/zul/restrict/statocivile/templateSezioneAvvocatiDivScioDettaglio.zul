<?xml version="1.0" encoding="UTF-8"?>
<?taglib uri="http://www.zkoss.org/dsp/web/core" prefix="c"?>

<zk xmlns="http://www.zkoss.org/2005/zul"
	xmlns:h="http://www.w3.org/1999/xhtml"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul http://www.zkoss.org/2005/zul/zul.xsd">

	<!-- AVVOCATI -->
	<groupbox mold="3d" hflex="1" open="false">
		<caption sclass="mainCaption">
			<div>
				<updownbutton onClick="@command(self.openClose())" sclass="captionButton"/>
				<label value="@load(vm.etichette['SEZIONE_AVVOCATI'])" sclass="captionLabel"/>
			</div>
		</caption>
		<grid sclass="form">
			<rows>
			    <zk if="${vm.anscOn and vm.dettaglio.tipoAttoEnum.isMatrimonio() and (vm.dettaglio.isAvvocati() or vm.dettaglio.isAvvocatiAltro())}">
                    <row>
                        <cell align="right" width="130px">
                            <h:span class="mandatoryLabel">*</h:span>
                            <label value="@load(vm.etichette['Ricezione_Atto'])"/>
                        </cell>
                        <cell>
                            <combobox model="@load(vm.listaRicezioneAtto)" readonly="true"
                                      selectedItem="@bind(vm.datiProvenienza.ricezioneAttoAvvocati) @converter('it.finmatica.zk.utils.PropertyConverter', property='value')">
                                <template name="model">
                                    <comboitem label="@load(empty each?'- -':each.label)" value="@load(each.value)"/>
                                </template>
                            </combobox>
                        </cell>
                    </row>
                </zk>
				<row>
					<cell colspan="2">
						<groupbox closable="false">
							<caption label="@load(vm.etichetteCustom['Avvocato1'])"/>
							<grid sclass="form">
								<rows>
									<row>
										<cell align="right" width="120px">
											<zk if="${vm.anscOn and (vm.dettaglio.isAvvocati() or vm.dettaglio.isAvvocatiAltro())}">
												<h:span class="mandatoryLabel">*</h:span>
											</zk>
											<label value="@load(vm.etichette['Cognome'])"/>
										</cell>
										<cell colspan="6">
											<hlayout valign="middle" hflex="1">
												<textbox value="@bind(vm.datiProvenienza.cognomeAvvocato1)" hflex="1" style="@load(vm.minuscole.cognomeAvvocato1?'text-transform:none':'text-transform:uppercase')"
														 onChange="@command('onAggiornaCaseDatiProvenienza')">
													<custom-attributes proprieta="cognomeAvvocato1"/>
												</textbox>
												<button image="/images/icon/action/16x16/cancel.png"
														tooltiptext="@load(vm.etichette['Cancella'])" onClick="@command('onCancellaCampoProvenienza')">
													<custom-attributes proprieta="cognomeAvvocato1"/>
												</button>
											</hlayout>
										</cell>
										<cell align="right" width="145px">
											<hlayout valign="middle" >
												<label value="@load(vm.etichette['Minuscole'])"/>
												<checkbox checked="@bind(vm.minuscole.cognomeAvvocato1)" onCheck="@command('onAggiornaCaseDatiProvenienza')">
													<custom-attributes proprieta="cognomeAvvocato1"/>
												</checkbox>
											</hlayout>
										</cell>
									</row>
									<row>
										<cell align="right">
											<zk if="${vm.anscOn and (vm.dettaglio.isAvvocati() or vm.dettaglio.isAvvocatiAltro())}">
												<h:span class="mandatoryLabel">*</h:span>
											</zk>
											<label value="@load(vm.etichette['Nome'])"/>
										</cell>
										<cell colspan="6">
											<hlayout valign="middle" hflex="1">
												<textbox value="@bind(vm.datiProvenienza.nomeAvvocato1)" hflex="1" style="@load(vm.minuscole.nomeAvvocato1?'text-transform:none':'text-transform:uppercase')"
														 onChange="@command('onAggiornaCaseDatiProvenienza')">
													<custom-attributes proprieta="nomeAvvocato1"/>
												</textbox>
												<button image="/images/icon/action/16x16/cancel.png"
														tooltiptext="@load(vm.etichette['Cancella'])" onClick="@command('onCancellaCampoProvenienza')">
													<custom-attributes proprieta="nomeAvvocato1"/>
												</button>
											</hlayout>
										</cell>
										<cell align="right" width="145px">
											<hlayout valign="middle">
												<label value="@load(vm.etichette['Minuscole'])"/>
												<checkbox checked="@bind(vm.minuscole.nomeAvvocato1)" onCheck="@command('onAggiornaCaseDatiProvenienza')">
													<custom-attributes proprieta="nomeAvvocato1"/>
												</checkbox>
											</hlayout>
										</cell>
									</row>
									<row>
										<cell align="right">
											<label value="@load(vm.etichette['Sede'])"/>
										</cell>
										<cell colspan="3">
											<hlayout valign="middle" hflex="1">
												<textbox value="@bind(vm.datiProvenienza.sedeAvvocato1)" hflex="1"/>
												<button image="/images/icon/action/16x16/cancel.png"
														tooltiptext="@load(vm.etichette['Cancella'])" onClick="@command('onCancellaCampoProvenienza')">
													<custom-attributes proprieta="sedeAvvocato1"/>
												</button>
											</hlayout>
										</cell>
                                        <cell align="right">
											<label value="@load(vm.etichette['Foro'])"/>
										</cell>
										<cell colspan="3">
											<hlayout valign="middle" hflex="1">
												<textbox value="@bind(vm.datiProvenienza.foroAvvocato1)" hflex="1"/>
												<button image="/images/icon/action/16x16/cancel.png"
														tooltiptext="@load(vm.etichette['Cancella'])" onClick="@command('onCancellaCampoProvenienza')">
													<custom-attributes proprieta="foroAvvocato1"/>
												</button>
											</hlayout>
										</cell>
									</row>
									<zk if="${vm.dettaglio.tipoAttoEnum.isMatrimonio() and (vm.dettaglio.isAvvocati() or vm.dettaglio.isAvvocatiAltro())}">
										<row>
											<cell align="right">
                                                <hlayout>
                                                    <hbox visible="@load(vm.anscOn and (vm.datiProvenienza.ricezioneAttoAvvocati eq 1 or vm.datiProvenienza.ricezioneAttoAvvocati eq 3) )">
                                                        <h:span class="mandatoryLabel" style="top:0.15em;right:0px;">*</h:span>
                                                    </hbox>
                                                    <label value="@load(vm.etichette['Protocollo'])"/>
                                                </hlayout>
											</cell>
											<cell colspan="3">
												<hlayout valign="middle" hflex="1">
													<textbox value="@bind(vm.datiProvenienza.protocolloAvvocato1Accordo)" hflex="1"/>
													<button image="/images/icon/action/16x16/cancel.png"
															tooltiptext="@load(vm.etichette['Cancella'])" onClick="@command('onCancellaCampoProvenienza')">
														<custom-attributes proprieta="protocolloAvvocato1Accordo"/>
													</button>
												</hlayout>
											</cell>
											<cell align="right">
                                                <hlayout>
                                                    <hbox visible="@load(vm.anscOn and (vm.datiProvenienza.ricezioneAttoAvvocati eq 1 or vm.datiProvenienza.ricezioneAttoAvvocati eq 3) )">
                                                        <h:span class="mandatoryLabel" style="top:0.15em;right:0px;">*</h:span>
                                                    </hbox>
                                                    <label value="@load(vm.etichette['Data_Comunicazione'])"/>
                                                </hlayout>
											</cell>
											<cell colspan="3">
												<hlayout valign="middle" hflex="1">
													<datebox format="dd/MM/yyyy" value="@bind(vm.datiProvenienza.dataComunicazioneAvvocato1Accordo)" width="100px"/>
													<button image="/images/icon/action/16x16/cancel.png"
															tooltiptext="@load(vm.etichette['Cancella'])" onClick="@command('onCancellaCampoProvenienza')">
														<custom-attributes proprieta="dataComunicazioneAvvocato1Accordo"/>
													</button>
												</hlayout>
											</cell>
										</row>
									</zk>
								</rows>
							</grid>
						</groupbox>
					</cell>
				</row>
				<row>
					<cell colspan="2">
						<groupbox closable="false">
							<caption label="@load(vm.etichetteCustom['Avvocato2'])"/>
							<grid sclass="form">
								<rows>
									<row>
										<cell align="right" width="120px">
											<zk if="${vm.anscOn and (vm.dettaglio.isAvvocati() or vm.dettaglio.isAvvocatiAltro())}">
												<h:span class="mandatoryLabel">*</h:span>
											</zk>
											<label value="@load(vm.etichette['Cognome'])"/>
										</cell>
										<cell colspan="6">
											<hlayout valign="middle" hflex="1">
												<textbox value="@bind(vm.datiProvenienza.cognomeAvvocato2)" hflex="1" style="@load(vm.minuscole.cognomeAvvocato2?'text-transform:none':'text-transform:uppercase')"
														 onChange="@command('onAggiornaCaseDatiProvenienza')">
													<custom-attributes proprieta="cognomeAvvocato2"/>
												</textbox>
												<button image="/images/icon/action/16x16/cancel.png"
														tooltiptext="@load(vm.etichette['Cancella'])" onClick="@command('onCancellaCampoProvenienza')">
													<custom-attributes proprieta="cognomeAvvocato2"/>
												</button>
											</hlayout>
										</cell>
										<cell align="right" width="145px">
											<hlayout valign="middle" >
												<label value="@load(vm.etichette['Minuscole'])"/>
												<checkbox checked="@bind(vm.minuscole.cognomeAvvocato2)" onCheck="@command('onAggiornaCaseDatiProvenienza')">
													<custom-attributes proprieta="cognomeAvvocato2"/>
												</checkbox>
											</hlayout>
										</cell>
									</row>
									<row>
										<cell align="right">
											<zk if="${vm.anscOn and (vm.dettaglio.isAvvocati() or vm.dettaglio.isAvvocatiAltro())}">
												<h:span class="mandatoryLabel">*</h:span>
											</zk>
											<label value="@load(vm.etichette['Nome'])"/>
										</cell>
										<cell colspan="6">
											<hlayout valign="middle" hflex="1">
												<textbox value="@bind(vm.datiProvenienza.nomeAvvocato2)" hflex="1" style="@load(vm.minuscole.nomeAvvocato2?'text-transform:none':'text-transform:uppercase')"
														 onChange="@command('onAggiornaCaseDatiProvenienza')">
													<custom-attributes proprieta="nomeAvvocato2"/>
												</textbox>
												<button image="/images/icon/action/16x16/cancel.png"
														tooltiptext="@load(vm.etichette['Cancella'])" onClick="@command('onCancellaCampoProvenienza')">
													<custom-attributes proprieta="nomeAvvocato2"/>
												</button>
											</hlayout>
										</cell>
										<cell align="right" width="145px">
											<hlayout valign="middle" >
												<label value="@load(vm.etichette['Minuscole'])"/>
												<checkbox checked="@bind(vm.minuscole.nomeAvvocato2)" onCheck="@command('onAggiornaCaseDatiProvenienza')">
													<custom-attributes proprieta="nomeAvvocato2"/>
												</checkbox>
											</hlayout>
										</cell>
									</row>
									<row>
										<cell align="right">
											<label value="@load(vm.etichette['Sede'])"/>
										</cell>
										<cell colspan="3">
											<hlayout valign="middle" hflex="1">
												<textbox value="@bind(vm.datiProvenienza.sedeAvvocato2)" hflex="1"/>
												<button image="/images/icon/action/16x16/cancel.png"
														tooltiptext="@load(vm.etichette['Cancella'])" onClick="@command('onCancellaCampoProvenienza')">
													<custom-attributes proprieta="sedeAvvocato2"/>
												</button>
											</hlayout>
										</cell>
                                        <cell align="right">
											<label value="@load(vm.etichette['Foro'])"/>
										</cell>
										<cell colspan="3">
											<hlayout valign="middle" hflex="1">
												<textbox value="@bind(vm.datiProvenienza.foroAvvocato2)" hflex="1"/>
												<button image="/images/icon/action/16x16/cancel.png"
														tooltiptext="@load(vm.etichette['Cancella'])" onClick="@command('onCancellaCampoProvenienza')">
													<custom-attributes proprieta="foroAvvocato2"/>
												</button>
											</hlayout>
										</cell>
									</row>
									<zk if="${vm.dettaglio.tipoAttoEnum.isMatrimonio() and (vm.dettaglio.isAvvocati() or vm.dettaglio.isAvvocatiAltro())}">
										<row>
											<cell align="right">
                                                <hlayout>
                                                    <hbox visible="@load(vm.anscOn and (vm.datiProvenienza.ricezioneAttoAvvocati eq 2 or vm.datiProvenienza.ricezioneAttoAvvocati eq 3) )">
                                                        <h:span class="mandatoryLabel" style="top:0.15em;right:0px;">*</h:span>
                                                    </hbox>
                                                    <label value="@load(vm.etichette['Protocollo'])"/>
                                                </hlayout>
											</cell>
											<cell colspan="3">
												<hlayout valign="middle" hflex="1">
													<textbox value="@bind(vm.datiProvenienza.protocolloAvvocato2Accordo)" hflex="1"/>
													<button image="/images/icon/action/16x16/cancel.png"
															tooltiptext="@load(vm.etichette['Cancella'])" onClick="@command('onCancellaCampoProvenienza')">
														<custom-attributes proprieta="protocolloAvvocato2Accordo"/>
													</button>
												</hlayout>
											</cell>
											<cell align="right">
                                                <hlayout>
                                                    <hbox visible="@load(vm.anscOn and (vm.datiProvenienza.ricezioneAttoAvvocati eq 2 or vm.datiProvenienza.ricezioneAttoAvvocati eq 3) )">
                                                        <h:span class="mandatoryLabel" style="top:0.15em;right:0px;">*</h:span>
                                                    </hbox>
                                                    <label value="@load(vm.etichette['Data_Comunicazione'])"/>
                                                </hlayout>
											</cell>
											<cell colspan="3">
												<hlayout valign="middle" hflex="1">
													<datebox format="dd/MM/yyyy" value="@bind(vm.datiProvenienza.dataComunicazioneAvvocato2Accordo)" width="100px"/>
													<button image="/images/icon/action/16x16/cancel.png"
															tooltiptext="@load(vm.etichette['Cancella'])" onClick="@command('onCancellaCampoProvenienza')">
														<custom-attributes proprieta="dataComunicazioneAvvocato2Accordo"/>
													</button>
												</hlayout>
											</cell>
										</row>
									</zk>
								</rows>
							</grid>
						</groupbox>
					</cell>
				</row>
			</rows>
		</grid>
	</groupbox>

</zk>