<?xml version="1.0" encoding="UTF-8"?>
<?taglib uri="http://www.zkoss.org/dsp/web/core" prefix="c"?>

<zk xmlns="http://www.zkoss.org/2005/zul"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.zkoss.org/2005/zul http://www.zkoss.org/2005/zul/zul.xsd">

    <window viewModel="@id('vm') @init('restrict.statocivile.annotazioni.RegistrazioneAnnotazioniViewModel')"
            apply="org.zkoss.bind.BindComposer"
            border="none"
            width="100%" height="@load(vm.wCenterHeight)"
            sizable="false" closable="false">

        <tabbox hflex="1" vflex="1">
            <tabs>
                <tab label="@load(vm.comuneClienteLabel)"		        tooltiptext="@load(vm.comuneClienteLabel)"/>
                <tab label="@load(vm.etichette['Altro_comune'])"		tooltiptext="@load(vm.etichette['Altro_comune'])"/>
            </tabs>
            <tabpanels>
                <tabpanel>
                    <include src="/restrict/statocivile/annotazioni/registrazioneAnnotazioniPerComuneLista.zul" />
                </tabpanel>
                <tabpanel>
                    <include src="/restrict/statocivile/annotazioni/registrazioneAnnotazioniPerAltroComuneLista.zul" />
                 </tabpanel>
             </tabpanels>
         </tabbox>

    </window>

</zk>