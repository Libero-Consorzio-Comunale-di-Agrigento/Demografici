<?xml version="1.0" encoding="UTF-8"?>
<?taglib uri="http://www.zkoss.org/dsp/web/core" prefix="c"?>

<zk xmlns="http://www.zkoss.org/2005/zul"
	xmlns:h="http://www.w3.org/1999/xhtml"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul http://www.zkoss.org/2005/zul/zul.xsd">

	<window viewModel="@id('vm') @init('restrict.statocivile.annotazioni.ArchivioAnnotazioniPerAnnotazioneListaViewModel')"
			apply="org.zkoss.bind.BindComposer"
			border="none"
			width="100%" height="100%"
			sizable="false" closable="false">

		<vlayout vflex="1">

			<hlayout valign="middle">
				<controlBarLista/>

				<label value="@load(vm.formLabel)" sclass="formTitle"/>
			</hlayout>

			<groupbox closable="false">
				<grid sclass="form">
					<rows>
						<row>
							<cell align="right"  width="100px">
								<label value="@load(vm.etichette['Comune'])"/>
							</cell>
							<cell colspan="6">
								<hlayout hflex="1">
									<radiogroup model="@load(vm.tipiComune)" onCheck="@command('onSelectTipoComune')"
												selectedItem="@bind(vm.tipoComune) @converter('it.finmatica.zk.utils.PropertyConverter', property='value')">
										<template name="model">
											<radio label="@load(each.label)" value="@load(each)" style="padding:10px"/>
										</template>
									</radiogroup>
								</hlayout>
							</cell>
							<cell width="40px"/>
						</row>
						<row>
							<cell align="right">
								<label value="@load(vm.etichette['Da'])"/>
							</cell>
							<cell>
								<hlayout valign="middle" hflex="1" spacing="9px">
									<datebox format="dd/MM/yyyy" value="@bind(vm.ricercaAnnotazione.dal)" width="95px"/>
									<button image="/images/icon/action/16x16/cancel.png"
											tooltiptext="@load(vm.etichette['Cancella'])" onClick="@command('onCancellaCampoRicerca')">
										<custom-attributes proprieta="dal"/>
									</button>
								</hlayout>
							</cell>
							<cell align="right">
								<label value="@load(vm.etichette['A'])"/>
							</cell>
							<cell>
								<hlayout valign="middle" hflex="1" spacing="9px">
									<datebox format="dd/MM/yyyy" value="@bind(vm.ricercaAnnotazione.al)" width="95px"/>
									<button image="/images/icon/action/16x16/cancel.png"
											tooltiptext="@load(vm.etichette['Cancella'])" onClick="@command('onCancellaCampoRicerca')">
										<custom-attributes proprieta="al"/>
									</button>
								</hlayout>
							</cell>
							<cell align="right">
								<label value="@load(vm.etichette['Stato'])"/>
							</cell>
							<cell colspan="2">
								<hlayout height="20px">
									<radiogroup model="@load(vm.listaStatoAnnotazione)"
												selectedItem="@bind(vm.ricercaAnnotazione.stato) @converter('it.finmatica.zk.utils.PropertyConverter', property='id')">
										<template name="model">
											<radio label="@load(empty each?vm.etichette['Tutte']:vm.getEtichettaEnum(each))" value="@load(each)" style="padding-left:10px"/>
										</template>
									</radiogroup>
								</hlayout>
							</cell>
							<cell/>
						</row>
						<row>
							<cell align="right">
								<label value="@load(vm.etichette['Formula'])"/>
							</cell>
							<cell colspan="6">
								<hlayout valign="middle" hflex="1">
									<bandboxAnnotazioni width="580px"
														value="@load(vm.ricercaAnnotazione.formulaDfa.descrizioneEstesa)"
														listaTipoAnnotazione="@load(vm.listaTipoAnnotazione)"
														tipoOrdinamentoDefaultValue="@load(vm.tipoOrdinamentoDefaultValue)"
														onSelect="@command('onSelectFormulaAnnotazione')"/>
									<button image="/images/icon/action/16x16/cancel.png"
											tooltiptext="@load(vm.etichette['Cancella'])" onClick="@command('onCancellaCampoRicerca')">
                                            <custom-attributes proprieta="formulaDfa"/>
                                    </button>
								</hlayout>
							</cell>
							<cell>
								<hlayout valign="middle">
									<button image="/images/icon/action/16x16/search.png"
											tooltiptext="@load(vm.etichette['Effettua_Ricerca'])" onClick="@command('onRicerca')"/>
								</hlayout>
							</cell>
						</row>
					</rows>
				</grid>
			</groupbox>

			<totalSizeBlock/>

			<borderlayout vflex="1">
				<center vflex="1">
					<listbox model="@load(vm.lista)" selectedItem="@bind(vm.dettaglio)" vflex="1"
							 emptyMessage="@load(vm.etichette['Nessun_dato_disponibile'])">
						<listhead>
							<listheader label="@load(vm.etichette['Tipo_Atto'])" 			width="80px"/>
							<listheader label="@load(vm.etichette['Formula'])"	/>
							<listheader label="@load(vm.etichette['Nuovo_Ordinamento'])"	width="130px"/>
						</listhead>
						<template name="model" var="item">
							<listitem>
								<listcell label="@load(vm.getEtichettaEnum(item.formulaDfa.getTipoAttoEnum()) )"/>
								<listcell label="@load(item.formulaDfa.descrizioneEstesa)"/>
								<listcell sclass="testo-al-centro">
									<checkbox checked="@load(item.formulaDfa.nuovoOrdinamento)" disabled="true"/>
								</listcell>
							</listitem>
						</template>
					</listbox>
				</center>
				<east size="52%" collapsible="true" open="@load(not empty vm.dettaglio)">
					<vlayout vflex="1" hflex="1" spacing="0px">
						<groupbox mold="3d" closable="false" style="background: #EDEFF5">
							<caption label="@load(vm.etichette['Atti'])" />
							<vlayout>
								<label value="@load(vm.dettaglio.formulaDfa.descrizioneEstesa)"
                                   multiline="true" sclass="grassetto"/>
								<label value="@load(vm.totalSizeDettaglioLabel)"/>
							</vlayout>
						</groupbox>
						<vlayout vflex="1" hflex="1" sclass="scroll" children="@load(vm.dettaglio.annotazioni)" spacing="0px" style="background-color: #EDEFF5;">
							<template name="children" var="s">
								<grid sclass="form">
									<rows>
										<row visible="@load(s.annotazione.isAttoDiAltroComune())">
											<cell visible="@load(s.annotazione.isAttoDiAltroComune())">
												<hlayout valign="middle" spacing="5px"  visible="@load(s.annotazione.isAttoDiAltroComune())">
													<label value="Annotazione su" sclass="grassetto"/>
													<label value="@load(vm.getEtichettaEnum(s.annotazione.getTipoAttoEnum()))" sclass="grassetto"/>
													<label value="di altro comune" sclass="grassetto"/>
												</hlayout>
											</cell>
										</row>
										<row>
											<cell>

												<hlayout spacing="10px" valign="middle">
													<hlayout valign="middle" spacing="8px"  visible="@load(s.annotazione.isAttoDiAltroComune())">
														<label value="@load(vm.etichette['Generata_da'])" sclass="grassetto"/>
														<label value=":" sclass="grassetto"/>
													</hlayout>

													<hlayout valign="middle" spacing="8px">
														<label value="@load(vm.getEtichettaEnum(s.attoAnnotazione.tipoAttoEnum) )" sclass="grassetto" />
														<label value="-" />
														<label value="@load(vm.etichette['Id_Atto_Ansc'])" visible="@load(s.attoAnnotazione.idAttoAnsc ne null)"/>
														<label value="@load(s.attoAnnotazione.idAttoAnsc)" visible="@load(s.attoAnnotazione.idAttoAnsc ne null)" sclass="grassetto" />
														<label value="@load(vm.etichette['Ufficio'])" visible="@load(s.attoAnnotazione.idAttoAnsc eq null)"/>
														<label value="@load(s.attoAnnotazione.ufficio)" visible="@load(s.attoAnnotazione.idAttoAnsc eq null)" sclass="grassetto" />
													</hlayout>

													<hlayout valign="middle" spacing="8px" visible="@load(s.attoAnnotazione.idAttoAnsc eq null)">
														<label value="@load(vm.etichette['Anno'])"/>
														<label value="@load(s.attoAnnotazione.anno)" sclass="grassetto" />
													</hlayout>

													<hlayout valign="middle" spacing="8px" visible="@load(s.attoAnnotazione.idAttoAnsc eq null)">
														<label value="@load(vm.etichette['Numero_Atto'])"/>
														<label value="@load(s.attoAnnotazione.atto)" 		sclass="grassetto"  visible="@load(s.attoAnnotazione.atto gt 0)"/>
														<label value="@load(vm.etichette['Provvisorio'])" 	sclass="grassetto" 	visible="@load(s.attoAnnotazione.atto le 0)"/>
													</hlayout>

													<hlayout valign="middle" spacing="8px" visible="@load(s.attoAnnotazione.idAttoAnsc eq null)">
														<label value="@load(vm.etichette['Parte'])"  						visible="@load(not empty s.attoAnnotazione.parte)"/>
														<label value="@load(s.attoAnnotazione.parte)" sclass="grassetto"   	visible="@load(not empty s.attoAnnotazione.parte)"/>
													</hlayout>

													<hlayout valign="middle" spacing="8px" visible="@load(s.attoAnnotazione.idAttoAnsc eq null)">
														<label value="@load(vm.etichette['Serie'])" 						visible="@load(not empty s.attoAnnotazione.serie)"/>
														<label value="@load(s.attoAnnotazione.serie)" sclass="grassetto" 	visible="@load(not empty s.attoAnnotazione.serie)"/>
													</hlayout>

													<hlayout valign="middle" spacing="8px" sclass="testo-a-dx" hflex="1">
														<button image="/images/icon/action/16x16/text.png"
																sclass="toolbar-mini-button"
																onClick="@command('onPreviewAnnotazione', annotazioneAtto=s.annotazione)"/>
													</hlayout>
												</hlayout>

											</cell>
										</row>
										<row>
											<cell>
												<hlayout spacing="30px">

													<hlayout valign="middle" spacing="8px">
														<label value="@load(vm.etichette['Cognome'])"   visible="@load(not s.attoAnnotazione.fake)"/>
														<label value="@load(s.attoAnnotazione.cognome)" sclass="grassetto"/>
													</hlayout>

													<hlayout valign="middle" spacing="8px">
														<label value="@load(vm.etichette['Nome'])"   visible="@load(not s.attoAnnotazione.fake)"/>
														<label value="@load(s.attoAnnotazione.nome)" sclass="grassetto"/>
													</hlayout>

												</hlayout>
											</cell>
										</row>
										<row visible="@load( ( (s.annotazione.tipoAttoEnum.name() eq 'MAT') or (s.annotazione.tipoAttoEnum.name() eq 'UCI') ) )">
											<cell>
												<hlayout spacing="30px">

													<hlayout valign="middle" spacing="8px">
														<label value="@load(vm.etichette['Cognome'])"/>
														<label value="@load(s.attoAnnotazione.cognome2)" sclass="grassetto"/>

													</hlayout>

													<hlayout valign="middle" spacing="8px">
														<label value="@load(vm.etichette['Nome'])"/>
														<label value="@load(s.attoAnnotazione.nome2)" sclass="grassetto"/>
													</hlayout>

												</hlayout>
											</cell>
										</row>
										<row style="background-color: #556B88;">
											<cell/>
										</row>
									</rows>
								</grid>
							</template>
						</vlayout>
						<popup use="it.finmatica.de4gsdzk.zkutils.CustomPopupAnnotazione" id="ppAnnotazione" width="500px" height="280px">
							<vlayout>
								<hlayout sclass="navigazione" valign="middle">
									<hlayout sclass="afc-control-bar" valign="middle">
										<button image="/images/icon/action/18x18/print.png"
												tooltiptext="@load(vm.etichette['stampa_etichetta_tooltip'])"
												onClick="@command('onStampaEtichetta', annotazioneAtto=vm.ppAnnotazione.annotazioneAtto)" />
									</hlayout>
								</hlayout>
								<grid sclass="form">
									<rows>
										<row>
											<cell align="right" width="120px">
												<label value="@load(vm.etichette['Testo'])"/>
											</cell>
											<cell colspan="3">
												<textbox value="@load(vm.ppAnnotazione.annotazioneAtto.testo)" disabled="true"
														 rows="5" hflex="1"/>
											</cell>
                                        </row>
										<row>
											<cell align="right">
												<label value="@load(vm.etichette['Data_Registrazione'])"/>
											</cell>
											<cell>
												<label value="@load(empty vm.ppAnnotazione.annotazioneAtto.dataRegistrazione? null:(c:formatDate(vm.ppAnnotazione.annotazioneAtto.dataRegistrazione, 'dd/MM/yyyy')))"/>
											</cell>
											<cell align="right">
												<label value="@load(vm.etichette['Sequenza'])"/>
											</cell>
											<cell>
												<label value="@load(vm.ppAnnotazione.annotazioneAtto.sequenza)" />
											</cell>
										</row>
                                        <row>
                                            <cell align="right">
                                                <label value="@load(vm.etichette['Stampa_Su_Estratto'])"/>
                                            </cell>
                                            <cell>
                                                <checkbox checked="@bind(vm.ppAnnotazione.annotazioneAtto.stampaSuEstratto)" disabled="true"/>
                                            </cell>
                                            <cell align="right">
                                                <label value="@load(vm.etichette['Stampa_Su_Atto'])"/>
                                            </cell>
                                            <cell>
                                                <checkbox checked="@bind(vm.ppAnnotazione.annotazioneAtto.stampaSuAtto)"  disabled="true"/>
                                            </cell>
                                        </row>
										<row>
											<cell align="right">
												<label value="@load(vm.etichette['Stato'])"/>
											</cell>
											<cell colspan="3">
												<hlayout height="20px">
													<radiogroup model="@load(vm.listaStatoAnnotazione)"
																selectedItem="@bind(vm.ppAnnotazione.annotazioneAtto.stato) @converter('it.finmatica.zk.utils.PropertyConverter', property='id')">
														<template name="model">
															<radio label="@load(vm.getEtichettaEnum(each))" visible="@load(not empty each)"
																   value="@load(each)" style="padding-left:10px" disabled="true"/>
														</template>
													</radiogroup>
												</hlayout>
											</cell>
										</row>
									</rows>
								</grid>
								<h:div sclass="barraPulsanti">
									<h:div>
										<button label="@load(vm.etichette['Chiudi'])" onClick="@command('onClosePreviewAnnotazione')"/>
									</h:div>
								</h:div>
							</vlayout>
						</popup>
					</vlayout>
				</east>
			</borderlayout>

		</vlayout>

	</window>

</zk>