<?xml version="1.0" encoding="UTF-8"?>
<?taglib uri="http://www.zkoss.org/dsp/web/core" prefix="c"?>

<zk xmlns="http://www.zkoss.org/2005/zul"
	xmlns:h="http://www.w3.org/1999/xhtml"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul http://www.zkoss.org/2005/zul/zul.xsd">

	<window viewModel="@id('vm') @init('restrict.statocivile.annotazioni.ArchivioAnnotazioniPerTipoAttoListaViewModel')"
			apply="org.zkoss.bind.BindComposer"
			border="none"
			width="100%" height="@load(vm.wCenterHeight)"
			sizable="false" closable="false">

		<vlayout vflex="1">

			<hlayout valign="middle">
				<controlBarLista/>

				<label value="@load(vm.formLabel)" sclass="formTitle"/>
			</hlayout>

			<groupbox closable="false">
				<grid sclass="form">
					<rows>
						<row>
							<cell align="right"  width="90px">
								<label value="@load(vm.etichette['Comune'])"/>
							</cell>
							<cell colspan="3">
								<hlayout hflex="1">
									<radiogroup model="@load(vm.tipiComune)" onCheck="@command('onSelectTipoComune')"
												selectedItem="@bind(vm.tipoComune) @converter('it.finmatica.zk.utils.PropertyConverter', property='value')">
										<template name="model">
											<radio label="@load(each.label)" value="@load(each)" style="padding:10px"/>
										</template>
									</radiogroup>
								</hlayout>
							</cell>
							<cell colspan="2" align="right">
								<label value="@load(vm.etichette['Data_Registrazione'])"/>
							</cell>
							<cell colspan="4">
								<hlayout valign="middle">
									<label value="@load(vm.etichette['Da'])"/>
									<datebox format="dd/MM/yyyy" value="@bind(vm.ricercaAnnotazione.dal)" width="95px"/>
									<space/>
									<label value="@load(vm.etichette['A'])"/>
									<datebox format="dd/MM/yyyy" value="@bind(vm.ricercaAnnotazione.al)" width="95px"/>
									<button image="/images/icon/action/16x16/cancel.png"
											tooltiptext="@load(vm.etichette['Cancella'])" onClick="@command('onCancellaCampoRicerca')">
										<custom-attributes proprieta="dal,al"/>
									</button>
								</hlayout>
							</cell>
							<cell width="80px"/>
							<cell colspan="2"/>
							<cell width="40px"/>
						</row>
						<row>
                            <cell align="right">
								<label value="@load(vm.etichette['Tipo_Atto'])"  visible="@load(vm.tipoComune.value eq 1)"/>
								<label value="@load(vm.etichette['Generata_da'])" visible="@load(vm.tipoComune.value eq 0)"/>
							</cell>
							<cell colspan="12">
								<hlayout hflex="1">
									<radiogroup model="@load(vm.listaTipiAtto)" onCheck="@command('onSelectTipoAtto')"
												selectedItem="@bind(vm.tipoAttoEnum)">
										<template name="model">
											<radio label="@load(vm.getEtichettaEnum(each))" value="@load(each)" style="padding:10px"/>
										</template>
									</radiogroup>
								</hlayout>
							</cell>
							<cell width="40px"/>
						</row>
						<row>
							<cell align="right" width="60px">
								<label value="@load(vm.etichette['Ufficio'])"/>
							</cell>
							<cell width="60px">
								<combobox model="@load(vm.listaUffici)" readonly="true" hflex="1"
										  selectedItem="@bind(vm.ricercaAnnotazione.ufficio) @converter('it.finmatica.zk.utils.PropertyConverter', property='id')">
									<template name="model">
										<comboitem label="@load(each)" value="@load(each)"/>
									</template>
								</combobox>
							</cell>
							<cell align="right">
								<label value="@load(vm.etichette['Anno'])"/>
							</cell>
							<cell>
								<intbox value="@bind(vm.ricercaAnnotazione.anno)" onOK="@command('onRicerca')" maxlength="4" hflex="1"/>
							</cell>
							<cell align="right">
								<label value="@load(vm.etichette['Parte'])" />
							</cell>
							<cell>
								<intbox value="@bind(vm.ricercaAnnotazione.parte)" onOK="@command('onRicerca')" width="40px"
								        disabled="@load(not vm.tipoAttoEnum.hasParte())"/>
							</cell>
							<cell align="right">
								<label value="@load(vm.etichette['Serie'])" />
							</cell>
							<cell>
								<textbox value="@bind(vm.ricercaAnnotazione.serie)" style="text-transform:uppercase" onOK="@command('onRicerca')"
								         width="50px" disabled="@load(not vm.tipoAttoEnum.hasSerie())"/>
							</cell>
							<cell align="right">
								<label value="@load(vm.etichette['Numero_Atto'])"/>
							</cell>
							<cell>
								<intbox value="@bind(vm.ricercaAnnotazione.atto)" onOK="@command('onRicerca')" width="70px"/>
							</cell>
							<cell align="right">
								<label value="@load(vm.etichette['Id_Atto_Ansc'])"/>
							</cell>
							<cell colspan="2">
								<hlayout valign="middle" hflex="1">
									<textbox value="@bind(vm.ricercaAnnotazione.idAttoAnsc)" onOK="@command('onRicerca')" width="150px"/>
								</hlayout>
							</cell>
							<cell>
								<hlayout valign="middle">
									<button image="/images/icon/action/16x16/search.png"
											tooltiptext="@load(vm.etichette['Effettua_Ricerca'])" onClick="@command('onRicerca')"/>
								</hlayout>
							</cell>
						</row>
					</rows>
				</grid>

			</groupbox>

			<orderByBlock/>

			<listbox model="@load(vm.lista)" selectedItem="@bind(vm.dettaglio)" vflex="1"
					 emptyMessage="@load(vm.etichette['Nessun_dato_disponibile'])">
				<listhead>
					<listheader label="@load(vm.etichette['Tipo_Atto'])" width="80px"/>
					<listheader label="@load(vm.etichette['Estremi_Atto'])"/>
					<listheader label="@load(vm.etichette['Formula'])"/>
					<listheader label="" width="60px"/>
				</listhead>
				<template name="model" var="item">
					<listitem>
						<listcell label="@load(vm.getEtichettaEnum(item.getTipoAttoEnum()))"/>
						<listcell label="@load( c:cat5(vm.getEstremiAtto(item),
						                        c:cat4(' - ', vm.etichette['Anno'],': ', item.anno),
						                        c:cat4(' ', vm.etichette['Numero_Atto'],': ', item.atto),
						                        c:cat3((empty item.parte?'':' / '), item.parte, (empty item.serie?'':item.serie)),
						                        (empty item.idAttoAnsc?'': c:cat4(' - ', vm.etichette['Id_Atto_Ansc'],': ', item.idAttoAnsc)) ) )"/>
						<listcell label="@load(item.formulaDfa.descrizioneEstesa)"/>
						<listcell>
							<button image="/images/icon/action/22x22/text.png"
									visible="@load(not empty item.id)"
									onClick="@command('onPreviewAnnotazione', annotazioneAtto=item)"/>
						</listcell>
					</listitem>
				</template>
			</listbox>
			<popup use="it.finmatica.de4gsdzk.zkutils.CustomPopupAnnotazione" id="ppAnnotazione" width="500px" height="280px">
				<vlayout>
					<hlayout sclass="navigazione" valign="middle">
						<hlayout sclass="afc-control-bar" valign="middle">
							<button image="/images/icon/action/18x18/print.png"
									tooltiptext="@load(vm.etichette['stampa_etichetta_tooltip'])"
									onClick="@command('onStampaEtichetta', annotazioneAtto=vm.ppAnnotazione.annotazioneAtto)" />
						</hlayout>
					</hlayout>
					<grid sclass="form">
						<rows>
							<row>
								<cell align="right" width="120px">
									<label value="@load(vm.etichette['Testo'])"/>
								</cell>
								<cell colspan="3">
									<textbox value="@load(vm.ppAnnotazione.annotazioneAtto.testo)" disabled="true"
											 rows="5" hflex="1"/>
								</cell>
							</row>
							<row>
								<cell align="right">
									<label value="@load(vm.etichette['Data_Registrazione'])"/>
								</cell>
								<cell>
									<label value="@load(empty vm.ppAnnotazione.annotazioneAtto.dataRegistrazione? null:(c:formatDate(vm.ppAnnotazione.annotazioneAtto.dataRegistrazione, 'dd/MM/yyyy')))"/>
								</cell>
								<cell align="right">
									<label value="@load(vm.etichette['Sequenza'])"/>
								</cell>
								<cell>
									<label value="@load(vm.ppAnnotazione.annotazioneAtto.sequenza)" />
								</cell>
							</row>
							<row>
								<cell align="right">
									<label value="@load(vm.etichette['Stampa_Su_Estratto'])"/>
								</cell>
								<cell>
									<checkbox checked="@bind(vm.ppAnnotazione.annotazioneAtto.stampaSuEstratto)" disabled="true"/>
								</cell>
								<cell align="right">
									<label value="@load(vm.etichette['Stampa_Su_Atto'])"/>
								</cell>
								<cell>
									<checkbox checked="@bind(vm.ppAnnotazione.annotazioneAtto.stampaSuAtto)"  disabled="true"/>
								</cell>
							</row>
							<row>
								<cell align="right">
									<label value="@load(vm.etichette['Stato'])"/>
								</cell>
								<cell colspan="3">
									<hlayout height="20px">
										<radiogroup model="@load(vm.listaStatoAnnotazione)"
													selectedItem="@bind(vm.ppAnnotazione.annotazioneAtto.stato) @converter('it.finmatica.zk.utils.PropertyConverter', property='id')">
											<template name="model">
												<radio label="@load(vm.getEtichettaEnum(each))" visible="@load(not empty each)"
													   value="@load(each)" style="padding-left:10px" disabled="true"/>
											</template>
										</radiogroup>
									</hlayout>
								</cell>
							</row>
						</rows>
					</grid>
					<h:div sclass="barraPulsanti">
						<h:div>
							<button label="@load(vm.etichette['Chiudi'])" onClick="@command('onClosePreviewAnnotazione')"/>
						</h:div>
					</h:div>
				</vlayout>
			</popup>

		</vlayout>

	</window>

</zk>
