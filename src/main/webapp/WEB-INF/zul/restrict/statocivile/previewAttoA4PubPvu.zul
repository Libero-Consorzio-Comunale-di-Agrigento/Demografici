<?xml version="1.0" encoding="UTF-8"?>
<?taglib uri="http://www.zkoss.org/dsp/web/core" prefix="c"?>

<zk xmlns="http://www.zkoss.org/2005/zul"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul http://www.zkoss.org/2005/zul/zul.xsd">

	<window viewModel="@id('vm') @init('restrict.statocivile.PreviewAttoA4ViewModel')"
			apply="org.zkoss.bind.BindComposer"
			border="none"
			width="100%" height="100%"
			sizable="false" closable="false">

		<hlayout>
			<controlBarDettaglio/>

			<controlBarTesto/>
		</hlayout>

		<vlayout sclass="scroll" vflex="1">
			<hlayout sclass="testo-al-centro" hflex="1">
				<vbox sclass="bordered-container" vflex="1">

					<grid sclass="form" width="700px">
						<rows>
							<row>
								<cell>
									<hlayout sclass="testo-al-centro" hflex="1">
										<label value="@load(vm.descrizioneAtto)" sclass="testoAttoA4"/>
									</hlayout>
								</cell>
							</row>
							<row>
								<cell colspan="1">
									<templateTestoA4/>
								</cell>
							</row>
						</rows>
					</grid>
				</vbox>
			</hlayout>
		</vlayout>

	</window>

</zk>