<?xml version="1.0" encoding="UTF-8"?>
<?taglib uri="http://www.zkoss.org/dsp/web/core" prefix="c"?>
<?component name="templateSezioneDatiIntestatarioCittadinanzaDettaglio" macroURI="/restrict/statocivile/cittadinanza/templateSezioneDatiIntestatarioCittadinanzaDettaglio.zul" inline="true"?>
<?component name="templateSezioneDatiCittadinanzaDettaglio" macroURI="/restrict/statocivile/cittadinanza/templateSezioneDatiCittadinanzaDettaglio.zul" inline="true"?>
<?component name="templateSezioneRedazioneCittadinanzaDettaglio" macroURI="/restrict/statocivile/cittadinanza/templateSezioneRedazioneCittadinanzaDettaglio.zul" inline="true"?>
<?component name="templateSezioneComposizioneCittadinanzaDettaglio" macroURI="/restrict/statocivile/cittadinanza/templateSezioneComposizioneCittadinanzaDettaglio.zul" inline="true"?>

<zk xmlns="http://www.zkoss.org/2005/zul"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul http://www.zkoss.org/2005/zul/zul.xsd">

	<window viewModel="@id('vm') @init('restrict.statocivile.cittadinanza.CittadinanzaPregressoDettaglioViewModel')"
			apply="org.zkoss.bind.BindComposer"
			border="none"
			width="100%" height="100%"
			sizable="false" closable="false">

			<hlayout valign="middle">
				<controlBarDettaglio/>

				<controlBarAtto/>

				<label value="@load(vm.formLabel)" sclass="@load(vm.attoSclass)"/>

				<estremiAttoFormLabel/>
			</hlayout>

			<vlayout vflex="1" width="100%" sclass="scroll">

				<templateSezioneInformazioniNasMatDecUciCitPregressoDettaglio/>

				<templateSezioneDatiIntestatarioCittadinanzaDettaglio/>

				<templateSezioneDatiCittadinanzaDettaglio/>

				<vlayout hflex="1" visible="@load(vm.composizioneTestoAttiva and (vm.statoFrammenti lt 2) and (vm.dettaglio.natura ne 'N'))">
					<templateSezioneAccessoComposizionePregressoDettaglio/>
				</vlayout>

				<vlayout hflex="1" visible="@load(vm.composizioneTestoAttiva and (vm.statoFrammenti eq 2) and (vm.dettaglio.natura ne 'N'))">
					<templateSezioneRedazioneCittadinanzaDettaglio/>
					<templateSezioneComposizioneCittadinanzaDettaglio/>
				</vlayout>

				<templateIdDomain/>

			</vlayout>

	</window>

</zk>