<?xml version="1.0" encoding="UTF-8"?>
<?taglib uri="http://www.zkoss.org/dsp/web/core" prefix="c"?>
<?component name="templateListaMotivoRichiesta" macroURI="/restrict/statocivile/templateListaMotivoRichiesta.zul" inline="true"?>

<zk xmlns="http://www.zkoss.org/2005/zul"
	xmlns:h="http://www.w3.org/1999/xhtml"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul http://www.zkoss.org/2005/zul/zul.xsd">

	<window viewModel="@id('vm') @init('restrict.statocivile.cittadinanza.MotivoCittadinanzaSelectViewModel')"
			apply="org.zkoss.bind.BindComposer"
			border="none"
			width="600px" height="500px"
			title="@load(vm.etichette['Seleziona'])"
			sizable="false" closable="false">

		<vlayout vflex="1">

			<controlBarMotivoRichiesta/>

			<totalSizeBlock/>

			<templateListaMotivoRichiesta/>

		</vlayout>

		<h:div sclass="barraPulsanti">
			<h:div>
				<button label="@load(vm.etichette['Seleziona'])"		onClick="@command('onSeleziona')" 	image="/images/icon/action/16x16/ok.png" />
				<button label="@load(vm.etichette['Chiudi'])"			onClick="@command('onChiudi')" 		image="/images/icon/action/16x16/close.png"/>
			</h:div>
		</h:div>


	</window>

</zk>