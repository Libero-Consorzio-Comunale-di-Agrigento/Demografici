<?xml version="1.0" encoding="UTF-8"?>
<?taglib uri="http://www.zkoss.org/dsp/web/core" prefix="c"?>
<?component name="templateRowMotivoRichiesta" macroURI="/restrict/statocivile/templateRowMotivoRichiesta.zul" inline="true"?>

<zk xmlns="http://www.zkoss.org/2005/zul"
	xmlns:h="http://www.w3.org/1999/xhtml"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul http://www.zkoss.org/2005/zul/zul.xsd">

	<!-- DATI ATTO -->
	<groupbox mold="3d" hflex="1" open="false">
		<caption sclass="mainCaption">
			<div>
				<updownbutton onClick="@command(self.openClose())" sclass="captionButton"/>
				<label value="@load(vm.etichette['SEZIONE_DATI_ATTO'])" sclass="captionLabel"/>
			</div>
		</caption>
		<grid sclass="form">
			<rows>
				<zk if="${vm.anscOn and vm.dettaglio.isAcquisto()}">
					<templateRowMotivoRichiesta colspans="1,4,1,4"/>
				</zk>
				<row>
					<cell align="right" width="135px">
                        <hlayout>
                            <hbox visible="@load(vm.dettaglio.isTrascrizione())">
                                <h:span class="mandatoryLabel" style="top:0.15em;right:0px;">*</h:span>
                            </hbox>
                            <label value="@load(vm.etichette['Data_Richiesta'])"/>
                        </hlayout>
					</cell>
					<cell colspan="4">
						<hlayout valign="middle" hflex="1" spacing="9px">
							<datebox format="dd/MM/yyyy" value="@bind(vm.dettaglio.dataRichiesta)" width="95px"/>
							<button image="/images/icon/action/16x16/cancel.png"
									tooltiptext="@load(vm.etichette['Cancella'])" onClick="@command('onCancellaCampoAtto')">
								<custom-attributes proprieta="dataRichiesta"/>
							</button>
						</hlayout>
					</cell>
					<cell align="right" width="120px">
					    <zk if="${vm.anscOn}">
                            <hlayout visible="@load(vm.dettaglio.motivoCittadinanza.flagEnteEstero)">
                                <hbox>
                                    <h:span class="mandatoryLabel" style="top:0.15em;right:0px;">*</h:span>
                                </hbox>
                                <label value="@load(vm.etichette['Data_Accertamento'])"/>
                            </hlayout>
                            <hlayout visible="@load(vm.dettaglio.motivoCittadinanza.flagAutorita and not vm.dettaglio.motivoCittadinanza.flagConsolato)">
                                <hbox>
                                    <h:span class="mandatoryLabel" style="top:0.15em;right:0px;">*</h:span>
                                </hbox>
                                <label value="@load(vm.etichette['Tipo_richiesta'])"/>
                            </hlayout>
                        </zk>
					</cell>
					<cell colspan="4">
					    <zk if="${vm.anscOn}">
                            <hlayout valign="middle" hflex="1" visible="@load(vm.dettaglio.motivoCittadinanza.flagEnteEstero)">
                                <datebox format="dd/MM/yyyy" value="@bind(vm.dettaglio.dataAccertamento)" width="95px"/>
                                <button image="/images/icon/action/16x16/cancel.png"
                                        tooltiptext="@load(vm.etichette['Cancella'])" onClick="@command('onCancellaCampoAtto')">
                                    <custom-attributes proprieta="dataAccertamento"/>
                                </button>
                            </hlayout>
                            <hlayout visible="@load(vm.dettaglio.motivoCittadinanza.flagAutorita and not vm.dettaglio.motivoCittadinanza.flagConsolato)">
                                <combobox model="@load(vm.listaTipoRichiestaTrascrizione)" readonly="true" width="200px"
                                          selectedItem="@bind(vm.datiProvenienza.tipoRichiestaTrascrizione) @converter('it.finmatica.zk.utils.PropertyConverter', property='id')">
                                    <template name="model">
                                        <comboitem label="@load(empty each?'- -':vm.getEtichettaEnum(each))" value="@load(each)"/>
                                    </template>
                                </combobox>
                            </hlayout>
						</zk>
					</cell>
				</row>
				<row>
					<cell align="right">
						<customLabel mandatory="@load((vm.anscOn and vm.dettaglio.isEstremiGiuramentoMandatory()))"
									 value="@load(vm.etichette['Data_Giuramento'])"/>
					</cell>
					<cell colspan="4">
						<hlayout valign="middle" hflex="1" spacing="9px">
							<datebox format="dd/MM/yyyy" value="@bind(vm.dettaglio.dataGiuramento)" onChange="@command('onChangeDataGiuramento')" width="95px"/>
							<button image="/images/icon/action/16x16/cancel.png"
									tooltiptext="@load(vm.etichette['Cancella'])" onClick="@command('onCancellaCampoAtto')">
								<custom-attributes proprieta="dataGiuramento"/>
							</button>
                            <!-- nelle cittadinanza non ha senso gestire l'imprecisato sulla data di giuramento
                            <label value="@load(vm.etichette['Imprecisati'])"/>

                            <hlayout valign="middle" hflex="1" spacing="6px">
                                <label value="@load(vm.etichette['Giorno'])"/>
                                <checkbox checked="@bind(vm.dettaglio.giornoGiuramentoImprecisato)"/>
                                <label value="@load(vm.etichette['Mese'])"/>
                                <checkbox checked="@bind(vm.dettaglio.meseGiuramentoImprecisato)"/>
                                <label value="@load(vm.etichette['Anno'])"/>
                                <checkbox checked="@bind(vm.dettaglio.annoGiuramentoImprecisato)"/>
                            </hlayout> -->
						</hlayout>
					</cell>
                    <cell align="right">
						<label value="@load(vm.etichette['Data_Decorrenza'])"/>
                    </cell>
                    <cell colspan="4">
                        <hlayout valign="middle" hflex="1" spacing="9px">
                            <datebox format="dd/MM/yyyy" value="@bind(vm.dettaglio.dataDecorrenza)" width="95px"/>
                            <button image="/images/icon/action/16x16/cancel.png"
                                    tooltiptext="@load(vm.etichette['Cancella'])" onClick="@command('onCancellaCampoAtto')">
                                <custom-attributes proprieta="dataDecorrenza"/>
                            </button>
                        </hlayout>
                    </cell>
				</row>

				<row visible="@load(vm.anscOn and vm.dettaglio.isEstremiGiuramentoMandatory())">
					<cell align="right">
						<label value="@load(vm.etichette['Estremi_Collegato'])"/>
					</cell>
					<cell colspan="9">
						<grid>
							<rows>
								<row>
									<cell align="right" width="100px">
										<customLabel
												mandatory="true"
												value="@load(vm.etichette['Numero_Atto'])"/>
									</cell>
									<cell>
										<intbox value="@bind(vm.datiProvenienza.attoGiuramento)" hflex="1"/>
									</cell>
									<cell align="right" width="90px">
										<label value="@load(vm.etichette['Ufficio'])"/>
									</cell>
									<cell>
										<intbox value="@bind(vm.datiProvenienza.ufficioGiuramento)" maxlength="2"
												width="45px"/>
									</cell>
									<cell align="right" width="90px">
										<customLabel
												mandatory="true"
												value="@load(vm.etichette['Anno'])"/>
									</cell>
									<cell>
										<intbox value="@bind(vm.datiProvenienza.annoGiuramento)" maxlength="4"
												width="45px"/>
									</cell>
									<cell align="right" width="75px">
										<label value="@load(vm.etichette['Id_Atto_Ansc'])" visible="@load(vm.anscOn)"/>
									</cell>
									<cell>
										<textbox value="@bind(vm.datiProvenienza.idAttoAnscGiuramento)" hflex="1"
												 visible="@load(vm.anscOn)" disabled="@load(not vm.anscOn)"/>
									</cell>
								</row>
								<row>
									<cell align="right">
										<customLabel mandatory="true" value="@load(vm.etichette['Comune_Atto'])"/>
									</cell>
									<cell colspan="5">
										<hlayout valign="middle" hflex="1">
											<bandboxComuni hflex="1"
														   value="@bind(vm.datiProvenienza.comuneGiuramento.descrizione)"
														   onSelect="@command('onSelectComune', campoRiferimento='CA_GIU')"/>
											<button image="/images/icon/action/16x16/cancel.png"
													tooltiptext="@load(vm.etichette['Cancella'])"
													onClick="@command('onCancellaComune', campoRiferimento='CA_GIU')"/>
										</hlayout>
									</cell>
									<cell>
										<textbox value="@load(vm.datiProvenienza.comuneGiuramento.siglaProvincia)"
												 hflex="1" readonly="true"/>
									</cell>
									<cell/>
								</row>
							</rows>
						</grid>
					</cell>
				</row>

				<row>
					<cell align="right">
						<label value="@load(vm.etichette['Note'])"/>
					</cell>
					<cell colspan="9">
						<textbox value="@bind(vm.dettaglio.note)" hflex="1" rows="4"/>
					</cell>
				</row>
			</rows>
		</grid>
	</groupbox>

</zk>