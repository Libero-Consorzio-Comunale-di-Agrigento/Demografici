<?xml version="1.0" encoding="UTF-8"?>
<?taglib uri="http://www.zkoss.org/dsp/web/core" prefix="c"?>
<?component name="templateRowEstremiAttoNascita1NasMorCit" macroURI="/restrict/statocivile/templateRowEstremiAttoNascita1NasMorCit.zul" inline="true"?>

<zk xmlns="http://www.zkoss.org/2005/zul"
	xmlns:h="http://www.w3.org/1999/xhtml"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul http://www.zkoss.org/2005/zul/zul.xsd">

	<!-- DATI RICHIEDENTE CITTADINANZA -->
	<groupbox mold="3d" hflex="1" open="false">
		<caption sclass="mainCaption">
			<div>
				<updownbutton onClick="@command(self.openClose())" sclass="captionButton"/>
				<label value="@load(vm.etichette['SEZIONE_DATI_INTESTATARIO'])" sclass="captionLabel"/>
			</div>
		</caption>
		<groupbox closable="false" visible="@load(vm.tipoOperazione.isInsert() and vm.dettaglio.isCodRec3() and (vm.dettaglio.isAcquisto() or vm.dettaglio.isAttestazioneSindacoDiciottenne() ) )">
			<grid sclass="form">
				<rows>
					<row visible="@load(vm.tipoOperazione.isInsert() and vm.dettaglio.isCodRec3() and (vm.dettaglio.isAcquisto() or vm.dettaglio.isAttestazioneSindacoDiciottenne() ) )">
						<cell colspan="11">
							<hlayout hflex="1" sclass="testo-a-sx">
								<button label="@load(vm.dettaglio.isAcquisto()?vm.etichette['Recupero_da_giuramento']:vm.etichette['Recupero_da_richiesta'])"
										height="35px" width="150px"
										style="font-size:12px; font-weight: bold;"
										disabled="@load(not (vm.tipoOperazione.isInsert() and vm.dettaglio.isCodRec3() and (vm.dettaglio.isAcquisto() or vm.dettaglio.isAttestazioneSindacoDiciottenne() )) )"
										onClick="@command('onSelectRecuperoDaGiuramentoORichiesta')" />
							</hlayout>
						</cell>
					</row>
				</rows>
			</grid>
		</groupbox>
		<grid sclass="form">
			<rows>
				<row>
					<cell align="right" width="135px">
						<h:span class="mandatoryLabel">*</h:span><label value="@load(vm.etichette['Cognome'])" tooltiptext="@load(empty vm.anagrafe.anagrafe1.matricola?vm.etichette['Cognome']: vm.anagrafe.anagrafe1.matricola)"/>
					</cell>
					<cell colspan="5">
						<hlayout valign="middle" hflex="1">
							<textbox value="@bind(vm.dettaglio.cognome)" hflex="1" onChange="@command('onAggiornaCaseAndAna', campoAnagrafe='COGNOME_SOGGETTO_1')"
									 style="@load(vm.minuscole.cognome1?'text-transform:none':'text-transform:uppercase')">
								<custom-attributes proprieta="cognome1"/>
							</textbox>
							<button image="/images/icon/action/16x16/cancel.png"
									tooltiptext="@load(vm.etichette['Cancella'])" onClick="@command('onCancellaCampoAtto', campoAnagrafe='COGNOME_SOGGETTO_1')">
								<custom-attributes proprieta="cognome1"/>
							</button>
						</hlayout>
					</cell>
					<cell align="right" width="90px">
						<hlayout valign="middle" >
							<label value="@load(vm.etichette['Minuscole'])"/>
							<checkbox checked="@bind(vm.minuscole.cognome1)" onCheck="@command('onAggiornaCase')" >
								<custom-attributes proprieta="cognome1"/>
							</checkbox>
						</hlayout>
					</cell>
					<cell width="100px"/>
					<cell align="right">
						<hlayout valign="middle">
							<label value="@load(vm.etichette['Senza_Cognome'])"/>
							<checkbox checked="@bind(vm.dettaglio.senzaCognome)"/>
						</hlayout>
					</cell>
				</row>
				<row>
					<cell align="right">
						<h:span class="mandatoryLabel">*</h:span><label value="@load(vm.etichette['Nome'])"/>
					</cell>
					<cell colspan="5">
						<hlayout valign="middle" hflex="1">
							<textbox value="@bind(vm.dettaglio.nome)" hflex="1" onChange="@command('onAggiornaCaseAndAna', campoAnagrafe='NOME_SOGGETTO_1')"
									 style="@load(vm.minuscole.nome1?'text-transform:none':'text-transform:uppercase')">
								<custom-attributes proprieta="nome1"/>
							</textbox>
							<button image="/images/icon/action/16x16/search.png"
									tooltiptext="@load(vm.etichette['Seleziona'])" onClick="@command('onCaricaSoggetti', tipoSoggetto='SOGGETTO_1')"
							/>
							<button image="/images/icon/action/16x16/cancel.png"
									tooltiptext="@load(vm.etichette['Cancella'])" onClick="@command('onCancellaCampoAtto', campoAnagrafe='NOME_SOGGETTO_1')">
								<custom-attributes proprieta="nome1"/>
							</button>
						</hlayout>
					</cell>
					<cell align="right">
						<hlayout valign="middle" >
							<label value="@load(vm.etichette['Minuscole'])"/>
							<checkbox checked="@bind(vm.minuscole.nome1)" onCheck="@command('onAggiornaCase')" >
								<custom-attributes proprieta="nome1"/>
							</checkbox>
						</hlayout>
					</cell>
					<cell/>
					<cell align="right">
						<hlayout valign="middle" >
							<label value="@load(vm.etichette['Senza_Nome'])"/>
							<checkbox checked="@bind(vm.dettaglio.senzaNome)" />
						</hlayout>
					</cell>
				</row>
				<row>
					<cell align="right">
						<h:span class="mandatoryLabel">*</h:span><label value="@load(vm.etichette['Sesso'])"/>
					</cell>
					<cell>
						<combobox model="@load(vm.listaSesso)" readonly="true" width="115px" onChange="@command('onSelectSesso', campoAnagrafe='SESSO_SOGGETTO_1')"
								  selectedItem="@bind(vm.dettaglio.sesso) @converter('it.finmatica.zk.utils.PropertyConverter', property='id')">
							<template name="model">
								<comboitem label="@load(empty each?'- -':vm.getEtichettaEnum(each))" value="@load(each)"/>
							</template>
						</combobox>
					</cell>
					<cell colspan="2">
						<hlayout valign="middle" hflex="1" spacing="9px">
							<label value="@load(vm.etichette['Data_Nascita'])"/>
							<datebox format="dd/MM/yyyy" value="@bind(vm.dettaglio.dataNascita)"
									 onChange="@command('onAggiornaDataRiferimentoComuneAttoNascitaAndAnaSoggetto1', campoAnagrafe='DATA_NASCITA_1')" width="100px"/>

							<button image="/images/icon/action/16x16/cancel.png"
									tooltiptext="@load(vm.etichette['Cancella'])" onClick="@command('onCancellaCampoAttoSoggetto1', campoAnagrafe='DATA_NASCITA_1')">
								<custom-attributes proprieta="dataNascita"/>
							</button>
						</hlayout>
					</cell>
					<cell colspan="5">
						<hlayout valign="middle" hflex="1" spacing="9px">
							<label value="@load(vm.etichette['Imprecisati'])"/>

							<hlayout valign="middle" hflex="1" spacing="6px">
								<label value="@load(vm.etichette['Giorno'])"/>
								<checkbox checked="@bind(vm.dettaglio.giornoNascitaImprecisato)"/>
								<label value="@load(vm.etichette['Mese'])"/>
								<checkbox checked="@bind(vm.dettaglio.meseNascitaImprecisato)"/>
								<label value="@load(vm.etichette['Anno'])"/>
								<checkbox checked="@bind(vm.dettaglio.annoNascitaImprecisato)"/>
							</hlayout>
						</hlayout>
					</cell>
				</row>
				<row>
					<cell align="right">
						<label value="@load(vm.etichette['Comune_Nascita'])"/>
					</cell>
					<cell colspan="5">
						<hlayout valign="middle" hflex="1">
							<bandboxComuni hflex="1"
										   value="@load(vm.dettaglio.descrizioneComuneNascita)"
										   dataRiferimento="@load(vm.dettaglio.dataNascita)"
										   onSelect="@command('onSelectComune', campoRiferimento='CN_SOGG_1')"/>
							<button image="/images/icon/action/16x16/cancel.png"
									tooltiptext="@load(vm.etichette['Cancella'])" onClick="@command('onCancellaComune', campoRiferimento='CN_SOGG_1')"
							/>
						</hlayout>
					</cell>
					<cell>
						<textbox value="@load(vm.dettaglio.siglaProvinciaNascita)" hflex="1" readonly="true"/>
					</cell>
					<cell align="right">
						<label value="@load(vm.etichette['Stato_Civile'])"/>
					</cell>
					<cell>
						<label value="@load(vm.anagrafe.anagrafe1.descrizioneStatoCivile)"/>
					</cell>
				</row>
				<row>
					<cell align="right">
						<label value="@load(vm.etichette['Codice_Fiscale'])"/>
					</cell>
					<cell colspan="5">
						<hlayout valign="middle" hflex="1">
							<textbox value="@bind(vm.dettaglio.codiceFiscale)" hflex="1" style="text-transform:uppercase"/>
							<button image="/images/icon/action/16x16/calculator.png"
									tooltiptext="@load(vm.etichette['Calcolo_Codice_Fiscale'])" onClick="@command('onCalcolaCf', tipoSoggetto='SOGGETTO_1')" />
							<button image="/images/icon/action/16x16/cancel.png"
									tooltiptext="@load(vm.etichette['Cancella'])" onClick="@command('onCancellaCampoAtto')">
								<custom-attributes proprieta="codiceFiscale"/>
							</button>
						</hlayout>
					</cell>
					<cell colspan="1">
						<hlayout valign="middle" hflex="1">
							<label  value="@load(vm.etichette['Non_Validato']))"/>
							<checkbox checked="@bind(vm.dettaglio.cfCalcolato1)" />
						</hlayout>
					</cell>
					<cell align="right">
						<label value="@load(vm.etichette['Stato_Anagrafico'])"/>
					</cell>
					<cell>
						<label value="@load(vm.anagrafe.anagrafe1.descrizioneStatoAnagrafico)"/>
					</cell>
				</row>
                <row>
                    <cell align="right">
                        <h:span class="mandatoryLabel">*</h:span><label value="@load(vm.etichette['Comune_Residenza'])"/>
                    </cell>
                    <cell colspan="5">
                        <hlayout valign="middle" hflex="1">
                            <bandboxComuni hflex="1"
                                           value="@load(vm.dettaglio.descrizioneComuneResidenza)"
                                           onSelect="@command('onSelectComune', campoRiferimento='CR_SOGG_1')"/>
                            <button image="/images/icon/action/16x16/cancel.png"
                                    tooltiptext="@load(vm.etichette['Cancella'])" onClick="@command('onCancellaComune', campoRiferimento='CR_SOGG_1')"
                            />
                        </hlayout>
                    </cell>
                    <cell>
                        <textbox value="@load(vm.dettaglio.siglaProvinciaResidenza)" hflex="1" readonly="true"/>
                    </cell>
					<cell align="right">
						<customLabel mandatory="@load(vm.anscOn)" value="@load(vm.etichette['Nazionalita'])"/>
					</cell>
					<cell>
						<combobox model="@load(vm.listaNazionalita)" readonly="false" hflex="1"
								  selectedItem="@bind(vm.dettaglio.nazionalita1) @converter('it.finmatica.zk.utils.PropertyConverter', property='id')">
							<template name="model">
								<comboitem label="@load(empty each?'- -':each.descrizione)" tooltiptext="@load(each.descrizione)" value="@load(each)"/>
							</template>
						</combobox>
					</cell>
                </row>

				<row>
					<cell align="right">
						<label value="@load(vm.etichette['Estremi_Atto_Nascita'])"/>
					</cell>
					<cell colspan="8">
						<grid hflex="1">
							<rows>
								<row>
									<cell>
										<grid>
											<rows>

												<templateRowEstremiAttoNascita1NasMorCit/>

												<row visible="@load( ( (vm.dettaglio.natura eq 'A') or (vm.dettaglio.natura eq 'P') ) and vm.dettaglio.isCodRec3() and (c:length(vm.listaAnnotazioniNascita) gt 1) )">
													<cell align="right">
														<label value="@load(vm.etichette['Annotazione'])"/>
													</cell>
													<cell colspan="11">
														<hlayout valign="middle" hflex="1">
															<combobox model="@load(vm.listaAnnotazioniNascita)" readonly="false" hflex="1" onSelect="@command('onSelectFormulaAnnotazione')"
																	  selectedItem="@bind(vm.datiProvenienza.formulaDfaAnnotazioneNascita1) @converter('it.finmatica.zk.utils.PropertyConverter', property='id')">
																<template name="model">
																	<comboitem label="@load(empty each?'- -':each.descrizioneEstesa)" value="@load(each.id)"/>
																</template>
																<custom-attributes proprieta="formulaDfaAnnotazioneNascita1" tipoFormula="NAS_1"/>
															</combobox>
															<button image="/images/icon/action/16x16/cancel.png"
																	tooltiptext="@load(vm.etichette['Cancella'])" onClick="@command('onCancellaFormulaAnnotazione')">
																<custom-attributes proprieta="formulaDfaAnnotazioneNascita1" tipoFormula="NAS_1"/>
															</button>
														</hlayout>
													</cell>
												</row>
											</rows>
										</grid>
									</cell>
									<cell width="42px">
										<button image="/images/icon/action/16x16/grid.png"
												tooltiptext="@load(vm.etichette['Recupera_Estremi_Atto_Nascita'])" onClick="@command('onRecuperaEstremiSoggetto1DaAttoDiNascita')"/>
									</cell>
								</row>
							</rows>
						</grid>
					</cell>
				</row>

			</rows>
		</grid>

	</groupbox>

</zk>