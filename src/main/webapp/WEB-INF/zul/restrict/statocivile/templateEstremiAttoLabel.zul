    <zk if="${vm.tipoAttoEnum.isSingoloSoggetto()}">
        <label value="@load(vm.atto.getNominativo())" sclass="grassetto"/>
    </zk>

    <zk if="${vm.tipoAttoEnum.isDoppioSoggetto()}">
        <label value="@load(vm.atto.getNominativo1())" sclass="grassetto"/>
        <label value=" - "/>
        <label value="@load(vm.atto.getNominativo2())" sclass="grassetto"/>
    </zk>

</zk>