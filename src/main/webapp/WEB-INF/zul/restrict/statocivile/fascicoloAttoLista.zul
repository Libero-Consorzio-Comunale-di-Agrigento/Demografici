<?xml version="1.0" encoding="UTF-8"?>
<?taglib uri="http://www.zkoss.org/dsp/web/core" prefix="c"?>

<zk xmlns="http://www.zkoss.org/2005/zul"
	xmlns:h="http://www.w3.org/1999/xhtml"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul http://www.zkoss.org/2005/zul/zul.xsd">

	<window viewModel="@id('vm') @init('restrict.statocivile.FascicoloAttoListaViewModel')"
			apply="org.zkoss.bind.BindComposer"
			border="none"
			width="100%" height="100%"
			sizable="false" closable="false">

		<hlayout valign="middle">
			<controlBarFascicolo/>

			<label value="@load(vm.formLabel)" sclass="formTitle"/>

			<estremiAttoFormLabel/>

		</hlayout>

		<vlayout vflex="1">

			<groupbox mold="3d" closable="false">
				<caption label="@load(vm.etichette['SEZIONE_DATI_ATTO'])"/>
				<grid sclass="form">
					<rows>
						<row>
							<cell>
                                <templateEstremiAttoLabel/>
							</cell>
						</row>
					</rows>
				</grid>
			</groupbox>

			<groupbox mold="3d" closable="false" visible="@load(vm.atto.natura.name() eq 'T')">
				<caption label="@load(vm.etichette['SEZIONE_ATTO_ORIGINALE'])"/>
				<grid sclass="form">
					<rows>
						<row>
							<cell>
								<templateEstremiAttoOriginaleLabel/>
							</cell>
						</row>
					</rows>
				</grid>
			</groupbox>

			<orderByBlock/>

			<borderlayout vflex="1">
				<center vflex="1">
					<listbox model="@load(vm.lista)" selectedItem="@bind(vm.dettaglio)" nonselectableTags="" vflex="1"
							 emptyMessage="@load(vm.etichette['Nessun_dato_disponibile'])">
						<listhead>
							<listheader label="@load(vm.etichette['Tipo_Documento'])"		/>
							<listheader label="@load(vm.etichette['Allegati'])"				width="90px"/>
							<listheader 													width="52px"/>
						</listhead>
						<template name="model" var="item">
							<listitem>
								<listcell label="@load(item.fascicolo.descrizioneEstesa)"/>
								<listcell label="@load(c:length(item.allegatiFascicolo))"/>
								<listcell>
									<button image="/images/icon/action/18x18/delete.png"
											disabled="@load( (c:length(item.allegatiFascicolo) gt 0) or item.fascicolo.archivioComunicazione.isProtocollato() or item.fascicolo.archivioComunicazione.isInviatoAlbo() )"
											tooltiptext="@load(vm.etichette['elimina_tooltip'])"
											onClick="@command('onEliminaFascicolo', fascicolo=item.fascicolo)"/>
								</listcell>
							</listitem>
						</template>
					</listbox>
				</center>
				<east size="50%" collapsible="true" open="@load(not empty vm.dettaglio)">
					<vlayout vflex="1" hflex="1" sclass="scroll">
						<grid sclass="form">
							<rows>
								<row>
									<cell>
										<groupbox mold="3d" closable="false">
											<caption label="@load(vm.etichette['Documento'])" width="120px">
												<hlayout sclass="testo-a-dx">
													<button image="/images/icon/action/18x18/save.png"
															tooltiptext="@load(vm.etichette['salva_tooltip'])"
															onClick="@command('onSalvaFascicolo', fascicolo=vm.dettaglio.fascicolo)" />
												</hlayout>
											</caption>
											<vlayout width="100%" spacing="5px">
												<label value="@load(vm.dettaglio.fascicolo.descrizioneEstesa)" visible="@load(not empty vm.dettaglio.fascicolo.archivioComunicazione)"
													   sclass="grassetto" multiline="true"/>
												<label value="@load(vm.getEstremiProtocollo(vm.dettaglio))"/>
											</vlayout>

											<grid sclass="form">
												<rows>
													<row>
														<cell align="right" width="18%">
															<label value="@load(vm.etichette['Tipo_Documento'])"/>
														</cell>
														<cell colspan="1">
															<combobox model="@load(vm.listaTipoDocumento)" readonly="true" hflex="1"
																	  disabled="@load(not vm.dettaglio.isModifyTipoEnabled())"
                                                                      onChange="@command('onSelectTipoDocumento')"
																	  selectedItem="@bind(vm.dettaglio.fascicolo.tipoDocumentoFascicolo) @converter('it.finmatica.zk.utils.PropertyConverter', property='id')">
																<template name="model">
																	<comboitem label="@load(each.descrizione)" tooltiptext="@load(each.descrizione)" value="@load(each)"/>
																</template>
															</combobox>
														</cell>
													</row>
												</rows>
											</grid>
										</groupbox>
									</cell>
								</row>
								<row>
									<cell>
										<groupbox mold="3d" closable="false">
											<caption label="@load(vm.etichette['Allegati'])" width="120px">
												<hlayout sclass="testo-a-dx">
													<button image="/images/icon/action/18x18/add.png" upload="true"
															tooltiptext="@load(vm.etichette['inserisci_allegato_tooltip'])"
															onUpload="@command('onUploadAllegatoFascicolo', fascicolo=vm.dettaglio.fascicolo)" />
												</hlayout>
											</caption>
											<hlayout hflex="1" valign="middle">
												<listbox model="@load(vm.dettaglio.allegatiFascicolo)">
													<listhead sizable="true">
														<listheader label="@load(vm.etichette['Allegato'])"/>
														<listheader label="@load(vm.etichette['Note'])"/>
														<listheader label="" width="52px"/>
														<listheader label="" width="52px"/>
														<listheader label="" width="52px"/>
													</listhead>
													<template name="model" var="subItem">
														<listitem>
															<listcell>
																<label value="@load(subItem.nome)" tooltiptext="@load(subItem.nome)"/>
															</listcell>
															<listcell>
																<hlayout valign="middle" hflex="4">
																	<label value="@load(subItem.note)" tooltiptext="@load(subItem.note)" multiline="true" hflex="3"/>
																	<button image="/images/icon/action/18x18/note.png"
																			onClick="@command('onEditaNote', allegato=subItem)"/>
																</hlayout>
															</listcell>
															<listcell>
																<button image="/images/icon/action/18x18/import.png"
																		tooltiptext="@load(vm.etichette['scarica_allegato_tooltip'])"
																		onClick="@command('onDownloadAllegato', allegato=subItem)"/>
															</listcell>
															<listcell>
																<button image="/images/icon/action/18x18/delete.png"
																		tooltiptext="@load(vm.etichette['elimina_tooltip'])"
																		disabled="@load(vm.dettaglio.fascicolo.archivioComunicazione.isProtocollato() or vm.dettaglio.fascicolo.archivioComunicazione.isInviatoAlbo())"
																		onClick="@command('onEliminaAllegato', allegato=subItem)"/>
															</listcell>
                                                            <listcell>
																<button image="/images/icon/action/18x18/info.png"
																		tooltiptext="@load(vm.etichette['info_tooltip'])"
																		onClick="@command('onShowInfo', allegato=subItem)"/>
															</listcell>
														</listitem>
													</template>
												</listbox>
											</hlayout>
										</groupbox>
									</cell>
								</row>
								<row>
									<cell>
										<templateIdDomain/>
									</cell>
								</row>
							</rows>
						</grid>
					</vlayout>
				</east>
			</borderlayout>
		</vlayout>

	</window>

</zk>