<?xml version="1.0" encoding="UTF-8"?>
<?taglib uri="http://www.zkoss.org/dsp/web/core" prefix="c"?>

<zk xmlns="http://www.zkoss.org/2005/zul"
    xmlns:h="http://www.w3.org/1999/xhtml"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.zkoss.org/2005/zul http://www.zkoss.org/2005/zul/zul.xsd">

    <window viewModel="@id('vm') @init('restrict.statocivile.StampaProspettoListaViewModel')"
            apply="org.zkoss.bind.BindComposer"
            border="none"
            width="100%" height="100%"
            sizable="false" closable="false">

        <hlayout valign="middle">
            <controlBarStampa/>

            <label value="@load(vm.formLabel)" sclass="formTitle"/>
        </hlayout>

        <vlayout vflex="1">

            <groupbox closable="false">
                <grid sclass="form">
                    <rows>
                        <row>
                            <cell align="right" width="120px">
                                <label value="@load(vm.etichette['Stato'])"/>
                            </cell>
                            <cell>
                                <combobox model="@load(vm.listaStati)" readonly="true"
                                          selectedItem="@bind(vm.ricerca.stato) @converter('it.finmatica.zk.utils.PropertyConverter', property='id')">
                                    <template name="model">
                                        <comboitem label="@load(empty each?vm.etichette['Tutti']:vm.etichette[each.name()])" value="@load(each)"/>
                                    </template>
                                </combobox>
                            </cell>
                        </row>
                        <row>
                            <cell align="right">
                                <label value="@load(vm.etichette['Anno'])"/>
                            </cell>
                            <cell>
                                <hlayout valign="middle">
                                    <hlayout valign="middle" width="200px">
                                        <label value="@load(vm.etichette['Da'])"/>
                                        <intbox cols="4" maxlength="4" value="@bind(vm.ricerca.annoDa)"/>
                                        <button image="/images/icon/action/16x16/cancel.png"
                                                tooltiptext="@load(vm.etichette['Cancella'])" onClick="@command('onCancellaCampoRicerca')">
                                            <custom-attributes proprieta="annoDa"/>
                                        </button>
                                    </hlayout>
                                    <hlayout valign="middle">
                                        <label value="@load(vm.etichette['A'])"/>
                                        <intbox cols="4" maxlength="4" value="@bind(vm.ricerca.annoA)"/>
                                        <button image="/images/icon/action/16x16/cancel.png"
                                                tooltiptext="@load(vm.etichette['Cancella'])" onClick="@command('onCancellaCampoRicerca')">
                                            <custom-attributes proprieta="annoA"/>
                                        </button>
                                    </hlayout>
                                </hlayout>
                            </cell>
                        </row>
                        <row>
                            <cell align="right">
                                <label value="@load(vm.etichette['Data_Registrazione'])"/>
                            </cell>
                            <cell>
                                <hlayout valign="middle">
                                    <hlayout valign="middle" width="200px">
                                        <label value="@load(vm.etichette['Da'])"/>
                                        <datebox format="dd/MM/yyyy" value="@bind(vm.ricerca.dataRegistrazioneDa)" width="95px"/>
                                        <button image="/images/icon/action/16x16/cancel.png"
                                                tooltiptext="@load(vm.etichette['Cancella'])" onClick="@command('onCancellaCampoRicerca')">
                                            <custom-attributes proprieta="dataRegistrazioneDa"/>
                                        </button>
                                    </hlayout>
                                    <hlayout valign="middle">
                                        <label value="@load(vm.etichette['A'])"/>
                                        <datebox format="dd/MM/yyyy" value="@bind(vm.ricerca.dataRegistrazioneA)" width="95px"/>
                                        <button image="/images/icon/action/16x16/cancel.png"
                                                tooltiptext="@load(vm.etichette['Cancella'])" onClick="@command('onCancellaCampoRicerca')">
                                            <custom-attributes proprieta="dataRegistrazioneA"/>
                                        </button>
                                    </hlayout>
                                </hlayout>
                            </cell>
                        </row>
                    </rows>
                </grid>
            </groupbox>

        </vlayout>

    </window>

</zk>