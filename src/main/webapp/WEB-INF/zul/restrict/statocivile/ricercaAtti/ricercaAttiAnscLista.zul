<?xml version="1.0" encoding="UTF-8"?>
<?taglib uri="http://www.zkoss.org/dsp/web/core" prefix="c"?>

<zk xmlns="http://www.zkoss.org/2005/zul"
	xmlns:h="http://www.w3.org/1999/xhtml"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xmlns:w="http://www.zkoss.org/2005/zk/client"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul http://www.zkoss.org/2005/zul/zul.xsd">

	<window viewModel="@id('vm') @init('restrict.statocivile.ricercaAtti.RicercaAttiAnscListaViewModel')"
			apply="org.zkoss.bind.BindComposer"
			border="none"
			width="100%" height="100%"
			sizable="false" closable="false">

		<vlayout vflex="1">

			<hlayout valign="middle">
				<controlBarLista/>

				<label value="@load(vm.formLabel)" sclass="formTitle"/>
			</hlayout>

			<groupbox closable="false">
				<grid sclass="form">
					<rows>
						<row>
							<cell align="right" width="80px">
								<label value="@load(vm.etichette['Archivio'])"/>
							</cell>
							<cell colspan="6">
								<hlayout hflex="1">
									<radiogroup model="@load(vm.listaTipiArchivio)" onCheck="@command('onSelectTipoArchivio')"
												selectedItem="@bind(vm.tipoArchivioAnscEnum) @converter('it.finmatica.zk.utils.PropertyConverter', property='id')">
										<template name="model">
											<radio label="@load(empty each?'Tutti':vm.getEtichettaEnum(each))" value="@load(each)" style="padding:15px"/>
										</template>
									</radiogroup>
								</hlayout>
							</cell>
							<cell width="40px"/>
						</row>
						<row>
							<cell align="right">
								<label value="@load(vm.etichette['Anno'])"/>
							</cell>
							<cell>
								<hlayout valign="middle" hflex="1">
									<intbox value="@bind(vm.ricercaAtto.anno)"
											onOK="@command('onRicerca')" maxlength="4" cols="4"/>
									<button image="/images/icon/action/16x16/cancel.png"
											tooltiptext="@load(vm.etichette['Cancella'])" onClick="@command('onCancellaCampoRicerca')">
										<custom-attributes proprieta="anno"/>
									</button>
								</hlayout>
							</cell>
							<cell align="right">
								<label value="@load(vm.etichette['Numero_comunale'])"/>
							</cell>
							<cell>
								<hlayout valign="middle" hflex="1">
									<intbox value="@bind(vm.ricercaAtto.numeroUnico)" mold="rounded" cols="5" maxlength="5" onOK="@command('onRicerca')"/>
									<button image="/images/icon/action/16x16/cancel.png"
											tooltiptext="@load(vm.etichette['Cancella'])" onClick="@command('onCancellaCampoRicerca')">
										<custom-attributes proprieta="numeroUnico"/>
									</button>
								</hlayout>
							</cell>
							<cell align="right">
								<label value="@load(vm.etichette['Id_Atto_Ansc'])"/>
							</cell>
							<cell colspan="2">
								<hlayout valign="middle" hflex="1">
									<textbox value="@bind(vm.ricercaAtto.idAttoAnsc)" onOK="@command('onRicerca')" width="180px"/>
									<button image="/images/icon/action/16x16/cancel.png"
											tooltiptext="@load(vm.etichette['Cancella'])" onClick="@command('onCancellaCampoRicerca')">
										<custom-attributes proprieta="idAttoAnsc"/>
									</button>
								</hlayout>
							</cell>
							<cell/>
						</row>
						<row>
							<cell align="right">
								<label value="@load(vm.etichette['Cognome'])"/>
							</cell>
							<cell colspan="6">
								<hlayout valign="middle" hflex="1">
									<textbox value="@bind(vm.ricercaAtto.cognome)" onOK="@command('onRicercaAttiAnsc')" hflex="1"/>
									<button image="/images/icon/action/16x16/cancel.png"
											tooltiptext="@load(vm.etichette['Cancella'])" onClick="@command('onCancellaCampoRicerca')">
										<custom-attributes proprieta="cognome"/>
									</button>
									<space/>
								</hlayout>
							</cell>
							<cell/>
						</row>
						<row>
							<cell align="right">
								<label value="@load(vm.etichette['Nome'])"/>
							</cell>
							<cell colspan="6">
								<hlayout valign="middle" hflex="1">
									<textbox value="@bind(vm.ricercaAtto.nome)" onOK="@command('onRicerca')" hflex="1"/>
									<button image="/images/icon/action/16x16/cancel.png"
											tooltiptext="@load(vm.etichette['Cancella'])" onClick="@command('onCancellaCampoRicerca')">
										<custom-attributes proprieta="nome"/>
									</button>
									<space/>
								</hlayout>
							</cell>
							<cell width="40px">
								<hlayout valign="middle">
									<button image="/images/icon/action/16x16/search.png"
											tooltiptext="@load(vm.etichette['Effettua_Ricerca'])" onClick="@command('onRicercaAttiAnsc')"/>
								</hlayout>
							</cell>
						</row>
						<row visible="@load(not empty vm.buchiNumerazioneXAnno)">
							<cell colspan="8">
								<label value="@load(vm.buchiNumerazioneXAnno)" multiline="true" sclass="grassetto"/>
							</cell>
						</row>
					</rows>
				</grid>
			</groupbox>

			<orderByBlock/>

			<listbox model="@load(vm.lista)" selectedItem="@bind(vm.dettaglio)" nonselectableTags="" vflex="1"
					 emptyMessage="@load(vm.etichette['Nessun_dato_disponibile'])">
				<listhead sizable="true">
					<listheader label="@load(vm.etichette['Archivio'])" width="110px"/>
					<listheader label="Id ANSC" 	/>
					<listheader label="@load(vm.etichette['Numero_comunale'])" width="120px"/>
					<listheader label="@load(vm.etichette['Cognome'])" />
					<listheader label="@load(vm.etichette['Nome'])" />
					<listheader label="@load(vm.etichette['Cognome'])" />
					<listheader label="@load(vm.etichette['Nome'])" />
					<listheader label="" width="52px"/>
				</listhead>
				<template name="model" var="item">
					<listitem onDoubleClick="@command('onModifica')">
						<listcell label="@load(item.flagDivorzio?(item.archivioRif eq 'MAT'?vm.etichette['Atti_Divorzio']:vm.etichette['Atti_Scioglimento']):(item.archivioRif eq 'ANN'?vm.getDescrizioneArchivioAnnotazione(item):vm.getEtichettaEnum(item.archivioRif)))"/>
						<listcell label="@load(item.idAttoAnsc)"/>
						<listcell label="@load(item.numeroUnico)"/>
						<listcell label="@load(item.cognome1)"/>
						<listcell label="@load(item.nome1)"/>
						<listcell label="@load(item.cognome2)"/>
						<listcell label="@load(item.nome2)"/>
						<listcell>
							<button image="/images/icon/action/18x18/edit.png"
									tooltiptext="@load(vm.etichette['modifica_tooltip'])"
									visible="@load(not empty item.idRif)"
									onClick="@command('onModifica')"/>
						</listcell>
					</listitem>
				</template>
			</listbox>

		</vlayout>

	</window>

</zk>