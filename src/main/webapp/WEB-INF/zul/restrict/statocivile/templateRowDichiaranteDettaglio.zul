<?xml version="1.0" encoding="UTF-8"?>
<?taglib uri="http://www.zkoss.org/dsp/web/core" prefix="c"?>

<zk xmlns="http://www.zkoss.org/2005/zul"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul http://www.zkoss.org/2005/zul/zul.xsd">

	<row>
		<cell align="right" width="150px">
			<customLabel mandatory="${arg.mandatory}" value="@load(vm.etichette['Cognome'])"/>
		</cell>
		<cell colspan="4">
			<hlayout valign="middle" hflex="1">
				<textbox value="@bind(vm.datiProvenienza.cognomeDichiarante)" hflex="1"
						 style="@load(vm.minuscole.cognomeDichiarante?'text-transform:none':'text-transform:uppercase')"
						 onChange="@command('onAggiornaCaseDatiProvenienza')">
					<custom-attributes proprieta="cognomeDichiarante"/>
				</textbox>
				<button image="/images/icon/action/16x16/cancel.png"
						tooltiptext="@load(vm.etichette['Cancella'])" onClick="@command('onCancellaCampoProvenienza')">
					<custom-attributes proprieta="cognomeDichiarante"/>
				</button>
			</hlayout>
		</cell>
		<cell align="right" width="85px">
			<hlayout valign="middle" >
				<label value="@load(vm.etichette['Minuscole'])"/>
				<checkbox checked="@bind(vm.minuscole.cognomeDichiarante)" onCheck="@command('onAggiornaCaseDatiProvenienza')">
					<custom-attributes proprieta="cognomeDichiarante"/>
				</checkbox>
			</hlayout>
		</cell>
		<cell width="100px"/>
		<cell align="right" width="150px">
			<hlayout valign="middle" >
				<label value="@load(vm.etichette['Senza_Cognome'])"/>
				<checkbox checked="@bind(vm.datiProvenienza.senzaCognomeDichiarante)"/>
			</hlayout>
		</cell>
		<cell width="40px"/>
	</row>
	<row>
		<cell align="right">
			<customLabel mandatory="${vm.anscOn and arg.mandatory}" value="@load(vm.etichette['Nome'])"/>
		</cell>
		<cell colspan="4">
			<hlayout valign="middle" hflex="1">
				<textbox value="@bind(vm.datiProvenienza.nomeDichiarante)" hflex="1"
						 style="@load(vm.minuscole.nomeDichiarante?'text-transform:none':'text-transform:uppercase')"
						 onChange="@command('onAggiornaCaseDatiProvenienza')">
					<custom-attributes proprieta="nomeDichiarante"/>
				</textbox>
				<button image="/images/icon/action/16x16/search.png"
						tooltiptext="@load(vm.etichette['Seleziona'])" onClick="@command('onCaricaSoggetti', tipoSoggetto='ALTRO')"/>
				<button image="/images/icon/action/16x16/cancel.png"
						tooltiptext="@load(vm.etichette['Cancella'])" onClick="@command('onCancellaCampoProvenienza')">
					<custom-attributes proprieta="nomeDichiarante"/>
				</button>
			</hlayout>
		</cell>
		<cell align="right">
			<hlayout valign="middle" >
				<label value="@load(vm.etichette['Minuscole'])"/>
				<checkbox checked="@bind(vm.minuscole.nomeDichiarante)" onCheck="@command('onAggiornaCaseDatiProvenienza')">
					<custom-attributes proprieta="nomeDichiarante"/>
				</checkbox>
			</hlayout>
		</cell>
		<cell/>
		<cell align="right">
			<hlayout valign="middle">
				<label value="@load(vm.etichette['Senza_Nome'])"/>
				<checkbox checked="@bind(vm.datiProvenienza.senzaNomeDichiarante)"/>
			</hlayout>
		</cell>
		<cell/>
	</row>
	<row>
		<cell align="right">
			<customLabel mandatory="${vm.anscOn and arg.mandatory}" value="@load(vm.etichette['Sesso'])"/>
		</cell>
		<cell>
			<combobox model="@load(vm.listaSesso)" readonly="true" width="100px"
					  selectedItem="@bind(vm.datiProvenienza.sessoDichiarante) @converter('it.finmatica.zk.utils.PropertyConverter', property='id')">
				<template name="model">
					<comboitem label="@load(empty each?'- -':vm.getEtichettaEnum(each))" value="@load(each)"/>
				</template>
			</combobox>
		</cell>
		<cell align="right">
			<customLabel mandatory="${vm.anscOn and arg.mandatory}" value="@load(vm.etichette['Data_Nascita'])"/>
		</cell>
		<cell colspan="2">
			<hlayout valign="middle" hflex="1">
				<datebox format="dd/MM/yyyy" value="@bind(vm.datiProvenienza.dataNascitaDichiarante)" width="100px"/>
				<button image="/images/icon/action/16x16/cancel.png"
						tooltiptext="@load(vm.etichette['Cancella'])" onClick="@command('onCancellaCampoProvenienza')">
					<custom-attributes proprieta="dataNascitaDichiarante"/>
				</button>
			</hlayout>
		</cell>
		<cell colspan="4"/>
	</row>
	<row>
		<cell align="right">
			<customLabel mandatory="${vm.anscOn and arg.mandatory}" value="@load(vm.etichette['Comune_Nascita'])"/>
		</cell>
		<cell colspan="4">
			<hlayout valign="middle" hflex="1">
				<bandboxComuni hflex="1"
							   value="@load(vm.datiProvenienza.comuneNascitaDichiarante.descrizione)"
							   dataRiferimento="@load(vm.datiProvenienza.dataNascitaDichiarante)"
							   onSelect="@command('onSelectComune', campoRiferimento='CN_DIC')"/>
				<button image="/images/icon/action/16x16/cancel.png"
						tooltiptext="@load(vm.etichette['Cancella'])" onClick="@command('onCancellaComune', campoRiferimento='CN_DIC')"/>
			</hlayout>
		</cell>
		<cell>
			<textbox value="@load(vm.datiProvenienza.comuneNascitaDichiarante.siglaProvincia)" readonly="true" hflex="1"/>
		</cell>
		<cell colspan="3"/>
	</row>
	<row>
		<cell align="right">
			<customLabel mandatory="${vm.anscOn and arg.mandatory}" value="@load(vm.etichette['Comune_Residenza'])"/>
		</cell>
		<cell colspan="4">
			<hlayout valign="middle" hflex="1">
				<bandboxComuni hflex="1"
							   value="@load(vm.datiProvenienza.comuneResidenzaDichiarante.descrizione)"
							   onSelect="@command('onSelectComune', campoRiferimento='CR_DIC')"/>
				<button image="/images/icon/action/16x16/cancel.png"
						tooltiptext="@load(vm.etichette['Cancella'])" onClick="@command('onCancellaComune', campoRiferimento='CR_DIC')"/>
			</hlayout>
		</cell>
		<cell>
			<textbox value="@load(vm.datiProvenienza.comuneResidenzaDichiarante.siglaProvincia)" readonly="true" hflex="1"/>
		</cell>
		<cell align="right">
			<customLabel mandatory="${vm.anscOn and arg.mandatory}" value="@load(vm.etichette['Nazionalita'])"/>
		</cell>
		<cell>
			<combobox model="@load(vm.listaNazionalita)" readonly="false" hflex="1"
					  selectedItem="@bind(vm.datiProvenienza.nazionalitaDichiarante) @converter('it.finmatica.zk.utils.PropertyConverter', property='id')">
				<template name="model">
					<comboitem label="@load(empty each?'- -':each.descrizione)" tooltiptext="@load(each.descrizione)" value="@load(each)"/>
				</template>
			</combobox>
		</cell>
		<cell/>
	</row>

</zk>