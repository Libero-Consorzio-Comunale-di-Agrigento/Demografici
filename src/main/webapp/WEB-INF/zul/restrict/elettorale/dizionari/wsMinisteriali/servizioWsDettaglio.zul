<?xml version="1.0" encoding="UTF-8"?>
<?taglib uri="http://www.zkoss.org/dsp/web/core" prefix="c"?>

<zk xmlns="http://www.zkoss.org/2005/zul"
    xmlns:h="http://www.w3.org/1999/xhtml"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.zkoss.org/2005/zul http://www.zkoss.org/2005/zul/zul.xsd">

    <window viewModel="@id('vm') @init('restrict.elettorale.dizionari.wsMinisteriali.ServizioWsDettaglioViewModel')"
            apply="org.zkoss.bind.BindComposer"
            border="none"
            width="100%" height="100%"
            sizable="false" closable="false">

        <vlayout vflex="1">

            <hlayout valign="middle">
                <controlBarDettaglio/>
                <label value="@load(vm.formLabel)" sclass="formTitle"/>
            </hlayout>

            <div vflex="1" style="overflow-y: auto;">
            <grid sclass="form">
                <rows>
                    <row>
                        <cell align="right" width="180px">
                            <label value="@load(vm.etichette['Id'])"/>
                        </cell>
                        <cell>
                            <intbox value="@bind(vm.dettaglio.id)" disabled="@load(vm.tipoOperazione.isUpdate())"/>
                        </cell>
                    </row>
                    <row>
                        <cell align="right">
                            <label value="@load(vm.etichette['Servizio'])"/>
                        </cell>
                        <cell>
                            <textbox value="@bind(vm.dettaglio.servizio)" hflex="1"/>
                        </cell>
                    </row>
                    <row>
                        <cell align="right">
                            <label value="@load(vm.etichette['Descrizione'])"/>
                        </cell>
                        <cell>
                            <textbox value="@bind(vm.dettaglio.descrizione)" hflex="1"/>
                        </cell>
                    </row>
                    <row>
                        <cell align="right">
                            <label value="@load(vm.etichette['Url'])"/>
                        </cell>
                        <cell>
                            <textbox value="@bind(vm.dettaglio.url)" hflex="1"/>
                        </cell>
                    </row>
                    <row>
                        <cell align="right">
                            <label value="@load(vm.etichette['Url_Base'])"/>
                        </cell>
                        <cell>
                            <textbox value="@bind(vm.dettaglio.urlBase)" hflex="1"/>
                        </cell>
                    </row>
                    <row>
                        <cell align="right">
                            <label value="@load(vm.etichette['Url_Servizio'])"/>
                        </cell>
                        <cell>
                            <textbox value="@bind(vm.dettaglio.urlServizio)" hflex="1"/>
                        </cell>
                    </row>
                    <row>
                        <cell align="right">
                            <label value="@load(vm.etichette['Risposta_Servizio'])"/>
                        </cell>
                        <cell>
                            <textbox value="@bind(vm.dettaglio.rispostaServizio)" hflex="1"/>
                        </cell>
                    </row>
                    <row>
                        <cell align="right">
                            <label value="@load(c:cat(vm.etichette['Risposta'], '  1'))"/>
                        </cell>
                        <cell>
                            <textbox value="@bind(vm.dettaglio.risposta1)" hflex="1"/>
                        </cell>
                    </row>
                    <row>
                        <cell align="right">
                            <label value="@load(c:cat(vm.etichette['Risposta'], '  2'))"/>
                        </cell>
                        <cell>
                            <textbox value="@bind(vm.dettaglio.risposta2)" hflex="1"/>
                        </cell>
                    </row>
                    <row>
                        <cell align="right">
                            <label value="@load(c:cat(vm.etichette['Risposta'], '  3'))"/>
                        </cell>
                        <cell>
                            <textbox value="@bind(vm.dettaglio.risposta3)" hflex="1"/>
                        </cell>
                    </row>
                    <row>
                        <cell align="right">
                            <label value="@load(c:cat(vm.etichette['Risposta'], '  4'))"/>
                        </cell>
                        <cell>
                            <textbox value="@bind(vm.dettaglio.risposta4)" hflex="1"/>
                        </cell>
                    </row>
                    <row>
                        <cell align="right">
                            <label value="@load(c:cat(vm.etichette['Risposta'], '  5'))"/>
                        </cell>
                        <cell>
                            <textbox value="@bind(vm.dettaglio.risposta5)" hflex="1"/>
                        </cell>
                    </row>
                    <row>
                        <cell align="right">
                            <label value="@load(c:cat(vm.etichette['Risposta'], '  6'))"/>
                        </cell>
                        <cell>
                            <textbox value="@bind(vm.dettaglio.risposta6)" hflex="1"/>
                        </cell>
                    </row>
                    <row>
                        <cell align="right">
                            <label value="@load(c:cat(vm.etichette['Risposta'], '  7'))"/>
                        </cell>
                        <cell>
                            <textbox value="@bind(vm.dettaglio.risposta7)" hflex="1"/>
                        </cell>
                    </row>
                    <row>
                        <cell align="right">
                            <label value="@load(c:cat(vm.etichette['Risposta'], '  8'))"/>
                        </cell>
                        <cell>
                            <textbox value="@bind(vm.dettaglio.risposta8)" hflex="1"/>
                        </cell>
                    </row>
                    <row>
                        <cell align="right">
                            <label value="@load(c:cat(vm.etichette['Risposta'], '  9'))"/>
                        </cell>
                        <cell>
                            <textbox value="@bind(vm.dettaglio.risposta9)" hflex="1"/>
                        </cell>
                    </row>
                    <row>
                        <cell align="right">
                            <label value="@load(c:cat(vm.etichette['Risposta'], '  10'))"/>
                        </cell>
                        <cell>
                            <textbox value="@bind(vm.dettaglio.risposta10)" hflex="1"/>
                        </cell>
                    </row>
                    <row>
                        <cell align="right">
                            <label value="@load(c:cat(vm.etichette['Risposta'], '  NS'))"/>
                        </cell>
                        <cell>
                            <textbox value="@bind(vm.dettaglio.rispostaNs)" hflex="1"/>
                        </cell>
                    </row>
                </rows>
            </grid>
            </div>

        </vlayout>

    </window>

</zk>