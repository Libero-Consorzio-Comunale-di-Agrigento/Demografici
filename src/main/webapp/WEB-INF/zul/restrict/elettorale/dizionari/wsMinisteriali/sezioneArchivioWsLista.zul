<?xml version="1.0" encoding="UTF-8"?>
<?taglib uri="http://www.zkoss.org/dsp/web/core" prefix="c"?>
<?component name=bandboxElezioni extends=bandbox class=it.finmatica.de4gsdzk.zkutils.BandboxElezioni?>

<zk xmlns="http://www.zkoss.org/2005/zul"
    xmlns:h="http://www.w3.org/1999/xhtml"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.zkoss.org/2005/zul http://www.zkoss.org/2005/zul/zul.xsd">

    <window viewModel="@id('vm') @init('restrict.elettorale.dizionari.wsMinisteriali.SezioneArchivioWsListaViewModel')"
            apply="org.zkoss.bind.BindComposer"
            border="none"
            width="100%" height="100%"
            sizable="false" closable="false">

        <vlayout vflex="1">

            <hlayout valign="middle">
                <controlBarLista/>
                <label value="@load(vm.formLabel)" sclass="formTitle"/>
            </hlayout>

            <grid sclass="form">
                <columns>
                    <column width="150px"/>
                    <column/>
                </columns>
                <rows>
                    <row>
                        <cell align="right">
                            <customLabel mandatory="true" value="@load(vm.etichette['Elezione'])"/>
                        </cell>
                        <cell>
                            <hlayout valign="middle">
                                <bandboxElezioni
                                        value="@bind(empty vm.elezione.data ? null : (c:formatDate(vm.elezione.data, 'dd/MM/yyyy')))"
                                        width="190px" onSelect="@command('onSelectElezione')"/>
                                <intbox value="@bind(vm.elezione.anno)" readonly="true" width="70px"/>
                                <intbox value="@bind(vm.elezione.progressivo)" readonly="true" width="70px"/>
                                <button image="/images/icon/action/16x16/cancel.png"
                                        tooltiptext="@load(vm.etichette['Cancella'])"
                                        onClick="@command('onAzzeraElezione')"/>
                            </hlayout>
                        </cell>
                    </row>
                    <row>
                        <cell align="right">
                            <customLabel value="@load(vm.etichette['Elezione_Ads'])"/>
                        </cell>
                        <cell>
                            <combobox model="@load(vm.elezioniList)" width="300px" readonly="true" disabled="@bind(vm.elezione eq null)"
                                      selectedItem="@bind(vm.de4Elezione)  @converter('it.finmatica.zk.utils.PropertyConverter', property='id')"
                                      onSelect="@command('onSelectElezioneAds')">
                                <template name="model">
                                    <comboitem label="@load(empty each ? vm.etichette['Tutte'] : c:cat3(each.id, ' - ', each.descrizione))" value="@load(each)"/>
                                </template>
                            </combobox>
                        </cell>
                    </row>
                </rows>
            </grid>

            <totalSizeBlock/>

            <listbox model="@load(vm.lista)" selectedItem="@bind(vm.dettaglio)" nonselectableTags="" vflex="1"
                     emptyMessage="@load(vm.etichette['Nessun_dato_disponibile'])">
                <listhead sizable="true">
                    <listheader label="@load(vm.etichette['Codice'])" width="80px"/>
                    <listheader label="@load(vm.etichette['Descrizione'])"/>
                    <listheader label="@load(vm.etichette['Numero_Progressivo_Area'])"/>
                    <listheader label="@load(vm.etichette['Numero_Posizione'])"/>
                    <listheader label="@load(vm.etichette['Codice_Tipo'])"/>
                    <listheader label="@load(vm.etichette['Descrizione_Tipo'])"/>
                    <listheader label="@load(vm.etichette['Sezione_Ads'])"/>
                    <listheader label="@load(vm.etichette['Elezione_Ads'])"/>
                    <listheader label="" width="52px"/>
                </listhead>
                <template name="model" var="item">
                    <listitem onDoubleClick="@command('onModifica')">
                        <listcell label="@load(item.codiceSezione)"/>
                        <listcell label="@load(item.descrizioneSezione)"/>
                        <listcell label="@load(item.numeroProgressivoArea)"/>
                        <listcell label="@load(item.numeroPosizione)"/>
                        <listcell label="@load(item.codiceTipoSezione)"/>
                        <listcell label="@load(item.descrizioneTipoSezione)"/>
                        <listcell label="@load(item.sezioneAds)"/>
                        <listcell label="@load(c:cat3(item.elezioneAds.id, ' - ', item.elezioneAds.descrizione))"/>
                        <listcell>
                            <button image="/images/icon/action/18x18/edit.png"
                                    tooltiptext="@load(vm.etichette['modifica_tooltip'])"
                                    visible="@load(not empty item.id)"
                                    onClick="@command('onModifica')"/>
                        </listcell>
                    </listitem>
                </template>
            </listbox>

        </vlayout>

    </window>

</zk>
