<?xml version="1.0" encoding="UTF-8"?>
<?taglib uri="http://www.zkoss.org/dsp/web/core" prefix="c"?>

<zk xmlns="http://www.zkoss.org/2005/zul"
    xmlns:h="http://www.w3.org/1999/xhtml"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.zkoss.org/2005/zul http://www.zkoss.org/2005/zul/zul.xsd">

    <window viewModel="@id('vm') @init('restrict.elettorale.dizionari.wsMinisteriali.TipoElezioneWsDettaglioViewModel')"
            apply="org.zkoss.bind.BindComposer"
            border="none"
            width="100%" height="100%"
            sizable="false" closable="false">

        <vlayout vflex="1">

            <hlayout valign="middle">
                <controlBarDettaglio/>
                <label value="@load(vm.formLabel)" sclass="formTitle"/>
            </hlayout>

            <div vflex="1" style="overflow-y: auto;">
            <grid sclass="form">
                <rows>
                    <row>
                        <cell align="right" width="180px">
                            <label value="@load(vm.etichette['Tipo_Elezione'])"/>
                        </cell>
                        <cell>
                            <intbox value="@bind(vm.dettaglio.codice)" disabled="@load(vm.tipoOperazione.isUpdate())"/>
                        </cell>
                    </row>
                    <row>
                        <cell align="right">
                            <label value="@load(vm.etichette['Descrizione'])"/>
                        </cell>
                        <cell>
                            <textbox value="@bind(vm.dettaglio.descrizione)" hflex="1" maxlength="255"/>
                        </cell>
                    </row>
                    <row>
                        <cell align="right">
                            <label value="@load(vm.etichette['Tipo_Elezione_Ads'])"/>
                        </cell>
                        <cell>
                            <intbox value="@bind(vm.dettaglio.codTeAds)"/>
                        </cell>
                    </row>
                </rows>
            </grid>
            </div>

        </vlayout>

    </window>

</zk>
