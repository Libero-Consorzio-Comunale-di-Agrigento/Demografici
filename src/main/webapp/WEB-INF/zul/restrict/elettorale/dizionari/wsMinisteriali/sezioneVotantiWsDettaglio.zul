<?xml version="1.0" encoding="UTF-8"?>
<?taglib uri="http://www.zkoss.org/dsp/web/core" prefix="c"?>

<zk xmlns="http://www.zkoss.org/2005/zul"
    xmlns:h="http://www.w3.org/1999/xhtml"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.zkoss.org/2005/zul http://www.zkoss.org/2005/zul/zul.xsd">

    <window viewModel="@id('vm') @init('restrict.elettorale.dizionari.wsMinisteriali.SezioneVotantiWsDettaglioViewModel')"
            apply="org.zkoss.bind.BindComposer"
            border="none"
            width="100%" height="100%"
            sizable="false" closable="false">

        <vlayout vflex="1">

            <hlayout valign="middle">
                <controlBarDettaglio/>
                <label value="@load(vm.formLabel)" sclass="formTitle"/>
            </hlayout>

            <div vflex="1" style="overflow-y: auto;">
            <grid sclass="form">
                <rows>
                    <row>
                        <cell align="right" width="180px">
                            <label value="@load(vm.etichette['Codice_Provincia'])"/>
                        </cell>
                        <cell>
                            <intbox value="@bind(vm.dettaglio.codiceProvincia)"/>
                        </cell>
                    </row>
                    <row>
                        <cell align="right">
                            <label value="@load(vm.etichette['Descrizione_Provincia'])"/>
                        </cell>
                        <cell>
                            <textbox value="@bind(vm.dettaglio.descrizioneProvincia)" hflex="1" maxlength="255"/>
                        </cell>
                    </row>
                    <row>
                        <cell align="right">
                            <label value="@load(vm.etichette['Codice_Comune'])"/>
                        </cell>
                        <cell>
                            <intbox value="@bind(vm.dettaglio.codiceComune)"/>
                        </cell>
                    </row>
                    <row>
                        <cell align="right">
                            <label value="@load(vm.etichette['Descrizione_Comune'])"/>
                        </cell>
                        <cell>
                            <textbox value="@bind(vm.dettaglio.descrizioneComune)" hflex="1" maxlength="255"/>
                        </cell>
                    </row>
                    <row>
                        <cell align="right">
                            <label value="@load(vm.etichette['Livello_Acquisizione'])"/>
                        </cell>
                        <cell>
                            <textbox value="@bind(vm.dettaglio.livelloAcquisizione)" hflex="1" maxlength="255"/>
                        </cell>
                    </row>
                    <row>
                        <cell align="right">
                            <label value="@load(vm.etichette['Codice'])"/>
                        </cell>
                        <cell>
                            <intbox value="@bind(vm.dettaglio.codiceSezione)"/>
                        </cell>
                    </row>
                    <row>
                        <cell align="right">
                            <label value="@load(vm.etichette['Descrizione'])"/>
                        </cell>
                        <cell>
                            <textbox value="@bind(vm.dettaglio.descrizioneSezione)" hflex="1" maxlength="255"/>
                        </cell>
                    </row>
                    <row>
                        <cell align="right">
                            <label value="@load(vm.etichette['Numero_Progressivo_Area'])"/>
                        </cell>
                        <cell>
                            <intbox value="@bind(vm.dettaglio.numeroProgressivoArea)"/>
                        </cell>
                    </row>
                    <row>
                        <cell align="right">
                            <label value="@load(vm.etichette['Numero_Posizione'])"/>
                        </cell>
                        <cell>
                            <intbox value="@bind(vm.dettaglio.numeroPosizione)"/>
                        </cell>
                    </row>
                    <row>
                        <cell align="right">
                            <label value="@load(vm.etichette['Codice_Tipo'])"/>
                        </cell>
                        <cell>
                            <intbox value="@bind(vm.dettaglio.codiceTipoSezione)"/>
                        </cell>
                    </row>
                    <row>
                        <cell align="right">
                            <label value="@load(vm.etichette['Descrizione_Tipo'])"/>
                        </cell>
                        <cell>
                            <textbox value="@bind(vm.dettaglio.descrizioneTipoSezione)" hflex="1" maxlength="255"/>
                        </cell>
                    </row>
                    <row>
                        <cell align="right">
                            <label value="@load(vm.etichette['Elezione_Ads'])"/>
                        </cell>
                        <cell>
                            <combobox model="@load(vm.elezioniList)" width="300px" readonly="true" disabled="@bind(vm.dettaglio.elezioneAds ne null)"
                                          selectedItem="@bind(vm.dettaglio.elezioneAds)  @converter('it.finmatica.zk.utils.PropertyConverter', property='id')">
                                    <template name="model">
                                        <comboitem label="@load(c:cat3(each.id, ' - ', each.descrizione))"
                                                   value="@load(each)"/>
                                    </template>
                                </combobox>
                        </cell>
                    </row>
                    <row>
                        <cell align="right">
                            <label value="@load(vm.etichette['Sezione_Ads'])"/>
                        </cell>
                        <cell>
                            <intbox value="@bind(vm.dettaglio.sezioneAds)"/>
                        </cell>
                    </row>
                    <row>
                        <cell align="right">
                            <label value="@load(vm.etichette['Flag_Invio_Ads'])"/>
                        </cell>
                        <cell>
                            <checkbox checked="@bind(vm.dettaglio.flagInvioAds)"/>
                        </cell>
                    </row>
                    <row>
                        <cell align="right">
                            <label value="@load(vm.etichette['Cod_Esito_Ws'])"/>
                        </cell>
                        <cell>
                            <textbox value="@bind(vm.dettaglio.codEsitoWs)" maxlength="10"/>
                        </cell>
                    </row>
                    <row>
                        <cell align="right">
                            <label value="@load(vm.etichette['Des_Esito_Ws'])"/>
                        </cell>
                        <cell>
                            <textbox value="@bind(vm.dettaglio.desEsitoWs)" hflex="1" maxlength="255"/>
                        </cell>
                    </row>
                    <row>
                        <cell align="right">
                            <label value="@load(vm.etichette['Data_Ora_Ws'])"/>
                        </cell>
                        <cell>
                            <datebox format="dd/MM/yyyy HH:mm" value="@bind(vm.dettaglio.dataOraWs)"/>
                        </cell>
                    </row>
                </rows>
            </grid>
            </div>

        </vlayout>

    </window>

</zk>
