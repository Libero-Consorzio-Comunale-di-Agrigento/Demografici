<?xml version="1.0" encoding="UTF-8"?>
<?taglib uri="http://www.zkoss.org/dsp/web/core" prefix="c"?>

<zk xmlns="http://www.zkoss.org/2005/zul"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.zkoss.org/2005/zul http://www.zkoss.org/2005/zul/zul.xsd">

    <window viewModel="@id('vm') @init('restrict.elettorale.dizionari.wsMinisteriali.WsMinisterialiViewModel')"
            apply="org.zkoss.bind.BindComposer"
            border="none"
            width="100%" height="@load(vm.wCenterHeight)"
            sizable="false" closable="false">

        <tabbox hflex="1" vflex="1">
            <tabs>
                <tab label="@load(vm.etichette['Servizi'])"/>
                <tab label="@load(vm.etichette['Tipi_Elezione'])"/>
                <tab label="@load(vm.etichette['Elezioni_Ws'])"/>
                <tab label="@load(vm.etichette['Sezioni_Archivio'])"/>
                <tab label="@load(vm.etichette['Sezioni_Votanti'])"/>
                <tab label="@load(vm.etichette['Liste_Ws'])"/>
                <tab label="@load(vm.etichette['Candidati_Ws'])"/>
                <tab label="@load(vm.etichette['Comunicazioni_Ws'])"/>
                <tab label="@load(vm.etichette['Rilevamenti'])"/>
            </tabs>
            <tabpanels>
                <tabpanel>
                    <include hflex="1" vflex="1" src="/restrict/elettorale/dizionari/wsMinisteriali/servizioWsLista.zul"/>
                </tabpanel>
                <tabpanel>
                    <include hflex="1" vflex="1" src="/restrict/elettorale/dizionari/wsMinisteriali/tipoElezioneWsLista.zul"/>
                </tabpanel>
                <tabpanel>
                    <include hflex="1" vflex="1" src="/restrict/elettorale/dizionari/wsMinisteriali/elezioneWsLista.zul"/>
                </tabpanel>
                <tabpanel>
                    <include hflex="1" vflex="1" src="/restrict/elettorale/dizionari/wsMinisteriali/sezioneArchivioWsLista.zul"/>
                </tabpanel>
                <tabpanel>
                    <include hflex="1" vflex="1" src="/restrict/elettorale/dizionari/wsMinisteriali/sezioneVotantiWsLista.zul"/>
                </tabpanel>
                <tabpanel>
                    <include hflex="1" vflex="1" src="/restrict/elettorale/dizionari/wsMinisteriali/listaWsLista.zul"/>
                </tabpanel>
                <tabpanel>
                    <include hflex="1" vflex="1" src="/restrict/elettorale/dizionari/wsMinisteriali/candidatoWsLista.zul"/>
                </tabpanel>
                <tabpanel>
                    <include hflex="1" vflex="1" src="/restrict/elettorale/dizionari/wsMinisteriali/comunicazioneWsLista.zul"/>
                </tabpanel>
                <tabpanel>
                    <include hflex="1" vflex="1" src="/restrict/elettorale/dizionari/wsMinisteriali/rilevamentoWsLista.zul"/>
                </tabpanel>
            </tabpanels>
        </tabbox>

    </window>

</zk>
