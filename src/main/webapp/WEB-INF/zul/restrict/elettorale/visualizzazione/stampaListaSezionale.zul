<?xml version="1.0" encoding="UTF-8"?>
<?taglib uri="http://www.zkoss.org/dsp/web/core" prefix="c"?>
<?component name=bandboxElezioni extends=bandbox class=it.finmatica.de4gsdzk.zkutils.BandboxElezioni?>
<?component name="templateRowTimbriUE" macroURI="templateRowTimbriUE.zul" inline="true"?>
<?component name="templateRowTimbriCE" macroURI="templateRowTimbriCE.zul" inline="true"?>

<zk xmlns="http://www.zkoss.org/2005/zul"
    xmlns:h="http://www.w3.org/1999/xhtml"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.zkoss.org/2005/zul http://www.zkoss.org/2005/zul/zul.xsd">

    <window viewModel="@id('vm') @init('restrict.elettorale.visualizzazione.StampaListaSezionaleViewModel')"
            apply="org.zkoss.bind.BindComposer"
            border="none"
            width="100%" height="100%"
            sizable="false" closable="false">

        <hlayout valign="middle">
            <controlBarStampa/>

            <label value="@load(vm.formLabel)" sclass="formTitle"/>
        </hlayout>

        <vlayout vflex="1" style="overflow: auto;">

            <groupbox closable="false">
                <caption label="@load(vm.etichette['Tipo_Lista'])"/>
                <grid sclass="form">
                    <columns>
                        <column width="150px"/>
                        <column />
                    </columns>
                    <rows>
                        <row>
                            <cell align="right">
                                <customLabel value="@load(vm.etichette['Tipo_Lista'])"/>
                            </cell>
                            <cell>
                                <hlayout valign="middle" hflex="1">
                                    <combobox model="@load(vm.listaTipoLista)" readonly="true"
                                              selectedItem="@bind(vm.specifiche.tipoLista)  @converter('it.finmatica.zk.utils.PropertyConverter', property='id')">
                                        <template name="model">
                                            <comboitem label="@load(empty each?vm.etichette['Tutti']: each.descrizioneBreve)"
                                                       value="@load(each)"/>
                                        </template>
                                    </combobox>
                                    <button image="/images/icon/action/16x16/cancel.png"
                                            tooltiptext="@load(vm.etichette['Cancella'])"
                                            onClick="@command('onCancellaCampoSpecifiche')">
                                        <custom-attributes proprieta="tipoLista"/>
                                    </button>
                                </hlayout>
                            </cell>
                        </row>
                    </rows>
                </grid>
            </groupbox>

            <groupbox closable="false">
                <caption label="@load(vm.etichette['Dati_Generali'])"/>
                <grid sclass="form">
                    <columns>
                        <column width="150px"/>
                        <column width="355px"/>
                        <column width="150px"/>
                        <column width="355px"/>
                        <column width="150px"/>
                        <column/>
                    </columns>
                    <rows>
                        <row>
                            <cell align="right">
                                <label value="@load(vm.etichette['Sezione'])"/>
                            </cell>
                            <cell>
                                <hlayout valign="middle">
                                    <hlayout valign="middle">
                                        <label value="@load(vm.etichette['Da'])"/>
                                        <intbox value="@bind(vm.specifiche.sezioneDa)" onChange="@command('onChangeSezione')"/>
                                        <button image="/images/icon/action/16x16/cancel.png"
                                                tooltiptext="@load(vm.etichette['Cancella'])"
                                                onClick="@command('onCancellaCampoSpecifiche')">
                                            <custom-attributes proprieta="sezioneDa"/>
                                        </button>
                                    </hlayout>
                                    <hlayout valign="middle">
                                        <label value="@load(vm.etichette['A'])"/>
                                        <intbox value="@bind(vm.specifiche.sezioneA)" onChange="@command('onChangeSezione')"/>
                                        <button image="/images/icon/action/16x16/cancel.png"
                                                tooltiptext="@load(vm.etichette['Cancella'])"
                                                onClick="@command('onCancellaCampoSpecifiche')">
                                            <custom-attributes proprieta="sezioneA"/>
                                        </button>
                                    </hlayout>
                                </hlayout>
                            </cell>
                            <cell align="right">
                                <label value="@load(vm.etichette['Progressivo'])"/>
                            </cell>
                            <cell>
                                <hlayout valign="middle">
                                    <hlayout valign="middle">
                                        <label value="@load(vm.etichette['Da'])"/>
                                        <intbox value="@bind(vm.specifiche.progressivoDa)"/>
                                        <button image="/images/icon/action/16x16/cancel.png"
                                                tooltiptext="@load(vm.etichette['Cancella'])"
                                                onClick="@command('onCancellaCampoSpecifiche')">
                                            <custom-attributes proprieta="progressivoDa"/>
                                        </button>
                                    </hlayout>
                                    <hlayout valign="middle">
                                        <label value="@load(vm.etichette['A'])"/>
                                        <intbox value="@bind(vm.specifiche.progressivoA)"/>
                                        <button image="/images/icon/action/16x16/cancel.png"
                                                tooltiptext="@load(vm.etichette['Cancella'])"
                                                onClick="@command('onCancellaCampoSpecifiche')">
                                            <custom-attributes proprieta="progressivoA"/>
                                        </button>
                                    </hlayout>
                                </hlayout>
                            </cell>
                            <cell colspan="2"/>
                        </row>
                        <row>
                            <cell align="right">
                                <label value="@load(vm.etichette['Stampa_Seggi'])"/>
                            </cell>
                            <cell>
                                <checkbox checked="@bind(vm.specifiche.stampaSeggi)" onCheck="@command('onCheckStampaSeggi')"/>
                            </cell>
                            <cell align="right">
                                <label value="@load(vm.etichette['Stampa_Chiusura'])"/>
                            </cell>
                            <cell>
                                <checkbox checked="@bind(vm.specifiche.stampaChiusura)"/>
                            </cell>
                            <cell align="right">
                                <label value="@load(vm.etichette['Stampa_Visto'])"/>
                            </cell>
                            <cell>
                                <checkbox checked="@bind(vm.specifiche.stampaVisto)"/>
                            </cell>
                        </row>
                    </rows>
                </grid>
            </groupbox>

            <groupbox closable="false" visible="@load(vm.specifiche.stampaSeggi)">
                <caption label="@load(vm.etichette['Stampa_Seggi'])"/>
                <grid sclass="form">
                    <columns>
                        <column width="150px"/>
                        <column width="102px"/>
                        <column width="150px"/>
                        <column width="103px"/>
                        <column width="150px"/>
                        <column width="355px"/>
                        <column width="150px"/>
                        <column/>
                    </columns>
                    <rows>
                        <row>
                            <cell align="right">
                                <customLabel mandatory="true" value="@load(vm.etichette['Elezione'])"/>
                            </cell>
                            <cell colspan="3">
                                <hlayout valign="middle" hflex="1">
                                    <bandboxElezioni
                                            value="@bind(empty vm.specifiche.elezione.data? null:(c:formatDate(vm.specifiche.elezione.data, 'dd/MM/yyyy')))"
                                            width="190px" onSelect="@command('onSelectElezione')"/>
                                    <button image="/images/icon/action/16x16/cancel.png"
                                            tooltiptext="@load(vm.etichette['Cancella'])"
                                            onClick="@command('onCancellaCampoSpecifiche')">
                                        <custom-attributes proprieta="elezione"/>
                                    </button>
                                </hlayout>
                            </cell>
                            <cell align="right">
                                <label value="@load(vm.etichette['Anno'])"/>
                            </cell>
                            <cell>
                                <intbox value="@bind(vm.specifiche.elezione.anno)" readonly="true"/>
                            </cell>
                            <cell align="right">
                                <label value="@load(vm.etichette['Progressivo'])"/>
                            </cell>
                            <cell>
                                <intbox value="@bind(vm.specifiche.elezione.progressivo)" readonly="true"/>
                            </cell>
                        </row>
                        <row>
                            <cell align="right">
                                <label value="@load(vm.etichette['Alfabetico'])"/>
                            </cell>
                            <cell>
                                <checkbox checked="@bind(vm.specifiche.alfabetico)"/>
                            </cell>
                            <cell align="right">
                                <label value="@load(vm.etichette['Storico'])"/>
                            </cell>
                            <cell>
                                <checkbox checked="@bind(vm.specifiche.storico)" disabled="@bind(not vm.specifiche.alfabetico)"/>
                            </cell>
                            <cell align="right">
                                <label value="@load(vm.etichette['Cognomi'])"/>
                            </cell>
                            <cell>
                                <combobox model="@load(vm.filtriCognomeList)" readonly="true" hflex="1" onSelect="@command('azzeraCheck')"
                                          selectedItem="@bind(vm.specifiche.filtroCognome)  @converter('it.finmatica.zk.utils.PropertyConverter', property='id')">
                                    <template name="model">
                                        <comboitem label="@load(vm.getEtichettaEnum(each, 'Tutti'))"
                                                   value="@load(each)"/>
                                    </template>
                                </combobox>
                            </cell>
                            <cell align="right" visible="@load(vm.isPaginaInizialeVisibile())">
                                <label value="@load(vm.etichette['Ultima_Pagina_AL'])"/>
                            </cell>
                            <cell visible="@load(vm.isPaginaInizialeVisibile())">
                                <intbox value="@bind(vm.specifiche.paginaIniziale)"/>
                            </cell>
                            <cell visible="@load(not vm.isPaginaInizialeVisibile())" colspan="2"/>
                        </row>
                        <row>
                            <cell align="right">
                                <label value="@load(vm.etichette['Politiche'])"/>
                            </cell>
                            <cell>
                                <checkbox checked="@bind(vm.specifiche.politiche)"/>
                            </cell>
                            <cell align="right">
                                <label value="@load(vm.etichette['Referendum'])"/>
                            </cell>
                            <cell>
                                <checkbox checked="@bind(vm.specifiche.referendum)"/>
                            </cell>
                            <cell align="right">
                                <label value="@load(vm.etichette['Amministrative'])"/>
                            </cell>
                            <cell>
                                <checkbox checked="@bind(vm.specifiche.amministrative)" onCheck="@command('onCheckAmministrative')"/>
                                <space/>
                                <textbox value="@bind(vm.specifiche.descrizioneAmministrative)" readonly="@bind(not vm.specifiche.amministrative)"/>
                            </cell>
                            <cell colspan="2"/>
                        </row>
                    </rows>
                </grid>
            </groupbox>

            <groupbox closable="false" visible="@load(vm.specifiche.stampaChiusura)">
                <caption label="@load(vm.etichette['Stampa_Chiusura'])"/>
                <grid sclass="form">
                    <columns>
                        <column width="150px"/>
                        <column width="355px"/>
                        <column width="150px"/>
                        <column/>
                    </columns>
                    <rows>
                        <row>
                            <cell align="right">
                                <label value="@load(vm.etichette['Verbale'])"/>
                            </cell>
                            <cell>
                                <hlayout valign="middle" hflex="1">
                                    <textbox value="@bind(vm.specifiche.verbale)"/>
                                    <button image="/images/icon/action/16x16/cancel.png"
                                            tooltiptext="@load(vm.etichette['Cancella'])"
                                            onClick="@command('onCancellaCampoSpecifiche')">
                                        <custom-attributes proprieta="verbale"/>
                                    </button>
                                </hlayout>
                            </cell>
                            <cell align="right">
                                <label value="@load(vm.etichette['Data_Verbale'])"/>
                            </cell>
                            <cell>
                                <hlayout valign="middle">
                                    <datebox format="dd/MM/yyyy" value="@bind(vm.specifiche.dataVerbale)"/>
                                    <button image="/images/icon/action/16x16/cancel.png"
                                            tooltiptext="@load(vm.etichette['Cancella'])"
                                            onClick="@command('onCancellaCampoSpecifiche')">
                                        <custom-attributes proprieta="dataVerbale"/>
                                    </button>
                                </hlayout>
                            </cell>
                        </row>
                    </rows>
                </grid>
                <templateRowTimbriUE sez="true"/>
                <templateRowTimbriCE sez="true"/>
            </groupbox>

        </vlayout>

    </window>

</zk>