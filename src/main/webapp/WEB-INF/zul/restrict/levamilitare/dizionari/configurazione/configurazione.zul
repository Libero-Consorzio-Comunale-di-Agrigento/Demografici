<?xml version="1.0" encoding="UTF-8"?>
<?taglib uri="http://www.zkoss.org/dsp/web/core" prefix="c"?>

<zk xmlns="http://www.zkoss.org/2005/zul"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul http://www.zkoss.org/2005/zul/zul.xsd">

	<window viewModel="@id('vm') @init('restrict.levamilitare.dizionari.configurazione.ConfigurazioneViewModel')"
			apply="org.zkoss.bind.BindComposer"
			border="none"
			width="100%" height="@load(vm.wCenterHeight)"
			sizable="false" closable="false">

		<tabbox hflex="1" vflex="1">
			<tabs>
				<tab label="@load(vm.etichette['Parametri'])"/>
                <tab label="@load(vm.etichette['Loghi'])"/>
			</tabs>
			<tabpanels>
				<tabpanel>
					<include hflex="1" vflex="1" src="/restrict/parametroLista.zul" sezione="LEV"/>
				</tabpanel>
                <tabpanel>
                    <include hflex="1" vflex="1" src="/restrict/logoLista.zul" sezione="LEV"/>
                </tabpanel>
			</tabpanels>
		</tabbox>

	</window>

</zk>