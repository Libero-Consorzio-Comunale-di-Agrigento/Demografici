<?xml version="1.0" encoding="UTF-8"?>
<?taglib uri="http://www.zkoss.org/dsp/web/core" prefix="c"?>

<zk xmlns="http://www.zkoss.org/2005/zul"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.zkoss.org/2005/zul http://www.zkoss.org/2005/zul/zul.xsd">

    <window viewModel="@id('vm') @init('restrict.CaricaModelliViewModel')"
        apply="org.zkoss.bind.BindComposer">
        <vlayout>
            File caricati: <label value="${vm.count}"/> su <label value="${vm.total}"/>
            File DAT caricati: <label value="${vm.countDAT}"/> su <label value="${vm.totalDAT}"/>
            File ETI caricati: <label value="${vm.countEti}"/> su <label value="${vm.totalEti}"/>
        </vlayout>
    </window>

</zk>
