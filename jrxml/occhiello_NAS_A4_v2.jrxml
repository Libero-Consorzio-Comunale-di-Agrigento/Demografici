	<parameter name="LABEL_SESSO" class="java.lang.String"/>
	<parameter name="ID" class="java.lang.String"/>
	<parameter name="TIPO_ATTO" class="java.lang.Integer"/>
	<parameter name="CODICE_TIPO_ATTO" class="java.lang.String"/>
	<parameter name="COGNOME" class="java.lang.String"/>
	<parameter name="NOME" class="java.lang.String"/>
	<parameter name="SESSO" class="java.lang.String"/>
	<parameter name="STATO" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT O.COGNOME AS COGNOME, O.NOME AS NOME, O.ATTO AS NUMERO, DECODE(O.TIPO_ATTO, 2, O.SESSO, '') AS SESSO, DECODE(O.TIPO_ATTO, 2, O.NATO_MORTO, '') AS STATO
FROM  CIV$P!{CODICE_TIPO_ATTO} N, CIVOCC O
WHERE N.ID = $P{ID}
AND O.TIPO_ATTO = $P{TIPO_ATTO} AND O.ID_ATTO = N.ID_ATTO]]>
	</queryString>
