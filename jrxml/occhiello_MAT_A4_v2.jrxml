	<queryString>
		<![CDATA[SELECT O.COGNOME AS COGNOME, O.NOME AS NOME, O.COGNOME_CN AS COGNOME_CONIUGE, O.NOME_CN AS NOME_CONIUGE
FROM  CIV$P!{CODICE_TIPO_ATTO} M, CIVOCC O
WHERE M.ID = $P{ID}
AND O.TIPO_ATTO = $P{TIPO_ATTO} AND O.ID_ATTO = M.ID_ATTO]]>
	</queryString>
