	</parameter>
	<queryString>
		<![CDATA[select
            coalesce(nas.anno, pub.anno, mat.anno, mor.anno, cit.anno, pvu.anno, uci.anno) ANNO ,
            coalesce(nas.ufficio, pub.ufficio, mat.ufficio, mor.ufficio, cit.ufficio, pvu.ufficio, uci.ufficio) UFFICIO,
            NAS1A, NAS1B, NAS2A, NAS2B, PUB1, PUB2A, PUB2B, MAT1, MAT2A, MAT2B, MAT2C, MOR1, MOR2A, MOR2B, MOR2C, MOR2BB, CIT, UCI_V, UCI_A
        from (
            select * from (select anno, ufficio, concat(parte,serie) as p from civnas_v)
            pivot ( count(p) for p in ('1A' NAS1A, '1B' NAS1B, '2A' NAS2A, '2B' NAS2B))
        ) nas full outer join (
            select * from (select anno, ufficio, concat(parte,serie) as p from civpub_v)
            pivot ( count(p) for p in ('1' PUB1, '2A' PUB2A, '2B' PUB2B))
        ) pub on pub.anno=nas.anno and pub.ufficio=nas.ufficio
        full outer join (
            select * from (select anno, ufficio, concat(parte,serie) as p from civmat_v)
            pivot ( count(p) for p in ('1' MAT1, '2A' MAT2A, '2B' MAT2B, '2C' MAT2C))
        ) mat on mat.anno=nas.anno and mat.ufficio=nas.ufficio
        full outer join (
            select * from (select anno, ufficio, concat(parte,serie) as p from civmor_v)
            pivot ( count(p) for p in ('1' MOR1, '2A' MOR2A, '2B' MOR2B, '2C' MOR2C, '2B BIS' MOR2BB))
        ) mor on mor.anno=nas.anno and mor.ufficio=nas.ufficio
        full outer join (
            select * from (select anno, ufficio, count(*) as CIT from civcit_v group by anno,ufficio)
        ) cit on cit.anno=nas.anno and cit.ufficio=nas.ufficio
        full outer join (
            select * from (select anno, ufficio, count(*) as UCI_V from civpvu_v group by anno,ufficio)
        ) pvu on pvu.anno=nas.anno and pvu.ufficio=nas.ufficio
        full outer join (
            select * from (select anno, ufficio, count(*) as UCI_A from civuci_v group by anno,ufficio)
        ) uci on uci.anno=nas.anno and uci.ufficio=nas.ufficio
        order by anno, ufficio nulls first]]>
	</queryString>
