<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="stampa_atti" language="groovy" pageWidth="842" pageHeight="595" orientation="Landscape" columnWidth="802" leftMargin="20" rightMargin="20" topMargin="5" bottomMargin="5" uuid="2249a8f5-b71b-4b21-bd06-318559c6f8ff">
	<property name="ireport.zoom" value="2.0"/>
	<property name="ireport.x" value="88"/>
	<property name="ireport.y" value="0"/>
	<parameter name="ENTE" class="java.lang.String"/>
	<parameter name="TITOLO" class="java.lang.String"/>
	<parameter name="FONTE" class="java.lang.String"/>
	<parameter name="PARAMETRI" class="java.lang.String"/>
	<parameter name="label_ANNO" class="java.lang.String" isForPrompting="false">
